047A7F 98 7A 04    0004*       dl move_lightning       ; move_program
047A82 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
047A83 10          0006*       db 16                   ; dim_x
047A84 10          0007*       db 16                   ; dim_y
047A85 01          0008*       db 1                    ; num_orientations
047A86 02          0009*       db 2                    ; num_animations
047A87 00          0010*       db 0                    ; animation
047A88 08          0011*       db 8                    ; animation_timer
047A89 00          0012*       db 0                    ; move_timer
047A8A 00          0013*       db 0                    ; move_step
047A8B 00          0014*       db 0                    ; points
