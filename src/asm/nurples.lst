044CCE             0052*   
044CCE             0053*   tile_spawn_explosion:
044CCE 21 76 4C 04 0054*       ld hl,explosion_defaults
044CD2 DD 21 1A 8B 0055*       ld ix,explosions_base
       04          
044CD7 06 08       0056*       ld b,explosions_max
044CD9 CD D4 78 04 0057*       call spawn_sprite_from_tile
044CDD D2 DD 74 04 0058*       jp nc,table_deactivate_tile ; no carry means no free sprite slots, so we deactivate parent tile and go home
044CE1             0059*   ; other specific initialization
044CE1 21 00 00 00 0060*       ld hl,0
044CE5 DD 2F 07    0061*       ld (ix+sprite_xvel),hl
044CE8 21 00 01 00 0062*       ld hl,1*256
044CEC DD 2F 0A    0063*       ld (ix+sprite_yvel),hl
