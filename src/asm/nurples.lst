048D5F             0046*   tile_table_init:
048D5F             0047*   ; reset num active tiles
048D5F 21 00 00 00 0048*       ld hl,0
048D63 22 57 8D 04 0049*       ld (num_active_tiles),hl
048D67             0050*   ; reset next tile id
048D67 AF          0051*       xor a
048D68 32 5A 8D 04 0052*       ld (next_tile_id),a
048D6C 32 5E 8D 04 0053*       ld (tile_fault_flags),a
048D70             0054*   ; clear the tile stack
048D70 AF          0055*       xor a ; write zeroes to tile stack
048D71 21 4E 8A 04 0056*       ld hl,tile_stack
048D75 01 03 03 00 0057*       ld bc,tile_stack_end-tile_stack
048D79 CD 5B 03 04 0058*       call clear_mem
048D7D             0059*   ; clear the tile table
048D7D AF          0060*       xor a ; write zeroes to tile table
048D7E 21 23 A6 04 0061*       ld hl,tile_table_base ; address to copy from
048D82 01 00 40 00 0062*       ld bc,tile_table_end-tile_table_base ; number of bytes to clear
048D86 CD 5B 03 04 0063*       call clear_mem
048D8A             0064*   ; write tile ids
048D8A DD 21 23 A6 0065*       ld ix,tile_table_base
       04          
048D8F AF          0066*       xor a ; tile id
048D90 06 00       0067*       ld b,0 ; loop counter
048D92             0068*   @loop:
048D92 DD 77 00    0069*       ld (ix+tile_id),a
048D95 ED 32 40    0070*       lea ix,ix+table_record_size
048D98 3C          0071*       inc a
048D99 10 F7       0072*       djnz @loop
048D9B             0073*   ; set pointers to top of tile stack and tile table
048D9B 21 5A 8D 04 0074*       ld hl,next_tile_id
048D9F 3E FF       0075*       ld a,255 ; will wrap around to 0 on first call to create active tile
048DA1 77          0076*       ld (hl),a
048DA2 21 23 A6 04 0077*       ld hl,tile_table_base
048DA6 22 54 8D 04 0078*       ld (tile_table_pointer),hl
048DAA 21 4E 8A 04 0079*       ld hl,tile_stack
048DAE 22 51 8D 04 0080*       ld (tile_stack_pointer),hl
048DB2 C9          0081*       ret
048DB3             0082*   ; end tile_table_init
048DB3             0083*   
048DB3             0084*   ; gets the next available tile id
048DB3             0085*   ; inputs; none
048DB3             0086*   ; returns: if new tile available, a = tile id, ix pointing to new tile vars, carry set
048DB3             0087*   ;      otherwise, a = 0, carry flag reset, ix invalid and must not be dereferenced
048DB3             0088*   ; destroys: a,b,de,hl,ix
048DB3             0089*   ; affects: on success, bumps num_active_tiles by one, adds a tile pointer to the top of the tile stack
048DB3             0090*   tile_table_get_next_id:
048DB3             0091*   ; The byte-sized active count deliberately caps the dense stack at 255 entries.
048DB3 3A 57 8D 04 0092*       ld a,(num_active_tiles)
048DB7 3C          0093*       inc a
