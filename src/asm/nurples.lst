       04          
044C92 06 08       0027*       ld b,explosions_max
044C94 CD 91 68 04 0028*       call spawn_sprite_from_sprite
044C98 D2 CD 67 04 0029*       jp nc,table_deactivate_sprite ; no carry means no free sprite slots, so we deactivate parent sprite and go home
044C9C             0030*   ; other specific initialization
044C9C 21 00 00 00 0031*       ld hl,0
044CA0 DD 2F 07    0032*       ld (ix+sprite_xvel),hl
044CA3 21 00 01 00 0033*       ld hl,1*256
044CA7 DD 2F 0A    0034*       ld (ix+sprite_yvel),hl
044CAA             0035*   ; deactivate parent sprite
044CAA C3 CD 67 04 0036*       jp table_deactivate_sprite
044CAE             0037*   ; end spawn_explosion
