0463CC             0057        include "levels.inc"
0463CC             0001*   ; tileset indices
0463CC             0002*   tiles_dg: equ 0
0463CC             0003*   ; tiles_xevious: equ 1
0463CC 00 00 00    0004*   tileset_ptr_idx: dl 0
0463CF             0005*   tileset_ptrs:
0463CF             0006*       ; dl tiles_xevious_levels
0463CF 83 65 04    0007*       dl tileset_00_levels
0463D2 00 00 00    0008*   tileset_ptrs_end: dl 0 ; list terminator
0463D5             0009*   tileset_ptrs_count: equ [tileset_ptrs_end-tileset_ptrs]/3
0463D5             0010*   
0463D5             0011*   ; get a pointer to the current tileset
0463D5             0012*   ; inputs: tileset_ptr_idx
0463D5             0013*   ; returns: ix = pointer to tileset levels lut
0463D5             0014*   get_tileset_ptr:
0463D5 3A CC 63 04 0015*       ld a,(tileset_ptr_idx)
0463D9 FE 01       0016*       cp tileset_ptrs_count
0463DB DA E4 63 04 0017*       jp c,@index_valid
0463DF AF          0018*       xor a ; corrupt/out-of-range selectors recover to the first tileset
0463E0 32 CC 63 04 0019*       ld (tileset_ptr_idx),a
0463E4             0020*   @index_valid:
0463E4 11 00 00 00 0021*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
0463E8 57          0022*       ld d,a ; d = tileset index
0463E9 1E 03       0023*       ld e,3 ; three bytes per index record
0463EB ED 5C       0024*       mlt de ; offset into tileset_ptrs lut
0463ED DD 21 CF 63 0025*       ld ix,tileset_ptrs
       04          
0463F2 DD 19       0026*       add ix,de ; ix = pointer to tileset_ptrs record
0463F4 C9          0027*       ret
0463F5             0028*   ; end get_tileset_ptr
0463F5             0029*   
0463F5             0030*   ; intialize a tileset
0463F5             0031*   ; inputs: a = index into tileset_ptrs
0463F5             0032*   init_tileset:
0463F5 32 CC 63 04 0033*       ld (tileset_ptr_idx),a ; store new tileset index
0463F9 CD D5 63 04 0034*       call get_tileset_ptr ; ix = pointer to tileset_ptrs record
0463FD DD 37 00    0035*       ld ix,(ix) ; ix = pointer to tileset levels lut
046400 DD 7E FF    0036*       ld a,(ix-1) ; number of levels in the tileset
046403 32 21 64 04 0037*       ld (num_levels),a
046407 AF          0038*       xor a ; reset current level to zero
046408 32 20 64 04 0039*       ld (cur_level),a
04640C C3 81 64 04 0040*       jp init_level
046410             0041*   ; end init_tileset
046410             0042*   
046410             0043*   next_tileset:
046410 3A CC 63 04 0044*       ld a,(tileset_ptr_idx)
046414 3C          0045*       inc a ; bump to next index
046415 FE 01       0046*       cp tileset_ptrs_count
046417 DA F5 63 04 0047*       jp c,init_tileset
04641B AF          0048*       xor a ; wrap to the first tileset without dereferencing the terminator
04641C C3 F5 63 04 0049*       jp init_tileset
046420             0050*   ; end next_tileset
046420             0051*   
046420 00          0052*   cur_level: db 0
046421 00          0053*   num_levels: db 0
046422             0054*   
046422             0055*   ; get a pointer to the current level lookup record
046422             0056*   ; inputs: tileset_ptr_idx, cur_level
046422             0057*   ; returns: ix = pointer to level definition
046422             0058*   get_level_ptr:
046422 CD D5 63 04 0059*       call get_tileset_ptr
046426 DD 37 00    0060*       ld ix,(ix) ; ix = pointer to tileset levels lut
046429 DD 7E FF    0061*       ld a,(ix-1) ; refresh the count after any outer-selector recovery
04642C 32 21 64 04 0062*       ld (num_levels),a
046430 47          0063*       ld b,a
046431 3A 20 64 04 0064*       ld a,(cur_level)
046435 B8          0065*       cp b
046436 DA 3F 64 04 0066*       jp c,@index_valid
04643A             0067*   @index_invalid:
04643A AF          0068*       xor a ; corrupt/out-of-range selectors recover to the first level
04643B 32 20 64 04 0069*       ld (cur_level),a
04643F             0070*   @index_valid:
04643F 11 00 00 00 0071*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
046443 57          0072*       ld d,a ; d = level index
046444 1E 03       0073*       ld e,3 ; three bytes per level record
046446 ED 5C       0074*       mlt de ; offset into tileset levels lut
