0482FE             0385*   sprite_compute_velocities:
0482FE FD 27 10    0386*       ld hl,(iy+sprite_heading)
048301 FD 17 0D    0387*       ld de,(iy+sprite_vel)
048304 CD F0 06 04 0388*       call polar_to_cartesian
048308 FD 2A 98 80 0389*       ld iy,(table_pointer)
       04          
04830D FD 0F 07    0390*       ld (iy+sprite_xvel),bc ; save x-velocity component
048310 FD 1F 0A    0391*       ld (iy+sprite_yvel),de ; save y-velocity component
048313 C9          0392*       ret
048314             0393*   ; end sprite_compute_velocities
048314             0394*   
048314             0395*   ; compute animation frame based on sprite_animation and sprite_heading
048314             0396*   ; inputs: table_pointer set to sprite record
048314             0397*   ; outputs: a, sprite_frame set to animation frame
048314             0398*   ; destroys: a,hl
048314             0399*   sprite_frame_heading_animation:
048314 FD 7E 11    0400*       ld a,(iy+sprite_heading+1) ; we want the integer portion
048317 CB 3F       0401*       srl a ; divide integer portion by 8
048319 CB 3F       0402*       srl a
04831B CB 3F       0403*       srl a
04831D FD 66 22    0404*       ld h,(iy+sprite_animation)
048320 2E 20       0405*       ld l,32 ; 32 orientation frames per animation
048322 ED 6C       0406*       mlt hl ; hl = offset from base animation
048324 85          0407*       add a,l ; modulo256 since sprite_frame is only 1 byte
048325 FD 77 28    0408*       ld (iy+sprite_frame),a
048328 C9          0409*       ret
048329             0410*   ; end sprite_frame_heading_animation
048329             0411*   
048329             0412*   ; compute animation frame based on sprite_heading
048329             0413*   ; inputs: table_pointer set to sprite record
048329             0414*   ; outputs: a, sprite_frame set to animation frame
048329             0415*   ; destroys: a,hl
048329             0416*   sprite_frame_heading:
048329 FD 7E 11    0417*       ld a,(iy+sprite_heading+1) ; we want the integer portion
04832C CB 3F       0418*       srl a ; divide integer portion by 8
04832E CB 3F       0419*       srl a
048330 CB 3F       0420*       srl a
048332 FD 77 28    0421*       ld (iy+sprite_frame),a
048335 C9          0422*       ret
048336             0423*   ; end sprite_frame_heading
048336             0424*   
048336             0425*   ; load a sprite with animation bitmaps
048336             0426*   ; inputs: a = sprite id, hl = base bufferId, bc = number of frames, sprite_select
048336             0427*   sprite_load_frames:
048336             0428*   ; back up input parameters
048336 E5          0429*       push hl ; base bufferId
048337 C5          0430*       push bc ; bc = number of frames
048338 CD EA 18 04 0431*       call vdu_sprite_clear_frames
04833C C1          0432*       pop bc ; bc = number of frames
04833D E1          0433*       pop hl ; = base bufferId
04833E             0434*   @load_frames:
04833E C5          0435*       push bc ; back up loop counter
04833F E5          0436*       push hl ; back up base bufferId
048340 CD 2C 1A 04 0437*       call vdu_sprite_add_buff
048344 E1          0438*       pop hl ; restore base bufferId
048345 23          0439*       inc hl ; bump it to the next frame
048346             0440*   ; decrement loop counter
048346 C1          0441*       pop bc
048347 0B          0442*       dec bc
048348 79          0443*       ld a,c
048349 B7          0444*       or a
04834A C2 3E 83 04 0445*       jp nz,@load_frames
04834E 78          0446*       ld a,b
04834F B7          0447*       or a
048350 C2 3E 83 04 0448*       jp nz,@load_frames
048354 C9          0449*       ret
048355             0450*   ; end sprite_load_frames
