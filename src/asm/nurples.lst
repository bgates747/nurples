047DF7             0001*   ; UART ports for reading joystick input
047DF7             0002*   ; bit tests: 0 means actuated, 1 means not actuated
047DF7             0003*   portC: 	EQU 	$9E ; reads dpad input
047DF7             0004*   joy1_u: equ 1
047DF7             0005*   joy1_d: equ 3
047DF7             0006*   joy1_l: equ 5
047DF7             0007*   joy1_r: equ 7
047DF7             0008*   portD: 	EQU 	$A2 ; reads buttons
047DF7             0009*   btn1_a: equ 5
047DF7             0010*   
047DF7             0011*   ; process player keyboard input, set player bitmap
047DF7             0012*   ; velocities and draw player bitmap at updated coordinates
047DF7             0013*   ; Inputs: player_x/y set at desired position
047DF7             0014*   ; Returns: player bitmap drawn at updated position
047DF7             0015*   ; Destroys: probably everything except maybe iy
047DF7             0016*   ; NOTE: in mode 9 we draw the ship as a sprite, not a bitmap
047DF7             0017*   ; TODO: requires sprite implementation
047DF7             0018*   player_input:
047DF7             0019*   ; point to player sprite record
047DF7 FD 21 9E 9C 0020*       ld iy,player_begin
       04          
047DFC FD 22 C2 80 0021*       ld (table_pointer),iy
       04          
047E01             0022*   ; reset player component velocities to zero as the default
047E01 21 00 00 00 0023*       ld hl,0
047E05 FD 2F 07    0024*       ld (iy+sprite_xvel),hl
047E08 FD 2F 0A    0025*       ld (iy+sprite_yvel),hl
047E0B             0026*   ; make ship the active sprite
047E0B FD 7E 00    0027*       ld a,(iy+sprite_id)
047E0E CD DD 18 04 0028*       call vdu_sprite_select
047E12             0029*   ; check for keypresses and branch accordingly
047E12             0030*       MOSCALL    mos_getkbmap ;ix = pointer to MOS virtual keys table
                       M1 Args: function=mos_getkbmap 
047E12 3E 1E       0001*M1 			LD	A, function
047E14 5B CF       0002*M1 			RST.LIL	08h
047E16             0031*   ; do player directional input
047E16 AF          0032*       xor a ; clear flags
047E17 DB 9E       0033*       in a,(portC) ; read dpad input
047E19 57          0034*       ld d,a ; save dpad input
047E1A 3E 01       0035*       ld a,1 ; set ship's default animation to center
047E1C             0036*   ; 26 Left: move player left
047E1C DD CB 03 4E 0037*       bit 1,(ix+3)
047E20 C2 2E 7E 04 0038*       jp nz,@F
047E24             0039*   ; test dpad left
047E24 CB 6A       0040*       bit joy1_l,d
047E26 CA 2E 7E 04 0041*       jp z,@F
047E2A C3 3A 7E 04 0042*       jp @right
047E2E             0043*   @@:
047E2E FD 27 07    0044*       ld hl,(iy+sprite_xvel)
047E31 01 00 FD FF 0045*       ld bc,-player_speed
047E35 09          0046*       add hl,bc
047E36 FD 2F 07    0047*       ld (iy+sprite_xvel),hl
047E39 3D          0048*       dec a ; set ship's animation to left
047E3A             0049*   @right:
047E3A             0050*   ; 122 Right: move player right
047E3A DD CB 0F 4E 0051*       bit 1,(ix+15)
047E3E C2 4C 7E 04 0052*       jp nz,@F
047E42             0053*   ; test dpad right
047E42 CB 7A       0054*       bit joy1_r,d
047E44 CA 4C 7E 04 0055*       jp z,@F
047E48 C3 58 7E 04 0056*       jp @up
047E4C             0057*   @@:
047E4C FD 27 07    0058*       ld hl,(iy+sprite_xvel)
047E4F 01 00 03 00 0059*       ld bc,player_speed
047E53 09          0060*       add hl,bc
047E54 FD 2F 07    0061*       ld (iy+sprite_xvel),hl
047E57 3C          0062*       inc a ; set ship's animation to right
047E58             0063*   @up:
047E58             0064*   ; 58 Up: move player up
047E58 DD CB 07 4E 0065*       bit 1,(ix+7)
047E5C C2 6A 7E 04 0066*       jp nz,@F
047E60             0067*   ; test dpad up
047E60 CB 4A       0068*       bit joy1_u,d
047E62 CA 6A 7E 04 0069*       jp z,@F
047E66 C3 75 7E 04 0070*       jp @dn
047E6A             0071*   @@:
047E6A FD 27 0A    0072*       ld hl,(iy+sprite_yvel)
047E6D 01 00 FD FF 0073*       ld bc,-player_speed
047E71 09          0074*       add hl,bc
047E72 FD 2F 0A    0075*       ld (iy+sprite_yvel),hl
047E75             0076*   @dn:
047E75             0077*   ; 42 Down: move player down
047E75 DD CB 05 4E 0078*       bit 1,(ix+5)
047E79 C2 87 7E 04 0079*       jp nz,@F
047E7D             0080*   ; test dpad down
047E7D CB 5A       0081*       bit joy1_d,d
047E7F CA 87 7E 04 0082*       jp z,@F
047E83 C3 92 7E 04 0083*       jp @frame
047E87             0084*   @@:
047E87 FD 27 0A    0085*       ld hl,(iy+sprite_yvel)
047E8A 01 00 03 00 0086*       ld bc,player_speed
047E8E 09          0087*       add hl,bc
047E8F FD 2F 0A    0088*       ld (iy+sprite_yvel),hl
047E92             0089*   @frame:
047E92             0090*   ; a should land here loaded with the correct frame
047E92 CD 40 19 04 0091*       call vdu_sprite_select_frame
047E96             0092*   ; draw player at updated position
047E96 FD 21 9E 9C 0093*       ld iy,player_begin
       04          
047E9B FD 22 C2 80 0094*       ld (table_pointer),iy
       04          
047EA0 CD 87 82 04 0095*       call move_sprite
047EA4 FD 07 01    0096*       ld bc,(iy+sprite_x)
047EA7 FD 17 04    0097*       ld de,(iy+sprite_y)
047EAA CD A9 19 04 0098*       call vdu_sprite_move_abs168
047EAE             0099*   
047EAE             0100*   ; process player laser fire
047EAE             0101*   ; do player fire button input
047EAE             0102*   ; read joystick fire button
047EAE AF          0103*       xor a ; clear flags
047EAF DB A2       0104*       in a,(portD) ; read joypad fire button input
047EB1 CB 6F       0105*       bit btn1_a,a
047EB3 CA 54 7F 04 0106*       jp z,player_spawn_laser
047EB7             0107*   ; 99 Space: fire main weapon
047EB7 DD CB 0C 56 0108*       bit 2,(ix+12)
047EBB C2 54 7F 04 0109*       jp nz,player_spawn_laser
047EBF             0110*   ; no fire button pressed so go home
047EBF C9          0111*       ret
047EC0             0112*   ; end player_input
