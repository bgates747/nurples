0466BA             0007*   field_bottom: equ screen_bottom-origin_top
0466BA             0008*   field_left: equ 0
0466BA             0009*   field_right: equ 255
0466BA             0010*   sprite_top: equ field_top
0466BA             0011*   sprite_bottom: equ field_bottom-15
0466BA             0012*   sprite_left: equ field_left
