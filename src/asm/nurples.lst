04698E FD CB 16 7E 0370*       bit 7,(iy+sprite_type)
046992 C2 D3 69 04 0371*       jp nz,@next_record ; if just spawned, skip to next record
046996             0372*   ; check sprite_just_died bit
046996 FD CB 1D 7E 0373*       bit sprite_just_died,(iy+sprite_collisions)
04699A C2 32 6A 04 0374*       jp nz,@sprite_died ; if just died, deactivate sprite
