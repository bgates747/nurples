044D00             0067*   
044D00             0068*   move_explosion:
044D00             0069*   ; run the movement program for the explosion
044D00 CD 0D 6A 04 0070*       call move_sprite
044D04 B7          0071*       or a ; a will be non-zero if have scrolled off screen
044D05 C2 8B 67 04 0072*       jp nz,table_deactivate_sprite
044D09             0073*   ; do the animations
044D09 FD 35 23    0074*       dec (iy+sprite_animation_timer)
044D0C C0          0075*       ret nz ; not time to bump animation frame
044D0D FD 34 28    0076*       inc (iy+sprite_frame)
044D10 FD 35 22    0077*       dec (iy+sprite_animation)
044D13 CA 8B 67 04 0078*       jp z,table_deactivate_sprite ; reached the end of the animations
044D17 3E 08       0079*       ld a,explosion_animation_ticks ; reset animation timer
044D19 FD 77 23    0080*       ld (iy+sprite_animation_timer),a
