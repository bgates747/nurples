046EFC             0073        include "targeting.inc"
046EFC             0001*   ; compute orientation to player
046EFC             0002*   ; based on relative positions
046EFC             0003*   ; returns: uh.l 16.8 fixed angle256 to player
046EFC             0004*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
046EFC             0005*   ;    representing delta-x/y *to* target respectively
046EFC             0006*   ; inputs: iy pointed at sprite record
046EFC             0007*   ; destroys: everything except iy (sprite record pointer)
046EFC             0008*   orientation_to_player:
046EFC DD 21 F3 87 0009*       ld ix,player_begin
       04          
046F01             0010*   ; compute dx
046F01 DD 27 01    0011*       ld hl,(ix+sprite_x)
046F04 FD 17 01    0012*       ld de,(iy+sprite_x)
046F07 B7          0013*       or a ; clear carry
046F08 ED 52       0014*       sbc hl,de ; dx
046F0A E5          0015*       push hl ; save dx
046F0B             0016*   ; compute dy
046F0B DD 27 04    0017*       ld hl,(ix+sprite_y)
046F0E FD 17 04    0018*       ld de,(iy+sprite_y)
046F11 B7          0019*       or a ; clear carry
046F12 ED 52       0020*       sbc hl,de ; dy
046F14 EB          0021*       ex de,hl ; de = dy
046F15             0022*   ; compute angle to player
046F15 C1          0023*       pop bc ; dx (was hl)
046F16 C5          0024*       push bc ; save dx
046F17 D5          0025*       push de ; save dy
046F18 CD F0 07 04 0026*       call atan2_168fast ; uh.l = angle to player
046F1C 3E E0       0027*       ld a,%11100000
046F1E A5          0028*       and l ; round angle to nearest 32th of a circle
046F1F 6F          0029*       ld l,a
046F20 22 71 6F 04 0030*       ld (Bearing_t),hl ; return angle to player
046F24 D1          0031*       pop de ; restore dy
046F25 C1          0032*       pop bc ; restore dx
046F26 C9          0033*       ret
046F27             0034*   ; end orientation_to_player
046F27             0035*   
046F27             0036*   ; compute orientation to player
046F27             0037*   ; based on relative positions
046F27             0038*   ; returns: uh.l 16.8 fixed angle256 to player
046F27             0039*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
046F27             0040*   ;    representing delta-x/y *to* target respectively
046F27             0041*   ; inputs: iy pointed at tile record
046F27             0042*   ; destroys: everything except iy (tile record pointer)
046F27             0043*   tile_orientation_to_player:
046F27 DD 21 F3 87 0044*       ld ix,player_begin
       04          
046F2C             0045*   ; compute dx
046F2C DD 27 01    0046*       ld hl,(ix+sprite_x)
046F2F FD 17 01    0047*       ld de,(iy+tile_x)
046F32 B7          0048*       or a ; clear carry
046F33 ED 52       0049*       sbc hl,de ; dx
046F35 E5          0050*       push hl ; save dx
046F36             0051*   ; compute dy
046F36 DD 27 04    0052*       ld hl,(ix+sprite_y)
046F39 FD 17 04    0053*       ld de,(iy+tile_y)
046F3C B7          0054*       or a ; clear carry
046F3D ED 52       0055*       sbc hl,de ; dy
046F3F EB          0056*       ex de,hl ; de = dy
046F40             0057*   ; compute angle to player
046F40 C1          0058*       pop bc ; dx (was hl)
046F41 CD F0 07 04 0059*       call atan2_168fast ; uh.l = angle to player
046F45 3E E0       0060*       ld a,%11100000
046F47 A5          0061*       and l ; round angle to nearest 32th of a circle
046F48 6F          0062*       ld l,a
046F49 22 71 6F 04 0063*       ld (Bearing_t),hl
046F4D C9          0064*       ret
046F4E             0065*   ; end tile_orientation_to_player
046F4E             0066*   
046F4E             0067*   ; compute orientation to coordinate
046F4E             0068*   ; based on relative positions
046F4E             0069*   ; returns: uh.l 16.8 fixed angle256 to coordinate
046F4E             0070*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
046F4E             0071*   ;    representing delta-x/y *to* target respectively
046F4E             0072*   ; inputs: iy pointed at sprite record, ub.c,ud.e are target x,y coordinates
046F4E             0073*   ; destroys: everything except iy (sprite record pointer)
046F4E             0074*   bearing_to_coord:
046F4E             0075*   ; compute dx
046F4E C5          0076*       push bc
046F4F E1          0077*       pop hl
046F50 FD 07 01    0078*       ld bc,(iy+sprite_x)
046F53 B7          0079*       or a ; clear carry
046F54 ED 42       0080*       sbc hl,bc ; dx
046F56 E5          0081*       push hl ; save dx
046F57             0082*   ; compute dy
046F57 EB          0083*       ex de,hl
046F58 FD 17 04    0084*       ld de,(iy+sprite_y)
046F5B B7          0085*       or a ; clear carry
046F5C ED 52       0086*       sbc hl,de ; dy
046F5E EB          0087*       ex de,hl ; de = dy
046F5F             0088*   ; compute angle to coordinate
046F5F C1          0089*       pop bc ; dx (was hl)
046F60 C5          0090*       push bc ; save dx
046F61 D5          0091*       push de ; save dy
046F62 CD F0 07 04 0092*       call atan2_168fast ; uh.l = angle to coordinate
046F66 3E E0       0093*       ld a,%11100000
046F68 A5          0094*       and l ; round angle to nearest 32th of a circle
046F69 6F          0095*       ld l,a
046F6A 22 71 6F 04 0096*       ld (Bearing_t),hl ; return angle to coordinate
046F6E D1          0097*       pop de ; restore dy
046F6F C1          0098*       pop bc ; restore dx
046F70 C9          0099*       ret
046F71             0100*   ; end bearing_to_coord
046F71             0101*   
046F71             0102*   ; targeting_computer variables fixed 16.8 format
046F71 00 00 00    0103*   Bearing_t: dl 0x000000 ; angle to target
046F74 00 00 00    0104*   Heading_t: dl 0x000000 ; angle of target motion
046F77 00 00 00    0105*   Vp: dl 0x000000 ; velocity of projectile
046F7A 00 00 00    0106*   Vp_x: dl 0x000000 ; x component of projectile velocity
046F7D 00 00 00    0107*   Vp_y: dl 0x000000 ; y component of projectile velocity
046F80 00 00 00    0108*   Vt: dl 0x000000 ; velocity of target
046F83 00 00 00    0109*   Vt_x: dl 0x000000 ; x component of target velocity
046F86 00 00 00    0110*   Vt_y: dl 0x000000 ; y component of target velocity
046F89 00 00 00    0111*   Heading_p: dl 0x000000 ; angle of projectile motion
046F8C 00 00 00    0112*   lead_angle: dl 0x000000 ; lead angle
046F8F             0113*   
046F8F             0114*   ; Inputs:   Vp velocity of projectile set,
046F8F             0115*   ;           iy pointed to sprite record,
046F8F             0116*   ;           player position and velocities correctly set
046F8F             0117*   ; Outputs:  uh.l is the 16.8 fixed firing angle256
046F8F             0118*   ;           ub.c and ud.e are the 16.8 fixed x,y component projectile velocities
046F8F             0119*   ; https://old.robowiki.net/cgi-bin/robowiki?LinearTargeting
046F8F             0120*   targeting_computer:
046F8F DD 21 F3 87 0121*       ld ix,player_begin
       04          
046F94             0122*   ; ; compute target velocity from x,y component velocities
046F94             0123*   ;     ld bc,(ix+sprite_xvel)
046F94             0124*   ;     ld de,(ix+sprite_yvel)
046F94             0125*   ;     ld hl,-1*256 ; account for vertical ground movement
046F94             0126*   ;     add hl,de
046F94             0127*   ;     ex de,hl ; ud.e = player_yvel-1
046F94             0128*   ;     call cartesian_to_polar_sm ; uh.l = Heading_t, ud.e = Vt
