0485F5             0001*   ; Game state variables
0485F5 B6 86 04    0002*   game_state:  dl game_main_menu
0485F8             0003*   game_fault_bad_state: equ 0
0485F8 00          0004*   game_fault_flags: db 0 ; latched fail-closed diagnostics
0485F9 00          0005*   game_exit_requested: db 0 ; main-loop handoff; state handlers must return normally
0485FA             0006*   
0485FA             0007*   do_game:
0485FA 2A F5 85 04 0008*       ld hl,(game_state)   ; Load the current game state
0485FE CD 1C 86 04 0009*       call game_state_pointer_valid
048602 DA 15 86 04 0010*       jp c,@dispatch
048606 21 F8 85 04 0011*       ld hl,game_fault_flags
04860A CB C6       0012*       set game_fault_bad_state,(hl)
04860C 21 67 87 04 0013*       ld hl,game_init ; publish recovery; do not run it in the corrupt frame
048610 22 F5 85 04 0014*       ld (game_state),hl
048614 C9          0015*       ret
048615             0016*   @dispatch:
048615             0017*       CALL_HL                ; Call the corresponding state handler
                       M1 Args: none
048615 01 1B 86 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
048619 C5          0002*M1     push bc ; which constitutes the return address
04861A E9          0003*M1     jp (hl) ; Jump to the address in HL
04861B C9          0018*       ret
04861C             0019*   
04861C             0020*   ; Exact stabilization whitelist for writable legacy global-state pointers.
04861C             0021*   ; inputs/outputs: hl = candidate handler; carry set only for an exact match
04861C             0022*   ; destroys: a,de
04861C             0023*   game_state_pointer_valid:
04861C 11 B6 86 04 0024*       ld de,game_main_menu
048620 CD B0 86 04 0025*       call @matches
048624 CA AE 86 04 0026*       jp z,@valid
048628 11 B7 86 04 0027*       ld de,game_paused
04862C CD B0 86 04 0028*       call @matches
048630 CA AE 86 04 0029*       jp z,@valid
048634 11 B8 86 04 0030*       ld de,game_level_transition
048638 CD B0 86 04 0031*       call @matches
04863C CA AE 86 04 0032*       jp z,@valid
048640 11 C5 86 04 0033*       ld de,game_over
048644 CD B0 86 04 0034*       call @matches
048648 CA AE 86 04 0035*       jp z,@valid
04864C 11 22 87 04 0036*       ld de,game_victory
048650 CD B0 86 04 0037*       call @matches
048654 CA AE 86 04 0038*       jp z,@valid
048658 11 23 87 04 0039*       ld de,game_loading
04865C CD B0 86 04 0040*       call @matches
048660 CA AE 86 04 0041*       jp z,@valid
048664 11 30 87 04 0042*       ld de,game_cutscene
048668 CD B0 86 04 0043*       call @matches
04866C CA AE 86 04 0044*       jp z,@valid
048670 11 31 87 04 0045*       ld de,game_inventory
048674 CD B0 86 04 0046*       call @matches
048678 CA AE 86 04 0047*       jp z,@valid
04867C 11 32 87 04 0048*       ld de,game_map
048680 CD B0 86 04 0049*       call @matches
048684 CA AE 86 04 0050*       jp z,@valid
048688 11 33 87 04 0051*       ld de,game_exit
04868C CD B0 86 04 0052*       call @matches
048690 CA AE 86 04 0053*       jp z,@valid
048694 11 67 87 04 0054*       ld de,game_init
048698 CD B0 86 04 0055*       call @matches
04869C CA AE 86 04 0056*       jp z,@valid
0486A0 11 E5 88 04 0057*       ld de,game_playing
