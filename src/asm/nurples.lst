04750C DD CB 16 FE 0327*       set 7,(ix+sprite_type) ; set just spawned flag
047510 DD CB 1D F6 0328*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
047514 37          0329*       scf ; set carry flag to indicate success
047515 C9          0330*       ret
047516             0331*   ; end spawn_active_tile
047516             0332*   
047516             0333*   ; spawn a new active tile at the prescribed location
047516             0334*   ; inputs: iy pointer to current hl = pointer to new tile default settings
047516             0335*   ; returns: if new tile available, a = tile id, ix pointing to new tile vars, carry set
047516             0336*   ;      otherwise, a = 0, carry flag reset, ix invalid and must not be dereferenced
