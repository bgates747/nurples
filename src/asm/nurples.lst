047BA1             0054*   ; define laser sprites
047BA1             0055*   @sprites_loop:
047BA1 F5          0056*       push af
047BA2 D5          0057*       push de
047BA3 CD 44 19 04 0058*   	call vdu_sprite_select
047BA7 CD 57 19 04 0059*   	call vdu_sprite_clear_frames
047BAB 21 4E 01 00 0060*   	ld hl,BUF_LASER_A
