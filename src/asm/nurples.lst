044ECA 06 11       0177*       ld b,17 ; y
044ECC CD B1 13 04 0178*       call vdu_move_cursor
044ED0 CD 5C 00 04 0179*       call printInline
044ED4 53 74 61 72 0180*       asciz "Starting In..."
       74 69 6E 67 
       20 49 6E 2E 
       2E 2E 00    
