047A65 ED 6C       0166*       mlt hl
047A67 11 0C 70 04 0167*       ld de,tile_stack-3
047A6B 19          0168*       add hl,de
047A6C 22 12 73 04 0169*       ld (tile_stack_pointer),hl
047A70 C9          0170*       ret
