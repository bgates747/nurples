044CCB             0054        include "explosion.inc"
044CCB             0001*   explosions_max: equ 8
044CCB             0002*   explosion_animation_count: equ 5
044CCB             0003*   explosion_animation_ticks: equ 8
044CCB             0004*   ; One update clears the just-spawned flag, then every animation frame runs for
044CCB             0005*   ; explosion_animation_ticks updates.
044CCB             0006*   explosion_lifetime_updates: equ explosion_animation_count*explosion_animation_ticks+1
044CCB             0007*   explosion_defaults:
044CCB 04          0008*       db explosion            ; type
044CCC 09 01 00    0009*       dl BUF_EXPLOSION_A	    ; base_bufferId
044CCF 48 4D 04    0010*       dl move_explosion	    ; move_program
044CD2 40          0011*       db %01000000            ; collisions bit 6 signals sprite alive
044CD3 07          0012*       db 7	                ; dim_x
044CD4 07          0013*       db 7                    ; dim_y
044CD5 01          0014*       db 1                    ; num_orientations
044CD6 05          0015*       db explosion_animation_count ; num_animations
044CD7 05          0016*       db explosion_animation_count ; animation
044CD8 08          0017*       db explosion_animation_ticks ; animation_timer
044CD9 00          0018*       db 0	                ; move_timer
044CDA 00          0019*       db 0	                ; move_step
044CDB 00          0020*       db 0	                ; points
044CDC 00          0021*       db 0	                ; shield_damage
044CDD 00          0022*       db 0                    ; frame
044CDE             0023*   
044CDE             0024*   spawn_explosion:
044CDE 21 CB 4C 04 0025*       ld hl,explosion_defaults
044CE2 DD 21 D8 90 0026*       ld ix,explosions_base
       04          
044CE7 06 08       0027*       ld b,explosions_max
044CE9 CD 00 69 04 0028*       call spawn_sprite_from_sprite
044CED D2 3C 68 04 0029*       jp nc,table_deactivate_sprite ; no carry means no free sprite slots, so we deactivate parent sprite and go home
044CF1             0030*   ; other specific initialization
044CF1 21 00 00 00 0031*       ld hl,0
044CF5 DD 2F 07    0032*       ld (ix+sprite_xvel),hl
044CF8 21 00 01 00 0033*       ld hl,1*256
044CFC DD 2F 0A    0034*       ld (ix+sprite_yvel),hl
044CFF             0035*   ; deactivate parent sprite
044CFF C3 3C 68 04 0036*       jp table_deactivate_sprite
044D03             0037*   ; end spawn_explosion
044D03             0038*   
044D03             0039*   spawn_explosion_player:
044D03 FD 21 D8 8E 0040*       ld iy,player_begin
       04          
044D08 FD 22 BC 67 0041*       ld (table_pointer),iy
       04          
044D0D 21 CB 4C 04 0042*       ld hl,explosion_defaults
044D11 DD 21 D8 90 0043*       ld ix,explosions_base
       04          
044D16 06 08       0044*       ld b,explosions_max
044D18 CD 00 69 04 0045*       call spawn_sprite_from_sprite
044D1C D8          0046*       ret c ; carry is the only indication that IX names a valid explosion
044D1D             0047*   ; no slot: keep the player hidden and return failure without exposing invalid IX
044D1D CD 3C 68 04 0048*       call table_deactivate_sprite
044D21 AF          0049*       xor a ; clear carry after the VDU calls in table_deactivate_sprite
044D22 C9          0050*       ret
044D23             0051*   ; end spawn_explosion_player
044D23             0052*   
044D23             0053*   tile_spawn_explosion:
044D23 21 CB 4C 04 0054*       ld hl,explosion_defaults
044D27 DD 21 D8 90 0055*       ld ix,explosions_base
       04          
044D2C 06 08       0056*       ld b,explosions_max
044D2E CD 78 79 04 0057*       call spawn_sprite_from_tile
044D32 D2 81 75 04 0058*       jp nc,table_deactivate_tile ; no carry means no free sprite slots, so we deactivate parent tile and go home
044D36             0059*   ; other specific initialization
044D36 21 00 00 00 0060*       ld hl,0
044D3A DD 2F 07    0061*       ld (ix+sprite_xvel),hl
044D3D 21 00 01 00 0062*       ld hl,1*256
044D41 DD 2F 0A    0063*       ld (ix+sprite_yvel),hl
044D44             0064*   ; deactivate parent sprite
044D44 C3 81 75 04 0065*       jp table_deactivate_tile
044D48             0066*   ; end tile_spawn_explosion
044D48             0067*   
044D48             0068*   move_explosion:
044D48             0069*   ; run the movement program for the explosion
044D48 CD BE 6A 04 0070*       call move_sprite
044D4C B7          0071*       or a ; a will be non-zero if have scrolled off screen
044D4D C2 3C 68 04 0072*       jp nz,table_deactivate_sprite
044D51             0073*   ; do the animations
044D51 FD 35 23    0074*       dec (iy+sprite_animation_timer)
044D54 C0          0075*       ret nz ; not time to bump animation frame
044D55 FD 34 28    0076*       inc (iy+sprite_frame)
044D58 FD 35 22    0077*       dec (iy+sprite_animation)
044D5B CA 3C 68 04 0078*       jp z,table_deactivate_sprite ; reached the end of the animations
044D5F 3E 08       0079*       ld a,explosion_animation_ticks ; reset animation timer
044D61 FD 77 23    0080*       ld (iy+sprite_animation_timer),a
044D64 C9          0081*       ret
044D65             0082*   ; end move_explosion
044D65             0083*   
044D65             0084*   move_explosions:
044D65             0085*   ; initialize pointers and loop counter
044D65 FD 21 D8 90 0086*       ld iy,explosions_base ; set iy to first record in table
       04          
044D6A 06 08       0087*       ld b,explosions_max ; loop counter
044D6C CD EC 69 04 0088*       call move_sprite_group
044D70 C9          0089*       ret
044D71             0090*   ; end move_explosions
044D71             0091*   
044D71             0092*   init_explosions:
044D71             0093*   ; set pointer to explosion sprite table
044D71 FD 21 D8 90 0094*       ld iy,explosions_base
       04          
044D76 FD 7E 00    0095*       ld a,(iy+sprite_id) ; sprite id
044D79 1E 08       0096*       ld e,explosions_max ; sprite loop counter
044D7B             0097*   ; define explosion sprites
044D7B             0098*   @sprites_loop:
044D7B F5          0099*       push af
044D7C D5          0100*       push de
044D7D CD 03 1A 04 0101*   	call vdu_sprite_select
044D81 CD 16 1A 04 0102*   	call vdu_sprite_clear_frames
044D85 21 09 01 00 0103*   	ld hl,BUF_EXPLOSION_A
044D89 06 05       0104*   	ld b,5 ; 5 bitmaps for explosion
044D8B             0105*   @frames_loop:
044D8B C5          0106*   	push bc
044D8C E5          0107*   	push hl
044D8D CD 58 1B 04 0108*   	call vdu_sprite_add_buff
044D91 E1          0109*   	pop hl
044D92 23          0110*   	inc hl
044D93 C1          0111*   	pop bc
044D94 10 F5       0112*   	djnz @frames_loop
044D96 D1          0113*       pop de ; sprite loop counter
044D97 F1          0114*       pop af ; sprite id
044D98 3C          0115*       inc a
044D99 1D          0116*       dec e
044D9A C2 7B 4D 04 0117*       jp nz,@sprites_loop
044D9E C9          0118*       ret
044D9F             0119*   ; end init_explosions
