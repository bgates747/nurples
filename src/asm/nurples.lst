046374 ED 52       0205*       sbc hl,de
046376 DD 17 0F    0206*       ld de,(ix+bar_y)
046379 19          0207*       add hl,de
04637A 7D          0208*       ld a,l
04637B E6 FC       0209*       and %11111100 ; round to nearest 4 pixels
04637D 6F          0210*       ld l,a
04637E EB          0211*       ex de,hl
04637F CD 1A 19 04 0212*       call vdu_plot_bmp
046383 C9          0213*       ret
046384             0214*   ; end bar_update_v
046384             0215*   
046384             0216*   ; update a horizontal bar display
046384             0217*   ; inputs: ix points to bar structure
046384             0218*   ;         bar_val set by caller
046384             0219*   ; prerequisite: bar_init called before first use
046384             0220*   bar_update_h:
046384             0221*   ; set gfx viewport
046384 DD E5       0222*       push ix ; preserve pointer
046386 DD 07 03    0223*       ld bc,(ix+bar_x0)
046389 DD 17 06    0224*       ld de,(ix+bar_y0)
04638C DD 31 0C    0225*       ld iy,(ix+bar_y1)
04638F DD 37 09    0226*       ld ix,(ix+bar_x1)
046392 CD 8F 14 04 0227*       call vdu_set_gfx_viewport
046396 DD E1       0228*       pop ix ; restore pointer
046398             0229*   ; select the color based on the value thresholds
046398 DD 17 00    0230*       ld de,(ix+bar_val)
04639B 21 EF FF FF 0231*       ld hl,-bar_red
04639F 19          0232*       add hl,de
0463A0 D2 BD 63 04 0233*       jp nc,@red
0463A4 21 DF FF FF 0234*       ld hl,-bar_yellow
0463A8 19          0235*       add hl,de
0463A9 D2 B5 63 04 0236*       jp nc,@yellow
0463AD 21 02 00 00 0237*       ld hl,BUF_BAR_H_2 ; green
0463B1 C3 C1 63 04 0238*       jp @select
0463B5             0239*   @yellow:
0463B5 21 01 00 00 0240*       ld hl,BUF_BAR_H_1 ; yellow
0463B9 C3 C1 63 04 0241*       jp @select
0463BD             0242*   @red:
0463BD 21 00 00 00 0243*       ld hl,BUF_BAR_H_0 ; red
0463C1             0244*   @select:
0463C1 CD E4 14 04 0245*       call vdu_buff_select
0463C5             0246*   ; compute x-plot position
0463C5 DD 27 00    0247*       ld hl,(ix+bar_val)
0463C8 DD 07 0F    0248*       ld bc,(ix+bar_x)
0463CB 09          0249*       add hl,bc
0463CC 7D          0250*       ld a,l
0463CD E6 FC       0251*       and %11111100 ; round to nearest 4 pixels
0463CF 6F          0252*       ld l,a
0463D0 E5          0253*       push hl
0463D1 C1          0254*       pop bc
0463D2             0255*   ; get y-plot position
0463D2 DD 17 06    0256*       ld de,(ix+bar_y0)
0463D5 CD 1A 19 04 0257*       call vdu_plot_bmp
0463D9 C9          0258*       ret
0463DA             0259*   ; end bar_update_h
