0474CA             0294*   ; spawn a new active tile at the prescribed location
0474CA             0295*   ; inputs: hl = pointer to new tile default settings, tiles_x_plot, tiles_y_plot = x,y position
0474CA             0296*   ; returns: if new tile available, a = tile id, ix pointing to new tile vars, carry set
0474CA             0297*   ;      otherwise, a = 0, carry flag reset, ix invalid and must not be dereferenced
0474CA             0298*   ; destroys: a,hl,bc,de,ix
0474CA             0299*   ; affects: on success, bumps num_active_tiles by one, adds a tile pointer to the top of the tile stack
0474CA             0300*   spawn_active_tile:
0474CA E5          0301*       push hl ; back up pointer to new tile defaults
0474CB CD 74 73 04 0302*       call tile_table_get_next_id ; if available: a = new tile id, ix = pointer to new tile vars
0474CF E1          0303*       pop hl ; restore pointer to new tile defaults
0474D0 D0          0304*       ret nc ; no carry means no free tile slots, so we go home
0474D1             0305*   ; copy default settings to new tile
0474D1 DD 22 1C 73 0306*       ld (new_tile_table_pointer),ix ; save pointer to new tile record
       04          
0474D6 ED 32 16    0307*       lea ix,ix+tile_definitions ; bump pointer to copy to
0474D9 DD E5       0308*       push ix ; pointer to default tile settings
0474DB D1          0309*       pop de ; address to copy to
0474DC 01 13 00 00 0310*       ld bc,tile_definitions_size ; copy only bytes provided by defaults
0474E0 ED B0       0311*       ldir ; copies defaults to new tile record
0474E2             0312*   ; copy tile position from inputs
0474E2 DD 2A 1C 73 0313*       ld ix,(new_tile_table_pointer) ; reset pointer to new tile record
       04          
0474E7 2A 92 75 04 0314*       ld hl,(tiles_x_plot-1) ; shift up one byte to get 16.8 fixed point
0474EB DD 2F 01    0315*       ld (ix+tile_x),hl
0474EE 2A 96 75 04 0316*       ld hl,(tiles_y_plot-1) ; shift up one byte to get 16.8 fixed point
0474F2 DD 2F 04    0317*       ld (ix+tile_y),hl
0474F5             0318*   ; set default tile velocities
0474F5 21 00 00 00 0319*       ld hl,0
0474F9 DD 2F 07    0320*       ld (ix+tile_xvel),hl
0474FC DD 2F 0D    0321*       ld (ix+tile_vel),hl
