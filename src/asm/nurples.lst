047B26             0001*   lightning_defaults:
047B26 0A          0002*       db tile_lightning       ; type
047B27 50 01 00    0003*       dl BUF_LIGHTNING_H_0    ; base_bufferId
047B2A 43 7B 04    0004*       dl move_lightning       ; move_program
047B2D 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
047B2E 10          0006*       db 16                   ; dim_x
047B2F 10          0007*       db 16                   ; dim_y
047B30 01          0008*       db 1                    ; num_orientations
047B31 02          0009*       db 2                    ; num_animations
047B32 00          0010*       db 0                    ; animation
047B33 08          0011*       db 8                    ; animation_timer
047B34 00          0012*       db 0                    ; move_timer
047B35 00          0013*       db 0                    ; move_step
047B36 00          0014*       db 0                    ; points
047B37 FF          0015*       db -1                    ; shield_damage
047B38 00          0016*       db 0                    ; frame
047B39             0017*   
047B39             0018*   activate_lightning:
047B39 21 26 7B 04 0019*       ld hl,lightning_defaults
047B3D             0020*   ; get next available active tile id
047B3D CD 75 75 04 0021*       call spawn_active_tile
047B41 D0          0022*       ret nc ; no carry means no free active tile slots, so we go home
047B42             0023*   ; other specific initialization
047B42 C9          0024*       ret
047B43             0025*   ; end activate_lightning
047B43             0026*   
047B43             0027*   move_lightning:
047B43 CD CB 77 04 0028*       call move_active_tile
047B47 CA DD 74 04 0029*       jp z,table_deactivate_tile
047B4B CD BF 49 04 0030*       call check_enemy_collision_laser ; kills laser on collision but does not die
047B4F DD 21 1A 89 0031*       ld ix,player_begin
       04          
047B54 DD CB 1D 76 0032*       bit sprite_alive,(ix+sprite_collisions)
047B58 CA 68 7B 04 0033*       jp z,@animate ; player is dead so don't check for collisions
047B5C CD CB 49 04 0034*       call check_enemy_collision_player
047B60 C2 68 7B 04 0035*       jp nz,@animate ; no collision so do animation
047B64 CD F7 66 04 0036*       call update_shields
047B68             0037*   @animate:
047B68 FD 35 23    0038*       dec (iy+tile_animation_timer)
047B6B C0          0039*       ret nz ; not time to animate
047B6C             0040*   ; reset the animation timer and bump animation
047B6C 3E 08       0041*       ld a,8
047B6E FD 77 23    0042*       ld (iy+tile_animation_timer),a
047B71 FD 7E 28    0043*       ld a,(iy+tile_frame)
047B74 3C          0044*       inc a
047B75 E6 01       0045*       and %00000001 ; modulo 1
047B77 FD 77 28    0046*       ld (iy+tile_frame),a
047B7A C3 B9 78 04 0047*       jp draw_active_tile
047B7E C9          0048*       ret
