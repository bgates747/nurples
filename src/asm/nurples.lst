04775C 00 04 00    0151*   bg_bufferId: dl BUF_BG_STARS_0 ; default bufferId for background tiles
04775F             0152*   
04775F             0153*   bg_plot:
04775F             0154*   ; load current bg tile bufferId as default
04775F 2A 5C 77 04 0155*       ld hl,(bg_bufferId)
047763             0156*   ; check whether it is time for a new background tile
047763 3A 59 77 04 0157*       ld a,(bg_y_plot)
047767 3C          0158*       inc a
047768 32 59 77 04 0159*       ld (bg_y_plot),a
04776C C2 84 77 04 0160*       jp nz,@F ; not time for a new tile so draw current one
047770             0161*   ; load the next background tile
047770 21 00 04 00 0162*       ld hl,BUF_BG_STARS_0
047774 CD 14 05 04 0163*       call rand_8
047778 E6 03       0164*       and %0000011
04777A 85          0165*       add a,l
04777B 6F          0166*       ld l,a
04777C 3E 00       0167*       ld a,0
04777E 8C          0168*       adc a,h
04777F 67          0169*       ld h,a
047780 22 5C 77 04 0170*       ld (bg_bufferId),hl
047784             0171*   @@:
