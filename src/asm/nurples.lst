042138             0034*   move_enemy_seeker_orbit:
042138             0035*   ; compute x coordinate of orbit origin based on sprite id
042138 3E 05       0036*       ld a,seeker_min_sprite_id
04213A FD 96 00    0037*       sub (iy+sprite_id)
04213D 6F          0038*       ld l,a
04213E 26 55       0039*       ld h,85 ; 1/3 the playing field width
042140 ED 6C       0040*       mlt hl
042142 3E 40       0041*       ld a,64 ; 1/4 of the playing field width
042144 85          0042*       add a,l ; a = x coordinate of orbit origin
042145 FD 77 25    0043*       ld (iy+sprite_move_step),a ; as good a place as any to store it
042148             0044*   ; initialize orbit angle
042148 AF          0045*       xor a
042149 FD 77 13    0046*       ld (iy+sprite_orientation),a
04214C             0047*   ; ; initialize move timer
04214C             0048*   ;     inc a ; set to 1
04214C             0049*   ;     ld (iy+sprite_move_timer),a
04214C             0050*   ; init done, so update move program
04214C 21 53 21 04 0051*       ld hl,@stage1 ; update move program pointer
042150 FD 2F 1A    0052*       ld (iy+sprite_move_program),hl
042153             0053*   ; fall through to @stage1
042153             0054*   @stage1:
042153             0055*   ; ; check whether time to update orbit angle
042153             0056*   ;     dec (iy+sprite_move_timer)
042153             0057*   ;     jp nz,@F ; not time to change so simply movethe sprite on the current heading
042153             0058*   ;     inc (iy+sprite_move_timer) ; reset timer to 1
042153             0059*   ; update the target coordinates based on orbit angle and radius
042153 FD 34 13    0060*       inc (iy+sprite_orientation) ; increment angle
042156 21 00 00 00 0061*       ld hl,0 ; clear hlu and l
04215A FD 66 13    0062*       ld h,(iy+sprite_orientation) ; uh.l = angle
04215D 11 00 80 00 0063*       ld de,128*256 ; ud.e = radius
042161 CD F6 06 04 0064*       call polar_to_cartesian ; u.bc, u.de = x,y offsets
042165 FD 7E 25    0065*       ld a,(iy+sprite_move_step) ; x coordinate of orbit origin
042168 80          0066*       add a,b ; add x offset
042169 01 00 00 00 0067*       ld bc,0 ; bcu and c
04216D 47          0068*       ld b,a ; ub.c = x
04216E 21 00 A8 00 0069*       ld hl,336/2*256
042172 19          0070*       add hl,de
042173 EB          0071*       ex de,hl ; ud.e = y
042174 CD 6C 86 04 0072*       call bearing_to_coord ; uh.l = angle to coordinate
042178 FD 2F 10    0073*       ld (iy+sprite_heading),hl ; save angle as heading
04217B             0074*   ; compute component velocities, save them in sprite record, and move the sprite
04217B CD 28 83 04 0075*       call sprite_compute_velocities
04217F             0076*   @@:
04217F CD 87 82 04 0077*       call move_sprite ; move the sprite
042183 C3 87 21 04 0078*       jp move_enemy_seeker
