046707             0001*   ; sprite_type
046707             0002*   enemy_dead: equ 0
046707             0003*   enemy_air: equ 1
046707             0004*   enemy_ground: equ 2
046707             0005*   enemy_projectile: equ 3
046707             0006*   explosion: equ 4
046707             0007*   player: equ 5
046707             0008*   player_air: equ 6
046707             0009*   player_ground: equ 7
046707             0010*   
046707             0011*   ; ###### SPRITE TABLE FIELD INDICES ######
046707             0012*   table_record_size:         equ  64; bytes per sprite record
046707             0013*   sprite_id:                 equ   0; 1 bytes ;unique spriteId, zero-based
046707             0014*   ; sprite state variables
046707             0015*   sprite_state_variables:    equ   1; beginning of sprite state variables
046707             0016*   sprite_x:                  equ   1; 3 bytes ;16.8 fractional x position in pixels
046707             0017*   sprite_y:                  equ   4; 3 bytes ;16.8 fractional y position in pixels
046707             0018*   sprite_xvel:               equ   7; 3 bytes ;x-component velocity, 16.8 fixed, pixels
046707             0019*   sprite_yvel:               equ  10; 3 bytes ;y-component velocity, 16.8 fixed, pixels
046707             0020*   sprite_vel:                equ  13; 3 bytes ;velocity px/frame (16.8 fixed)
046707             0021*   sprite_heading:            equ  16; 3 bytes ;sprite movement direction deg256 16.8 fixed
046707             0022*   sprite_orientation:        equ  19; 3 bytes ;orientation bits
046707             0023*   ; sprite definition variables
046707             0024*   sprite_definitions:        equ  22; beginnning of sprite definition variables
046707             0025*   sprite_type:               equ  22; 1 bytes ;type of sprite as defined in enemies.inc
046707             0026*   sprite_base_bufferId:      equ  23; 3 bytes ;bitmap bufferId
046707             0027*   sprite_move_program:       equ  26; 3 bytes ;address of sprite's behavior subroutine
046707             0028*   sprite_collisions:         equ  29; 1 bytes ;see collisions.inc constants for bit definitions
046707             0029*   sprite_dim_x:              equ  30; 1 bytes ;sprite width in pixels
046707             0030*   sprite_dim_y:              equ  31; 1 bytes ;sprite height in pixels
046707             0031*   sprite_num_orientations:   equ  32; 1 bytes ;number of orientations for this sprite
046707             0032*   sprite_num_animations:     equ  33; 1 bytes ;number of animations for this sprite
046707             0033*   sprite_animation:          equ  34; 1 bytes ;current animation index, zero-based
046707             0034*   sprite_animation_timer:    equ  35; 1 bytes ;when hits zero, draw next animation
046707             0035*   sprite_move_timer:         equ  36; 1 bytes ;when zero, go to next move program, or step
046707             0036*   sprite_move_step:          equ  37; 1 bytes ;stage in a move program sequence, varies
046707             0037*   sprite_points:             equ  38; 1 bytes ;points awarded for killing this sprite type
046707             0038*   sprite_shield_damage:      equ  39; 1 bytes ;shield points deducted for collision
046707             0039*   sprite_frame:              equ  40; 1 bytes ;current animation frame
046707             0040*   sprite_definitions_size:   equ  sprite_frame-sprite_definitions+1
046707             0041*   
046707             0042*   ; ###### SPRITE TABLE VARIABLES ######
046707             0043*   ; pointer to top address of current record, initialized to table_base
046707 86 87 04    0044*   table_pointer: dl table_base
04670A             0045*   
04670A             0046*   ; flag indicating collision with screen edge
04670A 00          0047*   sprite_screen_edge: db #00
04670B             0048*   sprite_fault_bad_record: equ 0
04670B             0049*   sprite_fault_bad_move_program: equ 1
04670B 00          0050*   sprite_fault_flags: db 0 ; latched fail-closed diagnostics
04670C             0051*   
04670C             0052*   ; ######### COLLISION SPRITE PARAMETERS ##########
04670C             0053*   ; integer coordinates are all that are needed for collision calculations
04670C 00          0054*   collision_x: db 0x00
04670D 00          0055*   collision_y: db 0x00
04670E 00          0056*   collision_dim_x: db 0x00
04670F 00          0057*   collision_dim_y: db 0x00
046710             0058*   
046710             0059*   ; scratch variables
046710 00          0060*   x: db 0x00 ; 8-bit signed integer
046711 00          0061*   y: db 0x00 ; 8-bit signed integer
046712 00 00 00    0062*   x0: dl 0x000000 ; 16.8 signed fixed place
046715 00 00 00    0063*   y0: dl 0x000000 ; 16.8 signed fixed place
046718 00 00 00    0064*   incx1: dl 0x000000 ; 16.8 signed fixed place
04671B 00 00 00    0065*   incy1: dl 0x000000 ; 16.8 signed fixed place
04671E 00 00 00    0066*   incx2: dl 0x000000 ; 16.8 signed fixed place
046721 00 00 00    0067*   incy2: dl 0x000000 ; 16.8 signed fixed place
046724             0068*   
046724             0069*   ; sprite_heading: dl 0x000000 ; signed fixed 16.8
046724 00 00 00    0070*   radius: dl 0x000000 ; signed fixed 16.8 (but should always be positive)
046727 00 00 00    0071*   sin_sprite_heading: dl 0x000000 ; signed fixed 16.8
04672A 00 00 00    0072*   cos_sprite_heading: dl 0x000000 ; signed fixed 16.8
04672D             0073*   
04672D             0074*   table_init:
04672D             0075*   ; clear the sprite table
04672D AF          0076*       xor a ; write zeroes to sprite table
04672E 32 0B 67 04 0077*       ld (sprite_fault_flags),a
046732 21 86 87 04 0078*       ld hl,table_base ; address to copy from
046736 01 00 05 00 0079*       ld bc,table_end-table_base ; number of bytes to clear
04673A CD 5B 03 04 0080*       call clear_mem
04673E             0081*   ; write sprite ids
04673E DD 21 86 87 0082*       ld ix,table_base
       04          
046743 AF          0083*       xor a ; sprite id
046744 0E 00       0084*       ld c,0 ; sprite type
046746 06 14       0085*       ld b,table_num_records ; loop counter
046748             0086*   @loop:
046748 DD 77 00    0087*       ld (ix+sprite_id),a
04674B DD 71 16    0088*       ld (ix+sprite_type),c
04674E ED 32 40    0089*       lea ix,ix+table_record_size
046751 3C          0090*       inc a
046752 10 F4       0091*       djnz @loop
046754 C9          0092*       ret
046755             0093*   ; end table_init
046755             0094*   
046755             0095*   ; Validate a record pointer and its stable identity byte against the physical
046755             0096*   ; 64-byte slot it occupies in the sprite table.
046755             0097*   ; inputs: iy = candidate sprite record
046755             0098*   ; outputs: carry set only for an aligned in-range pointer with the expected id
046755             0099*   ; destroys: a,de,hl
046755             0100*   sprite_table_record_pointer_valid:
046755 FD E5       0101*       push iy
046757 E1          0102*       pop hl
046758 11 86 87 04 0103*       ld de,table_base
04675C B7          0104*       or a
04675D ED 52       0105*       sbc hl,de ; offset from the sprite-table base
04675F DA 89 67 04 0106*       jp c,@invalid
046763 11 00 05 00 0107*       ld de,table_end-table_base
046767 B7          0108*       or a
046768 ED 52       0109*       sbc hl,de
04676A D2 89 67 04 0110*       jp nc,@invalid
04676E 19          0111*       add hl,de ; restore the in-range offset
04676F 7D          0112*       ld a,l
046770 E6 3F       0113*       and table_record_size-1
046772 C2 89 67 04 0114*       jp nz,@invalid
046776             0115*   ; Convert the aligned offset to its record id: H*4 + L/64.
046776 7C          0116*       ld a,h
046777 87          0117*       add a,a
046778 87          0118*       add a,a
046779 57          0119*       ld d,a
04677A 7D          0120*       ld a,l
04677B 07          0121*       rlca
04677C 07          0122*       rlca
04677D E6 03       0123*       and %00000011
04677F B2          0124*       or d
046780 FD BE 00    0125*       cp (iy+sprite_id)
046783 C2 89 67 04 0126*       jp nz,@invalid
046787 37          0127*       scf
046788 C9          0128*       ret
046789             0129*   @invalid:
046789 AF          0130*       xor a
04678A C9          0131*       ret
04678B             0132*   ; end sprite_table_record_pointer_valid
04678B             0133*   
04678B             0134*   ; deactivate the sprite with the given id
04678B             0135*   ; inputs: iy set to sprite record
04678B             0136*   ; outputs: nothing
04678B             0137*   ; destroys: a,de,hl
04678B             0138*   table_deactivate_sprite:
04678B CD 55 67 04 0139*       call sprite_table_record_pointer_valid
04678F D2 AB 67 04 0140*       jp nc,@invalid
046793 FD 7E 00    0141*       ld a,(iy+sprite_id) ; get spriteId
046796 FD E5       0142*       push iy
046798 CD BB 19 04 0143*       call vdu_sprite_select ; select sprite
04679C CD 3F 1A 04 0144*       call vdu_sprite_hide
0467A0 FD E1       0145*       pop iy
0467A2 FD CB 1D B6 0146*       res sprite_alive,(iy+sprite_collisions)
0467A6 FD CB 1D BE 0147*       res sprite_just_died,(iy+sprite_collisions)
0467AA C9          0148*       ret
0467AB             0149*   @invalid:
0467AB 21 0B 67 04 0150*       ld hl,sprite_fault_flags
0467AF CB C6       0151*       set sprite_fault_bad_record,(hl)
0467B1 C9          0152*       ret
0467B2             0153*   ; end table_deactivate_sprite
0467B2             0154*   
0467B2             0155*   sprites_init:
0467B2             0156*   ; initialize sprites
0467B2 CD EF 1A 04 0157*   	call vdu_sprite_reset ; clear sprite data in vdp
0467B6             0158*   
0467B6             0159*   ; define player sprite
0467B6 3A 86 88 04 0160*   	ld a,(player_begin+sprite_id)
0467BA CD BB 19 04 0161*   	call vdu_sprite_select
0467BE CD CE 19 04 0162*   	call vdu_sprite_clear_frames
0467C2 21 73 01 00 0163*   	ld hl,BUF_SHIP_0L
0467C6 06 03       0164*   	ld b,3 ; DJNZ consumes B; loading BC with 3 would put zero in B
0467C8             0165*   @sprite_player_loop:
0467C8 C5          0166*   	push bc
0467C9 E5          0167*   	push hl
0467CA CD 10 1B 04 0168*   	call vdu_sprite_add_buff
0467CE E1          0169*   	pop hl
0467CF 23          0170*   	inc hl
0467D0 C1          0171*   	pop bc
0467D1 10 F5       0172*   	djnz @sprite_player_loop
0467D3             0173*   
0467D3             0174*   ; define player weapon sprites
0467D3 CD 52 65 04 0175*       call init_player_laser
0467D7             0176*   
0467D7             0177*   ; define enemy sprites
0467D7 CD 55 4C 04 0178*       call init_enemy_seekers
0467DB CD F2 4A 04 0179*       call init_enemy_fireballs
0467DF             0180*   
0467DF             0181*   ; define explosion sprites
0467DF CD 29 4D 04 0182*       call init_explosions
0467E3             0183*   
0467E3             0184*   ; activate only after every contiguous sprite has its final frame definitions
0467E3 3E 14       0185*       ld a,table_num_records
0467E5 CD EF 19 04 0186*   	call vdu_sprite_activate
0467E9 C9          0187*       ret
0467EA             0188*   ; end sprites_init
0467EA             0189*   
0467EA             0190*   ; gets the next available sprite id for a particular sprite group
0467EA             0191*   ; inputs; ix = pointer to sprite group, b = number of records in sprite group
0467EA             0192*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
0467EA             0193*   ;      otherwise, a = 0, carry reset, ix invalid and must not be dereferenced
0467EA             0194*   ; destroys: a,b,c,hl,ix
0467EA             0195*   table_get_next_id:
0467EA             0196*   @loop:
0467EA DD CB 1D 76 0197*       bit sprite_alive,(ix+sprite_collisions)
0467EE 28 07       0198*       jr z,@found
0467F0 ED 32 40    0199*       lea ix,ix+table_record_size
0467F3 10 F5       0200*       djnz @loop
0467F5             0201*   @notfound:
0467F5 AF          0202*       xor a ; a = 0 and reset carry flag indicating that we didn't find a free sprite
0467F6 C9          0203*       ret
0467F7             0204*   @found:
0467F7             0205*   ; return sprite id
0467F7 DD 7E 00    0206*       ld a,(ix+sprite_id)
0467FA 37          0207*       scf ; sets carry flag indicating we found a free sprite
0467FB C9          0208*       ret ; done
0467FC             0209*   ; end table_get_next_id
0467FC             0210*   
0467FC             0211*   ; create a new sprite at the prescribed coordinates
0467FC             0212*   ; inputs: hl = pointer to new sprite default settings, ub.c, ud.e = x,y position
0467FC             0213*   ;         ix = pointer to sprite group, a = number of records in sprite group
0467FC             0214*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
0467FC             0215*   ;      otherwise, a = 0, carry reset, ix invalid and must not be dereferenced
0467FC             0216*   spawn_sprite_from_coords:
0467FC ED 43 49 68 0217*       ld (@sprite_x),bc ; store x-coordinate
       04          
046801 ED 53 4C 68 0218*       ld (@sprite_y),de ; store y-coordinate
       04          
046806 47          0219*       ld b,a ; number of records in sprite group
046807 E5          0220*       push hl ; back up pointer to new sprite defaults
046808 CD EA 67 04 0221*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
04680C E1          0222*       pop hl ; restore pointer to new sprite defaults
04680D D0          0223*       ret nc ; no carry means no free sprite slots, so we go home
04680E             0224*   ; copy default settings to new sprite
04680E DD E5       0225*       push ix ; back up pointer to new sprite record
046810 ED 32 16    0226*       lea ix,ix+sprite_definitions ; bump pointer to copy to
046813 DD E5       0227*       push ix ; pointer to default sprite settings
046815 D1          0228*       pop de ; address to copy to
046816 01 13 00 00 0229*       ld bc,sprite_definitions_size ; copy only bytes provided by defaults
04681A ED B0       0230*       ldir ; copies defaults to new sprite record
04681C DD E1       0231*       pop ix ; restore pointer to new sprite record
04681E             0232*   ; copy sprite position from existing sprite
04681E 2A 49 68 04 0233*       ld hl,(@sprite_x)
046822 DD 2F 01    0234*       ld (ix+sprite_x),hl
046825 2A 4C 68 04 0235*       ld hl,(@sprite_y)
046829 DD 2F 04    0236*       ld (ix+sprite_y),hl
04682C             0237*   ; clear motion state retained by a previously used physical record
04682C 21 00 00 00 0238*       ld hl,0
046830 DD 2F 07    0239*       ld (ix+sprite_xvel),hl
046833 DD 2F 0A    0240*       ld (ix+sprite_yvel),hl
046836 DD 2F 0D    0241*       ld (ix+sprite_vel),hl
046839 DD 2F 10    0242*       ld (ix+sprite_heading),hl
04683C DD 2F 13    0243*       ld (ix+sprite_orientation),hl
04683F             0244*   ; return to caller
04683F DD CB 16 FE 0245*       set 7,(ix+sprite_type) ; set just spawned flag
046843 DD CB 1D F6 0246*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
046847 37          0247*       scf ; set carry flag to indicate success
046848 C9          0248*       ret
046849 00 00 00    0249*   @sprite_x: dl 0 ; new sprite x-coordinate
04684C 00 00 00    0250*   @sprite_y: dl 0 ; new sprite y-coordinate
04684F             0251*   ; end spawn_sprite_from_coords
04684F             0252*   
04684F             0253*   ; create a new sprite at the same location as an existing sprite
04684F             0254*   ; inputs: hl = pointer to new sprite default settings, table_pointer = existing sprite
04684F             0255*   ;         ix = pointer to sprite group, b = number of records in sprite group
04684F             0256*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
04684F             0257*   ;      otherwise, a = 0, carry reset, ix invalid and must not be dereferenced
04684F             0258*   spawn_sprite_from_sprite:
04684F E5          0259*       push hl ; back up pointer to new sprite defaults
046850 CD EA 67 04 0260*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
046854 E1          0261*       pop hl ; restore pointer to new sprite defaults
046855 D0          0262*       ret nc ; no carry means no free sprite slots, so we go home
046856             0263*   ; copy default settings to new sprite
046856 DD E5       0264*       push ix ; back up pointer to new sprite record
046858 ED 32 16    0265*       lea ix,ix+sprite_definitions ; bump pointer to copy to
04685B DD E5       0266*       push ix ; pointer to default sprite settings
04685D D1          0267*       pop de ; address to copy to
04685E 01 13 00 00 0268*       ld bc,sprite_definitions_size ; copy only bytes provided by defaults
046862 ED B0       0269*       ldir ; copies defaults to new sprite record
046864 DD E1       0270*       pop ix ; restore pointer to new sprite record
046866             0271*   ; copy sprite position from existing sprite
046866 FD 2A 07 67 0272*       ld iy,(table_pointer) ; get existing sprite record
       04          
04686B FD 27 01    0273*       ld hl,(iy+sprite_x)
04686E DD 2F 01    0274*       ld (ix+sprite_x),hl
046871 FD 27 04    0275*       ld hl,(iy+sprite_y)
046874 DD 2F 04    0276*       ld (ix+sprite_y),hl
046877             0277*   ; clear motion state retained by a previously used physical record
046877 21 00 00 00 0278*       ld hl,0
04687B DD 2F 07    0279*       ld (ix+sprite_xvel),hl
04687E DD 2F 0A    0280*       ld (ix+sprite_yvel),hl
046881 DD 2F 0D    0281*       ld (ix+sprite_vel),hl
046884 DD 2F 10    0282*       ld (ix+sprite_heading),hl
046887 DD 2F 13    0283*       ld (ix+sprite_orientation),hl
04688A             0284*   ; return to caller
04688A DD CB 16 FE 0285*       set 7,(ix+sprite_type) ; set just spawned flag
04688E DD CB 1D F6 0286*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
046892 37          0287*       scf ; set carry flag to indicate success
046893 C9          0288*       ret
046894             0289*   ; end spawn_sprite_from_sprite
046894             0290*   
046894             0291*   ; Exact stabilization whitelist for writable legacy sprite callbacks.
046894             0292*   ; inputs: iy = validated sprite record, hl = stored callback
046894             0293*   ; outputs: carry set only for an exact pool/type/program combination
046894             0294*   ; destroys: a,de,hl
046894             0295*   sprite_move_program_valid:
046894 FD 7E 00    0296*       ld a,(iy+sprite_id)
046897 FE 04       0297*       cp player_lasers_end_sprite_id
046899 DA B9 68 04 0298*       jp c,@player_laser
04689D FE 05       0299*       cp seeker_min_sprite_id
04689F DA 31 69 04 0300*       jp c,@invalid ; the player record is not dispatched by this routine
0468A3 FE 08       0301*       cp seekers_end_sprite_id
0468A5 DA D2 68 04 0302*       jp c,@seeker
0468A9 FE 0C       0303*       cp fireballs_end_sprite_id
0468AB DA 03 69 04 0304*       jp c,@fireball
0468AF FE 14       0305*       cp explosions_end_sprite_id
0468B1 DA 1C 69 04 0306*       jp c,@explosion
0468B5 C3 31 69 04 0307*       jp @invalid
0468B9             0308*   @player_laser:
0468B9 FD 7E 16    0309*       ld a,(iy+sprite_type)
0468BC FE 06       0310*       cp player_air
0468BE C2 31 69 04 0311*       jp nz,@invalid
