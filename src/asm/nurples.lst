044E25             0105*   ; inputs: tileset_ptr_idx, cur_level
044E25             0106*   init_level:
044E25             0107*   ; ; initialize sprites and active tiles table
044E25             0108*   ;     call sprites_init
044E25             0109*   ;     call table_init
044E25             0110*   ;     call tile_table_init
044E25             0111*   ; set pointers
044E25 CD C6 4D 04 0112*       call get_level_ptr ; ix points to level lookup record
044E29 DD 37 00    0113*       ld ix,(ix) ; ix points to level definition
044E2C             0114*   ; set tiles_cols
044E2C DD 7E 00    0115*       ld a,(ix+0)
044E2F 32 38 76 04 0116*       ld (tiles_cols),a
