048A02 00 00 00    0033*       dl 0 ; list terminator
048A05             0034*   tile_stack_end:
048A05 02 87 04    0035*   tile_stack_pointer: dl tile_stack ; pointer to current stack record, initialized to tile_stack
048A08 60 A0 04    0036*   tile_table_pointer: dl tile_table_base ; pointer to top address of current record, initialized to tile_table_base
048A0B 00 00 00    0037*   num_active_tiles: dl 0 ; how many active tiles
