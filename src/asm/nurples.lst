048A3D             0041*   tile_table_init:
048A3D             0042*   ; reset num active tiles
048A3D 21 00 00 00 0043*       ld hl,0
048A41 22 36 8A 04 0044*       ld (num_active_tiles),hl
048A45             0045*   ; reset next tile id
