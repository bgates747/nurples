0413E3             0094*   
0413E3             0095*   ; COLOUR MODES
0413E3             0096*   ; Mode	Effect
0413E3             0097*   ; 0	Set on-screen pixel to target colour value
0413E3             0098*   ; 1	OR value with the on-screen pixel
0413E3             0099*   ; 2	AND value with the on-screen pixel
0413E3             0100*   ; 3	XOR value with the on-screen pixel
0413E3             0101*   ; 4	Invert the on-screen pixel
0413E3             0102*   ; 5	No operation
0413E3             0103*   ; 6	AND the inverse of the specified colour with the on-screen pixel
0413E3             0104*   ; 7	OR the inverse of the specified colour with the on-screen pixel
0413E3             0105*   
