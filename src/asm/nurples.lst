048E76 10          0006*       db 16                   ; dim_x
048E77 10          0007*       db 16                   ; dim_y
048E78 01          0008*       db 1                    ; num_orientations
048E79 01          0009*       db 1                    ; num_animations
048E7A 00          0010*       db 0                    ; animation
048E7B 00          0011*       db 0                    ; animation_timer
048E7C 00          0012*       db 0                    ; move_timer
048E7D 00          0013*       db 0                    ; move_step
048E7E 05          0014*       db 5                    ; points
