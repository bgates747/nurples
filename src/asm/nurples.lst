048632             0001*   ; ###### tile TABLE FIELD INDICES ######
048632             0002*   tile_table_record_size:         equ  actor_record_size; bytes per tile record
048632             0003*   tile_id:                 equ   0; 1 bytes ;unique tileId, zero-based
048632             0004*   ; tile state variables
048632             0005*   tile_state_variables:    equ   1; beginning of tile state variables
048632             0006*   tile_x:                  equ   1; 3 bytes ;16.8 fractional x position in pixels
048632             0007*   tile_y:                  equ   4; 3 bytes ;16.8 fractional y position in pixels
048632             0008*   tile_xvel:               equ   7; 3 bytes ;x-component velocity, 16.8 fixed, pixels
048632             0009*   tile_yvel:               equ  10; 3 bytes ;y-component velocity, 16.8 fixed, pixels
048632             0010*   tile_vel:                equ  13; 3 bytes ;velocity px/frame (16.8 fixed)
048632             0011*   tile_heading:            equ  16; 3 bytes ;tile movement direction deg256 16.8 fixed
048632             0012*   tile_orientation:        equ  19; 3 bytes ;orientation bits
048632             0013*   ; tile definition variables
048632             0014*   tile_definitions:        equ  22; beginnning of tile definition variables
048632             0015*   tile_type:               equ  22; 1 bytes ;type of tile as defined in enemies.inc
048632             0016*   tile_base_bufferId:      equ  23; 3 bytes ;bitmap bufferId
048632             0017*   tile_move_program:       equ  26; 3 bytes ;address of tile's behavior subroutine
048632             0018*   tile_collisions:         equ  29; 1 bytes ;see collisions.inc constants for bit definitions
048632             0019*   tile_dim_x:              equ  30; 1 bytes ;tile width in pixels
048632             0020*   tile_dim_y:              equ  31; 1 bytes ;tile height in pixels
048632             0021*   tile_num_orientations:   equ  32; 1 bytes ;number of orientations for this tile
048632             0022*   tile_num_animations:     equ  33; 1 bytes ;number of animations for this tile
048632             0023*   tile_animation:          equ  34; 1 bytes ;current animation index, zero-based
048632             0024*   tile_animation_timer:    equ  35; 1 bytes ;when hits zero, draw next animation
048632             0025*   tile_move_timer:         equ  36; 1 bytes ;when zero, go to next move program, or step
048632             0026*   tile_move_step:          equ  37; 1 bytes ;stage in a move program sequence, varies
048632             0027*   tile_points:             equ  38; 1 bytes ;points awarded for killing this tile type
048632             0028*   tile_shield_damage:      equ  39; 1 bytes ;shield points deducted for collision
048632             0029*   tile_frame:              equ  40; 1 bytes ;current animation frame
048632             0030*   tile_definitions_size:   equ  tile_frame-tile_definitions+1
048632             0031*   tile_custom:             equ  actor_record_custom
048632             0032*       .if tile_table_record_size-actor_record_size
048632             0033*           dl tile_record_size_mismatch
048632             0034*       .endif
048632             0035*       .if [tile_definitions+tile_definitions_size]-actor_record_shared_end
048632             0036*           dl tile_shared_header_span_mismatch
048632             0037*       .endif
048632             0038*       .if tile_custom-actor_record_custom
048632             0039*           dl tile_custom_offset_mismatch
048632             0040*       .endif
