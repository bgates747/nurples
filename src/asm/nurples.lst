048A03             0040*   
048A03             0041*   tile_table_init:
048A03             0042*   ; reset num active tiles
048A03 21 00 00 00 0043*       ld hl,0
048A07 22 FC 89 04 0044*       ld (num_active_tiles),hl
048A0B             0045*   ; reset next tile id
048A0B AF          0046*       xor a
048A0C 32 FF 89 04 0047*       ld (next_tile_id),a
048A10             0048*   ; clear the tile stack
048A10 AF          0049*       xor a ; write zeroes to tile stack
048A11 21 F3 86 04 0050*       ld hl,tile_stack
048A15 01 03 03 00 0051*       ld bc,tile_stack_end-tile_stack
048A19 CD 5F 03 04 0052*       call clear_mem
048A1D             0053*   ; clear the tile table
048A1D AF          0054*       xor a ; write zeroes to tile table
048A1E 21 03 A4 04 0055*       ld hl,tile_table_base ; address to copy from
048A22 01 00 40 00 0056*       ld bc,tile_table_end-tile_table_base ; number of bytes to clear
048A26 CD 5F 03 04 0057*       call clear_mem
048A2A             0058*   ; write tile ids
048A2A DD 21 03 A4 0059*       ld ix,tile_table_base
       04          
048A2F AF          0060*       xor a ; tile id
048A30 06 00       0061*       ld b,0 ; loop counter
048A32             0062*   @loop:
048A32 DD 77 00    0063*       ld (ix+tile_id),a
048A35 ED 32 40    0064*       lea ix,ix+table_record_size
048A38 3C          0065*       inc a
048A39 10 F7       0066*       djnz @loop
048A3B             0067*   ; set pointers to top of tile stack and tile table
048A3B 21 FF 89 04 0068*       ld hl,next_tile_id
048A3F 3E FF       0069*       ld a,255 ; will wrap around to 0 on first call to create active tile
048A41 77          0070*       ld (hl),a
048A42 21 03 A4 04 0071*       ld hl,tile_table_base
048A46 22 F9 89 04 0072*       ld (tile_table_pointer),hl
048A4A 21 F3 86 04 0073*       ld hl,tile_stack
048A4E 22 F6 89 04 0074*       ld (tile_stack_pointer),hl
048A52 C9          0075*       ret
048A53             0076*   ; end tile_table_init
048A53             0077*   
048A53             0078*   ; gets the next available tile id
048A53             0079*   ; inputs; none
048A53             0080*   ; returns: if new tile available, a = tile id, ix pointing to new tile vars, carry set
048A53             0081*   ;      otherwise, a = 0, carry flag reset, ix pointing to highest tile vars
048A53             0082*   ; destroys: a,hl,ix
048A53             0083*   ; affects: on success, bumps num_active_tiles by one, adds a tile pointer to the top of the tile stack
048A53             0084*   tile_table_get_next_id:
048A53 21 FC 89 04 0085*       ld hl,num_active_tiles
048A57 34          0086*       inc (hl)
048A58 C2 5F 8A 04 0087*       jp nz,@F ; check rollover to > 256 active tiles
048A5C 35          0088*       dec (hl) ; undo increment
048A5D AF          0089*       xor a ; reset carry flag indicating that we didn't find a free tile
048A5E C9          0090*       ret
048A5F             0091*   @@:
048A5F 7E          0092*       ld a,(hl) ; number of active tiles
048A60             0093*   ; point ix to next tile record
048A60 21 FF 89 04 0094*       ld hl,next_tile_id
048A64 34          0095*       inc (hl)
048A65 56          0096*       ld d,(hl) ; index into tile table
048A66 1E 40       0097*       ld e,tile_table_record_size
048A68 ED 5C       0098*       mlt de ; de is now the offset to the table entry
048A6A DD 21 03 A4 0099*       ld ix,tile_table_base ; point to base address of tile table
       04          
048A6F DD 19       0100*       add ix,de ; ix is now the address of the table entry
048A71             0101*   ; add tile pointer to tile stack
