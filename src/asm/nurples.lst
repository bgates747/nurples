04662F 1D          0073*       dec e
046630 C2 11 66 04 0074*       jp nz,@sprites_loop
046634             0075*   ; set laser firing timer to zero
046634 FD 21 D0 65 0076*       ld iy,tmr_laser
       04          
046639 21 00 00 00 0077*       ld hl,0
04663D CD E4 12 04 0078*       call timestamp_tmr_set
