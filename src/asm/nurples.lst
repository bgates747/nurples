04A0C3             0081    
04A0C3             0082    ; --- MAIN PROGRAM FILE ---
04A0C3             0083    main:
04A0C3             0084    ; start a new game
04A0C3 AF          0085        xor a
04A0C4 32 F9 85 04 0086        ld (game_exit_requested),a
04A0C8 21 67 87 04 0087        ld hl,game_init
04A0CC 22 F5 85 04 0088        ld (game_state),hl
04A0D0             0089    main_loop:
04A0D0             0090    ; update the global timestamp
04A0D0 CD 8B 12 04 0091        call timestamp_tick
04A0D4             0092    ; do gamestate logic
04A0D4 CD FA 85 04 0093        call do_game
04A0D8             0094    ; state handlers return through the dispatcher; honor an orderly exit request
04A0D8 3A F9 85 04 0095        ld a,(game_exit_requested)
04A0DC B7          0096        or a
04A0DD C2 F6 A0 04 0097        jp nz,main_end
04A0E1             0098    ; wait for the next vblank mitigate flicker and for loop timing
04A0E1 CD F6 13 04 0099        call vdu_vblank
04A0E5             0100    ; poll keyboard for escape keypress
04A0E5 3E 08       0101        ld a, $08 ; code to send to MOS
04A0E7 5B CF       0102        rst.lil $08 ; get IX pointer to System Variables
04A0E9 DD 7E 05    0103        ld a, (ix + $05) ; get ASCII code of key pressed
04A0EC FE 1B       0104        cp 27 ; check if 27 (ascii code for ESC)
04A0EE CA F6 A0 04 0105        jp z, main_end ; if pressed, jump to exit
04A0F2             0106    ; escape not pressed so loop
04A0F2 C3 D0 A0 04 0107        jp main_loop
04A0F6             0108    
04A0F6             0109    main_end:
04A0F6             0110    ; restore original screen mode
04A0F6 3A 66 87 04 0111        ld a,(original_screen_mode)
04A0FA CD 67 14 04 0112        call vdu_set_screen_mode
04A0FE             0113    ; print thanks for playing message
04A0FE CD 5C 00 04 0114        call printInline
04A102 54 68 61 6E 0115        asciz "Thank you for playing\r\n"
       6B 20 79 6F 
       75 20 66 6F 
       72 20 70 6C 
       61 79 69 6E 
       67 0D 0A 00 
04A11A 21 AE 1A 04 0116        ld hl,purple_nurples_ascii
04A11E CD 63 00 04 0117        call printString
04A122 C9          0118        ret
04A123             0119    ; end main
04A123             0120    
04A123             0121    ; needs to be the final include to leave room for the sprite and tile tables
04A123             0122        include "tables.inc"
04A123             0001*   ; #### THIS IS THE SPACE ALLOCATED TO THE SPRITE TABLE ####
04A123             0002*   table_base: equ $
04A123             0003*   player_weapons_begin: equ table_base
04A123             0004*   player_lasers_begin: equ player_weapons_begin
04A123             0005*   player_lasers_end: equ table_record_size*player_lasers_max+player_lasers_begin
04A123             0006*   player_lasers_end_sprite_id: equ [player_lasers_end-table_base]/table_record_size
04A123             0007*   player_weapons_end: equ table_record_size*player_lasers_max+player_weapons_begin
04A123             0008*   player_begin: equ player_weapons_end
04A123             0009*   player_end: equ table_record_size+player_begin
04A123             0010*   enemy_sprites_begin: equ player_end
04A123             0011*   seekers_base: equ enemy_sprites_begin
04A123             0012*   seeker_min_sprite_id: equ [seekers_base-table_base]/table_record_size
04A123             0013*   seekers_end: equ table_record_size*seekers_max+seekers_base
04A123             0014*   seekers_end_sprite_id: equ [seekers_end-table_base]/table_record_size
04A123             0015*   fireballs_base: equ seekers_end
04A123             0016*   fireballs_end: equ table_record_size*fireballs_max+fireballs_base
