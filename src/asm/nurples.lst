044BC8             0046*   
044BC8             0047*   ; Enter orbit through an actor-owned initializer. Publish the legal callback
044BC8             0048*   ; only after every field owned by the target state is ready.
044BC8             0049*   ; inputs: iy = validated live seeker record
044BC8             0050*   ; destroys: a,de,hl
044BC8             0051*   seeker_enter_orbit:
044BC8             0052*   ; compute x coordinate of orbit origin based on sprite id
044BC8 3E 05       0053*       ld a,seeker_min_sprite_id
044BCA FD 96 00    0054*       sub (iy+sprite_id)
044BCD 6F          0055*       ld l,a
044BCE 26 55       0056*       ld h,85 ; 1/3 the playing field width
044BD0 ED 6C       0057*       mlt hl
044BD2 3E 40       0058*       ld a,64 ; 1/4 of the playing field width
044BD4 85          0059*       add a,l ; a = x coordinate of orbit origin
044BD5 FD 77 2B    0060*       ld (iy+seeker_orbit_origin_x),a
044BD8             0061*   ; initialize orbit angle and local state
044BD8 AF          0062*       xor a
044BD9 FD 77 2C    0063*       ld (iy+seeker_orbit_angle),a
044BDC 3E 01       0064*       ld a,seeker_state_orbit
044BDE FD 77 2A    0065*       ld (iy+seeker_state),a
044BE1             0066*   ; publish the initialized target behavior last
044BE1 21 0B 4C 04 0067*       ld hl,move_enemy_seeker_orbit_stage1
044BE5 FD 2F 1A    0068*       ld (iy+sprite_move_program),hl
044BE8 37          0069*       scf
044BE9 C9          0070*       ret
044BEA             0071*   ; end seeker_enter_orbit
044BEA             0072*   
044BEA             0073*   ; Return from a non-hostile hold through the same initialized-publication
044BEA             0074*   ; contract. Preserve position and heading; reset every field owned by seeking.
044BEA             0075*   ; inputs: IY = validated live seeker record
044BEA             0076*   seeker_enter_seek:
044BEA AF          0077*       xor a
044BEB FD 77 25    0078*       ld (iy+sprite_move_step),a
044BEE 3E 00       0079*       ld a,seeker_state_seek
044BF0 FD 77 2A    0080*       ld (iy+seeker_state),a
044BF3 CD 14 05 04 0081*       call rand_8
044BF7 E6 3F       0082*       and %00111111
044BF9 CB DF       0083*       set 3,a
044BFB FD 77 24    0084*       ld (iy+sprite_move_timer),a
044BFE 21 EC 4C 04 0085*       ld hl,en_nav_seek_zag
044C02 FD 2F 1A    0086*       ld (iy+sprite_move_program),hl
044C05 37          0087*       scf
044C06 C9          0088*       ret
044C07             0089*   ; end seeker_enter_seek
044C07             0090*   
044C07             0091*   ; Compatibility entry for reviewed legacy callers. Stored callbacks use only
044C07             0092*   ; the persistent stage below.
044C07             0093*   move_enemy_seeker_orbit:
044C07 CD C8 4B 04 0094*       call seeker_enter_orbit
044C0B             0095*   ; fall through to the persistent orbit behavior
044C0B             0096*   move_enemy_seeker_orbit_stage1:
044C0B             0097*   ; update the target coordinates based on orbit angle and radius
044C0B FD 34 2C    0098*       inc (iy+seeker_orbit_angle)
044C0E 21 00 00 00 0099*       ld hl,0 ; clear hlu and l
044C12 FD 66 2C    0100*       ld h,(iy+seeker_orbit_angle) ; uh.l = angle
044C15 11 00 80 00 0101*       ld de,128*256 ; ud.e = radius
044C19 CD E9 06 04 0102*       call polar_to_cartesian ; u.bc, u.de = x,y offsets
044C1D FD 7E 2B    0103*       ld a,(iy+seeker_orbit_origin_x)
044C20 80          0104*       add a,b ; add x offset
044C21 01 00 00 00 0105*       ld bc,0 ; bcu and c
044C25 47          0106*       ld b,a ; ub.c = x
044C26 21 00 A8 00 0107*       ld hl,336/2*256
044C2A 19          0108*       add hl,de
044C2B EB          0109*       ex de,hl ; ud.e = y
044C2C CD 2B 85 04 0110*       call bearing_to_coord ; uh.l = angle to coordinate
044C30 FD 2F 10    0111*       ld (iy+sprite_heading),hl ; save angle as heading
044C33             0112*   ; compute component velocities, save them in sprite record, and move the sprite
044C33 CD CF 7F 04 0113*       call sprite_compute_velocities
044C37             0114*   @@:
044C37 CD 2E 7F 04 0115*       call move_sprite ; move the sprite
044C3B C3 AF 4C 04 0116*       jp move_enemy_seeker
044C3F             0117*   ; end move_enemy_seeker_orbit
044C3F             0118*   
044C3F             0119*   ; Transition every live seeker without accepting an arbitrary callback or
044C3F             0120*   ; caller-supplied pool range.
044C3F             0121*   seeker_group_enter_orbit:
044C3F FD 21 22 A5 0122*       ld iy,seekers_base
       04          
044C44 06 03       0123*       ld b,seekers_max
044C46             0124*   @loop:
044C46 C5          0125*       push bc
044C47 CD DE 7B 04 0126*       call sprite_table_record_pointer_valid
044C4B D2 6E 4C 04 0127*       jp nc,@bad_record
044C4F FD CB 1D 76 0128*       bit sprite_alive,(iy+sprite_collisions)
044C53 CA 66 4C 04 0129*       jp z,@next
044C57 FD 7E 16    0130*       ld a,(iy+sprite_type)
044C5A E6 7F       0131*       and actor_type_mask
044C5C FE 01       0132*       cp enemy_air
044C5E C2 6E 4C 04 0133*       jp nz,@bad_record
044C62 CD C8 4B 04 0134*       call seeker_enter_orbit
044C66             0135*   @next:
044C66 ED 33 40    0136*       lea iy,iy+table_record_size
044C69 C1          0137*       pop bc
044C6A 10 DA       0138*       djnz @loop
044C6C 37          0139*       scf
044C6D C9          0140*       ret
044C6E             0141*   @bad_record:
044C6E 21 98 7B 04 0142*       ld hl,sprite_fault_flags
044C72 CB C6       0143*       set sprite_fault_bad_record,(hl)
044C74 C1          0144*       pop bc
044C75 AF          0145*       xor a
044C76 C9          0146*       ret
044C77             0147*   ; end seeker_group_enter_orbit
044C77             0148*   
044C77             0149*   seeker_group_enter_seek:
044C77 FD 21 22 A5 0150*       ld iy,seekers_base
       04          
044C7C 06 03       0151*       ld b,seekers_max
044C7E             0152*   @loop:
044C7E C5          0153*       push bc
044C7F CD DE 7B 04 0154*       call sprite_table_record_pointer_valid
044C83 D2 A6 4C 04 0155*       jp nc,@bad_record
044C87 FD CB 1D 76 0156*       bit sprite_alive,(iy+sprite_collisions)
044C8B CA 9E 4C 04 0157*       jp z,@next
044C8F FD 7E 16    0158*       ld a,(iy+sprite_type)
044C92 E6 7F       0159*       and actor_type_mask
044C94 FE 01       0160*       cp enemy_air
044C96 C2 A6 4C 04 0161*       jp nz,@bad_record
044C9A CD EA 4B 04 0162*       call seeker_enter_seek
044C9E             0163*   @next:
044C9E ED 33 40    0164*       lea iy,iy+table_record_size
044CA1 C1          0165*       pop bc
044CA2 10 DA       0166*       djnz @loop
044CA4 37          0167*       scf
044CA5 C9          0168*       ret
044CA6             0169*   @bad_record:
044CA6 21 98 7B 04 0170*       ld hl,sprite_fault_flags
044CAA CB C6       0171*       set sprite_fault_bad_record,(hl)
044CAC C1          0172*       pop bc
044CAD AF          0173*       xor a
044CAE C9          0174*       ret
044CAF             0175*   ; end seeker_group_enter_seek
044CAF             0176*   
044CAF             0177*   move_enemy_seeker:
044CAF DD 21 E2 A4 0178*       ld ix,player_begin
       04          
044CB4 DD CB 1D 76 0179*       bit sprite_alive,(ix+sprite_collisions)
044CB8 CA C4 4C 04 0180*       jp z,@F ; player is dead so don't check for collisions
044CBC CD 39 4A 04 0181*       call check_enemy_collision_player
044CC0 CA E4 4C 04 0182*       jp z,@player
044CC4             0183*   @@:
044CC4 CD 2D 4A 04 0184*       call check_enemy_collision_laser
044CC8 CA DC 4C 04 0185*       jp z,@laser
044CCC             0186*   ; change the animation frame to match heading
044CCC FD 7E 00    0187*       ld a,(iy+sprite_id)
044CCF CD 03 1A 04 0188*       call vdu_sprite_select
044CD3 CD FA 7F 04 0189*       call sprite_frame_heading ; a, sprite_frame set to heading-based frame
044CD7 CD 66 1A 04 0190*       call vdu_sprite_select_frame
044CDB C9          0191*       ret
044CDC             0192*   @laser:
044CDC CD E5 7A 04 0193*       call update_score
044CE0 C3 AA 4D 04 0194*       jp spawn_explosion
044CE4             0195*   @player:
044CE4 CD 42 7B 04 0196*       call update_shields
044CE8 C3 AA 4D 04 0197*       jp spawn_explosion
044CEC             0198*   ; end move_enemy_seeker
044CEC             0199*   
044CEC             0200*   ; contains the logic for how to move the enemy
044CEC             0201*   ; and then does the moving
044CEC             0202*   ; inputs: a fully-populated active sprite table
044CEC             0203*   ;         player position variables
044CEC             0204*   ; destroys: everything except index registers
044CEC             0205*   ; outputs: moving enemies
044CEC             0206*   en_nav_seek_zag:
044CEC             0207*   ; set velocity and orientation by player's relative location
044CEC             0208*   ; move enemies y-axis
044CEC             0209*   ; where is player relative to us?
044CEC CD D9 84 04 0210*       call orientation_to_player ; uh.l angle to player, ub.c, ud.e = dx, dy
044CF0             0211*   ; is player above or below us?
044CF0 ED 53 37 03 0212*       ld (ude),de ; dy
       04          
044CF5 3A 39 03 04 0213*       ld a,(ude+2) ; deu
044CF9 17          0214*       rla ; shift sign bit into carry
044CFA D2 23 4D 04 0215*       jp nc,@zig_zag ; player is below,evade
044CFE             0216*   ; player is even or above,so home in on current heading
044CFE FD 2F 10    0217*       ld (iy+sprite_heading),hl ; save sprite heading
044D01             0218*   ; fall through to @compute_velocities
044D01             0219*   @compute_velocities:
044D01 CD CF 7F 04 0220*       call sprite_compute_velocities
044D05 CD 2E 7F 04 0221*       call move_sprite ; move the sprite
044D09 B7          0222*       or a ; a will be non-zero if have collided with screen edge
044D0A C2 3A 4D 04 0223*       jp nz,@edge_switch ; switch direction, but never move twice in one frame
044D0E C3 AF 4C 04 0224*       jp move_enemy_seeker ; didn't hit an edge so check collisions and move sprite
044D12             0225*   @reset_zig_zag_timer:
044D12 FD 2A 94 7B 0226*       ld iy,(table_pointer)
       04          
044D17 CD 14 05 04 0227*       call rand_8
044D1B E6 3F       0228*       and %00111111 ; limit it to 64
044D1D CB DF       0229*       set 3,a ; make sure it's at least 8
044D1F FD 77 24    0230*       ld (iy+sprite_move_timer),a ; store it
044D22 C9          0231*       ret
044D23             0232*   @zig_zag:
044D23 FD 7E 24    0233*       ld a,(iy+sprite_move_timer)
044D26 3D          0234*       dec a
044D27 FD 77 24    0235*       ld (iy+sprite_move_timer),a
044D2A C2 62 4D 04 0236*       jp nz,@zig_zag_no_switch
044D2E             0237*   @zag_switch:
044D2E CD 46 4D 04 0238*       call @switch_zag_heading
044D32 CD 12 4D 04 0239*       call @reset_zig_zag_timer
044D36 C3 62 4D 04 0240*       jp @zig_zag_no_switch
044D3A             0241*   @edge_switch:
044D3A             0242*   ; The generic mover has already clamped/bounced this seeker. Choose the next
044D3A             0243*   ; zag and return through collision handling; moving again here can loop forever
044D3A             0244*   ; at the bottom edge because both zag headings point downward.
044D3A CD 46 4D 04 0245*       call @switch_zag_heading
044D3E CD 12 4D 04 0246*       call @reset_zig_zag_timer
044D42 C3 AF 4C 04 0247*       jp move_enemy_seeker
044D46             0248*   @switch_zag_heading:
044D46 FD 7E 25    0249*       ld a,(iy+sprite_move_step)
044D49 EE 01       0250*       xor %1 ; flips bit zero
044D4B FD 77 25    0251*       ld (iy+sprite_move_step),a ; store it
044D4E C2 5A 4D 04 0252*       jp nz,@right ; zag right
044D52             0253*   ;otherwise zag left
044D52 21 00 A0 00 0254*       ld hl,160*256; southwest heading
044D56 FD 2F 10    0255*       ld (iy+sprite_heading),hl ; save sprite heading
044D59 C9          0256*       ret
044D5A             0257*   @right:
044D5A 21 00 60 00 0258*       ld hl,96*256; southeast heading
044D5E FD 2F 10    0259*       ld (iy+sprite_heading),hl ; save sprite heading
044D61 C9          0260*       ret
044D62             0261*   @zig_zag_no_switch:
044D62             0262*       ; ld a,(sprite_orientation)
044D62 FD 27 10    0263*       ld hl,(iy+sprite_heading)
044D65 C3 01 4D 04 0264*       jp @compute_velocities
044D69             0265*   ; end en_nav_seek_zag
044D69             0266*   
044D69             0267*   
044D69             0268*   init_enemy_seekers:
044D69             0269*   ; set pointer to seeker sprite table
044D69 FD 21 22 A5 0270*       ld iy,seekers_base
       04          
044D6E FD 7E 00    0271*       ld a,(iy+sprite_id) ; sprite id
044D71 1E 03       0272*       ld e,seekers_max ; sprite loop counter
044D73             0273*   ; define seeker sprites
044D73             0274*   @sprites_loop:
044D73 F5          0275*       push af
044D74 D5          0276*       push de
044D75 CD 03 1A 04 0277*   	call vdu_sprite_select
044D79 CD 16 1A 04 0278*   	call vdu_sprite_clear_frames
044D7D 21 53 01 00 0279*   	ld hl,BUF_SEEKER_000
044D81 06 20       0280*   	ld b,32 ; 32 bitmaps for seeker
044D83             0281*   @frames_loop:
044D83 C5          0282*   	push bc
044D84 E5          0283*   	push hl
044D85 CD 58 1B 04 0284*   	call vdu_sprite_add_buff
044D89 E1          0285*   	pop hl
044D8A 23          0286*   	inc hl
044D8B C1          0287*   	pop bc
044D8C 10 F5       0288*   	djnz @frames_loop
044D8E D1          0289*       pop de ; sprite loop counter
044D8F F1          0290*       pop af ; sprite id
044D90 3C          0291*       inc a
044D91 1D          0292*       dec e
044D92 C2 73 4D 04 0293*       jp nz,@sprites_loop
044D96 C9          0294*       ret
044D97             0295*   ; end init_enemy_seekers
044D97             0055        include "explosion.inc"
044D97             0001*   explosion_custom_begin: equ actor_record_custom
044D97             0002*   explosion_custom_end: equ explosion_custom_begin
044D97             0003*       .if explosion_custom_end-explosion_custom_begin
044D97             0004*           dl explosion_custom_span_mismatch
044D97             0005*       .endif
044D97             0006*   
044D97             0007*   explosions_max: equ 8
044D97             0008*   explosion_animation_count: equ 5
044D97             0009*   explosion_animation_ticks: equ 8
044D97             0010*   ; One update clears the just-spawned flag, then every animation frame runs for
044D97             0011*   ; explosion_animation_ticks updates.
044D97             0012*   explosion_lifetime_updates: equ explosion_animation_count*explosion_animation_ticks+1
044D97             0013*   explosion_defaults:
044D97 04          0014*       db explosion            ; type
044D98 09 01 00    0015*       dl BUF_EXPLOSION_A	    ; base_bufferId
044D9B 14 4E 04    0016*       dl move_explosion	    ; move_program
044D9E 40          0017*       db %01000000            ; collisions bit 6 signals sprite alive
044D9F 07          0018*       db 7	                ; dim_x
044DA0 07          0019*       db 7                    ; dim_y
044DA1 01          0020*       db 1                    ; num_orientations
044DA2 05          0021*       db explosion_animation_count ; num_animations
044DA3 05          0022*       db explosion_animation_count ; animation
044DA4 08          0023*       db explosion_animation_ticks ; animation_timer
044DA5 00          0024*       db 0	                ; move_timer
044DA6 00          0025*       db 0	                ; move_step
044DA7 00          0026*       db 0	                ; points
044DA8 00          0027*       db 0	                ; shield_damage
044DA9 00          0028*       db 0                    ; frame
044DAA             0029*   
044DAA             0030*   spawn_explosion:
044DAA 21 97 4D 04 0031*       ld hl,explosion_defaults
044DAE DD 21 E2 A6 0032*       ld ix,explosions_base
       04          
044DB3 06 08       0033*       ld b,explosions_max
044DB5 CD 6A 7D 04 0034*       call spawn_sprite_from_sprite
044DB9 D2 14 7C 04 0035*       jp nc,table_deactivate_sprite ; no carry means no free sprite slots, so we deactivate parent sprite and go home
044DBD             0036*   ; other specific initialization
044DBD 21 00 00 00 0037*       ld hl,0
044DC1 DD 2F 07    0038*       ld (ix+sprite_xvel),hl
044DC4 21 00 01 00 0039*       ld hl,1*256
044DC8 DD 2F 0A    0040*       ld (ix+sprite_yvel),hl
044DCB             0041*   ; deactivate parent sprite
044DCB C3 14 7C 04 0042*       jp table_deactivate_sprite
044DCF             0043*   ; end spawn_explosion
044DCF             0044*   
044DCF             0045*   spawn_explosion_player:
044DCF FD 21 E2 A4 0046*       ld iy,player_begin
       04          
044DD4 FD 22 94 7B 0047*       ld (table_pointer),iy
       04          
044DD9 21 97 4D 04 0048*       ld hl,explosion_defaults
044DDD DD 21 E2 A6 0049*       ld ix,explosions_base
       04          
044DE2 06 08       0050*       ld b,explosions_max
044DE4 CD 6A 7D 04 0051*       call spawn_sprite_from_sprite
044DE8 D8          0052*       ret c ; carry is the only indication that IX names a valid explosion
044DE9             0053*   ; no slot: keep the player hidden and return failure without exposing invalid IX
044DE9 CD 14 7C 04 0054*       call table_deactivate_sprite
044DED AF          0055*       xor a ; clear carry after the VDU calls in table_deactivate_sprite
044DEE C9          0056*       ret
044DEF             0057*   ; end spawn_explosion_player
044DEF             0058*   
044DEF             0059*   tile_spawn_explosion:
044DEF 21 97 4D 04 0060*       ld hl,explosion_defaults
044DF3 DD 21 E2 A6 0061*       ld ix,explosions_base
       04          
044DF8 06 08       0062*       ld b,explosions_max
044DFA CD 57 8F 04 0063*       call spawn_sprite_from_tile
044DFE D2 51 8A 04 0064*       jp nc,table_deactivate_tile ; no carry means no free sprite slots, so we deactivate parent tile and go home
044E02             0065*   ; other specific initialization
044E02 21 00 00 00 0066*       ld hl,0
044E06 DD 2F 07    0067*       ld (ix+sprite_xvel),hl
044E09 21 00 01 00 0068*       ld hl,1*256
044E0D DD 2F 0A    0069*       ld (ix+sprite_yvel),hl
044E10             0070*   ; deactivate parent sprite
044E10 C3 51 8A 04 0071*       jp table_deactivate_tile
044E14             0072*   ; end tile_spawn_explosion
044E14             0073*   
044E14             0074*   move_explosion:
044E14             0075*   ; run the movement program for the explosion
044E14 CD 2E 7F 04 0076*       call move_sprite
044E18             0077*   ; neg_hlu destroys A on a vertical collision; the published edge byte is the
044E18             0078*   ; only reliable result of the generic mover
044E18 3A 97 7B 04 0079*       ld a,(sprite_screen_edge)
044E1C B7          0080*       or a ; non-zero means the explosion has reached a screen edge
044E1D C2 14 7C 04 0081*       jp nz,table_deactivate_sprite
044E21             0082*   ; do the animations
044E21 FD 35 23    0083*       dec (iy+sprite_animation_timer)
044E24 C0          0084*       ret nz ; not time to bump animation frame
044E25 FD 34 28    0085*       inc (iy+sprite_frame)
044E28 FD 35 22    0086*       dec (iy+sprite_animation)
044E2B CA 14 7C 04 0087*       jp z,table_deactivate_sprite ; reached the end of the animations
044E2F 3E 08       0088*       ld a,explosion_animation_ticks ; reset animation timer
044E31 FD 77 23    0089*       ld (iy+sprite_animation_timer),a
044E34 C9          0090*       ret
044E35             0091*   ; end move_explosion
044E35             0092*   
044E35             0093*   move_explosions:
044E35             0094*   ; initialize pointers and loop counter
044E35 FD 21 E2 A6 0095*       ld iy,explosions_base ; set iy to first record in table
       04          
044E3A 06 08       0096*       ld b,explosions_max ; loop counter
044E3C CD 71 7E 04 0097*       call move_sprite_group
044E40 C9          0098*       ret
044E41             0099*   ; end move_explosions
044E41             0100*   
044E41             0101*   init_explosions:
