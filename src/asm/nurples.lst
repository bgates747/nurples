0411B2             0159*   ; -----------------------------------------------
0411B2             0160*   prt_irq_init:
0411B2             0161*       ; set up interrupt vector table 2
0411B2 21 00 00 00 0162*   	ld hl,0
0411B6 3A 0C 01 00 0163*   	ld a,($10c)
0411BA 6F          0164*   	ld l,a
0411BB 3A 0D 01 00 0165*   	ld a,($10d)
0411BF 67          0166*   	ld h,a
0411C0             0167*   
0411C0             0168*   	; skip over CALL ($c3)
0411C0 23          0169*   	inc hl
0411C1             0170*   	; load address of jump into vector table 2 (in ram)
0411C1 ED 27       0171*   	ld hl,(hl)
0411C3             0172*   
0411C3             0173*   	; write CALL prt_irq_handler to vector table 2
0411C3 3E C3       0174*   	ld a,$c3
0411C5 77          0175*   	ld (hl),a
0411C6 23          0176*   	inc hl
0411C7 11 CE 11 04 0177*   	ld de,prt_irq_handler
0411CB ED 1F       0178*   	ld (hl),de
0411CD             0179*   
0411CD C9          0180*       ret
