04A25C             0580*   
04A25C             0581*   telemetry_policy_table:
04A25C 20          0582*       db STATE_NEW_POLICY_STATE_RENDER
04A25D 30          0583*       db STATE_NEW_POLICY_WORLD_RENDER+STATE_NEW_POLICY_STATE_RENDER
04A25E 31          0584*       db STATE_NEW_POLICY_INPUT+STATE_NEW_POLICY_WORLD_RENDER+STATE_NEW_POLICY_STATE_RENDER
04A25F 30          0585*       db STATE_NEW_POLICY_WORLD_RENDER+STATE_NEW_POLICY_STATE_RENDER
04A260 34          0586*       db STATE_NEW_POLICY_ACTOR_RENDER+STATE_NEW_POLICY_WORLD_RENDER+STATE_NEW_POLICY_STATE_RENDER
04A261 35          0587*       db STATE_NEW_POLICY_INPUT+STATE_NEW_POLICY_ACTOR_RENDER+STATE_NEW_POLICY_WORLD_RENDER+STATE_NEW_POLICY_STATE_RENDER
04A262 3F          0588*       db STATE_NEW_POLICY_INPUT+STATE_NEW_POLICY_ACTOR_UPDATE+STATE_NEW_POLICY_ACTOR_RENDER+STATE_NEW_POLICY_WORLD_UPDATE+STATE_NEW_POLICY_WORLD_RENDER+STATE_NEW_POLICY_STATE_RENDER
04A263 35          0589*       db STATE_NEW_POLICY_INPUT+STATE_NEW_POLICY_ACTOR_RENDER+STATE_NEW_POLICY_WORLD_RENDER+STATE_NEW_POLICY_STATE_RENDER
04A264 34          0590*       db STATE_NEW_POLICY_ACTOR_RENDER+STATE_NEW_POLICY_WORLD_RENDER+STATE_NEW_POLICY_STATE_RENDER
04A265 34          0591*       db STATE_NEW_POLICY_ACTOR_RENDER+STATE_NEW_POLICY_WORLD_RENDER+STATE_NEW_POLICY_STATE_RENDER
04A266 31          0592*       db STATE_NEW_POLICY_INPUT+STATE_NEW_POLICY_WORLD_RENDER+STATE_NEW_POLICY_STATE_RENDER
04A267 31          0593*       db STATE_NEW_POLICY_INPUT+STATE_NEW_POLICY_WORLD_RENDER+STATE_NEW_POLICY_STATE_RENDER
04A268 00          0594*       db 0
04A269 30          0595*       db STATE_NEW_POLICY_WORLD_RENDER+STATE_NEW_POLICY_STATE_RENDER
04A26A             0088        include "runtime_init.inc"
04A26A             0001*   ; Process-entry initialization
04A26A             0002*   ; ============================
04A26A             0003*   ;
04A26A             0004*   ; MOS RUN re-enters the resident binary; it does not restore DB/DL initializers.
04A26A             0005*   ; Only state whose lifetime is one application invocation belongs here. Session,
04A26A             0006*   ; level, life, table, loader, and arithmetic scratch state is initialized by its
04A26A             0007*   ; owning routine before first use.
04A26A             0008*   
04A26A             0009*   runtime_process_init:
04A26A             0010*   ; Process control bytes are ordinary resident RAM. Reset them explicitly on
04A26A             0011*   ; every MOS RUN instead of relying on their assembled DB values.
04A26A AF          0012*       xor a
04A26B 32 2A 80 04 0013*       ld (game_exit_requested),a
04A26F 32 8B 70 04 0014*       ld (player_event),a
04A273 32 8D 70 04 0015*       ld (player_dying_phase),a
04A277 32 8E 70 04 0016*       ld (player_dying_timer),a
04A27B 32 8F 70 04 0017*       ld (player_dying_spawns),a
04A27F             0018*   
04A27F             0019*   ; Diagnostic latches describe this invocation only.
04A27F 32 29 80 04 0020*       ld (game_fault_flags),a
04A283 32 50 4A 04 0021*       ld (enemies_fault_flags),a
04A287 32 8C 70 04 0022*       ld (player_fault_flags),a
04A28B 32 98 7B 04 0023*       ld (sprite_fault_flags),a
04A28F 32 42 89 04 0024*       ld (tile_fault_flags),a
04A293 32 77 13 04 0025*       ld (timer_fault_flags),a
04A297 32 3E 14 04 0026*       ld (vdu_timing_fault_flags),a
04A29B             0027*   
04A29B             0028*   ; Small persistent helpers that otherwise inherit their previous RUN values.
04A29B 32 97 4B 04 0029*       ld (seekers_count),a
04A29F 32 97 7B 04 0030*       ld (sprite_screen_edge),a
04A2A3 32 78 13 04 0031*       ld (oldTimeStamp),a
04A2A7 21 00 00 00 0032*       ld hl,0
04A2AB 22 4A 05 04 0033*       ld (seed1),hl
04A2AF 22 4D 05 04 0034*       ld (seed2),hl
04A2B3             0035*   
04A2B3             0036*   ; Publish valid dispatcher states before the first tick. Their owning init
04A2B3             0037*   ; routines will republish the same operational states after resources exist.
04A2B3 21 A0 81 04 0038*       ld hl,game_init
04A2B7 22 26 80 04 0039*       ld (game_state),hl
04A2BB 21 AD 4A 04 0040*       ld hl,enemies_alive
04A2BF 22 4D 4A 04 0041*       ld (enemies_state),hl
04A2C3 21 DE 73 04 0042*       ld hl,player_alive
04A2C7 22 88 70 04 0043*       ld (player_state),hl
04A2CB             0044*   
04A2CB             0045*   ; Restore the documented random seed and establish a current clock baseline.
04A2CB 3E 50       0046*       ld a,$50
04A2CD 32 28 05 04 0047*       ld (r_seed),a
04A2D1 CD AF 12 04 0048*       call timestamp_init
04A2D5 C9          0049*       ret
04A2D6             0050*   ; end runtime_process_init
04A2D6             0089    
04A2D6             0090    ; --- MAIN PROGRAM FILE ---
04A2D6             0091    main:
04A2D6             0092    ; Invalidate and rebuild the public observer record before touching any other
04A2D6             0093    ; resident process state. MOS RUN does not reload initialized data.
04A2D6 CD 54 9E 04 0094        call telemetry_init
04A2DA CD 6A A2 04 0095        call runtime_process_init
04A2DE             0096    ; Capture the caller's display mode exactly once, before game_init changes VDP
04A2DE             0097    ; state. In-process restarts must not replace this with the gameplay mode.
04A2DE CD 11 15 04 0098        call vdu_get_screen_mode
04A2E2 32 9C 81 04 0099        ld (original_screen_mode),a
04A2E6             0100    ; MODE destroys VDP contexts, but the current logical text colours are exposed
04A2E6             0101    ; through the MOS screen-pixel result packet. Preserve each value independently
04A2E6             0102    ; so a failed VDP query degrades to the explicit white-on-black handoff.
04A2E6 AF          0103        xor a
04A2E7 32 9F 81 04 0104        ld (original_text_colours_valid),a
04A2EB 3E 80       0105        ld a,128
04A2ED CD 3F 14 04 0106        call vdu_get_text_colour
04A2F1 D2 03 A3 04 0107        jp nc,@capture_background
04A2F5 32 9D 81 04 0108        ld (original_text_foreground),a
04A2F9 3A 9F 81 04 0109        ld a,(original_text_colours_valid)
04A2FD F6 01       0110        or %00000001
04A2FF 32 9F 81 04 0111        ld (original_text_colours_valid),a
04A303             0112    @capture_background:
04A303 3E 81       0113        ld a,129
04A305 CD 3F 14 04 0114        call vdu_get_text_colour
04A309 D2 1B A3 04 0115        jp nc,@capture_complete
04A30D 32 9E 81 04 0116        ld (original_text_background),a
04A311 3A 9F 81 04 0117        ld a,(original_text_colours_valid)
04A315 F6 02       0118        or %00000010
04A317 32 9F 81 04 0119        ld (original_text_colours_valid),a
04A31B             0120    @capture_complete:
04A31B             0121    main_loop:
04A31B             0122    ; update the global timestamp
04A31B CD C7 12 04 0123        call timestamp_tick
04A31F             0124    ; do gamestate logic
04A31F CD 2B 80 04 0125        call do_game
04A323             0126    ; state handlers return through the dispatcher; honor an orderly exit request
04A323 3A 2A 80 04 0127        ld a,(game_exit_requested)
04A327 B7          0128        or a
04A328 C2 45 A3 04 0129        jp nz,@state_exit
04A32C             0130    ; Production pacing: one vblank. Two-vblank review lives in /test/nurples.
04A32C CD 8F 14 04 0131        call vdu_vblank
04A330             0132    ; poll keyboard for escape keypress
04A330 3E 08       0133        ld a, $08 ; code to send to MOS
04A332 5B CF       0134        rst.lil $08 ; get IX pointer to System Variables
04A334 DD 7E 05    0135        ld a, (ix + $05) ; get ASCII code of key pressed
04A337 FE 1B       0136        cp 27 ; check if 27 (ascii code for ESC)
04A339 CA 51 A3 04 0137        jp z,@escape
04A33D CD E9 9E 04 0138        call telemetry_tick
04A341             0139    ; escape not pressed so loop
04A341 C3 1B A3 04 0140        jp main_loop
04A345             0141    
04A345             0142    @state_exit:
04A345 CD 47 9E 04 0143        call telemetry_request_exit
04A349 CD EF 9E 04 0144        call telemetry_publish_terminal
04A34D C3 5D A3 04 0145        jp main_end
04A351             0146    @escape:
04A351 CD 47 9E 04 0147        call telemetry_request_exit
04A355 CD E9 9E 04 0148        call telemetry_tick
04A359 C3 5D A3 04 0149        jp main_end
04A35D             0150    
04A35D             0151    main_end:
04A35D             0152    ; Release application-owned VDP state. Select the permanent system font before
04A35D             0153    ; deleting the custom-font buffer, and detach sprites before their bitmaps.
04A35D 21 FF FF 00 0154        ld hl,65535
04A361 AF          0155        xor a
04A362 CD AF 18 04 0156        call vdu_font_select
04A366 CD 37 1B 04 0157        call vdu_sprite_reset
04A36A CD 3D 18 04 0158        call vdu_clear_all_buffers
04A36E             0159    ; restore original screen mode
04A36E 3A 9C 81 04 0160        ld a,(original_screen_mode)
04A372 CD 00 15 04 0161        call vdu_set_screen_mode
04A376             0162    ; MODE resets the context. Reassert a permanent font and deterministic farewell
04A376             0163    ; colours explicitly: white text on a freshly cleared black text background.
04A376 CD 9B 13 04 0164        call vdu_select_text_cursor
04A37A 21 FF FF 00 0165        ld hl,65535
04A37E AF          0166        xor a
04A37F CD AF 18 04 0167        call vdu_font_select
04A383 3E 80       0168        ld a,c_black+128
04A385 CD FB 13 04 0169        call vdu_colour_text
04A389 3E 0F       0170        ld a,c_white
04A38B CD FB 13 04 0171        call vdu_colour_text
04A38F CD CA 13 04 0172        call vdu_cls
04A393 CD 7F 13 04 0173        call vdu_cursor_on
04A397 CD 5C 00 04 0174        call printInline
04A39B 54 68 61 6E 0175        asciz "Thank you for playing\r\n"
       6B 20 79 6F 
       75 20 66 6F 
       72 20 70 6C 
       61 79 69 6E 
       67 0D 0A 00 
04A3B3 21 6A 44 04 0176        ld hl,purple_nurples_ascii
04A3B7 CD 63 00 04 0177        call printString
04A3BB             0178    ; Leave subsequent MOS text using the caller's logical colours when the VDP
04A3BB             0179    ; reported them. The already-rendered farewell remains white on black.
04A3BB 3A 9F 81 04 0180        ld a,(original_text_colours_valid)
04A3BF CB 4F       0181        bit 1,a
04A3C1 CA CF A3 04 0182        jp z,@restore_foreground
04A3C5 3A 9E 81 04 0183        ld a,(original_text_background)
04A3C9 F6 80       0184        or 128
04A3CB CD FB 13 04 0185        call vdu_colour_text
04A3CF             0186    @restore_foreground:
04A3CF 3A 9F 81 04 0187        ld a,(original_text_colours_valid)
04A3D3 CB 47       0188        bit 0,a
04A3D5 CA E1 A3 04 0189        jp z,@display_restored
04A3D9 3A 9D 81 04 0190        ld a,(original_text_foreground)
04A3DD CD FB 13 04 0191        call vdu_colour_text
04A3E1             0192    @display_restored:
04A3E1 C9          0193        ret
04A3E2             0194    ; end main
04A3E2             0195    
04A3E2             0196    ; needs to be the final include to leave room for the sprite and tile tables
04A3E2             0197        include "tables.inc"
04A3E2             0001*   ; #### THIS IS THE SPACE ALLOCATED TO THE SPRITE TABLE ####
04A3E2             0002*   table_base: equ $
04A3E2             0003*   player_weapons_begin: equ table_base
04A3E2             0004*   player_lasers_begin: equ player_weapons_begin
04A3E2             0005*   player_lasers_end: equ table_record_size*player_lasers_max+player_lasers_begin
04A3E2             0006*   player_lasers_end_sprite_id: equ [player_lasers_end-table_base]/table_record_size
04A3E2             0007*   player_weapons_end: equ table_record_size*player_lasers_max+player_weapons_begin
04A3E2             0008*   player_begin: equ player_weapons_end
04A3E2             0009*   player_end: equ table_record_size+player_begin
04A3E2             0010*   enemy_sprites_begin: equ player_end
04A3E2             0011*   seekers_base: equ enemy_sprites_begin
04A3E2             0012*   seeker_min_sprite_id: equ [seekers_base-table_base]/table_record_size
04A3E2             0013*   seekers_end: equ table_record_size*seekers_max+seekers_base
04A3E2             0014*   seekers_end_sprite_id: equ [seekers_end-table_base]/table_record_size
04A3E2             0015*   fireballs_base: equ seekers_end
04A3E2             0016*   fireballs_end: equ table_record_size*fireballs_max+fireballs_base
04A3E2             0017*   fireballs_end_sprite_id: equ [fireballs_end-table_base]/table_record_size
04A3E2             0018*   enemy_sprites_end: equ fireballs_end
04A3E2             0019*   explosions_base: equ enemy_sprites_end
04A3E2             0020*   explosions_end: equ table_record_size*explosions_max+explosions_base
04A3E2             0021*   explosions_end_sprite_id: equ [explosions_end-table_base]/table_record_size
04A3E2             0022*   table_end: equ explosions_end
04A3E2             0023*   
04A3E2             0024*   table_num_records: equ [table_end-table_base]/table_record_size
04A3E2             0025*   table_num_enemy_records: equ [enemy_sprites_end-enemy_sprites_begin]/table_record_size
04A3E2             0026*   
04A3E2             0027*   ; ### THIS IS THE SPACE ALLOCATED TO THE ACTIVE TILES TABLE ###
04A3E2             0028*   tile_table_base: equ table_end
04A3E2             0029*   tile_table_end: equ 256*tile_table_record_size+tile_table_base
