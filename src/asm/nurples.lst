04418C             1104*   agnb_audio_meta_format:    equ 2 ; u8 VDP format; version 0.2 requires 0x09
04418C             1105*   agnb_audio_meta_rate:      equ 3 ; u16 sample rate in Hz
04418C             1106*   agnb_audio_meta_data_size: equ 5 ; u32 DATA payload size
04418C             1107*   agnb_audio_meta_size:      equ 9
04418C             1108*   
