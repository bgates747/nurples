049350 CD 32 81 04 0040*       call update_score
049354 C3 58 93 04 0041*       jp kill_electrode
049358             0042*   ; end move_electrode
049358             0043*   
049358             0044*   kill_electrode:
049358             0045*   ; Preserve the source record itself. Removing earlier stack entries may change
049358             0046*   ; its dense-stack slot, so the slot is rediscovered after the scan.
049358 FD 22 A7 94 0047*       ld (@source_tile_pointer),iy
       04          
04935D FD 27 04    0048*       ld hl,(iy+tile_y)
049360 22 A4 94 04 0049*       ld (@tile_y),hl
049364             0050*   ; activate blank tile bitmap only after source data no longer depends on IY
049364 21 76 01 00 0051*       ld hl,BUF_TILE_BLANK
049368 CD 93 14 04 0052*       call vdu_buff_select
04936C             0053*   ; Bound the scan to the entry count at its start. Each processed or removed
04936C             0054*   ; entry consumes one unit; removal leaves IX on the shifted successor.
04936C 3A 57 8D 04 0055*       ld a,(num_active_tiles)
049370 32 AA 94 04 0056*       ld (@tiles_remaining),a
049374 DD 21 4E 8A 0057*       ld ix,tile_stack ; set ix to first record in table
       04          
049379             0058*   @check_loop:
049379 3A AA 94 04 0059*       ld a,(@tiles_remaining)
04937D B7          0060*       or a
04937E CA 30 94 04 0061*       jp z,@scan_done
049382 3D          0062*       dec a
049383 32 AA 94 04 0063*       ld (@tiles_remaining),a
049387             0064*   ; validate the stack slot before loading its pointer
049387 DD E5       0065*       push ix
049389 E1          0066*       pop hl
04938A CD 02 8E 04 0067*       call tile_stack_pointer_valid
04938E D2 30 94 04 0068*       jp nc,@scan_done
049392 DD 22 A1 94 0069*       ld (@tile_stack_pointer),ix ; update stack pointer
       04          
049397             0070*   ; validate the record before reading any fields
049397 DD 31 00    0071*       ld iy,(ix)
04939A CD 3B 8E 04 0072*       call tile_table_record_pointer_valid
04939E D2 0C 94 04 0073*       jp nc,@bad_record
0493A2             0074*   ; check top bit of tile_type to see if tile is just spawned
0493A2 FD CB 16 7E 0075*       bit 7,(iy+tile_type)
0493A6 C2 24 94 04 0076*       jp nz,@next_record ; if just spawned, skip to next record
0493AA             0077*   ; check sprite_alive bit to see if tile is active
0493AA FD CB 1D 76 0078*       bit sprite_alive,(iy+tile_collisions)
0493AE CA FA 93 04 0079*       jp z,@inactive_record
0493B2             0080*   ; check tile type
0493B2 FD 7E 16    0081*       ld a,(iy+tile_type)
0493B5 FE 0A       0082*       cp tile_lightning ; check if tile is lightning
0493B7 C2 24 94 04 0083*       jp nz,@next_record ; if not lightning, skip to next record
0493BB             0084*   ; check tile position
0493BB DD 22 51 8D 0085*       ld (tile_stack_pointer),ix
       04          
0493C0 FD 22 54 8D 0086*       ld (tile_table_pointer),iy
       04          
0493C5 FD 27 04    0087*       ld hl,(iy+tile_y)
0493C8 ED 5B A4 94 0088*       ld de,(@tile_y)
       04          
0493CD B7          0089*       or a ; clear carry
0493CE E5          0090*       push hl
0493CF ED 52       0091*       sbc hl,de
0493D1 E1          0092*       pop hl
0493D2 CA E2 93 04 0093*       jp z,@kill_it
0493D6 01 00 01 00 0094*       ld bc,1*256
0493DA 09          0095*       add hl,bc
0493DB B7          0096*       or a
0493DC ED 52       0097*       sbc hl,de
0493DE C2 24 94 04 0098*       jp nz,@next_record
0493E2             0099*   @kill_it: ; deactivate tile and replace with inactive blank tile
0493E2 FD 07 01    0100*       ld bc,(iy+tile_x) ; get x position (ud.e already has y-position)
0493E5 FD E5       0101*       push iy
0493E7 CD BF 18 04 0102*       call vdu_plot_bmp168 ; plot blank tile (bitmap was activated at beginning of proc)
0493EB FD E1       0103*       pop iy
0493ED CD 71 8E 04 0104*       call table_deactivate_tile
0493F1 DD 2A A1 94 0105*       ld ix,(@tile_stack_pointer) ; get back stack pointer
       04          
0493F6 C3 79 93 04 0106*       jp @check_loop ; deactivate tile naturally advances to next record
0493FA             0107*   @inactive_record:
0493FA             0108*   ; A valid inactive record violates the dense-stack invariant but is safe to
0493FA             0109*   ; remove. Keep IX on this slot so the shifted successor is checked next.
0493FA DD 22 51 8D 0110*       ld (tile_stack_pointer),ix
       04          
0493FF CD 71 8E 04 0111*       call table_deactivate_tile
049403 DD 2A A1 94 0112*       ld ix,(@tile_stack_pointer)
       04          
049408 C3 79 93 04 0113*       jp @check_loop
04940C             0114*   @bad_record:
04940C             0115*   ; The slot itself was validated, so it can be quarantined without touching the
04940C             0116*   ; malformed record pointer. Continue at the successor shifted into this slot.
04940C 21 5E 8D 04 0117*       ld hl,tile_fault_flags
049410 CB C6       0118*       set tile_fault_bad_record,(hl)
049412 DD 22 51 8D 0119*       ld (tile_stack_pointer),ix
       04          
049417 CD B5 8E 04 0120*       call tile_stack_quarantine_entry
04941B DD 2A A1 94 0121*       ld ix,(@tile_stack_pointer)
       04          
049420 C3 79 93 04 0122*       jp @check_loop
049424             0123*    ; get back stack pointer and loop
049424             0124*   @next_record:
049424 DD 2A A1 94 0125*       ld ix,(@tile_stack_pointer)
       04          
049429 ED 32 03    0126*       lea ix,ix+3 ; next tile stack record
04942C C3 79 93 04 0127*       jp @check_loop ; loop until we've checked all the records
049430             0128*   @scan_done:
049430             0129*   ; Rediscover the source cursor after any compaction. This search is bounded by
049430             0130*   ; the current dense-stack count and validates each slot before loading it.
049430 3A 57 8D 04 0131*       ld a,(num_active_tiles)
049434 32 AA 94 04 0132*       ld (@tiles_remaining),a
049438 FD 21 4E 8A 0133*       ld iy,tile_stack
       04          
04943D             0134*   @find_loop:
04943D 3A AA 94 04 0135*       ld a,(@tiles_remaining)
049441 B7          0136*       or a
049442 CA 84 94 04 0137*       jp z,@source_not_found
049446 3D          0138*       dec a
049447 32 AA 94 04 0139*       ld (@tiles_remaining),a
04944B FD E5       0140*       push iy
04944D E1          0141*       pop hl
04944E CD 02 8E 04 0142*       call tile_stack_pointer_valid
049452 D2 84 94 04 0143*       jp nc,@source_not_found
049456 FD 27 00    0144*       ld hl,(iy)
049459 ED 33 03    0145*       lea iy,iy+3 ; next tile stack record
04945C ED 5B A7 94 0146*       ld de,(@source_tile_pointer)
       04          
049461 B7          0147*       or a ; clear carry
049462 ED 52       0148*       sbc hl,de ; if not the same address, loop
049464 C2 3D 94 04 0149*       jp nz,@find_loop
049468 ED 33 FD    0150*       lea iy,iy-3 ; back up to the record we want
04946B FD 22 51 8D 0151*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
049470 FD 37 00    0152*       ld iy,(iy) ; iy points to the tile stack record
049473 CD 3B 8E 04 0153*       call tile_table_record_pointer_valid
049477 D2 84 94 04 0154*       jp nc,@source_not_found
04947B FD 22 54 8D 0155*       ld (tile_table_pointer),iy ; set pointer to this tile record
       04          
049480 C3 D0 92 04 0156*       jp transform_active_tile_to_crater
049484             0157*   @source_not_found:
049484             0158*   ; Fail closed and make the outer traversal's normal +3 step land exactly on
049484             0159*   ; the current logical end. It will then stop on the validated range check.
049484 21 5E 8D 04 0160*       ld hl,tile_fault_flags
049488 CB C6       0161*       set tile_fault_bad_record,(hl)
04948A 3A 57 8D 04 0162*       ld a,(num_active_tiles)
04948E 21 00 00 00 0163*       ld hl,0
049492 67          0164*       ld h,a
049493 2E 03       0165*       ld l,3
049495 ED 6C       0166*       mlt hl
049497 11 4B 8A 04 0167*       ld de,tile_stack-3
04949B 19          0168*       add hl,de
04949C 22 51 8D 04 0169*       ld (tile_stack_pointer),hl
0494A0 C9          0170*       ret
0494A1 4E 8A 04    0171*   @tile_stack_pointer: dl tile_stack ; pointer to current stack record, initialized to tile_stack
0494A4 00 00 00    0172*   @tile_y: dl 0 ; y position of tiles to kill
0494A7 00 00 00    0173*   @source_tile_pointer: dl 0
0494AA 00          0174*   @tiles_remaining: db 0
0494AB             0175*   ; end move_electrode
0494AB             0077        include "tile_lightning.inc"
0494AB             0001*   lightning_defaults:
0494AB 0A          0002*       db tile_lightning       ; type
0494AC 50 01 00    0003*       dl BUF_LIGHTNING_H_0    ; base_bufferId
0494AF C8 94 04    0004*       dl move_lightning       ; move_program
0494B2 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
0494B3 10          0006*       db 16                   ; dim_x
0494B4 10          0007*       db 16                   ; dim_y
0494B5 01          0008*       db 1                    ; num_orientations
0494B6 02          0009*       db 2                    ; num_animations
0494B7 00          0010*       db 0                    ; animation
0494B8 08          0011*       db 8                    ; animation_timer
0494B9 00          0012*       db 0                    ; move_timer
0494BA 00          0013*       db 0                    ; move_step
0494BB 00          0014*       db 0                    ; points
0494BC FF          0015*       db -1                    ; shield_damage
0494BD 00          0016*       db 0                    ; frame
0494BE             0017*   
0494BE             0018*   activate_lightning:
0494BE 21 AB 94 04 0019*       ld hl,lightning_defaults
0494C2             0020*   ; get next available active tile id
0494C2 CD 09 8F 04 0021*       call spawn_active_tile
0494C6 D0          0022*       ret nc ; no carry means no free active tile slots, so we go home
0494C7             0023*   ; other specific initialization
0494C7 C9          0024*       ret
0494C8             0025*   ; end activate_lightning
0494C8             0026*   
0494C8             0027*   move_lightning:
0494C8 CD 50 91 04 0028*       call move_active_tile
0494CC CA 71 8E 04 0029*       jp z,table_deactivate_tile
