048E9D CD 56 18 04 0092*       call vdu_plot_bmp168 ; plot blank tile (bitmap was activated at beginning of proc)
048EA1 CD 83 8A 04 0093*       call table_deactivate_tile
048EA5 DD 2A E1 8E 0094*       ld ix,(@tile_stack_pointer) ; get back stack pointer
       04          
048EAA C3 45 8E 04 0095*       jp @check_loop ; deactivate tile naturally advances to next record
048EAE             0096*    ; get back stack pointer and loop
048EAE             0097*   @next_record:
048EAE DD 2A E1 8E 0098*       ld ix,(@tile_stack_pointer)
       04          
048EB3 ED 32 03    0099*       lea ix,ix+3 ; next tile stack record
048EB6 C3 45 8E 04 0100*       jp @check_loop ; loop until we've checked all the records
048EBA             0101*   @done:
048EBA             0102*   ; find this tile record in the tile stack
048EBA D1          0103*       pop de ; restore pointer to this tile table record (was hl)
048EBB FD 21 F3 86 0104*       ld iy,tile_stack ; set ix to first record in table
       04          
048EC0             0105*   @find_loop:
048EC0 FD 27 00    0106*       ld hl,(iy)
048EC3 ED 33 03    0107*       lea iy,iy+3 ; next tile stack record
