0414BC             0236*   ; VDU 29, x; y;: Set graphics origin
0414BC             0237*   ; This command sets the graphics origin.
0414BC             0238*   ; The origin is the point on the screen where the coordinates (0,0) are located.
0414BC             0239*   ; inputs: bc=x0,de=y0
0414BC             0240*   ; outputs; nothing
0414BC             0241*   ; destroys: a might make it out alive
0414BC             0242*   vdu_set_gfx_origin:
0414BC ED 43 D2 14 0243*       ld (@x0),bc
       04          
0414C1 ED 53 D4 14 0244*       ld (@y0),de
       04          
0414C6 21 D1 14 04 0245*       ld hl,@cmd
0414CA 01 05 00 00 0246*       ld bc,@end-@cmd
0414CE 5B DF       0247*       rst.lil $18
0414D0 C9          0248*       ret
0414D1 1D          0249*   @cmd:   db 29 ; set graphics origin command
0414D2 00 00       0250*   @x0: 	dw 0x0000 ; set by bc
0414D4 00 00       0251*   @y0: 	dw 0x0000 ; set by de
0414D6 00          0252*   @end:   db 0x00	  ; padding
0414D7             0253*   
0414D7             0254*   ; VDU 24, left; bottom; right; top;: Set graphics viewport
0414D7             0255*   ; NOTE: the order of the y-coordinate parameters are inverted
0414D7             0256*   ; 	because we have turned off logical screen scaling
0414D7             0257*   ; NOTE: coordinates are relative to current gfx origin
0414D7             0258*   ; inputs: bc=x0,de=y0,ix=x1,iy=y1
0414D7             0259*   ; outputs; nothing
0414D7             0260*   ; destroys: a might make it out alive
0414D7             0261*   vdu_set_gfx_viewport:
0414D7 ED 43 F7 14 0262*       ld (@x0),bc
       04          
0414DC FD 22 F9 14 0263*       ld (@y1),iy
       04          
0414E1 DD 22 FB 14 0264*   	ld (@x1),ix
       04          
0414E6 ED 53 FD 14 0265*   	ld (@y0),de
       04          
0414EB 21 F6 14 04 0266*   	ld hl,@cmd
0414EF 01 09 00 00 0267*   	ld bc,@end-@cmd
0414F3 5B DF       0268*   	rst.lil $18
0414F5 C9          0269*   	ret
0414F6 18          0270*   @cmd:   db 24 ; set graphics viewport command
0414F7 00 00       0271*   @x0: 	dw 0x0000 ; set by bc
0414F9 00 00       0272*   @y1: 	dw 0x0000 ; set by iy
0414FB 00 00       0273*   @x1: 	dw 0x0000 ; set by ix
0414FD 00 00       0274*   @y0: 	dw 0x0000 ; set by de
0414FF 00          0275*   @end:   db 0x00	  ; padding
