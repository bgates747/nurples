041500             0319*   vdu_set_screen_mode:
041500 32 10 15 04 0320*   	ld (@arg),a
041504 21 0F 15 04 0321*   	ld hl,@cmd
041508 01 02 00 00 0322*   	ld bc,@end-@cmd
04150C 5B DF       0323*   	rst.lil $18
04150E C9          0324*   	ret
04150F 16          0325*   @cmd: db 22 ; set screen mode
041510 00          0326*   @arg: db 0  ; screen mode parameter
041511             0327*   @end:
041511             0328*   
041511             0329*   ; get the current screen mode
041511             0330*   ; inputs: none
041511             0331*   ; outputs: a=screen mode
041511             0332*   ; destroys: af, ix
041511             0333*   vdu_get_screen_mode:
041511             0334*       MOSCALL mos_sysvars
                       M1 Args: function=mos_sysvars 
041511 3E 08       0001*M1 			LD	A, function
041513 5B CF       0002*M1 			RST.LIL	08h
041515 DD 7E 27    0335*       ld a,(IX+sysvar_scrMode)
041518 C9          0336*       ret
041519             0337*   ; end vdu_get_screen_mode
041519             0338*   
041519             0339*   ; VDU 23, 0, &C0, n: Turn logical screen scaling on and off *
041519             0340*   ; inputs: a is scaling mode, 1=on, 0=off
041519             0341*   ; note: default setting on boot is scaling ON
041519             0342*   vdu_set_scaling:
041519 32 2B 15 04 0343*   	ld (@arg),a
04151D 21 28 15 04 0344*   	ld hl,@cmd
041521 01 04 00 00 0345*   	ld bc,@end-@cmd
041525 5B DF       0346*   	rst.lil $18
041527 C9          0347*   	ret
041528 17 00 C0    0348*   @cmd: db 23,0,0xC0
04152B 00          0349*   @arg: db 0  ; scaling on/off
04152C             0350*   @end:
04152C             0351*   
04152C             0352*   ; VDU 23, 27, &20, bufferId; : Select bitmap (using a buffer ID)
04152C             0353*   ; inputs: hl=bufferId
04152C             0354*   vdu_buff_select:
04152C 22 3E 15 04 0355*   	ld (@bufferId),hl
041530 21 3B 15 04 0356*   	ld hl,@cmd
041534 01 05 00 00 0357*   	ld bc,@end-@cmd
041538 5B DF       0358*   	rst.lil $18
04153A C9          0359*   	ret
04153B 17 1B 20    0360*   @cmd: db 23,27,0x20
04153E 00 00       0361*   @bufferId: dw 0x0000
041540 00          0362*   @end: db 0x00 ; padding
041541             0363*   
041541             0364*   ; VDU 23, 27, &21, w; h; format: Create bitmap from selected buffer
041541             0365*   ; inputs: a=format; bc=width; de=height
041541             0366*   ; prerequisites: buffer selected by vdu_bmp_select or vdu_buff_select
041541             0367*   ; formats: https://agonconsole8.github.io/agon-docs/VDP---Bitmaps-API.html
041541             0368*   ; 0 	RGBA8888 (4-bytes per pixel)
041541             0369*   ; 1 	RGBA2222 (1-bytes per pixel)
041541             0370*   ; 2 	Mono/Mask (1-bit per pixel)
041541             0371*   ; 3 	Reserved for internal use by VDP (“native” format)
041541             0372*   vdu_bmp_create:
041541 ED 43 5D 15 0373*       ld (@width),bc
       04          
041546 ED 53 5F 15 0374*       ld (@height),de
       04          
04154B 32 61 15 04 0375*       ld (@fmt),a
04154F 21 5A 15 04 0376*   	ld hl,@cmd
041553 01 08 00 00 0377*   	ld bc,@end-@cmd
041557 5B DF       0378*   	rst.lil $18
041559 C9          0379*   	ret
04155A 17 1B 21    0380*   @cmd:       db 23,27,0x21
04155D 00 00       0381*   @width:     dw 0x0000
04155F 00 00       0382*   @height:    dw 0x0000
041561 00          0383*   @fmt:       db 0x00
041562             0384*   @end:
041562             0385*   
041562             0386*   ; load an rgba2222 image file to a working buffer and make it an rgba8888 bitmap in a target buffer
041562             0387*   ; inputs: bc,de image width,height ; hl = targetBufferId ; ix = file size ; iy = pointer to filename
041562             0388*   vdu_load_img_rgba2_to_8:
041562             0389*   ; backup the target buffer id and image dimensions
041562 E5          0390*       push hl
041563 D5          0391*       push de
041564 C5          0392*       push bc
041565             0393*   ; load the rgba2 image to working buffer 65534
041565 21 FE FF 00 0394*       ld hl,65534 ; temporary working buffer id
041569 CD 72 16 04 0395*   	call vdu_load_buffer_from_file
04156D             0396*   ; restore the image dimensions and target buffer id
04156D C1          0397*       pop bc
04156E D1          0398*       pop de
04156F E1          0399*       pop hl
041570 D0          0400*       ret nc ; leave the cleared target untouched when the source cannot open
041571             0401*   ; fall through to vdu_rgba2_to_8
041571             0402*   
041571             0403*   ; https://discord.com/channels/1158535358624039014/1158536711148675072/1257757461729771771
041571             0404*   ; ok, so the "expand bitmap" can be used, when coupled with a "reverse" - the expanded bitmap _doesn't_ come out "right" otherwise, cos of endian-ness
041571             0405*   ; the "expand bitmap" command is:
041571             0406*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
041571             0407*   ; and then to reverse the byte order to fix endian-ness:
041571             0408*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
041571             0409*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
041571             0410*   ; VDU 23,27,&20,targetBufferID%;
041571             0411*   ; VDU 23,27,&21,width%;height%;0
041571             0412*   ; -------------------------------------------------------------------
041571             0413*   ; inputs: bc,de image width,height ; hl = targetBufferId
041571             0414*   ; prerequisites: rgba2 image data loaded into workingBufferId 65534
041571             0415*   vdu_rgba2_to_8:
041571             0416*   ; load the image dimensions and buffer id parameters
041571 ED 43 CD 15 0417*       ld (@width),bc
       04          
041576 ED 53 CF 15 0418*       ld (@height),de
       04          
04157B 22 B2 15 04 0419*       ld (@bufferId0),hl
04157F 22 BF 15 04 0420*       ld (@bufferId2),hl
041583 22 C8 15 04 0421*       ld (@bufferId1),hl
041587             0422*   ; clean up bytes that got stomped on by the ID loads
041587 3E 48       0423*       ld a,0x48
041589 32 B4 15 04 0424*       ld (@bufferId0+2),a
04158D 3E 17       0425*       ld a,23
04158F 32 CA 15 04 0426*       ld (@bufferId1+2),a
041593 3E 18       0427*       ld a,24
041595 32 C1 15 04 0428*       ld (@bufferId2+2),a
041599 AF          0429*       xor a
04159A 32 D1 15 04 0430*       ld (@height+2),a
04159E             0431*   ; send the vdu command strings
04159E 21 A9 15 04 0432*       ld hl,@beg
0415A2 01 29 00 00 0433*       ld bc,@end-@beg
0415A6 5B DF       0434*       rst.lil $18
0415A8 C9          0435*       ret
0415A9             0436*   @beg:
0415A9             0437*   ; Command 14: Consolidate blocks in a buffer
0415A9             0438*   ; VDU 23, 0, &A0, bufferId; 14
0415A9 17 00 A0    0439*       db 23,0,0xA0
0415AC FE FF       0440*       dw 65534 ; workingBufferId
0415AE 0E          0441*       db 14 ; consolidate blocks
0415AF             0442*   ; the "expand bitmap" command is:
0415AF             0443*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
0415AF 17 00 A0    0444*       db 23,0,0xA0
0415B2 00 00       0445*   @bufferId0: dw 0x0000 ; targetBufferId
0415B4 48          0446*       db 0x48 ; given as decimal command 72 in the docs
0415B5 02          0447*       db 2 ; options mask: %00000011 is the number of bits per pixel in the source bitmap
0415B6 FE FF       0448*       dw 65534 ; sourceBufferId
0415B8 00 7F BF FF 0449*       db 0x00,0x7F,0xBF,0xFF ; expanding to bytes by bit-shifting?
0415BC             0450*   ; reverse the byte order to fix endian-ness:
0415BC             0451*   ; Command 24: Reverse the order of data of blocks within a buffer
0415BC             0452*   ; VDU 23, 0, &A0, bufferId; 24, options, [valueSize;] [chunkSize;]
0415BC             0453*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
0415BC 17 00 A0    0454*       db 23,0,0xA0
0415BF 00 00       0455*   @bufferId2:    dw 0x0000 ; targetBufferId
0415C1 18          0456*       db 24 ; reverse byte order
0415C2 04          0457*       db 4 ; option: Reverse data of the value size within chunk of data of the specified size
0415C3 04 00       0458*       dw 4 ; size (4 bytes)
0415C5             0459*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
0415C5             0460*   ; VDU 23,27,&20,targetBufferID%;
0415C5 17 1B 20    0461*       db 23,27,0x20 ; select bitmap
0415C8 00 00       0462*   @bufferId1: dw 0x0000 ; targetBufferId
0415CA             0463*   ; VDU 23,27,&21,width%;height%;0
0415CA 17 1B 21    0464*       db 23,27,0x21 ; create bitmap from buffer
0415CD 00 00       0465*   @width: dw 0x0000
0415CF 00 00       0466*   @height: dw 0x0000
0415D1 00          0467*       db 0x00 ; rgba8888 format
0415D2             0468*   @end:
0415D2             0469*   
0415D2             0470*   ; scratch variables
0415D2 00 00 00    0471*   bufferId0: dl 0x000000
0415D5 00 00 00    0472*   bufferId1: dl 0x000000
0415D8             0473*   
0415D8             0474*   ; load a vdu buffer from local memory
0415D8             0475*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
0415D8             0476*   vdu_load_buffer:
0415D8 ED 43 01 16 0477*       ld (@length),bc
       04          
0415DD D5          0478*       push de ; save data pointer
0415DE             0479*   ; send the vdu command string
0415DE 7D          0480*       ld a,l
0415DF 32 FE 15 04 0481*       ld (@bufferId),a
0415E3 7C          0482*       ld a,h
0415E4 32 FF 15 04 0483*       ld (@bufferId+1),a
0415E8 21 FB 15 04 0484*       ld hl,@cmd
0415EC 01 08 00 00 0485*       ld bc,@end-@cmd
0415F0 5B DF       0486*       rst.lil $18
0415F2             0487*   ; send the buffer data
0415F2 E1          0488*       pop hl ; pointer to data
0415F3 ED 4B 01 16 0489*       ld bc,(@length)
       04          
0415F8 5B DF       0490*       rst.lil $18 ; send it
0415FA C9          0491*       ret
0415FB             0492*   ; Upload data :: VDU 23, 0 &A0, bufferId; 0, length; <buffer-data>
0415FB 17 00 A0    0493*   @cmd:       db 23,0,0xA0
0415FE 00 00       0494*   @bufferId:	dw 0x0000
041600 00          0495*   		    db 0 ; load buffer
041601 00 00       0496*   @length:	dw 0x0000
041603 00          0497*   @end: db 0 ; padding
041604             0498*   
041604             0499*   ; Command 14: Consolidate blocks in a buffer
041604             0500*   vdu_consolidate_buffer:
041604             0501*   ; set parameters for vdu call
041604 7D          0502*       ld a,l
041605 32 1C 16 04 0503*       ld (@bufferId),a
041609 7C          0504*       ld a,h
04160A 32 1D 16 04 0505*       ld (@bufferId+1),a
04160E 21 19 16 04 0506*       ld hl,@beg
041612 01 06 00 00 0507*       ld bc,@end-@beg
041616 5B DF       0508*       rst.lil $18
041618 C9          0509*       ret
041619             0510*   ; VDU 23, 0, &A0, bufferId; 14
041619 17 00 A0    0511*   @beg: db 23,0,0xA0
04161C 00 00       0512*   @bufferId: dw 0x0000
04161E 0E          0513*              db 14
04161F             0514*   @end:
04161F             0515*   
04161F             0516*   ; Convert a consolidated buffer to an explicitly rated audio sample.
04161F             0517*   ; This is a dependency of the canonical AGNB API's dormant audio entry point;
04161F             0518*   ; Purple Nurples currently creates no audio container and does not call it.
04161F             0519*   ; inputs: HL=bufferId, A=base format (0 signed, 1 unsigned), DE=sample rate
04161F             0520*   vdu_buffer_to_sound:
04161F 22 3F 16 04 0521*       ld (@bufferId),hl
041623 C6 08       0522*       add a,8
041625 32 41 16 04 0523*       ld (@format),a
041629 ED 53 42 16 0524*       ld (@sampleRate),de
       04          
04162E 21 39 16 04 0525*       ld hl,@cmd
041632 01 0B 00 00 0526*       ld bc,@end-@cmd
041636 5B DF       0527*       rst.lil $18
041638 C9          0528*       ret
041639 17 00 85    0529*   @cmd:        db 23,0,$85
04163C 00 05 02    0530*                db 0,5,2
04163F 00 00       0531*   @bufferId:   dw 0
041641 00          0532*   @format:     db 0
041642 00 00       0533*   @sampleRate: dw 0
041644             0534*   ; Native ADL stores three bytes from DE. This byte absorbs DEU outside the VDU
041644             0535*   ; packet, matching the canonical dependency implementation.
041644 00          0536*   @end:        db 0
041645             0537*   
041645             0538*   ; load an image file to a buffer and make it a bitmap
041645             0539*   ; inputs: a = image type ; bc,de image width,height ; hl = bufferId ; ix = file size ; iy = pointer to filename
041645             0540*   vdu_load_img:
041645             0541*   ; back up image type and dimension parameters
041645 22 D2 15 04 0542*       ld (bufferId0),hl
041649 F5          0543*       push af
04164A C5          0544*   	push bc
04164B D5          0545*   	push de
04164C             0546*   ; load the image
04164C CD 72 16 04 0547*   	call vdu_load_buffer_from_file
041650 DA 59 16 04 0548*       jp c,@loaded
041654             0549*   ; balance the saved arguments and fail without creating an empty bitmap
041654 D1          0550*   	pop de
041655 C1          0551*   	pop bc
041656 F1          0552*   	pop af
041657 B7          0553*       or a ; preserve A while reasserting the carry-clear failure contract
041658 C9          0554*       ret
041659             0555*   @loaded:
041659             0556*   ; now make it a bitmap
041659 2A D2 15 04 0557*       ld hl,(bufferId0)
04165D CD 04 16 04 0558*       call vdu_consolidate_buffer
041661 2A D2 15 04 0559*       ld hl,(bufferId0)
041665 CD 2C 15 04 0560*       call vdu_buff_select
041669 D1          0561*   	pop de ; image height
04166A C1          0562*   	pop bc ; image width
04166B F1          0563*   	pop af ; image type
04166C CD 41 15 04 0564*   	call vdu_bmp_create
041670 37          0565*       scf
041671 C9          0566*       ret
041672             0567*   
041672             0568*   ; inputs: hl = bufferId; iy = pointer to filename
041672             0569*   ; outputs: carry set after a complete read/close; carry clear if open failed
041672             0570*   vdu_load_buffer_from_file:
041672 22 D2 15 04 0571*       ld (bufferId0),hl
041676             0572*   
041676             0573*   ; clear target buffer
041676 CD 22 18 04 0574*       call vdu_clear_buffer
04167A             0575*   
04167A             0576*   ; open the file in read mode
04167A             0577*   ; Open a file
04167A             0578*   ; HLU: Filename
04167A             0579*   ;   C: Mode
04167A             0580*   ; Returns:
04167A             0581*   ;   A: Filehandle, or 0 if couldn't open
04167A FD E5       0582*   	push iy ; pointer to filename
04167C E1          0583*   	pop hl
04167D 0E 01       0584*       ld c,fa_read
04167F             0585*       MOSCALL mos_fopen
                       M1 Args: function=mos_fopen 
04167F 3E 0A       0001*M1 			LD	A, function
041681 5B CF       0002*M1 			RST.LIL	08h
041683 B7          0586*       or a
041684 C8          0587*       ret z ; carry clear: do not read or close the all-files handle zero
041685 32 C2 16 04 0588*       ld (@filehandle),a
041689             0589*   
041689             0590*   @read_file:
041689             0591*   ; Read a block of data from a file
041689             0592*   ;   C: Filehandle
041689             0593*   ; HLU: Pointer to where to write the data to
041689             0594*   ; DEU: Number of bytes to read
041689             0595*   ; Returns:
041689             0596*   ; DEU: Number of bytes read
041689 3A C2 16 04 0597*       ld a,(@filehandle)
04168D 4F          0598*       ld c,a
04168E 21 00 E0 B7 0599*       ld hl,filedata
041692 11 00 20 00 0600*       ld de,8192 ; max we can read into onboard sram at one time
041696             0601*       MOSCALL mos_fread
                       M1 Args: function=mos_fread 
041696 3E 1A       0001*M1 			LD	A, function
041698 5B CF       0002*M1 			RST.LIL	08h
04169A             0602*   
04169A             0603*   ; test de for zero bytes read
04169A 21 00 00 00 0604*       ld hl,0
04169E AF          0605*       xor a ; clear carry
04169F ED 52       0606*       sbc hl,de
0416A1 CA B7 16 04 0607*       jp z,@close_file
0416A5             0608*   
0416A5             0609*   ; load a vdu buffer from local memory
0416A5             0610*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
0416A5 2A D2 15 04 0611*       ld hl,(bufferId0)
0416A9 D5          0612*       push de ; chunksize
0416AA C1          0613*       pop bc
0416AB 11 00 E0 B7 0614*       ld de,filedata
0416AF CD D8 15 04 0615*       call vdu_load_buffer
0416B3             0616*   
0416B3             0617*   ; read the next block
0416B3 C3 89 16 04 0618*       jp @read_file
0416B7             0619*   
0416B7             0620*   ; close the file
0416B7             0621*   @close_file:
0416B7 3A C2 16 04 0622*       ld a,(@filehandle)
0416BB 4F          0623*       ld c,a
0416BC             0624*       MOSCALL mos_fclose
                       M1 Args: function=mos_fclose 
0416BC 3E 0B       0001*M1 			LD	A, function
0416BE 5B CF       0002*M1 			RST.LIL	08h
0416C0 37          0625*       scf
0416C1 C9          0626*       ret ; vdu_load_buffer_from_file
0416C2             0627*   
0416C2 00          0628*   @filehandle: db 0 ; file handle
0416C3 00 00 00    0629*   @fil: dl 0 ; pointer to FIL struct
0416C6             0630*   
0416C6 00 00 00    0631*   @chunkpointer: dl 0 ; pointer to current chunk
0416C9             0632*   
