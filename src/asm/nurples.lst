047AC7 DD 21 86 88 0031*       ld ix,player_begin
       04          
047ACC DD CB 1D 76 0032*       bit sprite_alive,(ix+sprite_collisions)
047AD0 CA E0 7A 04 0033*       jp z,@animate ; player is dead so don't check for collisions
047AD4 CD D8 49 04 0034*       call check_enemy_collision_player
