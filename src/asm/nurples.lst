047945 CB C6       0146*       set tile_fault_bad_record,(hl)
047947 CD C5 75 04 0147*       call tile_stack_quarantine_entry
04794B C3 25 79 04 0148*       jp @next_record
04794F             0149*   @bad_move_program:
