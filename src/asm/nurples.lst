0410CC 22 FB 0F 04 0119*       ld (logo_ypos),hl
0410D0 21 2D 00 00 0120*       ld hl,BUF_SPLASH_LOGO
0410D4 CD E4 14 04 0121*       call vdu_buff_select
0410D8 ED 4B F8 0F 0122*       ld bc,(logo_xpos)
       04          
0410DD ED 5B FB 0F 0123*       ld de,(logo_ypos)
