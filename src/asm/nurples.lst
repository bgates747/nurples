046682 6F          0018*       ld l,a
046683 DD 2F 00    0019*       ld (ix+bar_val),hl
046686 CD F8 62 04 0020*       call bar_update_v
04668A C9          0021*       ret
04668B             0022*   ; end init_bar_shields
04668B             0023*   
04668B             0024*   ; inputs: iy set to sprite/tile record being tallied
04668B             0025*   ; outputs: a/player_shields = updated shields, Z set when depleted
04668B             0026*   ; destroys: hl,de; preserves bc,ix,iy
04668B             0027*   update_shields:
04668B FD 6E 27    0028*       ld l,(iy+sprite_shield_damage)
04668E 3A 60 66 04 0029*       ld a,(player_shields)
046692 85          0030*       add a,l
046693 F2 98 66 04 0031*       jp p,@have_shields
046697 AF          0032*       xor a ; set to zero
046698             0033*   @have_shields:
046698 32 60 66 04 0034*       ld (player_shields),a
04669C B7          0035*       or a ; check for zero
04669D CA 64 60 04 0036*       jp z,kill_player
0466A1 C9          0037*       ret
0466A2             0038*   ; end update_shields
0466A2             0039*   
