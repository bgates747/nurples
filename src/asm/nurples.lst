047C26 47 65 74 20 0253*   get_ready: asciz "Get Ready!"
       52 65 61 64 
       79 21 00    
047C31             0254*   
047C31             0255*   player_dead:
047C31             0256*   ; reset player score to what it was at the start of the level
047C31 2A 2F 81 04 0257*       ld hl,(player_starting_score)
047C35 22 2C 81 04 0258*       ld (player_score),hl
047C39             0259*   ; decrement lives
047C39 3A 3D 7A 04 0260*       ld a,(player_ships)
047C3D 3D          0261*       dec a
047C3E 32 3D 7A 04 0262*       ld (player_ships),a
047C42 C2 4D 7C 04 0263*       jp nz,@respawn
047C46             0264*   ; actors publish outcomes; the global playing state owns the phase transition
047C46 3E 01       0265*       ld a,player_event_game_over
047C48 32 3B 7A 04 0266*       ld (player_event),a
047C4C C9          0267*       ret
047C4D             0268*   @respawn:
047C4D CD 3F 7A 04 0269*       call draw_player_ships
047C51 CD C7 88 04 0270*       call reset_runtime_tables
047C55             0271*   ; ; reset player score to what it was at the start of the level
047C55             0272*   ;     ld hl,(player_starting_score)
047C55             0273*   ;     ld (player_score),hl
047C55             0274*   ; restart the level
047C55 CD 1A 69 04 0275*       call init_level
047C59             0276*   ; spawn player sprite at starting position
047C59 CD DD 7A 04 0277*       call player_init
047C5D DA 68 7C 04 0278*       jp c,@player_ready
047C61             0279*   ; allocation should be impossible after table_init; recover without touching IX
047C61 3E 01       0280*       ld a,player_event_game_over
047C63 32 3B 7A 04 0281*       ld (player_event),a
047C67 C9          0282*       ret
047C68             0283*   @player_ready:
047C68             0284*   ; set game playing substates
047C68 21 F1 20 04 0285*       ld hl,enemies_alive
047C6C 22 91 20 04 0286*       ld (enemies_state), hl
047C70 C9          0287*       ret
047C71             0288*   ; end player_dead
