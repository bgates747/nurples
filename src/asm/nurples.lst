04843A 5B CF       0002*M1 			RST.LIL	08h
04843C             0204*   @scan:
04843C DD E5       0205*       push ix
04843E E1          0206*       pop hl
04843F 06 10       0207*       ld b,16
048441 AF          0208*       xor a
048442             0209*   @byte:
048442 B6          0210*       or (hl)
048443 23          0211*       inc hl
048444 10 FC       0212*       djnz @byte
048446 20 F4       0213*       jr nz,@scan
048448 C9          0214*       ret
048449             0215*   ; end choose_joystick
048449             0216*   
048449             0217*   ; Reset only shared runtime infrastructure. Session and level semantics remain
048449             0218*   ; with their respective callers.
048449             0219*   reset_runtime_tables:
048449 CD BA 7B 04 0220*       call table_init
04844D 21 E2 A3 04 0221*       ld hl,table_base
048451 22 94 7B 04 0222*       ld (table_pointer),hl
048455 CD 3B 7C 04 0223*       call sprites_init
048459 CD BA 7B 04 0224*       call table_init
04845D CD 43 89 04 0225*       call tile_table_init
048461 AF          0226*       xor a
048462 32 8B 70 04 0227*       ld (player_event),a
048466 C9          0228*       ret
048467             0229*   ; end reset_runtime_tables
048467             0075        include "state_game_playing.inc"
048467             0001*   ; main game state
048467             0002*   game_playing:
048467             0003*   ; Main gameplay loop
048467             0004*   
048467             0005*   ; Level-start presentation scrolls only the blank starfield. The player actor
048467             0006*   ; publishes its bounded speed; the global renderer owns the VDP operation and
048467             0007*   ; never admits terrain through the multi-scanline path. The final seven entry
048467             0008*   ; frames run at speed one, then GRACE falls through to the ordinary one-line
048467             0009*   ; terrain pipeline on the following frame.
048467 CD 6A 71 04 0010*       call player_entry_starfield_speed
04846B D2 77 84 04 0011*       jp nc,@terrain
04846F CD 2B 8D 04 0012*       call starfield_warp_scroll
048473 C3 8F 84 04 0013*       jp @tiles_ready
048477             0014*   @terrain:
048477             0015*   ; plot tiles through the gameplay-only one-scanline path
048477 CD CD 8B 04 0016*       call tiles_plot
04847B B7          0017*       or a
04847C CA 8F 84 04 0018*       jp z,@tiles_ready
048480             0019*   ; level completion is a world result; only the global state selects the phase
048480 3E 08       0020*       ld a,STATE_NEW_EVENT_LEVEL_COMPLETE
048482 CD 39 9E 04 0021*       call telemetry_post_events
048486 21 E9 80 04 0022*       ld hl,game_level_transition
04848A 22 26 80 04 0023*       ld (game_state),hl
04848E C9          0024*       ret
04848F             0025*   @tiles_ready:
04848F             0026*   
04848F             0027*   ; set gfx viewport to playing field window
04848F CD 71 7B 04 0028*       call set_gfx_playing_field
048493             0029*   
048493             0030*   ; process movement and collisions
048493 CD E2 70 04 0031*       call do_player
048497 3A 8B 70 04 0032*       ld a,(player_event)
04849B B7          0033*       or a
04849C CA B4 84 04 0034*       jp z,@player_ready
0484A0             0035*   ; consume the actor outcome before any more work runs in the old playing frame
0484A0 AF          0036*       xor a
0484A1 32 8B 70 04 0037*       ld (player_event),a
0484A5 3E 20       0038*       ld a,STATE_NEW_EVENT_NO_LIVES
0484A7 CD 39 9E 04 0039*       call telemetry_post_events
0484AB 21 F6 80 04 0040*       ld hl,game_over
0484AF 22 26 80 04 0041*       ld (game_state),hl
0484B3 C9          0042*       ret
0484B4             0043*   @player_ready:
0484B4 CD 51 4A 04 0044*       call do_enemies
0484B8 CD 35 4E 04 0045*       call move_explosions
0484BC CD B7 8E 04 0046*       call move_tiles
0484C0             0047*   
0484C0             0048*   ; update UI
0484C0 01 00 00 00 0049*       ld bc,0
0484C4 11 00 00 00 0050*       ld de,0
0484C8 CD BC 14 04 0051*       call vdu_set_gfx_origin
0484CC             0052*       ; call print_score
0484CC CD 59 7B 04 0053*       call draw_shields
0484D0 CD C3 7A 04 0054*       call draw_laser
0484D4 CD 7A 78 04 0055*       call draw_fuel
0484D8 C9          0056*       ret
0484D9             0076        include "targeting.inc"
0484D9             0001*   ; compute orientation to player
0484D9             0002*   ; based on relative positions
0484D9             0003*   ; returns: uh.l 16.8 fixed angle256 to player
0484D9             0004*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
0484D9             0005*   ;    representing delta-x/y *to* target respectively
0484D9             0006*   ; inputs: iy pointed at sprite record
0484D9             0007*   ; destroys: everything except iy (sprite record pointer)
0484D9             0008*   orientation_to_player:
0484D9 DD 21 E2 A4 0009*       ld ix,player_begin
       04          
0484DE             0010*   ; compute dx
0484DE DD 27 01    0011*       ld hl,(ix+sprite_x)
0484E1 FD 17 01    0012*       ld de,(iy+sprite_x)
0484E4 B7          0013*       or a ; clear carry
0484E5 ED 52       0014*       sbc hl,de ; dx
0484E7 E5          0015*       push hl ; save dx
0484E8             0016*   ; compute dy
0484E8 DD 27 04    0017*       ld hl,(ix+sprite_y)
0484EB FD 17 04    0018*       ld de,(iy+sprite_y)
0484EE B7          0019*       or a ; clear carry
0484EF ED 52       0020*       sbc hl,de ; dy
0484F1 EB          0021*       ex de,hl ; de = dy
0484F2             0022*   ; compute angle to player
0484F2 C1          0023*       pop bc ; dx (was hl)
0484F3 C5          0024*       push bc ; save dx
0484F4 D5          0025*       push de ; save dy
0484F5 CD E3 07 04 0026*       call atan2_168fast ; uh.l = angle to player
0484F9 3E E0       0027*       ld a,%11100000
0484FB A5          0028*       and l ; round angle to nearest 32th of a circle
0484FC 6F          0029*       ld l,a
0484FD 22 4E 85 04 0030*       ld (Bearing_t),hl ; return angle to player
048501 D1          0031*       pop de ; restore dy
048502 C1          0032*       pop bc ; restore dx
048503 C9          0033*       ret
048504             0034*   ; end orientation_to_player
048504             0035*   
048504             0036*   ; compute orientation to player
048504             0037*   ; based on relative positions
048504             0038*   ; returns: uh.l 16.8 fixed angle256 to player
048504             0039*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
048504             0040*   ;    representing delta-x/y *to* target respectively
048504             0041*   ; inputs: iy pointed at tile record
048504             0042*   ; destroys: everything except iy (tile record pointer)
048504             0043*   tile_orientation_to_player:
048504 DD 21 E2 A4 0044*       ld ix,player_begin
       04          
048509             0045*   ; compute dx
048509 DD 27 01    0046*       ld hl,(ix+sprite_x)
04850C FD 17 01    0047*       ld de,(iy+tile_x)
04850F B7          0048*       or a ; clear carry
048510 ED 52       0049*       sbc hl,de ; dx
048512 E5          0050*       push hl ; save dx
048513             0051*   ; compute dy
048513 DD 27 04    0052*       ld hl,(ix+sprite_y)
048516 FD 17 04    0053*       ld de,(iy+tile_y)
048519 B7          0054*       or a ; clear carry
04851A ED 52       0055*       sbc hl,de ; dy
04851C EB          0056*       ex de,hl ; de = dy
04851D             0057*   ; compute angle to player
04851D C1          0058*       pop bc ; dx (was hl)
04851E CD E3 07 04 0059*       call atan2_168fast ; uh.l = angle to player
048522 3E E0       0060*       ld a,%11100000
048524 A5          0061*       and l ; round angle to nearest 32th of a circle
048525 6F          0062*       ld l,a
048526 22 4E 85 04 0063*       ld (Bearing_t),hl
04852A C9          0064*       ret
04852B             0065*   ; end tile_orientation_to_player
04852B             0066*   
04852B             0067*   ; compute orientation to coordinate
04852B             0068*   ; based on relative positions
04852B             0069*   ; returns: uh.l 16.8 fixed angle256 to coordinate
04852B             0070*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
04852B             0071*   ;    representing delta-x/y *to* target respectively
04852B             0072*   ; inputs: iy pointed at sprite record, ub.c,ud.e are target x,y coordinates
04852B             0073*   ; destroys: everything except iy (sprite record pointer)
04852B             0074*   bearing_to_coord:
04852B             0075*   ; compute dx
04852B C5          0076*       push bc
04852C E1          0077*       pop hl
04852D FD 07 01    0078*       ld bc,(iy+sprite_x)
048530 B7          0079*       or a ; clear carry
048531 ED 42       0080*       sbc hl,bc ; dx
048533 E5          0081*       push hl ; save dx
048534             0082*   ; compute dy
048534 EB          0083*       ex de,hl
048535 FD 17 04    0084*       ld de,(iy+sprite_y)
048538 B7          0085*       or a ; clear carry
048539 ED 52       0086*       sbc hl,de ; dy
04853B EB          0087*       ex de,hl ; de = dy
04853C             0088*   ; compute angle to coordinate
04853C C1          0089*       pop bc ; dx (was hl)
04853D C5          0090*       push bc ; save dx
04853E D5          0091*       push de ; save dy
04853F CD E3 07 04 0092*       call atan2_168fast ; uh.l = angle to coordinate
048543 3E E0       0093*       ld a,%11100000
048545 A5          0094*       and l ; round angle to nearest 32th of a circle
048546 6F          0095*       ld l,a
048547 22 4E 85 04 0096*       ld (Bearing_t),hl ; return angle to coordinate
04854B D1          0097*       pop de ; restore dy
04854C C1          0098*       pop bc ; restore dx
04854D C9          0099*       ret
04854E             0100*   ; end bearing_to_coord
04854E             0101*   
04854E             0102*   ; targeting_computer variables fixed 16.8 format
04854E 00 00 00    0103*   Bearing_t: dl 0x000000 ; angle to target
048551 00 00 00    0104*   Heading_t: dl 0x000000 ; angle of target motion
048554 00 00 00    0105*   Vp: dl 0x000000 ; velocity of projectile
048557 00 00 00    0106*   Vp_x: dl 0x000000 ; x component of projectile velocity
04855A 00 00 00    0107*   Vp_y: dl 0x000000 ; y component of projectile velocity
04855D 00 00 00    0108*   Vt: dl 0x000000 ; velocity of target
048560 00 00 00    0109*   Vt_x: dl 0x000000 ; x component of target velocity
048563 00 00 00    0110*   Vt_y: dl 0x000000 ; y component of target velocity
048566 00 00 00    0111*   Heading_p: dl 0x000000 ; angle of projectile motion
048569 00 00 00    0112*   lead_angle: dl 0x000000 ; lead angle
04856C             0113*   
04856C             0114*   ; Inputs:   Vp velocity of projectile set,
04856C             0115*   ;           iy pointed to sprite record,
04856C             0116*   ;           player position and velocities correctly set
04856C             0117*   ; Outputs:  uh.l is the 16.8 fixed firing angle256
04856C             0118*   ;           ub.c and ud.e are the 16.8 fixed x,y component projectile velocities
04856C             0119*   ; Law-of-sines derivation and NanoLinearTargeting small-angle approximation:
04856C             0120*   ; https://old.robowiki.net/cgi-bin/robowiki?LinearTargeting
04856C             0121*   ; Archived mirror:
04856C             0122*   ; https://robowiki.net/wiki/Linear_Targeting/Archived_Talk_20071111
04856C             0123*   targeting_computer:
04856C DD 21 E2 A4 0124*       ld ix,player_begin
       04          
048571             0125*   ; compute target speed and heading from its component velocities
048571 DD 07 07    0126*       ld bc,(ix+sprite_xvel)
048574 DD 17 0A    0127*       ld de,(ix+sprite_yvel)
048577 21 00 FF FF 0128*       ld hl,-1*256 ; account for vertical ground movement
04857B 19          0129*       add hl,de
04857C EB          0130*       ex de,hl ; ud.e = player y velocity - ground scroll velocity
04857D CD 3D 07 04 0131*       call cartesian_to_polar_sm ; uh.l = Heading_t, ud.e = Vt
048581 22 51 85 04 0132*       ld (Heading_t),hl
048585 ED 53 5D 85 0133*       ld (Vt),de
       04          
04858A             0134*   ; B = target heading - bearing to target
04858A ED 5B 4E 85 0135*       ld de,(Bearing_t)
       04          
04858F B7          0136*       or a ; clear carry
048590 ED 52       0137*       sbc hl,de
048592             0138*   ; numerator = Vt * sin(B), the target's lateral velocity
048592 CD D5 06 04 0139*       call sin168
048596 ED 5B 5D 85 0140*       ld de,(Vt)
       04          
04859B CD 11 06 04 0141*       call smul168
04859F             0142*   ; sin(A) = Vt * sin(B) / Vp
04859F ED 5B 54 85 0143*       ld de,(Vp)
       04          
0485A4 CD 75 06 04 0144*       call sdiv168 ; quotient is returned in ud.e, remainder in uh.l
0485A8 EB          0145*       ex de,hl
0485A9             0146*   ; NanoLinearTargeting drops asin and treats its argument as radians. Convert
0485A9             0147*   ; that small-angle result to angle256: 256/(2*pi) = 40.743665...
0485A9 11 BE 28 00 0148*       ld de,0x0028BE ; 40.7421875 in 16.8 fixed
0485AD CD 11 06 04 0149*       call smul168
0485B1 22 69 85 04 0150*       ld (lead_angle),hl
0485B5             0151*   ; projectile heading = bearing + lead angle
0485B5 ED 5B 4E 85 0152*       ld de,(Bearing_t)
       04          
0485BA 19          0153*       add hl,de
0485BB             0154*   
0485BB E5          0155*       push hl
0485BC             0156*   
0485BC             0157*   ; compute component projectile velocities
0485BC ED 5B 54 85 0158*       ld de,(Vp) ; Vp should have been set by caller
       04          
0485C1 CD E9 06 04 0159*       call polar_to_cartesian ; ub.c = Vp_x, ud.e = Vp_y
0485C5 ED 43 57 85 0160*       ld (Vp_x),bc
       04          
0485CA             0161*       ; inc d ; account for vertical ground movement
0485CA ED 53 5A 85 0162*       ld (Vp_y),de
       04          
0485CF E1          0163*       pop hl ; uh.l = lead angle+target bearing
0485D0 22 66 85 04 0164*       ld (Heading_p),hl
0485D4             0165*   
0485D4 C9          0166*       ret
0485D5             0167*   
0485D5             0168*   ; debug print the results
0485D5             0169*       PUSH_ALL
                       M1 Args: none
