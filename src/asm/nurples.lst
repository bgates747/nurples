044EF2             0182*   @waitLoop:
044EF2 C5          0183*       push bc
044EF3 78          0184*       ld a,b
044EF4 3D          0185*       dec a
044EF5 CD E3 7B 04 0186*       call printHexA
044EF9 0E 26       0187*       ld c,38 ; x
044EFB 06 11       0188*       ld b,17 ; y
044EFD CD BE 13 04 0189*       call vdu_move_cursor
044F01 3E 80       0190*       ld a,%10000000 ; bit 7 changes once per second
044F03 CD 2D 13 04 0191*       call multiPurposeDelay
044F07 C1          0192*       pop bc
044F08 10 E8       0193*       djnz @waitLoop
044F0A C9          0194*       ret
