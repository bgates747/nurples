0466CC             0001*   
0466CC 40          0002*   player_shields: db 64
0466CD 40          0003*   player_shields_max: db 64
0466CE             0004*   ; player_shields_max: db 8 ; DEBUG
0466CE 00          0005*   player_shields_last: db 0
0466CF             0006*   bar_shields:
0466CF 00 00 00    0007*       dl 0 ; value
0466D2 F0 01 00    0008*       dl 496 ; x0
0466D5 30 01 00    0009*       dl 304 ; y0
0466D8 F7 01 00    0010*       dl 496+7 ; x1
0466DB 6F 01 00    0011*       dl 304+63 ; y1
0466DE F0 00 00    0012*       dl 304-64 ; y-plot coordinate
0466E1             0013*   
0466E1             0014*   init_bar_shields:
0466E1 DD 21 CF 66 0015*       ld ix,bar_shields
       04          
0466E6 21 00 00 00 0016*       ld hl,0
0466EA 3A CD 66 04 0017*       ld a,(player_shields_max)
0466EE 6F          0018*       ld l,a
0466EF DD 2F 00    0019*       ld (ix+bar_val),hl
0466F2 CD 6A 63 04 0020*       call bar_update_v
0466F6 C9          0021*       ret
0466F7             0022*   ; end init_bar_shields
0466F7             0023*   
0466F7             0024*   ; inputs: iy set to sprite/tile record being tallied
0466F7             0025*   ; outputs: a/player_shields = updated shields, Z set when depleted
0466F7             0026*   ; destroys: hl,de; preserves bc,ix,iy
0466F7             0027*   update_shields:
0466F7 FD 6E 27    0028*       ld l,(iy+sprite_shield_damage)
0466FA 3A CC 66 04 0029*       ld a,(player_shields)
0466FE 85          0030*       add a,l
0466FF F2 04 67 04 0031*       jp p,@have_shields
046703 AF          0032*       xor a ; set to zero
046704             0033*   @have_shields:
046704 32 CC 66 04 0034*       ld (player_shields),a
046708 B7          0035*       or a ; check for zero
046709 CA 8A 60 04 0036*       jp z,kill_player
04670D C9          0037*       ret
04670E             0038*   ; end update_shields
04670E             0039*   
04670E             0040*   draw_shields:
04670E 21 CE 66 04 0041*       ld hl,player_shields_last
046712 3A CC 66 04 0042*       ld a,(player_shields)
046716 BE          0043*       cp (hl)
046717 C8          0044*       ret z ; no change to update
046718 77          0045*       ld (hl),a
046719 DD 21 CF 66 0046*       ld ix,bar_shields
       04          
04671E DD 77 00    0047*       ld (ix+bar_val),a ; TODO: this is redundant
046721 CD 6A 63 04 0048*       call bar_update_v
046725 C9          0049*       ret
