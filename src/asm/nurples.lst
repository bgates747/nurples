040FA7             0001*   fonts_load:
040FA7 DD 21 37 4D 0002*       ld ix,font_list ; pointer to font list lookup
       04          
040FAC 06 01       0003*       ld b,num_fonts ; loop counter
040FAE             0004*   
040FAE             0005*   @load_loop:
040FAE C5          0006*       push bc ; save loop counter
040FAF             0007*   
040FAF             0008*   ; load font into a buffer
040FAF DD 27 06    0009*       ld hl,(ix+font_list_bufferId)
040FB2 DD 31 09    0010*       ld iy,(ix+font_list_filename)
040FB5 DD E5       0011*       push ix ; mos_fread does not preserve the font-list cursor
040FB7 CD 0A 16 04 0012*       call vdu_load_buffer_from_file
040FBB DD E1       0013*       pop ix
040FBD 30 24       0014*       jr nc,@load_failed
040FBF             0015*   
040FBF             0016*   ; create font from buffer
040FBF DD 27 06    0017*       ld hl,(ix+font_list_bufferId)
040FC2 DD 5E 00    0018*       ld e,(ix+font_list_width)
040FC5 DD 56 03    0019*       ld d,(ix+font_list_height)
040FC8 3E 00       0020*       ld a,0 ; flags
040FCA CD 61 18 04 0021*       call vdu_font_create
040FCE             0022*   
040FCE             0023*   ; select font
040FCE DD 27 06    0024*       ld hl,(ix+font_list_bufferId)
040FD1 3E 01       0025*       ld a,1 ; flags
040FD3 CD 47 18 04 0026*       call vdu_font_select
040FD7             0027*   
040FD7             0028*   ; Report only a fully uploaded, created, and selected font.
040FD7 3E 2E       0029*       ld a,'.'
040FD9 5B D7       0030*       rst.lil 10h
040FDB             0031*   
040FDB             0032*   ; ; debug print filename
040FDB             0033*   ;     call printNewLine
040FDB             0034*   ;     ld hl,(ix+font_list_filename)
040FDB             0035*   ;     call printString
040FDB             0036*   
040FDB             0037*   ; advance font_list pointer to next record
040FDB             0038*   @next_font:
040FDB ED 32 0C    0039*       lea ix,ix+font_list_record_size
040FDE             0040*   
040FDE             0041*   ; restore loop counter
040FDE C1          0042*       pop bc
040FDF 10 CD       0043*       djnz @load_loop
040FE1             0044*   
040FE1             0045*   ; all done: every font completed successfully
040FE1 37          0046*       scf
040FE2 C9          0047*       ret
040FE3             0048*   
040FE3             0049*   @load_failed:
040FE3             0050*   ; Balance the loop counter saved by this iteration and publish failure.
040FE3 C1          0051*       pop bc
040FE4 B7          0052*       or a ; clear carry
040FE5 C9          0053*       ret
