048D13 22 8D 04    0033*       dl activate_null_tile
048D16 22 8D 04    0034*       dl activate_null_tile
048D19 22 8D 04    0035*       dl activate_null_tile
048D1C 22 8D 04    0036*       dl activate_null_tile ; tile 15
048D1F EE 8D 04    0037*       dl activate_crater ; tile 16
