049038 DD 21 87 9D 0031*       ld ix,player_begin
       04          
04903D DD CB 1D 76 0032*       bit sprite_alive,(ix+sprite_collisions)
049041 CA 51 90 04 0033*       jp z,@animate ; player is dead so don't check for collisions
049045 CD 7D 20 04 0034*       call check_enemy_collision_player
049049 C2 51 90 04 0035*       jp nz,@animate ; no collision so do animation
04904D CD FA 7C 04 0036*       call update_shields
049051             0037*   @animate:
049051 FD 35 23    0038*       dec (iy+tile_animation_timer)
049054 C0          0039*       ret nz ; not time to animate
049055             0040*   ; reset the animation timer and bump animation
049055 3E 08       0041*       ld a,8
049057 FD 77 23    0042*       ld (iy+tile_animation_timer),a
04905A FD 7E 28    0043*       ld a,(iy+tile_frame)
04905D 3C          0044*       inc a
04905E E6 01       0045*       and %00000001 ; modulo 1
049060 FD 77 28    0046*       ld (iy+tile_frame),a
049063 C3 A2 8D 04 0047*       jp draw_active_tile
049067 C9          0048*       ret
049068             0078        include "tile_pad_small.inc"
049068             0001*   pad_small_defaults:
049068 01          0002*       db tile_pad_small       ; type
049069 77 01 00    0003*       dl BUF_TILE_PAD_0       ; base_bufferId
04906C 8E 90 04    0004*       dl move_pad_small       ; move_program
04906F 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
049070 10          0006*       db 16                   ; dim_x
049071 10          0007*       db 16                   ; dim_y
049072 01          0008*       db 1                    ; num_orientations
049073 01          0009*       db 1                    ; num_animations
049074 00          0010*       db 0                    ; animation
049075 10          0011*       db 16                   ; animation_timer
049076 00          0012*       db 0                    ; move_timer
049077 00          0013*       db 0                    ; move_step
049078 05          0014*       db 5                    ; points
049079 00          0015*       db 0                    ; shield_damage
04907A 00          0016*       db 0                    ; frame
04907B             0017*   
04907B             0018*   activate_pad_small:
04907B 21 68 90 04 0019*       ld hl,pad_small_defaults
04907F             0020*   ; get next available active tile id
04907F CD 5E 8A 04 0021*       call spawn_active_tile
049083 D0          0022*       ret nc ; no carry means no free active tile slots, so we go home
049084             0023*   ; other specific initialization
049084 CD 14 05 04 0024*       call rand_8     ; snag a random number
049088 E6 1F       0025*       and %00011111 ; keep only 5 lowest bits (max 31)
