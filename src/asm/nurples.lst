0416B9             0040        include "vdu_buffered_api.inc"
0416B9             0001*   ; https://agonconsole8.github.io/agon-docs/vdp/Buffered-Commands-API/
0416B9             0002*   
0416B9             0003*   ; Command 0: Write block to a buffer
0416B9             0004*   ; VDU 23, 0, &A0, bufferId; 0, length; <buffer-data>
0416B9             0005*   ; inputs: hl = bufferId, bc = length of data, de = pointer to data
0416B9             0006*   vdu_write_block_to_buffer:
0416B9             0007*   ; back up input parameters
0416B9 D5          0008*       push de ; pointer to data
0416BA C5          0009*       push bc ; length of data
0416BB             0010*   ; set up the vdu command string
0416BB 22 DB 16 04 0011*       ld (@bufferId),hl
0416BF ED 43 DE 16 0012*       ld (@length),bc
       04          
0416C4 AF          0013*       xor a ; load buffer
0416C5 32 DD 16 04 0014*       ld (@bufferId+2),a
0416C9 21 D8 16 04 0015*       ld hl,@cmd0
0416CD 01 08 00 00 0016*       ld bc,@end0-@cmd0
0416D1 5B DF       0017*       rst.lil $18
0416D3             0018*   ; send the buffer data
0416D3 C1          0019*       pop bc ; length of data
0416D4 E1          0020*       pop hl ; pointer to data (was de)
0416D5 5B DF       0021*       rst.lil $18 ; send it
0416D7 C9          0022*       ret
0416D8             0023*   ; command string data
0416D8 17 00 A0    0024*   @cmd0:      db 23,0,0xA0
0416DB 00 00       0025*   @bufferId:	dw 0x0000
0416DD 00          0026*               db 0 ; load buffer
0416DE 00 00       0027*   @length:	dw 0x0000
0416E0 00          0028*   @end0:      db 0x00 ; padding
0416E1             0029*   ; end vdu_write_block_to_buffer
0416E1             0030*   
0416E1             0031*   ; Command 1: Call a buffer
0416E1             0032*   ; VDU 23, 0, &A0, bufferId; 1
0416E1             0033*   ; inputs: hl = bufferId
0416E1             0034*   vdu_call_buffer:
0416E1 22 F9 16 04 0035*       ld (@bufferId),hl
0416E5 3E 01       0036*       ld a,1 ; call buffer
0416E7 32 FB 16 04 0037*       ld (@bufferId+2),a
0416EB 21 F6 16 04 0038*       ld hl,@cmd
0416EF 01 06 00 00 0039*       ld bc,@end-@cmd
0416F3 5B DF       0040*       rst.lil $18
0416F5 C9          0041*       ret
0416F6 17 00 A0    0042*   @cmd:     db 23,0,0xA0
0416F9 00 00       0043*   @bufferId: dw 0x0000
0416FB 01          0044*              db 1 ; call buffer
0416FC             0045*   @end:
0416FC             0046*   ; end vdu_call_buffer
0416FC             0047*   
0416FC             0048*   ; Command 2: Clear a buffer
0416FC             0049*   ; VDU 23, 0 &A0, bufferId; 2
0416FC             0050*   ; inputs: hl = bufferId
0416FC             0051*   vdu_clear_buffer:
0416FC 22 14 17 04 0052*       ld (@bufferId),hl
041700 3E 02       0053*       ld a,2 ; clear buffer
041702 32 16 17 04 0054*       ld (@bufferId+2),a
041706 21 11 17 04 0055*       ld hl,@cmd
04170A 01 06 00 00 0056*       ld bc,@end-@cmd
04170E 5B DF       0057*       rst.lil $18
041710 C9          0058*       ret
041711 17 00 A0    0059*   @cmd:     db 23,0,0xA0
041714 00 00       0060*   @bufferId: dw 0x0000
041716 02          0061*              db 2 ; clear buffer
041717             0062*   @end:
041717             0063*   ; end vdu_clear_buffer
041717             0064*   
041717             0065*   ; Clear all buffers
041717             0066*   ; inputs: none
041717             0067*   vdu_clear_all_buffers:
041717             0068*   ; clear all buffers
041717 21 22 17 04 0069*       ld hl,@beg
04171B 01 06 00 00 0070*       ld bc,@end-@beg
04171F 5B DF       0071*       rst.lil $18
041721 C9          0072*       ret
041722 17 00 A0    0073*   @beg: db 23,0,$A0
041725 FF FF       0074*         dw -1 ; bufferId -1 (65535) means clear all buffers
041727 02          0075*         db 2  ; command 2: clear a buffer
041728             0076*   @end:
041728             0077*   ; end vdu_clear_all_buffers
041728             0078*   
041728             0079*   ; Command 3: Create a writeable buffer
041728             0080*   ; VDU 23, 0 &A0, bufferId; 3, length;
041728             0081*   ; inputs: hl = bufferId, bc = length
041728             0082*   vdu_create_writeable_buffer:
041728 22 45 17 04 0083*       ld (@bufferId),hl
04172C ED 43 48 17 0084*       ld (@length),bc
       04          
041731 3E 03       0085*       ld a,3 ; create writeable buffer
041733 32 47 17 04 0086*       ld (@bufferId+2),a
041737 21 42 17 04 0087*       ld hl,@cmd
04173B 01 08 00 00 0088*       ld bc,@end-@cmd
04173F 5B DF       0089*       rst.lil $18
041741 C9          0090*       ret
041742 17 00 A0    0091*   @cmd:     db 23,0,0xA0
041745 00 00       0092*   @bufferId: dw 0x0000
041747 03          0093*              db 3 ; create writeable buffer
041748 00 00       0094*   @length: dw 0x0000
04174A 00          0095*   @end:     db 0x00 ; padding
04174B             0096*   ; end vdu_create_writeable_buffer
04174B             0097*   
04174B             0098*   ; Command 4: Set output stream to a buffer
04174B             0099*   ; VDU 23, 0 &A0, bufferId; 4
04174B             0100*   ; inputs: hl = bufferId
04174B             0101*   vdu_set_output_stream_buffer:
04174B 22 63 17 04 0102*       ld (@bufferId),hl
04174F 3E 04       0103*       ld a,4 ; set output stream to buffer
041751 32 65 17 04 0104*       ld (@bufferId+2),a
041755 21 60 17 04 0105*       ld hl,@cmd
041759 01 06 00 00 0106*       ld bc,@end-@cmd
04175D 5B DF       0107*       rst.lil $18
04175F C9          0108*       ret
041760 17 00 A0    0109*   @cmd:     db 23,0,0xA0
041763 00 00       0110*   @bufferId: dw 0x0000
041765 04          0111*              db 4 ; set output stream to buffer
041766 00          0112*   @end:     db 0x00 ; padding
041767             0113*   ; end vdu_set_output_stream_buffer
041767             0114*   
041767             0115*   ; Command 5: Adjust buffer contents
041767             0116*   ; VDU 23, 0, &A0, bufferId; 5, operation, offset; [count;] <operand>, [arguments]
041767             0117*   vdu_adjust_buffer:
041767 C9          0118*       ret ; TODO: implement
041768             0119*   ; end vdu_adjust_buffer
041768             0120*   
041768             0121*   ; Command 6: Conditionally call a buffer
041768             0122*   ; VDU 23, 0, &A0, bufferId; 6, operation, checkBufferId; checkOffset; [arguments]
041768             0123*   vdu_call_buffer_conditional:
041768 C9          0124*       ret ; TODO: implement
041769             0125*   ; end vdu_call_buffer_conditional
041769             0126*   
041769             0127*   ; Command 7: Jump to a buffer
041769             0128*   ; VDU 23, 0, &A0, bufferId; 7
041769             0129*   ; inputs: hl = bufferId
041769             0130*   vdu_jump_to_buffer:
041769 22 81 17 04 0131*       ld (@bufferId),hl
04176D 3E 07       0132*       ld a,7 ; jump to buffer
04176F 32 83 17 04 0133*       ld (@bufferId+2),a
041773 21 7E 17 04 0134*       ld hl,@cmd
041777 01 06 00 00 0135*       ld bc,@end-@cmd
04177B 5B DF       0136*       rst.lil $18
04177D C9          0137*       ret
04177E 17 00 A0    0138*   @cmd:     db 23,0,0xA0
041781 00 00       0139*   @bufferId: dw 0x0000
041783 07          0140*              db 7 ; jump to buffer
041784 00          0141*   @end:     db 0x00 ; padding
041785             0142*   ; end vdu_jump_to_buffer
041785             0143*   
041785             0144*   ; Command 8: Conditional Jump to a buffer
041785             0145*   ; VDU 23, 0, &A0, bufferId; 8, operation, checkBufferId; checkOffset; [arguments]
041785             0146*   vdu_jump_to_buffer_conditional:
041785 C9          0147*       ret ; TODO: implement
041786             0148*   ; end vdu_jump_to_buffer_conditional
041786             0149*   
041786             0150*   ; Command 9: Jump to an offset in a buffer
041786             0151*   ; VDU 23, 0, &A0, bufferId; 9, offset; offsetHighByte, [blockNumber;]
041786             0152*   vdu_jump_to_buffer_offset:
041786 C9          0153*       ret ; TODO: implement
041787             0154*   ; end vdu_jump_to_buffer_offset
041787             0155*   
041787             0156*   ; Command 10: Conditional jump to an offset in a buffer
041787             0157*   ; VDU 23, 0, &A0, bufferId; 10, offset; offsetHighByte, [blockNumber;] [arguments]
041787             0158*   vdu_jump_to_buffer_offset_conditional:
041787 C9          0159*       ret ; TODO: implement
041788             0160*   ; end vdu_jump_to_buffer_offset_conditional
041788             0161*   
041788             0162*   ; Command 11: Call buffer with an offset
041788             0163*   ; VDU 23, 0, &A0, bufferId; 11, offset; offsetHighByte, [blockNumber;]
041788             0164*   vdu_call_buffer_offset:
041788 C9          0165*       ret ; TODO: implement
041789             0166*   ; end vdu_call_buffer_offset
041789             0167*   
041789             0041        include "vdu_fonts.inc"
041789             0001*   ; select font
041789             0002*   ; inputs: hl = bufferId, a = font flags
041789             0003*   ; Flags:
041789             0004*   ; Bit	Description
041789             0005*   ; 0	Adjust cursor position to ensure text baseline is aligned
041789             0006*   ;   0: Do not adjust cursor position (best for changing font on a new line)
041789             0007*   ;   1: Adjust cursor position (best for changing font in the middle of a line)
041789             0008*   ; 1-7	Reserved for future use
041789             0009*   ; VDU 23, 0, &95, 0, bufferId; flags: Select font
041789             0010*   vdu_font_select:
041789 22 A0 17 04 0011*       ld (@bufferId),hl
04178D 32 A2 17 04 0012*       ld (@flags),a
041791 21 9C 17 04 0013*       ld hl,@cmd
041795 01 07 00 00 0014*       ld bc,@end-@cmd
041799 5B DF       0015*       rst.lil $18
04179B C9          0016*       ret
04179C 17 00 95 00 0017*   @cmd: db 23, 0, 0x95, 0
0417A0 00 00       0018*   @bufferId: dw 0x0000
0417A2 00          0019*   @flags: db 0x00
0417A3             0020*   @end:
0417A3             0021*   
0417A3             0022*   ; create font from buffer
0417A3             0023*   ; inputs: hl = bufferId, e = width, d = height, d = ascent, a = flags
0417A3             0024*   ; VDU 23, 0, &95, 1, bufferId; width, height, ascent, flags: Create font from buffer
0417A3             0025*   vdu_font_create:
0417A3 22 C8 17 04 0026*       ld (@bufferId),hl
0417A7 ED 53 CA 17 0027*       ld (@width),de ; also loads height
       04          
0417AC 32 CD 17 04 0028*       ld (@flags),a
0417B0 7A          0029*       ld a,d ; height
0417B1 32 CC 17 04 0030*       ld (@ascent),a ; ascent = height
0417B5             0031*   ; consolidate buffer
0417B5 CD 13 15 04 0032*       call vdu_consolidate_buffer
0417B9             0033*   ; create font
0417B9 21 C4 17 04 0034*       ld hl,@cmd
0417BD 01 0A 00 00 0035*       ld bc,@end-@cmd
0417C1 5B DF       0036*       rst.lil $18
0417C3 C9          0037*       ret
0417C4 17 00 95 01 0038*   @cmd: db 23, 0, 0x95, 1
0417C8 00 00       0039*   @bufferId: dw 0x0000
0417CA 00          0040*   @width: db 0x00
0417CB 00          0041*   @height: db 0x00
0417CC 00          0042*   @ascent: db 0x00
0417CD 00          0043*   @flags: db 0x00
0417CE             0044*   @end:
0417CE             0045*   
0417CE             0046*   ; set or adjust font property
0417CE             0047*   ; inputs: hl = bufferId, a = field, de = value
0417CE             0048*   ; VDU 23, 0, &95, 2, bufferId; field, value;: Set or adjust font property
0417CE             0049*   vdu_font_property:
0417CE 22 EA 17 04 0050*       ld (@bufferId),hl
0417D2 32 EC 17 04 0051*       ld (@field),a
0417D6 ED 53 ED 17 0052*       ld (@value),de
       04          
0417DB 21 E6 17 04 0053*       ld hl,@cmd
0417DF 01 09 00 00 0054*       ld bc,@end-@cmd
0417E3 5B DF       0055*       rst.lil $18
0417E5 C9          0056*       ret
0417E6 17 00 95 02 0057*   @cmd: db 23, 0, 0x95, 2
0417EA 00 00       0058*   @bufferId: dw 0x0000
0417EC 00          0059*   @field: db 0x00
0417ED 00 00       0060*   @value: dw 0x0000
0417EF 00          0061*   @end: db 0x00 ; padding
0417F0             0062*   
0417F0             0063*   ; VDU 23, 0, &95, 3, bufferId; [<args>]: Reserved
0417F0             0064*   
0417F0             0065*   ; Clear/Delete font
0417F0             0066*   ; inputs: hl = bufferId
0417F0             0067*   ; VDU 23, 0, &95, 4, bufferId;: Clear/Delete font
0417F0             0068*   vdu_font_clear:
0417F0 22 03 18 04 0069*       ld (@bufferId),hl
0417F4 21 FF 17 04 0070*       ld hl,@cmd
0417F8 01 06 00 00 0071*       ld bc,@end-@cmd
0417FC 5B DF       0072*       rst.lil $18
0417FE C9          0073*       ret
0417FF 17 00 95 04 0074*   @cmd: db 23, 0, 0x95, 4
041803 00 00       0075*   @bufferId: dw 0x0000
041805 00          0076*   @end: db 0x00 ; padding
041806             0077*   
041806             0078*   ; Copy system font to buffer
041806             0079*   ; inputs: hl = bufferId
041806             0080*   ; VDU 23, 0, &95, 5, bufferId;: Copy system font to buffer
041806             0081*   vdu_font_copy_system:
041806 22 19 18 04 0082*       ld (@bufferId),hl
04180A 21 15 18 04 0083*       ld hl,@cmd
04180E 01 06 00 00 0084*       ld bc,@end-@cmd
041812 5B DF       0085*       rst.lil $18
041814 C9          0086*       ret
041815 17 00 95 05 0087*   @cmd: db 23, 0, 0x95, 5
041819 00 00       0088*   @bufferId: dw 0x0000
04181B 00          0089*   @end: db 0x00 ; padding
04181C             0042        include "vdu_plot.inc"
04181C             0001*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
04181C             0002*   ; PLOT code 	(Decimal) 	Effect
04181C             0003*   ; &00-&07 	0-7 	Solid line, includes both ends
04181C             0004*   plot_sl_both: equ 0x00
04181C             0005*   
04181C             0006*   ; &08-&0F 	8-15 	Solid line, final point omitted
04181C             0007*   plot_sl_first: equ 0x08
04181C             0008*   
04181C             0009*   ; &10-&17 	16-23 	Not supported (Dot-dash line, includes both ends, pattern restarted)
04181C             0010*   ; &18-&1F 	24-31 	Not supported (Dot-dash line, first point omitted, pattern restarted)
04181C             0011*   
04181C             0012*   ; &20-&27 	32-39 	Solid line, first point omitted
04181C             0013*   plot_sl_last: equ 0x20
04181C             0014*   
04181C             0015*   ; &28-&2F 	40-47 	Solid line, both points omitted
04181C             0016*   plot_sl_none: equ 0x28
04181C             0017*   
04181C             0018*   ; &30-&37 	48-55 	Not supported (Dot-dash line, first point omitted, pattern continued)
04181C             0019*   ; &38-&3F 	56-63 	Not supported (Dot-dash line, both points omitted, pattern continued)
04181C             0020*   
04181C             0021*   ; &40-&47 	64-71 	Point plot
04181C             0022*   plot_pt: equ 0x40
04181C             0023*   
04181C             0024*   ; &48-&4F 	72-79 	Line fill left and right to non-background §§
04181C             0025*   plot_lf_lr_non_bg: equ 0x48
04181C             0026*   
04181C             0027*   ; &50-&57 	80-87 	Triangle fill
04181C             0028*   plot_tf: equ 0x50
04181C             0029*   
04181C             0030*   ; &58-&5F 	88-95 	Line fill right to background §§
04181C             0031*   plot_lf_r_bg: equ 0x58
04181C             0032*   
04181C             0033*   ; &60-&67 	96-103 	Rectangle fill
04181C             0034*   plot_rf: equ 0x60
04181C             0035*   
04181C             0036*   ; &68-&6F 	104-111 	Line fill left and right to foreground §§
04181C             0037*   plot_lf_lr_fg: equ 0x60
04181C             0038*   
04181C             0039*   ; &70-&77 	112-119 	Parallelogram fill
04181C             0040*   plot_pf: equ 0x70
04181C             0041*   
04181C             0042*   ; &78-&7F 	120-127 	Line fill right to non-foreground §§
04181C             0043*   plot_lf_r_non_fg: equ 0x78
04181C             0044*   
04181C             0045*   ; &80-&87 	128-135 	Not supported (Flood until non-background)
04181C             0046*   ; &88-&8F 	136-143 	Not supported (Flood until foreground)
04181C             0047*   
04181C             0048*   ; &90-&97 	144-151 	Circle outline
04181C             0049*   plot_co: equ 0x90
04181C             0050*   
04181C             0051*   ; &98-&9F 	152-159 	Circle fill
04181C             0052*   plot_cf: equ 0x98
04181C             0053*   
04181C             0054*   ; &A0-&A7 	160-167 	Not supported (Circular arc)
04181C             0055*   ; &A8-&AF 	168-175 	Not supported (Circular segment)
04181C             0056*   ; &B0-&B7 	176-183 	Not supported (Circular sector)
04181C             0057*   
04181C             0058*   ; &B8-&BF 	184-191 	Rectangle copy/move
04181C             0059*   plot_rcm: equ 0xB8
04181C             0060*   
04181C             0061*   ; &C0-&C7 	192-199 	Not supported (Ellipse outline)
04181C             0062*   ; &C8-&CF 	200-207 	Not supported (Ellipse fill)
04181C             0063*   ; &D0-&D7 	208-215 	Not defined
04181C             0064*   ; &D8-&DF 	216-223 	Not defined
04181C             0065*   ; &E0-&E7 	224-231 	Not defined
04181C             0066*   
04181C             0067*   ; &E8-&EF 	232-239 	Bitmap plot §
04181C             0068*   plot_bmp: equ 0xE8
04181C             0069*   
04181C             0070*   ; &F0-&F7 	240-247 	Not defined
04181C             0071*   ; &F8-&FF 	248-255 	Not defined
04181C             0072*   
04181C             0073*   ; § Support added in Agon Console8 VDP 2.1.0 §§ Support added in
04181C             0074*   ; Agon Console8 VDP 2.2.0
04181C             0075*   
04181C             0076*   ; Within each group of eight plot codes, the effects are as follows:
04181C             0077*   ; Plot code 	Effect
04181C             0078*   ; 0 	Move relative
04181C             0079*   mv_rel: equ 0
04181C             0080*   
04181C             0081*   ; 1 	Plot relative in current foreground colour
04181C             0082*   dr_rel_fg: equ 1
04181C             0083*   
04181C             0084*   ; 2 	Not supported (Plot relative in logical inverse colour)
04181C             0085*   ; 3 	Plot relative in current background colour
04181C             0086*   dr_rel_bg: equ 3
04181C             0087*   
04181C             0088*   ; 4 	Move absolute
04181C             0089*   mv_abs: equ 4
04181C             0090*   
04181C             0091*   ; 5 	Plot absolute in current foreground colour
04181C             0092*   dr_abs_fg: equ 5
04181C             0093*   
04181C             0094*   ; 6 	Not supported (Plot absolute in logical inverse colour)
04181C             0095*   ; 7 	Plot absolute in current background colour
04181C             0096*   dr_abs_bg: equ 7
04181C             0097*   
04181C             0098*   ; Codes 0-3 use the position data provided as part of the command
04181C             0099*   ; as a relative position, adding the position given to the current
04181C             0100*   ; graphical cursor position. Codes 4-7 use the position data provided
04181C             0101*   ; as part of the command as an absolute position, setting the current
04181C             0102*   ; graphical cursor position to the position given.
04181C             0103*   
04181C             0104*   ; Codes 2 and 6 on Acorn systems plot using a logical inverse of the
04181C             0105*   ; current pixel colour. These operations cannot currently be supported
04181C             0106*   ; by the graphics system the Agon VDP uses, so these codes are not
04181C             0107*   ; supported. Support for these codes may be added in a future version
04181C             0108*   ; of the VDP firmware.
04181C             0109*   
04181C             0110*   ; 16 colour palette constants
04181C             0111*   c_black: equ 0
04181C             0112*   c_red_dk: equ 1
04181C             0113*   c_green_dk: equ 2
04181C             0114*   c_yellow_dk: equ 3
04181C             0115*   c_blue_dk: equ 4
04181C             0116*   c_magenta_dk: equ 5
04181C             0117*   c_cyan_dk: equ 6
04181C             0118*   c_grey: equ 7
04181C             0119*   c_grey_dk: equ 8
04181C             0120*   c_red: equ 9
04181C             0121*   c_green: equ 10
04181C             0122*   c_yellow: equ 11
04181C             0123*   c_blue: equ 12
04181C             0124*   c_magenta: equ 13
04181C             0125*   c_cyan: equ 14
04181C             0126*   c_white: equ 15
04181C             0127*   
04181C             0128*   ; VDU 25, mode, x; y;: PLOT command
04181C             0129*   ; inputs: a=mode, bc=x0, de=y0
04181C             0130*   vdu_plot:
04181C 32 36 18 04 0131*       ld (@mode),a
041820 ED 43 37 18 0132*       ld (@x0),bc
       04          
041825 ED 53 39 18 0133*       ld (@y0),de
       04          
04182A 21 35 18 04 0134*   	ld hl,@cmd
04182E 01 06 00 00 0135*   	ld bc,@end-@cmd
041832 5B DF       0136*   	rst.lil $18
041834 C9          0137*   	ret
041835 19          0138*   @cmd:   db 25
041836 00          0139*   @mode:  db 0
041837 00 00       0140*   @x0: 	dw 0
041839 00 00       0141*   @y0: 	dw 0
04183B 00          0142*   @end:   db 0 ; extra byte to soak up deu
04183C             0143*   
04183C             0144*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
04183C             0145*   ; &E8-&EF 	232-239 	Bitmap plot §
04183C             0146*   ; VDU 25, mode, x; y;: PLOT command
04183C             0147*   ; inputs: bc=x0, de=y0
04183C             0148*   ; prerequisites: vdu_buff_select
04183C             0149*   vdu_plot_bmp:
04183C ED 43 53 18 0150*       ld (@x0),bc
       04          
041841 ED 53 55 18 0151*       ld (@y0),de
       04          
041846 21 51 18 04 0152*   	ld hl,@cmd
04184A 01 06 00 00 0153*   	ld bc,@end-@cmd
04184E 5B DF       0154*   	rst.lil $18
041850 C9          0155*   	ret
041851 19          0156*   @cmd:   db 25
041852 ED          0157*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
041853 00 00       0158*   @x0: 	dw 0x0000
041855 00 00       0159*   @y0: 	dw 0x0000
041857 00          0160*   @end:   db 0x00 ; padding
041858             0161*   
041858             0162*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
041858             0163*   ; &E8-&EF 	232-239 	Bitmap plot §
041858             0164*   ; VDU 25, mode, x; y;: PLOT command
041858             0165*   ; inputs: bc=x0, de=y0
041858             0166*   ; USING 16.8 FIXED POINT COORDINATES
041858             0167*   ; inputs: ub.c is x coordinate, ud.e is y coordinate
041858             0168*   ;   the fractional portiion of the inputs are truncated
041858             0169*   ;   leaving only the 16-bit integer portion
041858             0170*   ; prerequisites: vdu_buff_select
041858             0171*   vdu_plot_bmp168:
041858             0172*   ; populate in the reverse of normal to keep the
041858             0173*   ; inputs from stomping on each other
041858 ED 53 76 18 0174*       ld (@y0-1),de
       04          
04185D ED 43 74 18 0175*       ld (@x0-1),bc
       04          
041862 3E ED       0176*       ld a,plot_bmp+dr_abs_fg ; 0xED
041864 32 74 18 04 0177*       ld (@mode),a ; restore the mode byte that got stomped on by bcu
041868 21 73 18 04 0178*   	ld hl,@cmd
04186C 01 06 00 00 0179*   	ld bc,@end-@cmd
041870 5B DF       0180*   	rst.lil $18
041872 C9          0181*   	ret
041873 19          0182*   @cmd:   db 25
041874 ED          0183*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
041875 00 00       0184*   @x0: 	dw 0x0000
041877 00 00       0185*   @y0: 	dw 0x0000
041879             0186*   @end:  ; no padding required b/c we shifted de right
041879             0187*   
041879             0188*   ; draw a filled rectangle
041879             0189*   vdu_plot_rf:
041879 ED 43 A0 18 0190*       ld (@x0),bc
       04          
04187E ED 53 A2 18 0191*       ld (@y0),de
       04          
041883 DD 22 A6 18 0192*       ld (@x1),ix
       04          
041888 FD 22 A8 18 0193*       ld (@y1),iy
       04          
04188D 3E 19       0194*       ld a,25 ; we have to reload the 2nd plot command
04188F 32 A4 18 04 0195*       ld (@cmd1),a ; because the 24-bit y0 load stomped on it
041893 21 9E 18 04 0196*   	ld hl,@cmd0
041897 01 0C 00 00 0197*   	ld bc,@end-@cmd0
04189B 5B DF       0198*   	rst.lil $18
04189D C9          0199*       ret
04189E 19          0200*   @cmd0:  db 25 ; plot
04189F 04          0201*   @arg0:  db plot_sl_both+mv_abs
0418A0 00 00       0202*   @x0:    dw 0x0000
0418A2 00 00       0203*   @y0:    dw 0x0000
0418A4 19          0204*   @cmd1:  db 25 ; plot
0418A5 65          0205*   @arg1:  db plot_rf+dr_abs_fg
0418A6 00 00       0206*   @x1:    dw 0x0000
0418A8 00 00       0207*   @y1:    dw 0x0000
0418AA 00          0208*   @end:   db 0x00 ; padding
0418AB             0209*   
0418AB             0210*   ; draw a filled circle
0418AB             0211*   vdu_plot_cf:
0418AB ED 43 D2 18 0212*       ld (@x0),bc
       04          
0418B0 ED 53 D4 18 0213*       ld (@y0),de
       04          
0418B5 DD 22 D8 18 0214*       ld (@x1),ix
       04          
0418BA FD 22 DA 18 0215*       ld (@y1),iy
       04          
0418BF 3E 19       0216*       ld a,25 ; we have to reload the 2nd plot command
0418C1 32 D6 18 04 0217*       ld (@cmd1),a ; because the 24-bit y0 load stomped on it
0418C5 21 D0 18 04 0218*   	ld hl,@cmd0
0418C9 01 0C 00 00 0219*   	ld bc,@end-@cmd0
0418CD 5B DF       0220*   	rst.lil $18
0418CF C9          0221*       ret
0418D0 19          0222*   @cmd0:  db 25 ; plot
0418D1 04          0223*   @arg0:  db plot_sl_both+mv_abs
0418D2 00 00       0224*   @x0:    dw 0x0000
0418D4 00 00       0225*   @y0:    dw 0x0000
0418D6 19          0226*   @cmd1:  db 25 ; plot
0418D7 9D          0227*   @arg1:  db plot_cf+dr_abs_fg
0418D8 00 00       0228*   @x1:    dw 0x0000
0418DA 00 00       0229*   @y1:    dw 0x0000
0418DC 00          0230*   @end:   db 0x00 ; padding
0418DD             0043        include "vdu_sprites.inc"
0418DD             0001*   ; ; https://github.com/AgonConsole8/agon-docs/blob/main/VDP---Bitmaps-API.md
0418DD             0002*   ; the VDP can support up to 256 sprites. They must be defined
0418DD             0003*   ; contiguously, and so the first sprite is sprite 0.
0418DD             0004*   ; (In contrast, bitmaps can have any ID from 0 to 65534.)
0418DD             0005*   ; Once a selection of sprites have been defined, you can activate
0418DD             0006*   ; them using the VDU 23, 27, 7, n command, where n is the number
0418DD             0007*   ; of sprites to activate. This will activate the first n sprites,
0418DD             0008*   ; starting with sprite 0. All sprites from 0 to n-1 must be defined.
0418DD             0009*   
0418DD             0010*   ; A single sprite can have multiple "frames", referring to
0418DD             0011*   ; different bitmaps.
0418DD             0012*   ; (These bitmaps do not need to be the same size.)
0418DD             0013*   ; This allows a sprite to include an animation sequence,
0418DD             0014*   ; which can be stepped through one frame at a time, or picked
0418DD             0015*   ; in any order.
0418DD             0016*   
0418DD             0017*   ; Any format of bitmap can be used as a sprite frame. It should
0418DD             0018*   ; be noted however that "native" format bitmaps are not
0418DD             0019*   ; recommended for use as sprite frames, as they cannot get
0418DD             0020*   ; erased from the screen. (As noted above, the "native" bitmap
0418DD             0021*   ; format is not really intended for general use.) This is part
0418DD             0022*   ; of why from Agon Console8 VDP 2.6.0 bitmaps captured from the
0418DD             0023*   ; screen are now stored in RGBA2222 format.
0418DD             0024*   
0418DD             0025*   ; An "active" sprite can be hidden, so it will stop being drawn,
0418DD             0026*   ; and then later shown again.
0418DD             0027*   
0418DD             0028*   ; Moving sprites around the screen is done by changing the
0418DD             0029*   ; position of the sprite. This can be done either by setting
0418DD             0030*   ; the absolute position of the sprite, or by moving the sprite
0418DD             0031*   ; by a given number of pixels. (Sprites are positioned using
0418DD             0032*   ; pixel coordinates, and not by the logical OS coordinate system.)
0418DD             0033*   ; In the current sprite system, sprites will not update their
0418DD             0034*   ; position on-screen until either another drawing operation is
0418DD             0035*   ; performed or an explicit VDU 23, 27, 15 command is performed.
0418DD             0036*   
0418DD             0037*   ; VDU 23, 27, 4, n: Select sprite n
0418DD             0038*   ; inputs: a is the 8-bit sprite id
0418DD             0039*   vdu_sprite_select:
0418DD 32 EF 18 04 0040*       ld (@sprite),a
0418E1 21 EC 18 04 0041*       ld hl,@cmd
0418E5 01 04 00 00 0042*       ld bc,@end-@cmd
0418E9 5B DF       0043*       rst.lil $18
0418EB C9          0044*       ret
0418EC 17 1B 04    0045*   @cmd:    db 23,27,4
0418EF 00          0046*   @sprite: db 0x00
0418F0             0047*   @end:
0418F0             0048*   
0418F0             0049*   ; VDU 23, 27, 5: Clear frames in current sprite
0418F0             0050*   ; inputs: none
0418F0             0051*   ; prerequisites: vdu_sprite_select
0418F0             0052*   vdu_sprite_clear_frames:
0418F0 21 FB 18 04 0053*       ld hl,@cmd
0418F4 01 03 00 00 0054*       ld bc,@end-@cmd
0418F8 5B DF       0055*       rst.lil $18
0418FA C9          0056*       ret
0418FB 17 1B 05    0057*   @cmd: db 23,27,5
0418FE             0058*   @end:
0418FE             0059*   
0418FE             0060*   ; VDU 23, 27, 6, n: Add bitmap n as a frame to current sprite (where bitmap's buffer ID is 64000+n)
0418FE             0061*   ; inputs: a is the 8-bit bitmap number
0418FE             0062*   ; prerequisites: vdu_sprite_select
0418FE             0063*   vdu_sprite_add_bmp:
0418FE 32 10 19 04 0064*       ld (@bmp),a
041902 21 0D 19 04 0065*       ld hl,@cmd
041906 01 04 00 00 0066*       ld bc,@end-@cmd
04190A 5B DF       0067*       rst.lil $18
04190C C9          0068*       ret
04190D 17 1B 06    0069*   @cmd: db 23,27,6
041910 00          0070*   @bmp: db 0x00
041911             0071*   @end:
041911             0072*   
041911             0073*   ; VDU 23, 27, 7, n: Activate n sprites
041911             0074*   ; inputs: a is the number of sprites to activate
041911             0075*   ; prerequisites: each sprite activated must have at least one frame attached to it
041911             0076*   vdu_sprite_activate:
041911 32 23 19 04 0077*       ld (@num),a
041915 21 20 19 04 0078*       ld hl,@cmd
041919 01 04 00 00 0079*       ld bc,@end-@cmd
04191D 5B DF       0080*       rst.lil $18
04191F C9          0081*       ret
041920 17 1B 07    0082*   @cmd: db 23,27,7
041923 00          0083*   @num: db 0x00
041924             0084*   @end:
041924             0085*   
041924             0086*   ; VDU 23, 27, 8: Select next frame of current sprite
041924             0087*   ; inputs: none
041924             0088*   ; prerequisites: vdu_sprite_select
041924             0089*   vdu_sprite_next_frame:
041924 21 2F 19 04 0090*       ld hl,@cmd
041928 01 03 00 00 0091*       ld bc,@end-@cmd
04192C 5B DF       0092*       rst.lil $18
04192E C9          0093*       ret
04192F 17 1B 08    0094*   @cmd: db 23,27,8
041932             0095*   @end:
041932             0096*   
041932             0097*   ; VDU 23, 27, 9: Select previous frame of current sprite
041932             0098*   ; inputs: none
041932             0099*   ; prerequisites: vdu_sprite_select
041932             0100*   vdu_sprite_prev_frame:
041932 21 3D 19 04 0101*       ld hl,@cmd
041936 01 03 00 00 0102*       ld bc,@end-@cmd
04193A 5B DF       0103*       rst.lil $18
04193C C9          0104*       ret
04193D 17 1B 09    0105*   @cmd: db 23,27,9
041940             0106*   @end:
041940             0107*   
041940             0108*   ; VDU 23, 27, 10, n: Select the nth frame of current sprite
041940             0109*   ; inputs: a is frame number to select
041940             0110*   ; prerequisites: vdu_sprite_select
041940             0111*   vdu_sprite_select_frame:
041940 32 52 19 04 0112*       ld (@frame),a
041944 21 4F 19 04 0113*       ld hl,@cmd
041948 01 04 00 00 0114*       ld bc,@end-@cmd
04194C 5B DF       0115*       rst.lil $18
04194E C9          0116*       ret
04194F 17 1B 0A    0117*   @cmd:    db 23,27,10
041952 00          0118*   @frame:  db 0x00
041953             0119*   @end:
041953             0120*   
041953             0121*   ; VDU 23, 27, 11: Show current sprite
041953             0122*   ; inputs: none
041953             0123*   ; prerequisites: vdu_sprite_select
041953             0124*   vdu_sprite_show:
041953 21 5E 19 04 0125*       ld hl,@cmd
041957 01 03 00 00 0126*       ld bc,@end-@cmd
04195B 5B DF       0127*       rst.lil $18
04195D C9          0128*       ret
04195E 17 1B 0B    0129*   @cmd: db 23,27,11
041961             0130*   @end:
041961             0131*   
041961             0132*   ; VDU 23, 27, 12: Hide current sprite
041961             0133*   ; inputs: none
041961             0134*   ; prerequisites: vdu_sprite_select
041961             0135*   vdu_sprite_hide:
041961 21 6C 19 04 0136*       ld hl,@cmd
041965 01 03 00 00 0137*       ld bc,@end-@cmd
041969 5B DF       0138*       rst.lil $18
04196B C9          0139*       ret
04196C 17 1B 0C    0140*   @cmd: db 23,27,12
04196F             0141*   @end:
04196F             0142*   
04196F             0143*   ; VDU 23, 27, 13, x; y;: Move current sprite to pixel position x, y
04196F             0144*   ; inputs: bc is x coordinate, de is y coordinate
04196F             0145*   ; prerequisites: vdu_sprite_select
04196F             0146*   vdu_sprite_move_abs:
04196F ED 43 87 19 0147*       ld (@xpos),bc
       04          
041974 ED 53 89 19 0148*       ld (@ypos),de
       04          
041979 21 84 19 04 0149*       ld hl,@cmd
04197D 01 07 00 00 0150*       ld bc,@end-@cmd
041981 5B DF       0151*       rst.lil $18
041983 C9          0152*       ret
041984 17 1B 0D    0153*   @cmd:  db 23,27,13
041987 00 00       0154*   @xpos: dw 0x0000
041989 00 00       0155*   @ypos: dw 0x0000
04198B 00          0156*   @end:  db 0x00 ; padding
04198C             0157*   
04198C             0158*   ; VDU 23, 27, 14, x; y;: Move current sprite by x, y pixels
04198C             0159*   ; inputs: bc is x coordinate, de is y coordinate
04198C             0160*   ; prerequisites: vdu_sprite_select
04198C             0161*   vdu_sprite_move_rel:
04198C ED 43 A4 19 0162*       ld (@dx),bc
       04          
041991 ED 53 A6 19 0163*       ld (@dy),de
       04          
041996 21 A1 19 04 0164*       ld hl,@cmd
04199A 01 07 00 00 0165*       ld bc,@end-@cmd
04199E 5B DF       0166*       rst.lil $18
0419A0 C9          0167*       ret
0419A1 17 1B 0E    0168*   @cmd: db 23,27,14
0419A4 00 00       0169*   @dx:  dw 0x0000
0419A6 00 00       0170*   @dy:  dw 0x0000
0419A8 00          0171*   @end: db 0x00 ; padding
0419A9             0172*   
0419A9             0173*   ; VDU 23, 27, 13, x; y;: Move current sprite to pixel position x, y
0419A9             0174*   ; USING 16.8 FIXED POINT COORDINATES
0419A9             0175*   ; inputs: ub.c is x coordinate, ud.e is y coordinate
0419A9             0176*   ;   the fractional portiion of the inputs are truncated
0419A9             0177*   ;   leaving only the 16-bit integer portion
0419A9             0178*   ; prerequisites: vdu_sprite_select
0419A9             0179*   vdu_sprite_move_abs168:
0419A9             0180*   ; offset inputs by the gfx origin
0419A9             0181*   ; y coordinate
0419A9 21 00 30 00 0182*       ld hl,origin_top*256
0419AD 19          0183*       add hl,de
0419AE 22 D0 19 04 0184*       ld (@ypos-1),hl
0419B2             0185*   ; x coordinate
0419B2 21 00 80 00 0186*       ld hl,origin_left*256
0419B6 09          0187*       add hl,bc
0419B7 22 CE 19 04 0188*       ld (@xpos-1),hl
0419BB             0189*   ; prepare vdu command
0419BB 3E 0D       0190*       ld a,13       ; restore the final byte of the command
0419BD 32 CE 19 04 0191*       ld (@cmd+2),a ; string that got stomped on by bcu
0419C1 21 CC 19 04 0192*       ld hl,@cmd
0419C5 01 07 00 00 0193*       ld bc,@end-@cmd
0419C9 5B DF       0194*       rst.lil $18
0419CB C9          0195*       ret
0419CC 17 1B 0D    0196*   @cmd:  db 23,27,13
0419CF 00 00       0197*   @xpos: dw 0x0000
0419D1 00 00       0198*   @ypos: dw 0x0000
0419D3             0199*   @end:  ; no padding required b/c we shifted de right
0419D3             0200*   
0419D3             0201*   ; VDU 23, 27, 14, x; y;: Move current sprite by x, y pixels
0419D3             0202*   ; USING 16.8 FIXED POINT COORDINATES
0419D3             0203*   ; inputs: ub.c is dx, ud.e is dy
0419D3             0204*   ;   the fractional portiion of the inputs are truncated
0419D3             0205*   ;   leaving only the 16-bit integer portion
0419D3             0206*   ; prerequisites: vdu_sprite_select
0419D3             0207*   vdu_sprite_move_rel168:
0419D3             0208*   ; populate in the reverse of normal to keep the
0419D3             0209*   ; inputs from stomping on each other
0419D3 ED 53 F2 19 0210*       ld (@dy-1),de
       04          
0419D8 ED 43 F0 19 0211*       ld (@dx-1),bc
       04          
0419DD 3E 0E       0212*       ld a,14       ; restore the final byte of the command
0419DF 32 F0 19 04 0213*       ld (@cmd+2),a ; string that got stomped on by bcu
0419E3 21 EE 19 04 0214*       ld hl,@cmd
0419E7 01 07 00 00 0215*       ld bc,@end-@cmd
0419EB 5B DF       0216*       rst.lil $18
0419ED C9          0217*       ret
0419EE 17 1B 0E    0218*   @cmd:  db 23,27,14
0419F1 00 00       0219*   @dx: dw 0x0000
0419F3 00 00       0220*   @dy: dw 0x0000
0419F5             0221*   @end:  ; no padding required b/c we shifted de right
0419F5             0222*   
0419F5             0223*   ; VDU 23, 27, 15: Update the sprites in the GPU
0419F5             0224*   ; inputs: none
0419F5             0225*   vdu_sprite_update:
0419F5 21 00 1A 04 0226*       ld hl,@cmd
0419F9 01 03 00 00 0227*       ld bc,@end-@cmd
0419FD 5B DF       0228*       rst.lil $18
0419FF C9          0229*       ret
041A00 17 1B 0F    0230*   @cmd: db 23,27,15
041A03             0231*   @end:
041A03             0232*   
041A03             0233*   ; VDU 23, 27, 16: Reset bitmaps and sprites and clear all data
041A03             0234*   ; inputs: none
041A03             0235*   vdu_sprite_bmp_reset:
041A03 21 0E 1A 04 0236*       ld hl,@cmd
041A07 01 03 00 00 0237*       ld bc,@end-@cmd
041A0B 5B DF       0238*       rst.lil $18
041A0D C9          0239*       ret
041A0E 17 1B 10    0240*   @cmd: db 23,27,16
041A11             0241*   @end:
041A11             0242*   
041A11             0243*   ; VDU 23, 27, 17: Reset sprites (only) and clear all data
041A11             0244*   ; inputs: none
041A11             0245*   vdu_sprite_reset:
041A11 21 1C 1A 04 0246*       ld hl,@cmd
041A15 01 03 00 00 0247*       ld bc,@end-@cmd
041A19 5B DF       0248*       rst.lil $18
041A1B C9          0249*       ret
041A1C 17 1B 11    0250*   @cmd: db 23,27,17
041A1F             0251*   @end:
041A1F             0252*   
041A1F             0253*   ; VDU 23, 27, 18, n: Set the current sprite GCOL paint mode to n **
041A1F             0254*   ; inputs: a is the GCOL paint mode
041A1F             0255*   ; prerequisites: vdu_sprite_select
041A1F             0256*   vdu_sprite_set_gcol:
041A1F 32 31 1A 04 0257*       ld (@mode),a
041A23 21 2E 1A 04 0258*       ld hl,@cmd
041A27 01 04 00 00 0259*       ld bc,@end-@cmd
041A2B 5B DF       0260*       rst.lil $18
041A2D C9          0261*       ret
041A2E 17 1B 12    0262*   @cmd:  db 23,27,18
041A31 00          0263*   @mode: db 0x00
041A32             0264*   @end:
041A32             0265*   
041A32             0266*   ; VDU 23, 27, &26, n;: Add bitmap n as a frame to current sprite using a 16-bit buffer ID
041A32             0267*   ; inputs: hl=bufferId
041A32             0268*   ; prerequisites: vdu_sprite_select
041A32             0269*   vdu_sprite_add_buff:
041A32 22 44 1A 04 0270*       ld (@bufferId),hl
041A36 21 41 1A 04 0271*       ld hl,@cmd
041A3A 01 05 00 00 0272*       ld bc,@end-@cmd
041A3E 5B DF       0273*       rst.lil $18
041A40 C9          0274*       ret
041A41 17 1B 26    0275*   @cmd:      db 23,27,0x26
041A44 00 00       0276*   @bufferId: dw 0x0000
041A46 00          0277*   @end:      db 0x00 ; padding
