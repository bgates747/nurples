042082             0038*   ; move projectile one frame's distance so it isn't drawn right over turret
042082 DD 27 01    0039*       ld hl,(ix+sprite_x)
042085 DD 17 07    0040*       ld de,(ix+sprite_xvel)
042088 19          0041*       add hl,de
