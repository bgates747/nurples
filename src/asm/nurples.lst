046F1F             0073        include "targeting.inc"
046F1F             0001*   ; compute orientation to player
046F1F             0002*   ; based on relative positions
046F1F             0003*   ; returns: uh.l 16.8 fixed angle256 to player
046F1F             0004*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
046F1F             0005*   ;    representing delta-x/y *to* target respectively
046F1F             0006*   ; inputs: iy pointed at sprite record
046F1F             0007*   ; destroys: everything except iy (sprite record pointer)
046F1F             0008*   orientation_to_player:
046F1F DD 21 86 88 0009*       ld ix,player_begin
       04          
046F24             0010*   ; compute dx
046F24 DD 27 01    0011*       ld hl,(ix+sprite_x)
046F27 FD 17 01    0012*       ld de,(iy+sprite_x)
046F2A B7          0013*       or a ; clear carry
046F2B ED 52       0014*       sbc hl,de ; dx
046F2D E5          0015*       push hl ; save dx
046F2E             0016*   ; compute dy
046F2E DD 27 04    0017*       ld hl,(ix+sprite_y)
046F31 FD 17 04    0018*       ld de,(iy+sprite_y)
046F34 B7          0019*       or a ; clear carry
046F35 ED 52       0020*       sbc hl,de ; dy
046F37 EB          0021*       ex de,hl ; de = dy
046F38             0022*   ; compute angle to player
046F38 C1          0023*       pop bc ; dx (was hl)
046F39 C5          0024*       push bc ; save dx
046F3A D5          0025*       push de ; save dy
046F3B CD F0 07 04 0026*       call atan2_168fast ; uh.l = angle to player
046F3F 3E E0       0027*       ld a,%11100000
046F41 A5          0028*       and l ; round angle to nearest 32th of a circle
046F42 6F          0029*       ld l,a
046F43 22 94 6F 04 0030*       ld (Bearing_t),hl ; return angle to player
046F47 D1          0031*       pop de ; restore dy
046F48 C1          0032*       pop bc ; restore dx
046F49 C9          0033*       ret
046F4A             0034*   ; end orientation_to_player
046F4A             0035*   
046F4A             0036*   ; compute orientation to player
046F4A             0037*   ; based on relative positions
046F4A             0038*   ; returns: uh.l 16.8 fixed angle256 to player
046F4A             0039*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
046F4A             0040*   ;    representing delta-x/y *to* target respectively
046F4A             0041*   ; inputs: iy pointed at tile record
046F4A             0042*   ; destroys: everything except iy (tile record pointer)
046F4A             0043*   tile_orientation_to_player:
046F4A DD 21 86 88 0044*       ld ix,player_begin
       04          
046F4F             0045*   ; compute dx
046F4F DD 27 01    0046*       ld hl,(ix+sprite_x)
046F52 FD 17 01    0047*       ld de,(iy+tile_x)
046F55 B7          0048*       or a ; clear carry
046F56 ED 52       0049*       sbc hl,de ; dx
046F58 E5          0050*       push hl ; save dx
046F59             0051*   ; compute dy
046F59 DD 27 04    0052*       ld hl,(ix+sprite_y)
046F5C FD 17 04    0053*       ld de,(iy+tile_y)
046F5F B7          0054*       or a ; clear carry
046F60 ED 52       0055*       sbc hl,de ; dy
046F62 EB          0056*       ex de,hl ; de = dy
046F63             0057*   ; compute angle to player
046F63 C1          0058*       pop bc ; dx (was hl)
046F64 CD F0 07 04 0059*       call atan2_168fast ; uh.l = angle to player
046F68 3E E0       0060*       ld a,%11100000
046F6A A5          0061*       and l ; round angle to nearest 32th of a circle
046F6B 6F          0062*       ld l,a
046F6C 22 94 6F 04 0063*       ld (Bearing_t),hl
046F70 C9          0064*       ret
046F71             0065*   ; end tile_orientation_to_player
046F71             0066*   
046F71             0067*   ; compute orientation to coordinate
046F71             0068*   ; based on relative positions
046F71             0069*   ; returns: uh.l 16.8 fixed angle256 to coordinate
046F71             0070*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
046F71             0071*   ;    representing delta-x/y *to* target respectively
046F71             0072*   ; inputs: iy pointed at sprite record, ub.c,ud.e are target x,y coordinates
046F71             0073*   ; destroys: everything except iy (sprite record pointer)
046F71             0074*   bearing_to_coord:
046F71             0075*   ; compute dx
046F71 C5          0076*       push bc
046F72 E1          0077*       pop hl
046F73 FD 07 01    0078*       ld bc,(iy+sprite_x)
046F76 B7          0079*       or a ; clear carry
046F77 ED 42       0080*       sbc hl,bc ; dx
046F79 E5          0081*       push hl ; save dx
046F7A             0082*   ; compute dy
046F7A EB          0083*       ex de,hl
046F7B FD 17 04    0084*       ld de,(iy+sprite_y)
046F7E B7          0085*       or a ; clear carry
046F7F ED 52       0086*       sbc hl,de ; dy
046F81 EB          0087*       ex de,hl ; de = dy
046F82             0088*   ; compute angle to coordinate
046F82 C1          0089*       pop bc ; dx (was hl)
046F83 C5          0090*       push bc ; save dx
046F84 D5          0091*       push de ; save dy
046F85 CD F0 07 04 0092*       call atan2_168fast ; uh.l = angle to coordinate
046F89 3E E0       0093*       ld a,%11100000
046F8B A5          0094*       and l ; round angle to nearest 32th of a circle
046F8C 6F          0095*       ld l,a
046F8D 22 94 6F 04 0096*       ld (Bearing_t),hl ; return angle to coordinate
046F91 D1          0097*       pop de ; restore dy
046F92 C1          0098*       pop bc ; restore dx
046F93 C9          0099*       ret
046F94             0100*   ; end bearing_to_coord
046F94             0101*   
046F94             0102*   ; targeting_computer variables fixed 16.8 format
046F94 00 00 00    0103*   Bearing_t: dl 0x000000 ; angle to target
046F97 00 00 00    0104*   Heading_t: dl 0x000000 ; angle of target motion
046F9A 00 00 00    0105*   Vp: dl 0x000000 ; velocity of projectile
046F9D 00 00 00    0106*   Vp_x: dl 0x000000 ; x component of projectile velocity
046FA0 00 00 00    0107*   Vp_y: dl 0x000000 ; y component of projectile velocity
046FA3 00 00 00    0108*   Vt: dl 0x000000 ; velocity of target
046FA6 00 00 00    0109*   Vt_x: dl 0x000000 ; x component of target velocity
046FA9 00 00 00    0110*   Vt_y: dl 0x000000 ; y component of target velocity
046FAC 00 00 00    0111*   Heading_p: dl 0x000000 ; angle of projectile motion
046FAF 00 00 00    0112*   lead_angle: dl 0x000000 ; lead angle
046FB2             0113*   
046FB2             0114*   ; Inputs:   Vp velocity of projectile set,
046FB2             0115*   ;           iy pointed to sprite record,
046FB2             0116*   ;           player position and velocities correctly set
046FB2             0117*   ; Outputs:  uh.l is the 16.8 fixed firing angle256
046FB2             0118*   ;           ub.c and ud.e are the 16.8 fixed x,y component projectile velocities
046FB2             0119*   ; https://old.robowiki.net/cgi-bin/robowiki?LinearTargeting
046FB2             0120*   targeting_computer:
046FB2 DD 21 86 88 0121*       ld ix,player_begin
       04          
046FB7             0122*   ; ; compute target velocity from x,y component velocities
046FB7             0123*   ;     ld bc,(ix+sprite_xvel)
046FB7             0124*   ;     ld de,(ix+sprite_yvel)
046FB7             0125*   ;     ld hl,-1*256 ; account for vertical ground movement
046FB7             0126*   ;     add hl,de
046FB7             0127*   ;     ex de,hl ; ud.e = player_yvel-1
046FB7             0128*   ;     call cartesian_to_polar_sm ; uh.l = Heading_t, ud.e = Vt
046FB7             0129*   ;     ld (Heading_t),hl ; PASSES
046FB7             0130*   ;     ld (Vt),de ; PASSES
046FB7             0131*   ; ; Bearing_t should have been set by prerequisite call to orientation_to_player
046FB7             0132*   ; ; compute Heading_t-Bearing_t PASSES
046FB7             0133*   ;     ld de,(Bearing_t)
046FB7             0134*   ;     and a ; clear carry
046FB7             0135*   ;     sbc hl,de ; Uh.l = Heading_t-Bearing_t
046FB7             0136*   ; ; compute sin(Heading_t-Bearing_t)
046FB7             0137*   ;     call sin168 ; uh.l = sin(Heading_t-Bearing_t)
046FB7             0138*   ; ; compute (Vt*sin(Heading_t-Bearing_t))
046FB7             0139*   ;     ld de,(Vt)
046FB7             0140*   ;     call smul168 ; uh.l = (Vt*sin(Heading_t-Bearing_t))
046FB7             0141*   ; ; compute (Vt * sin(Heading_t-Bearing_t)) / Vp
046FB7             0142*   ;     ld de,(Vp)
046FB7             0143*   ;     call sdiv168 ; ud.e = (Vt*sin(Heading_t-Bearing_t)) / Vp
046FB7             0144*   ;     ex de,hl ; uh.l = (Vt*sin(Heading_t-Bearing_t)) / Vp
046FB7             0145*   ; ; answer is in radians, convert to degrees256
046FB7             0146*   ;     ld de,0x0028BE ; 40.74 = 57.29578*256/360
046FB7             0147*   ;     call smul168 ; uh.l = angle in degrees256
046FB7             0148*   ;     ld (lead_angle),hl ; TODO: fix this
046FB7             0149*   ; ; add lead angle to target bearing
046FB7             0150*   ;     ld de,(Bearing_t)
046FB7             0151*   ;     add hl,de ; h.l = lead angle+target bearing
046FB7             0152*   
046FB7 2A 94 6F 04 0153*       ld hl,(Bearing_t) ; TODO: fix this
046FBB             0154*   
046FBB E5          0155*       push hl
046FBC             0156*   
046FBC             0157*   ; compute component projectile velocities
046FBC ED 5B 9A 6F 0158*       ld de,(Vp) ; Vp should have been set by caller
       04          
046FC1 CD F6 06 04 0159*       call polar_to_cartesian ; ub.c = Vp_x, ud.e = Vp_y
046FC5 ED 43 9D 6F 0160*       ld (Vp_x),bc
       04          
046FCA             0161*       ; inc d ; account for vertical ground movement
046FCA ED 53 A0 6F 0162*       ld (Vp_y),de
       04          
046FCF E1          0163*       pop hl ; uh.l = lead angle+target bearing
046FD0 22 AC 6F 04 0164*       ld (Heading_p),hl
046FD4             0165*   
046FD4 C9          0166*       ret
