044175             1075*   ; AGNB 0.2 audio loader
044175             1076*   ; =====================
044175             1077*   ;
044175             1078*   ; The generic RIFF/AGNB file, chunk, bounds, streaming, buffer-clear, buffer-
044175             1079*   ; load, and buffer-consolidation routines remain in agnb_api.inc. This file adds
044175             1080*   ; the audio-specific record path for:
044175             1081*   ;
044175             1082*   ;     LIST BUFR
044175             1083*   ;       BHDR  u16 bufferId
044175             1084*   ;       AUDI  u8 vdpFormat=0x09; u16 sampleRate
044175             1085*   ;       DATA  unsigned 8-bit mono PCM bytes
044175             1086*   ;
044175             1087*   ; AUDI format 0x09 means VDP base format 1 (unsigned 8-bit mono) with bit 3
044175             1088*   ; set to record that an explicit u16 sample rate follows. vdu_buffer_to_sound
044175             1089*   ; accepts the base format and adds bit 3 itself, so finalization masks it off.
044175             1090*   
044175             1091*   agnb_audio_version_major:  equ 0
044175             1092*   agnb_audio_version_minor:  equ 2
044175             1093*   
044175             1094*   agnb_audi_format:          equ 0 ; u8 VDP sample format byte
044175             1095*   agnb_audi_sample_rate:     equ 1 ; u16 Hz
044175             1096*   agnb_audi_payload_size:    equ 3
044175             1097*   
044175             1098*   agnb_audio_vdp_format:     equ 0x09 ; unsigned 8-bit mono + sample rate follows
044175             1099*   
044175 41 55 44 49 1100*   agnb_id_audi:              db "AUDI"
