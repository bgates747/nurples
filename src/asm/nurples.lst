041500             0281*   ; 11    320   240   2     60hz
041500             0282*   ; 139   320   240   2     60hz
041500             0283*   ; 23    512   384   2     60hz
041500             0284*   ; 151   512   384   2     60hz
041500             0285*   ; 6     640   240   2     60hz
041500             0286*   ; 134   640   240   2     60hz
041500             0287*   ; 2     640   480   2     60hz
041500             0288*   ; 130   640   480   2     60hz
041500             0289*   ; 17    800   600   2     60hz
041500             0290*   ; 145   800   600   2     60hz
041500             0291*   ; 18    1024  768   2     60hz
041500             0292*   ; 146   1024  768   2     60hz
041500             0293*   ; ---   ----  ----  ----  -------
041500             0294*   ; 10    320   240   4     60hz
041500             0295*   ; 138   320   240   4     60hz
041500             0296*   ; 22    512   384   4     60hz
041500             0297*   ; 150   512   384   4     60hz
041500             0298*   ; 5     640   240   4     60hz
041500             0299*   ; 133   640   240   4     60hz
041500             0300*   ; 1     640   480   4     60hz
041500             0301*   ; 129   640   480   4     60hz
041500             0302*   ; 16    800   600   4     60hz
041500             0303*   ; 19    1024  768   4     60hz
041500             0304*   ; ---   ----  ----  ----  -------
041500             0305*   ; 9     320   240   16    60hz
041500             0306*   ; 137   320   240   16    60hz
041500             0307*   ; 21    512   384   16    60hz
041500             0308*   ; 149   512   384   16    60hz
041500             0309*   ; 4     640   240   16    60hz
041500             0310*   ; 132   640   240   16    60hz
041500             0311*   ; 0     640   480   16    60hz
041500             0312*   ; 7     n/a   n/a   16    60hz
041500             0313*   ; ---   ----  ----  ----  -------
041500             0314*   ; 8     320   240   64    60hz
041500             0315*   ; 136   320   240   64    60hz
041500             0316*   ; 20    512   384   64    60hz
041500             0317*   ; 3     640   240   64    60hz
