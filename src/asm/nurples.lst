048386             0006*       CALL_HL                ; Call the corresponding state handler
                       M1 Args: none
048386 01 8C 83 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
04838A C5          0002*M1     push bc ; which constitutes the return address
04838B E9          0003*M1     jp (hl) ; Jump to the address in HL
04838C C9          0007*       ret
