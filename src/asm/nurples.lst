047DAA CA B3 7D 04 0036*       jp z,@no_fuel
047DAE FA B3 7D 04 0037*       jp m,@no_fuel
047DB2 C9          0038*       ret ; fuel not zero so return
047DB3             0039*   @no_fuel:
047DB3 36 00       0040*       ld (hl),0 ; TODO: implement out-of-fuel handler
047DB5 C9          0041*       ret
047DB6             0042*   ; end discharge_fuel
047DB6             0043*   
047DB6             0044*   draw_fuel:
