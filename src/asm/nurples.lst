041122             0039        include "timer.inc"
041122             0001*   ; Table 32. Timer Control Registers
041122             0002*   TMR0_CTL: equ 80h
041122             0003*   TMR1_CTL: equ 83h
041122             0004*   TMR2_CTL: equ 86h
041122             0005*   TMR3_CTL: equ 89h
041122             0006*   TMR4_CTL: equ 8Ch
041122             0007*   TMR5_CTL: equ 8Fh
041122             0008*   
041122             0009*   ; each timer register takes three bytes:
041122             0010*   ;   0: control register
041122             0011*   ;   1: low byte of timer reset value
041122             0012*   ;   2: high byte of timer reset value
041122             0013*   ; note that the value is only 8-bits,so we use in0/out0 i/o calls,
041122             0014*   ; which correctly force the high and upper bytes of the address bus to zero
041122             0015*   
041122             0016*   TMR_REG_CTL: equ 0
041122             0017*   TMR_RES_LOW: equ 1
041122             0018*   TMR_RES_HIGH: equ 2
041122             0019*   
041122             0020*   ; Timer Control Register Bit Definitions
041122             0021*   PRT_IRQ_0:    equ %00000000 ; The timer does not reach its end-of-count value.
041122             0022*                               ; This bit is reset to 0 every time the TMRx_CTL register is read.
041122             0023*   PRT_IRQ_1:    equ %10000000 ; The timer reaches its end-of-count value. If IRQ_EN is set to 1,
041122             0024*                               ; an interrupt signal is sent to the CPU. This bit remains 1 until
041122             0025*                               ; the TMRx_CTL register is read.
041122             0026*   
041122             0027*   IRQ_EN_0:     equ %00000000 ; Timer interrupt requests are disabled.
041122             0028*   IRQ_EN_1:     equ %01000000 ; Timer interrupt requests are enabled.
041122             0029*   
041122             0030*   PRT_MODE_0:   equ %00000000 ; The timer operates in SINGLE PASS mode. PRT_EN (bit 0) is reset to
041122             0031*                               ;  0,and counting stops when the end-of-count value is reached.
041122             0032*   PRT_MODE_1:   equ %00010000 ; The timer operates in CONTINUOUS mode. The timer reload value is
041122             0033*                               ; written to the counter when the end-of-count value is reached.
041122             0034*   
041122             0035*   ; CLK_DIV is a 2-bit mask that sets the timer input source clock divider
041122             0036*   CLK_DIV_256:  equ %00001100 ;
041122             0037*   CLK_DIV_64:   equ %00001000 ;
041122             0038*   CLK_DIV_16:   equ %00000100 ;
041122             0039*   CLK_DIV_4:    equ %00000000 ;
041122             0040*   
041122             0041*   RST_EN_0:     equ %00000000 ; The reload and restart function is disabled.
041122             0042*   RST_EN_1:     equ %00000010 ; The reload and restart function is enabled.
041122             0043*                               ; When a 1 is written to this bit,the values in the reload registers
041122             0044*                               ;  are loaded into the downcounter when the timer restarts. The
041122             0045*                               ; programmer must ensure that this bit is set to 1 each time
041122             0046*                               ; SINGLE-PASS mode is used.
041122             0047*   
041122             0048*   ; disable/enable the programmable reload timer
041122             0049*   PRT_EN_0:     equ %00000000 ;
041122             0050*   PRT_EN_1:     equ %00000001 ;
041122             0051*   
041122             0052*   ; Table 37. Timer Input Source Select Register
041122             0053*   ; Each of the 4 timers are allocated two bits of the 8-bit register
041122             0054*   ; in little-endian order,with TMR0 using bits 0 and 1,TMR1 using bits 2 and 3,etc.
041122             0055*   ;   00: System clock / CLK_DIV
041122             0056*   ;   01: RTC / CLK_DIV
041122             0057*   ;   NOTE: these are the values given in the manual,but it may be a typo
041122             0058*   ;   10: GPIO port B pin 1.
041122             0059*   ;   11: GPIO port B pin 1.
041122             0060*   TMR_ISS:   equ 92h ; register address
041122             0061*   
041122             0062*   ; Table 51. Real-Time Clock Control Register
041122             0063*   RTC_CTRL: equ EDh ; register address
041122             0064*   
041122             0065*   ; alarm interrupt disable/enable
041122             0066*   RTC_ALARM_0:    equ %00000000
041122             0067*   RTC_ALARM_1:    equ %10000000
041122             0068*   
041122             0069*   ; interrupt on alarm disable/enable
041122             0070*   RTC_INT_ENT_0:  equ %00000000
041122             0071*   RTC_INT_ENT_1:  equ %01000000
041122             0072*   
041122             0073*   RTC_BCD_EN_0:   equ %00000000   ; RTC count and alarm registers are binary
041122             0074*   RTC_BCD_EN_1:   equ %00100000   ; RTC count and alarm registers are BCD
041122             0075*   
041122             0076*   RTC_CLK_SEL_0:  equ %00000000   ; RTC clock source is crystal oscillator output (32768 Hz).
041122             0077*                                   ; On-chip 32768 Hz oscillator is enabled.
041122             0078*   RTC_CLK_SEL_1:  equ %00010000   ; RTC clock source is power line frequency input as set by FREQ_SEL.
041122             0079*                                   ; On-chip 32768 Hz oscillator is disabled.
041122             0080*   
041122             0081*   RTC_FREQ_SEL_0: equ %00000000   ; 60 Hz power line frequency.
041122             0082*   RTC_FREQ_SEL_1: equ %00001000   ; 50 Hz power line frequency.
041122             0083*   
041122             0084*   RTC_SLP_WAKE_0: equ %00000000   ; RTC does not generate a sleep-mode recovery reset.
041122             0085*   RTC_SLP_WAKE_1: equ %00000010   ; RTC generates a sleep-mode recovery reset.
041122             0086*   
041122             0087*   RTC_UNLOCK_0:   equ %00000000   ; RTC count registers are locked to prevent Write access.
041122             0088*                                   ; RTC counter is enabled.
041122             0089*   RTC_UNLOCK_1:   equ %00000001   ; RTC count registers are unlocked to allow Write access.
041122             0090*                                   ; RTC counter is disabled.
041122             0091*   
041122             0092*   ; prt_reload_emulator: equ 11234 ; 1/102.4 seconds on emulator with 16 clock divider
041122             0093*   
041122             0094*   prt_reload_emulator: equ 11519 ; 1 centisecond on emulator with 16 clock divider
041122             0095*   prt_reload_hardware: equ 11532 ; 1 centisecond on hardware with 16 clock divider
041122 00 00 00    0096*   prt_reload: dl 0x000000
041125             0097*   
041125             0098*   ; returns: a = 0 if running on hardware,1 if running on emulator
041125             0099*   ;          de = number PRT interrupts during test interval
041125             0100*   prt_calibrate:
041125 CD 27 14 04 0101*       call vdu_vblank
041129             0102*   ; set a MOS timer
041129 21 78 00 00 0103*       ld hl,120*1 ; 1 second
04112D FD 21 AD 12 0104*       ld iy,tmr_test
       04          
041132 CD 8B 12 04 0105*       call tmr_set
041136             0106*   ; set a PRT timer
041136             0107*       ; ld hl,prt_reload_hardware
041136             0108*       ; ld hl,prt_reload_emulator
041136 21 05 2D 00 0109*       ld hl,prt_reload_emulator + prt_reload_hardware / 2
04113A 22 22 11 04 0110*       ld (prt_reload),hl
04113E CD C6 11 04 0111*       call prt_set
041142             0112*   @loop:
041142             0113*   ; check time remaining on MOS timer
041142 CD 99 12 04 0114*       call tmr_get
041146 CA 50 11 04 0115*       jp z,@done ; time expired,so quit
04114A FA 50 11 04 0116*       jp m,@done ; time past expiration (negative),so quit
04114E 18 F2       0117*       jr @loop
041150             0118*   @done:
041150 ED 5B 14 12 0119*       ld de,(prt_irq_counter)
       04          
041155 01 0C 2D 00 0120*       ld bc,prt_reload_hardware ; default value for running on hardware
041159 ED 43 22 11 0121*       ld (prt_reload),bc
       04          
04115E 21 64 00 00 0122*       ld hl,100 ; halfway between 101 for real hardware and 99 for emulator
041162 AF          0123*       xor a ; clear carry,zero is default value for running on hardware
041163 32 85 11 04 0124*       ld (is_emulator),a
041167 ED 52       0125*       sbc hl,de
041169 21 86 11 04 0126*       ld hl,on_hardware ; default message for running on hardware
04116D CA 25 11 04 0127*       jp z,prt_calibrate ; zero result is indeterminate so we try again
041171 F8          0128*       ret m ; negative result means we're on hardware
041172 3C          0129*       inc a ; we're on emulator
041173 32 85 11 04 0130*       ld (is_emulator),a
041177 01 FF 2C 00 0131*       ld bc,prt_reload_emulator
04117B ED 43 22 11 0132*       ld (prt_reload),bc
       04          
041180 21 9C 11 04 0133*       ld hl,on_emulator
041184 C9          0134*       ret
041185 00          0135*   is_emulator: db 0
041186 52 75 6E 6E 0136*   on_hardware: defb "Running on hardware\r\n",0
       69 6E 67 20 
       6F 6E 20 68 
       61 72 64 77 
       61 72 65 0D 
       0A 00       
04119C 52 75 6E 6E 0137*   on_emulator: defb "Running on emulator\r\n",0
       69 6E 67 20 
       6F 6E 20 65 
       6D 75 6C 61 
       74 6F 72 0D 
