048026             0001*   ; Game state variables
048026 E7 80 04    0002*   game_state:  dl game_main_menu
048029             0003*   game_fault_bad_state: equ 0
048029 00          0004*   game_fault_flags: db 0 ; latched fail-closed diagnostics
04802A 00          0005*   game_exit_requested: db 0 ; main-loop handoff; state handlers must return normally
04802B             0006*   
04802B             0007*   do_game:
04802B 2A 26 80 04 0008*       ld hl,(game_state)   ; Load the current game state
04802F CD 4D 80 04 0009*       call game_state_pointer_valid
048033 DA 46 80 04 0010*       jp c,@dispatch
048037 21 29 80 04 0011*       ld hl,game_fault_flags
04803B CB C6       0012*       set game_fault_bad_state,(hl)
04803D 21 A0 81 04 0013*       ld hl,game_init ; publish recovery; do not run it in the corrupt frame
048041 22 26 80 04 0014*       ld (game_state),hl
048045 C9          0015*       ret
048046             0016*   @dispatch:
048046             0017*       CALL_HL                ; Call the corresponding state handler
                       M1 Args: none
048046 01 4C 80 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
04804A C5          0002*M1     push bc ; which constitutes the return address
04804B E9          0003*M1     jp (hl) ; Jump to the address in HL
04804C C9          0018*       ret
04804D             0019*   
04804D             0020*   ; Exact stabilization whitelist for writable legacy global-state pointers.
04804D             0021*   ; inputs/outputs: hl = candidate handler; carry set only for an exact match
04804D             0022*   ; destroys: a,de
04804D             0023*   game_state_pointer_valid:
04804D 11 E7 80 04 0024*       ld de,game_main_menu
048051 CD E1 80 04 0025*       call @matches
048055 CA DF 80 04 0026*       jp z,@valid
048059 11 E8 80 04 0027*       ld de,game_paused
04805D CD E1 80 04 0028*       call @matches
048061 CA DF 80 04 0029*       jp z,@valid
048065 11 E9 80 04 0030*       ld de,game_level_transition
048069 CD E1 80 04 0031*       call @matches
04806D CA DF 80 04 0032*       jp z,@valid
048071 11 F6 80 04 0033*       ld de,game_over
048075 CD E1 80 04 0034*       call @matches
048079 CA DF 80 04 0035*       jp z,@valid
04807D 11 59 81 04 0036*       ld de,game_victory
048081 CD E1 80 04 0037*       call @matches
048085 CA DF 80 04 0038*       jp z,@valid
048089 11 5A 81 04 0039*       ld de,game_loading
04808D CD E1 80 04 0040*       call @matches
048091 CA DF 80 04 0041*       jp z,@valid
048095 11 67 81 04 0042*       ld de,game_cutscene
048099 CD E1 80 04 0043*       call @matches
04809D CA DF 80 04 0044*       jp z,@valid
0480A1 11 68 81 04 0045*       ld de,game_inventory
0480A5 CD E1 80 04 0046*       call @matches
0480A9 CA DF 80 04 0047*       jp z,@valid
0480AD 11 69 81 04 0048*       ld de,game_map
0480B1 CD E1 80 04 0049*       call @matches
0480B5 CA DF 80 04 0050*       jp z,@valid
0480B9 11 6A 81 04 0051*       ld de,game_exit
0480BD CD E1 80 04 0052*       call @matches
0480C1 CA DF 80 04 0053*       jp z,@valid
0480C5 11 A0 81 04 0054*       ld de,game_init
0480C9 CD E1 80 04 0055*       call @matches
0480CD CA DF 80 04 0056*       jp z,@valid
0480D1 11 67 84 04 0057*       ld de,game_playing
0480D5 CD E1 80 04 0058*       call @matches
0480D9 CA DF 80 04 0059*       jp z,@valid
0480DD AF          0060*       xor a
0480DE C9          0061*       ret
0480DF             0062*   @valid:
