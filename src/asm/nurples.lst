04130E             0358*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04130E 3E 08       0001*M1 			LD	A, function
041310 5B CF       0002*M1 			RST.LIL	08h
041312 DD 27 00    0359*       ld hl,(ix+sysvar_time)  ; get current time
041315 22 2A 13 04 0360*       ld (stopwatch_started),hl            ; set start time
041319 C9          0361*       ret
04131A             0362*   
04131A             0363*   ; gets time elapsed on a stopwatch
04131A             0364*   ; returns: hl = time elapsed in 1/120ths of a second
04131A             0365*   ; destroys: af,hl,de,ix
04131A             0366*   stopwatch_get:
04131A             0367*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04131A 3E 08       0001*M1 			LD	A, function
04131C 5B CF       0002*M1 			RST.LIL	08h
04131E DD 27 00    0368*       ld hl,(ix+sysvar_time)  ; get current time
041321 ED 5B 2A 13 0369*       ld de,(stopwatch_started)            ; get start time
       04          
041326 AF          0370*       xor a                   ; clear carry
041327 ED 52       0371*       sbc hl,de               ; hl = time elapsed (will always be zero or positive)
041329 C9          0372*       ret
04132A             0373*   
