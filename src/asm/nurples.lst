0420C7             0067*   ; reset the animation timer and bump animation
0420C7 3E 08       0068*       ld a,8
0420C9 FD 77 23    0069*       ld (iy+sprite_animation_timer),a
0420CC FD 7E 22    0070*       ld a,(iy+sprite_animation)
0420CF 3C          0071*       inc a
0420D0 E6 01       0072*       and %00000001 ; modulo 2
0420D2 FD 77 22    0073*       ld (iy+sprite_animation),a
0420D5 CD 3E 83 04 0074*       call sprite_frame_heading_animation ; a, sprite_frame set to heading-based frame
0420D9 CD 40 19 04 0075*       call vdu_sprite_select_frame
