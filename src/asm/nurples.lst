043BF2             0209*   agnb_io_buffer_size:       equ 8192
043BF2             0210*   
043BF2             0211*   ; Application callback invoked after each image has been finalized.
043BF2 00 00 00    0212*   agnb_image_callback:       dl 0
043BF5             0213*   
043BF5             0214*   ; Reader subroutine interface
043BF5             0215*   ; ---------------------------
043BF5             0216*   ; These labels establish the intended decomposition and calling contracts.
043BF5             0217*   ; They deliberately fail with agnb_error_not_implemented until replaced with
043BF5             0218*   ; real code, preventing an incomplete loader from reporting false success.
043BF5             0219*   
043BF5             0220*   ; Compare two FourCC values.
043BF5             0221*   ; inputs:  HL = pointer to first FourCC, DE = pointer to second FourCC
043BF5             0222*   ; outputs: Z set when all four bytes match, Z reset when any byte differs
043BF5             0223*   ; preserves: BC, DE, HL
043BF5             0224*   ; destroys: A
043BF5             0225*   agnb_compare_fourcc:
043BF5 C5          0226*       push bc
043BF6 D5          0227*       push de
043BF7 E5          0228*       push hl
043BF8 06 04       0229*       ld b,4
043BFA             0230*   @loop:
043BFA 1A          0231*       ld a,(de)
043BFB BE          0232*       cp (hl)
043BFC 20 04       0233*       jr nz,@done ; exit with Z reset if any byte differs, indicating a mismatch
043BFE 13          0234*       inc de
043BFF 23          0235*       inc hl
043C00 10 F8       0236*       djnz @loop ; if we fall throgh at the end of the loop Z is set, indicating a match
043C02             0237*   @done:
043C02 E1          0238*       pop hl
043C03 D1          0239*       pop de
043C04 C1          0240*       pop bc
043C05 C9          0241*       ret
043C06             0242*   
043C06             0243*   ; Open a container for reading.
043C06             0244*   ; inputs:  DE = zero-terminated filename (normally agnb_filename)
043C06             0245*   ; outputs: A=0 and Z set on success; A=agnb_error_open and NZ set on failure
043C06             0246*   ;          agnb_fil initialized and agnb_file_is_open set on success
043C06             0247*   ; destroys: AF, BC, HL
043C06             0248*   agnb_open:
043C06             0249*   ; begin fail-closed: do not leave stale success state if ffs_fopen fails
043C06 AF          0250*       xor a
043C07 32 E5 1B 04 0251*       ld (agnb_file_is_open),a
043C0B 32 E4 1B 04 0252*       ld (agnb_last_error),a
043C0F             0253*   
043C0F             0254*   ; Each newly opened container starts at physical and logical offset zero.
043C0F             0255*   ; The original single-container caller received this state from BSS
043C0F             0256*   ; initialization; consecutive container loads must establish it explicitly.
043C0F 21 00 00 00 0257*       ld hl,0
043C13 22 C5 1B 04 0258*       ld (agnb_state+agnb_state_file_offset),hl
043C17 22 C9 1B 04 0259*       ld (agnb_state+agnb_state_bytes_read),hl
043C1B 32 C8 1B 04 0260*       ld (agnb_state+agnb_state_file_offset+3),a
043C1F 32 CC 1B 04 0261*       ld (agnb_state+agnb_state_bytes_read+3),a
043C23             0262*   
043C23             0263*   ; open the caller-supplied filename into our single reader-owned FIL
043C23 21 8D 1B 04 0264*       ld hl,agnb_fil
043C27 0E 01       0265*       ld c,fa_read
043C29             0266*       FFSCALL ffs_fopen
                       M1 Args: function=ffs_fopen 
043C29 FD E5       0001*M1     push iy
043C2B 3E 80       0002*M1     ld a,function
043C2D 5B CF       0003*M1     rst.lil $08
043C2F FD E1       0004*M1     pop iy
043C31 B7          0267*       or a
043C32 20 08       0268*       jr nz,@error
043C34             0269*   
043C34             0270*   ; ffs_fopen succeeded
043C34 3E 01       0271*       ld a,1
043C36 32 E5 1B 04 0272*       ld (agnb_file_is_open),a
043C3A AF          0273*       xor a
043C3B C9          0274*       ret
043C3C             0275*   
043C3C             0276*   @error:
043C3C 3E 01       0277*       ld a,agnb_error_open
043C3E 32 E4 1B 04 0278*       ld (agnb_last_error),a
043C42 B7          0279*       or a
043C43 C9          0280*       ret
043C44             0281*   
043C44             0282*   ; Close agnb_fil if open and clear agnb_file_is_open.
043C44             0283*   ; outputs: A=0 and Z set if closed or already closed
043C44             0284*   ;          nonzero FatFS result and NZ set if ffs_fclose fails
043C44             0285*   ; destroys: HL
043C44             0286*   agnb_close:
043C44             0287*   ; An unopened file is already in the requested state.
043C44 3A E5 1B 04 0288*       ld a,(agnb_file_is_open)
043C48 B7          0289*       or a
043C49 28 14       0290*       jr z,@success
043C4B             0291*   
043C4B             0292*   ; Close our single reader-owned FIL.
043C4B 21 8D 1B 04 0293*       ld hl,agnb_fil
043C4F             0294*       FFSCALL ffs_fclose
                       M1 Args: function=ffs_fclose 
043C4F FD E5       0001*M1     push iy
043C51 3E 81       0002*M1     ld a,function
043C53 5B CF       0003*M1     rst.lil $08
043C55 FD E1       0004*M1     pop iy
043C57 B7          0295*       or a
043C58 20 0B       0296*       jr nz,agnb_error_close
043C5A             0297*   
043C5A             0298*   ; Only clear the open flag after FatFS confirms the close.
043C5A AF          0299*       xor a
043C5B 32 E5 1B 04 0300*       ld (agnb_file_is_open),a
043C5F             0301*   @success:
043C5F AF          0302*       xor a
043C60 32 E4 1B 04 0303*       ld (agnb_last_error),a
043C64 C9          0304*       ret
043C65             0305*   
043C65             0306*   agnb_error_close:
043C65             0307*   ; Placeholder in case we determine that close failures need a dedicated AGNB
043C65             0308*   ; error code or recovery path. For now retain and return the nonzero FRESULT,
043C65             0309*   ; and leave agnb_file_is_open set because FatFS did not confirm the close.
043C65 32 E4 1B 04 0310*       ld (agnb_last_error),a
043C69 B7          0311*       or a
043C6A C9          0312*       ret
043C6B             0313*   
043C6B             0314*   ; Top-level image load operation.
043C6B             0315*   ; inputs:  DE = zero-terminated container filename
043C6B             0316*   ; outputs: A=0 and Z set after all valid LIST BUFR image records are uploaded
043C6B             0317*   ;          and finalized at their explicit IDs; nonzero error and NZ otherwise
043C6B             0318*   ; destroys: AF, BC, DE, HL, IX
043C6B             0319*   agnb_load_images:
043C6B 21 DA 3C 04 0320*       ld hl,agnb_image_callback_noop
043C6F             0321*   
043C6F             0322*   ; Callback-enabled image loader.
043C6F             0323*   ; inputs: DE = filename; HL = callback whose result is ignored
043C6F             0324*   agnb_load_images_with_callback:
043C6F 22 F2 3B 04 0325*       ld (agnb_image_callback),hl
043C73 CD 06 3C 04 0326*       call agnb_open
043C77 C0          0327*       ret nz
043C78             0328*   
043C78 CD 51 3D 04 0329*       call agnb_read_riff_header
043C7C 20 47       0330*       jr nz,@load_error
043C7E CD 25 3E 04 0331*       call agnb_read_vers
043C82 20 41       0332*       jr nz,@load_error
043C84             0333*   
043C84             0334*   @next_record:
043C84             0335*   ; End only at the exact declared RIFF boundary. A position beyond it is an
043C84             0336*   ; internal bounds failure; a position before it must begin another LIST BUFR.
043C84 3A C8 1B 04 0337*       ld a,(agnb_state+agnb_state_file_offset+3)
043C88 21 B8 1B 04 0338*       ld hl,agnb_state+agnb_state_riff_end+3
043C8C BE          0339*       cp (hl)
043C8D 38 12       0340*       jr c,@read_record
043C8F 20 2E       0341*       jr nz,@bad_bounds
043C91 2A C5 1B 04 0342*       ld hl,(agnb_state+agnb_state_file_offset)
043C95 ED 5B B5 1B 0343*       ld de,(agnb_state+agnb_state_riff_end)
       04          
043C9A B7          0344*       or a
043C9B ED 52       0345*       sbc hl,de
043C9D 28 32       0346*       jr z,@success
043C9F 30 1E       0347*       jr nc,@bad_bounds
043CA1             0348*   
043CA1             0349*   @read_record:
043CA1 CD 90 3E 04 0350*       call agnb_read_buffer_list
043CA5 20 1E       0351*       jr nz,@load_error
