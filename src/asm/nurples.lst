0412B3             0292*   
       FF FF FF FF 
       FF FF 
0412B3 00 00 00    0293*   timestamp_now: dl 0
0412B6 00 00 00    0294*   timestamp_old: dl 0
0412B9 00 00 00    0295*   timestamp_chg: dl 0
0412BC             0296*   
0412BC             0297*   ; Establish a restart-safe baseline before the first timestamp_tick. Without
0412BC             0298*   ; this, a second MOS RUN computes its first delta from the prior invocation.
0412BC             0299*   timestamp_init:
0412BC             0300*       MOSCALL mos_sysvars
                       M1 Args: function=mos_sysvars 
0412BC 3E 08       0001*M1 			LD	A, function
0412BE 5B CF       0002*M1 			RST.LIL	08h
0412C0 DD 27 00    0301*       ld hl,(ix+sysvar_time)
0412C3 22 B3 12 04 0302*       ld (timestamp_now),hl
0412C7 22 B6 12 04 0303*       ld (timestamp_old),hl
0412CB 21 00 00 00 0304*       ld hl,0
0412CF 22 B9 12 04 0305*       ld (timestamp_chg),hl
0412D3 C9          0306*       ret
0412D4             0307*   ; end timestamp_init
0412D4             0308*   
0412D4             0309*   ; update the global timestamp from the system clock
0412D4             0310*   ; inputs: none
0412D4             0311*   ; returns: hl = time elapsed in 1/120ths of a second
0412D4             0312*   ;          de = current time
0412D4             0313*   ;          ix = pointer to syvars table
0412D4             0314*   ; destroys: af,hl,de,ix
0412D4             0315*   timestamp_tick:
0412D4 ED 5B B3 12 0316*       ld de,(timestamp_now)   ; get previous time
       04          
0412D9 ED 53 B6 12 0317*       ld (timestamp_old),de   ; save previous time
       04          
0412DE             0318*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0412DE 3E 08       0001*M1 			LD	A, function
0412E0 5B CF       0002*M1 			RST.LIL	08h
0412E2 DD 27 00    0319*       ld hl,(ix+sysvar_time)  ; get current time
0412E5 22 B3 12 04 0320*       ld (timestamp_now),hl   ; save current time
0412E9 AF          0321*       xor a                   ; clear carry
0412EA ED 52       0322*       sbc hl,de               ; hl = time elapsed
0412EC 22 B9 12 04 0323*       ld (timestamp_chg),hl   ; save elapsed time
0412F0 C9          0324*       ret
0412F1             0325*   
0412F1             0326*   ; set a countdown timer
0412F1             0327*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412F1             0328*   ; requires: timestamp_tick to be called at least once before this function
0412F1             0329*   ; returns: hl = current time
0412F1             0330*   ; destroys: hl
0412F1             0331*   timestamp_tmr_set:
0412F1 FD 2F 03    0332*       ld (iy+3),hl            ; set time remaining
0412F4 2A B3 12 04 0333*       ld hl,(timestamp_now)   ; get current timestamp
0412F8 FD 2F 00    0334*       ld (iy+0),hl            ; set start time
0412FB C9          0335*       ret
0412FC             0336*   
0412FC             0337*   ; gets time remaining on a countdown timer following the global timestamp
0412FC             0338*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412FC             0339*   ; requires: timestamp_tick to be called at least once before this function
0412FC             0340*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
0412FC             0341*   ;          sign flags: pos = time not expired,zero or neg = time expired
0412FC             0342*   ; destroys: af,hl,de
0412FC             0343*   timestamp_tmr_get:
0412FC ED 5B B3 12 0344*       ld de,(timestamp_now)   ; get current timestamp
       04          
041301 FD 27 00    0345*       ld hl,(iy+0)            ; get start time
041304 AF          0346*       xor a                   ; clear carry
041305 ED 52       0347*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
041307 FD 17 03    0348*       ld de,(iy+3)            ; get timer set value
04130A AF          0349*       xor a                   ; clear carry
04130B ED 5A       0350*       adc hl,de               ; hl = time remaining
04130D             0351*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
04130D C9          0352*       ret
04130E             0353*   
04130E             0354*   ; set a stopwatch
04130E             0355*   ; returns: hl = start time
04130E             0356*   ; destroys: hl,ix
