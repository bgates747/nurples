041467             0259*   vdu_set_screen_mode:
041467 32 77 14 04 0260*   	ld (@arg),a
04146B 21 76 14 04 0261*   	ld hl,@cmd
04146F 01 02 00 00 0262*   	ld bc,@end-@cmd
041473 5B DF       0263*   	rst.lil $18
041475 C9          0264*   	ret
041476 16          0265*   @cmd: db 22 ; set screen mode
041477 00          0266*   @arg: db 0  ; screen mode parameter
041478             0267*   @end:
041478             0268*   
041478             0269*   ; get the current screen mode
041478             0270*   ; inputs: none
041478             0271*   ; outputs: a=screen mode
041478             0272*   ; destroys: af, ix
041478             0273*   vdu_get_screen_mode:
