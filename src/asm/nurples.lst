048D22             0039*   tile_activation_routines_count: equ [tile_activation_routines_end-tile_activation_routines]/3
048D22             0040*   ; end tile_activation_routines
048D22             0041*   
048D22             0042*   activate_null_tile:
048D22 C9          0043*       ret ; dummy routine, do nothing
048D23             0044*   move_active_tile:
048D23             0045*   ; y-axis movement
048D23 FD 27 04    0046*       ld hl,(iy+tile_y)
048D26 FD 17 0A    0047*       ld de,(iy+tile_yvel)
048D29 19          0048*       add hl,de
048D2A FD 2F 04    0049*       ld (iy+tile_y),hl
048D2D             0050*   ; detect screen edge collisions
048D2D             0051*   ; y-axis bottom is all we need to test
048D2D 11 00 80 FE 0052*       ld de,-tile_bottom*256
048D31 ED 5A       0053*       adc hl,de
048D33 F8          0054*       ret m ; still on screen so do nothing further
048D34 AF          0055*       xor a ; signal caller that tile has scrolled off screen
048D35 C9          0056*       ret
048D36             0057*   ; end move_active_tile
048D36             0058*   
048D36             0059*   move_tiles:
048D36             0060*   ; initialize pointers and loop counter
048D36 FD 21 2D 87 0061*       ld iy,tile_stack ; set iy to first record in table
       04          
048D3B             0062*   @move_loop:
048D3B FD 22 30 8A 0063*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
048D40 FD 7E 02    0064*       ld a,(iy+2)
048D43 B7          0065*       or a ; will be zero if at end of stack
048D44 C8          0066*       ret z ; end of stack so we're done
048D45             0067*   ; point iy to tile record
048D45 FD 37 00    0068*       ld iy,(iy) ; iy points to the current tile record
048D48 FD 22 33 8A 0069*       ld (tile_table_pointer),iy ; update table pointer
       04          
048D4D             0070*   ; check top bit of tile_type to see if tile is just spawned
048D4D FD CB 16 7E 0071*       bit 7,(iy+tile_type)
048D51 C2 6F 8D 04 0072*       jp nz,@just_spawned ; if just spawned, skip to next record
048D55             0073*   ; check sprite_alive bit to see if tile is active
048D55 FD CB 1D 76 0074*       bit sprite_alive,(iy+sprite_collisions)
048D59 C8          0075*       ret z ; end of stack so we're done
048D5A             0076*   ; otherwise we prepare to move the tile
048D5A FD 27 1A    0077*       ld hl,(iy+tile_move_program) ; load the behavior subroutine address
048D5D             0078*       CALL_HL
                       M1 Args: none
048D5D 01 63 8D 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
048D61 C5          0002*M1     push bc ; which constitutes the return address
048D62 E9          0003*M1     jp (hl) ; Jump to the address in HL
048D63             0079*    ; get back stack pointer and loop
048D63             0080*   @next_record:
048D63 FD 2A 30 8A 0081*       ld iy,(tile_stack_pointer)
       04          
048D68 ED 33 03    0082*       lea iy,iy+3 ; next tile stack record
048D6B C3 3B 8D 04 0083*       jp @move_loop ; loop until we've checked all the records
048D6F             0084*   @just_spawned:
048D6F FD CB 16 BE 0085*       res 7,(iy+tile_type) ; clear just spawned flag
048D73 C3 63 8D 04 0086*       jp @next_record
048D77             0087*   ; end move_tiles
048D77             0088*   
048D77             0089*   draw_active_tile:
048D77 FD 27 17    0090*       ld hl,(iy+tile_base_bufferId)
048D7A FD 7E 28    0091*       ld a,(iy+tile_frame)
048D7D 85          0092*       add a,l ; TODO: with a little work we could make all tile base buffer ids align to 256
048D7E 6F          0093*       ld l,a
048D7F 3E 00       0094*       ld a,0 ; preserve carry
048D81 8C          0095*       adc a,h
048D82 67          0096*       ld h,a
048D83 CD 3C 14 04 0097*       call vdu_buff_select ; buffer id of animation frame
048D87 FD 07 01    0098*       ld bc,(iy+tile_x)
048D8A FD 17 04    0099*       ld de,(iy+tile_y)
048D8D CD 58 18 04 0100*       call vdu_plot_bmp168
048D91 C9          0101*       ret
048D92             0102*   ; end draw_active_tile
048D92             0103*   
048D92             0104*   ; create a new sprite at the same location as the current tile
048D92             0105*   ; inputs: hl = pointer to new sprite default settings, tile_table_pointer = current tile
048D92             0106*   ;         ix = pointer to sprite group, b = number of records in sprite group
048D92             0107*   spawn_sprite_from_tile:
048D92 E5          0108*       push hl ; back up pointer to new sprite defaults
048D93 CD 6D 81 04 0109*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
048D97 E1          0110*       pop hl ; restore pointer to new sprite defaults
048D98 D0          0111*       ret nc ; no carry means no free sprite slots, so we go home
048D99             0112*   ; copy default settings to new sprite
048D99 DD E5       0113*       push ix ; back up pointer to new sprite record
048D9B ED 32 16    0114*       lea ix,ix+sprite_definitions ; bump pointer to copy to
048D9E DD E5       0115*       push ix ; pointer to default sprite settings
048DA0 D1          0116*       pop de ; address to copy to
048DA1 01 2A 00 00 0117*       ld bc,table_record_size-sprite_definitions ; number of bytes to copy
048DA5 ED B0       0118*       ldir ; copies defaults to new sprite record
048DA7 DD E1       0119*       pop ix ; restore pointer to new sprite record
048DA9             0120*   ; copy sprite position from existing tile
048DA9 FD 2A 33 8A 0121*       ld iy,(tile_table_pointer) ; get existing tile record
       04          
048DAE FD 27 01    0122*       ld hl,(iy+tile_x)
048DB1 DD 2F 01    0123*       ld (ix+sprite_x),hl
048DB4 FD 27 04    0124*       ld hl,(iy+tile_y)
048DB7 DD 2F 04    0125*       ld (ix+sprite_y),hl
048DBA             0126*   ; return to caller
048DBA DD CB 16 FE 0127*       set 7,(ix+sprite_type) ; set just spawned flag
048DBE DD CB 1D F6 0128*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
048DC2 37          0129*       scf ; set carry flag to indicate success
048DC3 C9          0130*       ret
048DC4             0131*   ; end spawn_sprite_from_tile
048DC4             0132*   
048DC4             0133*   ; create a new tile at the same location as the current tile
048DC4             0134*   ; inputs: tile_table_pointer = current tile
048DC4             0135*   spawn_active_tile_from_tile:
048DC4             0136*   ; copy default settings to new tile
048DC4 DD 2A 33 8A 0137*       ld ix,(tile_table_pointer) ; get existing tile record
       04          
048DC9 ED 32 16    0138*       lea ix,ix+tile_definitions ; bump pointer to copy to
048DCC DD E5       0139*       push ix ; pointer to default tile settings
048DCE D1          0140*       pop de ; address to copy to
048DCF 01 2A 00 00 0141*       ld bc,tile_table_record_size-tile_definitions ; number of bytes to copy
048DD3 ED B0       0142*       ldir ; copies defaults to new tile record
048DD5 DD 2A 33 8A 0143*       ld ix,(tile_table_pointer) ; restore pointer to new tile record
       04          
048DDA C9          0144*       ret
048DDB             0145*   ; end spawn_active_tile_from_tile
