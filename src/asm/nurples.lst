       04          
04146C ED 53 7F 14 0184*       ld (@y0),de
       04          
041471 21 7C 14 04 0185*       ld hl,@cmd
041475 01 05 00 00 0186*       ld bc,@end-@cmd
041479 5B DF       0187*       rst.lil $18
04147B C9          0188*       ret
04147C 1D          0189*   @cmd:   db 29 ; set graphics origin command
04147D 00 00       0190*   @x0: 	dw 0x0000 ; set by bc
04147F 00 00       0191*   @y0: 	dw 0x0000 ; set by de
041481 00          0192*   @end:   db 0x00	  ; padding
041482             0193*   
