047928             0059        include "player_state.inc"
047928             0001*   player_defaults:
047928 05          0002*       db player               ; type
047929 73 01 00    0003*       dl BUF_SHIP_0L          ; base_bufferId
04792C 90 79 04    0004*       dl do_player            ; move_program
04792F 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
047930 10          0006*       db 16                   ; dim_x
047931 10          0007*       db 16                   ; dim_y
047932 01          0008*       db 1                    ; num_orientations
047933 01          0009*       db 1                    ; num_animations
047934 00          0010*       db 0                    ; animation
047935 00          0011*       db 0                    ; animation_timer
047936 00          0012*       db 0                    ; move_timer
047937 00          0013*       db 0                    ; move_step
047938 00          0014*       db 0                    ; points
047939 00          0015*       db 0                    ; shield_damage
04793A 00          0016*       db 0                    ; frame
04793B             0017*   
04793B 1F 7A 04    0018*   player_state:  dl player_alive
04793E 00          0019*   player_ships: db 0
04793F 03          0020*   player_ships_max: db 3
047940             0021*   player_speed: equ 3*256 ; pixels per frame 16.8 fixed
047940             0022*   
047940             0023*   draw_player_ships:
047940             0024*   ; activate mfd
047940 DD 21 78 7B 0025*       ld ix,mfd_ships
       04          
047945 CD 7F 7C 04 0026*       call mfd_activate
047949             0027*   ; blank out previously drawn ships
047949 AF          0028*       xor a ; color mode 0
04794A 0E 00       0029*       ld c,c_black
04794C CD 83 13 04 0030*       call vdu_gcol
047950 01 00 00 00 0031*       ld bc,0
047954 11 00 00 00 0032*       ld de,0
047958 DD 21 4F 00 0033*       ld ix,0+79
       00          
04795D FD 21 0F 00 0034*       ld iy,0+15
       00          
047962 CD 73 18 04 0035*       call vdu_plot_rf
047966             0036*   ; draw the ships remaining
047966 21 2B 00 00 0037*       ld hl,BUF_SHIP_MFD
04796A CD 36 14 04 0038*       call vdu_buff_select
04796E 3A 3E 79 04 0039*       ld a,(player_ships) ; loop counter
047972 01 00 00 00 0040*       ld bc,0 ; starting x-coordinate
047976             0041*   @loop:
047976 3D          0042*       dec a ; we don't count the ship we're flying
047977 C8          0043*       ret z
047978 F5          0044*       push af ; back up loop counter
047979 C5          0045*       push bc ; save x-coordinate
04797A 11 00 00 00 0046*       ld de,0 ; y-coordinate
04797E CD 36 18 04 0047*       call vdu_plot_bmp
047982 C1          0048*       pop bc ; restore x-coordinate
047983 21 10 00 00 0049*       ld hl,16 ; bump x-coords
047987 09          0050*       add hl,bc
047988 E5          0051*       push hl
047989 C1          0052*       pop bc ; bc = new x-coordinate
04798A F1          0053*       pop af
04798B C3 76 79 04 0054*       jp @loop
04798F C9          0055*       ret
047990             0056*   ; end draw_player_ships
047990             0057*   
047990             0058*   do_player:
047990 2A 3B 79 04 0059*       ld hl,(player_state)
047994             0060*       CALL_HL
                       M1 Args: none
047994 01 9A 79 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
047998 C5          0002*M1     push bc ; which constitutes the return address
047999 E9          0003*M1     jp (hl) ; Jump to the address in HL
04799A C9          0061*       ret
04799B             0062*   ; end do_player
04799B             0063*   
04799B             0064*   ; set initial player position
04799B             0065*   ; inputs: none,everything is hardcoded
04799B             0066*   ; outputs: player_x/y set to bottom-left corner of screen
04799B             0067*   ; destroys: pretty much everything
04799B             0068*   player_init:
04799B 3A 21 80 04 0069*       ld a,(player_shields_max)
04799F 32 20 80 04 0070*       ld (player_shields),a
0479A3 3A B9 7E 04 0071*       ld a,(laser_power_max)
0479A7 32 B7 7E 04 0072*       ld (laser_power),a
0479AB 3A 97 7D 04 0073*       ld a,(player_fuel_max)
0479AF 32 95 7D 04 0074*       ld (player_fuel),a
