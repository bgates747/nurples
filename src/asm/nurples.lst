04233B             0024*   spawn_explosion:
04233B 21 28 23 04 0025*       ld hl,explosion_defaults
04233F DD 21 23 A4 0026*       ld ix,explosions_base
       04          
042344 06 08       0027*       ld b,explosions_max
042346 CD 3F 83 04 0028*       call spawn_sprite_from_sprite
04234A D2 65 82 04 0029*       jp nc,table_deactivate_sprite ; no carry means no free sprite slots, so we deactivate parent sprite and go home
04234E             0030*   ; other specific initialization
04234E 21 00 00 00 0031*       ld hl,0
042352 DD 2F 07    0032*       ld (ix+sprite_xvel),hl
042355 21 00 01 00 0033*       ld hl,1*256
042359 DD 2F 0A    0034*       ld (ix+sprite_yvel),hl
04235C             0035*   ; deactivate parent sprite
04235C C3 65 82 04 0036*       jp table_deactivate_sprite
042360             0037*   ; end spawn_explosion
042360             0038*   
042360             0039*   spawn_explosion_player:
042360 FD 21 23 A2 0040*       ld iy,player_begin
       04          
042365 FD 22 E1 81 0041*       ld (table_pointer),iy
       04          
04236A 21 28 23 04 0042*       ld hl,explosion_defaults
04236E DD 21 23 A4 0043*       ld ix,explosions_base
       04          
042373 06 08       0044*       ld b,explosions_max
042375 CD 3F 83 04 0045*       call spawn_sprite_from_sprite
042379 D8          0046*       ret c ; carry is the only indication that IX names a valid explosion
04237A             0047*   ; no slot: keep the player hidden and return failure without exposing invalid IX
04237A CD 65 82 04 0048*       call table_deactivate_sprite
04237E AF          0049*       xor a ; clear carry after the VDU calls in table_deactivate_sprite
04237F C9          0050*       ret
042380             0051*   ; end spawn_explosion_player
042380             0052*   
042380             0053*   tile_spawn_explosion:
042380 21 28 23 04 0054*       ld hl,explosion_defaults
042384 DD 21 23 A4 0055*       ld ix,explosions_base
       04          
042389 06 08       0056*       ld b,explosions_max
04238B CD 59 92 04 0057*       call spawn_sprite_from_tile
04238F D2 71 8E 04 0058*       jp nc,table_deactivate_tile ; no carry means no free sprite slots, so we deactivate parent tile and go home
042393             0059*   ; other specific initialization
042393 21 00 00 00 0060*       ld hl,0
042397 DD 2F 07    0061*       ld (ix+sprite_xvel),hl
04239A 21 00 01 00 0062*       ld hl,1*256
04239E DD 2F 0A    0063*       ld (ix+sprite_yvel),hl
