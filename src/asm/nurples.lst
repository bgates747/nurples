043B8A             0209*   agnb_io_buffer_size:       equ 8192
043B8A             0210*   
043B8A             0211*   ; Application callback invoked after each image has been finalized.
043B8A 00 00 00    0212*   agnb_image_callback:       dl 0
043B8D             0213*   
043B8D             0214*   ; Reader subroutine interface
043B8D             0215*   ; ---------------------------
043B8D             0216*   ; These labels establish the intended decomposition and calling contracts.
043B8D             0217*   ; They deliberately fail with agnb_error_not_implemented until replaced with
043B8D             0218*   ; real code, preventing an incomplete loader from reporting false success.
043B8D             0219*   
043B8D             0220*   ; Compare two FourCC values.
043B8D             0221*   ; inputs:  HL = pointer to first FourCC, DE = pointer to second FourCC
043B8D             0222*   ; outputs: Z set when all four bytes match, Z reset when any byte differs
043B8D             0223*   ; preserves: BC, DE, HL
043B8D             0224*   ; destroys: A
043B8D             0225*   agnb_compare_fourcc:
043B8D C5          0226*       push bc
043B8E D5          0227*       push de
043B8F E5          0228*       push hl
043B90 06 04       0229*       ld b,4
043B92             0230*   @loop:
043B92 1A          0231*       ld a,(de)
043B93 BE          0232*       cp (hl)
043B94 20 04       0233*       jr nz,@done ; exit with Z reset if any byte differs, indicating a mismatch
043B96 13          0234*       inc de
043B97 23          0235*       inc hl
043B98 10 F8       0236*       djnz @loop ; if we fall throgh at the end of the loop Z is set, indicating a match
043B9A             0237*   @done:
043B9A E1          0238*       pop hl
043B9B D1          0239*       pop de
043B9C C1          0240*       pop bc
043B9D C9          0241*       ret
043B9E             0242*   
043B9E             0243*   ; Open a container for reading.
043B9E             0244*   ; inputs:  DE = zero-terminated filename (normally agnb_filename)
043B9E             0245*   ; outputs: A=0 and Z set on success; A=agnb_error_open and NZ set on failure
043B9E             0246*   ;          agnb_fil initialized and agnb_file_is_open set on success
043B9E             0247*   ; destroys: AF, BC, HL
043B9E             0248*   agnb_open:
043B9E             0249*   ; begin fail-closed: do not leave stale success state if ffs_fopen fails
043B9E AF          0250*       xor a
043B9F 32 7D 1B 04 0251*       ld (agnb_file_is_open),a
043BA3 32 7C 1B 04 0252*       ld (agnb_last_error),a
043BA7             0253*   
043BA7             0254*   ; Each newly opened container starts at physical and logical offset zero.
043BA7             0255*   ; The original single-container caller received this state from BSS
043BA7             0256*   ; initialization; consecutive container loads must establish it explicitly.
043BA7 21 00 00 00 0257*       ld hl,0
043BAB 22 5D 1B 04 0258*       ld (agnb_state+agnb_state_file_offset),hl
043BAF 22 61 1B 04 0259*       ld (agnb_state+agnb_state_bytes_read),hl
043BB3 32 60 1B 04 0260*       ld (agnb_state+agnb_state_file_offset+3),a
043BB7 32 64 1B 04 0261*       ld (agnb_state+agnb_state_bytes_read+3),a
043BBB             0262*   
043BBB             0263*   ; open the caller-supplied filename into our single reader-owned FIL
043BBB 21 25 1B 04 0264*       ld hl,agnb_fil
043BBF 0E 01       0265*       ld c,fa_read
043BC1             0266*       FFSCALL ffs_fopen
                       M1 Args: function=ffs_fopen 
043BC1 FD E5       0001*M1     push iy
043BC3 3E 80       0002*M1     ld a,function
043BC5 5B CF       0003*M1     rst.lil $08
043BC7 FD E1       0004*M1     pop iy
043BC9 B7          0267*       or a
043BCA 20 08       0268*       jr nz,@error
043BCC             0269*   
043BCC             0270*   ; ffs_fopen succeeded
043BCC 3E 01       0271*       ld a,1
043BCE 32 7D 1B 04 0272*       ld (agnb_file_is_open),a
043BD2 AF          0273*       xor a
043BD3 C9          0274*       ret
043BD4             0275*   
043BD4             0276*   @error:
043BD4 3E 01       0277*       ld a,agnb_error_open
043BD6 32 7C 1B 04 0278*       ld (agnb_last_error),a
043BDA B7          0279*       or a
043BDB C9          0280*       ret
043BDC             0281*   
043BDC             0282*   ; Close agnb_fil if open and clear agnb_file_is_open.
043BDC             0283*   ; outputs: A=0 and Z set if closed or already closed
043BDC             0284*   ;          nonzero FatFS result and NZ set if ffs_fclose fails
043BDC             0285*   ; destroys: HL
043BDC             0286*   agnb_close:
043BDC             0287*   ; An unopened file is already in the requested state.
043BDC 3A 7D 1B 04 0288*       ld a,(agnb_file_is_open)
043BE0 B7          0289*       or a
043BE1 28 14       0290*       jr z,@success
043BE3             0291*   
043BE3             0292*   ; Close our single reader-owned FIL.
043BE3 21 25 1B 04 0293*       ld hl,agnb_fil
043BE7             0294*       FFSCALL ffs_fclose
                       M1 Args: function=ffs_fclose 
043BE7 FD E5       0001*M1     push iy
043BE9 3E 81       0002*M1     ld a,function
043BEB 5B CF       0003*M1     rst.lil $08
043BED FD E1       0004*M1     pop iy
043BEF B7          0295*       or a
043BF0 20 0B       0296*       jr nz,agnb_error_close
043BF2             0297*   
043BF2             0298*   ; Only clear the open flag after FatFS confirms the close.
043BF2 AF          0299*       xor a
043BF3 32 7D 1B 04 0300*       ld (agnb_file_is_open),a
043BF7             0301*   @success:
043BF7 AF          0302*       xor a
043BF8 32 7C 1B 04 0303*       ld (agnb_last_error),a
043BFC C9          0304*       ret
043BFD             0305*   
043BFD             0306*   agnb_error_close:
043BFD             0307*   ; Placeholder in case we determine that close failures need a dedicated AGNB
043BFD             0308*   ; error code or recovery path. For now retain and return the nonzero FRESULT,
043BFD             0309*   ; and leave agnb_file_is_open set because FatFS did not confirm the close.
043BFD 32 7C 1B 04 0310*       ld (agnb_last_error),a
043C01 B7          0311*       or a
043C02 C9          0312*       ret
043C03             0313*   
043C03             0314*   ; Top-level image load operation.
043C03             0315*   ; inputs:  DE = zero-terminated container filename
043C03             0316*   ; outputs: A=0 and Z set after all valid LIST BUFR image records are uploaded
043C03             0317*   ;          and finalized at their explicit IDs; nonzero error and NZ otherwise
043C03             0318*   ; destroys: AF, BC, DE, HL, IX
043C03             0319*   agnb_load_images:
043C03 21 72 3C 04 0320*       ld hl,agnb_image_callback_noop
043C07             0321*   
043C07             0322*   ; Callback-enabled image loader.
043C07             0323*   ; inputs: DE = filename; HL = callback whose result is ignored
043C07             0324*   agnb_load_images_with_callback:
043C07 22 8A 3B 04 0325*       ld (agnb_image_callback),hl
043C0B CD 9E 3B 04 0326*       call agnb_open
043C0F C0          0327*       ret nz
043C10             0328*   
043C10 CD E9 3C 04 0329*       call agnb_read_riff_header
043C14 20 47       0330*       jr nz,@load_error
043C16 CD BD 3D 04 0331*       call agnb_read_vers
043C1A 20 41       0332*       jr nz,@load_error
043C1C             0333*   
043C1C             0334*   @next_record:
043C1C             0335*   ; End only at the exact declared RIFF boundary. A position beyond it is an
043C1C             0336*   ; internal bounds failure; a position before it must begin another LIST BUFR.
043C1C 3A 60 1B 04 0337*       ld a,(agnb_state+agnb_state_file_offset+3)
043C20 21 50 1B 04 0338*       ld hl,agnb_state+agnb_state_riff_end+3
043C24 BE          0339*       cp (hl)
043C25 38 12       0340*       jr c,@read_record
043C27 20 2E       0341*       jr nz,@bad_bounds
043C29 2A 5D 1B 04 0342*       ld hl,(agnb_state+agnb_state_file_offset)
043C2D ED 5B 4D 1B 0343*       ld de,(agnb_state+agnb_state_riff_end)
       04          
043C32 B7          0344*       or a
043C33 ED 52       0345*       sbc hl,de
043C35 28 32       0346*       jr z,@success
043C37 30 1E       0347*       jr nc,@bad_bounds
043C39             0348*   
043C39             0349*   @read_record:
043C39 CD 28 3E 04 0350*       call agnb_read_buffer_list
043C3D 20 1E       0351*       jr nz,@load_error
043C3F CD 45 40 04 0352*       call agnb_stream_data
043C43 20 18       0353*       jr nz,@load_error
043C45 CD E5 40 04 0354*       call agnb_finalize_image
043C49 20 12       0355*       jr nz,@load_error
043C4B             0356*   
043C4B             0357*   ; Give the application one completed-bitmap boundary per record.
043C4B             0358*   ; Metadata remains valid for the duration of the callback.
043C4B CD 6D 3C 04 0359*       call agnb_call_image_callback
043C4F             0360*   
043C4F CD 0E 41 04 0361*       call agnb_finish_buffer_list
043C53 20 08       0362*       jr nz,@load_error
043C55 18 C5       0363*       jr @next_record
043C57             0364*   
043C57             0365*   @bad_bounds:
043C57 3E 08       0366*       ld a,agnb_error_bounds
043C59 32 7C 1B 04 0367*       ld (agnb_last_error),a
043C5D             0368*   @load_error:
043C5D             0369*   ; Preserve the parser/transport error while still closing the open file.
043C5D F5          0370*       push af
043C5E CD DC 3B 04 0371*       call agnb_close
043C62 F1          0372*       pop af
043C63 32 7C 1B 04 0373*       ld (agnb_last_error),a
043C67 B7          0374*       or a
043C68 C9          0375*       ret
043C69             0376*   
043C69             0377*   @success:
043C69 C3 DC 3B 04 0378*       jp agnb_close
043C6D             0379*   
043C6D             0380*   ; The CALL above has already stacked the continuation address. Tail-jump to
043C6D             0381*   ; the selected callback so its RET resumes the loader without clobbering BC.
043C6D             0382*   agnb_call_image_callback:
043C6D 2A 8A 3B 04 0383*       ld hl,(agnb_image_callback)
043C71 E9          0384*       jp (hl)
043C72             0385*   
043C72             0386*   agnb_image_callback_noop:
043C72 AF          0387*       xor a
043C73 C9          0388*       ret
043C74             0389*   
043C74             0390*   ; Read exactly BC bytes from agnb_fil into DE.
043C74             0391*   ; inputs:  BC = requested u24 length, DE = destination
043C74             0392*   ; outputs: A=0 and Z set after the complete request is satisfied
043C74             0393*   ;          nonzero error code and NZ set on FatFS error or premature EOF
043C74             0394*   ;          state offset/count updated after every successful FatFS read
043C74             0395*   ; destroys: BC, DE, HL
043C74             0396*   agnb_read_exact:
043C74             0397*   ; A zero-length request is already complete.
043C74 21 00 00 00 0398*       ld hl,0
043C78 B7          0399*       or a
043C79 ED 42       0400*       sbc hl,bc
043C7B 28 62       0401*       jr z,@success
043C7D             0402*   
043C7D             0403*   @read:
043C7D             0404*   ; ffs_fread replaces BC with the number of bytes actually read, so retain the
043C7D             0405*   ; remaining request on the stack. It preserves DE, our current destination.
043C7D C5          0406*       push bc
043C7E 21 25 1B 04 0407*       ld hl,agnb_fil
043C82             0408*       FFSCALL ffs_fread
                       M1 Args: function=ffs_fread 
043C82 FD E5       0001*M1     push iy
043C84 3E 82       0002*M1     ld a,function
043C86 5B CF       0003*M1     rst.lil $08
043C88 FD E1       0004*M1     pop iy
043C8A B7          0409*       or a
043C8B 20 40       0410*       jr nz,@fatfs_error
043C8D             0411*   
043C8D             0412*   ; Advance the u32 logical position by the returned u24 byte count.
043C8D 2A 5D 1B 04 0413*       ld hl,(agnb_state+agnb_state_file_offset)
043C91 09          0414*       add hl,bc
043C92 22 5D 1B 04 0415*       ld (agnb_state+agnb_state_file_offset),hl
043C96 3A 60 1B 04 0416*       ld a,(agnb_state+agnb_state_file_offset+3)
043C9A CE 00       0417*       adc a,0
043C9C 38 34       0418*       jr c,@offset_overflow
043C9E 32 60 1B 04 0419*       ld (agnb_state+agnb_state_file_offset+3),a
043CA2             0420*   
043CA2             0421*   ; Retain the count returned by this individual FatFS read.
043CA2 ED 43 61 1B 0422*       ld (agnb_state+agnb_state_bytes_read),bc
       04          
043CA7 AF          0423*       xor a
043CA8 32 64 1B 04 0424*       ld (agnb_state+agnb_state_bytes_read+3),a
043CAC             0425*   
043CAC             0426*   ; Recover the remaining request and reject zero bytes as premature EOF.
