044C96             0024*   spawn_explosion:
044C96 21 83 4C 04 0025*       ld hl,explosion_defaults
044C9A DD 21 86 8A 0026*       ld ix,explosions_base
       04          
044C9F 06 08       0027*       ld b,explosions_max
044CA1 CD 4F 68 04 0028*       call spawn_sprite_from_sprite
044CA5 D2 8B 67 04 0029*       jp nc,table_deactivate_sprite ; no carry means no free sprite slots, so we deactivate parent sprite and go home
044CA9             0030*   ; other specific initialization
044CA9 21 00 00 00 0031*       ld hl,0
044CAD DD 2F 07    0032*       ld (ix+sprite_xvel),hl
044CB0 21 00 01 00 0033*       ld hl,1*256
044CB4 DD 2F 0A    0034*       ld (ix+sprite_yvel),hl
044CB7             0035*   ; deactivate parent sprite
044CB7 C3 8B 67 04 0036*       jp table_deactivate_sprite
044CBB             0037*   ; end spawn_explosion
044CBB             0038*   
044CBB             0039*   spawn_explosion_player:
044CBB FD 21 86 88 0040*       ld iy,player_begin
       04          
044CC0 FD 22 07 67 0041*       ld (table_pointer),iy
       04          
044CC5 21 83 4C 04 0042*       ld hl,explosion_defaults
044CC9 DD 21 86 8A 0043*       ld ix,explosions_base
       04          
044CCE 06 08       0044*       ld b,explosions_max
044CD0 CD 4F 68 04 0045*       call spawn_sprite_from_sprite
044CD4 D8          0046*       ret c ; carry is the only indication that IX names a valid explosion
044CD5             0047*   ; no slot: keep the player hidden and return failure without exposing invalid IX
044CD5 CD 8B 67 04 0048*       call table_deactivate_sprite
044CD9 AF          0049*       xor a ; clear carry after the VDU calls in table_deactivate_sprite
044CDA C9          0050*       ret
044CDB             0051*   ; end spawn_explosion_player
044CDB             0052*   
044CDB             0053*   tile_spawn_explosion:
044CDB 21 83 4C 04 0054*       ld hl,explosion_defaults
044CDF DD 21 86 8A 0055*       ld ix,explosions_base
       04          
044CE4 06 08       0056*       ld b,explosions_max
044CE6 CD 4C 78 04 0057*       call spawn_sprite_from_tile
044CEA D2 55 74 04 0058*       jp nc,table_deactivate_tile ; no carry means no free sprite slots, so we deactivate parent tile and go home
044CEE             0059*   ; other specific initialization
044CEE 21 00 00 00 0060*       ld hl,0
044CF2 DD 2F 07    0061*       ld (ix+sprite_xvel),hl
044CF5 21 00 01 00 0062*       ld hl,1*256
044CF9 DD 2F 0A    0063*       ld (ix+sprite_yvel),hl
