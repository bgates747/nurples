046F61             0073        include "targeting.inc"
046F61             0001*   ; compute orientation to player
046F61             0002*   ; based on relative positions
046F61             0003*   ; returns: uh.l 16.8 fixed angle256 to player
046F61             0004*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
046F61             0005*   ;    representing delta-x/y *to* target respectively
046F61             0006*   ; inputs: iy pointed at sprite record
046F61             0007*   ; destroys: everything except iy (sprite record pointer)
046F61             0008*   orientation_to_player:
046F61 DD 21 1A 89 0009*       ld ix,player_begin
       04          
046F66             0010*   ; compute dx
046F66 DD 27 01    0011*       ld hl,(ix+sprite_x)
046F69 FD 17 01    0012*       ld de,(iy+sprite_x)
046F6C B7          0013*       or a ; clear carry
046F6D ED 52       0014*       sbc hl,de ; dx
046F6F E5          0015*       push hl ; save dx
046F70             0016*   ; compute dy
046F70 DD 27 04    0017*       ld hl,(ix+sprite_y)
046F73 FD 17 04    0018*       ld de,(iy+sprite_y)
046F76 B7          0019*       or a ; clear carry
046F77 ED 52       0020*       sbc hl,de ; dy
046F79 EB          0021*       ex de,hl ; de = dy
046F7A             0022*   ; compute angle to player
046F7A C1          0023*       pop bc ; dx (was hl)
046F7B C5          0024*       push bc ; save dx
046F7C D5          0025*       push de ; save dy
046F7D CD E3 07 04 0026*       call atan2_168fast ; uh.l = angle to player
046F81 3E E0       0027*       ld a,%11100000
046F83 A5          0028*       and l ; round angle to nearest 32th of a circle
046F84 6F          0029*       ld l,a
046F85 22 D6 6F 04 0030*       ld (Bearing_t),hl ; return angle to player
046F89 D1          0031*       pop de ; restore dy
046F8A C1          0032*       pop bc ; restore dx
046F8B C9          0033*       ret
046F8C             0034*   ; end orientation_to_player
046F8C             0035*   
046F8C             0036*   ; compute orientation to player
046F8C             0037*   ; based on relative positions
046F8C             0038*   ; returns: uh.l 16.8 fixed angle256 to player
046F8C             0039*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
046F8C             0040*   ;    representing delta-x/y *to* target respectively
046F8C             0041*   ; inputs: iy pointed at tile record
046F8C             0042*   ; destroys: everything except iy (tile record pointer)
046F8C             0043*   tile_orientation_to_player:
046F8C DD 21 1A 89 0044*       ld ix,player_begin
       04          
046F91             0045*   ; compute dx
046F91 DD 27 01    0046*       ld hl,(ix+sprite_x)
046F94 FD 17 01    0047*       ld de,(iy+tile_x)
046F97 B7          0048*       or a ; clear carry
046F98 ED 52       0049*       sbc hl,de ; dx
046F9A E5          0050*       push hl ; save dx
046F9B             0051*   ; compute dy
046F9B DD 27 04    0052*       ld hl,(ix+sprite_y)
046F9E FD 17 04    0053*       ld de,(iy+tile_y)
046FA1 B7          0054*       or a ; clear carry
046FA2 ED 52       0055*       sbc hl,de ; dy
046FA4 EB          0056*       ex de,hl ; de = dy
046FA5             0057*   ; compute angle to player
046FA5 C1          0058*       pop bc ; dx (was hl)
046FA6 CD E3 07 04 0059*       call atan2_168fast ; uh.l = angle to player
046FAA 3E E0       0060*       ld a,%11100000
046FAC A5          0061*       and l ; round angle to nearest 32th of a circle
046FAD 6F          0062*       ld l,a
046FAE 22 D6 6F 04 0063*       ld (Bearing_t),hl
046FB2 C9          0064*       ret
046FB3             0065*   ; end tile_orientation_to_player
046FB3             0066*   
046FB3             0067*   ; compute orientation to coordinate
046FB3             0068*   ; based on relative positions
046FB3             0069*   ; returns: uh.l 16.8 fixed angle256 to coordinate
046FB3             0070*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
046FB3             0071*   ;    representing delta-x/y *to* target respectively
046FB3             0072*   ; inputs: iy pointed at sprite record, ub.c,ud.e are target x,y coordinates
046FB3             0073*   ; destroys: everything except iy (sprite record pointer)
046FB3             0074*   bearing_to_coord:
046FB3             0075*   ; compute dx
046FB3 C5          0076*       push bc
046FB4 E1          0077*       pop hl
046FB5 FD 07 01    0078*       ld bc,(iy+sprite_x)
046FB8 B7          0079*       or a ; clear carry
046FB9 ED 42       0080*       sbc hl,bc ; dx
046FBB E5          0081*       push hl ; save dx
046FBC             0082*   ; compute dy
046FBC EB          0083*       ex de,hl
046FBD FD 17 04    0084*       ld de,(iy+sprite_y)
046FC0 B7          0085*       or a ; clear carry
046FC1 ED 52       0086*       sbc hl,de ; dy
046FC3 EB          0087*       ex de,hl ; de = dy
046FC4             0088*   ; compute angle to coordinate
046FC4 C1          0089*       pop bc ; dx (was hl)
046FC5 C5          0090*       push bc ; save dx
046FC6 D5          0091*       push de ; save dy
046FC7 CD E3 07 04 0092*       call atan2_168fast ; uh.l = angle to coordinate
046FCB 3E E0       0093*       ld a,%11100000
046FCD A5          0094*       and l ; round angle to nearest 32th of a circle
046FCE 6F          0095*       ld l,a
046FCF 22 D6 6F 04 0096*       ld (Bearing_t),hl ; return angle to coordinate
046FD3 D1          0097*       pop de ; restore dy
046FD4 C1          0098*       pop bc ; restore dx
046FD5 C9          0099*       ret
046FD6             0100*   ; end bearing_to_coord
046FD6             0101*   
046FD6             0102*   ; targeting_computer variables fixed 16.8 format
046FD6 00 00 00    0103*   Bearing_t: dl 0x000000 ; angle to target
046FD9 00 00 00    0104*   Heading_t: dl 0x000000 ; angle of target motion
046FDC 00 00 00    0105*   Vp: dl 0x000000 ; velocity of projectile
046FDF 00 00 00    0106*   Vp_x: dl 0x000000 ; x component of projectile velocity
046FE2 00 00 00    0107*   Vp_y: dl 0x000000 ; y component of projectile velocity
046FE5 00 00 00    0108*   Vt: dl 0x000000 ; velocity of target
046FE8 00 00 00    0109*   Vt_x: dl 0x000000 ; x component of target velocity
046FEB 00 00 00    0110*   Vt_y: dl 0x000000 ; y component of target velocity
046FEE 00 00 00    0111*   Heading_p: dl 0x000000 ; angle of projectile motion
046FF1 00 00 00    0112*   lead_angle: dl 0x000000 ; lead angle
046FF4             0113*   
046FF4             0114*   ; Inputs:   Vp velocity of projectile set,
046FF4             0115*   ;           iy pointed to sprite record,
046FF4             0116*   ;           player position and velocities correctly set
046FF4             0117*   ; Outputs:  uh.l is the 16.8 fixed firing angle256
046FF4             0118*   ;           ub.c and ud.e are the 16.8 fixed x,y component projectile velocities
046FF4             0119*   ; Law-of-sines derivation and NanoLinearTargeting small-angle approximation:
046FF4             0120*   ; https://old.robowiki.net/cgi-bin/robowiki?LinearTargeting
046FF4             0121*   ; Archived mirror:
046FF4             0122*   ; https://robowiki.net/wiki/Linear_Targeting/Archived_Talk_20071111
046FF4             0123*   targeting_computer:
046FF4 DD 21 1A 89 0124*       ld ix,player_begin
       04          
046FF9             0125*   ; compute target speed and heading from its component velocities
046FF9 DD 07 07    0126*       ld bc,(ix+sprite_xvel)
046FFC DD 17 0A    0127*       ld de,(ix+sprite_yvel)
046FFF 21 00 FF FF 0128*       ld hl,-1*256 ; account for vertical ground movement
047003 19          0129*       add hl,de
047004 EB          0130*       ex de,hl ; ud.e = player y velocity - ground scroll velocity
047005 CD 3D 07 04 0131*       call cartesian_to_polar_sm ; uh.l = Heading_t, ud.e = Vt
047009 22 D9 6F 04 0132*       ld (Heading_t),hl
04700D ED 53 E5 6F 0133*       ld (Vt),de
       04          
047012             0134*   ; B = target heading - bearing to target
047012 ED 5B D6 6F 0135*       ld de,(Bearing_t)
       04          
047017 B7          0136*       or a ; clear carry
047018 ED 52       0137*       sbc hl,de
04701A             0138*   ; numerator = Vt * sin(B), the target's lateral velocity
04701A CD D5 06 04 0139*       call sin168
04701E ED 5B E5 6F 0140*       ld de,(Vt)
       04          
047023 CD 11 06 04 0141*       call smul168
047027             0142*   ; sin(A) = Vt * sin(B) / Vp
047027 ED 5B DC 6F 0143*       ld de,(Vp)
       04          
04702C CD 75 06 04 0144*       call sdiv168 ; quotient is returned in ud.e, remainder in uh.l
047030 EB          0145*       ex de,hl
047031             0146*   ; NanoLinearTargeting drops asin and treats its argument as radians. Convert
047031             0147*   ; that small-angle result to angle256: 256/(2*pi) = 40.743665...
047031 11 BE 28 00 0148*       ld de,0x0028BE ; 40.7421875 in 16.8 fixed
047035 CD 11 06 04 0149*       call smul168
047039 22 F1 6F 04 0150*       ld (lead_angle),hl
04703D             0151*   ; projectile heading = bearing + lead angle
04703D ED 5B D6 6F 0152*       ld de,(Bearing_t)
       04          
047042 19          0153*       add hl,de
047043             0154*   
047043 E5          0155*       push hl
047044             0156*   
047044             0157*   ; compute component projectile velocities
047044 ED 5B DC 6F 0158*       ld de,(Vp) ; Vp should have been set by caller
       04          
047049 CD E9 06 04 0159*       call polar_to_cartesian ; ub.c = Vp_x, ud.e = Vp_y
04704D ED 43 DF 6F 0160*       ld (Vp_x),bc
       04          
047052             0161*       ; inc d ; account for vertical ground movement
047052 ED 53 E2 6F 0162*       ld (Vp_y),de
       04          
047057 E1          0163*       pop hl ; uh.l = lead angle+target bearing
047058 22 EE 6F 04 0164*       ld (Heading_p),hl
04705C             0165*   
04705C C9          0166*       ret
04705D             0167*   
04705D             0168*   ; debug print the results
04705D             0169*       PUSH_ALL
                       M1 Args: none
