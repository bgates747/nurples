047B67 00          0026*   laser_power_last: db 0 ; integer
047B68 40          0027*   laser_power_max: db 64 ; integer
047B69 04          0028*   laser_power_per_shot: db 4 ; integer
047B6A 00          0029*   charge_laser_timer: db 0
047B6B 06          0030*   charge_laser_timer_max: db 6
047B6C             0031*   bar_laser:
047B6C 00 00 00    0032*       dl 0 ; value
047B6F 08 00 00    0033*       dl 8 ; x0
047B72 30 01 00    0034*       dl 304 ; y0
