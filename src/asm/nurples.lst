047312             0035*   tile_stack_end:
047312 0F 70 04    0036*   tile_stack_pointer: dl tile_stack ; pointer to current stack record, initialized to tile_stack
047315 F3 8B 04    0037*   tile_table_pointer: dl tile_table_base ; pointer to top address of current record, initialized to tile_table_base
047318 00 00 00    0038*   num_active_tiles: dl 0 ; how many active tiles
04731B 00          0039*   next_tile_id: db 0 ; next available tile id
04731C 00 00 00    0040*   new_tile_table_pointer: dl 0 ; pointer to new tile record
04731F             0041*   tile_fault_bad_record: equ 0
