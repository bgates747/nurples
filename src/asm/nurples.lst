047CC0 21 EF FF FF 0184*       ld hl,-bar_red
047CC4 19          0185*       add hl,de
047CC5 D2 E2 7C 04 0186*       jp nc,@red
047CC9 21 DF FF FF 0187*       ld hl,-bar_yellow
