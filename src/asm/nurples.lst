04100E             0037*   img_load_init:
04100E 21 00 00 00 0038*       ld hl,0
041012 22 F8 0F 04 0039*       ld (logo_xpos),hl
041016 22 01 10 04 0040*       ld (game_load_index),hl
04101A 7D          0041*       ld a,l
04101B 32 07 10 04 0042*       ld (game_load_callback_overflow),a
04101F             0043*   
04101F 21 00 E0 00 0044*       ld hl,logo_y_start
041023 22 FB 0F 04 0045*       ld (logo_ypos),hl
041027             0046*   
041027 21 5E 01 00 0047*       ld hl,game_num_images
04102B 22 04 10 04 0048*       ld (game_load_remaining),hl
04102F             0049*   
04102F 21 00 28 FF 0050*       ld hl,logo_y_distance
041033 11 00 5E 01 0051*       ld de,game_num_images*256
041037 CD 75 06 04 0052*       call sdiv168 ; DE = signed 16.8 distance per completed bitmap
04103B ED 53 FE 0F 0053*       ld (logo_yvel),de
       04          
041040 C9          0054*       ret
