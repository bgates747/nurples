0476EC             0012*   tile_lightning: equ 10
0476EC             0013*   ; tile_electrode_r: equ 11 ; same as tile_electrode
0476EC             0014*   tile_12: equ 12
0476EC             0015*   tile_13: equ 13
0476EC             0016*   tile_14: equ 14
0476EC             0017*   tile_15: equ 15
0476EC             0018*   tile_crater: equ 16
