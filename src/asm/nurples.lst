0470D9 09          0126*       add hl,bc
0470DA E5          0127*       push hl
0470DB C1          0128*       pop bc ; bc = new x-coordinate
0470DC F1          0129*       pop af
0470DD C3 C8 70 04 0130*       jp @loop
0470E1 C9          0131*       ret
0470E2             0132*   ; end draw_player_ships
