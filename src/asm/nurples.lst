046508             0001*   laser_defaults:
046508 06          0002*       db player_air        ; type
046509 4E 01 00    0003*       dl BUF_LASER_A	    ; base_bufferId
04650C F6 65 04    0004*       dl move_player_laser	; move_program
04650F 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
046510 05          0006*       db 5	                ; dim_x
046511 0D          0007*       db 13                   ; dim_y
046512 01          0008*       db 1                    ; num_orientations
046513 02          0009*       db 2                    ; num_animations
046514 00          0010*       db 0	                ; animation
046515 02          0011*       db laser_animation_timer_reset ; animation_timer
046516 00          0012*       db 0	                ; move_timer
046517 00          0013*       db 0	                ; move_step
046518 00          0014*       db 0	                ; points
046519 00          0015*       db 0	                ; shield_damage
04651A 00          0016*       db 0                    ; frame
04651B             0017*   
04651B             0018*   
04651B             0019*   player_lasers_max: equ 4
04651B             0020*   laser_speed: equ 4*256 ; 6 pixels per frame 16.8 fixed
04651B             0021*   tmr_laser: ds 6 ; rate timer for firing laser
       FF FF FF FF 
       FF FF 
046521 0C 00 00    0022*   tmr_laser_reset: dl 120/10
046524             0023*   laser_animation_timer_reset: equ 2 ; animate every two frames
046524             0024*   
046524 40          0025*   laser_power: db 64 ; integer
046525 00          0026*   laser_power_last: db 0 ; integer
046526 40          0027*   laser_power_max: db 64 ; integer
046527 04          0028*   laser_power_per_shot: db 4 ; integer
046528 00          0029*   charge_laser_timer: db 0
046529 06          0030*   charge_laser_timer_max: db 6
04652A             0031*   bar_laser:
04652A 00 00 00    0032*       dl 0 ; value
04652D 08 00 00    0033*       dl 8 ; x0
046530 30 01 00    0034*       dl 304 ; y0
