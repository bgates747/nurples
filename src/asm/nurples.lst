047E73 19          0232*       add hl,de
047E74 D2 91 7E 04 0233*       jp nc,@red
047E78 21 DF FF FF 0234*       ld hl,-bar_yellow
047E7C 19          0235*       add hl,de
047E7D D2 89 7E 04 0236*       jp nc,@yellow
047E81 21 02 00 00 0237*       ld hl,BUF_BAR_H_2 ; green
047E85 C3 95 7E 04 0238*       jp @select
047E89             0239*   @yellow:
047E89 21 01 00 00 0240*       ld hl,BUF_BAR_H_1 ; yellow
047E8D C3 95 7E 04 0241*       jp @select
