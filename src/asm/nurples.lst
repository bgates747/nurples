044F88 CD 2A 50 04 0136*       call print_level
044F8C CD FA 7A 04 0137*       call print_score
044F90             0138*   ; TEMPORARY DIAGNOSTIC: bypass the blocking countdown. Restore the tagged
044F90             0139*   ; debug/pre-countdown-bypass-20260802 state to return to the original path.
