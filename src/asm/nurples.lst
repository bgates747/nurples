       04          
044D21 FD 7E 00    0095*       ld a,(iy+sprite_id) ; sprite id
044D24 1E 08       0096*       ld e,explosions_max ; sprite loop counter
044D26             0097*   ; define explosion sprites
044D26             0098*   @sprites_loop:
044D26 F5          0099*       push af
044D27 D5          0100*       push de
044D28 CD AE 19 04 0101*   	call vdu_sprite_select
044D2C CD C1 19 04 0102*   	call vdu_sprite_clear_frames
044D30 21 09 01 00 0103*   	ld hl,BUF_EXPLOSION_A
