0411F8 2A 07 12 04 0187*   	ld hl,(prt_irq_counter)
0411FC 23          0188*   	inc hl
0411FD 22 07 12 04 0189*   	ld (prt_irq_counter),hl
041201 E1          0190*       pop hl
041202 F1          0191*   	pop af
041203 FB          0192*   	ei
041204 5B ED 4D    0193*   	reti.l
