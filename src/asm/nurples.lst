0491B9             0103*   move_tiles:
0491B9             0104*   ; initialize the dense-stack cursor
0491B9 3A 57 8D 04 0105*       ld a,(num_active_tiles)
0491BD B7          0106*       or a
0491BE C8          0107*       ret z
0491BF FD 21 4E 8A 0108*       ld iy,tile_stack ; set iy to first record in table
       04          
0491C4             0109*   @move_loop:
0491C4 FD E5       0110*       push iy
0491C6 E1          0111*       pop hl
0491C7 CD 02 8E 04 0112*       call tile_stack_pointer_valid
0491CB D0          0113*       ret nc ; normal end-of-stack or fail-closed malformed cursor
0491CC FD 22 51 8D 0114*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
0491D1             0115*   ; point iy to tile record
0491D1 FD 37 00    0116*       ld iy,(iy) ; iy points to the current tile record
0491D4 CD 3B 8E 04 0117*       call tile_table_record_pointer_valid
0491D8 D2 22 92 04 0118*       jp nc,@bad_record
0491DC FD 22 54 8D 0119*       ld (tile_table_pointer),iy ; update table pointer
       04          
0491E1             0120*   ; check top bit of tile_type to see if tile is just spawned
0491E1 FD CB 16 7E 0121*       bit 7,(iy+tile_type)
0491E5 C2 12 92 04 0122*       jp nz,@just_spawned ; if just spawned, skip to next record
0491E9             0123*   ; check sprite_alive bit to see if tile is active
0491E9 FD CB 1D 76 0124*       bit sprite_alive,(iy+tile_collisions)
0491ED CA 1A 92 04 0125*       jp z,@inactive_record
0491F1             0126*   ; otherwise we prepare to move the tile
0491F1 FD 27 1A    0127*       ld hl,(iy+tile_move_program) ; load the behavior subroutine address
0491F4 CD 63 91 04 0128*       call tile_move_program_valid
0491F8 D2 30 92 04 0129*       jp nc,@bad_move_program
0491FC FD E5       0130*       push iy ; callbacks may use index registers internally but do not own them
0491FE             0131*       CALL_HL
                       M1 Args: none
0491FE 01 04 92 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
049202 C5          0002*M1     push bc ; which constitutes the return address
049203 E9          0003*M1     jp (hl) ; Jump to the address in HL
049204 FD E1       0132*       pop iy
049206             0133*    ; get back stack pointer and loop
049206             0134*   @next_record:
049206 FD 2A 51 8D 0135*       ld iy,(tile_stack_pointer)
       04          
04920B ED 33 03    0136*       lea iy,iy+3 ; next tile stack record
04920E C3 C4 91 04 0137*       jp @move_loop ; loop until we've checked all the records
049212             0138*   @just_spawned:
049212 FD CB 16 BE 0139*       res 7,(iy+tile_type) ; clear just spawned flag
049216 C3 06 92 04 0140*       jp @next_record
04921A             0141*   @inactive_record:
04921A CD 71 8E 04 0142*       call table_deactivate_tile
04921E C3 06 92 04 0143*       jp @next_record
049222             0144*   @bad_record:
049222 21 5E 8D 04 0145*       ld hl,tile_fault_flags
049226 CB C6       0146*       set tile_fault_bad_record,(hl)
049228 CD B5 8E 04 0147*       call tile_stack_quarantine_entry
04922C C3 06 92 04 0148*       jp @next_record
049230             0149*   @bad_move_program:
049230 21 5E 8D 04 0150*       ld hl,tile_fault_flags
049234 CB CE       0151*       set tile_fault_bad_move_program,(hl)
049236 CD 71 8E 04 0152*       call table_deactivate_tile
04923A C3 06 92 04 0153*       jp @next_record
