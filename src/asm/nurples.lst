048FC3             0035*   ; do animation
048FC3 FD 35 23    0036*       dec (iy+tile_animation_timer)
048FC6 C2 DC 8F 04 0037*       jp nz,@F
048FCA 3E 10       0038*       ld a,16
048FCC FD 77 23    0039*       ld (iy+tile_animation_timer),a
048FCF FD 7E 28    0040*       ld a,(iy+tile_frame)
048FD2 3C          0041*       inc a
048FD3 E6 07       0042*       and %00000111 ; modulo 8
048FD5 FD 77 28    0043*       ld (iy+tile_frame),a
048FD8 CD 77 8D 04 0044*       call draw_active_tile
048FDC             0045*   @@: ; check player alive
048FDC DD 21 9E 9C 0046*       ld ix,player_begin
       04          
048FE1 DD CB 1D 76 0047*       bit sprite_alive,(ix+sprite_collisions)
048FE5 C8          0048*       ret z ; player dead so nothing more to do
048FE6             0049*   ; check whether it is time to spawn a seeker
048FE6 FD 35 24    0050*       dec (iy+tile_move_timer)
048FE9 C0          0051*       ret nz
048FEA             0052*   ; spwan a seeker
048FEA CD 20 21 04 0053*       call enemy_spawn_seeker
048FEE             0054*       ; ret ; DEBUG
048FEE             0055*       ; fall through to reset move timer
048FEE             0056*   pad_small_reset_move_timer:
048FEE CD 14 05 04 0057*       call rand_8     ; snag a random number
048FF2 E6 1F       0058*       and %00011111   ; keep only 5 lowest bits (max 31)
