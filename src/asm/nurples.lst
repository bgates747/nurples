0411AA             0156*   ; ===============================================
0411AA             0157*   ; PRT Timer Interrupt Handling
0411AA             0158*   ; https://github.com/tomm/agon-cpu-emulator/blob/main/sdcard/regression_suite/timerirq.asm
0411AA             0159*   ; -----------------------------------------------
0411AA             0160*   prt_irq_init:
0411AA             0161*       ; set up interrupt vector table 2
0411AA 21 00 00 00 0162*   	ld hl,0
0411AE 3A 0C 01 00 0163*   	ld a,($10c)
0411B2 6F          0164*   	ld l,a
0411B3 3A 0D 01 00 0165*   	ld a,($10d)
0411B7 67          0166*   	ld h,a
0411B8             0167*   
0411B8             0168*   	; skip over CALL ($c3)
0411B8 23          0169*   	inc hl
0411B9             0170*   	; load address of jump into vector table 2 (in ram)
0411B9 ED 27       0171*   	ld hl,(hl)
0411BB             0172*   
0411BB             0173*   	; write CALL prt_irq_handler to vector table 2
0411BB 3E C3       0174*   	ld a,$c3
0411BD 77          0175*   	ld (hl),a
0411BE 23          0176*   	inc hl
0411BF 11 C6 11 04 0177*   	ld de,prt_irq_handler
0411C3 ED 1F       0178*   	ld (hl),de
0411C5             0179*   
0411C5 C9          0180*       ret
0411C6             0181*   
0411C6             0182*   prt_irq_handler:
0411C6 F3          0183*   	di
0411C7 F5          0184*   	push af
0411C8 E5          0185*       push hl
0411C9 ED 38 83    0186*   	in0 a,(TMR1_CTL+TMR_REG_CTL)
0411CC 2A DB 11 04 0187*   	ld hl,(prt_irq_counter)
0411D0 23          0188*   	inc hl
0411D1 22 DB 11 04 0189*   	ld (prt_irq_counter),hl
0411D5 E1          0190*       pop hl
0411D6 F1          0191*   	pop af
0411D7 FB          0192*   	ei
0411D8 5B ED 4D    0193*   	reti.l
0411DB             0194*   
0411DB             0195*   prt_irq_counter:
0411DB 00 00 00    0196*   	.dl 0
0411DE             0197*   prt_irq_counter_saved:
0411DE 00 00 00    0198*       .dl 0
0411E1             0199*   
0411E1             0200*   prt_loop_reset:
0411E1 E5          0201*       push hl
0411E2 21 00 00 00 0202*   	ld hl,0
0411E6 22 DB 11 04 0203*   	ld (prt_irq_counter),hl
0411EA 22 4C 12 04 0204*       ld (prt_loop_counter),hl
0411EE 22 4F 12 04 0205*       ld (prt_loops),hl
0411F2 CD 8D 11 04 0206*       call prt_set
0411F6 E1          0207*       pop hl
0411F7 C9          0208*       ret
0411F8             0209*   
0411F8             0210*   prt_loop_start:
0411F8 E5          0211*       push hl
0411F9 21 00 00 00 0212*   	ld hl,0
0411FD 22 DB 11 04 0213*   	ld (prt_irq_counter),hl
041201 E1          0214*       pop hl
041202 C9          0215*       ret
041203             0216*   
041203             0217*   prt_loop_stop:
041203 E5          0218*       push hl
041204 D5          0219*       push de
041205 2A DB 11 04 0220*       ld hl,(prt_irq_counter)
041209 ED 5B 4C 12 0221*       ld de,(prt_loop_counter)
       04          
04120E 19          0222*       add hl,de
04120F 22 4C 12 04 0223*       ld (prt_loop_counter),hl
041213 21 00 00 00 0224*       ld hl,0
041217 22 DB 11 04 0225*       ld (prt_irq_counter),hl
04121B 2A 4F 12 04 0226*       ld hl,(prt_loops)
04121F 23          0227*       inc hl
041220 22 4F 12 04 0228*       ld (prt_loops),hl
041224 D1          0229*       pop de
041225 E1          0230*       pop hl
041226 C9          0231*       ret
