048A21             0256*   ; Compact the already-validated dense-stack cursor and retain the historical
048A21             0257*   ; cursor-minus-three convention used by deactivation during iteration.
048A21             0258*   tile_stack_remove_current_entry:
048A21             0259*   ; compute address to copy from
048A21 2A A6 88 04 0260*       ld hl,(tile_stack_pointer)
048A25 23          0261*       inc hl
048A26 23          0262*       inc hl
048A27 23          0263*       inc hl
