044F99             0146*   init_bg:
044F99             0147*   ; Scroll commands expose the graphics background before the replacement
044F99             0148*   ; bitmap strip is plotted. Match that fill to the opaque starfield ground so
044F99             0149*   ; fast scrolling cannot flash black/violet seams between queued VDP commands.
044F99 AF          0150*       xor a ; plotting mode 0
044F9A 0E 90       0151*       ld c,16+128 ; darkest blue, matching the starfield base
044F9C CD 0C 14 04 0152*       call vdu_gcol
044FA0             0153*   ; draw initial background tiles
044FA0 21 00 04 00 0154*       ld hl,BUF_BG_STARS_0
044FA4 CD 2C 15 04 0155*       call vdu_buff_select
044FA8 01 00 00 00 0156*       ld bc,0
044FAC 11 00 00 00 0157*       ld de,field_top
044FB0 CD 62 19 04 0158*       call vdu_plot_bmp
044FB4 21 02 04 00 0159*       ld hl,BUF_BG_STARS_4
044FB8 CD 2C 15 04 0160*       call vdu_buff_select
044FBC 01 00 00 00 0161*       ld bc,0
044FC0 11 00 01 00 0162*       ld de,field_top+256
044FC4 CD 62 19 04 0163*       call vdu_plot_bmp
044FC8 C9          0164*       ret
044FC9             0165*   ; end init_level
044FC9             0166*   start_level_countdown:
