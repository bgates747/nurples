04923E             0156*   draw_active_tile:
04923E FD 27 17    0157*       ld hl,(iy+tile_base_bufferId)
049241 FD 7E 28    0158*       ld a,(iy+tile_frame)
049244 85          0159*       add a,l ; TODO: with a little work we could make all tile base buffer ids align to 256
049245 6F          0160*       ld l,a
049246 3E 00       0161*       ld a,0 ; preserve carry
049248 8C          0162*       adc a,h
049249 67          0163*       ld h,a
04924A CD 93 14 04 0164*       call vdu_buff_select ; buffer id of animation frame
04924E FD 07 01    0165*       ld bc,(iy+tile_x)
049251 FD 17 04    0166*       ld de,(iy+tile_y)
049254 CD BF 18 04 0167*       call vdu_plot_bmp168
049258 C9          0168*       ret
049259             0169*   ; end draw_active_tile
