0479D5 DD E1       0228*       pop ix ; restore pointer
0479D7             0229*   ; select the color based on the value thresholds
0479D7 DD 17 00    0230*       ld de,(ix+bar_val)
0479DA 21 EF FF FF 0231*       ld hl,-bar_red
0479DE 19          0232*       add hl,de
0479DF D2 FC 79 04 0233*       jp nc,@red
0479E3 21 DF FF FF 0234*       ld hl,-bar_yellow
0479E7 19          0235*       add hl,de
0479E8 D2 F4 79 04 0236*       jp nc,@yellow
0479EC 21 02 00 00 0237*       ld hl,BUF_BAR_H_2 ; green
0479F0 C3 00 7A 04 0238*       jp @select
0479F4             0239*   @yellow:
0479F4 21 01 00 00 0240*       ld hl,BUF_BAR_H_1 ; yellow
0479F8 C3 00 7A 04 0241*       jp @select
0479FC             0242*   @red:
