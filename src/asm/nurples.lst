                       M1 Args: none
04834D 01 53 83 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
048351 C5          0002*M1     push bc ; which constitutes the return address
048352 E9          0003*M1     jp (hl) ; Jump to the address in HL
048353 C9          0007*       ret
