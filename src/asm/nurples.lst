044179             1104*   agnb_audio_meta_format:    equ 2 ; u8 VDP format; version 0.2 requires 0x09
044179             1105*   agnb_audio_meta_rate:      equ 3 ; u16 sample rate in Hz
044179             1106*   agnb_audio_meta_data_size: equ 5 ; u32 DATA payload size
044179             1107*   agnb_audio_meta_size:      equ 9
044179             1108*   
