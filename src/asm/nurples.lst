041031 2A E3 0F 04 0057*       ld hl,(cur_filename)
041035 CD 63 00 04 0058*       call printString
041039             0059*   
041039             0060*   ; flip the framebuffer
041039             0061*       ; call vdu_flip
041039             0062*   
