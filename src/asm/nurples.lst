047590             0059        include "player_state.inc"
047590             0001*   player_defaults:
047590 05          0002*       db player               ; type
047591 73 01 00    0003*       dl BUF_SHIP_0L          ; base_bufferId
047594 FA 75 04    0004*       dl do_player            ; move_program
047597 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
047598 10          0006*       db 16                   ; dim_x
047599 10          0007*       db 16                   ; dim_y
04759A 01          0008*       db 1                    ; num_orientations
04759B 01          0009*       db 1                    ; num_animations
04759C 00          0010*       db 0                    ; animation
04759D 00          0011*       db 0                    ; animation_timer
04759E 00          0012*       db 0                    ; move_timer
04759F 00          0013*       db 0                    ; move_step
0475A0 00          0014*       db 0                    ; points
0475A1 00          0015*       db 0                    ; shield_damage
0475A2 00          0016*       db 0                    ; frame
0475A3             0017*   
0475A3 CA 76 04    0018*   player_state:  dl player_alive
0475A6             0019*   player_event_none: equ 0
0475A6             0020*   player_event_game_over: equ 1
0475A6 00          0021*   player_event: db player_event_none
0475A7             0022*   player_fault_bad_state: equ 0
0475A7 00          0023*   player_fault_flags: db 0 ; latched fail-closed diagnostics
0475A8 00          0024*   player_ships: db 0
0475A9 03          0025*   player_ships_max: db 3
0475AA             0026*   player_speed: equ 3*256 ; pixels per frame 16.8 fixed
0475AA             0027*   
0475AA             0028*   draw_player_ships:
0475AA             0029*   ; activate mfd
0475AA DD 21 27 78 0030*       ld ix,mfd_ships
       04          
0475AF CD 2E 79 04 0031*       call mfd_activate
0475B3             0032*   ; blank out previously drawn ships
0475B3 AF          0033*       xor a ; color mode 0
0475B4 0E 00       0034*       ld c,c_black
0475B6 CD C3 13 04 0035*       call vdu_gcol
0475BA 01 00 00 00 0036*       ld bc,0
0475BE 11 00 00 00 0037*       ld de,0
0475C2 DD 21 4F 00 0038*       ld ix,0+79
       00          
0475C7 FD 21 0F 00 0039*       ld iy,0+15
       00          
0475CC CD E0 18 04 0040*       call vdu_plot_rf
0475D0             0041*   ; draw the ships remaining
0475D0 21 2B 00 00 0042*       ld hl,BUF_SHIP_MFD
0475D4 CD 93 14 04 0043*       call vdu_buff_select
0475D8 3A A8 75 04 0044*       ld a,(player_ships) ; loop counter
0475DC 01 00 00 00 0045*       ld bc,0 ; starting x-coordinate
0475E0             0046*   @loop:
0475E0 3D          0047*       dec a ; we don't count the ship we're flying
0475E1 C8          0048*       ret z
0475E2 F5          0049*       push af ; back up loop counter
0475E3 C5          0050*       push bc ; save x-coordinate
0475E4 11 00 00 00 0051*       ld de,0 ; y-coordinate
0475E8 CD A3 18 04 0052*       call vdu_plot_bmp
0475EC C1          0053*       pop bc ; restore x-coordinate
0475ED 21 10 00 00 0054*       ld hl,16 ; bump x-coords
0475F1 09          0055*       add hl,bc
0475F2 E5          0056*       push hl
0475F3 C1          0057*       pop bc ; bc = new x-coordinate
0475F4 F1          0058*       pop af
0475F5 C3 E0 75 04 0059*       jp @loop
0475F9 C9          0060*       ret
0475FA             0061*   ; end draw_player_ships
0475FA             0062*   
0475FA             0063*   do_player:
0475FA 2A A3 75 04 0064*       ld hl,(player_state)
0475FE CD 1A 76 04 0065*       call player_state_pointer_valid
047602 DA 13 76 04 0066*       jp c,@dispatch
047606 21 A7 75 04 0067*       ld hl,player_fault_flags
04760A CB C6       0068*       set player_fault_bad_state,(hl)
04760C 3E 01       0069*       ld a,player_event_game_over
04760E 32 A6 75 04 0070*       ld (player_event),a
047612 C9          0071*       ret
047613             0072*   @dispatch:
047613             0073*       CALL_HL
                       M1 Args: none
047613 01 19 76 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
047617 C5          0002*M1     push bc ; which constitutes the return address
047618 E9          0003*M1     jp (hl) ; Jump to the address in HL
047619 C9          0074*       ret
04761A             0075*   ; end do_player
04761A             0076*   
04761A             0077*   ; Exact stabilization whitelist for writable legacy player-state pointers.
04761A             0078*   ; Invalid actor state is surfaced as an event for the global coordinator.
04761A             0079*   player_state_pointer_valid:
04761A 11 CA 76 04 0080*       ld de,player_alive
04761E CD 42 76 04 0081*       call @matches
047622 CA 40 76 04 0082*       jp z,@valid
047626 11 00 77 04 0083*       ld de,player_dying
04762A CD 42 76 04 0084*       call @matches
04762E CA 40 76 04 0085*       jp z,@valid
047632 11 9C 77 04 0086*       ld de,player_dead
047636 CD 42 76 04 0087*       call @matches
04763A CA 40 76 04 0088*       jp z,@valid
04763E AF          0089*       xor a
04763F C9          0090*       ret
047640             0091*   @valid:
047640 37          0092*       scf
047641 C9          0093*       ret
047642             0094*   @matches:
047642 E5          0095*       push hl
047643 B7          0096*       or a
047644 ED 52       0097*       sbc hl,de
047646 E1          0098*       pop hl
047647 C9          0099*       ret
047648             0100*   ; end player_state_pointer_valid
047648             0101*   
047648             0102*   ; set initial player position
047648             0103*   ; inputs: none,everything is hardcoded
047648             0104*   ; outputs: player_x/y set to bottom-left corner of screen
047648             0105*   ; destroys: pretty much everything
047648             0106*   player_init:
047648 3A D0 7C 04 0107*       ld a,(player_shields_max)
04764C 32 CF 7C 04 0108*       ld (player_shields),a
047650 3A 68 7B 04 0109*       ld a,(laser_power_max)
047654 32 66 7B 04 0110*       ld (laser_power),a
047658 3A 46 7A 04 0111*       ld a,(player_fuel_max)
04765C 32 44 7A 04 0112*       ld (player_fuel),a
047660             0113*   ; set all to zero so they will update
047660 AF          0114*       xor a
047661 32 67 7B 04 0115*       ld (laser_power_last),a
047665 32 D1 7C 04 0116*       ld (player_shields_last),a
047669 32 45 7A 04 0117*       ld (player_fuel_last),a
04766D             0118*   ; set player sprite record with defaults
04766D DD 21 87 9D 0119*       ld ix,player_begin
       04          
047672 21 90 75 04 0120*       ld hl,player_defaults
047676 01 00 00 00 0121*       ld bc,0*256
04767A 11 00 40 01 0122*       ld de,sprite_bottom*256
04767E 3E 01       0123*       ld a,1
047680 CD 41 7E 04 0124*       call spawn_sprite_from_coords
047684 D0          0125*       ret nc ; IX is invalid when the one-record player pool is full
047685 DD CB 16 BE 0126*       res 7,(ix+sprite_type)
047689             0127*   ; load sprite frames
047689 DD 7E 00    0128*       ld a,(ix+sprite_id)
04768C CD 44 19 04 0129*       call vdu_sprite_select
047690 CD 57 19 04 0130*       call vdu_sprite_clear_frames
047694 21 73 01 00 0131*       ld hl,BUF_SHIP_0L
047698 CD 99 1A 04 0132*       call vdu_sprite_add_buff
04769C 21 74 01 00 0133*       ld hl,BUF_SHIP_1C
0476A0 CD 99 1A 04 0134*       call vdu_sprite_add_buff
0476A4 21 75 01 00 0135*       ld hl,BUF_SHIP_2R
0476A8 CD 99 1A 04 0136*       call vdu_sprite_add_buff
0476AC             0137*   @draw:
0476AC 01 00 00 00 0138*       ld bc,0*256
0476B0 11 00 40 01 0139*       ld de,sprite_bottom*256
0476B4 CD 10 1A 04 0140*       call vdu_sprite_move_abs168
0476B8 CD BA 19 04 0141*       call vdu_sprite_show
0476BC 21 CA 76 04 0142*       ld hl,player_alive
0476C0 22 A3 75 04 0143*       ld (player_state),hl
0476C4 DD CB 1D F6 0144*       set sprite_alive,(ix+sprite_collisions)
0476C8 37          0145*       scf ; publish successful initialization to the caller
0476C9 C9          0146*       ret
0476CA             0147*   ; end player_init
0476CA             0148*   
0476CA             0149*   player_alive:
0476CA CD 81 7A 04 0150*       call player_input
0476CE CD D2 7B 04 0151*       call player_move_weapons
0476D2 C9          0152*       ret
0476D3             0153*   ; end player_alive
0476D3             0154*   
0476D3             0155*   kill_player:
0476D3             0156*   ; update_shields callers still own their collision-record index registers
0476D3 F5          0157*       push af
0476D4 C5          0158*       push bc
0476D5 DD E5       0159*       push ix
0476D7 FD E5       0160*       push iy
0476D9             0161*   ; set player collision flag to dead
0476D9 DD 21 87 9D 0162*       ld ix,player_begin
       04          
0476DE DD CB 1D B6 0163*       res sprite_alive,(ix+sprite_collisions)
0476E2             0164*   ; change seeker move program to move_enemy_seeker_orbit
0476E2 FD 21 C7 9D 0165*       ld iy,seekers_base
       04          
0476E7 21 F1 21 04 0166*       ld hl,move_enemy_seeker_orbit
0476EB 06 03       0167*       ld b,seekers_max
0476ED CD 3D 80 04 0168*       call change_sprite_group_move_program
0476F1             0169*   ; set player state to dying
0476F1 21 00 77 04 0170*       ld hl,player_dying
0476F5 22 A3 75 04 0171*       ld (player_state),hl
0476F9 FD E1       0172*       pop iy
0476FB DD E1       0173*       pop ix
0476FD C1          0174*       pop bc
0476FE F1          0175*       pop af
0476FF C9          0176*       ret
047700             0177*   ; end kill_player
047700             0178*   
047700             0179*   player_dying:
047700             0180*   ; spawn explosions at player location
047700 06 10       0181*       ld b,16 ; loop counter
047702             0182*   @loop_explode:
047702 C5          0183*       push bc ; save loop counter
047703 CD 60 23 04 0184*       call spawn_explosion_player
047707 D2 19 77 04 0185*       jp nc,@animate_initial ; never dereference IX after allocation failure
04770B 21 00 00 00 0186*       ld hl,0
04770F DD 2F 07    0187*       ld (ix+sprite_xvel),hl
047712 21 00 01 00 0188*       ld hl,1*256
047716 DD 2F 0A    0189*       ld (ix+sprite_yvel),hl
