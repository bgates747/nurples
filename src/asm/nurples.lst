047F16             0001*   ; UART ports for reading joystick input
047F16             0002*   ; bit tests: 0 means actuated, 1 means not actuated
047F16             0003*   portC: 	EQU 	$9E ; reads dpad input
047F16             0004*   joy1_u: equ 1
047F16             0005*   joy1_d: equ 3
047F16             0006*   joy1_l: equ 5
047F16             0007*   joy1_r: equ 7
047F16             0008*   portD: 	EQU 	$A2 ; reads buttons
047F16             0009*   btn1_a: equ 5
047F16             0010*   
047F16             0011*   ; process player keyboard input, set player bitmap
047F16             0012*   ; velocities and draw player bitmap at updated coordinates
047F16             0013*   ; Inputs: player_x/y set at desired position
047F16             0014*   ; Returns: player bitmap drawn at updated position
047F16             0015*   ; Destroys: probably everything except maybe iy
047F16             0016*   ; NOTE: in mode 9 we draw the ship as a sprite, not a bitmap
047F16             0017*   ; TODO: requires sprite implementation
047F16             0018*   player_input:
047F16             0019*   ; point to player sprite record
047F16 FD 21 23 A2 0020*       ld iy,player_begin
       04          
047F1B FD 22 E1 81 0021*       ld (table_pointer),iy
       04          
047F20             0022*   ; reset player component velocities to zero as the default
047F20 21 00 00 00 0023*       ld hl,0
047F24 FD 2F 07    0024*       ld (iy+sprite_xvel),hl
047F27 FD 2F 0A    0025*       ld (iy+sprite_yvel),hl
047F2A             0026*   ; make ship the active sprite
047F2A FD 7E 00    0027*       ld a,(iy+sprite_id)
047F2D CD 44 19 04 0028*       call vdu_sprite_select
047F31             0029*   ; check for keypresses and branch accordingly
047F31             0030*       MOSCALL    mos_getkbmap ;ix = pointer to MOS virtual keys table
                       M1 Args: function=mos_getkbmap 
047F31 3E 1E       0001*M1 			LD	A, function
047F33 5B CF       0002*M1 			RST.LIL	08h
047F35             0031*   ; do player directional input
047F35 AF          0032*       xor a ; clear flags
047F36 DB 9E       0033*       in a,(portC) ; read dpad input
047F38 57          0034*       ld d,a ; save dpad input
047F39 3E 01       0035*       ld a,1 ; set ship's default animation to center
047F3B             0036*   ; 26 Left: move player left
047F3B DD CB 03 4E 0037*       bit 1,(ix+3)
047F3F C2 4D 7F 04 0038*       jp nz,@F
047F43             0039*   ; test dpad left
047F43 CB 6A       0040*       bit joy1_l,d
047F45 CA 4D 7F 04 0041*       jp z,@F
047F49 C3 59 7F 04 0042*       jp @right
047F4D             0043*   @@:
047F4D FD 27 07    0044*       ld hl,(iy+sprite_xvel)
047F50 01 00 FD FF 0045*       ld bc,-player_speed
047F54 09          0046*       add hl,bc
047F55 FD 2F 07    0047*       ld (iy+sprite_xvel),hl
047F58 3D          0048*       dec a ; set ship's animation to left
047F59             0049*   @right:
047F59             0050*   ; 122 Right: move player right
047F59 DD CB 0F 4E 0051*       bit 1,(ix+15)
047F5D C2 6B 7F 04 0052*       jp nz,@F
047F61             0053*   ; test dpad right
047F61 CB 7A       0054*       bit joy1_r,d
047F63 CA 6B 7F 04 0055*       jp z,@F
047F67 C3 77 7F 04 0056*       jp @up
047F6B             0057*   @@:
047F6B FD 27 07    0058*       ld hl,(iy+sprite_xvel)
047F6E 01 00 03 00 0059*       ld bc,player_speed
047F72 09          0060*       add hl,bc
047F73 FD 2F 07    0061*       ld (iy+sprite_xvel),hl
047F76 3C          0062*       inc a ; set ship's animation to right
047F77             0063*   @up:
047F77             0064*   ; 58 Up: move player up
047F77 DD CB 07 4E 0065*       bit 1,(ix+7)
047F7B C2 89 7F 04 0066*       jp nz,@F
047F7F             0067*   ; test dpad up
047F7F CB 4A       0068*       bit joy1_u,d
047F81 CA 89 7F 04 0069*       jp z,@F
047F85 C3 94 7F 04 0070*       jp @dn
047F89             0071*   @@:
047F89 FD 27 0A    0072*       ld hl,(iy+sprite_yvel)
047F8C 01 00 FD FF 0073*       ld bc,-player_speed
047F90 09          0074*       add hl,bc
047F91 FD 2F 0A    0075*       ld (iy+sprite_yvel),hl
047F94             0076*   @dn:
047F94             0077*   ; 42 Down: move player down
047F94 DD CB 05 4E 0078*       bit 1,(ix+5)
047F98 C2 A6 7F 04 0079*       jp nz,@F
047F9C             0080*   ; test dpad down
047F9C CB 5A       0081*       bit joy1_d,d
047F9E CA A6 7F 04 0082*       jp z,@F
047FA2 C3 B1 7F 04 0083*       jp @frame
047FA6             0084*   @@:
047FA6 FD 27 0A    0085*       ld hl,(iy+sprite_yvel)
047FA9 01 00 03 00 0086*       ld bc,player_speed
047FAD 09          0087*       add hl,bc
047FAE FD 2F 0A    0088*       ld (iy+sprite_yvel),hl
047FB1             0089*   @frame:
047FB1             0090*   ; a should land here loaded with the correct frame
047FB1 CD A7 19 04 0091*       call vdu_sprite_select_frame
047FB5             0092*   ; draw player at updated position
047FB5 FD 21 23 A2 0093*       ld iy,player_begin
       04          
047FBA FD 22 E1 81 0094*       ld (table_pointer),iy
       04          
047FBF CD FD 84 04 0095*       call move_sprite
047FC3 FD 07 01    0096*       ld bc,(iy+sprite_x)
047FC6 FD 17 04    0097*       ld de,(iy+sprite_y)
047FC9 CD 10 1A 04 0098*       call vdu_sprite_move_abs168
047FCD             0099*   
047FCD             0100*   ; process player laser fire
047FCD             0101*   ; do player fire button input
047FCD             0102*   ; read joystick fire button
047FCD AF          0103*       xor a ; clear flags
047FCE DB A2       0104*       in a,(portD) ; read joypad fire button input
047FD0 CB 6F       0105*       bit btn1_a,a
047FD2 CA 73 80 04 0106*       jp z,player_spawn_laser
047FD6             0107*   ; 99 Space: fire main weapon
047FD6 DD CB 0C 56 0108*       bit 2,(ix+12)
047FDA C2 73 80 04 0109*       jp nz,player_spawn_laser
047FDE             0110*   ; no fire button pressed so go home
047FDE C9          0111*       ret
047FDF             0112*   ; end player_input
