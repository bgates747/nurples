04654A C1          0068*   	pop bc
04654B 10 F5       0069*   	djnz @frames_loop
04654D D1          0070*       pop de ; sprite loop counter
04654E F1          0071*       pop af ; sprite id
04654F 3C          0072*       inc a
046550 1D          0073*       dec e
046551 C2 32 65 04 0074*       jp nz,@sprites_loop
046555             0075*   ; set laser firing timer to zero
046555 FD 21 EE 64 0076*       ld iy,tmr_laser
       04          
04655A 21 00 00 00 0077*       ld hl,0
