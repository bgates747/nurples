04178A             0041        include "vdu_buffered_api.inc"
04178A             0001*   ; https://agonconsole8.github.io/agon-docs/vdp/Buffered-Commands-API/
04178A             0002*   
04178A             0003*   ; Command 0: Write block to a buffer
04178A             0004*   ; VDU 23, 0, &A0, bufferId; 0, length; <buffer-data>
04178A             0005*   ; inputs: hl = bufferId, bc = length of data, de = pointer to data
04178A             0006*   vdu_write_block_to_buffer:
04178A             0007*   ; back up input parameters
04178A D5          0008*       push de ; pointer to data
04178B C5          0009*       push bc ; length of data
04178C             0010*   ; set up the vdu command string
04178C 22 AC 17 04 0011*       ld (@bufferId),hl
041790 ED 43 AF 17 0012*       ld (@length),bc
       04          
041795 AF          0013*       xor a ; load buffer
041796 32 AE 17 04 0014*       ld (@bufferId+2),a
04179A 21 A9 17 04 0015*       ld hl,@cmd0
04179E 01 08 00 00 0016*       ld bc,@end0-@cmd0
0417A2 5B DF       0017*       rst.lil $18
0417A4             0018*   ; send the buffer data
0417A4 C1          0019*       pop bc ; length of data
0417A5 E1          0020*       pop hl ; pointer to data (was de)
0417A6 5B DF       0021*       rst.lil $18 ; send it
0417A8 C9          0022*       ret
0417A9             0023*   ; command string data
0417A9 17 00 A0    0024*   @cmd0:      db 23,0,0xA0
0417AC 00 00       0025*   @bufferId:	dw 0x0000
0417AE 00          0026*               db 0 ; load buffer
0417AF 00 00       0027*   @length:	dw 0x0000
0417B1 00          0028*   @end0:      db 0x00 ; padding
0417B2             0029*   ; end vdu_write_block_to_buffer
0417B2             0030*   
0417B2             0031*   ; Command 1: Call a buffer
0417B2             0032*   ; VDU 23, 0, &A0, bufferId; 1
0417B2             0033*   ; inputs: hl = bufferId
0417B2             0034*   vdu_call_buffer:
0417B2 22 CA 17 04 0035*       ld (@bufferId),hl
0417B6 3E 01       0036*       ld a,1 ; call buffer
0417B8 32 CC 17 04 0037*       ld (@bufferId+2),a
0417BC 21 C7 17 04 0038*       ld hl,@cmd
0417C0 01 06 00 00 0039*       ld bc,@end-@cmd
0417C4 5B DF       0040*       rst.lil $18
0417C6 C9          0041*       ret
0417C7 17 00 A0    0042*   @cmd:     db 23,0,0xA0
0417CA 00 00       0043*   @bufferId: dw 0x0000
0417CC 01          0044*              db 1 ; call buffer
0417CD             0045*   @end:
0417CD             0046*   ; end vdu_call_buffer
0417CD             0047*   
0417CD             0048*   ; Command 2: Clear a buffer
0417CD             0049*   ; VDU 23, 0 &A0, bufferId; 2
0417CD             0050*   ; inputs: hl = bufferId
0417CD             0051*   vdu_clear_buffer:
0417CD 22 E5 17 04 0052*       ld (@bufferId),hl
0417D1 3E 02       0053*       ld a,2 ; clear buffer
0417D3 32 E7 17 04 0054*       ld (@bufferId+2),a
0417D7 21 E2 17 04 0055*       ld hl,@cmd
0417DB 01 06 00 00 0056*       ld bc,@end-@cmd
0417DF 5B DF       0057*       rst.lil $18
0417E1 C9          0058*       ret
0417E2 17 00 A0    0059*   @cmd:     db 23,0,0xA0
0417E5 00 00       0060*   @bufferId: dw 0x0000
0417E7 02          0061*              db 2 ; clear buffer
0417E8             0062*   @end:
0417E8             0063*   ; end vdu_clear_buffer
0417E8             0064*   
0417E8             0065*   ; Clear all buffers
0417E8             0066*   ; inputs: none
0417E8             0067*   vdu_clear_all_buffers:
0417E8             0068*   ; clear all buffers
0417E8 21 F3 17 04 0069*       ld hl,@beg
0417EC 01 06 00 00 0070*       ld bc,@end-@beg
0417F0 5B DF       0071*       rst.lil $18
0417F2 C9          0072*       ret
0417F3 17 00 A0    0073*   @beg: db 23,0,$A0
0417F6 FF FF       0074*         dw -1 ; bufferId -1 (65535) means clear all buffers
0417F8 02          0075*         db 2  ; command 2: clear a buffer
0417F9             0076*   @end:
0417F9             0077*   ; end vdu_clear_all_buffers
0417F9             0078*   
0417F9             0079*   ; Command 3: Create a writeable buffer
0417F9             0080*   ; VDU 23, 0 &A0, bufferId; 3, length;
0417F9             0081*   ; inputs: hl = bufferId, bc = length
0417F9             0082*   vdu_create_writeable_buffer:
0417F9 22 16 18 04 0083*       ld (@bufferId),hl
0417FD ED 43 19 18 0084*       ld (@length),bc
       04          
041802 3E 03       0085*       ld a,3 ; create writeable buffer
041804 32 18 18 04 0086*       ld (@bufferId+2),a
041808 21 13 18 04 0087*       ld hl,@cmd
04180C 01 08 00 00 0088*       ld bc,@end-@cmd
041810 5B DF       0089*       rst.lil $18
041812 C9          0090*       ret
041813 17 00 A0    0091*   @cmd:     db 23,0,0xA0
041816 00 00       0092*   @bufferId: dw 0x0000
041818 03          0093*              db 3 ; create writeable buffer
041819 00 00       0094*   @length: dw 0x0000
04181B 00          0095*   @end:     db 0x00 ; padding
04181C             0096*   ; end vdu_create_writeable_buffer
04181C             0097*   
04181C             0098*   ; Command 4: Set output stream to a buffer
04181C             0099*   ; VDU 23, 0 &A0, bufferId; 4
04181C             0100*   ; inputs: hl = bufferId
04181C             0101*   vdu_set_output_stream_buffer:
04181C 22 34 18 04 0102*       ld (@bufferId),hl
041820 3E 04       0103*       ld a,4 ; set output stream to buffer
041822 32 36 18 04 0104*       ld (@bufferId+2),a
041826 21 31 18 04 0105*       ld hl,@cmd
04182A 01 06 00 00 0106*       ld bc,@end-@cmd
04182E 5B DF       0107*       rst.lil $18
041830 C9          0108*       ret
041831 17 00 A0    0109*   @cmd:     db 23,0,0xA0
041834 00 00       0110*   @bufferId: dw 0x0000
041836 04          0111*              db 4 ; set output stream to buffer
041837 00          0112*   @end:     db 0x00 ; padding
041838             0113*   ; end vdu_set_output_stream_buffer
041838             0114*   
041838             0115*   ; Command 5: Adjust buffer contents
041838             0116*   ; VDU 23, 0, &A0, bufferId; 5, operation, offset; [count;] <operand>, [arguments]
041838             0117*   vdu_adjust_buffer:
041838 C9          0118*       ret ; TODO: implement
041839             0119*   ; end vdu_adjust_buffer
041839             0120*   
041839             0121*   ; Command 6: Conditionally call a buffer
041839             0122*   ; VDU 23, 0, &A0, bufferId; 6, operation, checkBufferId; checkOffset; [arguments]
041839             0123*   vdu_call_buffer_conditional:
041839 C9          0124*       ret ; TODO: implement
04183A             0125*   ; end vdu_call_buffer_conditional
04183A             0126*   
04183A             0127*   ; Command 7: Jump to a buffer
04183A             0128*   ; VDU 23, 0, &A0, bufferId; 7
04183A             0129*   ; inputs: hl = bufferId
04183A             0130*   vdu_jump_to_buffer:
04183A 22 52 18 04 0131*       ld (@bufferId),hl
04183E 3E 07       0132*       ld a,7 ; jump to buffer
041840 32 54 18 04 0133*       ld (@bufferId+2),a
041844 21 4F 18 04 0134*       ld hl,@cmd
041848 01 06 00 00 0135*       ld bc,@end-@cmd
04184C 5B DF       0136*       rst.lil $18
04184E C9          0137*       ret
04184F 17 00 A0    0138*   @cmd:     db 23,0,0xA0
041852 00 00       0139*   @bufferId: dw 0x0000
041854 07          0140*              db 7 ; jump to buffer
041855 00          0141*   @end:     db 0x00 ; padding
041856             0142*   ; end vdu_jump_to_buffer
041856             0143*   
041856             0144*   ; Command 8: Conditional Jump to a buffer
041856             0145*   ; VDU 23, 0, &A0, bufferId; 8, operation, checkBufferId; checkOffset; [arguments]
041856             0146*   vdu_jump_to_buffer_conditional:
041856 C9          0147*       ret ; TODO: implement
041857             0148*   ; end vdu_jump_to_buffer_conditional
041857             0149*   
041857             0150*   ; Command 9: Jump to an offset in a buffer
041857             0151*   ; VDU 23, 0, &A0, bufferId; 9, offset; offsetHighByte, [blockNumber;]
041857             0152*   vdu_jump_to_buffer_offset:
041857 C9          0153*       ret ; TODO: implement
041858             0154*   ; end vdu_jump_to_buffer_offset
041858             0155*   
041858             0156*   ; Command 10: Conditional jump to an offset in a buffer
041858             0157*   ; VDU 23, 0, &A0, bufferId; 10, offset; offsetHighByte, [blockNumber;] [arguments]
041858             0158*   vdu_jump_to_buffer_offset_conditional:
041858 C9          0159*       ret ; TODO: implement
041859             0160*   ; end vdu_jump_to_buffer_offset_conditional
041859             0161*   
041859             0162*   ; Command 11: Call buffer with an offset
041859             0163*   ; VDU 23, 0, &A0, bufferId; 11, offset; offsetHighByte, [blockNumber;]
041859             0164*   vdu_call_buffer_offset:
041859 C9          0165*       ret ; TODO: implement
04185A             0166*   ; end vdu_call_buffer_offset
