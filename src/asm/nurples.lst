041847             0042        include "vdu_fonts.inc"
041847             0001*   ; select font
041847             0002*   ; inputs: hl = bufferId, a = font flags
041847             0003*   ; Flags:
041847             0004*   ; Bit	Description
041847             0005*   ; 0	Adjust cursor position to ensure text baseline is aligned
041847             0006*   ;   0: Do not adjust cursor position (best for changing font on a new line)
041847             0007*   ;   1: Adjust cursor position (best for changing font in the middle of a line)
041847             0008*   ; 1-7	Reserved for future use
041847             0009*   ; VDU 23, 0, &95, 0, bufferId; flags: Select font
041847             0010*   vdu_font_select:
041847 22 5E 18 04 0011*       ld (@bufferId),hl
04184B 32 60 18 04 0012*       ld (@flags),a
04184F 21 5A 18 04 0013*       ld hl,@cmd
041853 01 07 00 00 0014*       ld bc,@end-@cmd
041857 5B DF       0015*       rst.lil $18
041859 C9          0016*       ret
04185A 17 00 95 00 0017*   @cmd: db 23, 0, 0x95, 0
04185E 00 00       0018*   @bufferId: dw 0x0000
041860 00          0019*   @flags: db 0x00
041861             0020*   @end:
041861             0021*   
041861             0022*   ; create font from buffer
041861             0023*   ; inputs: hl = bufferId, e = width, d = height, d = ascent, a = flags
041861             0024*   ; VDU 23, 0, &95, 1, bufferId; width, height, ascent, flags: Create font from buffer
041861             0025*   vdu_font_create:
041861 22 86 18 04 0026*       ld (@bufferId),hl
041865 ED 53 88 18 0027*       ld (@width),de ; also loads height
       04          
04186A 32 8B 18 04 0028*       ld (@flags),a
04186E 7A          0029*       ld a,d ; height
04186F 32 8A 18 04 0030*       ld (@ascent),a ; ascent = height
041873             0031*   ; consolidate buffer
041873 CD 9C 15 04 0032*       call vdu_consolidate_buffer
041877             0033*   ; create font
041877 21 82 18 04 0034*       ld hl,@cmd
04187B 01 0A 00 00 0035*       ld bc,@end-@cmd
04187F 5B DF       0036*       rst.lil $18
041881 C9          0037*       ret
041882 17 00 95 01 0038*   @cmd: db 23, 0, 0x95, 1
041886 00 00       0039*   @bufferId: dw 0x0000
041888 00          0040*   @width: db 0x00
041889 00          0041*   @height: db 0x00
04188A 00          0042*   @ascent: db 0x00
04188B 00          0043*   @flags: db 0x00
04188C             0044*   @end:
04188C             0045*   
04188C             0046*   ; set or adjust font property
04188C             0047*   ; inputs: hl = bufferId, a = field, de = value
04188C             0048*   ; VDU 23, 0, &95, 2, bufferId; field, value;: Set or adjust font property
04188C             0049*   vdu_font_property:
04188C 22 A8 18 04 0050*       ld (@bufferId),hl
041890 32 AA 18 04 0051*       ld (@field),a
041894 ED 53 AB 18 0052*       ld (@value),de
       04          
041899 21 A4 18 04 0053*       ld hl,@cmd
04189D 01 09 00 00 0054*       ld bc,@end-@cmd
0418A1 5B DF       0055*       rst.lil $18
0418A3 C9          0056*       ret
0418A4 17 00 95 02 0057*   @cmd: db 23, 0, 0x95, 2
0418A8 00 00       0058*   @bufferId: dw 0x0000
0418AA 00          0059*   @field: db 0x00
0418AB 00 00       0060*   @value: dw 0x0000
0418AD 00          0061*   @end: db 0x00 ; padding
0418AE             0062*   
0418AE             0063*   ; VDU 23, 0, &95, 3, bufferId; [<args>]: Reserved
0418AE             0064*   
0418AE             0065*   ; Clear/Delete font
0418AE             0066*   ; inputs: hl = bufferId
0418AE             0067*   ; VDU 23, 0, &95, 4, bufferId;: Clear/Delete font
0418AE             0068*   vdu_font_clear:
0418AE 22 C1 18 04 0069*       ld (@bufferId),hl
0418B2 21 BD 18 04 0070*       ld hl,@cmd
0418B6 01 06 00 00 0071*       ld bc,@end-@cmd
0418BA 5B DF       0072*       rst.lil $18
0418BC C9          0073*       ret
0418BD 17 00 95 04 0074*   @cmd: db 23, 0, 0x95, 4
0418C1 00 00       0075*   @bufferId: dw 0x0000
0418C3 00          0076*   @end: db 0x00 ; padding
0418C4             0077*   
0418C4             0078*   ; Copy system font to buffer
0418C4             0079*   ; inputs: hl = bufferId
0418C4             0080*   ; VDU 23, 0, &95, 5, bufferId;: Copy system font to buffer
0418C4             0081*   vdu_font_copy_system:
0418C4 22 D7 18 04 0082*       ld (@bufferId),hl
0418C8 21 D3 18 04 0083*       ld hl,@cmd
0418CC 01 06 00 00 0084*       ld bc,@end-@cmd
0418D0 5B DF       0085*       rst.lil $18
