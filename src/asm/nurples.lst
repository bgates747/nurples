047B9B             0023*   ; other specific initialization
047B9B CD 14 05 04 0024*       call rand_8     ; snag a random number
047B9F E6 1F       0025*       and %00011111 ; keep only 5 lowest bits (max 31)
047BA1 DD 77 24    0026*       ld (ix+tile_move_timer),a ; when this hits zero,will spawn a seeker
047BA4 C9          0027*       ret
