0460C4             0195*   player_dying:
0460C4             0196*   ; This actor update is deliberately bounded to one frame. The global playing
0460C4             0197*   ; loop, not the actor, advances enemies, explosions, tiles, and VBlank.
0460C4 CD CF 65 04 0198*       call player_move_weapons
0460C8 3A 4C 5F 04 0199*       ld a,(player_dying_phase)
0460CC B7          0200*       or a
0460CD CA F2 60 04 0201*       jp z,@initial
0460D1 FE 01       0202*       cp player_dying_phase_delay
0460D3 CA 39 61 04 0203*       jp z,@delay
0460D7 FE 02       0204*       cp player_dying_phase_finale
0460D9 CA 51 61 04 0205*       jp z,@finale
0460DD             0206*   ; Finish only after the finale explosions have had their full lifetime.
0460DD 3A 4D 5F 04 0207*       ld a,(player_dying_timer)
0460E1 3C          0208*       inc a
0460E2 32 4D 5F 04 0209*       ld (player_dying_timer),a
0460E6 FE 29       0210*       cp explosion_lifetime_updates
0460E8 D8          0211*       ret c
0460E9 21 9F 61 04 0212*       ld hl,player_dead
0460ED 22 47 5F 04 0213*       ld (player_state),hl
0460F1 C9          0214*       ret
0460F2             0215*   
0460F2             0216*   @initial:
0460F2             0217*   ; Preserve the old cadence: one rising explosion every sixteen outer frames.
0460F2 3A 4D 5F 04 0218*       ld a,(player_dying_timer)
0460F6 B7          0219*       or a
0460F7 C2 1A 61 04 0220*       jp nz,@tick_initial
0460FB CD AE 4C 04 0221*       call spawn_explosion_player
0460FF D2 11 61 04 0222*       jp nc,@initial_spawned
046103 21 00 00 00 0223*       ld hl,0
046107 DD 2F 07    0224*       ld (ix+sprite_xvel),hl
04610A 21 00 01 00 0225*       ld hl,1*256
04610E DD 2F 0A    0226*       ld (ix+sprite_yvel),hl
046111             0227*   @initial_spawned:
046111 3A 4E 5F 04 0228*       ld a,(player_dying_spawns)
046115 3C          0229*       inc a
046116 32 4E 5F 04 0230*       ld (player_dying_spawns),a
04611A             0231*   @tick_initial:
04611A 3A 4D 5F 04 0232*       ld a,(player_dying_timer)
04611E 3C          0233*       inc a
04611F E6 0F       0234*       and 15
046121 32 4D 5F 04 0235*       ld (player_dying_timer),a
046125 C0          0236*       ret nz
046126 3A 4E 5F 04 0237*       ld a,(player_dying_spawns)
04612A FE 10       0238*       cp 16
04612C D8          0239*       ret c
04612D 3E 01       0240*       ld a,player_dying_phase_delay
04612F 32 4C 5F 04 0241*       ld (player_dying_phase),a
046133 AF          0242*       xor a
046134 32 4E 5F 04 0243*       ld (player_dying_spawns),a
046138 C9          0244*       ret
046139             0245*   
046139             0246*   @delay:
046139 3A 4D 5F 04 0247*       ld a,(player_dying_timer)
04613D 3C          0248*       inc a
04613E 32 4D 5F 04 0249*       ld (player_dying_timer),a
046142 FE 10       0250*       cp 16
046144 D8          0251*       ret c
046145 AF          0252*       xor a
046146 32 4D 5F 04 0253*       ld (player_dying_timer),a
04614A 3E 02       0254*       ld a,player_dying_phase_finale
04614C 32 4C 5F 04 0255*       ld (player_dying_phase),a
046150 C9          0256*       ret
046151             0257*   
046151             0258*   @finale:
046151             0259*   ; Spread allocations across frames so pool pressure can never turn this actor
046151             0260*   ; into a blocking burst. Allocation failure remains a harmless skipped effect.
046151 CD AE 4C 04 0261*       call spawn_explosion_player
046155 D2 67 61 04 0262*       jp nc,@finale_spawned
046159 CD 7F 61 04 0263*       call @rand
04615D DD 2F 07    0264*       ld (ix+sprite_xvel),hl
046160 CD 7F 61 04 0265*       call @rand
046164 DD 2F 0A    0266*       ld (ix+sprite_yvel),hl
