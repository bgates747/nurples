049E45             0086        include "timer_jukebox.inc"
049E45             0001*   ps_prt_reload: equ [72000/2]+1 ; 2 ticks per second at 18.432 MHz with a 256 clock divider
049E45             0002*   
049E45             0003*   ; start PRT timer
049E45             0004*   ps_prt_start:
049E45 21 00 00 00 0005*       ld hl,0
049E49 22 84 9E 04 0006*       ld (ps_prt_irq_counter),hl
049E4D 21 A1 8C 00 0007*       ld hl,ps_prt_reload
049E51 ED 29 84    0008*       out0 (TMR1_CTL+TMR_RES_LOW),l
049E54 ED 21 85    0009*   	out0 (TMR1_CTL+TMR_RES_HIGH),h
049E57             0010*   ; disable timer (in effect, reset it)
049E57 3E 0E       0011*       ld a,PRT_IRQ_0 | IRQ_EN_0 | PRT_MODE_0 | CLK_DIV_256 | RST_EN_1 | PRT_EN_0
049E59 ED 39 83    0012*   	out0 (TMR1_CTL+TMR_REG_CTL),a
049E5C             0013*   ; enable timer,with interrupt and CONTINUOUS mode,clock divider 256
049E5C 3E 5F       0014*       ld a,PRT_IRQ_0 | IRQ_EN_1 | PRT_MODE_1 | CLK_DIV_256 | RST_EN_1 | PRT_EN_1
049E5E ED 39 83    0015*   	out0 (TMR1_CTL+TMR_REG_CTL),a
049E61 C9          0016*       ret
049E62             0017*   
049E62             0018*   ; stop PRT timer
049E62             0019*   ps_prt_stop:
049E62 3E 0E       0020*       ld a,PRT_IRQ_0 | IRQ_EN_0 | PRT_MODE_0 | CLK_DIV_256 | RST_EN_1 | PRT_EN_0
049E64 ED 39 83    0021*   	out0 (TMR1_CTL+TMR_REG_CTL),a
049E67 C9          0022*       ret
049E68             0023*   
049E68             0024*   ; ===============================================
049E68             0025*   ; PRT Timer Interrupt Handling
049E68             0026*   ; https://github.com/tomm/agon-cpu-emulator/blob/main/sdcard/regression_suite/timerirq.asm
049E68             0027*   ; -----------------------------------------------
049E68             0028*   ps_prt_irq_init:
049E68             0029*       ; set up interrupt vector table 2
049E68 21 00 00 00 0030*   	ld hl,0
049E6C 3A 0C 01 00 0031*   	ld a,($10c)
049E70 6F          0032*   	ld l,a
049E71 3A 0D 01 00 0033*   	ld a,($10d)
049E75 67          0034*   	ld h,a
049E76             0035*   
049E76             0036*   	; skip over CALL ($c3)
049E76 23          0037*   	inc hl
049E77             0038*   	; load address of jump into vector table 2 (in ram)
049E77 ED 27       0039*   	ld hl,(hl)
049E79             0040*   
049E79             0041*   	; write CALL ps_prt_irq_handler to vector table 2
049E79 3E C3       0042*   	ld a,$c3
049E7B 77          0043*   	ld (hl),a
049E7C 23          0044*   	inc hl
049E7D 11 85 9E 04 0045*   	ld de,ps_prt_irq_handler
049E81 ED 1F       0046*   	ld (hl),de
049E83             0047*   
049E83 C9          0048*       ret
049E84             0049*   ; end ps_prt_irq_init
049E84             0050*   
049E84             0051*   ; interrupt routine for playing the next sample
049E84             0052*   ps_prt_irq_counter:
049E84 00          0053*   	db 0
049E85             0054*   ps_prt_irq_handler:
049E85 F3          0055*   	di
049E86 08          0056*   	ex af,af'
049E87 D9          0057*       exx
049E88 DD E5       0058*   	push ix
049E8A FD E5       0059*   	push iy
049E8C ED 38 83    0060*   	in0 a,(TMR1_CTL+TMR_REG_CTL)
049E8F 3A 84 9E 04 0061*       ld a,(ps_prt_irq_counter)
049E93 3C          0062*       inc a
049E94 E6 01       0063*       and 1 ; modulo 2
049E96 32 84 9E 04 0064*       ld (ps_prt_irq_counter),a
049E9A CC 71 9C 04 0065*       call z,ps_play_sample
049E9E FD E1       0066*   	pop iy
049EA0 DD E1       0067*   	pop ix
049EA2 D9          0068*       exx
049EA3 08          0069*       ex af,af'
049EA4 FB          0070*   	ei
049EA5 5B ED 4D    0071*   	reti.l
049EA8             0072*   ; end ps_prt_irq_handler
049EA8             0087    
049EA8             0088    ; --- MAIN PROGRAM FILE ---
049EA8             0089    init:
049EA8             0090    ; load play sample command buffers
049EA8 CD DA 9D 04 0091        call load_command_buffer
049EAC             0092    ; initialize play sample timer interrupt handler
049EAC CD 68 9E 04 0093        call ps_prt_irq_init
049EB0 C9          0094        ret
049EB1             0095    ; end init
049EB1             0096    
049EB1             0097    main:
049EB1             0098    ; start a new game
049EB1 21 38 84 04 0099        ld hl,game_init
049EB5 22 46 83 04 0100        ld (game_state),hl
049EB9             0101    main_loop:
049EB9             0102    ; update the global timestamp
049EB9 CD 81 12 04 0103        call timestamp_tick
049EBD             0104    ; do gamestate logic
049EBD CD 49 83 04 0105        call do_game
049EC1             0106    ; wait for the next vblank mitigate flicker and for loop timing
049EC1 CD B9 13 04 0107        call vdu_vblank
049EC5             0108    ; poll keyboard for escape keypress
049EC5 3E 08       0109        ld a, $08 ; code to send to MOS
049EC7 5B CF       0110        rst.lil $08 ; get IX pointer to System Variables
049EC9 DD 7E 05    0111        ld a, (ix + $05) ; get ASCII code of key pressed
049ECC FE 1B       0112        cp 27 ; check if 27 (ascii code for ESC)
049ECE CA D6 9E 04 0113        jp z, main_end ; if pressed, jump to exit
049ED2             0114    ; escape not pressed so loop
049ED2 C3 B9 9E 04 0115        jp main_loop
049ED6             0116    
049ED6             0117    main_end:
049ED6             0118    ; restore original screen mode
049ED6 3A 37 84 04 0119        ld a,(original_screen_mode)
049EDA CD 0E 14 04 0120        call vdu_set_screen_mode
049EDE             0121    ; print thanks for playing message
049EDE CD 60 00 04 0122        call printInline
049EE2 54 68 61 6E 0123        asciz "Thank you for playing\r\n"
       6B 20 79 6F 
       75 20 66 6F 
       72 20 70 6C 
       61 79 69 6E 
       67 0D 0A 00 
049EFA 21 45 1A 04 0124        ld hl,purple_nurples_ascii
049EFE CD 67 00 04 0125        call printString
049F02 C9          0126        ret
049F03             0127    ; end main
049F03             0128    
049F03             0129    ; needs to be the final include to leave room for the sprite and tile tables
049F03             0130        include "tables.inc"
049F03             0001*   ; #### THIS IS THE SPACE ALLOCATED TO THE SPRITE TABLE ####
049F03             0002*   table_base: equ $
049F03             0003*   player_weapons_begin: equ table_base
049F03             0004*   player_lasers_begin: equ player_weapons_begin
049F03             0005*   player_lasers_end: equ table_record_size*player_lasers_max+player_lasers_begin
049F03             0006*   player_weapons_end: equ table_record_size*player_lasers_max+player_weapons_begin
049F03             0007*   player_begin: equ player_weapons_end
049F03             0008*   player_end: equ table_record_size+player_begin
049F03             0009*   enemy_sprites_begin: equ player_end
049F03             0010*   seekers_base: equ enemy_sprites_begin
049F03             0011*   seeker_min_sprite_id: equ [seekers_base-table_base]/table_record_size
049F03             0012*   seekers_end: equ table_record_size*seekers_max+seekers_base
049F03             0013*   fireballs_base: equ seekers_end
049F03             0014*   fireballs_end: equ table_record_size*fireballs_max+fireballs_base
049F03             0015*   enemy_sprites_end: equ fireballs_end
049F03             0016*   explosions_base: equ enemy_sprites_end
049F03             0017*   explosions_end: equ table_record_size*explosions_max+explosions_base
049F03             0018*   table_end: equ explosions_end
049F03             0019*   
049F03             0020*   table_num_records: equ table_end-table_base/table_record_size
049F03             0021*   table_num_enemy_records: equ enemy_sprites_end-enemy_sprites_begin/table_record_size
049F03             0022*   
049F03             0023*   ; ### THIS IS THE SPACE ALLOCATED TO THE ACTIVE TILES TABLE ###
049F03             0024*   tile_table_base: equ table_end
049F03             0025*   tile_table_end: equ 256*tile_table_record_size+tile_table_base
049F03             0026*   
049F03             0027*   ; ### THIS IS THE SPACE ALLOCATED TO JUKEBOX SONG DATA ###
049F03             0028*   song_data: equ tile_table_end
