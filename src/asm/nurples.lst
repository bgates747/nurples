044005             0841*   ; Calculate the expected RGBA2222 payload size.
044005             0842*   ; inputs:  width and height in agnb_metadata
044005             0843*   ; outputs: HL = width * height (unsigned 24-bit)
044005             0844*   ;          u32 result retained in agnb_expected_data_size
044005             0845*   ; destroys: AF, HL
044005             0846*   ;
044005             0847*   ; IMPORTANT: umul24 discards product bits above bit 23. That theoretical limit
044005             0848*   ; is 16,777,215 bytes/pixels--orders of magnitude larger than any conceivable
044005             0849*   ; bitmap on the Agon. The initial image loader therefore deliberately uses the
044005             0850*   ; smaller native-ADL result instead of carrying a general u16*u16=u32 routine.
044005             0851*   agnb_calculate_image_data_size:
044005             0852*   ; Load each contiguous u16 field as UHL, then use the established eZ80 idiom
044005             0853*   ; to discard the accidentally loaded following byte.
