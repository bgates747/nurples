04225C             0051        include "explosion.inc"
04225C             0001*   explosions_max: equ 8
04225C             0002*   explosion_animation_count: equ 5
04225C             0003*   explosion_animation_ticks: equ 8
04225C             0004*   ; One update clears the just-spawned flag, then every animation frame runs for
04225C             0005*   ; explosion_animation_ticks updates.
04225C             0006*   explosion_lifetime_updates: equ explosion_animation_count*explosion_animation_ticks+1
04225C             0007*   explosion_defaults:
04225C 04          0008*       db explosion            ; type
04225D 09 01 00    0009*       dl BUF_EXPLOSION_A	    ; base_bufferId
042260 D9 22 04    0010*       dl move_explosion	    ; move_program
042263 40          0011*       db %01000000            ; collisions bit 6 signals sprite alive
042264 07          0012*       db 7	                ; dim_x
