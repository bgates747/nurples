048DD8 FD 77 28    0044*       ld (iy+tile_frame),a
048DDB C9          0045*       ret
048DDC             0046*   ; end move_crater
048DDC             0077        include "tile_electrode.inc"
048DDC             0001*   electrode_defaults:
048DDC 09          0002*       db 9                    ; type
