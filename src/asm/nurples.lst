044B45 D5          0087*       push de
044B46 CD 03 1A 04 0088*       call vdu_sprite_select
044B4A CD 16 1A 04 0089*       call vdu_sprite_clear_frames
044B4E 21 0E 01 00 0090*       ld hl,BUF_FIREBALL_2_000
044B52 06 40       0091*       ld b,2*32 ; 2 animations * 32 orientations
044B54             0092*   @frames_loop:
044B54 C5          0093*       push bc
044B55 E5          0094*       push hl
044B56 CD 58 1B 04 0095*       call vdu_sprite_add_buff
044B5A E1          0096*       pop hl
044B5B 23          0097*       inc hl
044B5C C1          0098*       pop bc
044B5D 10 F5       0099*       djnz @frames_loop
044B5F D1          0100*       pop de ; sprite loop counter
044B60 F1          0101*       pop af ; sprite id
044B61 3C          0102*       inc a
044B62 1D          0103*       dec e
044B63 C2 44 4B 04 0104*       jp nz,@sprites_loop
044B67 C9          0105*       ret
