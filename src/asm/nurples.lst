04209D 3A C5 80 04 0053*       ld a,(sprite_screen_edge)
0420A1 B7          0054*       or a ; a will be non-zero if have scrolled off screen
0420A2 C2 0B 81 04 0055*       jp nz,table_deactivate_sprite
0420A6 DD 21 9E 9C 0056*       ld ix,player_begin
       04          
0420AB DD CB 1D 76 0057*       bit sprite_alive,(ix+sprite_collisions)
