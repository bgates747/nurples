048C60             0085        include "runtime_init.inc"
048C60             0001*   ; Process-entry initialization
048C60             0002*   ; ============================
048C60             0003*   ;
048C60             0004*   ; MOS RUN re-enters the resident binary; it does not restore DB/DL initializers.
048C60             0005*   ; Only state whose lifetime is one application invocation belongs here. Session,
048C60             0006*   ; level, life, table, loader, and arithmetic scratch state is initialized by its
048C60             0007*   ; owning routine before first use.
048C60             0008*   
048C60             0009*   runtime_process_init:
048C60             0010*   ; Process control bytes are ordinary resident RAM. Reset them explicitly on
048C60             0011*   ; every MOS RUN instead of relying on their assembled DB values.
048C60 AF          0012*       xor a
048C61 32 BA 6B 04 0013*       ld (game_exit_requested),a
048C65 32 9F 5F 04 0014*       ld (player_event),a
048C69 32 A1 5F 04 0015*       ld (player_dying_phase),a
048C6D 32 A2 5F 04 0016*       ld (player_dying_timer),a
048C71 32 A3 5F 04 0017*       ld (player_dying_spawns),a
048C75             0018*   
048C75             0019*   ; Diagnostic latches describe this invocation only.
048C75 32 B9 6B 04 0020*       ld (game_fault_flags),a
048C79 32 37 4A 04 0021*       ld (enemies_fault_flags),a
048C7D 32 A0 5F 04 0022*       ld (player_fault_flags),a
048C81 32 C0 67 04 0023*       ld (sprite_fault_flags),a
048C85 32 72 74 04 0024*       ld (tile_fault_flags),a
048C89 32 77 13 04 0025*       ld (timer_fault_flags),a
048C8D 32 3E 14 04 0026*       ld (vdu_timing_fault_flags),a
048C91             0027*   
048C91             0028*   ; Small persistent helpers that otherwise inherit their previous RUN values.
048C91 32 68 4B 04 0029*       ld (seekers_count),a
048C95 32 BF 67 04 0030*       ld (sprite_screen_edge),a
048C99 32 78 13 04 0031*       ld (oldTimeStamp),a
048C9D 21 00 00 00 0032*       ld hl,0
048CA1 22 4A 05 04 0033*       ld (seed1),hl
048CA5 22 4D 05 04 0034*       ld (seed2),hl
048CA9             0035*   
048CA9             0036*   ; Publish valid dispatcher states before the first tick. Their owning init
048CA9             0037*   ; routines will republish the same operational states after resources exist.
048CA9 21 30 6D 04 0038*       ld hl,game_init
048CAD 22 B6 6B 04 0039*       ld (game_state),hl
048CB1 21 94 4A 04 0040*       ld hl,enemies_alive
048CB5 22 34 4A 04 0041*       ld (enemies_state),hl
048CB9 21 E2 60 04 0042*       ld hl,player_alive
048CBD 22 9C 5F 04 0043*       ld (player_state),hl
048CC1             0044*   
048CC1             0045*   ; Restore the documented random seed and establish a current clock baseline.
048CC1 3E 50       0046*       ld a,$50
048CC3 32 28 05 04 0047*       ld (r_seed),a
048CC7 CD AF 12 04 0048*       call timestamp_init
048CCB C9          0049*       ret
048CCC             0050*   ; end runtime_process_init
048CCC             0086    
048CCC             0087    ; --- MAIN PROGRAM FILE ---
048CCC             0088    main:
048CCC             0089    ; Invalidate and rebuild the public observer record before touching any other
048CCC             0090    ; resident process state. MOS RUN does not reload initialized data.
048CCC CD 52 88 04 0091        call telemetry_init
048CD0 CD 60 8C 04 0092        call runtime_process_init
048CD4             0093    ; Capture the caller's display mode exactly once, before game_init changes VDP
048CD4             0094    ; state. In-process restarts must not replace this with the gameplay mode.
048CD4 CD 11 15 04 0095        call vdu_get_screen_mode
048CD8 32 2C 6D 04 0096        ld (original_screen_mode),a
048CDC             0097    ; MODE destroys VDP contexts, but the current logical text colours are exposed
048CDC             0098    ; through the MOS screen-pixel result packet. Preserve each value independently
048CDC             0099    ; so a failed VDP query degrades to the explicit white-on-black handoff.
048CDC AF          0100        xor a
048CDD 32 2F 6D 04 0101        ld (original_text_colours_valid),a
048CE1 3E 80       0102        ld a,128
048CE3 CD 3F 14 04 0103        call vdu_get_text_colour
048CE7 D2 F9 8C 04 0104        jp nc,@capture_background
048CEB 32 2D 6D 04 0105        ld (original_text_foreground),a
048CEF 3A 2F 6D 04 0106        ld a,(original_text_colours_valid)
048CF3 F6 01       0107        or %00000001
048CF5 32 2F 6D 04 0108        ld (original_text_colours_valid),a
048CF9             0109    @capture_background:
048CF9 3E 81       0110        ld a,129
048CFB CD 3F 14 04 0111        call vdu_get_text_colour
048CFF D2 11 8D 04 0112        jp nc,@capture_complete
048D03 32 2E 6D 04 0113        ld (original_text_background),a
048D07 3A 2F 6D 04 0114        ld a,(original_text_colours_valid)
048D0B F6 02       0115        or %00000010
048D0D 32 2F 6D 04 0116        ld (original_text_colours_valid),a
048D11             0117    @capture_complete:
048D11             0118    main_loop:
048D11             0119    ; update the global timestamp
048D11 CD C7 12 04 0120        call timestamp_tick
048D15             0121    ; do gamestate logic
048D15 CD BB 6B 04 0122        call do_game
048D19             0123    ; state handlers return through the dispatcher; honor an orderly exit request
048D19 3A BA 6B 04 0124        ld a,(game_exit_requested)
048D1D B7          0125        or a
048D1E C2 3B 8D 04 0126        jp nz,@state_exit
048D22             0127    ; wait for the next vblank mitigate flicker and for loop timing
048D22 CD 8F 14 04 0128        call vdu_vblank
048D26             0129    ; poll keyboard for escape keypress
048D26 3E 08       0130        ld a, $08 ; code to send to MOS
048D28 5B CF       0131        rst.lil $08 ; get IX pointer to System Variables
048D2A DD 7E 05    0132        ld a, (ix + $05) ; get ASCII code of key pressed
048D2D FE 1B       0133        cp 27 ; check if 27 (ascii code for ESC)
048D2F CA 47 8D 04 0134        jp z,@escape
048D33 CD E7 88 04 0135        call telemetry_tick
048D37             0136    ; escape not pressed so loop
048D37 C3 11 8D 04 0137        jp main_loop
048D3B             0138    
048D3B             0139    @state_exit:
048D3B CD 45 88 04 0140        call telemetry_request_exit
048D3F CD ED 88 04 0141        call telemetry_publish_terminal
048D43 C3 53 8D 04 0142        jp main_end
048D47             0143    @escape:
048D47 CD 45 88 04 0144        call telemetry_request_exit
048D4B CD E7 88 04 0145        call telemetry_tick
048D4F C3 53 8D 04 0146        jp main_end
048D53             0147    
048D53             0148    main_end:
048D53             0149    ; Release application-owned VDP state. Select the permanent system font before
048D53             0150    ; deleting the custom-font buffer, and detach sprites before their bitmaps.
048D53 21 FF FF 00 0151        ld hl,65535
048D57 AF          0152        xor a
048D58 CD AF 18 04 0153        call vdu_font_select
048D5C CD 37 1B 04 0154        call vdu_sprite_reset
048D60 CD 3D 18 04 0155        call vdu_clear_all_buffers
048D64             0156    ; restore original screen mode
048D64 3A 2C 6D 04 0157        ld a,(original_screen_mode)
048D68 CD 00 15 04 0158        call vdu_set_screen_mode
048D6C             0159    ; MODE resets the context. Reassert a permanent font and deterministic farewell
048D6C             0160    ; colours explicitly: white text on a freshly cleared black text background.
048D6C CD 9B 13 04 0161        call vdu_select_text_cursor
048D70 21 FF FF 00 0162        ld hl,65535
048D74 AF          0163        xor a
048D75 CD AF 18 04 0164        call vdu_font_select
048D79 3E 80       0165        ld a,c_black+128
048D7B CD FB 13 04 0166        call vdu_colour_text
048D7F 3E 0F       0167        ld a,c_white
048D81 CD FB 13 04 0168        call vdu_colour_text
048D85 CD CA 13 04 0169        call vdu_cls
048D89 CD 7F 13 04 0170        call vdu_cursor_on
048D8D CD 5C 00 04 0171        call printInline
048D91 54 68 61 6E 0172        asciz "Thank you for playing\r\n"
       6B 20 79 6F 
       75 20 66 6F 
       72 20 70 6C 
       61 79 69 6E 
       67 0D 0A 00 
048DA9 21 51 44 04 0173        ld hl,purple_nurples_ascii
048DAD CD 63 00 04 0174        call printString
048DB1             0175    ; Leave subsequent MOS text using the caller's logical colours when the VDP
048DB1             0176    ; reported them. The already-rendered farewell remains white on black.
048DB1 3A 2F 6D 04 0177        ld a,(original_text_colours_valid)
048DB5 CB 4F       0178        bit 1,a
048DB7 CA C5 8D 04 0179        jp z,@restore_foreground
048DBB 3A 2E 6D 04 0180        ld a,(original_text_background)
048DBF F6 80       0181        or 128
048DC1 CD FB 13 04 0182        call vdu_colour_text
048DC5             0183    @restore_foreground:
048DC5 3A 2F 6D 04 0184        ld a,(original_text_colours_valid)
048DC9 CB 47       0185        bit 0,a
048DCB CA D7 8D 04 0186        jp z,@display_restored
048DCF 3A 2D 6D 04 0187        ld a,(original_text_foreground)
048DD3 CD FB 13 04 0188        call vdu_colour_text
048DD7             0189    @display_restored:
048DD7 C9          0190        ret
048DD8             0191    ; end main
