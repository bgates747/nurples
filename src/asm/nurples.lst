0485D2 FD 77 28    0579*       ld (iy+sprite_frame),a
0485D5 C9          0580*       ret
0485D6             0581*   ; end sprite_frame_heading
0485D6             0582*   
0485D6             0583*   ; load a sprite with animation bitmaps
0485D6             0584*   ; inputs: a = sprite id, hl = base bufferId, bc = number of frames, sprite_select
0485D6             0585*   sprite_load_frames:
0485D6             0586*   ; back up input parameters
0485D6 E5          0587*       push hl ; base bufferId
0485D7 C5          0588*       push bc ; bc = number of frames
0485D8 CD 57 19 04 0589*       call vdu_sprite_clear_frames
0485DC C1          0590*       pop bc ; bc = number of frames
0485DD E1          0591*       pop hl ; = base bufferId
0485DE             0592*   @load_frames:
0485DE C5          0593*       push bc ; back up loop counter
0485DF E5          0594*       push hl ; back up base bufferId
0485E0 CD 99 1A 04 0595*       call vdu_sprite_add_buff
0485E4 E1          0596*       pop hl ; restore base bufferId
0485E5 23          0597*       inc hl ; bump it to the next frame
0485E6             0598*   ; decrement loop counter
0485E6 C1          0599*       pop bc
0485E7 0B          0600*       dec bc
0485E8 79          0601*       ld a,c
0485E9 B7          0602*       or a
0485EA C2 DE 85 04 0603*       jp nz,@load_frames
0485EE 78          0604*       ld a,b
0485EF B7          0605*       or a
0485F0 C2 DE 85 04 0606*       jp nz,@load_frames
0485F4 C9          0607*       ret
0485F5             0608*   ; end sprite_load_frames
