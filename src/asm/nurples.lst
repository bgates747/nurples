04861A             0071        include "targeting.inc"
04861A             0001*   ; compute orientation to player
04861A             0002*   ; based on relative positions
04861A             0003*   ; returns: uh.l 16.8 fixed angle256 to player
04861A             0004*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
04861A             0005*   ;    representing delta-x/y *to* target respectively
04861A             0006*   ; inputs: iy pointed at sprite record
04861A             0007*   ; destroys: everything except iy (sprite record pointer)
04861A             0008*   orientation_to_player:
04861A DD 21 9E 9C 0009*       ld ix,player_begin
       04          
04861F             0010*   ; compute dx
04861F DD 27 01    0011*       ld hl,(ix+sprite_x)
048622 FD 17 01    0012*       ld de,(iy+sprite_x)
048625 B7          0013*       or a ; clear carry
048626 ED 52       0014*       sbc hl,de ; dx
048628 E5          0015*       push hl ; save dx
048629             0016*   ; compute dy
048629 DD 27 04    0017*       ld hl,(ix+sprite_y)
04862C FD 17 04    0018*       ld de,(iy+sprite_y)
04862F B7          0019*       or a ; clear carry
048630 ED 52       0020*       sbc hl,de ; dy
048632 EB          0021*       ex de,hl ; de = dy
048633             0022*   ; compute angle to player
048633 C1          0023*       pop bc ; dx (was hl)
048634 C5          0024*       push bc ; save dx
048635 D5          0025*       push de ; save dy
048636 CD F0 07 04 0026*       call atan2_168fast ; uh.l = angle to player
04863A 3E E0       0027*       ld a,%11100000
04863C A5          0028*       and l ; round angle to nearest 32th of a circle
04863D 6F          0029*       ld l,a
04863E 22 8F 86 04 0030*       ld (Bearing_t),hl ; return angle to player
048642 D1          0031*       pop de ; restore dy
048643 C1          0032*       pop bc ; restore dx
048644 C9          0033*       ret
048645             0034*   ; end orientation_to_player
048645             0035*   
048645             0036*   ; compute orientation to player
048645             0037*   ; based on relative positions
048645             0038*   ; returns: uh.l 16.8 fixed angle256 to player
048645             0039*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
048645             0040*   ;    representing delta-x/y *to* target respectively
048645             0041*   ; inputs: iy pointed at tile record
048645             0042*   ; destroys: everything except iy (tile record pointer)
048645             0043*   tile_orientation_to_player:
048645 DD 21 9E 9C 0044*       ld ix,player_begin
       04          
04864A             0045*   ; compute dx
04864A DD 27 01    0046*       ld hl,(ix+sprite_x)
04864D FD 17 01    0047*       ld de,(iy+tile_x)
048650 B7          0048*       or a ; clear carry
048651 ED 52       0049*       sbc hl,de ; dx
048653 E5          0050*       push hl ; save dx
048654             0051*   ; compute dy
048654 DD 27 04    0052*       ld hl,(ix+sprite_y)
048657 FD 17 04    0053*       ld de,(iy+tile_y)
04865A B7          0054*       or a ; clear carry
04865B ED 52       0055*       sbc hl,de ; dy
04865D EB          0056*       ex de,hl ; de = dy
04865E             0057*   ; compute angle to player
04865E C1          0058*       pop bc ; dx (was hl)
04865F CD F0 07 04 0059*       call atan2_168fast ; uh.l = angle to player
048663 3E E0       0060*       ld a,%11100000
048665 A5          0061*       and l ; round angle to nearest 32th of a circle
048666 6F          0062*       ld l,a
048667 22 8F 86 04 0063*       ld (Bearing_t),hl
04866B C9          0064*       ret
04866C             0065*   ; end tile_orientation_to_player
04866C             0066*   
04866C             0067*   ; compute orientation to coordinate
04866C             0068*   ; based on relative positions
04866C             0069*   ; returns: uh.l 16.8 fixed angle256 to coordinate
04866C             0070*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
04866C             0071*   ;    representing delta-x/y *to* target respectively
04866C             0072*   ; inputs: iy pointed at sprite record, ub.c,ud.e are target x,y coordinates
04866C             0073*   ; destroys: everything except iy (sprite record pointer)
04866C             0074*   bearing_to_coord:
04866C             0075*   ; compute dx
04866C C5          0076*       push bc
04866D E1          0077*       pop hl
04866E FD 07 01    0078*       ld bc,(iy+sprite_x)
048671 B7          0079*       or a ; clear carry
048672 ED 42       0080*       sbc hl,bc ; dx
048674 E5          0081*       push hl ; save dx
048675             0082*   ; compute dy
048675 EB          0083*       ex de,hl
048676 FD 17 04    0084*       ld de,(iy+sprite_y)
048679 B7          0085*       or a ; clear carry
04867A ED 52       0086*       sbc hl,de ; dy
04867C EB          0087*       ex de,hl ; de = dy
04867D             0088*   ; compute angle to coordinate
04867D C1          0089*       pop bc ; dx (was hl)
04867E C5          0090*       push bc ; save dx
04867F D5          0091*       push de ; save dy
048680 CD F0 07 04 0092*       call atan2_168fast ; uh.l = angle to coordinate
048684 3E E0       0093*       ld a,%11100000
048686 A5          0094*       and l ; round angle to nearest 32th of a circle
048687 6F          0095*       ld l,a
048688 22 8F 86 04 0096*       ld (Bearing_t),hl ; return angle to coordinate
04868C D1          0097*       pop de ; restore dy
04868D C1          0098*       pop bc ; restore dx
04868E C9          0099*       ret
04868F             0100*   ; end bearing_to_coord
04868F             0101*   
04868F             0102*   ; targeting_computer variables fixed 16.8 format
04868F 00 00 00    0103*   Bearing_t: dl 0x000000 ; angle to target
048692 00 00 00    0104*   Heading_t: dl 0x000000 ; angle of target motion
048695 00 00 00    0105*   Vp: dl 0x000000 ; velocity of projectile
048698 00 00 00    0106*   Vp_x: dl 0x000000 ; x component of projectile velocity
04869B 00 00 00    0107*   Vp_y: dl 0x000000 ; y component of projectile velocity
04869E 00 00 00    0108*   Vt: dl 0x000000 ; velocity of target
0486A1 00 00 00    0109*   Vt_x: dl 0x000000 ; x component of target velocity
0486A4 00 00 00    0110*   Vt_y: dl 0x000000 ; y component of target velocity
0486A7 00 00 00    0111*   Heading_p: dl 0x000000 ; angle of projectile motion
0486AA 00 00 00    0112*   lead_angle: dl 0x000000 ; lead angle
0486AD             0113*   
0486AD             0114*   ; Inputs:   Vp velocity of projectile set,
0486AD             0115*   ;           iy pointed to sprite record,
0486AD             0116*   ;           player position and velocities correctly set
0486AD             0117*   ; Outputs:  uh.l is the 16.8 fixed firing angle256
0486AD             0118*   ;           ub.c and ud.e are the 16.8 fixed x,y component projectile velocities
0486AD             0119*   ; https://old.robowiki.net/cgi-bin/robowiki?LinearTargeting
0486AD             0120*   targeting_computer:
0486AD DD 21 9E 9C 0121*       ld ix,player_begin
       04          
0486B2             0122*   ; ; compute target velocity from x,y component velocities
0486B2             0123*   ;     ld bc,(ix+sprite_xvel)
0486B2             0124*   ;     ld de,(ix+sprite_yvel)
0486B2             0125*   ;     ld hl,-1*256 ; account for vertical ground movement
0486B2             0126*   ;     add hl,de
0486B2             0127*   ;     ex de,hl ; ud.e = player_yvel-1
0486B2             0128*   ;     call cartesian_to_polar_sm ; uh.l = Heading_t, ud.e = Vt
0486B2             0129*   ;     ld (Heading_t),hl ; PASSES
0486B2             0130*   ;     ld (Vt),de ; PASSES
0486B2             0131*   ; ; Bearing_t should have been set by prerequisite call to orientation_to_player
0486B2             0132*   ; ; compute Heading_t-Bearing_t PASSES
0486B2             0133*   ;     ld de,(Bearing_t)
0486B2             0134*   ;     and a ; clear carry
0486B2             0135*   ;     sbc hl,de ; Uh.l = Heading_t-Bearing_t
0486B2             0136*   ; ; compute sin(Heading_t-Bearing_t)
0486B2             0137*   ;     call sin168 ; uh.l = sin(Heading_t-Bearing_t)
0486B2             0138*   ; ; compute (Vt*sin(Heading_t-Bearing_t))
0486B2             0139*   ;     ld de,(Vt)
0486B2             0140*   ;     call smul168 ; uh.l = (Vt*sin(Heading_t-Bearing_t))
0486B2             0141*   ; ; compute (Vt * sin(Heading_t-Bearing_t)) / Vp
0486B2             0142*   ;     ld de,(Vp)
0486B2             0143*   ;     call sdiv168 ; ud.e = (Vt*sin(Heading_t-Bearing_t)) / Vp
0486B2             0144*   ;     ex de,hl ; uh.l = (Vt*sin(Heading_t-Bearing_t)) / Vp
0486B2             0145*   ; ; answer is in radians, convert to degrees256
0486B2             0146*   ;     ld de,0x0028BE ; 40.74 = 57.29578*256/360
0486B2             0147*   ;     call smul168 ; uh.l = angle in degrees256
0486B2             0148*   ;     ld (lead_angle),hl ; TODO: fix this
0486B2             0149*   ; ; add lead angle to target bearing
0486B2             0150*   ;     ld de,(Bearing_t)
0486B2             0151*   ;     add hl,de ; h.l = lead angle+target bearing
0486B2             0152*   
0486B2 2A 8F 86 04 0153*       ld hl,(Bearing_t) ; TODO: fix this
0486B6             0154*   
0486B6 E5          0155*       push hl
0486B7             0156*   
0486B7             0157*   ; compute component projectile velocities
0486B7 ED 5B 95 86 0158*       ld de,(Vp) ; Vp should have been set by caller
       04          
0486BC CD F6 06 04 0159*       call polar_to_cartesian ; ub.c = Vp_x, ud.e = Vp_y
0486C0 ED 43 98 86 0160*       ld (Vp_x),bc
       04          
0486C5             0161*       ; inc d ; account for vertical ground movement
0486C5 ED 53 9B 86 0162*       ld (Vp_y),de
       04          
0486CA E1          0163*       pop hl ; uh.l = lead angle+target bearing
0486CB 22 A7 86 04 0164*       ld (Heading_p),hl
0486CF             0165*   
0486CF C9          0166*       ret
0486D0             0167*   
