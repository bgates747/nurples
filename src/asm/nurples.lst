046749             0069        include "sprites.inc"
046749             0001*   ; sprite_type
046749             0002*   enemy_dead: equ 0
046749             0003*   enemy_air: equ 1
046749             0004*   enemy_ground: equ 2
046749             0005*   enemy_projectile: equ 3
046749             0006*   explosion: equ 4
046749             0007*   player: equ 5
046749             0008*   player_air: equ 6
046749             0009*   player_ground: equ 7
046749             0010*   
046749             0011*   ; ###### SPRITE TABLE FIELD INDICES ######
046749             0012*   table_record_size:         equ  64; bytes per sprite record
046749             0013*   sprite_id:                 equ   0; 1 bytes ;unique spriteId, zero-based
046749             0014*   ; sprite state variables
046749             0015*   sprite_state_variables:    equ   1; beginning of sprite state variables
046749             0016*   sprite_x:                  equ   1; 3 bytes ;16.8 fractional x position in pixels
046749             0017*   sprite_y:                  equ   4; 3 bytes ;16.8 fractional y position in pixels
046749             0018*   sprite_xvel:               equ   7; 3 bytes ;x-component velocity, 16.8 fixed, pixels
046749             0019*   sprite_yvel:               equ  10; 3 bytes ;y-component velocity, 16.8 fixed, pixels
046749             0020*   sprite_vel:                equ  13; 3 bytes ;velocity px/frame (16.8 fixed)
046749             0021*   sprite_heading:            equ  16; 3 bytes ;sprite movement direction deg256 16.8 fixed
046749             0022*   sprite_orientation:        equ  19; 3 bytes ;orientation bits
046749             0023*   ; sprite definition variables
046749             0024*   sprite_definitions:        equ  22; beginnning of sprite definition variables
046749             0025*   sprite_type:               equ  22; 1 bytes ;type of sprite as defined in enemies.inc
046749             0026*   sprite_base_bufferId:      equ  23; 3 bytes ;bitmap bufferId
046749             0027*   sprite_move_program:       equ  26; 3 bytes ;address of sprite's behavior subroutine
046749             0028*   sprite_collisions:         equ  29; 1 bytes ;see collisions.inc constants for bit definitions
046749             0029*   sprite_dim_x:              equ  30; 1 bytes ;sprite width in pixels
046749             0030*   sprite_dim_y:              equ  31; 1 bytes ;sprite height in pixels
046749             0031*   sprite_num_orientations:   equ  32; 1 bytes ;number of orientations for this sprite
046749             0032*   sprite_num_animations:     equ  33; 1 bytes ;number of animations for this sprite
046749             0033*   sprite_animation:          equ  34; 1 bytes ;current animation index, zero-based
046749             0034*   sprite_animation_timer:    equ  35; 1 bytes ;when hits zero, draw next animation
046749             0035*   sprite_move_timer:         equ  36; 1 bytes ;when zero, go to next move program, or step
046749             0036*   sprite_move_step:          equ  37; 1 bytes ;stage in a move program sequence, varies
046749             0037*   sprite_points:             equ  38; 1 bytes ;points awarded for killing this sprite type
046749             0038*   sprite_shield_damage:      equ  39; 1 bytes ;shield points deducted for collision
046749             0039*   sprite_frame:              equ  40; 1 bytes ;current animation frame
046749             0040*   sprite_definitions_size:   equ  sprite_frame-sprite_definitions+1
046749             0041*   
046749             0042*   ; ###### SPRITE TABLE VARIABLES ######
046749             0043*   ; pointer to top address of current record, initialized to table_base
046749 1A 88 04    0044*   table_pointer: dl table_base
04674C             0045*   
04674C             0046*   ; flag indicating collision with screen edge
04674C 00          0047*   sprite_screen_edge: db #00
04674D             0048*   sprite_fault_bad_record: equ 0
04674D             0049*   sprite_fault_bad_move_program: equ 1
04674D 00          0050*   sprite_fault_flags: db 0 ; latched fail-closed diagnostics
04674E             0051*   
04674E             0052*   ; ######### COLLISION SPRITE PARAMETERS ##########
04674E             0053*   ; integer coordinates are all that are needed for collision calculations
04674E 00          0054*   collision_x: db 0x00
04674F 00          0055*   collision_y: db 0x00
046750 00          0056*   collision_dim_x: db 0x00
046751 00          0057*   collision_dim_y: db 0x00
046752             0058*   
046752             0059*   ; scratch variables
046752 00          0060*   x: db 0x00 ; 8-bit signed integer
046753 00          0061*   y: db 0x00 ; 8-bit signed integer
046754 00 00 00    0062*   x0: dl 0x000000 ; 16.8 signed fixed place
046757 00 00 00    0063*   y0: dl 0x000000 ; 16.8 signed fixed place
04675A 00 00 00    0064*   incx1: dl 0x000000 ; 16.8 signed fixed place
04675D 00 00 00    0065*   incy1: dl 0x000000 ; 16.8 signed fixed place
046760 00 00 00    0066*   incx2: dl 0x000000 ; 16.8 signed fixed place
046763 00 00 00    0067*   incy2: dl 0x000000 ; 16.8 signed fixed place
046766             0068*   
046766             0069*   ; sprite_heading: dl 0x000000 ; signed fixed 16.8
046766 00 00 00    0070*   radius: dl 0x000000 ; signed fixed 16.8 (but should always be positive)
046769 00 00 00    0071*   sin_sprite_heading: dl 0x000000 ; signed fixed 16.8
04676C 00 00 00    0072*   cos_sprite_heading: dl 0x000000 ; signed fixed 16.8
04676F             0073*   
04676F             0074*   table_init:
04676F             0075*   ; clear the sprite table
04676F AF          0076*       xor a ; write zeroes to sprite table
046770 32 4D 67 04 0077*       ld (sprite_fault_flags),a
046774 21 1A 88 04 0078*       ld hl,table_base ; address to copy from
046778 01 00 05 00 0079*       ld bc,table_end-table_base ; number of bytes to clear
04677C CD 5B 03 04 0080*       call clear_mem
046780             0081*   ; write sprite ids
046780 DD 21 1A 88 0082*       ld ix,table_base
       04          
046785 AF          0083*       xor a ; sprite id
046786 0E 00       0084*       ld c,0 ; sprite type
046788 06 14       0085*       ld b,table_num_records ; loop counter
04678A             0086*   @loop:
04678A DD 77 00    0087*       ld (ix+sprite_id),a
04678D DD 71 16    0088*       ld (ix+sprite_type),c
046790 ED 32 40    0089*       lea ix,ix+table_record_size
046793 3C          0090*       inc a
046794 10 F4       0091*       djnz @loop
046796 C9          0092*       ret
046797             0093*   ; end table_init
046797             0094*   
046797             0095*   ; Validate a record pointer and its stable identity byte against the physical
046797             0096*   ; 64-byte slot it occupies in the sprite table.
046797             0097*   ; inputs: iy = candidate sprite record
046797             0098*   ; outputs: carry set only for an aligned in-range pointer with the expected id
046797             0099*   ; destroys: a,de,hl
046797             0100*   sprite_table_record_pointer_valid:
046797 FD E5       0101*       push iy
046799 E1          0102*       pop hl
04679A 11 1A 88 04 0103*       ld de,table_base
04679E B7          0104*       or a
04679F ED 52       0105*       sbc hl,de ; offset from the sprite-table base
0467A1 DA CB 67 04 0106*       jp c,@invalid
0467A5 11 00 05 00 0107*       ld de,table_end-table_base
0467A9 B7          0108*       or a
0467AA ED 52       0109*       sbc hl,de
0467AC D2 CB 67 04 0110*       jp nc,@invalid
0467B0 19          0111*       add hl,de ; restore the in-range offset
0467B1 7D          0112*       ld a,l
0467B2 E6 3F       0113*       and table_record_size-1
0467B4 C2 CB 67 04 0114*       jp nz,@invalid
0467B8             0115*   ; Convert the aligned offset to its record id: H*4 + L/64.
0467B8 7C          0116*       ld a,h
0467B9 87          0117*       add a,a
0467BA 87          0118*       add a,a
0467BB 57          0119*       ld d,a
0467BC 7D          0120*       ld a,l
0467BD 07          0121*       rlca
0467BE 07          0122*       rlca
0467BF E6 03       0123*       and %00000011
0467C1 B2          0124*       or d
0467C2 FD BE 00    0125*       cp (iy+sprite_id)
0467C5 C2 CB 67 04 0126*       jp nz,@invalid
0467C9 37          0127*       scf
0467CA C9          0128*       ret
0467CB             0129*   @invalid:
0467CB AF          0130*       xor a
0467CC C9          0131*       ret
0467CD             0132*   ; end sprite_table_record_pointer_valid
0467CD             0133*   
0467CD             0134*   ; deactivate the sprite with the given id
0467CD             0135*   ; inputs: iy set to sprite record
0467CD             0136*   ; outputs: nothing
0467CD             0137*   ; destroys: a,de,hl
0467CD             0138*   table_deactivate_sprite:
0467CD CD 97 67 04 0139*       call sprite_table_record_pointer_valid
0467D1 D2 ED 67 04 0140*       jp nc,@invalid
0467D5 FD 7E 00    0141*       ld a,(iy+sprite_id) ; get spriteId
0467D8 FD E5       0142*       push iy
0467DA CD AE 19 04 0143*       call vdu_sprite_select ; select sprite
0467DE CD 32 1A 04 0144*       call vdu_sprite_hide
0467E2 FD E1       0145*       pop iy
0467E4 FD CB 1D B6 0146*       res sprite_alive,(iy+sprite_collisions)
0467E8 FD CB 1D BE 0147*       res sprite_just_died,(iy+sprite_collisions)
0467EC C9          0148*       ret
0467ED             0149*   @invalid:
0467ED 21 4D 67 04 0150*       ld hl,sprite_fault_flags
0467F1 CB C6       0151*       set sprite_fault_bad_record,(hl)
0467F3 C9          0152*       ret
0467F4             0153*   ; end table_deactivate_sprite
0467F4             0154*   
0467F4             0155*   sprites_init:
0467F4             0156*   ; initialize sprites
0467F4 CD E2 1A 04 0157*   	call vdu_sprite_reset ; clear sprite data in vdp
0467F8             0158*   
0467F8             0159*   ; define player sprite
0467F8 3A 1A 89 04 0160*   	ld a,(player_begin+sprite_id)
0467FC CD AE 19 04 0161*   	call vdu_sprite_select
046800 CD C1 19 04 0162*   	call vdu_sprite_clear_frames
046804 21 73 01 00 0163*   	ld hl,BUF_SHIP_0L
046808 06 03       0164*   	ld b,3 ; DJNZ consumes B; loading BC with 3 would put zero in B
04680A             0165*   @sprite_player_loop:
04680A C5          0166*   	push bc
04680B E5          0167*   	push hl
04680C CD 03 1B 04 0168*   	call vdu_sprite_add_buff
046810 E1          0169*   	pop hl
046811 23          0170*   	inc hl
046812 C1          0171*   	pop bc
046813 10 F5       0172*   	djnz @sprite_player_loop
046815             0173*   
046815             0174*   ; define player weapon sprites
046815 CD 94 65 04 0175*       call init_player_laser
046819             0176*   
046819             0177*   ; define enemy sprites
046819 CD 48 4C 04 0178*       call init_enemy_seekers
04681D CD E5 4A 04 0179*       call init_enemy_fireballs
046821             0180*   
046821             0181*   ; define explosion sprites
046821 CD 1C 4D 04 0182*       call init_explosions
046825             0183*   
046825             0184*   ; activate only after every contiguous sprite has its final frame definitions
046825 3E 14       0185*       ld a,table_num_records
046827 CD E2 19 04 0186*   	call vdu_sprite_activate
04682B C9          0187*       ret
04682C             0188*   ; end sprites_init
04682C             0189*   
04682C             0190*   ; gets the next available sprite id for a particular sprite group
04682C             0191*   ; inputs; ix = pointer to sprite group, b = number of records in sprite group
04682C             0192*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
04682C             0193*   ;      otherwise, a = 0, carry reset, ix invalid and must not be dereferenced
04682C             0194*   ; destroys: a,b,c,hl,ix
04682C             0195*   table_get_next_id:
04682C             0196*   @loop:
04682C DD CB 1D 76 0197*       bit sprite_alive,(ix+sprite_collisions)
046830 28 07       0198*       jr z,@found
046832 ED 32 40    0199*       lea ix,ix+table_record_size
046835 10 F5       0200*       djnz @loop
046837             0201*   @notfound:
046837 AF          0202*       xor a ; a = 0 and reset carry flag indicating that we didn't find a free sprite
046838 C9          0203*       ret
046839             0204*   @found:
046839             0205*   ; return sprite id
046839 DD 7E 00    0206*       ld a,(ix+sprite_id)
04683C 37          0207*       scf ; sets carry flag indicating we found a free sprite
04683D C9          0208*       ret ; done
04683E             0209*   ; end table_get_next_id
04683E             0210*   
04683E             0211*   ; create a new sprite at the prescribed coordinates
04683E             0212*   ; inputs: hl = pointer to new sprite default settings, ub.c, ud.e = x,y position
04683E             0213*   ;         ix = pointer to sprite group, a = number of records in sprite group
04683E             0214*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
04683E             0215*   ;      otherwise, a = 0, carry reset, ix invalid and must not be dereferenced
04683E             0216*   spawn_sprite_from_coords:
04683E ED 43 8B 68 0217*       ld (@sprite_x),bc ; store x-coordinate
       04          
046843 ED 53 8E 68 0218*       ld (@sprite_y),de ; store y-coordinate
       04          
046848 47          0219*       ld b,a ; number of records in sprite group
046849 E5          0220*       push hl ; back up pointer to new sprite defaults
04684A CD 2C 68 04 0221*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
04684E E1          0222*       pop hl ; restore pointer to new sprite defaults
04684F D0          0223*       ret nc ; no carry means no free sprite slots, so we go home
046850             0224*   ; copy default settings to new sprite
046850 DD E5       0225*       push ix ; back up pointer to new sprite record
046852 ED 32 16    0226*       lea ix,ix+sprite_definitions ; bump pointer to copy to
046855 DD E5       0227*       push ix ; pointer to default sprite settings
046857 D1          0228*       pop de ; address to copy to
046858 01 13 00 00 0229*       ld bc,sprite_definitions_size ; copy only bytes provided by defaults
04685C ED B0       0230*       ldir ; copies defaults to new sprite record
04685E DD E1       0231*       pop ix ; restore pointer to new sprite record
046860             0232*   ; copy sprite position from existing sprite
046860 2A 8B 68 04 0233*       ld hl,(@sprite_x)
046864 DD 2F 01    0234*       ld (ix+sprite_x),hl
046867 2A 8E 68 04 0235*       ld hl,(@sprite_y)
04686B DD 2F 04    0236*       ld (ix+sprite_y),hl
04686E             0237*   ; clear motion state retained by a previously used physical record
04686E 21 00 00 00 0238*       ld hl,0
046872 DD 2F 07    0239*       ld (ix+sprite_xvel),hl
046875 DD 2F 0A    0240*       ld (ix+sprite_yvel),hl
046878 DD 2F 0D    0241*       ld (ix+sprite_vel),hl
04687B DD 2F 10    0242*       ld (ix+sprite_heading),hl
04687E DD 2F 13    0243*       ld (ix+sprite_orientation),hl
046881             0244*   ; return to caller
046881 DD CB 16 FE 0245*       set 7,(ix+sprite_type) ; set just spawned flag
046885 DD CB 1D F6 0246*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
046889 37          0247*       scf ; set carry flag to indicate success
04688A C9          0248*       ret
04688B 00 00 00    0249*   @sprite_x: dl 0 ; new sprite x-coordinate
04688E 00 00 00    0250*   @sprite_y: dl 0 ; new sprite y-coordinate
046891             0251*   ; end spawn_sprite_from_coords
046891             0252*   
046891             0253*   ; create a new sprite at the same location as an existing sprite
046891             0254*   ; inputs: hl = pointer to new sprite default settings, table_pointer = existing sprite
046891             0255*   ;         ix = pointer to sprite group, b = number of records in sprite group
046891             0256*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
046891             0257*   ;      otherwise, a = 0, carry reset, ix invalid and must not be dereferenced
046891             0258*   spawn_sprite_from_sprite:
046891 E5          0259*       push hl ; back up pointer to new sprite defaults
046892 CD 2C 68 04 0260*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
046896 E1          0261*       pop hl ; restore pointer to new sprite defaults
046897 D0          0262*       ret nc ; no carry means no free sprite slots, so we go home
046898             0263*   ; copy default settings to new sprite
046898 DD E5       0264*       push ix ; back up pointer to new sprite record
04689A ED 32 16    0265*       lea ix,ix+sprite_definitions ; bump pointer to copy to
04689D DD E5       0266*       push ix ; pointer to default sprite settings
04689F D1          0267*       pop de ; address to copy to
0468A0 01 13 00 00 0268*       ld bc,sprite_definitions_size ; copy only bytes provided by defaults
0468A4 ED B0       0269*       ldir ; copies defaults to new sprite record
0468A6 DD E1       0270*       pop ix ; restore pointer to new sprite record
0468A8             0271*   ; copy sprite position from existing sprite
0468A8 FD 2A 49 67 0272*       ld iy,(table_pointer) ; get existing sprite record
       04          
0468AD FD 27 01    0273*       ld hl,(iy+sprite_x)
0468B0 DD 2F 01    0274*       ld (ix+sprite_x),hl
0468B3 FD 27 04    0275*       ld hl,(iy+sprite_y)
0468B6 DD 2F 04    0276*       ld (ix+sprite_y),hl
0468B9             0277*   ; clear motion state retained by a previously used physical record
0468B9 21 00 00 00 0278*       ld hl,0
0468BD DD 2F 07    0279*       ld (ix+sprite_xvel),hl
0468C0 DD 2F 0A    0280*       ld (ix+sprite_yvel),hl
0468C3 DD 2F 0D    0281*       ld (ix+sprite_vel),hl
0468C6 DD 2F 10    0282*       ld (ix+sprite_heading),hl
0468C9 DD 2F 13    0283*       ld (ix+sprite_orientation),hl
0468CC             0284*   ; return to caller
0468CC DD CB 16 FE 0285*       set 7,(ix+sprite_type) ; set just spawned flag
0468D0 DD CB 1D F6 0286*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
0468D4 37          0287*       scf ; set carry flag to indicate success
0468D5 C9          0288*       ret
0468D6             0289*   ; end spawn_sprite_from_sprite
