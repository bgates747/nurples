041467             0224*   ; 151   512   384   2     60hz
041467             0225*   ; 6     640   240   2     60hz
041467             0226*   ; 134   640   240   2     60hz
041467             0227*   ; 2     640   480   2     60hz
041467             0228*   ; 130   640   480   2     60hz
041467             0229*   ; 17    800   600   2     60hz
041467             0230*   ; 145   800   600   2     60hz
041467             0231*   ; 18    1024  768   2     60hz
041467             0232*   ; 146   1024  768   2     60hz
