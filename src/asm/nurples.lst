04132D             0375*   
04132D             0376*   ; ------------------
04132D             0377*   ; delay routine
04132D             0378*   ; Author: Richard Turrnidge
04132D             0379*   ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.asm
04132D             0380*   ; routine waits a fixed time,then returns
04132D             0381*   ; arrive with A =  the delay byte. One bit to be set only.
04132D             0382*   ; eg. ld A,00000100b
04132D             0383*   
04132D             0384*   multiPurposeDelay:
       FF FF FF 
04132D F5          0385*       push af
04132E C5          0386*       push bc
04132F D5          0387*       push de
041330 DD E5       0388*       push ix
041332 5F          0389*       ld e,a ; timestamp bit mask
041333 3E 20       0390*       ld a,32
041335 32 86 13 04 0391*       ld (multiPurposeDelay_timeout_outer),a
041339 06 00       0392*       ld b,0
04133B 16 00       0393*       ld d,0
04133D 3E 08       0394*       ld a,$08
04133F 5B CF       0395*       RST.LIL	08h                 ; get IX pointer to sysvars
041341             0396*   
041341             0397*   ; oldTimeStamp is per-call scratch, not persistent process state. Seed it from
041341             0398*   ; the requested clock bit so every call waits for a real transition.
041341 DD 7E 00    0399*       ld a,(ix + 0)
041344 A3          0400*       and e
041345 32 85 13 04 0401*       ld (oldTimeStamp),a
041349             0402*   
041349             0403*   waitLoop:
041349             0404*   
041349 DD 7E 00    0405*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
04134C             0406*   
04134C             0407*                                   ;   we check if bit set is same as last time we checked.
04134C             0408*                                   ;   bit 0 - don't use
04134C             0409*                                   ;   bit 1 - changes 64 times per second
04134C             0410*                                   ;   bit 2 - changes 32 times per second
04134C             0411*                                   ;   bit 3 - changes 16 times per second
04134C             0412*   
04134C             0413*                                   ;   bit 4 - changes 8 times per second
04134C             0414*                                   ;   bit 5 - changes 4 times per second
04134C             0415*                                   ;   bit 6 - changes 2 times per second
04134C             0416*                                   ;   bit 7 - changes 1 times per second
04134C A3          0417*       and e
04134D 4F          0418*       ld c,a
04134E 3A 85 13 04 0419*       ld a,(oldTimeStamp)
041352 B9          0420*       cp c                        ; is A same as last value?
041353 C2 79 13 04 0421*       jp nz,@changed
041357             0422*   ; Bound a stalled MOS clock to 32 * 65,536 polls.
041357 15          0423*       dec d
041358 C2 49 13 04 0424*       jp nz,waitLoop
04135C 10 EB       0425*       djnz waitLoop
04135E 3A 86 13 04 0426*       ld a,(multiPurposeDelay_timeout_outer)
041362 3D          0427*       dec a
041363 32 86 13 04 0428*       ld (multiPurposeDelay_timeout_outer),a
041367 C2 49 13 04 0429*       jp nz,waitLoop
04136B 3A 84 13 04 0430*       ld a,(timer_fault_flags)
04136F F6 01       0431*       or %00000001
041371 32 84 13 04 0432*       ld (timer_fault_flags),a
041375 C3 7E 13 04 0433*       jp @done
041379             0434*   @changed:
041379 79          0435*       ld a,c
04137A 32 85 13 04 0436*       ld (oldTimeStamp),a        ; set new value
04137E             0437*   
04137E             0438*   @done:
04137E DD E1       0439*       pop ix
041380 D1          0440*       pop de
041381 C1          0441*       pop bc
041382 F1          0442*       pop af
041383 C9          0443*       ret
041384             0444*   
041384             0445*   timer_fault_delay_timeout: equ 0
041384 00          0446*   timer_fault_flags: db 0
041385 00          0447*   oldTimeStamp: .db 00h
041386 00          0448*   multiPurposeDelay_timeout_outer: db 0
