046450 21 EF FF FF 0231*       ld hl,-bar_red
046454 19          0232*       add hl,de
046455 D2 72 64 04 0233*       jp nc,@red
046459 21 DF FF FF 0234*       ld hl,-bar_yellow
04645D 19          0235*       add hl,de
04645E D2 6A 64 04 0236*       jp nc,@yellow
046462 21 02 00 00 0237*       ld hl,BUF_BAR_H_2 ; green
046466 C3 76 64 04 0238*       jp @select
04646A             0239*   @yellow:
04646A 21 01 00 00 0240*       ld hl,BUF_BAR_H_1 ; yellow
04646E C3 76 64 04 0241*       jp @select
046472             0242*   @red:
