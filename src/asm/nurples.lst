048D54             0100*   
048D54             0101*   ; create a new sprite at the same location as the current tile
048D54             0102*   ; inputs: hl = pointer to new sprite default settings, tile_table_pointer = current tile
048D54             0103*   ;         ix = pointer to sprite group, b = number of records in sprite group
048D54             0104*   spawn_sprite_from_tile:
048D54 E5          0105*       push hl ; back up pointer to new sprite defaults
048D55 CD 43 81 04 0106*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
048D59 E1          0107*       pop hl ; restore pointer to new sprite defaults
048D5A D0          0108*       ret nc ; no carry means no free sprite slots, so we go home
048D5B             0109*   ; copy default settings to new sprite
048D5B DD E5       0110*       push ix ; back up pointer to new sprite record
048D5D ED 32 16    0111*       lea ix,ix+sprite_definitions ; bump pointer to copy to
048D60 DD E5       0112*       push ix ; pointer to default sprite settings
048D62 D1          0113*       pop de ; address to copy to
048D63 01 2A 00 00 0114*       ld bc,table_record_size-sprite_definitions ; number of bytes to copy
048D67 ED B0       0115*       ldir ; copies defaults to new sprite record
048D69 DD E1       0116*       pop ix ; restore pointer to new sprite record
048D6B             0117*   ; copy sprite position from existing tile
048D6B FD 2A 08 8A 0118*       ld iy,(tile_table_pointer) ; get existing tile record
       04          
048D70 FD 27 01    0119*       ld hl,(iy+tile_x)
048D73 DD 2F 01    0120*       ld (ix+sprite_x),hl
048D76 FD 27 04    0121*       ld hl,(iy+tile_y)
048D79 DD 2F 04    0122*       ld (ix+sprite_y),hl
048D7C             0123*   ; return to caller
048D7C DD CB 16 FE 0124*       set 7,(ix+sprite_type) ; set just spawned flag
048D80 DD CB 1D F6 0125*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
