047AC1             0040*   ; reset the animation timer and bump animation
047AC1 3E 08       0041*       ld a,8
047AC3 FD 77 23    0042*       ld (iy+tile_animation_timer),a
047AC6 FD 7E 28    0043*       ld a,(iy+tile_frame)
