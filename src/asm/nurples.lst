04408E             0874*   
04408E             0875*   ; A 24-bit calculated size can match only a declared u32 whose high byte is 0.
04408E 3A D7 1B 04 0876*       ld a,(agnb_metadata+agnb_meta_data_size+3)
044092 B7          0877*       or a
