044B08 40          0009*       db %01000000            ; collisions bit 6 signals sprite alive
044B09 10          0010*       db 16                   ; dim_x
044B0A 10          0011*       db 16                   ; dim_y
044B0B 20          0012*       db 32                   ; num_orientations
044B0C 01          0013*       db 1                    ; num_animations
044B0D 00          0014*       db 0                    ; animation
044B0E 00          0015*       db 0                    ; animation_timer
044B0F 01          0016*       db 1                    ; move_timer
044B10 00          0017*       db 0                    ; move_step
