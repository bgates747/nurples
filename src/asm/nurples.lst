04655A 1E 04       0053*       ld e,player_lasers_max ; sprite loop counter
04655C             0054*   ; define laser sprites
04655C             0055*   @sprites_loop:
04655C F5          0056*       push af
04655D D5          0057*       push de
04655E CD BB 19 04 0058*   	call vdu_sprite_select
046562 CD CE 19 04 0059*   	call vdu_sprite_clear_frames
046566 21 4E 01 00 0060*   	ld hl,BUF_LASER_A
04656A 06 02       0061*   	ld b,2 ; two bitmaps for laser
04656C             0062*   @frames_loop:
04656C C5          0063*   	push bc
04656D E5          0064*   	push hl
04656E CD 10 1B 04 0065*   	call vdu_sprite_add_buff
046572 E1          0066*   	pop hl
046573 23          0067*   	inc hl
046574 C1          0068*   	pop bc
046575 10 F5       0069*   	djnz @frames_loop
046577 D1          0070*       pop de ; sprite loop counter
046578 F1          0071*       pop af ; sprite id
046579 3C          0072*       inc a
04657A 1D          0073*       dec e
04657B C2 5C 65 04 0074*       jp nz,@sprites_loop
04657F             0075*   ; set laser firing timer to zero
04657F FD 21 1B 65 0076*       ld iy,tmr_laser
       04          
046584 21 00 00 00 0077*       ld hl,0
046588 CD F1 12 04 0078*       call timestamp_tmr_set
