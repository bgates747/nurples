047FFC CD 44 19 04 0410*       call vdu_sprite_select
048000 FD 07 01    0411*       ld bc,(iy+sprite_x)
048003 FD 17 04    0412*       ld de,(iy+sprite_y)
048006 CD 10 1A 04 0413*       call vdu_sprite_move_abs168
04800A CD BA 19 04 0414*       call vdu_sprite_show
04800E             0415*   @@:
04800E ED 33 40    0416*       lea iy,iy+table_record_size
048011 C1          0417*       pop bc ; get back loop counter
048012 10 D0       0418*       djnz @reset_just_spawned
048014 C9          0419*       ret
048015             0420*   @bad_record:
048015 21 50 7D 04 0421*       ld hl,sprite_fault_flags
048019 CB C6       0422*       set sprite_fault_bad_record,(hl)
04801B FD E1       0423*       pop iy
04801D C1          0424*       pop bc
04801E C9          0425*       ret
04801F             0426*   @bad_move_program:
04801F 21 50 7D 04 0427*       ld hl,sprite_fault_flags
048023 CB CE       0428*       set sprite_fault_bad_move_program,(hl)
048025 CD D0 7D 04 0429*       call table_deactivate_sprite
048029 C3 D6 7F 04 0430*       jp @next_record
04802D             0431*   @bad_reset_record:
04802D 21 50 7D 04 0432*       ld hl,sprite_fault_flags
048031 CB C6       0433*       set sprite_fault_bad_record,(hl)
048033 C1          0434*       pop bc
048034 C9          0435*       ret
048035             0436*   @sprite_died:
048035 CD D0 7D 04 0437*       call table_deactivate_sprite
048039 C3 D6 7F 04 0438*       jp @next_record
04803D             0439*   ; end move_sprite_group
04803D             0440*   
04803D             0441*   ; update behavior subroutines for a specified sprite group
04803D             0442*   ; inputs: hl = pointer to move program, iy = pointer to sprite group, b = number of records in sprite group
04803D             0443*   change_sprite_group_move_program:
04803D             0444*   @update_loop:
04803D             0445*   ; check sprite_alive bit to see if sprite is active
04803D FD CB 1D 76 0446*       bit sprite_alive,(iy+sprite_collisions)
048041 CA 4C 80 04 0447*       jp z,@next_record ; ... skip to next record
048045             0448*   ; otherwise load the behavior subroutine address
048045 FD 2F 1A    0449*       ld (iy+sprite_move_program),hl
048048             0450*    ; clear just spawned flag
048048 FD CB 16 BE 0451*       res 7,(iy+sprite_type)
04804C             0452*   ; fall through to @next_record
04804C             0453*   @next_record:
04804C ED 33 40    0454*       lea iy,iy+table_record_size
04804F 10 EC       0455*       djnz @update_loop ; loop until we've checked all the records
048051 C9          0456*       ret
048052             0457*   ; end change_sprite_group_move_program
048052             0458*   
048052             0459*   ; compute a sprite's new position based on its component x,y velocities
048052             0460*   ; with screen boundary checking and update its sprite table record accordingly
048052             0461*   ; inputs: table_pointer set to sprite record
048052             0462*   ; returns: updated x, y positions and edge collision flags in sprite_screen_edge
048052             0463*   ; destroys: everything
048052             0464*   ; note: actual rendering of sprite must be handled by caller
048052             0465*   move_sprite:
048052 FD 2A 4C 7D 0466*       ld iy,(table_pointer)
       04          
048057             0467*   ; x-axis movement
048057 FD 27 01    0468*       ld hl,(iy+sprite_x)
04805A FD 17 07    0469*       ld de,(iy+sprite_xvel)
04805D 19          0470*       add hl,de
04805E FD 2F 01    0471*       ld (iy+sprite_x),hl
048061             0472*   ; y-axis movement
048061 FD 27 04    0473*       ld hl,(iy+sprite_y)
048064 FD 17 0A    0474*       ld de,(iy+sprite_yvel)
048067 19          0475*       add hl,de
048068 FD 2F 04    0476*       ld (iy+sprite_y),hl
04806B             0477*   ; detect screen edge collisions
04806B AF          0478*       xor a ; reset screen edge collision flag and clear carry
04806C 32 4F 7D 04 0479*       ld (sprite_screen_edge),a
048070             0480*   ; y-axis first since we already have it in hl
048070 11 00 00 00 0481*       ld de,-sprite_top*256
048074 ED 5A       0482*       adc hl,de
048076 FA A0 80 04 0483*       jp m,@top
04807A ED 52       0484*       sbc hl,de ; hl back to original value
04807C 11 00 C0 FE 0485*       ld de,-sprite_bottom*256
048080 ED 5A       0486*       adc hl,de
048082 F2 AA 80 04 0487*       jp p,@bottom
048086             0488*   @xaxis:
048086 FD 27 01    0489*       ld hl,(iy+sprite_x)
048089 11 00 00 00 0490*       ld de,-sprite_left*256
04808D ED 5A       0491*       adc hl,de
04808F FA C5 80 04 0492*       jp m,@left
048093 ED 52       0493*       sbc hl,de ; hl back to original value
048095 11 00 10 FF 0494*       ld de,-sprite_right*256
048099 ED 5A       0495*       adc hl,de
04809B F2 D3 80 04 0496*       jp p,@right
04809F             0497*   ; no edge collisions so go home
04809F C9          0498*       ret
0480A0             0499*   @top:
0480A0 3E 08       0500*       ld a,collide_top
0480A2 21 00 00 00 0501*       ld hl,sprite_top*256
0480A6 C3 B0 80 04 0502*       jp @collide_y
0480AA             0503*   @bottom:
0480AA 3E 04       0504*       ld a,collide_bottom
0480AC 21 00 40 01 0505*       ld hl,sprite_bottom*256
0480B0             0506*   @collide_y:
0480B0 32 4F 7D 04 0507*       ld (sprite_screen_edge),a
0480B4 FD 2F 04    0508*       ld (iy+sprite_y),hl
0480B7             0509*   ; reverse y-axis velocity
0480B7 FD 27 0A    0510*       ld hl,(iy+sprite_yvel)
0480BA CD 7C 04 04 0511*       call neg_hlu
0480BE FD 2F 0A    0512*       ld (iy+sprite_yvel),hl
0480C1             0513*   ; go check for x-axis collisions
0480C1 C3 86 80 04 0514*       jp @xaxis
0480C5             0515*   @left:
0480C5 3A 4F 7D 04 0516*       ld a,(sprite_screen_edge)
0480C9 F6 02       0517*       or a,collide_left
0480CB 21 00 00 00 0518*       ld hl,sprite_left*256
0480CF C3 DD 80 04 0519*       jp @collide_x
0480D3             0520*   @right:
0480D3 3A 4F 7D 04 0521*       ld a,(sprite_screen_edge)
0480D7 F6 01       0522*       or a,collide_right
0480D9 21 00 F0 00 0523*       ld hl,sprite_right*256
0480DD             0524*   @collide_x:
0480DD 32 4F 7D 04 0525*       ld (sprite_screen_edge),a
0480E1 FD 2F 01    0526*       ld (iy+sprite_x),hl
0480E4             0527*   ; reverse x-axis velocity
0480E4 FD 27 07    0528*       ld hl,(iy+sprite_xvel)
0480E7 CD 7C 04 04 0529*       call neg_hlu
0480EB FD 2F 07    0530*       ld (iy+sprite_xvel),hl
0480EE             0531*   ; final collision flag to a and return
0480EE 3A 4F 7D 04 0532*       ld a,(sprite_screen_edge)
0480F2 C9          0533*       ret
0480F3             0534*   ; end move_sprite
0480F3             0535*   
0480F3             0536*   sprite_compute_velocities:
0480F3 FD 27 10    0537*       ld hl,(iy+sprite_heading)
0480F6 FD 17 0D    0538*       ld de,(iy+sprite_vel)
0480F9 CD F6 06 04 0539*       call polar_to_cartesian
0480FD FD 2A 4C 7D 0540*       ld iy,(table_pointer)
       04          
048102 FD 0F 07    0541*       ld (iy+sprite_xvel),bc ; save x-velocity component
048105 FD 1F 0A    0542*       ld (iy+sprite_yvel),de ; save y-velocity component
048108 C9          0543*       ret
048109             0544*   ; end sprite_compute_velocities
048109             0545*   
048109             0546*   ; compute animation frame based on sprite_animation and sprite_heading
048109             0547*   ; inputs: table_pointer set to sprite record
048109             0548*   ; outputs: a, sprite_frame set to animation frame
048109             0549*   ; destroys: a,hl
048109             0550*   sprite_frame_heading_animation:
048109 FD 7E 11    0551*       ld a,(iy+sprite_heading+1) ; we want the integer portion
04810C CB 3F       0552*       srl a ; divide integer portion by 8
04810E CB 3F       0553*       srl a
048110 CB 3F       0554*       srl a
048112 FD 66 22    0555*       ld h,(iy+sprite_animation)
048115 2E 20       0556*       ld l,32 ; 32 orientation frames per animation
048117 ED 6C       0557*       mlt hl ; hl = offset from base animation
048119 85          0558*       add a,l ; modulo256 since sprite_frame is only 1 byte
04811A FD 77 28    0559*       ld (iy+sprite_frame),a
04811D C9          0560*       ret
04811E             0561*   ; end sprite_frame_heading_animation
04811E             0562*   
04811E             0563*   ; compute animation frame based on sprite_heading
04811E             0564*   ; inputs: table_pointer set to sprite record
04811E             0565*   ; outputs: a, sprite_frame set to animation frame
04811E             0566*   ; destroys: a,hl
04811E             0567*   sprite_frame_heading:
04811E FD 7E 11    0568*       ld a,(iy+sprite_heading+1) ; we want the integer portion
048121 CB 3F       0569*       srl a ; divide integer portion by 8
048123 CB 3F       0570*       srl a
048125 CB 3F       0571*       srl a
048127 FD 77 28    0572*       ld (iy+sprite_frame),a
04812A C9          0573*       ret
04812B             0574*   ; end sprite_frame_heading
04812B             0575*   
04812B             0576*   ; load a sprite with animation bitmaps
04812B             0577*   ; inputs: a = sprite id, hl = base bufferId, bc = number of frames, sprite_select
04812B             0578*   sprite_load_frames:
04812B             0579*   ; back up input parameters
04812B E5          0580*       push hl ; base bufferId
04812C C5          0581*       push bc ; bc = number of frames
04812D CD 57 19 04 0582*       call vdu_sprite_clear_frames
048131 C1          0583*       pop bc ; bc = number of frames
048132 E1          0584*       pop hl ; = base bufferId
048133             0585*   @load_frames:
048133 C5          0586*       push bc ; back up loop counter
048134 E5          0587*       push hl ; back up base bufferId
048135 CD 99 1A 04 0588*       call vdu_sprite_add_buff
048139 E1          0589*       pop hl ; restore base bufferId
04813A 23          0590*       inc hl ; bump it to the next frame
04813B             0591*   ; decrement loop counter
04813B C1          0592*       pop bc
04813C 0B          0593*       dec bc
04813D 79          0594*       ld a,c
04813E B7          0595*       or a
04813F C2 33 81 04 0596*       jp nz,@load_frames
048143 78          0597*       ld a,b
048144 B7          0598*       or a
048145 C2 33 81 04 0599*       jp nz,@load_frames
048149 C9          0600*       ret
04814A             0601*   ; end sprite_load_frames
