04148F             0199*   ; outputs; nothing
04148F             0200*   ; destroys: a might make it out alive
04148F             0201*   vdu_set_gfx_viewport:
04148F ED 43 AF 14 0202*       ld (@x0),bc
       04          
041494 FD 22 B1 14 0203*       ld (@y1),iy
       04          
041499 DD 22 B3 14 0204*   	ld (@x1),ix
       04          
04149E ED 53 B5 14 0205*   	ld (@y0),de
       04          
0414A3 21 AE 14 04 0206*   	ld hl,@cmd
0414A7 01 09 00 00 0207*   	ld bc,@end-@cmd
0414AB 5B DF       0208*   	rst.lil $18
0414AD C9          0209*   	ret
0414AE 18          0210*   @cmd:   db 24 ; set graphics viewport command
0414AF 00 00       0211*   @x0: 	dw 0x0000 ; set by bc
0414B1 00 00       0212*   @y1: 	dw 0x0000 ; set by iy
0414B3 00 00       0213*   @x1: 	dw 0x0000 ; set by ix
0414B5 00 00       0214*   @y0: 	dw 0x0000 ; set by de
0414B7 00          0215*   @end:   db 0x00	  ; padding
0414B8             0216*   
0414B8             0217*   ; SCREEN MODES
0414B8             0218*   ; ===============================
0414B8             0219*   ; Mode  Horz  Vert  Cols  Refresh
0414B8             0220*   ; ---   ----  ----  ----  -------
0414B8             0221*   ; 11    320   240   2     60hz
0414B8             0222*   ; 139   320   240   2     60hz
0414B8             0223*   ; 23    512   384   2     60hz
0414B8             0224*   ; 151   512   384   2     60hz
0414B8             0225*   ; 6     640   240   2     60hz
0414B8             0226*   ; 134   640   240   2     60hz
0414B8             0227*   ; 2     640   480   2     60hz
0414B8             0228*   ; 130   640   480   2     60hz
0414B8             0229*   ; 17    800   600   2     60hz
0414B8             0230*   ; 145   800   600   2     60hz
0414B8             0231*   ; 18    1024  768   2     60hz
0414B8             0232*   ; 146   1024  768   2     60hz
0414B8             0233*   ; ---   ----  ----  ----  -------
0414B8             0234*   ; 10    320   240   4     60hz
0414B8             0235*   ; 138   320   240   4     60hz
0414B8             0236*   ; 22    512   384   4     60hz
0414B8             0237*   ; 150   512   384   4     60hz
0414B8             0238*   ; 5     640   240   4     60hz
0414B8             0239*   ; 133   640   240   4     60hz
0414B8             0240*   ; 1     640   480   4     60hz
0414B8             0241*   ; 129   640   480   4     60hz
0414B8             0242*   ; 16    800   600   4     60hz
0414B8             0243*   ; 19    1024  768   4     60hz
0414B8             0244*   ; ---   ----  ----  ----  -------
0414B8             0245*   ; 9     320   240   16    60hz
0414B8             0246*   ; 137   320   240   16    60hz
0414B8             0247*   ; 21    512   384   16    60hz
0414B8             0248*   ; 149   512   384   16    60hz
0414B8             0249*   ; 4     640   240   16    60hz
0414B8             0250*   ; 132   640   240   16    60hz
0414B8             0251*   ; 0     640   480   16    60hz
0414B8             0252*   ; 7     n/a   n/a   16    60hz
0414B8             0253*   ; ---   ----  ----  ----  -------
0414B8             0254*   ; 8     320   240   64    60hz
0414B8             0255*   ; 136   320   240   64    60hz
0414B8             0256*   ; 20    512   384   64    60hz
0414B8             0257*   ; 3     640   240   64    60hz
0414B8             0258*   ; ---   ----  ----  ----  -------
0414B8             0259*   vdu_set_screen_mode:
0414B8 32 C8 14 04 0260*   	ld (@arg),a
0414BC 21 C7 14 04 0261*   	ld hl,@cmd
0414C0 01 02 00 00 0262*   	ld bc,@end-@cmd
0414C4 5B DF       0263*   	rst.lil $18
0414C6 C9          0264*   	ret
0414C7 16          0265*   @cmd: db 22 ; set screen mode
0414C8 00          0266*   @arg: db 0  ; screen mode parameter
0414C9             0267*   @end:
0414C9             0268*   
0414C9             0269*   ; get the current screen mode
0414C9             0270*   ; inputs: none
0414C9             0271*   ; outputs: a=screen mode
0414C9             0272*   ; destroys: af, ix
0414C9             0273*   vdu_get_screen_mode:
0414C9             0274*       MOSCALL mos_sysvars
                       M1 Args: function=mos_sysvars 
0414C9 3E 08       0001*M1 			LD	A, function
0414CB 5B CF       0002*M1 			RST.LIL	08h
0414CD DD 7E 27    0275*       ld a,(IX+sysvar_scrMode)
0414D0 C9          0276*       ret
0414D1             0277*   ; end vdu_get_screen_mode
0414D1             0278*   
0414D1             0279*   ; VDU 23, 0, &C0, n: Turn logical screen scaling on and off *
0414D1             0280*   ; inputs: a is scaling mode, 1=on, 0=off
0414D1             0281*   ; note: default setting on boot is scaling ON
0414D1             0282*   vdu_set_scaling:
0414D1 32 E3 14 04 0283*   	ld (@arg),a
0414D5 21 E0 14 04 0284*   	ld hl,@cmd
0414D9 01 04 00 00 0285*   	ld bc,@end-@cmd
0414DD 5B DF       0286*   	rst.lil $18
0414DF C9          0287*   	ret
0414E0 17 00 C0    0288*   @cmd: db 23,0,0xC0
0414E3 00          0289*   @arg: db 0  ; scaling on/off
0414E4             0290*   @end:
0414E4             0291*   
0414E4             0292*   ; VDU 23, 27, &20, bufferId; : Select bitmap (using a buffer ID)
0414E4             0293*   ; inputs: hl=bufferId
0414E4             0294*   vdu_buff_select:
0414E4 22 F6 14 04 0295*   	ld (@bufferId),hl
0414E8 21 F3 14 04 0296*   	ld hl,@cmd
0414EC 01 05 00 00 0297*   	ld bc,@end-@cmd
0414F0 5B DF       0298*   	rst.lil $18
0414F2 C9          0299*   	ret
0414F3 17 1B 20    0300*   @cmd: db 23,27,0x20
0414F6 00 00       0301*   @bufferId: dw 0x0000
0414F8 00          0302*   @end: db 0x00 ; padding
0414F9             0303*   
0414F9             0304*   ; VDU 23, 27, &21, w; h; format: Create bitmap from selected buffer
0414F9             0305*   ; inputs: a=format; bc=width; de=height
0414F9             0306*   ; prerequisites: buffer selected by vdu_bmp_select or vdu_buff_select
0414F9             0307*   ; formats: https://agonconsole8.github.io/agon-docs/VDP---Bitmaps-API.html
0414F9             0308*   ; 0 	RGBA8888 (4-bytes per pixel)
0414F9             0309*   ; 1 	RGBA2222 (1-bytes per pixel)
0414F9             0310*   ; 2 	Mono/Mask (1-bit per pixel)
0414F9             0311*   ; 3 	Reserved for internal use by VDP (“native” format)
0414F9             0312*   vdu_bmp_create:
0414F9 ED 43 15 15 0313*       ld (@width),bc
       04          
0414FE ED 53 17 15 0314*       ld (@height),de
       04          
041503 32 19 15 04 0315*       ld (@fmt),a
041507 21 12 15 04 0316*   	ld hl,@cmd
04150B 01 08 00 00 0317*   	ld bc,@end-@cmd
04150F 5B DF       0318*   	rst.lil $18
041511 C9          0319*   	ret
041512 17 1B 21    0320*   @cmd:       db 23,27,0x21
041515 00 00       0321*   @width:     dw 0x0000
041517 00 00       0322*   @height:    dw 0x0000
041519 00          0323*   @fmt:       db 0x00
04151A             0324*   @end:
04151A             0325*   
04151A             0326*   ; load an rgba2222 image file to a working buffer and make it an rgba8888 bitmap in a target buffer
04151A             0327*   ; inputs: bc,de image width,height ; hl = targetBufferId ; ix = file size ; iy = pointer to filename
04151A             0328*   vdu_load_img_rgba2_to_8:
04151A             0329*   ; backup the target buffer id and image dimensions
04151A E5          0330*       push hl
04151B D5          0331*       push de
04151C C5          0332*       push bc
04151D             0333*   ; load the rgba2 image to working buffer 65534
04151D 21 FE FF 00 0334*       ld hl,65534 ; temporary working buffer id
041521 CD 2A 16 04 0335*   	call vdu_load_buffer_from_file
041525             0336*   ; restore the image dimensions and target buffer id
041525 C1          0337*       pop bc
041526 D1          0338*       pop de
041527 E1          0339*       pop hl
041528 D0          0340*       ret nc ; leave the cleared target untouched when the source cannot open
041529             0341*   ; fall through to vdu_rgba2_to_8
041529             0342*   
041529             0343*   ; https://discord.com/channels/1158535358624039014/1158536711148675072/1257757461729771771
041529             0344*   ; ok, so the "expand bitmap" can be used, when coupled with a "reverse" - the expanded bitmap _doesn't_ come out "right" otherwise, cos of endian-ness
041529             0345*   ; the "expand bitmap" command is:
041529             0346*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
041529             0347*   ; and then to reverse the byte order to fix endian-ness:
041529             0348*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
041529             0349*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
041529             0350*   ; VDU 23,27,&20,targetBufferID%;
041529             0351*   ; VDU 23,27,&21,width%;height%;0
041529             0352*   ; -------------------------------------------------------------------
041529             0353*   ; inputs: bc,de image width,height ; hl = targetBufferId
041529             0354*   ; prerequisites: rgba2 image data loaded into workingBufferId 65534
041529             0355*   vdu_rgba2_to_8:
041529             0356*   ; load the image dimensions and buffer id parameters
041529 ED 43 85 15 0357*       ld (@width),bc
       04          
04152E ED 53 87 15 0358*       ld (@height),de
       04          
041533 22 6A 15 04 0359*       ld (@bufferId0),hl
041537 22 77 15 04 0360*       ld (@bufferId2),hl
04153B 22 80 15 04 0361*       ld (@bufferId1),hl
04153F             0362*   ; clean up bytes that got stomped on by the ID loads
04153F 3E 48       0363*       ld a,0x48
041541 32 6C 15 04 0364*       ld (@bufferId0+2),a
041545 3E 17       0365*       ld a,23
041547 32 82 15 04 0366*       ld (@bufferId1+2),a
04154B 3E 18       0367*       ld a,24
04154D 32 79 15 04 0368*       ld (@bufferId2+2),a
041551 AF          0369*       xor a
041552 32 89 15 04 0370*       ld (@height+2),a
041556             0371*   ; send the vdu command strings
041556 21 61 15 04 0372*       ld hl,@beg
04155A 01 29 00 00 0373*       ld bc,@end-@beg
04155E 5B DF       0374*       rst.lil $18
041560 C9          0375*       ret
041561             0376*   @beg:
041561             0377*   ; Command 14: Consolidate blocks in a buffer
041561             0378*   ; VDU 23, 0, &A0, bufferId; 14
041561 17 00 A0    0379*       db 23,0,0xA0
041564 FE FF       0380*       dw 65534 ; workingBufferId
041566 0E          0381*       db 14 ; consolidate blocks
041567             0382*   ; the "expand bitmap" command is:
041567             0383*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
041567 17 00 A0    0384*       db 23,0,0xA0
04156A 00 00       0385*   @bufferId0: dw 0x0000 ; targetBufferId
04156C 48          0386*       db 0x48 ; given as decimal command 72 in the docs
04156D 02          0387*       db 2 ; options mask: %00000011 is the number of bits per pixel in the source bitmap
04156E FE FF       0388*       dw 65534 ; sourceBufferId
041570 00 7F BF FF 0389*       db 0x00,0x7F,0xBF,0xFF ; expanding to bytes by bit-shifting?
041574             0390*   ; reverse the byte order to fix endian-ness:
041574             0391*   ; Command 24: Reverse the order of data of blocks within a buffer
041574             0392*   ; VDU 23, 0, &A0, bufferId; 24, options, [valueSize;] [chunkSize;]
041574             0393*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
041574 17 00 A0    0394*       db 23,0,0xA0
041577 00 00       0395*   @bufferId2:    dw 0x0000 ; targetBufferId
041579 18          0396*       db 24 ; reverse byte order
04157A 04          0397*       db 4 ; option: Reverse data of the value size within chunk of data of the specified size
04157B 04 00       0398*       dw 4 ; size (4 bytes)
04157D             0399*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
04157D             0400*   ; VDU 23,27,&20,targetBufferID%;
04157D 17 1B 20    0401*       db 23,27,0x20 ; select bitmap
041580 00 00       0402*   @bufferId1: dw 0x0000 ; targetBufferId
041582             0403*   ; VDU 23,27,&21,width%;height%;0
041582 17 1B 21    0404*       db 23,27,0x21 ; create bitmap from buffer
041585 00 00       0405*   @width: dw 0x0000
041587 00 00       0406*   @height: dw 0x0000
041589 00          0407*       db 0x00 ; rgba8888 format
04158A             0408*   @end:
04158A             0409*   
04158A             0410*   ; scratch variables
04158A 00 00 00    0411*   bufferId0: dl 0x000000
04158D 00 00 00    0412*   bufferId1: dl 0x000000
041590             0413*   
041590             0414*   ; load a vdu buffer from local memory
041590             0415*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
041590             0416*   vdu_load_buffer:
041590 ED 43 B9 15 0417*       ld (@length),bc
       04          
041595 D5          0418*       push de ; save data pointer
041596             0419*   ; send the vdu command string
041596 7D          0420*       ld a,l
041597 32 B6 15 04 0421*       ld (@bufferId),a
04159B 7C          0422*       ld a,h
04159C 32 B7 15 04 0423*       ld (@bufferId+1),a
0415A0 21 B3 15 04 0424*       ld hl,@cmd
0415A4 01 08 00 00 0425*       ld bc,@end-@cmd
0415A8 5B DF       0426*       rst.lil $18
0415AA             0427*   ; send the buffer data
0415AA E1          0428*       pop hl ; pointer to data
0415AB ED 4B B9 15 0429*       ld bc,(@length)
       04          
0415B0 5B DF       0430*       rst.lil $18 ; send it
0415B2 C9          0431*       ret
0415B3             0432*   ; Upload data :: VDU 23, 0 &A0, bufferId; 0, length; <buffer-data>
0415B3 17 00 A0    0433*   @cmd:       db 23,0,0xA0
0415B6 00 00       0434*   @bufferId:	dw 0x0000
0415B8 00          0435*   		    db 0 ; load buffer
0415B9 00 00       0436*   @length:	dw 0x0000
0415BB 00          0437*   @end: db 0 ; padding
0415BC             0438*   
0415BC             0439*   ; Command 14: Consolidate blocks in a buffer
0415BC             0440*   vdu_consolidate_buffer:
0415BC             0441*   ; set parameters for vdu call
0415BC 7D          0442*       ld a,l
0415BD 32 D4 15 04 0443*       ld (@bufferId),a
0415C1 7C          0444*       ld a,h
0415C2 32 D5 15 04 0445*       ld (@bufferId+1),a
0415C6 21 D1 15 04 0446*       ld hl,@beg
0415CA 01 06 00 00 0447*       ld bc,@end-@beg
0415CE 5B DF       0448*       rst.lil $18
0415D0 C9          0449*       ret
0415D1             0450*   ; VDU 23, 0, &A0, bufferId; 14
0415D1 17 00 A0    0451*   @beg: db 23,0,0xA0
0415D4 00 00       0452*   @bufferId: dw 0x0000
0415D6 0E          0453*              db 14
0415D7             0454*   @end:
0415D7             0455*   
0415D7             0456*   ; Convert a consolidated buffer to an explicitly rated audio sample.
0415D7             0457*   ; This is a dependency of the canonical AGNB API's dormant audio entry point;
0415D7             0458*   ; Purple Nurples currently creates no audio container and does not call it.
0415D7             0459*   ; inputs: HL=bufferId, A=base format (0 signed, 1 unsigned), DE=sample rate
0415D7             0460*   vdu_buffer_to_sound:
0415D7 22 F7 15 04 0461*       ld (@bufferId),hl
0415DB C6 08       0462*       add a,8
0415DD 32 F9 15 04 0463*       ld (@format),a
0415E1 ED 53 FA 15 0464*       ld (@sampleRate),de
       04          
0415E6 21 F1 15 04 0465*       ld hl,@cmd
0415EA 01 0B 00 00 0466*       ld bc,@end-@cmd
0415EE 5B DF       0467*       rst.lil $18
0415F0 C9          0468*       ret
0415F1 17 00 85    0469*   @cmd:        db 23,0,$85
0415F4 00 05 02    0470*                db 0,5,2
0415F7 00 00       0471*   @bufferId:   dw 0
0415F9 00          0472*   @format:     db 0
0415FA 00 00       0473*   @sampleRate: dw 0
0415FC             0474*   ; Native ADL stores three bytes from DE. This byte absorbs DEU outside the VDU
0415FC             0475*   ; packet, matching the canonical dependency implementation.
0415FC 00          0476*   @end:        db 0
0415FD             0477*   
0415FD             0478*   ; load an image file to a buffer and make it a bitmap
0415FD             0479*   ; inputs: a = image type ; bc,de image width,height ; hl = bufferId ; ix = file size ; iy = pointer to filename
0415FD             0480*   vdu_load_img:
0415FD             0481*   ; back up image type and dimension parameters
0415FD 22 8A 15 04 0482*       ld (bufferId0),hl
041601 F5          0483*       push af
041602 C5          0484*   	push bc
041603 D5          0485*   	push de
041604             0486*   ; load the image
041604 CD 2A 16 04 0487*   	call vdu_load_buffer_from_file
041608 DA 11 16 04 0488*       jp c,@loaded
04160C             0489*   ; balance the saved arguments and fail without creating an empty bitmap
04160C D1          0490*   	pop de
04160D C1          0491*   	pop bc
04160E F1          0492*   	pop af
04160F B7          0493*       or a ; preserve A while reasserting the carry-clear failure contract
041610 C9          0494*       ret
041611             0495*   @loaded:
041611             0496*   ; now make it a bitmap
041611 2A 8A 15 04 0497*       ld hl,(bufferId0)
041615 CD BC 15 04 0498*       call vdu_consolidate_buffer
041619 2A 8A 15 04 0499*       ld hl,(bufferId0)
04161D CD E4 14 04 0500*       call vdu_buff_select
041621 D1          0501*   	pop de ; image height
041622 C1          0502*   	pop bc ; image width
041623 F1          0503*   	pop af ; image type
041624 CD F9 14 04 0504*   	call vdu_bmp_create
041628 37          0505*       scf
041629 C9          0506*       ret
04162A             0507*   
04162A             0508*   ; inputs: hl = bufferId; iy = pointer to filename
04162A             0509*   ; outputs: carry set after a complete read/close; carry clear if open failed
04162A             0510*   vdu_load_buffer_from_file:
04162A 22 8A 15 04 0511*       ld (bufferId0),hl
04162E             0512*   
04162E             0513*   ; clear target buffer
04162E CD DA 17 04 0514*       call vdu_clear_buffer
041632             0515*   
041632             0516*   ; open the file in read mode
041632             0517*   ; Open a file
041632             0518*   ; HLU: Filename
041632             0519*   ;   C: Mode
041632             0520*   ; Returns:
041632             0521*   ;   A: Filehandle, or 0 if couldn't open
041632 FD E5       0522*   	push iy ; pointer to filename
041634 E1          0523*   	pop hl
041635 0E 01       0524*       ld c,fa_read
041637             0525*       MOSCALL mos_fopen
                       M1 Args: function=mos_fopen 
041637 3E 0A       0001*M1 			LD	A, function
041639 5B CF       0002*M1 			RST.LIL	08h
04163B B7          0526*       or a
04163C C8          0527*       ret z ; carry clear: do not read or close the all-files handle zero
04163D 32 7A 16 04 0528*       ld (@filehandle),a
041641             0529*   
041641             0530*   @read_file:
041641             0531*   ; Read a block of data from a file
041641             0532*   ;   C: Filehandle
041641             0533*   ; HLU: Pointer to where to write the data to
041641             0534*   ; DEU: Number of bytes to read
041641             0535*   ; Returns:
041641             0536*   ; DEU: Number of bytes read
041641 3A 7A 16 04 0537*       ld a,(@filehandle)
041645 4F          0538*       ld c,a
041646 21 00 E0 B7 0539*       ld hl,filedata
04164A 11 00 20 00 0540*       ld de,8192 ; max we can read into onboard sram at one time
04164E             0541*       MOSCALL mos_fread
                       M1 Args: function=mos_fread 
04164E 3E 1A       0001*M1 			LD	A, function
041650 5B CF       0002*M1 			RST.LIL	08h
041652             0542*   
041652             0543*   ; test de for zero bytes read
041652 21 00 00 00 0544*       ld hl,0
041656 AF          0545*       xor a ; clear carry
041657 ED 52       0546*       sbc hl,de
041659 CA 6F 16 04 0547*       jp z,@close_file
04165D             0548*   
04165D             0549*   ; load a vdu buffer from local memory
04165D             0550*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
04165D 2A 8A 15 04 0551*       ld hl,(bufferId0)
041661 D5          0552*       push de ; chunksize
041662 C1          0553*       pop bc
041663 11 00 E0 B7 0554*       ld de,filedata
041667 CD 90 15 04 0555*       call vdu_load_buffer
04166B             0556*   
04166B             0557*   ; read the next block
04166B C3 41 16 04 0558*       jp @read_file
04166F             0559*   
04166F             0560*   ; close the file
04166F             0561*   @close_file:
04166F 3A 7A 16 04 0562*       ld a,(@filehandle)
041673 4F          0563*       ld c,a
041674             0564*       MOSCALL mos_fclose
                       M1 Args: function=mos_fclose 
041674 3E 0B       0001*M1 			LD	A, function
041676 5B CF       0002*M1 			RST.LIL	08h
041678 37          0565*       scf
041679 C9          0566*       ret ; vdu_load_buffer_from_file
04167A             0567*   
