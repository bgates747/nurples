04669F 19          0124*       add hl,de
0466A0 DD 2F 04    0125*       ld (ix+sprite_y),hl
0466A3             0126*   ; set laser velocity
0466A3 21 00 FC FF 0127*       ld hl,-laser_speed
0466A7 DD 2F 0A    0128*       ld (ix+sprite_yvel),hl
