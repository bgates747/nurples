041205 2A 14 12 04 0187*   	ld hl,(prt_irq_counter)
041209 23          0188*   	inc hl
04120A 22 14 12 04 0189*   	ld (prt_irq_counter),hl
04120E E1          0190*       pop hl
04120F F1          0191*   	pop af
041210 FB          0192*   	ei
041211 5B ED 4D    0193*   	reti.l
