047A77             0044*   kill_electrode:
047A77             0045*   ; Preserve the source record itself. Removing earlier stack entries may change
047A77             0046*   ; its dense-stack slot, so the slot is rediscovered after the scan.
047A77 FD 22 C6 7B 0047*       ld (@source_tile_pointer),iy
       04          
047A7C FD 27 04    0048*       ld hl,(iy+tile_y)
