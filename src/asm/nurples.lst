047A58 CB C6       0161*       set tile_fault_bad_record,(hl)
047A5A 3A 18 73 04 0162*       ld a,(num_active_tiles)
047A5E 21 00 00 00 0163*       ld hl,0
047A62 67          0164*       ld h,a
