0485E0             0072        include "targeting.inc"
0485E0             0001*   ; compute orientation to player
0485E0             0002*   ; based on relative positions
0485E0             0003*   ; returns: uh.l 16.8 fixed angle256 to player
0485E0             0004*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
0485E0             0005*   ;    representing delta-x/y *to* target respectively
0485E0             0006*   ; inputs: iy pointed at sprite record
0485E0             0007*   ; destroys: everything except iy (sprite record pointer)
0485E0             0008*   orientation_to_player:
0485E0 DD 21 03 A0 0009*       ld ix,player_begin
       04          
0485E5             0010*   ; compute dx
0485E5 DD 27 01    0011*       ld hl,(ix+sprite_x)
0485E8 FD 17 01    0012*       ld de,(iy+sprite_x)
0485EB B7          0013*       or a ; clear carry
0485EC ED 52       0014*       sbc hl,de ; dx
0485EE E5          0015*       push hl ; save dx
0485EF             0016*   ; compute dy
0485EF DD 27 04    0017*       ld hl,(ix+sprite_y)
0485F2 FD 17 04    0018*       ld de,(iy+sprite_y)
0485F5 B7          0019*       or a ; clear carry
0485F6 ED 52       0020*       sbc hl,de ; dy
0485F8 EB          0021*       ex de,hl ; de = dy
0485F9             0022*   ; compute angle to player
0485F9 C1          0023*       pop bc ; dx (was hl)
0485FA C5          0024*       push bc ; save dx
0485FB D5          0025*       push de ; save dy
0485FC CD EE 07 04 0026*       call atan2_168fast ; uh.l = angle to player
048600 3E E0       0027*       ld a,%11100000
048602 A5          0028*       and l ; round angle to nearest 32th of a circle
048603 6F          0029*       ld l,a
048604 22 55 86 04 0030*       ld (Bearing_t),hl ; return angle to player
048608 D1          0031*       pop de ; restore dy
048609 C1          0032*       pop bc ; restore dx
04860A C9          0033*       ret
04860B             0034*   ; end orientation_to_player
04860B             0035*   
04860B             0036*   ; compute orientation to player
04860B             0037*   ; based on relative positions
04860B             0038*   ; returns: uh.l 16.8 fixed angle256 to player
04860B             0039*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
04860B             0040*   ;    representing delta-x/y *to* target respectively
04860B             0041*   ; inputs: iy pointed at tile record
04860B             0042*   ; destroys: everything except iy (tile record pointer)
04860B             0043*   tile_orientation_to_player:
04860B DD 21 03 A0 0044*       ld ix,player_begin
       04          
048610             0045*   ; compute dx
048610 DD 27 01    0046*       ld hl,(ix+sprite_x)
048613 FD 17 01    0047*       ld de,(iy+tile_x)
048616 B7          0048*       or a ; clear carry
048617 ED 52       0049*       sbc hl,de ; dx
048619 E5          0050*       push hl ; save dx
04861A             0051*   ; compute dy
04861A DD 27 04    0052*       ld hl,(ix+sprite_y)
04861D FD 17 04    0053*       ld de,(iy+tile_y)
048620 B7          0054*       or a ; clear carry
048621 ED 52       0055*       sbc hl,de ; dy
048623 EB          0056*       ex de,hl ; de = dy
048624             0057*   ; compute angle to player
048624 C1          0058*       pop bc ; dx (was hl)
048625 CD EE 07 04 0059*       call atan2_168fast ; uh.l = angle to player
048629 3E E0       0060*       ld a,%11100000
04862B A5          0061*       and l ; round angle to nearest 32th of a circle
04862C 6F          0062*       ld l,a
04862D 22 55 86 04 0063*       ld (Bearing_t),hl
048631 C9          0064*       ret
048632             0065*   ; end tile_orientation_to_player
048632             0066*   
048632             0067*   ; compute orientation to coordinate
048632             0068*   ; based on relative positions
048632             0069*   ; returns: uh.l 16.8 fixed angle256 to coordinate
048632             0070*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
048632             0071*   ;    representing delta-x/y *to* target respectively
048632             0072*   ; inputs: iy pointed at sprite record, ub.c,ud.e are target x,y coordinates
048632             0073*   ; destroys: everything except iy (sprite record pointer)
048632             0074*   bearing_to_coord:
048632             0075*   ; compute dx
048632 C5          0076*       push bc
048633 E1          0077*       pop hl
048634 FD 07 01    0078*       ld bc,(iy+sprite_x)
048637 B7          0079*       or a ; clear carry
048638 ED 42       0080*       sbc hl,bc ; dx
04863A E5          0081*       push hl ; save dx
04863B             0082*   ; compute dy
04863B EB          0083*       ex de,hl
04863C FD 17 04    0084*       ld de,(iy+sprite_y)
04863F B7          0085*       or a ; clear carry
048640 ED 52       0086*       sbc hl,de ; dy
048642 EB          0087*       ex de,hl ; de = dy
048643             0088*   ; compute angle to coordinate
048643 C1          0089*       pop bc ; dx (was hl)
048644 C5          0090*       push bc ; save dx
048645 D5          0091*       push de ; save dy
048646 CD EE 07 04 0092*       call atan2_168fast ; uh.l = angle to coordinate
04864A 3E E0       0093*       ld a,%11100000
04864C A5          0094*       and l ; round angle to nearest 32th of a circle
04864D 6F          0095*       ld l,a
04864E 22 55 86 04 0096*       ld (Bearing_t),hl ; return angle to coordinate
048652 D1          0097*       pop de ; restore dy
048653 C1          0098*       pop bc ; restore dx
048654 C9          0099*       ret
048655             0100*   ; end bearing_to_coord
048655             0101*   
048655             0102*   ; targeting_computer variables fixed 16.8 format
048655 00 00 00    0103*   Bearing_t: dl 0x000000 ; angle to target
048658 00 00 00    0104*   Heading_t: dl 0x000000 ; angle of target motion
04865B 00 00 00    0105*   Vp: dl 0x000000 ; velocity of projectile
04865E 00 00 00    0106*   Vp_x: dl 0x000000 ; x component of projectile velocity
048661 00 00 00    0107*   Vp_y: dl 0x000000 ; y component of projectile velocity
048664 00 00 00    0108*   Vt: dl 0x000000 ; velocity of target
048667 00 00 00    0109*   Vt_x: dl 0x000000 ; x component of target velocity
04866A 00 00 00    0110*   Vt_y: dl 0x000000 ; y component of target velocity
04866D 00 00 00    0111*   Heading_p: dl 0x000000 ; angle of projectile motion
048670 00 00 00    0112*   lead_angle: dl 0x000000 ; lead angle
048673             0113*   
048673             0114*   ; Inputs:   Vp velocity of projectile set,
048673             0115*   ;           iy pointed to sprite record,
048673             0116*   ;           player position and velocities correctly set
048673             0117*   ; Outputs:  uh.l is the 16.8 fixed firing angle256
048673             0118*   ;           ub.c and ud.e are the 16.8 fixed x,y component projectile velocities
048673             0119*   ; https://old.robowiki.net/cgi-bin/robowiki?LinearTargeting
048673             0120*   targeting_computer:
048673 DD 21 03 A0 0121*       ld ix,player_begin
       04          
048678             0122*   ; ; compute target velocity from x,y component velocities
048678             0123*   ;     ld bc,(ix+sprite_xvel)
048678             0124*   ;     ld de,(ix+sprite_yvel)
048678             0125*   ;     ld hl,-1*256 ; account for vertical ground movement
048678             0126*   ;     add hl,de
048678             0127*   ;     ex de,hl ; ud.e = player_yvel-1
048678             0128*   ;     call cartesian_to_polar_sm ; uh.l = Heading_t, ud.e = Vt
048678             0129*   ;     ld (Heading_t),hl ; PASSES
048678             0130*   ;     ld (Vt),de ; PASSES
048678             0131*   ; ; Bearing_t should have been set by prerequisite call to orientation_to_player
048678             0132*   ; ; compute Heading_t-Bearing_t PASSES
048678             0133*   ;     ld de,(Bearing_t)
048678             0134*   ;     and a ; clear carry
048678             0135*   ;     sbc hl,de ; Uh.l = Heading_t-Bearing_t
048678             0136*   ; ; compute sin(Heading_t-Bearing_t)
048678             0137*   ;     call sin168 ; uh.l = sin(Heading_t-Bearing_t)
048678             0138*   ; ; compute (Vt*sin(Heading_t-Bearing_t))
048678             0139*   ;     ld de,(Vt)
048678             0140*   ;     call smul168 ; uh.l = (Vt*sin(Heading_t-Bearing_t))
048678             0141*   ; ; compute (Vt * sin(Heading_t-Bearing_t)) / Vp
048678             0142*   ;     ld de,(Vp)
048678             0143*   ;     call sdiv168 ; ud.e = (Vt*sin(Heading_t-Bearing_t)) / Vp
048678             0144*   ;     ex de,hl ; uh.l = (Vt*sin(Heading_t-Bearing_t)) / Vp
048678             0145*   ; ; answer is in radians, convert to degrees256
048678             0146*   ;     ld de,0x0028BE ; 40.74 = 57.29578*256/360
048678             0147*   ;     call smul168 ; uh.l = angle in degrees256
048678             0148*   ;     ld (lead_angle),hl ; TODO: fix this
048678             0149*   ; ; add lead angle to target bearing
048678             0150*   ;     ld de,(Bearing_t)
048678             0151*   ;     add hl,de ; h.l = lead angle+target bearing
048678             0152*   
048678 2A 55 86 04 0153*       ld hl,(Bearing_t) ; TODO: fix this
04867C             0154*   
04867C E5          0155*       push hl
04867D             0156*   
04867D             0157*   ; compute component projectile velocities
04867D ED 5B 5B 86 0158*       ld de,(Vp) ; Vp should have been set by caller
       04          
048682 CD F4 06 04 0159*       call polar_to_cartesian ; ub.c = Vp_x, ud.e = Vp_y
048686 ED 43 5E 86 0160*       ld (Vp_x),bc
       04          
04868B             0161*       ; inc d ; account for vertical ground movement
04868B ED 53 61 86 0162*       ld (Vp_y),de
       04          
048690 E1          0163*       pop hl ; uh.l = lead angle+target bearing
048691 22 6D 86 04 0164*       ld (Heading_p),hl
048695             0165*   
048695 C9          0166*       ret
048696             0167*   
