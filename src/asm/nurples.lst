04777F             0157*   
04777F             0158*   bar_val: equ 0 ; current value
04777F             0159*   bar_x0: equ panel_x0
04777F             0160*   bar_y0: equ panel_y0
04777F             0161*   bar_x1: equ panel_x1
04777F             0162*   bar_y1: equ panel_y1
04777F             0163*   bar_y: equ 15 ; y-plot coordinate
04777F             0164*   bar_x: equ 15 ; x-plot coordinate
04777F             0165*   
04777F             0166*   bar_yellow: equ 33
04777F             0167*   bar_red: equ 17
04777F             0168*   
04777F             0169*   ; update a vertical bar display
04777F             0170*   ; inputs: ix points to bar structure
04777F             0171*   ;         bar_val set by caller
04777F             0172*   ; prerequisite: bar_init called before first use
04777F             0173*   bar_update_v:
04777F             0174*   ; set gfx viewport
04777F DD E5       0175*       push ix ; preserve pointer
047781 DD 07 03    0176*       ld bc,(ix+bar_x0)
047784 DD 17 06    0177*       ld de,(ix+bar_y0)
047787 DD 31 0C    0178*       ld iy,(ix+bar_y1)
04778A DD 37 09    0179*       ld ix,(ix+bar_x1)
04778D CD D7 14 04 0180*       call vdu_set_gfx_viewport
047791 DD E1       0181*       pop ix ; restore pointer
047793             0182*   ; select the color based on the value thresholds
047793 DD 17 00    0183*       ld de,(ix+bar_val)
047796 21 EF FF FF 0184*       ld hl,-bar_red
04779A 19          0185*       add hl,de
04779B D2 B8 77 04 0186*       jp nc,@red
04779F 21 DF FF FF 0187*       ld hl,-bar_yellow
0477A3 19          0188*       add hl,de
0477A4 D2 B0 77 04 0189*       jp nc,@yellow
0477A8 21 05 00 00 0190*       ld hl,BUF_BAR_V_2 ; green
0477AC C3 BC 77 04 0191*       jp @select
0477B0             0192*   @yellow:
0477B0 21 04 00 00 0193*       ld hl,BUF_BAR_V_1 ; yellow
0477B4 C3 BC 77 04 0194*       jp @select
0477B8             0195*   @red:
0477B8 21 03 00 00 0196*       ld hl,BUF_BAR_V_0 ; red
0477BC             0197*   @select:
0477BC CD 2C 15 04 0198*       call vdu_buff_select
0477C0             0199*   ; get x-plot position
0477C0 DD 07 03    0200*       ld bc,(ix+bar_x0)
0477C3             0201*   ; compute y-plot position
0477C3 DD 17 00    0202*       ld de,(ix+bar_val)
0477C6 21 40 00 00 0203*       ld hl,64
0477CA AF          0204*       xor a ; clear carry
0477CB ED 52       0205*       sbc hl,de
0477CD DD 17 0F    0206*       ld de,(ix+bar_y)
0477D0 19          0207*       add hl,de
0477D1 7D          0208*       ld a,l
0477D2 E6 FC       0209*       and %11111100 ; round to nearest 4 pixels
0477D4 6F          0210*       ld l,a
0477D5 EB          0211*       ex de,hl
0477D6 CD 62 19 04 0212*       call vdu_plot_bmp
0477DA C9          0213*       ret
0477DB             0214*   ; end bar_update_v
0477DB             0215*   
0477DB             0216*   ; update a horizontal bar display
0477DB             0217*   ; inputs: ix points to bar structure
0477DB             0218*   ;         bar_val set by caller
0477DB             0219*   ; prerequisite: bar_init called before first use
0477DB             0220*   bar_update_h:
0477DB             0221*   ; set gfx viewport
0477DB DD E5       0222*       push ix ; preserve pointer
0477DD DD 07 03    0223*       ld bc,(ix+bar_x0)
0477E0 DD 17 06    0224*       ld de,(ix+bar_y0)
0477E3 DD 31 0C    0225*       ld iy,(ix+bar_y1)
0477E6 DD 37 09    0226*       ld ix,(ix+bar_x1)
0477E9 CD D7 14 04 0227*       call vdu_set_gfx_viewport
0477ED DD E1       0228*       pop ix ; restore pointer
0477EF             0229*   ; select the color based on the value thresholds
0477EF DD 17 00    0230*       ld de,(ix+bar_val)
0477F2 21 EF FF FF 0231*       ld hl,-bar_red
0477F6 19          0232*       add hl,de
0477F7 D2 14 78 04 0233*       jp nc,@red
0477FB 21 DF FF FF 0234*       ld hl,-bar_yellow
0477FF 19          0235*       add hl,de
047800 D2 0C 78 04 0236*       jp nc,@yellow
047804 21 02 00 00 0237*       ld hl,BUF_BAR_H_2 ; green
047808 C3 18 78 04 0238*       jp @select
04780C             0239*   @yellow:
04780C 21 01 00 00 0240*       ld hl,BUF_BAR_H_1 ; yellow
047810 C3 18 78 04 0241*       jp @select
047814             0242*   @red:
047814 21 00 00 00 0243*       ld hl,BUF_BAR_H_0 ; red
047818             0244*   @select:
047818 CD 2C 15 04 0245*       call vdu_buff_select
04781C             0246*   ; compute x-plot position
04781C DD 27 00    0247*       ld hl,(ix+bar_val)
04781F DD 07 0F    0248*       ld bc,(ix+bar_x)
047822 09          0249*       add hl,bc
047823 7D          0250*       ld a,l
047824 E6 FC       0251*       and %11111100 ; round to nearest 4 pixels
047826 6F          0252*       ld l,a
047827 E5          0253*       push hl
047828 C1          0254*       pop bc
047829             0255*   ; get y-plot position
047829 DD 17 06    0256*       ld de,(ix+bar_y0)
04782C CD 62 19 04 0257*       call vdu_plot_bmp
047830 C9          0258*       ret
047831             0259*   ; end bar_update_h
047831             0066        include "player_fuel.inc"
047831             0001*   
047831             0002*   bar_fuel:
047831 00 00 00    0003*       dl 0 ; value
047834 30 00 00    0004*       dl 48 ; x0
047837 08 01 00    0005*       dl 264 ; y0
04783A 6F 00 00    0006*       dl 48+63 ; x1
04783D 0F 01 00    0007*       dl 264+7 ; y1
047840 F0 FF FF    0008*       dl 48-64 ; x-plot coordinate
047843             0009*   
047843             0010*   init_bar_fuel:
047843 DD 21 31 78 0011*       ld ix,bar_fuel
       04          
047848 21 00 00 00 0012*       ld hl,0
04784C 3A 5B 78 04 0013*       ld a,(player_fuel_max)
047850 6F          0014*       ld l,a
047851 DD 2F 00    0015*       ld (ix+bar_val),hl
047854 CD DB 77 04 0016*       call bar_update_h
047858 C9          0017*       ret
047859             0018*   ; end init_bar_fuel
047859             0019*   
047859 40          0020*   player_fuel: db 64 ; integer
04785A 00          0021*   player_fuel_last: db 0 ; integer
04785B 40          0022*   player_fuel_max: db 64 ; integer
04785C 00          0023*   discharge_fuel_timer: db 0
04785D 40          0024*   discharge_fuel_timer_max: db 64 ;
04785E             0025*   discharge_fuel:
04785E             0026*   ; check fuel timer
04785E 21 5C 78 04 0027*       ld hl,discharge_fuel_timer
047862 35          0028*       dec (hl)
047863 C0          0029*       ret nz ; not time to discharge fuel so return
047864             0030*   ; reset fuel discharge timer
047864 3A 5D 78 04 0031*       ld a,(discharge_fuel_timer_max)
047868 77          0032*       ld (hl),a
047869             0033*   ; discharge fuel
047869 21 59 78 04 0034*       ld hl,player_fuel
04786D 35          0035*       dec (hl)
04786E CA 77 78 04 0036*       jp z,@no_fuel
047872 FA 77 78 04 0037*       jp m,@no_fuel
047876 C9          0038*       ret ; fuel not zero so return
047877             0039*   @no_fuel:
047877 36 00       0040*       ld (hl),0 ; TODO: implement out-of-fuel handler
047879 C9          0041*       ret
04787A             0042*   ; end discharge_fuel
04787A             0043*   
04787A             0044*   draw_fuel:
04787A CD 5E 78 04 0045*       call discharge_fuel
04787E 21 5A 78 04 0046*       ld hl,player_fuel_last
047882 3A 59 78 04 0047*       ld a,(player_fuel)
047886 BE          0048*       cp (hl)
047887 C8          0049*       ret z ; no change to update
047888 77          0050*       ld (hl),a
047889 DD 21 31 78 0051*       ld ix,bar_fuel
       04          
04788E DD 77 00    0052*       ld (ix+bar_val),a ; TODO: this is redundant
047891 CD DB 77 04 0053*       call bar_update_h
