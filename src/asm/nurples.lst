0480E1             0093*   ; destroys: a,hl
0480E1             0094*   table_deactivate_sprite:
0480E1 FD 7E 00    0095*       ld a,(iy+sprite_id) ; get spriteId
0480E4 CD D7 18 04 0096*       call vdu_sprite_select ; select sprite
0480E8 CD 5B 19 04 0097*       call vdu_sprite_hide
0480EC FD CB 1D B6 0098*       res sprite_alive,(iy+sprite_collisions)
0480F0 FD CB 1D BE 0099*       res sprite_just_died,(iy+sprite_collisions)
0480F4 C9          0100*       ret
0480F5             0101*   ; end table_deactivate_sprite
