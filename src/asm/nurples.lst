048287             0307*   
048287             0308*   ; compute a sprite's new position based on its component x,y velocities
048287             0309*   ; with screen boundary checking and update its sprite table record accordingly
048287             0310*   ; inputs: table_pointer set to sprite record
048287             0311*   ; returns: updated x, y positions and edge collision flags in sprite_screen_edge
048287             0312*   ; destroys: everything
048287             0313*   ; note: actual rendering of sprite must be handled by caller
048287             0314*   move_sprite:
048287 FD 2A C2 80 0315*       ld iy,(table_pointer)
       04          
04828C             0316*   ; x-axis movement
04828C FD 27 01    0317*       ld hl,(iy+sprite_x)
04828F FD 17 07    0318*       ld de,(iy+sprite_xvel)
048292 19          0319*       add hl,de
048293 FD 2F 01    0320*       ld (iy+sprite_x),hl
048296             0321*   ; y-axis movement
048296 FD 27 04    0322*       ld hl,(iy+sprite_y)
048299 FD 17 0A    0323*       ld de,(iy+sprite_yvel)
04829C 19          0324*       add hl,de
04829D FD 2F 04    0325*       ld (iy+sprite_y),hl
0482A0             0326*   ; detect screen edge collisions
0482A0 AF          0327*       xor a ; reset screen edge collision flag and clear carry
0482A1 32 C5 80 04 0328*       ld (sprite_screen_edge),a
0482A5             0329*   ; y-axis first since we already have it in hl
0482A5 11 00 00 00 0330*       ld de,-sprite_top*256
0482A9 ED 5A       0331*       adc hl,de
0482AB FA D5 82 04 0332*       jp m,@top
0482AF ED 52       0333*       sbc hl,de ; hl back to original value
0482B1 11 00 C0 FE 0334*       ld de,-sprite_bottom*256
0482B5 ED 5A       0335*       adc hl,de
0482B7 F2 DF 82 04 0336*       jp p,@bottom
0482BB             0337*   @xaxis:
0482BB FD 27 01    0338*       ld hl,(iy+sprite_x)
0482BE 11 00 00 00 0339*       ld de,-sprite_left*256
0482C2 ED 5A       0340*       adc hl,de
0482C4 FA FA 82 04 0341*       jp m,@left
0482C8 ED 52       0342*       sbc hl,de ; hl back to original value
0482CA 11 00 10 FF 0343*       ld de,-sprite_right*256
0482CE ED 5A       0344*       adc hl,de
0482D0 F2 08 83 04 0345*       jp p,@right
0482D4             0346*   ; no edge collisions so go home
0482D4 C9          0347*       ret
0482D5             0348*   @top:
0482D5 3E 08       0349*       ld a,collide_top
0482D7 21 00 00 00 0350*       ld hl,sprite_top*256
0482DB C3 E5 82 04 0351*       jp @collide_y
0482DF             0352*   @bottom:
0482DF 3E 04       0353*       ld a,collide_bottom
0482E1 21 00 40 01 0354*       ld hl,sprite_bottom*256
0482E5             0355*   @collide_y:
0482E5 32 C5 80 04 0356*       ld (sprite_screen_edge),a
0482E9 FD 2F 04    0357*       ld (iy+sprite_y),hl
0482EC             0358*   ; reverse y-axis velocity
0482EC FD 27 0A    0359*       ld hl,(iy+sprite_yvel)
0482EF CD 7C 04 04 0360*       call neg_hlu
0482F3 FD 2F 0A    0361*       ld (iy+sprite_yvel),hl
0482F6             0362*   ; go check for x-axis collisions
0482F6 C3 BB 82 04 0363*       jp @xaxis
0482FA             0364*   @left:
0482FA 3A C5 80 04 0365*       ld a,(sprite_screen_edge)
0482FE F6 02       0366*       or a,collide_left
048300 21 00 00 00 0367*       ld hl,sprite_left*256
048304 C3 12 83 04 0368*       jp @collide_x
048308             0369*   @right:
048308 3A C5 80 04 0370*       ld a,(sprite_screen_edge)
04830C F6 01       0371*       or a,collide_right
04830E 21 00 F0 00 0372*       ld hl,sprite_right*256
048312             0373*   @collide_x:
048312 32 C5 80 04 0374*       ld (sprite_screen_edge),a
048316 FD 2F 01    0375*       ld (iy+sprite_x),hl
048319             0376*   ; reverse x-axis velocity
048319 FD 27 07    0377*       ld hl,(iy+sprite_xvel)
04831C CD 7C 04 04 0378*       call neg_hlu
048320 FD 2F 07    0379*       ld (iy+sprite_xvel),hl
048323             0380*   ; final collision flag to a and return
048323 3A C5 80 04 0381*       ld a,(sprite_screen_edge)
048327 C9          0382*       ret
048328             0383*   ; end move_sprite
048328             0384*   
048328             0385*   sprite_compute_velocities:
048328 FD 27 10    0386*       ld hl,(iy+sprite_heading)
04832B FD 17 0D    0387*       ld de,(iy+sprite_vel)
04832E CD F6 06 04 0388*       call polar_to_cartesian
048332 FD 2A C2 80 0389*       ld iy,(table_pointer)
       04          
048337 FD 0F 07    0390*       ld (iy+sprite_xvel),bc ; save x-velocity component
04833A FD 1F 0A    0391*       ld (iy+sprite_yvel),de ; save y-velocity component
04833D C9          0392*       ret
04833E             0393*   ; end sprite_compute_velocities
04833E             0394*   
04833E             0395*   ; compute animation frame based on sprite_animation and sprite_heading
04833E             0396*   ; inputs: table_pointer set to sprite record
04833E             0397*   ; outputs: a, sprite_frame set to animation frame
04833E             0398*   ; destroys: a,hl
04833E             0399*   sprite_frame_heading_animation:
04833E FD 7E 11    0400*       ld a,(iy+sprite_heading+1) ; we want the integer portion
048341 CB 3F       0401*       srl a ; divide integer portion by 8
048343 CB 3F       0402*       srl a
048345 CB 3F       0403*       srl a
048347 FD 66 22    0404*       ld h,(iy+sprite_animation)
04834A 2E 20       0405*       ld l,32 ; 32 orientation frames per animation
04834C ED 6C       0406*       mlt hl ; hl = offset from base animation
04834E 85          0407*       add a,l ; modulo256 since sprite_frame is only 1 byte
04834F FD 77 28    0408*       ld (iy+sprite_frame),a
048352 C9          0409*       ret
048353             0410*   ; end sprite_frame_heading_animation
048353             0411*   
048353             0412*   ; compute animation frame based on sprite_heading
048353             0413*   ; inputs: table_pointer set to sprite record
048353             0414*   ; outputs: a, sprite_frame set to animation frame
048353             0415*   ; destroys: a,hl
048353             0416*   sprite_frame_heading:
048353 FD 7E 11    0417*       ld a,(iy+sprite_heading+1) ; we want the integer portion
048356 CB 3F       0418*       srl a ; divide integer portion by 8
048358 CB 3F       0419*       srl a
04835A CB 3F       0420*       srl a
04835C FD 77 28    0421*       ld (iy+sprite_frame),a
04835F C9          0422*       ret
048360             0423*   ; end sprite_frame_heading
048360             0424*   
048360             0425*   ; load a sprite with animation bitmaps
048360             0426*   ; inputs: a = sprite id, hl = base bufferId, bc = number of frames, sprite_select
048360             0427*   sprite_load_frames:
048360             0428*   ; back up input parameters
048360 E5          0429*       push hl ; base bufferId
048361 C5          0430*       push bc ; bc = number of frames
048362 CD F0 18 04 0431*       call vdu_sprite_clear_frames
048366 C1          0432*       pop bc ; bc = number of frames
048367 E1          0433*       pop hl ; = base bufferId
048368             0434*   @load_frames:
048368 C5          0435*       push bc ; back up loop counter
048369 E5          0436*       push hl ; back up base bufferId
04836A CD 32 1A 04 0437*       call vdu_sprite_add_buff
04836E E1          0438*       pop hl ; restore base bufferId
04836F 23          0439*       inc hl ; bump it to the next frame
048370             0440*   ; decrement loop counter
048370 C1          0441*       pop bc
048371 0B          0442*       dec bc
048372 79          0443*       ld a,c
048373 B7          0444*       or a
048374 C2 68 83 04 0445*       jp nz,@load_frames
048378 78          0446*       ld a,b
048379 B7          0447*       or a
04837A C2 68 83 04 0448*       jp nz,@load_frames
04837E C9          0449*       ret
04837F             0450*   ; end sprite_load_frames
