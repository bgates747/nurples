046879 FE 08       0301*       cp seekers_end_sprite_id
04687B DA A8 68 04 0302*       jp c,@seeker
04687F FE 0C       0303*       cp fireballs_end_sprite_id
046881 DA D9 68 04 0304*       jp c,@fireball
046885 FE 14       0305*       cp explosions_end_sprite_id
046887 DA F2 68 04 0306*       jp c,@explosion
04688B C3 07 69 04 0307*       jp @invalid
