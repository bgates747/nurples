0411D4 2A E3 11 04 0187*   	ld hl,(prt_irq_counter)
0411D8 23          0188*   	inc hl
0411D9 22 E3 11 04 0189*   	ld (prt_irq_counter),hl
0411DD E1          0190*       pop hl
0411DE F1          0191*   	pop af
0411DF FB          0192*   	ei
0411E0 5B ED 4D    0193*   	reti.l
