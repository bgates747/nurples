046799             0057        include "levels.inc"
046799             0001*   ; tileset indices
046799             0002*   tiles_dg: equ 0
046799             0003*   ; tiles_xevious: equ 1
046799 00 00 00    0004*   tileset_ptr_idx: dl 0
04679C             0005*   tileset_ptrs:
04679C             0006*       ; dl tiles_xevious_levels
04679C 2B 69 04    0007*       dl tileset_00_levels
04679F 00 00 00    0008*   tileset_ptrs_end: dl 0 ; list terminator
0467A2             0009*   
0467A2             0010*   ; get a pointer to the current tileset
0467A2             0011*   ; inputs: tileset_ptr_idx
0467A2             0012*   ; returns: ix = pointer to tileset levels lut
0467A2             0013*   get_tileset_ptr:
0467A2 3A 99 67 04 0014*       ld a,(tileset_ptr_idx)
0467A6 11 00 00 00 0015*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
0467AA 57          0016*       ld d,a ; d = tileset index
0467AB 1E 03       0017*       ld e,3 ; three bytes per index record
0467AD ED 5C       0018*       mlt de ; offset into tileset_ptrs lut
0467AF DD 21 9C 67 0019*       ld ix,tileset_ptrs
       04          
0467B4 DD 19       0020*       add ix,de ; ix = pointer to tileset_ptrs record
0467B6 C9          0021*       ret
0467B7             0022*   ; end get_tileset_ptr
0467B7             0023*   
0467B7             0024*   ; intialize a tileset
0467B7             0025*   ; inputs: a = index into tileset_ptrs
0467B7             0026*   init_tileset:
0467B7 32 99 67 04 0027*       ld (tileset_ptr_idx),a ; store new tileset index
0467BB CD A2 67 04 0028*       call get_tileset_ptr ; ix = pointer to tileset_ptrs record
0467BF DD 37 00    0029*       ld ix,(ix) ; ix = pointer to tileset levels lut
0467C2 DD 7E FF    0030*       ld a,(ix-1) ; number of levels in the tileset
0467C5 32 F5 67 04 0031*       ld (num_levels),a
0467C9 AF          0032*       xor a ; reset current level to zero
0467CA 32 F4 67 04 0033*       ld (cur_level),a
0467CE C3 32 68 04 0034*       jp init_level
0467D2             0035*   ; end init_tileset
0467D2             0036*   
0467D2             0037*   next_tileset:
0467D2 21 99 67 04 0038*       ld hl,tileset_ptr_idx
0467D6 34          0039*       inc (hl) ; bump to next index
0467D7 CD A2 67 04 0040*       call get_tileset_ptr ; ix = pointer to tileset_ptrs record
0467DB DD 27 00    0041*       ld hl,(ix) ; ix = pointer to tileset levels lut
0467DE             0042*       sign_hlu ; check for list terminator (0)
                       M1 Args: none
0467DE 19          0001*M1     add hl,de ; 1 cycle
0467DF B7          0002*M1     or a ; clear flags ; 1 cycle
0467E0 ED 52       0003*M1     sbc hl,de ; 2 cycles
0467E2             0004*M1     ; 4 cycles total
0467E2 C2 F0 67 04 0043*       jp nz,@F ; not end of list
0467E6 3E FF       0044*       ld a,-1 ; will wrap around to zero on the next iteration
0467E8 32 99 67 04 0045*       ld (tileset_ptr_idx),a
0467EC C3 D2 67 04 0046*       jp next_tileset ; try again
0467F0             0047*   @@:
0467F0 C3 B7 67 04 0048*       jp init_tileset
0467F4             0049*   ; end next_tileset
0467F4             0050*   
0467F4 00          0051*   cur_level: db 0
0467F5 00          0052*   num_levels: db 0
0467F6             0053*   
0467F6             0054*   ; get a pointer to the current level lookup record
0467F6             0055*   ; inputs: tileset_ptr_idx, cur_level
0467F6             0056*   ; returns: ix = pointer to level definition
0467F6             0057*   get_level_ptr:
0467F6 CD A2 67 04 0058*       call get_tileset_ptr
0467FA DD 37 00    0059*       ld ix,(ix) ; ix = pointer to tileset levels lut
0467FD 3A F4 67 04 0060*       ld a,(cur_level)
046801 11 00 00 00 0061*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
046805 57          0062*       ld d,a ; d = level index
046806 1E 03       0063*       ld e,3 ; three bytes per level record
046808 ED 5C       0064*       mlt de ; offset into tileset levels lut
04680A DD 19       0065*       add ix,de ; ix = pointer to level record
04680C C9          0066*       ret
04680D             0067*   ; end get_level_ptr
04680D             0068*   
04680D             0069*   ; advance to the next level in the current tileset
04680D             0070*   ; inputs: tileset_ptr_idx, cur_level
04680D             0071*   next_level:
04680D             0072*   ; update starting score
04680D 2A 0D 80 04 0073*       ld hl,(player_score)
046811 22 10 80 04 0074*       ld (player_starting_score),hl
046815             0075*   ; set up pointers to next map definition
046815 21 F4 67 04 0076*       ld hl,cur_level
046819 34          0077*       inc (hl) ; bump to next level
04681A CD F6 67 04 0078*       call get_level_ptr ; ix points to current level lookup record
04681E DD 27 00    0079*       ld hl,(ix) ; hl = pointer to next level lookup record
046821             0080*       sign_hlu ; check for list terminator (0)
                       M1 Args: none
046821 19          0001*M1     add hl,de ; 1 cycle
046822 B7          0002*M1     or a ; clear flags ; 1 cycle
046823 ED 52       0003*M1     sbc hl,de ; 2 cycles
046825             0004*M1     ; 4 cycles total
046825 C2 32 68 04 0081*       jp nz,@F ; not end of list
046829 AF          0082*       xor a ; reset level to zero
04682A 32 F4 67 04 0083*       ld (cur_level),a
04682E C3 D2 67 04 0084*       jp next_tileset ; try next tileset
046832             0085*   @@: ; fall through to init_level
046832             0086*   ; end next_level
046832             0087*   
046832             0088*   ; inputs: tileset_ptr_idx, cur_level
046832             0089*   init_level:
046832             0090*   ; ; initialize sprites and active tiles table
046832             0091*   ;     call sprites_init
046832             0092*   ;     call table_init
046832             0093*   ;     call tile_table_init
046832             0094*   ; set pointers
046832 CD F6 67 04 0095*       call get_level_ptr ; ix points to level lookup record
046836 DD 37 00    0096*       ld ix,(ix) ; ix points to level definition
046839             0097*   ; set tiles_cols
046839 DD 7E 00    0098*       ld a,(ix+0)
04683C 32 B3 8B 04 0099*       ld (tiles_cols),a
046840             0100*   ; set tiles_row counter
046840 DD 7E 01    0101*       ld a,(ix+1)
046843 32 B0 8B 04 0102*       ld (tiles_row),a
046847             0103*   ; set cur_baseBufferId
046847 DD 27 04    0104*       ld hl,(ix+4)
04684A 22 B4 8B 04 0105*       ld (cur_baseBufferId),hl
04684E             0106*   ; set tiles_row_defs
04684E ED 32 07    0107*       lea ix,ix+7 ; ix points to definition of first tile of first row
046851 DD 22 AD 8B 0108*       ld (tiles_row_defs),ix
       04          
046856             0109*   ; reset tile rows and plot coordinates
046856 21 FF FF FF 0110*       ld hl,-1
04685A 22 B1 8C 04 0111*       ld (bg_y_plot),hl
04685E 23          0112*       inc hl
04685F 22 B8 8B 04 0113*       ld (tiles_x_plot),hl
046863 21 F1 FF FF 0114*       ld hl,-15
046867 22 BC 8B 04 0115*       ld (tiles_y_plot),hl
04686B             0116*   ; print level number, score, and countdown to start
04686B CD 02 69 04 0117*       call print_level
04686F CD 28 80 04 0118*       call print_score
046873 CD A1 68 04 0119*       call start_level_countdown
046877 C9          0120*       ret
046878             0121*   ; end init_level
046878             0122*   
046878             0123*   init_bg:
046878             0124*   ; draw initial background tiles
046878 21 00 04 00 0125*       ld hl,BUF_BG_STARS_0
04687C CD 3C 14 04 0126*       call vdu_buff_select
046880 01 00 00 00 0127*       ld bc,0
046884 11 00 00 00 0128*       ld de,field_top
046888 CD 3C 18 04 0129*       call vdu_plot_bmp
04688C 21 02 04 00 0130*       ld hl,BUF_BG_STARS_4
046890 CD 3C 14 04 0131*       call vdu_buff_select
046894 01 00 00 00 0132*       ld bc,0
046898 11 00 01 00 0133*       ld de,field_top+256
04689C CD 3C 18 04 0134*       call vdu_plot_bmp
0468A0 C9          0135*       ret
0468A1             0136*   ; end init_level
0468A1             0137*   start_level_countdown:
0468A1             0138*   ; set gfx origin and viewport to playing field window
0468A1 CD 9F 80 04 0139*       call set_gfx_playing_field
0468A5 CD 78 68 04 0140*       call init_bg
0468A9             0141*   ; set text colors
0468A9 3E 90       0142*       ld a,16+128 ; darkest blue
0468AB CD 78 13 04 0143*       call vdu_colour_text
0468AF 3E 3A       0144*       ld a,58 ; dark orange
0468B1 CD 78 13 04 0145*       call vdu_colour_text
0468B5             0146*   ; print get ready message
0468B5 0E 1B       0147*       ld c,27 ; x
0468B7 06 10       0148*       ld b,16 ; y
0468B9 CD 33 13 04 0149*       call vdu_move_cursor
0468BD CD 5C 00 04 0150*       call printInline
0468C1 47 65 74 20 0151*       asciz "Get Ready!"
       52 65 61 64 
       79 21 00    
0468CC             0152*   ; countdown to restart
0468CC 0E 18       0153*       ld c,24 ; x
0468CE 06 11       0154*       ld b,17 ; y
0468D0 CD 33 13 04 0155*       call vdu_move_cursor
0468D4 CD 5C 00 04 0156*       call printInline
0468D8 53 74 61 72 0157*       asciz "Starting In..."
       74 69 6E 67 
       20 49 6E 2E 
       2E 2E 00    
