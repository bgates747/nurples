047A17             0123*    ; get back stack pointer and loop
047A17             0124*   @next_record:
047A17 DD 2A 94 7A 0125*       ld ix,(@tile_stack_pointer)
       04          
047A1C ED 32 03    0126*       lea ix,ix+3 ; next tile stack record
047A1F C3 6C 79 04 0127*       jp @check_loop ; loop until we've checked all the records
047A23             0128*   @scan_done:
047A23             0129*   ; Rediscover the source cursor after any compaction. This search is bounded by
047A23             0130*   ; the current dense-stack count and validates each slot before loading it.
047A23 3A 3B 73 04 0131*       ld a,(num_active_tiles)
047A27 32 9D 7A 04 0132*       ld (@tiles_remaining),a
047A2B FD 21 32 70 0133*       ld iy,tile_stack
       04          
047A30             0134*   @find_loop:
047A30 3A 9D 7A 04 0135*       ld a,(@tiles_remaining)
047A34 B7          0136*       or a
047A35 CA 77 7A 04 0137*       jp z,@source_not_found
047A39 3D          0138*       dec a
047A3A 32 9D 7A 04 0139*       ld (@tiles_remaining),a
047A3E FD E5       0140*       push iy
047A40 E1          0141*       pop hl
047A41 CD E6 73 04 0142*       call tile_stack_pointer_valid
047A45 D2 77 7A 04 0143*       jp nc,@source_not_found
047A49 FD 27 00    0144*       ld hl,(iy)
047A4C ED 33 03    0145*       lea iy,iy+3 ; next tile stack record
047A4F ED 5B 9A 7A 0146*       ld de,(@source_tile_pointer)
       04          
047A54 B7          0147*       or a ; clear carry
047A55 ED 52       0148*       sbc hl,de ; if not the same address, loop
047A57 C2 30 7A 04 0149*       jp nz,@find_loop
047A5B ED 33 FD    0150*       lea iy,iy-3 ; back up to the record we want
047A5E FD 22 35 73 0151*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
047A63 FD 37 00    0152*       ld iy,(iy) ; iy points to the tile stack record
047A66 CD 1F 74 04 0153*       call tile_table_record_pointer_valid
047A6A D2 77 7A 04 0154*       jp nc,@source_not_found
047A6E FD 22 38 73 0155*       ld (tile_table_pointer),iy ; set pointer to this tile record
       04          
047A73 C3 C3 78 04 0156*       jp transform_active_tile_to_crater
047A77             0157*   @source_not_found:
047A77             0158*   ; Fail closed and make the outer traversal's normal +3 step land exactly on
047A77             0159*   ; the current logical end. It will then stop on the validated range check.
