0480D2             0093*   ; destroys: a,hl
0480D2             0094*   table_deactivate_sprite:
0480D2 FD 7E 00    0095*       ld a,(iy+sprite_id) ; get spriteId
0480D5 CD DB 18 04 0096*       call vdu_sprite_select ; select sprite
