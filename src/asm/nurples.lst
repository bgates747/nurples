04616B 3C          0269*       inc a
04616C 32 4E 5F 04 0270*       ld (player_dying_spawns),a
046170 FE 08       0271*       cp explosions_max
046172 D8          0272*       ret c
046173 AF          0273*       xor a
046174 32 4D 5F 04 0274*       ld (player_dying_timer),a
046178 3E 03       0275*       ld a,player_dying_phase_finish
04617A 32 4C 5F 04 0276*       ld (player_dying_phase),a
04617E C9          0277*       ret
