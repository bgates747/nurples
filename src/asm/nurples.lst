041039 C1          0064*       pop bc
04103A 0B          0065*       dec bc
04103B 79          0066*       ld a,c
04103C B7          0067*       or a
04103D C2 10 10 04 0068*       jp nz,img_load_main
041041 78          0069*       ld a,b
041042 B7          0070*       or a
041043 C2 10 10 04 0071*       jp nz,img_load_main
041047 C9          0072*       ret
041048             0073*   
041048             0074*   load_next_image:
041048 FD 2A E0 0F 0075*       ld iy,(cur_image_list)
       04          
04104D FD E5       0076*       push iy
04104F FD 7E 00    0077*       ld a,(iy+image_type) ; get image type
041052 FD 07 03    0078*       ld bc,(iy+image_width) ; get image width
041055 FD 17 06    0079*       ld de,(iy+image_height) ; get image height
041058 FD 31 09    0080*       ld ix,(iy+image_filesize) ; get image file size
04105B FD 27 0F    0081*       ld hl,(iy+image_bufferId) ; get image bufferId
04105E 22 E6 0F 04 0082*       ld (cur_buffer_id),hl
041062 FD 37 0C    0083*       ld iy,(iy+image_filename) ; get image filename
041065 FD 22 E3 0F 0084*       ld (cur_filename),iy
       04          
04106A CD 86 15 04 0085*       call vdu_load_img
04106E FD E1       0086*       pop iy
041070 ED 33 12    0087*       lea iy,iy+image_record_size
041073 FD 22 E0 0F 0088*       ld (cur_image_list),iy
       04          
041078 C9          0089*       ret
