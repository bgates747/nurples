041B18             0045        include "agnb_api.inc"
041B18             0001*   ; Canonical AGNB image/audio loader API
041B18             0002*   ; =====================================
041B18             0003*   ;
041B18             0004*   ; Public entry points:
041B18             0005*   ;   agnb_load_images: DE -> zero-terminated AGNB 0.1 image filename
041B18             0006*   ;   agnb_load_images_with_callback:
041B18             0007*   ;                     DE -> filename, HL -> completed-image callback
041B18             0008*   ;   agnb_load_audio:  DE -> zero-terminated AGNB 0.2 audio filename
041B18             0009*   ;   agnb_load_audio_with_callback:
041B18             0010*   ;                     DE -> filename, HL -> completed-audio callback
041B18             0011*   ;
041B18             0012*   ; Applications own plotting, playback, input, timing, and debug behavior.
041B18             0013*   ; External dependencies and reference implementations are documented in
041B18             0014*   ; README.md and agnb_dependencies.inc.
041B18             0015*   ;
041B18             0016*   ; AGNB 0.1 image-container layout
041B18             0017*   ; ===============================
041B18             0018*   ;
041B18             0019*   ; AGNB is a RIFF container. All integer fields are unsigned little-endian.
041B18             0020*   ; Every chunk begins with a four-byte ID and a u32 payload size. The payload
041B18             0021*   ; follows immediately and is padded with zero bytes to a four-byte boundary.
041B18             0022*   ; The stored chunk size excludes its eight-byte header and alignment padding.
041B18             0023*   ;
041B18             0024*   ;     RIFF  u32(file size - 8)  AGNB
041B18             0025*   ;       VERS  size=2
041B18             0026*   ;         u8 major=0
041B18             0027*   ;         u8 minor=1
041B18             0028*   ;       LIST  type=BUFR
041B18             0029*   ;         BHDR  size=2
041B18             0030*   ;           u16 bufferId
041B18             0031*   ;         IMAG  size=5
041B18             0032*   ;           u16 width
041B18             0033*   ;           u16 height
041B18             0034*   ;           u8  format=1        ; RGBA2222
041B18             0035*   ;         DATA  size=width*height
041B18             0036*   ;           u8 pixels[]         ; row-major, no row padding
041B18             0037*   ;
041B18             0038*   ; VERS occurs once before the LIST records. Each version 0.1 LIST BUFR record
041B18             0039*   ; contains exactly BHDR, IMAG, and DATA in that order. The LIST payload starts
041B18             0040*   ; with its four-byte BUFR type, followed by those nested chunks. Readers must
041B18             0041*   ; validate the enclosing RIFF/LIST bounds and the BHDR/IMAG metadata before
041B18             0042*   ; reading or uploading DATA. Chunk traversal advances by:
041B18             0043*   ;
041B18             0044*   ;     8 + ((payload_size + 3) & ~3)
041B18             0045*   ;
041B18             0046*   ; The offsets below are indices from the beginning of the named header or
041B18             0047*   ; payload. RIFF and chunk sizes are u32 values even though ADL registers are
041B18             0048*   ; 24-bit, so their high byte must not be silently discarded during validation.
041B18             0049*   
041B18             0050*   ; RIFF file header: "RIFF", u32 size, "AGNB"
041B18             0051*   agnb_riff_id:              equ 0
041B18             0052*   agnb_riff_size:            equ 4
041B18             0053*   agnb_riff_form:            equ 8
041B18             0054*   agnb_riff_header_size:     equ 12
041B18             0055*   
041B18             0056*   ; Generic RIFF chunk header: FourCC ID, u32 payload size
041B18             0057*   agnb_chunk_id:             equ 0
041B18             0058*   agnb_chunk_size:           equ 4
041B18             0059*   agnb_chunk_data:           equ 8
041B18             0060*   agnb_chunk_header_size:    equ 8
041B18             0061*   
041B18             0062*   ; VERS payload
041B18             0063*   agnb_vers_major:           equ 0
041B18             0064*   agnb_vers_minor:           equ 1
041B18             0065*   agnb_vers_payload_size:    equ 2
041B18             0066*   
041B18             0067*   ; LIST BUFR payload
041B18             0068*   agnb_list_type:            equ 0
041B18             0069*   agnb_list_chunks:          equ 4
041B18             0070*   agnb_list_type_size:       equ 4
041B18             0071*   
041B18             0072*   ; BHDR payload
041B18             0073*   agnb_bhdr_bufferId:        equ 0
041B18             0074*   agnb_bhdr_payload_size:    equ 2
041B18             0075*   
041B18             0076*   ; IMAG payload
041B18             0077*   agnb_imag_width:           equ 0
041B18             0078*   agnb_imag_height:          equ 2
041B18             0079*   agnb_imag_format:          equ 4
041B18             0080*   agnb_imag_payload_size:    equ 5
041B18             0081*   
041B18             0082*   ; DATA payload
041B18             0083*   agnb_data_pixels:          equ 0
041B18             0084*   
041B18             0085*   ; Values supported by the version 0.1 image loader
041B18             0086*   agnb_version_major:        equ 0
041B18             0087*   agnb_version_minor:        equ 1
041B18             0088*   agnb_image_rgba2222:       equ 1
041B18             0089*   
041B18             0090*   
041B18             0091*   ; FourCC constants
041B18             0092*   ; ----------------
041B18             0093*   ; Store each identifier exactly as it appears on disk. agnb_compare_fourcc
041B18             0094*   ; compares one of these tables with four bytes read from the container.
041B18             0095*   
041B18 52 49 46 46 0096*   agnb_id_riff:              db "RIFF"
041B1C 41 47 4E 42 0097*   agnb_id_agnb:              db "AGNB"
041B20 56 45 52 53 0098*   agnb_id_vers:              db "VERS"
041B24 4C 49 53 54 0099*   agnb_id_list:              db "LIST"
041B28 42 55 46 52 0100*   agnb_id_bufr:              db "BUFR"
041B2C 42 48 44 52 0101*   agnb_id_bhdr:              db "BHDR"
041B30 49 4D 41 47 0102*   agnb_id_imag:              db "IMAG"
041B34 44 41 54 41 0103*   agnb_id_data:              db "DATA"
041B38             0104*   
041B38             0105*   
041B38             0106*   ; Reader result codes
041B38             0107*   ; -------------------
041B38             0108*   ; Public routines will return A=0 with Z set on success, or one of these
041B38             0109*   ; nonzero values with NZ set on failure. The same value is stored in
041B38             0110*   ; agnb_last_error.
041B38             0111*   
041B38             0112*   agnb_error_ok:             equ 0
041B38             0113*   agnb_error_open:           equ 1
041B38             0114*   agnb_error_read:           equ 2
041B38             0115*   agnb_error_seek:           equ 3
041B38             0116*   agnb_error_riff_id:        equ 4
041B38             0117*   agnb_error_riff_form:      equ 5
041B38             0118*   agnb_error_version:        equ 6
041B38             0119*   agnb_error_chunk:          equ 7
041B38             0120*   agnb_error_bounds:         equ 8
041B38             0121*   agnb_error_bufferId:       equ 9
041B38             0122*   agnb_error_metadata:       equ 10
041B38             0123*   agnb_error_data_size:      equ 11
041B38             0124*   agnb_error_vdp:            equ 12
041B38             0125*   agnb_error_eof:            equ 13
041B38             0126*   agnb_error_not_implemented: equ 255
041B38             0127*   
041B38             0128*   
041B38             0129*   ; FatFS file structure
041B38             0130*   ; --------------------
041B38             0131*   ; The direct ffs_* API needs one caller-owned FIL. Its field indices come from
041B38             0132*   ; mos_api.inc. No FILINFO is needed for opening, reading, seeking, or closing
041B38             0133*   ; the single known container filename.
041B38             0134*   
041B38             0135*   agnb_fil_size:             equ fil_dir_ptr+3
041B38             0136*   agnb_fil:
041B38 00 00 00 00 0137*       blkb agnb_fil_size,0
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
041B5C             0138*   
041B5C             0139*   
041B5C             0140*   ; Reader-state structure
041B5C             0141*   ; ----------------------
041B5C             0142*   ; RIFF sizes and offsets are u32 and are kept as four bytes even though most
041B5C             0143*   ; eZ80 arithmetic is 24-bit. The byte at offset +3 must participate in bounds
041B5C             0144*   ; checks and FatFS seeks.
041B5C             0145*   
041B5C             0146*   agnb_state_file_size:      equ 0  ; u32 physical size from FIL object
041B5C             0147*   agnb_state_riff_end:       equ 4  ; u32 first byte after RIFF contents
041B5C             0148*   agnb_state_list_end:       equ 8  ; u32 first byte after current LIST payload
041B5C             0149*   agnb_state_chunk_size:     equ 12 ; u32 current chunk payload size
041B5C             0150*   agnb_state_chunk_end:      equ 16 ; u32 first byte after current payload
041B5C             0151*   agnb_state_file_offset:    equ 20 ; u32 current logical read position
041B5C             0152*   agnb_state_bytes_read:     equ 24 ; u32 last read count (high byte normally 0)
041B5C             0153*   agnb_state_size:           equ 28
041B5C             0154*   
041B5C             0155*   agnb_state:
041B5C 00 00 00 00 0156*       blkb agnb_state_size,0
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
041B78             0157*   
041B78             0158*   
041B78             0159*   ; Normalized image metadata
041B78             0160*   ; -------------------------
041B78             0161*   ; BHDR and IMAG are copied here and validated completely before DATA is read.
041B78             0162*   
041B78             0163*   agnb_meta_bufferId:        equ 0  ; u16 writer-specified VDP bufferId
041B78             0164*   agnb_meta_width:           equ 2  ; u16 pixels
041B78             0165*   agnb_meta_height:          equ 4  ; u16 pixels
041B78             0166*   agnb_meta_format:          equ 6  ; u8, version 0.1 requires RGBA2222
041B78             0167*   agnb_meta_data_size:       equ 7  ; u32 DATA payload size
041B78             0168*   agnb_meta_size:            equ 11
041B78             0169*   
041B78             0170*   agnb_metadata:
041B78 00 00 00 00 0171*       blkb agnb_meta_size,0
       00 00 00 00 
       00 00 00    
041B83             0172*   
041B83             0173*   ; Retained u32 result from agnb_calculate_image_data_size for validation and
041B83             0174*   ; temporary test inspection. The high byte is zero for the 24-bit product.
041B83             0175*   agnb_expected_data_size:
041B83 00 00 00 00 0176*       blkb 4,0
041B87             0177*   
041B87             0178*   ; Working counters used by agnb_stream_data. DATA sizes accepted by the image
041B87             0179*   ; loader have already been constrained to 24 bits.
041B87             0180*   agnb_stream_remaining:
041B87 00 00 00    0181*       blkb 3,0
041B8A             0182*   agnb_stream_block_size:
041B8A 00 00 00    0183*       blkb 3,0
041B8D             0184*   agnb_padding_size:
041B8D 00          0185*       db 0
041B8E             0186*   
041B8E             0187*   ; Record-validation flags. These are reset at the start of each LIST BUFR.
041B8E             0188*   agnb_record_has_bhdr:      equ 0
041B8E             0189*   agnb_record_has_imag:      equ 1
041B8E             0190*   agnb_record_has_data:      equ 2
041B8E             0191*   
041B8E 00          0192*   agnb_record_flags:         db 0
041B8F 00          0193*   agnb_last_error:           db agnb_error_ok
041B90 00          0194*   agnb_file_is_open:         db 0
041B91             0195*   
041B91             0196*   
041B91             0197*   ; Reusable I/O storage
041B91             0198*   ; --------------------
041B91             0199*   ; The 12-byte buffer is large enough for either the RIFF file header or a
041B91             0200*   ; generic chunk header plus the four-byte LIST type. DATA is streamed through
041B91             0201*   ; the application's existing 8 KiB SRAM filedata area.
041B91             0202*   
041B91             0203*   agnb_header:
041B91 00 00 00 00 0204*       blkb agnb_riff_header_size,0
       00 00 00 00 
       00 00 00 00 
