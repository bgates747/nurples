047A81             0001*   ; UART ports for reading joystick input
047A81             0002*   ; bit tests: 0 means actuated, 1 means not actuated
047A81             0003*   portC: 	EQU 	$9E ; reads dpad input
047A81             0004*   joy1_u: equ 1
047A81             0005*   joy1_d: equ 3
047A81             0006*   joy1_l: equ 5
047A81             0007*   joy1_r: equ 7
047A81             0008*   portD: 	EQU 	$A2 ; reads buttons
047A81             0009*   btn1_a: equ 5
047A81             0010*   
047A81             0011*   ; process player keyboard input, set player bitmap
047A81             0012*   ; velocities and draw player bitmap at updated coordinates
047A81             0013*   ; Inputs: player_x/y set at desired position
047A81             0014*   ; Returns: player bitmap drawn at updated position
047A81             0015*   ; Destroys: probably everything except maybe iy
047A81             0016*   ; NOTE: in mode 9 we draw the ship as a sprite, not a bitmap
047A81             0017*   ; TODO: requires sprite implementation
047A81             0018*   player_input:
047A81             0019*   ; point to player sprite record
047A81 FD 21 87 9D 0020*       ld iy,player_begin
       04          
047A86 FD 22 4C 7D 0021*       ld (table_pointer),iy
       04          
