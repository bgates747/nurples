048066             0008*   field_left: equ 0
048066             0009*   field_right: equ 255
048066             0010*   sprite_top: equ field_top
048066             0011*   sprite_bottom: equ field_bottom-15
048066             0012*   sprite_left: equ field_left
048066             0013*   sprite_right: equ field_right-15
048066             0014*   tile_bottom: equ screen_bottom+1
