0463DD             0168*   
0463DD             0169*   ; update a vertical bar display
0463DD             0170*   ; inputs: ix points to bar structure
0463DD             0171*   ;         bar_val set by caller
0463DD             0172*   ; prerequisite: bar_init called before first use
0463DD             0173*   bar_update_v:
0463DD             0174*   ; set gfx viewport
0463DD DD E5       0175*       push ix ; preserve pointer
0463DF DD 07 03    0176*       ld bc,(ix+bar_x0)
0463E2 DD 17 06    0177*       ld de,(ix+bar_y0)
0463E5 DD 31 0C    0178*       ld iy,(ix+bar_y1)
0463E8 DD 37 09    0179*       ld ix,(ix+bar_x1)
0463EB CD D7 14 04 0180*       call vdu_set_gfx_viewport
0463EF DD E1       0181*       pop ix ; restore pointer
0463F1             0182*   ; select the color based on the value thresholds
0463F1 DD 17 00    0183*       ld de,(ix+bar_val)
0463F4 21 EF FF FF 0184*       ld hl,-bar_red
0463F8 19          0185*       add hl,de
0463F9 D2 16 64 04 0186*       jp nc,@red
0463FD 21 DF FF FF 0187*       ld hl,-bar_yellow
046401 19          0188*       add hl,de
046402 D2 0E 64 04 0189*       jp nc,@yellow
046406 21 05 00 00 0190*       ld hl,BUF_BAR_V_2 ; green
04640A C3 1A 64 04 0191*       jp @select
04640E             0192*   @yellow:
04640E 21 04 00 00 0193*       ld hl,BUF_BAR_V_1 ; yellow
046412 C3 1A 64 04 0194*       jp @select
046416             0195*   @red:
046416 21 03 00 00 0196*       ld hl,BUF_BAR_V_0 ; red
04641A             0197*   @select:
04641A CD 2C 15 04 0198*       call vdu_buff_select
04641E             0199*   ; get x-plot position
04641E DD 07 03    0200*       ld bc,(ix+bar_x0)
046421             0201*   ; compute y-plot position
046421 DD 17 00    0202*       ld de,(ix+bar_val)
046424 21 40 00 00 0203*       ld hl,64
046428 AF          0204*       xor a ; clear carry
046429 ED 52       0205*       sbc hl,de
04642B DD 17 0F    0206*       ld de,(ix+bar_y)
04642E 19          0207*       add hl,de
04642F 7D          0208*       ld a,l
046430 E6 FC       0209*       and %11111100 ; round to nearest 4 pixels
046432 6F          0210*       ld l,a
046433 EB          0211*       ex de,hl
046434 CD 62 19 04 0212*       call vdu_plot_bmp
046438 C9          0213*       ret
046439             0214*   ; end bar_update_v
046439             0215*   
