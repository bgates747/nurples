048FA8 D0          0022*       ret nc ; no carry means no free active tile slots, so we go home
048FA9             0023*   ; other specific initialization
048FA9 CD 14 05 04 0024*       call rand_8     ; snag a random number
048FAD E6 1F       0025*       and %00011111 ; keep only 5 lowest bits (max 31)
048FAF DD 77 24    0026*       ld (ix+tile_move_timer),a ; when this hits zero,will spawn a seeker
048FB2 C9          0027*       ret
048FB3             0028*   ; end activate_pad_small
048FB3             0029*   
048FB3             0030*   move_pad_small:
048FB3 CD 23 8D 04 0031*       call move_active_tile
