048103 CD 2C 1A 04 0111*   	call vdu_sprite_add_buff
048107 F1          0112*   	pop af ; restore loop counter / sprite id
048108 3C          0113*       inc a
048109 FE 14       0114*       cp table_num_records
04810B C2 FA 80 04 0115*       jp nz,@sprite_loop
