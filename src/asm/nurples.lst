0464BC             0025*   discharge_fuel:
0464BC             0026*   ; check fuel timer
0464BC 21 BA 64 04 0027*       ld hl,discharge_fuel_timer
0464C0 35          0028*       dec (hl)
0464C1 C0          0029*       ret nz ; not time to discharge fuel so return
0464C2             0030*   ; reset fuel discharge timer
0464C2 3A BB 64 04 0031*       ld a,(discharge_fuel_timer_max)
0464C6 77          0032*       ld (hl),a
0464C7             0033*   ; discharge fuel
