0410E3             0038        include "timer.inc"
0410E3             0001*   ; Table 32. Timer Control Registers
0410E3             0002*   TMR0_CTL: equ 80h
0410E3             0003*   TMR1_CTL: equ 83h
0410E3             0004*   TMR2_CTL: equ 86h
0410E3             0005*   TMR3_CTL: equ 89h
0410E3             0006*   TMR4_CTL: equ 8Ch
0410E3             0007*   TMR5_CTL: equ 8Fh
0410E3             0008*   
0410E3             0009*   ; each timer register takes three bytes:
0410E3             0010*   ;   0: control register
0410E3             0011*   ;   1: low byte of timer reset value
0410E3             0012*   ;   2: high byte of timer reset value
0410E3             0013*   ; note that the value is only 8-bits,so we use in0/out0 i/o calls,
0410E3             0014*   ; which correctly force the high and upper bytes of the address bus to zero
0410E3             0015*   
0410E3             0016*   TMR_REG_CTL: equ 0
0410E3             0017*   TMR_RES_LOW: equ 1
0410E3             0018*   TMR_RES_HIGH: equ 2
0410E3             0019*   
0410E3             0020*   ; Timer Control Register Bit Definitions
0410E3             0021*   PRT_IRQ_0:    equ %00000000 ; The timer does not reach its end-of-count value.
0410E3             0022*                               ; This bit is reset to 0 every time the TMRx_CTL register is read.
0410E3             0023*   PRT_IRQ_1:    equ %10000000 ; The timer reaches its end-of-count value. If IRQ_EN is set to 1,
0410E3             0024*                               ; an interrupt signal is sent to the CPU. This bit remains 1 until
0410E3             0025*                               ; the TMRx_CTL register is read.
0410E3             0026*   
0410E3             0027*   IRQ_EN_0:     equ %00000000 ; Timer interrupt requests are disabled.
0410E3             0028*   IRQ_EN_1:     equ %01000000 ; Timer interrupt requests are enabled.
0410E3             0029*   
0410E3             0030*   PRT_MODE_0:   equ %00000000 ; The timer operates in SINGLE PASS mode. PRT_EN (bit 0) is reset to
0410E3             0031*                               ;  0,and counting stops when the end-of-count value is reached.
0410E3             0032*   PRT_MODE_1:   equ %00010000 ; The timer operates in CONTINUOUS mode. The timer reload value is
0410E3             0033*                               ; written to the counter when the end-of-count value is reached.
0410E3             0034*   
0410E3             0035*   ; CLK_DIV is a 2-bit mask that sets the timer input source clock divider
0410E3             0036*   CLK_DIV_256:  equ %00001100 ;
0410E3             0037*   CLK_DIV_64:   equ %00001000 ;
0410E3             0038*   CLK_DIV_16:   equ %00000100 ;
0410E3             0039*   CLK_DIV_4:    equ %00000000 ;
0410E3             0040*   
0410E3             0041*   RST_EN_0:     equ %00000000 ; The reload and restart function is disabled.
0410E3             0042*   RST_EN_1:     equ %00000010 ; The reload and restart function is enabled.
0410E3             0043*                               ; When a 1 is written to this bit,the values in the reload registers
0410E3             0044*                               ;  are loaded into the downcounter when the timer restarts. The
0410E3             0045*                               ; programmer must ensure that this bit is set to 1 each time
0410E3             0046*                               ; SINGLE-PASS mode is used.
0410E3             0047*   
0410E3             0048*   ; disable/enable the programmable reload timer
0410E3             0049*   PRT_EN_0:     equ %00000000 ;
0410E3             0050*   PRT_EN_1:     equ %00000001 ;
0410E3             0051*   
0410E3             0052*   ; Table 37. Timer Input Source Select Register
0410E3             0053*   ; Each of the 4 timers are allocated two bits of the 8-bit register
0410E3             0054*   ; in little-endian order,with TMR0 using bits 0 and 1,TMR1 using bits 2 and 3,etc.
0410E3             0055*   ;   00: System clock / CLK_DIV
0410E3             0056*   ;   01: RTC / CLK_DIV
0410E3             0057*   ;   NOTE: these are the values given in the manual,but it may be a typo
0410E3             0058*   ;   10: GPIO port B pin 1.
0410E3             0059*   ;   11: GPIO port B pin 1.
0410E3             0060*   TMR_ISS:   equ 92h ; register address
0410E3             0061*   
0410E3             0062*   ; Table 51. Real-Time Clock Control Register
0410E3             0063*   RTC_CTRL: equ EDh ; register address
0410E3             0064*   
0410E3             0065*   ; alarm interrupt disable/enable
0410E3             0066*   RTC_ALARM_0:    equ %00000000
0410E3             0067*   RTC_ALARM_1:    equ %10000000
0410E3             0068*   
0410E3             0069*   ; interrupt on alarm disable/enable
0410E3             0070*   RTC_INT_ENT_0:  equ %00000000
0410E3             0071*   RTC_INT_ENT_1:  equ %01000000
0410E3             0072*   
0410E3             0073*   RTC_BCD_EN_0:   equ %00000000   ; RTC count and alarm registers are binary
0410E3             0074*   RTC_BCD_EN_1:   equ %00100000   ; RTC count and alarm registers are BCD
0410E3             0075*   
0410E3             0076*   RTC_CLK_SEL_0:  equ %00000000   ; RTC clock source is crystal oscillator output (32768 Hz).
0410E3             0077*                                   ; On-chip 32768 Hz oscillator is enabled.
0410E3             0078*   RTC_CLK_SEL_1:  equ %00010000   ; RTC clock source is power line frequency input as set by FREQ_SEL.
0410E3             0079*                                   ; On-chip 32768 Hz oscillator is disabled.
0410E3             0080*   
0410E3             0081*   RTC_FREQ_SEL_0: equ %00000000   ; 60 Hz power line frequency.
0410E3             0082*   RTC_FREQ_SEL_1: equ %00001000   ; 50 Hz power line frequency.
0410E3             0083*   
0410E3             0084*   RTC_SLP_WAKE_0: equ %00000000   ; RTC does not generate a sleep-mode recovery reset.
0410E3             0085*   RTC_SLP_WAKE_1: equ %00000010   ; RTC generates a sleep-mode recovery reset.
0410E3             0086*   
0410E3             0087*   RTC_UNLOCK_0:   equ %00000000   ; RTC count registers are locked to prevent Write access.
0410E3             0088*                                   ; RTC counter is enabled.
0410E3             0089*   RTC_UNLOCK_1:   equ %00000001   ; RTC count registers are unlocked to allow Write access.
0410E3             0090*                                   ; RTC counter is disabled.
0410E3             0091*   
0410E3             0092*   ; prt_reload_emulator: equ 11234 ; 1/102.4 seconds on emulator with 16 clock divider
0410E3             0093*   
0410E3             0094*   prt_reload_emulator: equ 11519 ; 1 centisecond on emulator with 16 clock divider
0410E3             0095*   prt_reload_hardware: equ 11532 ; 1 centisecond on hardware with 16 clock divider
0410E3 00 00 00    0096*   prt_reload: dl 0x000000
0410E6             0097*   
0410E6             0098*   ; returns: a = 0 if running on hardware,1 if running on emulator
0410E6             0099*   ;          de = number PRT interrupts during test interval
0410E6             0100*   prt_calibrate:
0410E6 CD B5 13 04 0101*       call vdu_vblank
0410EA             0102*   ; set a MOS timer
0410EA 21 78 00 00 0103*       ld hl,120*1 ; 1 second
0410EE FD 21 6E 12 0104*       ld iy,tmr_test
       04          
0410F3 CD 4C 12 04 0105*       call tmr_set
0410F7             0106*   ; set a PRT timer
0410F7             0107*       ; ld hl,prt_reload_hardware
0410F7             0108*       ; ld hl,prt_reload_emulator
0410F7 21 05 2D 00 0109*       ld hl,prt_reload_emulator + prt_reload_hardware / 2
0410FB 22 E3 10 04 0110*       ld (prt_reload),hl
0410FF CD 87 11 04 0111*       call prt_set
041103             0112*   @loop:
041103             0113*   ; check time remaining on MOS timer
041103 CD 5A 12 04 0114*       call tmr_get
041107 CA 11 11 04 0115*       jp z,@done ; time expired,so quit
04110B FA 11 11 04 0116*       jp m,@done ; time past expiration (negative),so quit
04110F 18 F2       0117*       jr @loop
041111             0118*   @done:
041111 ED 5B D5 11 0119*       ld de,(prt_irq_counter)
       04          
041116 01 0C 2D 00 0120*       ld bc,prt_reload_hardware ; default value for running on hardware
04111A ED 43 E3 10 0121*       ld (prt_reload),bc
       04          
04111F 21 64 00 00 0122*       ld hl,100 ; halfway between 101 for real hardware and 99 for emulator
041123 AF          0123*       xor a ; clear carry,zero is default value for running on hardware
041124 32 46 11 04 0124*       ld (is_emulator),a
041128 ED 52       0125*       sbc hl,de
04112A 21 47 11 04 0126*       ld hl,on_hardware ; default message for running on hardware
04112E CA E6 10 04 0127*       jp z,prt_calibrate ; zero result is indeterminate so we try again
041132 F8          0128*       ret m ; negative result means we're on hardware
041133 3C          0129*       inc a ; we're on emulator
041134 32 46 11 04 0130*       ld (is_emulator),a
041138 01 FF 2C 00 0131*       ld bc,prt_reload_emulator
04113C ED 43 E3 10 0132*       ld (prt_reload),bc
       04          
041141 21 5D 11 04 0133*       ld hl,on_emulator
041145 C9          0134*       ret
041146 00          0135*   is_emulator: db 0
041147 52 75 6E 6E 0136*   on_hardware: defb "Running on hardware\r\n",0
       69 6E 67 20 
       6F 6E 20 68 
       61 72 64 77 
       61 72 65 0D 
       0A 00       
04115D 52 75 6E 6E 0137*   on_emulator: defb "Running on emulator\r\n",0
       69 6E 67 20 
       6F 6E 20 65 
       6D 75 6C 61 
       74 6F 72 0D 
       0A 00       
041173             0138*   
041173 43 61 6C 69 0139*   calibrating_timer: defb "Calibrating timer\r\n",0
       62 72 61 74 
       69 6E 67 20 
       74 69 6D 65 
       72 0D 0A 00 
041187             0140*   
041187             0141*   ; set PRT timer
041187             0142*   prt_set:
041187 21 00 00 00 0143*       ld hl,0
04118B 22 D5 11 04 0144*       ld (prt_irq_counter),hl
04118F 2A E3 10 04 0145*       ld hl,(prt_reload)
041193 ED 29 84    0146*       out0 (TMR1_CTL+TMR_RES_LOW),l
041196 ED 21 85    0147*   	out0 (TMR1_CTL+TMR_RES_HIGH),h
041199             0148*   ; disable timer
041199 3E 06       0149*       ld a,PRT_IRQ_0 | IRQ_EN_0 | PRT_MODE_0 | CLK_DIV_16 | RST_EN_1 | PRT_EN_0
04119B ED 39 83    0150*   	out0 (TMR1_CTL+TMR_REG_CTL),a
04119E             0151*   ; enable timer,with interrupt and CONTINUOUS mode,clock divider 16
04119E 3E 57       0152*       ld a,PRT_IRQ_0 | IRQ_EN_1 | PRT_MODE_1 | CLK_DIV_16 | RST_EN_1 | PRT_EN_1
0411A0 ED 39 83    0153*   	out0 (TMR1_CTL+TMR_REG_CTL),a
0411A3 C9          0154*       ret
0411A4             0155*   
0411A4             0156*   ; ===============================================
0411A4             0157*   ; PRT Timer Interrupt Handling
0411A4             0158*   ; https://github.com/tomm/agon-cpu-emulator/blob/main/sdcard/regression_suite/timerirq.asm
0411A4             0159*   ; -----------------------------------------------
0411A4             0160*   prt_irq_init:
0411A4             0161*       ; set up interrupt vector table 2
0411A4 21 00 00 00 0162*   	ld hl,0
0411A8 3A 0C 01 00 0163*   	ld a,($10c)
0411AC 6F          0164*   	ld l,a
0411AD 3A 0D 01 00 0165*   	ld a,($10d)
0411B1 67          0166*   	ld h,a
0411B2             0167*   
0411B2             0168*   	; skip over CALL ($c3)
0411B2 23          0169*   	inc hl
0411B3             0170*   	; load address of jump into vector table 2 (in ram)
0411B3 ED 27       0171*   	ld hl,(hl)
0411B5             0172*   
0411B5             0173*   	; write CALL prt_irq_handler to vector table 2
0411B5 3E C3       0174*   	ld a,$c3
0411B7 77          0175*   	ld (hl),a
0411B8 23          0176*   	inc hl
0411B9 11 C0 11 04 0177*   	ld de,prt_irq_handler
0411BD ED 1F       0178*   	ld (hl),de
0411BF             0179*   
0411BF C9          0180*       ret
0411C0             0181*   
0411C0             0182*   prt_irq_handler:
0411C0 F3          0183*   	di
0411C1 F5          0184*   	push af
0411C2 E5          0185*       push hl
0411C3 ED 38 83    0186*   	in0 a,(TMR1_CTL+TMR_REG_CTL)
0411C6 2A D5 11 04 0187*   	ld hl,(prt_irq_counter)
0411CA 23          0188*   	inc hl
0411CB 22 D5 11 04 0189*   	ld (prt_irq_counter),hl
0411CF E1          0190*       pop hl
0411D0 F1          0191*   	pop af
0411D1 FB          0192*   	ei
0411D2 5B ED 4D    0193*   	reti.l
0411D5             0194*   
0411D5             0195*   prt_irq_counter:
0411D5 00 00 00    0196*   	.dl 0
0411D8             0197*   prt_irq_counter_saved:
0411D8 00 00 00    0198*       .dl 0
0411DB             0199*   
0411DB             0200*   prt_loop_reset:
0411DB E5          0201*       push hl
0411DC 21 00 00 00 0202*   	ld hl,0
0411E0 22 D5 11 04 0203*   	ld (prt_irq_counter),hl
0411E4 22 46 12 04 0204*       ld (prt_loop_counter),hl
0411E8 22 49 12 04 0205*       ld (prt_loops),hl
0411EC CD 87 11 04 0206*       call prt_set
0411F0 E1          0207*       pop hl
0411F1 C9          0208*       ret
0411F2             0209*   
0411F2             0210*   prt_loop_start:
0411F2 E5          0211*       push hl
0411F3 21 00 00 00 0212*   	ld hl,0
0411F7 22 D5 11 04 0213*   	ld (prt_irq_counter),hl
0411FB E1          0214*       pop hl
0411FC C9          0215*       ret
0411FD             0216*   
0411FD             0217*   prt_loop_stop:
0411FD E5          0218*       push hl
0411FE D5          0219*       push de
0411FF 2A D5 11 04 0220*       ld hl,(prt_irq_counter)
041203 ED 5B 46 12 0221*       ld de,(prt_loop_counter)
       04          
041208 19          0222*       add hl,de
041209 22 46 12 04 0223*       ld (prt_loop_counter),hl
04120D 21 00 00 00 0224*       ld hl,0
041211 22 D5 11 04 0225*       ld (prt_irq_counter),hl
041215 2A 49 12 04 0226*       ld hl,(prt_loops)
041219 23          0227*       inc hl
04121A 22 49 12 04 0228*       ld (prt_loops),hl
04121E D1          0229*       pop de
04121F E1          0230*       pop hl
041220 C9          0231*       ret
041221             0232*   
041221             0233*   ; inputs: bc = y,x text coordinates to print
