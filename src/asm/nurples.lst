047CB8             0169*   ; update a vertical bar display
047CB8             0170*   ; inputs: ix points to bar structure
047CB8             0171*   ;         bar_val set by caller
047CB8             0172*   ; prerequisite: bar_init called before first use
047CB8             0173*   bar_update_v:
047CB8             0174*   ; set gfx viewport
047CB8 DD E5       0175*       push ix ; preserve pointer
047CBA DD 07 03    0176*       ld bc,(ix+bar_x0)
047CBD DD 17 06    0177*       ld de,(ix+bar_y0)
047CC0 DD 31 0C    0178*       ld iy,(ix+bar_y1)
047CC3 DD 37 09    0179*       ld ix,(ix+bar_x1)
047CC6 CD E1 13 04 0180*       call vdu_set_gfx_viewport
047CCA DD E1       0181*       pop ix ; restore pointer
047CCC             0182*   ; select the color based on the value thresholds
047CCC DD 17 00    0183*       ld de,(ix+bar_val)
047CCF 21 EF FF FF 0184*       ld hl,-bar_red
047CD3 19          0185*       add hl,de
047CD4 D2 F1 7C 04 0186*       jp nc,@red
047CD8 21 DF FF FF 0187*       ld hl,-bar_yellow
047CDC 19          0188*       add hl,de
047CDD D2 E9 7C 04 0189*       jp nc,@yellow
047CE1 21 05 00 00 0190*       ld hl,BUF_BAR_V_2 ; green
047CE5 C3 F5 7C 04 0191*       jp @select
047CE9             0192*   @yellow:
047CE9 21 04 00 00 0193*       ld hl,BUF_BAR_V_1 ; yellow
047CED C3 F5 7C 04 0194*       jp @select
047CF1             0195*   @red:
047CF1 21 03 00 00 0196*       ld hl,BUF_BAR_V_0 ; red
047CF5             0197*   @select:
047CF5 CD 36 14 04 0198*       call vdu_buff_select
047CF9             0199*   ; get x-plot position
047CF9 DD 07 03    0200*       ld bc,(ix+bar_x0)
047CFC             0201*   ; compute y-plot position
047CFC DD 17 00    0202*       ld de,(ix+bar_val)
047CFF 21 40 00 00 0203*       ld hl,64
047D03 AF          0204*       xor a ; clear carry
047D04 ED 52       0205*       sbc hl,de
047D06 DD 17 0F    0206*       ld de,(ix+bar_y)
047D09 19          0207*       add hl,de
047D0A 7D          0208*       ld a,l
047D0B E6 FC       0209*       and %11111100 ; round to nearest 4 pixels
047D0D 6F          0210*       ld l,a
047D0E EB          0211*       ex de,hl
047D0F CD 36 18 04 0212*       call vdu_plot_bmp
