041301             0358*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041301 3E 08       0001*M1 			LD	A, function
041303 5B CF       0002*M1 			RST.LIL	08h
041305 DD 27 00    0359*       ld hl,(ix+sysvar_time)  ; get current time
041308 22 1D 13 04 0360*       ld (stopwatch_started),hl            ; set start time
04130C C9          0361*       ret
04130D             0362*   
04130D             0363*   ; gets time elapsed on a stopwatch
04130D             0364*   ; returns: hl = time elapsed in 1/120ths of a second
04130D             0365*   ; destroys: af,hl,de,ix
04130D             0366*   stopwatch_get:
04130D             0367*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04130D 3E 08       0001*M1 			LD	A, function
04130F 5B CF       0002*M1 			RST.LIL	08h
041311 DD 27 00    0368*       ld hl,(ix+sysvar_time)  ; get current time
041314 ED 5B 1D 13 0369*       ld de,(stopwatch_started)            ; get start time
       04          
041319 AF          0370*       xor a                   ; clear carry
04131A ED 52       0371*       sbc hl,de               ; hl = time elapsed (will always be zero or positive)
04131C C9          0372*       ret
04131D             0373*   
04131D             0374*   stopwatch_started: ds 3 ; buffer to hold stopwatch start time
041320             0375*   
041320             0376*   ; ------------------
041320             0377*   ; delay routine
041320             0378*   ; Author: Richard Turrnidge
041320             0379*   ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.asm
041320             0380*   ; routine waits a fixed time,then returns
041320             0381*   ; arrive with A =  the delay byte. One bit to be set only.
041320             0382*   ; eg. ld A,00000100b
041320             0383*   
041320             0384*   multiPurposeDelay:
       FF FF FF 
041320 F5          0385*       push af
041321 C5          0386*       push bc
041322 D5          0387*       push de
041323 DD E5       0388*       push ix
041325 5F          0389*       ld e,a ; timestamp bit mask
041326 3E 20       0390*       ld a,32
041328 32 79 13 04 0391*       ld (multiPurposeDelay_timeout_outer),a
04132C 06 00       0392*       ld b,0
04132E 16 00       0393*       ld d,0
041330 3E 08       0394*       ld a,$08
041332 5B CF       0395*       RST.LIL	08h                 ; get IX pointer to sysvars
041334             0396*   
041334             0397*   ; oldTimeStamp is per-call scratch, not persistent process state. Seed it from
041334             0398*   ; the requested clock bit so every call waits for a real transition.
041334 DD 7E 00    0399*       ld a,(ix + 0)
041337 A3          0400*       and e
041338 32 78 13 04 0401*       ld (oldTimeStamp),a
04133C             0402*   
04133C             0403*   waitLoop:
04133C             0404*   
04133C DD 7E 00    0405*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
04133F             0406*   
04133F             0407*                                   ;   we check if bit set is same as last time we checked.
04133F             0408*                                   ;   bit 0 - don't use
04133F             0409*                                   ;   bit 1 - changes 64 times per second
04133F             0410*                                   ;   bit 2 - changes 32 times per second
04133F             0411*                                   ;   bit 3 - changes 16 times per second
04133F             0412*   
04133F             0413*                                   ;   bit 4 - changes 8 times per second
04133F             0414*                                   ;   bit 5 - changes 4 times per second
04133F             0415*                                   ;   bit 6 - changes 2 times per second
04133F             0416*                                   ;   bit 7 - changes 1 times per second
04133F A3          0417*       and e
041340 4F          0418*       ld c,a
041341 3A 78 13 04 0419*       ld a,(oldTimeStamp)
041345 B9          0420*       cp c                        ; is A same as last value?
041346 C2 6C 13 04 0421*       jp nz,@changed
04134A             0422*   ; Bound a stalled MOS clock to 32 * 65,536 polls.
04134A 15          0423*       dec d
04134B C2 3C 13 04 0424*       jp nz,waitLoop
04134F 10 EB       0425*       djnz waitLoop
041351 3A 79 13 04 0426*       ld a,(multiPurposeDelay_timeout_outer)
041355 3D          0427*       dec a
041356 32 79 13 04 0428*       ld (multiPurposeDelay_timeout_outer),a
04135A C2 3C 13 04 0429*       jp nz,waitLoop
04135E 3A 77 13 04 0430*       ld a,(timer_fault_flags)
041362 F6 01       0431*       or %00000001
041364 32 77 13 04 0432*       ld (timer_fault_flags),a
041368 C3 71 13 04 0433*       jp @done
04136C             0434*   @changed:
04136C 79          0435*       ld a,c
04136D 32 78 13 04 0436*       ld (oldTimeStamp),a        ; set new value
041371             0437*   
041371             0438*   @done:
041371 DD E1       0439*       pop ix
041373 D1          0440*       pop de
041374 C1          0441*       pop bc
041375 F1          0442*       pop af
041376 C9          0443*       ret
041377             0444*   
041377             0445*   timer_fault_delay_timeout: equ 0
041377 00          0446*   timer_fault_flags: db 0
041378 00          0447*   oldTimeStamp: .db 00h
041379 00          0448*   multiPurposeDelay_timeout_outer: db 0
