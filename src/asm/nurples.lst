041EAD 00          0023*       db 0 ; string terminator
041EAE             0047        include "collisions.inc"
041EAE             0001*   ; ====== COLLISION DETECTION ======
041EAE             0002*   ; --- constants ---
041EAE             0003*   ; sprite_collisions flags
041EAE             0004*   ; collides_with_player: equ %00000001
041EAE             0005*   ; collides_with_laser: equ %00000010
041EAE             0006*   sprite_alive: equ 6; set when sprite is alive
041EAE             0007*   sprite_just_died: equ 7; set when sprite just died
041EAE             0008*   collide_top: equ %00001000
041EAE             0009*   collide_bottom: equ %00000100
041EAE             0010*   collide_left: equ %00000010
041EAE             0011*   collide_right: equ %00000001
041EAE             0012*   
041EAE 00 00 00    0013*   collision_table_pointer: dl 0x000000 ; pointer to the sprite in the group being checked for collision
041EB1             0014*   
041EB1             0015*   collision_draw_hitboxes:
041EB1             0016*   ; draw hitbox for ix collider
041EB1 DD E5       0017*       push ix
041EB3 FD E5       0018*       push iy
041EB5 AF          0019*       xor a ; color mode 0
041EB6 0E 09       0020*       ld c,c_red
041EB8 CD 89 13 04 0021*       call vdu_gcol
041EBC 01 00 00 00 0022*       ld bc,0
041EC0 DD 4E 02    0023*       ld c,(ix+sprite_x+1)
041EC3 DD 46 03    0024*       ld b,(ix+sprite_x+2)
041EC6 11 00 00 00 0025*       ld de,0
041ECA DD 5E 05    0026*       ld e,(ix+sprite_y+1)
041ECD DD 56 06    0027*       ld d,(ix+sprite_y+2)
041ED0 21 00 00 00 0028*       ld hl,0 ; clear hlu and h
041ED4 DD 6E 1E    0029*       ld l,(ix+sprite_dim_x)
041ED7 09          0030*       add hl,bc ; hl = x1
041ED8 E5          0031*       push hl ; save x1
041ED9 21 00 00 00 0032*       ld hl,0 ; clear hlu and h
041EDD DD 6E 1F    0033*       ld l,(ix+sprite_dim_y)
041EE0 19          0034*       add hl,de ; hl = y1
041EE1 DD E1       0035*       pop ix ; ix = x1 (was hl)
041EE3 E5          0036*       push hl
041EE4 FD E1       0037*       pop iy ; iy = y1
041EE6 CD 79 18 04 0038*       call vdu_plot_rf
041EEA FD E1       0039*       pop iy
041EEC DD E1       0040*       pop ix
041EEE             0041*   
041EEE             0042*   ; draw hitbox for iy collider
041EEE DD E5       0043*       push ix
041EF0 FD E5       0044*       push iy
041EF2 AF          0045*       xor a ; color mode 0
041EF3 0E 0A       0046*       ld c,c_green
041EF5 CD 89 13 04 0047*       call vdu_gcol
041EF9 01 00 00 00 0048*       ld bc,0
041EFD FD 4E 02    0049*       ld c,(iy+sprite_x+1)
041F00 FD 46 03    0050*       ld b,(iy+sprite_x+2)
041F03 11 00 00 00 0051*       ld de,0
041F07 FD 5E 05    0052*       ld e,(iy+sprite_y+1)
041F0A FD 56 06    0053*       ld d,(iy+sprite_y+2)
041F0D 21 00 00 00 0054*       ld hl,0 ; clear hlu and h
041F11 FD 6E 1E    0055*       ld l,(iy+sprite_dim_x)
041F14 09          0056*       add hl,bc ; hl = x1
041F15 E5          0057*       push hl ; save x1
041F16 21 00 00 00 0058*       ld hl,0 ; clear hlu and h
041F1A FD 6E 1F    0059*       ld l,(iy+sprite_dim_y)
041F1D 19          0060*       add hl,de ; hl = y1
041F1E DD E1       0061*       pop ix ; ix = x1 (was hl)
041F20 E5          0062*       push hl
041F21 FD E1       0063*       pop iy ; iy = y1
041F23 CD 79 18 04 0064*       call vdu_plot_rf
041F27 FD E1       0065*       pop iy
041F29 DD E1       0066*       pop ix
041F2B C9          0067*       ret
041F2C             0068*   ; end collision_draw_hitboxes
041F2C             0069*   
041F2C             0070*   ; check_collision:
041F2C             0071*   ; Detects collision using bounding box method.
041F2C             0072*   ; Inputs:
041F2C             0073*   ;   IX -> Sprite/Tile table for Collider A
041F2C             0074*   ;   IY -> Sprite/Tile table for Collider B
041F2C             0075*   ; Outputs:
041F2C             0076*   ;   a = 0, zero flag set, positive sign, carry reset -> Collision detected
041F2C             0077*   ;   a = -1, zero flag reset, negative sign, carry set -> No collision detected
041F2C             0078*   ; Destroys: HL, DE, AF
041F2C             0079*   check_collision:
041F2C             0080*   check_collision_box:
041F2C             0081*   ; Test 1: (ay + ah) - by < 0
041F2C 21 00 00 00 0082*       ld hl,0                     ; Clear hlu
041F30 DD 6E 05    0083*       ld l,(ix+sprite_y+1)        ; Load ay integer part low byte
041F33 DD 66 06    0084*       ld h,(ix+sprite_y+2)        ; Load ay integer part high byte
041F36 11 00 00 00 0085*       ld de,0                     ; Clear deu and d
041F3A DD 5E 1F    0086*       ld e,(ix+sprite_dim_y)      ; Load ah
041F3D 19          0087*       add hl,de                   ; (ay + ah)
041F3E FD 5E 05    0088*       ld e,(iy+sprite_y+1)        ; Load by integer part low byte
041F41 FD 56 06    0089*       ld d,(iy+sprite_y+2)        ; Load by integer part high byte
041F44 AF          0090*       xor a                       ; Clear carry
041F45 ED 52       0091*       sbc hl,de                   ; (ay + ah) - by
041F47 FA AA 1F 04 0092*       jp m,@not_collision         ; No collision if negative
041F4B             0093*   
041F4B             0094*   ; Test 2: ay - (by + bh) < 0
041F4B 21 00 00 00 0095*       ld hl,0                     ; Clear hlu
041F4F FD 6E 05    0096*       ld l,(iy+sprite_y+1)        ; Load by integer part low byte
041F52 FD 66 06    0097*       ld h,(iy+sprite_y+2)        ; Load by integer part high byte
041F55 11 00 00 00 0098*       ld de,0                     ; Clear deu and d
041F59 FD 5E 1F    0099*       ld e,(iy+sprite_dim_y)      ; Load bh
041F5C 19          0100*       add hl,de                   ; (by + bh)
041F5D DD 5E 05    0101*       ld e,(ix+sprite_y+1)        ; Load ay integer part low byte
041F60 DD 56 06    0102*       ld d,(ix+sprite_y+2)        ; Load ay integer part high byte
041F63 AF          0103*       xor a                       ; Clear carry
041F64 ED 52       0104*       sbc hl,de                   ; (by + bh) - ay
041F66 FA AA 1F 04 0105*       jp m,@not_collision         ; No collision if negative
041F6A             0106*   
041F6A             0107*   ; Test 3: (ax + aw) - bx < 0
041F6A 21 00 00 00 0108*       ld hl,0                     ; Clear hlu
041F6E DD 6E 02    0109*       ld l,(ix+sprite_x+1)        ; Load ax integer part low byte
041F71 DD 66 03    0110*       ld h,(ix+sprite_x+2)        ; Load ax integer part high byte
041F74 11 00 00 00 0111*       ld de,0                     ; Clear deu and d
041F78 DD 5E 1E    0112*       ld e,(ix+sprite_dim_x)      ; Load aw
041F7B 19          0113*       add hl,de                   ; (ax + aw)
041F7C FD 5E 02    0114*       ld e,(iy+sprite_x+1)        ; Load bx integer part low byte
041F7F FD 56 03    0115*       ld d,(iy+sprite_x+2)        ; Load bx integer part high byte
041F82 AF          0116*       xor a                       ; Clear carry
041F83 ED 52       0117*       sbc hl,de                   ; (ax + aw) - bx
041F85 FA AA 1F 04 0118*       jp m,@not_collision         ; No collision if negative
041F89             0119*   
041F89             0120*   ; Test 4: ax - (bx + bw) < 0
041F89 21 00 00 00 0121*       ld hl,0                     ; Clear hlu
041F8D FD 6E 02    0122*       ld l,(iy+sprite_x+1)        ; Load bx integer part low byte
041F90 FD 66 03    0123*       ld h,(iy+sprite_x+2)        ; Load bx integer part high byte
041F93 11 00 00 00 0124*       ld de,0                     ; Clear deu and d
041F97 FD 5E 1E    0125*       ld e,(iy+sprite_dim_x)      ; Load bw
041F9A 19          0126*       add hl,de                   ; (bx + bw)
041F9B DD 5E 02    0127*       ld e,(ix+sprite_x+1)        ; Load ax integer part low byte
041F9E DD 56 03    0128*       ld d,(ix+sprite_x+2)        ; Load ax integer part high byte
041FA1 AF          0129*       xor a                       ; Clear carry
041FA2 ED 52       0130*       sbc hl,de                   ; (bx + bw) - ax
041FA4 FA AA 1F 04 0131*       jp m,@not_collision         ; No collision if negative
041FA8             0132*   
041FA8             0133*   ; If all tests pass, collision is detected
041FA8             0134*   @is_collision:
041FA8 AF          0135*       xor a                       ; Clear accumulator and flags (a = 0)
041FA9 C9          0136*       ret                         ; Return with zero flag set
041FAA             0137*   
041FAA             0138*   ; No collision detected
041FAA             0139*   @not_collision:
041FAA 3D          0140*       dec a                       ; Set a to -1
041FAB C9          0141*       ret                         ; Return with carry set
041FAC             0142*   ; End check_collision_box
041FAC             0143*   
041FAC             0144*   
041FAC             0145*   ; this routine detects collisions between two collidable objects,
041FAC             0146*   ; which can include sprites, active tiles, or any screen coordinate
041FAC             0147*   ; which has been set up with a sprite table structure that includes dim_x
041FAC             0148*   ; representing the radius of the collidable object
041FAC             0149*   ; inputs: ix and iy point to the colliding objects' sprite/tile table records
041FAC             0150*   ; outputs: uh.l = distance - sum of radii
041FAC             0151*   ;          zero flag set if collision detected
041FAC             0152*   ;          dx168 and dy168 are also populated with the signed displacements
041FAC             0153*   ; destroys: everything except indexes
041FAC             0154*   ; check_collision:
041FAC             0155*   check_collision_cartesian:
041FAC             0156*   ; compute dx = x1-x0
041FAC DD 27 01    0157*       ld hl,(ix+sprite_x)
041FAF FD 17 01    0158*       ld de,(iy+sprite_x)
041FB2 AF          0159*       xor a ; clear carry
041FB3 ED 52       0160*       sbc hl,de
041FB5 22 84 07 04 0161*       ld (dx168),hl ; dx to scratch
041FB9             0162*   ; compute dy = y1-y0
041FB9 DD 27 04    0163*       ld hl,(ix+sprite_y)
041FBC FD 17 04    0164*       ld de,(iy+sprite_y)
041FBF AF          0165*       xor a ; clear carry
041FC0 ED 52       0166*       sbc hl,de ; hl = dy
041FC2 22 8A 07 04 0167*       ld (dy168),hl ; dy to scratch
041FC6             0168*   ; compute euclidean distance between centers
041FC6 CD 90 07 04 0169*       call distance168 ; uh.l = distance
041FCA             0170*   ; check for overlap by summing half the radii
041FCA DD 7E 1E    0171*       ld a,(ix+sprite_dim_x)
041FCD CB 3F       0172*       srl a ; divide by 2
041FCF FD 5E 1E    0173*       ld e,(iy+sprite_dim_x)
041FD2 CB 3B       0174*       srl e ; divide by 2
041FD4 83          0175*       add a,e
041FD5 11 00 00 00 0176*       ld de,0 ; clear deu and e
041FD9 57          0177*       ld d,a ; ud.e = sum of radii
041FDA B7          0178*       or a ; clear carry
041FDB ED 52       0179*       sbc hl,de ; uh.l = distance - sum of radii
041FDD C8          0180*       ret z ; return collision
041FDE F0          0181*       ret p ; return no collision
041FDF AF          0182*       xor a ; return collision
041FE0 C9          0183*       ret
041FE1             0184*   ; end check_collision_cartesian
041FE1             0185*   
041FE1             0186*   ; check collisions of a sprite or tile against a sprite group
041FE1             0187*   ; inputs: iy = pointer to sprite or tile record being checked
041FE1             0188*   ;         ix = pointer to sprite group, b = number of records in sprite group
041FE1             0189*   check_sprite_group_collisions:
041FE1             0190*   @collision_loop:
041FE1 DD 22 AE 1E 0191*       ld (collision_table_pointer),ix ; update table pointer
       04          
041FE6 C5          0192*       push bc ; backup loop counter
041FE7             0193*   ; check sprite_collisions sprite_alive flag to see if sprite is active
041FE7 DD CB 1D 76 0194*       bit sprite_alive,(ix+sprite_collisions)
041FEB CA 01 20 04 0195*       jp z,@next_record ; not alive so skip to next record
041FEF             0196*   ; sprite alive so check for collision
041FEF CD 2C 1F 04 0197*       call check_collision
041FF3 C2 01 20 04 0198*       jp nz,@next_record ; no collision
041FF7             0199*   ; set sprite_just_died flag for each entity and return to caller
041FF7 C1          0200*       pop bc ; dummy pop to balance stack
041FF8 DD CB 1D FE 0201*       set sprite_just_died,(ix+sprite_collisions)
041FFC FD CB 1D FE 0202*       set sprite_just_died,(iy+sprite_collisions)
042000 C9          0203*       ret
042001             0204*   @next_record:
042001 C1          0205*       pop bc ; get back our loop counter
042002 ED 32 40    0206*       lea ix,ix+table_record_size
042005 10 DA       0207*       djnz @collision_loop ; loop until we've checked all the records
042007             0208*   ; return to caller
042007 AF          0209*       xor a
042008 3C          0210*       inc a ; resets sign flag and a to non-zero indicating no collision
042009 C9          0211*       ret
04200A             0212*   ; end check_sprite_group_collisions
04200A             0213*   
04200A             0214*   check_enemy_collision_laser: ; check for collisions with laser
04200A DD 21 9E 9B 0215*       ld ix,player_lasers_begin
       04          
04200F 06 04       0216*       ld b,player_lasers_max
042011 CD E1 1F 04 0217*       call check_sprite_group_collisions
042015 C9          0218*       ret
042016             0219*   ; end check_enemy_collision_laser
042016             0220*   
042016             0221*   check_enemy_collision_player: ; check for collisions with player
042016 DD 21 9E 9C 0222*       ld ix,player_begin
       04          
04201B CD 2C 1F 04 0223*       call check_collision
04201F C0          0224*       ret nz ; no collision so nothing to do
042020 DD CB 1D FE 0225*       set sprite_just_died,(ix+sprite_collisions)
042024 FD CB 1D FE 0226*       set sprite_just_died,(iy+sprite_collisions)
042028 AF          0227*       xor a ; signal collision detected
042029 C9          0228*       ret
04202A             0229*   ; end check_enemy_collision_player
