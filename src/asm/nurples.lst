047B3B CB 6F       0105*       bit btn1_a,a
047B3D CA DE 7B 04 0106*       jp z,player_spawn_laser
047B41             0107*   ; 99 Space: fire main weapon
047B41 DD CB 0C 56 0108*       bit 2,(ix+12)
047B45 C2 DE 7B 04 0109*       jp nz,player_spawn_laser
047B49             0110*   ; no fire button pressed so go home
047B49 C9          0111*       ret
047B4A             0112*   ; end player_input
