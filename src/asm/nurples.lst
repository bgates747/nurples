047742             0040*   ; end tile_activation_routines
047742             0041*   
047742             0042*   activate_null_tile:
047742 C9          0043*       ret ; dummy routine, do nothing
047743             0044*   move_active_tile:
047743             0045*   ; y-axis movement
047743 FD 27 04    0046*       ld hl,(iy+tile_y)
047746 FD 17 0A    0047*       ld de,(iy+tile_yvel)
047749 19          0048*       add hl,de
04774A FD 2F 04    0049*       ld (iy+tile_y),hl
04774D             0050*   ; detect screen edge collisions
04774D             0051*   ; y-axis bottom is all we need to test
04774D 11 00 80 FE 0052*       ld de,-tile_bottom*256
047751 ED 5A       0053*       adc hl,de
047753 F8          0054*       ret m ; still on screen so do nothing further
047754 AF          0055*       xor a ; signal caller that tile has scrolled off screen
047755 C9          0056*       ret
047756             0057*   ; end move_active_tile
047756             0058*   
047756             0059*   ; Exact stabilization whitelist for writable legacy tile callbacks.
047756             0060*   ; inputs: iy = validated tile record, hl = stored callback
047756             0061*   ; outputs: carry set and hl = expected callback on an exact type/program match
047756             0062*   ; destroys: a,de,hl
047756             0063*   tile_move_program_valid:
047756 FD 7E 16    0064*       ld a,(iy+tile_type)
047759 FE 01       0065*       cp tile_pad_small
04775B CA 7B 77 04 0066*       jp z,@pad_small
04775F FE 05       0067*       cp tile_turret_fireball
047761 CA 83 77 04 0068*       jp z,@turret_fireball
047765 FE 09       0069*       cp tile_electrode
047767 CA 8B 77 04 0070*       jp z,@electrode
04776B FE 0A       0071*       cp tile_lightning
04776D CA 93 77 04 0072*       jp z,@lightning
047771 FE 10       0073*       cp tile_crater
047773 CA 9B 77 04 0074*       jp z,@crater
047777 C3 AA 77 04 0075*       jp @invalid
04777B             0076*   @pad_small:
04777B 11 1D 7B 04 0077*       ld de,move_pad_small
04777F C3 9F 77 04 0078*       jp @compare
047783             0079*   @turret_fireball:
047783 11 92 7B 04 0080*       ld de,move_turret_fireball
047787 C3 9F 77 04 0081*       jp @compare
04778B             0082*   @electrode:
04778B 11 19 79 04 0083*       ld de,move_electrode
04778F C3 9F 77 04 0084*       jp @compare
047793             0085*   @lightning:
047793 11 BB 7A 04 0086*       ld de,move_lightning
047797 C3 9F 77 04 0087*       jp @compare
04779B             0088*   @crater:
04779B 11 CB 78 04 0089*       ld de,move_crater
04779F             0090*   @compare:
04779F B7          0091*       or a
0477A0 ED 52       0092*       sbc hl,de
0477A2 C2 AA 77 04 0093*       jp nz,@invalid
0477A6 D5          0094*       push de
0477A7 E1          0095*       pop hl ; publish the fixed expected address, not writable record data
0477A8 37          0096*       scf
0477A9 C9          0097*       ret
0477AA             0098*   @invalid:
0477AA AF          0099*       xor a
0477AB C9          0100*       ret
0477AC             0101*   ; end tile_move_program_valid
0477AC             0102*   
0477AC             0103*   move_tiles:
0477AC             0104*   ; initialize the dense-stack cursor
0477AC 3A 3B 73 04 0105*       ld a,(num_active_tiles)
0477B0 B7          0106*       or a
0477B1 C8          0107*       ret z
0477B2 FD 21 32 70 0108*       ld iy,tile_stack ; set iy to first record in table
       04          
0477B7             0109*   @move_loop:
0477B7 FD E5       0110*       push iy
0477B9 E1          0111*       pop hl
0477BA CD E6 73 04 0112*       call tile_stack_pointer_valid
0477BE D0          0113*       ret nc ; normal end-of-stack or fail-closed malformed cursor
0477BF FD 22 35 73 0114*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
0477C4             0115*   ; point iy to tile record
0477C4 FD 37 00    0116*       ld iy,(iy) ; iy points to the current tile record
0477C7 CD 1F 74 04 0117*       call tile_table_record_pointer_valid
0477CB D2 15 78 04 0118*       jp nc,@bad_record
0477CF FD 22 38 73 0119*       ld (tile_table_pointer),iy ; update table pointer
       04          
0477D4             0120*   ; check top bit of tile_type to see if tile is just spawned
0477D4 FD CB 16 7E 0121*       bit 7,(iy+tile_type)
0477D8 C2 05 78 04 0122*       jp nz,@just_spawned ; if just spawned, skip to next record
0477DC             0123*   ; check sprite_alive bit to see if tile is active
0477DC FD CB 1D 76 0124*       bit sprite_alive,(iy+tile_collisions)
0477E0 CA 0D 78 04 0125*       jp z,@inactive_record
0477E4             0126*   ; otherwise we prepare to move the tile
0477E4 FD 27 1A    0127*       ld hl,(iy+tile_move_program) ; load the behavior subroutine address
0477E7 CD 56 77 04 0128*       call tile_move_program_valid
0477EB D2 23 78 04 0129*       jp nc,@bad_move_program
0477EF FD E5       0130*       push iy ; callbacks may use index registers internally but do not own them
0477F1             0131*       CALL_HL
                       M1 Args: none
0477F1 01 F7 77 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
0477F5 C5          0002*M1     push bc ; which constitutes the return address
0477F6 E9          0003*M1     jp (hl) ; Jump to the address in HL
0477F7 FD E1       0132*       pop iy
0477F9             0133*    ; get back stack pointer and loop
0477F9             0134*   @next_record:
0477F9 FD 2A 35 73 0135*       ld iy,(tile_stack_pointer)
       04          
0477FE ED 33 03    0136*       lea iy,iy+3 ; next tile stack record
047801 C3 B7 77 04 0137*       jp @move_loop ; loop until we've checked all the records
047805             0138*   @just_spawned:
047805 FD CB 16 BE 0139*       res 7,(iy+tile_type) ; clear just spawned flag
047809 C3 F9 77 04 0140*       jp @next_record
04780D             0141*   @inactive_record:
04780D CD 55 74 04 0142*       call table_deactivate_tile
047811 C3 F9 77 04 0143*       jp @next_record
047815             0144*   @bad_record:
047815 21 42 73 04 0145*       ld hl,tile_fault_flags
047819 CB C6       0146*       set tile_fault_bad_record,(hl)
04781B CD 99 74 04 0147*       call tile_stack_quarantine_entry
04781F C3 F9 77 04 0148*       jp @next_record
047823             0149*   @bad_move_program:
047823 21 42 73 04 0150*       ld hl,tile_fault_flags
047827 CB CE       0151*       set tile_fault_bad_move_program,(hl)
047829 CD 55 74 04 0152*       call table_deactivate_tile
04782D C3 F9 77 04 0153*       jp @next_record
047831             0154*   ; end move_tiles
047831             0155*   
047831             0156*   draw_active_tile:
047831 FD 27 17    0157*       ld hl,(iy+tile_base_bufferId)
047834 FD 7E 28    0158*       ld a,(iy+tile_frame)
047837 85          0159*       add a,l ; TODO: with a little work we could make all tile base buffer ids align to 256
047838 6F          0160*       ld l,a
047839 3E 00       0161*       ld a,0 ; preserve carry
04783B 8C          0162*       adc a,h
04783C 67          0163*       ld h,a
04783D CD E4 14 04 0164*       call vdu_buff_select ; buffer id of animation frame
047841 FD 07 01    0165*       ld bc,(iy+tile_x)
047844 FD 17 04    0166*       ld de,(iy+tile_y)
047847 CD 36 19 04 0167*       call vdu_plot_bmp168
04784B C9          0168*       ret
04784C             0169*   ; end draw_active_tile
04784C             0170*   
04784C             0171*   ; create a new sprite at the same location as the current tile
04784C             0172*   ; inputs: hl = pointer to new sprite default settings, tile_table_pointer = current tile
04784C             0173*   ;         ix = pointer to sprite group, b = number of records in sprite group
04784C             0174*   spawn_sprite_from_tile:
04784C E5          0175*       push hl ; back up pointer to new sprite defaults
04784D CD EA 67 04 0176*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
047851 E1          0177*       pop hl ; restore pointer to new sprite defaults
047852 D0          0178*       ret nc ; no carry means no free sprite slots, so we go home
047853             0179*   ; copy default settings to new sprite
047853 DD E5       0180*       push ix ; back up pointer to new sprite record
047855 ED 32 16    0181*       lea ix,ix+sprite_definitions ; bump pointer to copy to
047858 DD E5       0182*       push ix ; pointer to default sprite settings
04785A D1          0183*       pop de ; address to copy to
04785B 01 13 00 00 0184*       ld bc,sprite_definitions_size ; copy only bytes provided by defaults
04785F ED B0       0185*       ldir ; copies defaults to new sprite record
047861 DD E1       0186*       pop ix ; restore pointer to new sprite record
047863             0187*   ; copy sprite position from existing tile
047863 FD 2A 38 73 0188*       ld iy,(tile_table_pointer) ; get existing tile record
       04          
047868 FD 27 01    0189*       ld hl,(iy+tile_x)
04786B DD 2F 01    0190*       ld (ix+sprite_x),hl
04786E FD 27 04    0191*       ld hl,(iy+tile_y)
047871 DD 2F 04    0192*       ld (ix+sprite_y),hl
047874             0193*   ; clear motion state retained by a previously used physical record
047874 21 00 00 00 0194*       ld hl,0
047878 DD 2F 07    0195*       ld (ix+sprite_xvel),hl
04787B DD 2F 0A    0196*       ld (ix+sprite_yvel),hl
04787E DD 2F 0D    0197*       ld (ix+sprite_vel),hl
047881 DD 2F 10    0198*       ld (ix+sprite_heading),hl
047884 DD 2F 13    0199*       ld (ix+sprite_orientation),hl
047887             0200*   ; return to caller
047887 DD CB 16 FE 0201*       set 7,(ix+sprite_type) ; set just spawned flag
04788B DD CB 1D F6 0202*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
04788F 37          0203*       scf ; set carry flag to indicate success
047890 C9          0204*       ret
047891             0205*   ; end spawn_sprite_from_tile
047891             0206*   
047891             0207*   ; create a new tile at the same location as the current tile
047891             0208*   ; inputs: tile_table_pointer = current tile
047891             0209*   spawn_active_tile_from_tile:
047891             0210*   ; copy default settings to new tile
047891 DD 2A 38 73 0211*       ld ix,(tile_table_pointer) ; get existing tile record
       04          
047896 ED 32 16    0212*       lea ix,ix+tile_definitions ; bump pointer to copy to
047899 DD E5       0213*       push ix ; pointer to default tile settings
04789B D1          0214*       pop de ; address to copy to
04789C 01 13 00 00 0215*       ld bc,tile_definitions_size ; copy only bytes provided by defaults
0478A0 ED B0       0216*       ldir ; copies defaults to new tile record
0478A2 DD 2A 38 73 0217*       ld ix,(tile_table_pointer) ; restore pointer to new tile record
       04          
0478A7 C9          0218*       ret
0478A8             0219*   ; end spawn_active_tile_from_tile
0478A8             0077        include "tile_crater.inc"
0478A8             0001*   crater_defaults:
0478A8 10          0002*       db tile_crater          ; type
0478A9 04 01 00    0003*       dl BUF_CRATER_A      ; base_bufferId
0478AC CB 78 04    0004*       dl move_crater          ; move_program
0478AF 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
0478B0 10          0006*       db 16                   ; dim_x
0478B1 10          0007*       db 16                   ; dim_y
0478B2 01          0008*       db 1                    ; num_orientations
0478B3 04          0009*       db 4                    ; num_animations
0478B4 05          0010*       db 5	                ; animation
0478B5 08          0011*       db 8                    ; animation_timer
0478B6 00          0012*       db 0                    ; move_timer
0478B7 00          0013*       db 0                    ; move_step
0478B8 00          0014*       db 0                    ; points
0478B9 00          0015*       db 0                    ; shield_damage
0478BA 00          0016*       db 0                    ; frame
0478BB             0017*   
0478BB             0018*   activate_crater:
0478BB 21 A8 78 04 0019*       ld hl,crater_defaults
0478BF C3 ED 74 04 0020*       jp spawn_active_tile
0478C3             0021*   ; end activate_crater
0478C3             0022*   
0478C3             0023*   ; Replace an existing active tile without allocating or changing its position.
0478C3             0024*   transform_active_tile_to_crater:
0478C3 21 A8 78 04 0025*       ld hl,crater_defaults
0478C7 C3 91 78 04 0026*       jp spawn_active_tile_from_tile
0478CB             0027*   ; end transform_active_tile_to_crater
0478CB             0028*   
0478CB             0029*   move_crater:
0478CB CD 43 77 04 0030*       call move_active_tile
0478CF CA 55 74 04 0031*       jp z,table_deactivate_tile
0478D3             0032*   ; do animation
0478D3 FD 35 23    0033*       dec (iy+tile_animation_timer)
0478D6 C0          0034*       ret nz ; not time to animate
0478D7 FD 35 22    0035*       dec (iy+sprite_animation) ; check whether time to transition to crater
0478DA CC F0 78 04 0036*       call z,@make_crater
0478DE 3E 08       0037*       ld a,8
0478E0 FD 77 23    0038*       ld (iy+tile_animation_timer),a
0478E3 FD 7E 28    0039*       ld a,(iy+tile_frame)
0478E6 3C          0040*       inc a
0478E7 E6 03       0041*       and %00000011 ; modulo 4
0478E9 FD 77 28    0042*       ld (iy+tile_frame),a
0478EC C3 31 78 04 0043*       jp draw_active_tile
0478F0             0044*   @make_crater:
0478F0 21 00 01 00 0045*       ld hl,BUF_CRATER_0
0478F4 FD 2F 17    0046*       ld (iy+tile_base_bufferId),hl
0478F7 3E FF       0047*       ld a,-1 ; will wrap to zero on return
0478F9 FD 77 28    0048*       ld (iy+tile_frame),a
0478FC C9          0049*       ret
0478FD             0050*   ; end move_crater
0478FD             0078        include "tile_electrode.inc"
0478FD             0001*   electrode_defaults:
0478FD 09          0002*       db tile_electrode       ; type
0478FE 76 01 00    0003*       dl BUF_TILE_BLANK       ; base_bufferId
047901 19 79 04    0004*       dl move_electrode       ; move_program
047904 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
047905 10          0006*       db 16                   ; dim_x
047906 10          0007*       db 16                   ; dim_y
047907 01          0008*       db 1                    ; num_orientations
047908 01          0009*       db 1                    ; num_animations
047909 00          0010*       db 0                    ; animation
04790A 00          0011*       db 0                    ; animation_timer
04790B 00          0012*       db 0                    ; move_timer
04790C 00          0013*       db 0                    ; move_step
04790D 05          0014*       db 5                    ; points
04790E FC          0015*       db -4                   ; shield_damage
04790F 00          0016*       db 0                    ; frame
047910             0017*   
047910             0018*   activate_electrode:
047910 21 FD 78 04 0019*       ld hl,electrode_defaults
047914             0020*   ; get next available active tile id
047914 CD ED 74 04 0021*       call spawn_active_tile
047918             0022*       ; ret nc ; no carry means no free active tile slots, so we go home
047918             0023*   ; other specific initialization
047918 C9          0024*       ret
047919             0025*   ; end activate_electrode
047919             0026*   
047919             0027*   move_electrode:
047919 CD 43 77 04 0028*       call move_active_tile
04791D CA 55 74 04 0029*       jp z,table_deactivate_tile
047921 DD 21 86 88 0030*       ld ix,player_begin
       04          
047926 DD CB 1D 76 0031*       bit sprite_alive,(ix+sprite_collisions)
04792A CA 3E 79 04 0032*       jp z,@laser ; player is dead so don't check for collisions
04792E CD D8 49 04 0033*       call check_enemy_collision_player
047932 C2 3E 79 04 0034*       jp nz,@laser ; no collision so check laser collision
047936 CD B5 66 04 0035*       call update_shields
04793A C3 4B 79 04 0036*       jp kill_electrode
04793E             0037*   @laser:
04793E CD CC 49 04 0038*       call check_enemy_collision_laser
047942 C0          0039*       ret nz ; no collision so we're done
047943 CD 58 66 04 0040*       call update_score
047947 C3 4B 79 04 0041*       jp kill_electrode
04794B             0042*   ; end move_electrode
04794B             0043*   
04794B             0044*   kill_electrode:
04794B             0045*   ; Preserve the source record itself. Removing earlier stack entries may change
04794B             0046*   ; its dense-stack slot, so the slot is rediscovered after the scan.
04794B FD 22 9A 7A 0047*       ld (@source_tile_pointer),iy
       04          
047950 FD 27 04    0048*       ld hl,(iy+tile_y)
047953 22 97 7A 04 0049*       ld (@tile_y),hl
047957             0050*   ; activate blank tile bitmap only after source data no longer depends on IY
047957 21 76 01 00 0051*       ld hl,BUF_TILE_BLANK
04795B CD E4 14 04 0052*       call vdu_buff_select
04795F             0053*   ; Bound the scan to the entry count at its start. Each processed or removed
04795F             0054*   ; entry consumes one unit; removal leaves IX on the shifted successor.
04795F 3A 3B 73 04 0055*       ld a,(num_active_tiles)
047963 32 9D 7A 04 0056*       ld (@tiles_remaining),a
047967 DD 21 32 70 0057*       ld ix,tile_stack ; set ix to first record in table
       04          
04796C             0058*   @check_loop:
04796C 3A 9D 7A 04 0059*       ld a,(@tiles_remaining)
047970 B7          0060*       or a
047971 CA 23 7A 04 0061*       jp z,@scan_done
047975 3D          0062*       dec a
047976 32 9D 7A 04 0063*       ld (@tiles_remaining),a
04797A             0064*   ; validate the stack slot before loading its pointer
04797A DD E5       0065*       push ix
04797C E1          0066*       pop hl
04797D CD E6 73 04 0067*       call tile_stack_pointer_valid
047981 D2 23 7A 04 0068*       jp nc,@scan_done
047985 DD 22 94 7A 0069*       ld (@tile_stack_pointer),ix ; update stack pointer
       04          
04798A             0070*   ; validate the record before reading any fields
04798A DD 31 00    0071*       ld iy,(ix)
04798D CD 1F 74 04 0072*       call tile_table_record_pointer_valid
047991 D2 FF 79 04 0073*       jp nc,@bad_record
047995             0074*   ; check top bit of tile_type to see if tile is just spawned
047995 FD CB 16 7E 0075*       bit 7,(iy+tile_type)
047999 C2 17 7A 04 0076*       jp nz,@next_record ; if just spawned, skip to next record
04799D             0077*   ; check sprite_alive bit to see if tile is active
04799D FD CB 1D 76 0078*       bit sprite_alive,(iy+tile_collisions)
0479A1 CA ED 79 04 0079*       jp z,@inactive_record
0479A5             0080*   ; check tile type
0479A5 FD 7E 16    0081*       ld a,(iy+tile_type)
0479A8 FE 0A       0082*       cp tile_lightning ; check if tile is lightning
0479AA C2 17 7A 04 0083*       jp nz,@next_record ; if not lightning, skip to next record
0479AE             0084*   ; check tile position
0479AE DD 22 35 73 0085*       ld (tile_stack_pointer),ix
       04          
0479B3 FD 22 38 73 0086*       ld (tile_table_pointer),iy
       04          
0479B8 FD 27 04    0087*       ld hl,(iy+tile_y)
0479BB ED 5B 97 7A 0088*       ld de,(@tile_y)
       04          
0479C0 B7          0089*       or a ; clear carry
0479C1 E5          0090*       push hl
0479C2 ED 52       0091*       sbc hl,de
0479C4 E1          0092*       pop hl
0479C5 CA D5 79 04 0093*       jp z,@kill_it
0479C9 01 00 01 00 0094*       ld bc,1*256
0479CD 09          0095*       add hl,bc
0479CE B7          0096*       or a
0479CF ED 52       0097*       sbc hl,de
0479D1 C2 17 7A 04 0098*       jp nz,@next_record
0479D5             0099*   @kill_it: ; deactivate tile and replace with inactive blank tile
0479D5 FD 07 01    0100*       ld bc,(iy+tile_x) ; get x position (ud.e already has y-position)
0479D8 FD E5       0101*       push iy
0479DA CD 36 19 04 0102*       call vdu_plot_bmp168 ; plot blank tile (bitmap was activated at beginning of proc)
0479DE FD E1       0103*       pop iy
0479E0 CD 55 74 04 0104*       call table_deactivate_tile
0479E4 DD 2A 94 7A 0105*       ld ix,(@tile_stack_pointer) ; get back stack pointer
       04          
0479E9 C3 6C 79 04 0106*       jp @check_loop ; deactivate tile naturally advances to next record
0479ED             0107*   @inactive_record:
0479ED             0108*   ; A valid inactive record violates the dense-stack invariant but is safe to
0479ED             0109*   ; remove. Keep IX on this slot so the shifted successor is checked next.
0479ED DD 22 35 73 0110*       ld (tile_stack_pointer),ix
       04          
0479F2 CD 55 74 04 0111*       call table_deactivate_tile
0479F6 DD 2A 94 7A 0112*       ld ix,(@tile_stack_pointer)
       04          
0479FB C3 6C 79 04 0113*       jp @check_loop
0479FF             0114*   @bad_record:
0479FF             0115*   ; The slot itself was validated, so it can be quarantined without touching the
0479FF             0116*   ; malformed record pointer. Continue at the successor shifted into this slot.
0479FF 21 42 73 04 0117*       ld hl,tile_fault_flags
047A03 CB C6       0118*       set tile_fault_bad_record,(hl)
047A05 DD 22 35 73 0119*       ld (tile_stack_pointer),ix
       04          
047A0A CD 99 74 04 0120*       call tile_stack_quarantine_entry
047A0E DD 2A 94 7A 0121*       ld ix,(@tile_stack_pointer)
       04          
