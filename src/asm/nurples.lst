041EA7 00          0023*       db 0 ; string terminator
041EA8             0047        include "collisions.inc"
041EA8             0001*   ; ====== COLLISION DETECTION ======
041EA8             0002*   ; --- constants ---
041EA8             0003*   ; sprite_collisions flags
041EA8             0004*   ; collides_with_player: equ %00000001
041EA8             0005*   ; collides_with_laser: equ %00000010
041EA8             0006*   sprite_alive: equ 6; set when sprite is alive
041EA8             0007*   sprite_just_died: equ 7; set when sprite just died
041EA8             0008*   collide_top: equ %00001000
041EA8             0009*   collide_bottom: equ %00000100
041EA8             0010*   collide_left: equ %00000010
041EA8             0011*   collide_right: equ %00000001
041EA8             0012*   
041EA8 00 00 00    0013*   collision_table_pointer: dl 0x000000 ; pointer to the sprite in the group being checked for collision
041EAB             0014*   
041EAB             0015*   collision_draw_hitboxes:
041EAB             0016*   ; draw hitbox for ix collider
041EAB DD E5       0017*       push ix
041EAD FD E5       0018*       push iy
041EAF AF          0019*       xor a ; color mode 0
041EB0 0E 09       0020*       ld c,c_red
041EB2 CD 83 13 04 0021*       call vdu_gcol
041EB6 01 00 00 00 0022*       ld bc,0
041EBA DD 4E 02    0023*       ld c,(ix+sprite_x+1)
041EBD DD 46 03    0024*       ld b,(ix+sprite_x+2)
041EC0 11 00 00 00 0025*       ld de,0
041EC4 DD 5E 05    0026*       ld e,(ix+sprite_y+1)
041EC7 DD 56 06    0027*       ld d,(ix+sprite_y+2)
041ECA 21 00 00 00 0028*       ld hl,0 ; clear hlu and h
041ECE DD 6E 1E    0029*       ld l,(ix+sprite_dim_x)
041ED1 09          0030*       add hl,bc ; hl = x1
041ED2 E5          0031*       push hl ; save x1
041ED3 21 00 00 00 0032*       ld hl,0 ; clear hlu and h
041ED7 DD 6E 1F    0033*       ld l,(ix+sprite_dim_y)
041EDA 19          0034*       add hl,de ; hl = y1
041EDB DD E1       0035*       pop ix ; ix = x1 (was hl)
041EDD E5          0036*       push hl
041EDE FD E1       0037*       pop iy ; iy = y1
041EE0 CD 73 18 04 0038*       call vdu_plot_rf
041EE4 FD E1       0039*       pop iy
041EE6 DD E1       0040*       pop ix
041EE8             0041*   
041EE8             0042*   ; draw hitbox for iy collider
041EE8 DD E5       0043*       push ix
041EEA FD E5       0044*       push iy
041EEC AF          0045*       xor a ; color mode 0
041EED 0E 0A       0046*       ld c,c_green
041EEF CD 83 13 04 0047*       call vdu_gcol
041EF3 01 00 00 00 0048*       ld bc,0
041EF7 FD 4E 02    0049*       ld c,(iy+sprite_x+1)
041EFA FD 46 03    0050*       ld b,(iy+sprite_x+2)
041EFD 11 00 00 00 0051*       ld de,0
041F01 FD 5E 05    0052*       ld e,(iy+sprite_y+1)
041F04 FD 56 06    0053*       ld d,(iy+sprite_y+2)
041F07 21 00 00 00 0054*       ld hl,0 ; clear hlu and h
041F0B FD 6E 1E    0055*       ld l,(iy+sprite_dim_x)
041F0E 09          0056*       add hl,bc ; hl = x1
041F0F E5          0057*       push hl ; save x1
041F10 21 00 00 00 0058*       ld hl,0 ; clear hlu and h
041F14 FD 6E 1F    0059*       ld l,(iy+sprite_dim_y)
041F17 19          0060*       add hl,de ; hl = y1
041F18 DD E1       0061*       pop ix ; ix = x1 (was hl)
041F1A E5          0062*       push hl
041F1B FD E1       0063*       pop iy ; iy = y1
041F1D CD 73 18 04 0064*       call vdu_plot_rf
041F21 FD E1       0065*       pop iy
041F23 DD E1       0066*       pop ix
041F25 C9          0067*       ret
041F26             0068*   ; end collision_draw_hitboxes
041F26             0069*   
041F26             0070*   ; check_collision:
041F26             0071*   ; Detects collision using bounding box method.
041F26             0072*   ; Inputs:
041F26             0073*   ;   IX -> Sprite/Tile table for Collider A
041F26             0074*   ;   IY -> Sprite/Tile table for Collider B
041F26             0075*   ; Outputs:
041F26             0076*   ;   a = 0, zero flag set, positive sign, carry reset -> Collision detected
041F26             0077*   ;   a = -1, zero flag reset, negative sign, carry set -> No collision detected
041F26             0078*   ; Destroys: HL, DE, AF
041F26             0079*   check_collision:
041F26             0080*   check_collision_box:
041F26             0081*   ; Test 1: (ay + ah) - by < 0
041F26 21 00 00 00 0082*       ld hl,0                     ; Clear hlu
041F2A DD 6E 05    0083*       ld l,(ix+sprite_y+1)        ; Load ay integer part low byte
041F2D DD 66 06    0084*       ld h,(ix+sprite_y+2)        ; Load ay integer part high byte
041F30 11 00 00 00 0085*       ld de,0                     ; Clear deu and d
041F34 DD 5E 1F    0086*       ld e,(ix+sprite_dim_y)      ; Load ah
041F37 19          0087*       add hl,de                   ; (ay + ah)
041F38 FD 5E 05    0088*       ld e,(iy+sprite_y+1)        ; Load by integer part low byte
041F3B FD 56 06    0089*       ld d,(iy+sprite_y+2)        ; Load by integer part high byte
041F3E AF          0090*       xor a                       ; Clear carry
041F3F ED 52       0091*       sbc hl,de                   ; (ay + ah) - by
041F41 FA A4 1F 04 0092*       jp m,@not_collision         ; No collision if negative
041F45             0093*   
041F45             0094*   ; Test 2: ay - (by + bh) < 0
041F45 21 00 00 00 0095*       ld hl,0                     ; Clear hlu
041F49 FD 6E 05    0096*       ld l,(iy+sprite_y+1)        ; Load by integer part low byte
041F4C FD 66 06    0097*       ld h,(iy+sprite_y+2)        ; Load by integer part high byte
041F4F 11 00 00 00 0098*       ld de,0                     ; Clear deu and d
041F53 FD 5E 1F    0099*       ld e,(iy+sprite_dim_y)      ; Load bh
041F56 19          0100*       add hl,de                   ; (by + bh)
041F57 DD 5E 05    0101*       ld e,(ix+sprite_y+1)        ; Load ay integer part low byte
041F5A DD 56 06    0102*       ld d,(ix+sprite_y+2)        ; Load ay integer part high byte
041F5D AF          0103*       xor a                       ; Clear carry
041F5E ED 52       0104*       sbc hl,de                   ; (by + bh) - ay
041F60 FA A4 1F 04 0105*       jp m,@not_collision         ; No collision if negative
041F64             0106*   
041F64             0107*   ; Test 3: (ax + aw) - bx < 0
041F64 21 00 00 00 0108*       ld hl,0                     ; Clear hlu
041F68 DD 6E 02    0109*       ld l,(ix+sprite_x+1)        ; Load ax integer part low byte
041F6B DD 66 03    0110*       ld h,(ix+sprite_x+2)        ; Load ax integer part high byte
041F6E 11 00 00 00 0111*       ld de,0                     ; Clear deu and d
041F72 DD 5E 1E    0112*       ld e,(ix+sprite_dim_x)      ; Load aw
041F75 19          0113*       add hl,de                   ; (ax + aw)
041F76 FD 5E 02    0114*       ld e,(iy+sprite_x+1)        ; Load bx integer part low byte
041F79 FD 56 03    0115*       ld d,(iy+sprite_x+2)        ; Load bx integer part high byte
041F7C AF          0116*       xor a                       ; Clear carry
041F7D ED 52       0117*       sbc hl,de                   ; (ax + aw) - bx
041F7F FA A4 1F 04 0118*       jp m,@not_collision         ; No collision if negative
041F83             0119*   
041F83             0120*   ; Test 4: ax - (bx + bw) < 0
041F83 21 00 00 00 0121*       ld hl,0                     ; Clear hlu
041F87 FD 6E 02    0122*       ld l,(iy+sprite_x+1)        ; Load bx integer part low byte
041F8A FD 66 03    0123*       ld h,(iy+sprite_x+2)        ; Load bx integer part high byte
041F8D 11 00 00 00 0124*       ld de,0                     ; Clear deu and d
041F91 FD 5E 1E    0125*       ld e,(iy+sprite_dim_x)      ; Load bw
041F94 19          0126*       add hl,de                   ; (bx + bw)
041F95 DD 5E 02    0127*       ld e,(ix+sprite_x+1)        ; Load ax integer part low byte
041F98 DD 56 03    0128*       ld d,(ix+sprite_x+2)        ; Load ax integer part high byte
041F9B AF          0129*       xor a                       ; Clear carry
041F9C ED 52       0130*       sbc hl,de                   ; (bx + bw) - ax
041F9E FA A4 1F 04 0131*       jp m,@not_collision         ; No collision if negative
041FA2             0132*   
041FA2             0133*   ; If all tests pass, collision is detected
041FA2             0134*   @is_collision:
041FA2 AF          0135*       xor a                       ; Clear accumulator and flags (a = 0)
041FA3 C9          0136*       ret                         ; Return with zero flag set
041FA4             0137*   
041FA4             0138*   ; No collision detected
041FA4             0139*   @not_collision:
041FA4 3D          0140*       dec a                       ; Set a to -1
041FA5 C9          0141*       ret                         ; Return with carry set
041FA6             0142*   ; End check_collision_box
041FA6             0143*   
041FA6             0144*   
041FA6             0145*   ; this routine detects collisions between two collidable objects,
041FA6             0146*   ; which can include sprites, active tiles, or any screen coordinate
041FA6             0147*   ; which has been set up with a sprite table structure that includes dim_x
041FA6             0148*   ; representing the radius of the collidable object
041FA6             0149*   ; inputs: ix and iy point to the colliding objects' sprite/tile table records
041FA6             0150*   ; outputs: uh.l = distance - sum of radii
041FA6             0151*   ;          zero flag set if collision detected
041FA6             0152*   ;          dx168 and dy168 are also populated with the signed displacements
041FA6             0153*   ; destroys: everything except indexes
041FA6             0154*   ; check_collision:
041FA6             0155*   check_collision_cartesian:
041FA6             0156*   ; compute dx = x1-x0
041FA6 DD 27 01    0157*       ld hl,(ix+sprite_x)
041FA9 FD 17 01    0158*       ld de,(iy+sprite_x)
041FAC AF          0159*       xor a ; clear carry
041FAD ED 52       0160*       sbc hl,de
041FAF 22 7E 07 04 0161*       ld (dx168),hl ; dx to scratch
041FB3             0162*   ; compute dy = y1-y0
041FB3 DD 27 04    0163*       ld hl,(ix+sprite_y)
041FB6 FD 17 04    0164*       ld de,(iy+sprite_y)
041FB9 AF          0165*       xor a ; clear carry
041FBA ED 52       0166*       sbc hl,de ; hl = dy
041FBC 22 84 07 04 0167*       ld (dy168),hl ; dy to scratch
041FC0             0168*   ; compute euclidean distance between centers
041FC0 CD 8A 07 04 0169*       call distance168 ; uh.l = distance
041FC4             0170*   ; check for overlap by summing half the radii
041FC4 DD 7E 1E    0171*       ld a,(ix+sprite_dim_x)
041FC7 CB 3F       0172*       srl a ; divide by 2
041FC9 FD 5E 1E    0173*       ld e,(iy+sprite_dim_x)
041FCC CB 3B       0174*       srl e ; divide by 2
041FCE 83          0175*       add a,e
041FCF 11 00 00 00 0176*       ld de,0 ; clear deu and e
041FD3 57          0177*       ld d,a ; ud.e = sum of radii
041FD4 B7          0178*       or a ; clear carry
041FD5 ED 52       0179*       sbc hl,de ; uh.l = distance - sum of radii
041FD7 C8          0180*       ret z ; return collision
041FD8 F0          0181*       ret p ; return no collision
041FD9 AF          0182*       xor a ; return collision
041FDA C9          0183*       ret
041FDB             0184*   ; end check_collision_cartesian
041FDB             0185*   
041FDB             0186*   ; check collisions of a sprite or tile against a sprite group
041FDB             0187*   ; inputs: iy = pointer to sprite or tile record being checked
041FDB             0188*   ;         ix = pointer to sprite group, b = number of records in sprite group
041FDB             0189*   check_sprite_group_collisions:
041FDB             0190*   @collision_loop:
041FDB DD 22 A8 1E 0191*       ld (collision_table_pointer),ix ; update table pointer
       04          
041FE0 C5          0192*       push bc ; backup loop counter
041FE1             0193*   ; check sprite_collisions sprite_alive flag to see if sprite is active
041FE1 DD CB 1D 76 0194*       bit sprite_alive,(ix+sprite_collisions)
041FE5 CA FB 1F 04 0195*       jp z,@next_record ; not alive so skip to next record
041FE9             0196*   ; sprite alive so check for collision
041FE9 CD 26 1F 04 0197*       call check_collision
041FED C2 FB 1F 04 0198*       jp nz,@next_record ; no collision
041FF1             0199*   ; set sprite_just_died flag for each entity and return to caller
041FF1 C1          0200*       pop bc ; dummy pop to balance stack
041FF2 DD CB 1D FE 0201*       set sprite_just_died,(ix+sprite_collisions)
041FF6 FD CB 1D FE 0202*       set sprite_just_died,(iy+sprite_collisions)
041FFA C9          0203*       ret
041FFB             0204*   @next_record:
041FFB C1          0205*       pop bc ; get back our loop counter
041FFC ED 32 40    0206*       lea ix,ix+table_record_size
041FFF 10 DA       0207*       djnz @collision_loop ; loop until we've checked all the records
042001             0208*   ; return to caller
042001 AF          0209*       xor a
042002 3C          0210*       inc a ; resets sign flag and a to non-zero indicating no collision
042003 C9          0211*       ret
042004             0212*   ; end check_sprite_group_collisions
042004             0213*   
042004             0214*   check_enemy_collision_laser: ; check for collisions with laser
042004 DD 21 60 9B 0215*       ld ix,player_lasers_begin
       04          
042009 06 04       0216*       ld b,player_lasers_max
04200B CD DB 1F 04 0217*       call check_sprite_group_collisions
04200F C9          0218*       ret
042010             0219*   ; end check_enemy_collision_laser
042010             0220*   
