0468BE 06 11       0152*       ld b,17 ; y
0468C0 CD 2D 13 04 0153*       call vdu_move_cursor
0468C4 CD 5C 00 04 0154*       call printInline
0468C8 53 74 61 72 0155*       asciz "Starting In..."
       74 69 6E 67 
       20 49 6E 2E 
