04A24C AD 4A 04    0570*       dl enemies_alive
04A24F 01          0571*       db STATE_TELEMETRY_ENEMY_ACTIVE
04A250 B9 4A 04    0572*       dl enemies_despawning
04A253 02          0573*       db STATE_TELEMETRY_ENEMY_DESPAWNING
04A254 BA 4A 04    0574*       dl enemies_dead
04A257 03          0575*       db STATE_TELEMETRY_ENEMY_DEAD
04A258 BB 4A 04    0576*       dl enemies_respawning
04A25B 04          0577*       db STATE_TELEMETRY_ENEMY_RESPAWNING
04A25C             0578*   telemetry_enemies_state_map_end:
