041942             0043        include "vdu_plot.inc"
041942             0001*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
041942             0002*   ; PLOT code 	(Decimal) 	Effect
041942             0003*   ; &00-&07 	0-7 	Solid line, includes both ends
041942             0004*   plot_sl_both: equ 0x00
041942             0005*   
041942             0006*   ; &08-&0F 	8-15 	Solid line, final point omitted
041942             0007*   plot_sl_first: equ 0x08
041942             0008*   
041942             0009*   ; &10-&17 	16-23 	Not supported (Dot-dash line, includes both ends, pattern restarted)
041942             0010*   ; &18-&1F 	24-31 	Not supported (Dot-dash line, first point omitted, pattern restarted)
041942             0011*   
041942             0012*   ; &20-&27 	32-39 	Solid line, first point omitted
041942             0013*   plot_sl_last: equ 0x20
041942             0014*   
041942             0015*   ; &28-&2F 	40-47 	Solid line, both points omitted
041942             0016*   plot_sl_none: equ 0x28
041942             0017*   
041942             0018*   ; &30-&37 	48-55 	Not supported (Dot-dash line, first point omitted, pattern continued)
041942             0019*   ; &38-&3F 	56-63 	Not supported (Dot-dash line, both points omitted, pattern continued)
041942             0020*   
041942             0021*   ; &40-&47 	64-71 	Point plot
041942             0022*   plot_pt: equ 0x40
041942             0023*   
041942             0024*   ; &48-&4F 	72-79 	Line fill left and right to non-background §§
041942             0025*   plot_lf_lr_non_bg: equ 0x48
041942             0026*   
041942             0027*   ; &50-&57 	80-87 	Triangle fill
041942             0028*   plot_tf: equ 0x50
041942             0029*   
041942             0030*   ; &58-&5F 	88-95 	Line fill right to background §§
041942             0031*   plot_lf_r_bg: equ 0x58
041942             0032*   
041942             0033*   ; &60-&67 	96-103 	Rectangle fill
041942             0034*   plot_rf: equ 0x60
041942             0035*   
041942             0036*   ; &68-&6F 	104-111 	Line fill left and right to foreground §§
041942             0037*   plot_lf_lr_fg: equ 0x60
041942             0038*   
041942             0039*   ; &70-&77 	112-119 	Parallelogram fill
041942             0040*   plot_pf: equ 0x70
041942             0041*   
041942             0042*   ; &78-&7F 	120-127 	Line fill right to non-foreground §§
041942             0043*   plot_lf_r_non_fg: equ 0x78
041942             0044*   
041942             0045*   ; &80-&87 	128-135 	Not supported (Flood until non-background)
041942             0046*   ; &88-&8F 	136-143 	Not supported (Flood until foreground)
041942             0047*   
041942             0048*   ; &90-&97 	144-151 	Circle outline
041942             0049*   plot_co: equ 0x90
041942             0050*   
041942             0051*   ; &98-&9F 	152-159 	Circle fill
041942             0052*   plot_cf: equ 0x98
041942             0053*   
041942             0054*   ; &A0-&A7 	160-167 	Not supported (Circular arc)
041942             0055*   ; &A8-&AF 	168-175 	Not supported (Circular segment)
041942             0056*   ; &B0-&B7 	176-183 	Not supported (Circular sector)
041942             0057*   
041942             0058*   ; &B8-&BF 	184-191 	Rectangle copy/move
041942             0059*   plot_rcm: equ 0xB8
041942             0060*   
041942             0061*   ; &C0-&C7 	192-199 	Not supported (Ellipse outline)
041942             0062*   ; &C8-&CF 	200-207 	Not supported (Ellipse fill)
041942             0063*   ; &D0-&D7 	208-215 	Not defined
041942             0064*   ; &D8-&DF 	216-223 	Not defined
041942             0065*   ; &E0-&E7 	224-231 	Not defined
041942             0066*   
041942             0067*   ; &E8-&EF 	232-239 	Bitmap plot §
041942             0068*   plot_bmp: equ 0xE8
041942             0069*   
041942             0070*   ; &F0-&F7 	240-247 	Not defined
041942             0071*   ; &F8-&FF 	248-255 	Not defined
041942             0072*   
041942             0073*   ; § Support added in Agon Console8 VDP 2.1.0 §§ Support added in
041942             0074*   ; Agon Console8 VDP 2.2.0
041942             0075*   
041942             0076*   ; Within each group of eight plot codes, the effects are as follows:
041942             0077*   ; Plot code 	Effect
041942             0078*   ; 0 	Move relative
041942             0079*   mv_rel: equ 0
041942             0080*   
041942             0081*   ; 1 	Plot relative in current foreground colour
041942             0082*   dr_rel_fg: equ 1
041942             0083*   
041942             0084*   ; 2 	Not supported (Plot relative in logical inverse colour)
041942             0085*   ; 3 	Plot relative in current background colour
041942             0086*   dr_rel_bg: equ 3
041942             0087*   
041942             0088*   ; 4 	Move absolute
041942             0089*   mv_abs: equ 4
041942             0090*   
041942             0091*   ; 5 	Plot absolute in current foreground colour
041942             0092*   dr_abs_fg: equ 5
041942             0093*   
041942             0094*   ; 6 	Not supported (Plot absolute in logical inverse colour)
041942             0095*   ; 7 	Plot absolute in current background colour
041942             0096*   dr_abs_bg: equ 7
041942             0097*   
041942             0098*   ; Codes 0-3 use the position data provided as part of the command
041942             0099*   ; as a relative position, adding the position given to the current
041942             0100*   ; graphical cursor position. Codes 4-7 use the position data provided
041942             0101*   ; as part of the command as an absolute position, setting the current
041942             0102*   ; graphical cursor position to the position given.
041942             0103*   
041942             0104*   ; Codes 2 and 6 on Acorn systems plot using a logical inverse of the
041942             0105*   ; current pixel colour. These operations cannot currently be supported
041942             0106*   ; by the graphics system the Agon VDP uses, so these codes are not
041942             0107*   ; supported. Support for these codes may be added in a future version
041942             0108*   ; of the VDP firmware.
041942             0109*   
041942             0110*   ; 16 colour palette constants
041942             0111*   c_black: equ 0
041942             0112*   c_red_dk: equ 1
041942             0113*   c_green_dk: equ 2
041942             0114*   c_yellow_dk: equ 3
041942             0115*   c_blue_dk: equ 4
041942             0116*   c_magenta_dk: equ 5
041942             0117*   c_cyan_dk: equ 6
041942             0118*   c_grey: equ 7
041942             0119*   c_grey_dk: equ 8
041942             0120*   c_red: equ 9
041942             0121*   c_green: equ 10
041942             0122*   c_yellow: equ 11
041942             0123*   c_blue: equ 12
041942             0124*   c_magenta: equ 13
041942             0125*   c_cyan: equ 14
041942             0126*   c_white: equ 15
041942             0127*   
041942             0128*   ; VDU 25, mode, x; y;: PLOT command
041942             0129*   ; inputs: a=mode, bc=x0, de=y0
041942             0130*   vdu_plot:
041942 32 5C 19 04 0131*       ld (@mode),a
041946 ED 43 5D 19 0132*       ld (@x0),bc
       04          
04194B ED 53 5F 19 0133*       ld (@y0),de
       04          
041950 21 5B 19 04 0134*   	ld hl,@cmd
041954 01 06 00 00 0135*   	ld bc,@end-@cmd
041958 5B DF       0136*   	rst.lil $18
04195A C9          0137*   	ret
04195B 19          0138*   @cmd:   db 25
04195C 00          0139*   @mode:  db 0
04195D 00 00       0140*   @x0: 	dw 0
04195F 00 00       0141*   @y0: 	dw 0
041961 00          0142*   @end:   db 0 ; extra byte to soak up deu
041962             0143*   
041962             0144*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
041962             0145*   ; &E8-&EF 	232-239 	Bitmap plot §
041962             0146*   ; VDU 25, mode, x; y;: PLOT command
041962             0147*   ; inputs: bc=x0, de=y0
041962             0148*   ; prerequisites: vdu_buff_select
041962             0149*   vdu_plot_bmp:
041962 ED 43 79 19 0150*       ld (@x0),bc
       04          
041967 ED 53 7B 19 0151*       ld (@y0),de
       04          
04196C 21 77 19 04 0152*   	ld hl,@cmd
041970 01 06 00 00 0153*   	ld bc,@end-@cmd
041974 5B DF       0154*   	rst.lil $18
041976 C9          0155*   	ret
041977 19          0156*   @cmd:   db 25
041978 ED          0157*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
041979 00 00       0158*   @x0: 	dw 0x0000
04197B 00 00       0159*   @y0: 	dw 0x0000
04197D 00          0160*   @end:   db 0x00 ; padding
04197E             0161*   
04197E             0162*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
04197E             0163*   ; &E8-&EF 	232-239 	Bitmap plot §
04197E             0164*   ; VDU 25, mode, x; y;: PLOT command
04197E             0165*   ; inputs: bc=x0, de=y0
04197E             0166*   ; USING 16.8 FIXED POINT COORDINATES
04197E             0167*   ; inputs: ub.c is x coordinate, ud.e is y coordinate
04197E             0168*   ;   the fractional portiion of the inputs are truncated
04197E             0169*   ;   leaving only the 16-bit integer portion
04197E             0170*   ; prerequisites: vdu_buff_select
04197E             0171*   vdu_plot_bmp168:
04197E             0172*   ; populate in the reverse of normal to keep the
04197E             0173*   ; inputs from stomping on each other
04197E ED 53 9C 19 0174*       ld (@y0-1),de
       04          
041983 ED 43 9A 19 0175*       ld (@x0-1),bc
       04          
041988 3E ED       0176*       ld a,plot_bmp+dr_abs_fg ; 0xED
04198A 32 9A 19 04 0177*       ld (@mode),a ; restore the mode byte that got stomped on by bcu
04198E 21 99 19 04 0178*   	ld hl,@cmd
041992 01 06 00 00 0179*   	ld bc,@end-@cmd
041996 5B DF       0180*   	rst.lil $18
041998 C9          0181*   	ret
041999 19          0182*   @cmd:   db 25
04199A ED          0183*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
04199B 00 00       0184*   @x0: 	dw 0x0000
04199D 00 00       0185*   @y0: 	dw 0x0000
04199F             0186*   @end:  ; no padding required b/c we shifted de right
04199F             0187*   
04199F             0188*   ; draw a filled rectangle
04199F             0189*   vdu_plot_rf:
04199F ED 43 C6 19 0190*       ld (@x0),bc
       04          
0419A4 ED 53 C8 19 0191*       ld (@y0),de
       04          
0419A9 DD 22 CC 19 0192*       ld (@x1),ix
       04          
0419AE FD 22 CE 19 0193*       ld (@y1),iy
       04          
0419B3 3E 19       0194*       ld a,25 ; we have to reload the 2nd plot command
0419B5 32 CA 19 04 0195*       ld (@cmd1),a ; because the 24-bit y0 load stomped on it
0419B9 21 C4 19 04 0196*   	ld hl,@cmd0
0419BD 01 0C 00 00 0197*   	ld bc,@end-@cmd0
0419C1 5B DF       0198*   	rst.lil $18
0419C3 C9          0199*       ret
0419C4 19          0200*   @cmd0:  db 25 ; plot
0419C5 04          0201*   @arg0:  db plot_sl_both+mv_abs
0419C6 00 00       0202*   @x0:    dw 0x0000
0419C8 00 00       0203*   @y0:    dw 0x0000
0419CA 19          0204*   @cmd1:  db 25 ; plot
0419CB 65          0205*   @arg1:  db plot_rf+dr_abs_fg
0419CC 00 00       0206*   @x1:    dw 0x0000
0419CE 00 00       0207*   @y1:    dw 0x0000
0419D0 00          0208*   @end:   db 0x00 ; padding
0419D1             0209*   
0419D1             0210*   ; draw a filled circle
0419D1             0211*   vdu_plot_cf:
0419D1 ED 43 F8 19 0212*       ld (@x0),bc
       04          
0419D6 ED 53 FA 19 0213*       ld (@y0),de
       04          
0419DB DD 22 FE 19 0214*       ld (@x1),ix
       04          
0419E0 FD 22 00 1A 0215*       ld (@y1),iy
       04          
0419E5 3E 19       0216*       ld a,25 ; we have to reload the 2nd plot command
0419E7 32 FC 19 04 0217*       ld (@cmd1),a ; because the 24-bit y0 load stomped on it
0419EB 21 F6 19 04 0218*   	ld hl,@cmd0
0419EF 01 0C 00 00 0219*   	ld bc,@end-@cmd0
0419F3 5B DF       0220*   	rst.lil $18
0419F5 C9          0221*       ret
0419F6 19          0222*   @cmd0:  db 25 ; plot
0419F7 04          0223*   @arg0:  db plot_sl_both+mv_abs
0419F8 00 00       0224*   @x0:    dw 0x0000
0419FA 00 00       0225*   @y0:    dw 0x0000
0419FC 19          0226*   @cmd1:  db 25 ; plot
0419FD 9D          0227*   @arg1:  db plot_cf+dr_abs_fg
0419FE 00 00       0228*   @x1:    dw 0x0000
041A00 00 00       0229*   @y1:    dw 0x0000
041A02 00          0230*   @end:   db 0x00 ; padding
041A03             0044        include "vdu_sprites.inc"
041A03             0001*   ; ; https://github.com/AgonConsole8/agon-docs/blob/main/VDP---Bitmaps-API.md
041A03             0002*   ; the VDP can support up to 256 sprites. They must be defined
041A03             0003*   ; contiguously, and so the first sprite is sprite 0.
041A03             0004*   ; (In contrast, bitmaps can have any ID from 0 to 65534.)
041A03             0005*   ; Once a selection of sprites have been defined, you can activate
041A03             0006*   ; them using the VDU 23, 27, 7, n command, where n is the number
041A03             0007*   ; of sprites to activate. This will activate the first n sprites,
041A03             0008*   ; starting with sprite 0. All sprites from 0 to n-1 must be defined.
041A03             0009*   
041A03             0010*   ; A single sprite can have multiple "frames", referring to
041A03             0011*   ; different bitmaps.
041A03             0012*   ; (These bitmaps do not need to be the same size.)
041A03             0013*   ; This allows a sprite to include an animation sequence,
041A03             0014*   ; which can be stepped through one frame at a time, or picked
041A03             0015*   ; in any order.
041A03             0016*   
041A03             0017*   ; Any format of bitmap can be used as a sprite frame. It should
041A03             0018*   ; be noted however that "native" format bitmaps are not
041A03             0019*   ; recommended for use as sprite frames, as they cannot get
041A03             0020*   ; erased from the screen. (As noted above, the "native" bitmap
041A03             0021*   ; format is not really intended for general use.) This is part
041A03             0022*   ; of why from Agon Console8 VDP 2.6.0 bitmaps captured from the
041A03             0023*   ; screen are now stored in RGBA2222 format.
041A03             0024*   
041A03             0025*   ; An "active" sprite can be hidden, so it will stop being drawn,
041A03             0026*   ; and then later shown again.
041A03             0027*   
041A03             0028*   ; Moving sprites around the screen is done by changing the
041A03             0029*   ; position of the sprite. This can be done either by setting
041A03             0030*   ; the absolute position of the sprite, or by moving the sprite
041A03             0031*   ; by a given number of pixels. (Sprites are positioned using
041A03             0032*   ; pixel coordinates, and not by the logical OS coordinate system.)
041A03             0033*   ; In the current sprite system, sprites will not update their
041A03             0034*   ; position on-screen until either another drawing operation is
041A03             0035*   ; performed or an explicit VDU 23, 27, 15 command is performed.
041A03             0036*   
041A03             0037*   ; VDU 23, 27, 4, n: Select sprite n
041A03             0038*   ; inputs: a is the 8-bit sprite id
041A03             0039*   vdu_sprite_select:
041A03 32 15 1A 04 0040*       ld (@sprite),a
041A07 21 12 1A 04 0041*       ld hl,@cmd
041A0B 01 04 00 00 0042*       ld bc,@end-@cmd
041A0F 5B DF       0043*       rst.lil $18
041A11 C9          0044*       ret
041A12 17 1B 04    0045*   @cmd:    db 23,27,4
041A15 00          0046*   @sprite: db 0x00
041A16             0047*   @end:
041A16             0048*   
041A16             0049*   ; VDU 23, 27, 5: Clear frames in current sprite
041A16             0050*   ; inputs: none
041A16             0051*   ; prerequisites: vdu_sprite_select
041A16             0052*   vdu_sprite_clear_frames:
041A16 21 21 1A 04 0053*       ld hl,@cmd
041A1A 01 03 00 00 0054*       ld bc,@end-@cmd
041A1E 5B DF       0055*       rst.lil $18
041A20 C9          0056*       ret
041A21 17 1B 05    0057*   @cmd: db 23,27,5
041A24             0058*   @end:
041A24             0059*   
041A24             0060*   ; VDU 23, 27, 6, n: Add bitmap n as a frame to current sprite (where bitmap's buffer ID is 64000+n)
041A24             0061*   ; inputs: a is the 8-bit bitmap number
041A24             0062*   ; prerequisites: vdu_sprite_select
041A24             0063*   vdu_sprite_add_bmp:
041A24 32 36 1A 04 0064*       ld (@bmp),a
041A28 21 33 1A 04 0065*       ld hl,@cmd
041A2C 01 04 00 00 0066*       ld bc,@end-@cmd
041A30 5B DF       0067*       rst.lil $18
041A32 C9          0068*       ret
041A33 17 1B 06    0069*   @cmd: db 23,27,6
041A36 00          0070*   @bmp: db 0x00
041A37             0071*   @end:
041A37             0072*   
041A37             0073*   ; VDU 23, 27, 7, n: Activate n sprites
041A37             0074*   ; inputs: a is the number of sprites to activate
041A37             0075*   ; prerequisites: each sprite activated must have at least one frame attached to it
041A37             0076*   vdu_sprite_activate:
041A37 32 49 1A 04 0077*       ld (@num),a
041A3B 21 46 1A 04 0078*       ld hl,@cmd
041A3F 01 04 00 00 0079*       ld bc,@end-@cmd
041A43 5B DF       0080*       rst.lil $18
041A45 C9          0081*       ret
041A46 17 1B 07    0082*   @cmd: db 23,27,7
041A49 00          0083*   @num: db 0x00
041A4A             0084*   @end:
041A4A             0085*   
041A4A             0086*   ; VDU 23, 27, 8: Select next frame of current sprite
041A4A             0087*   ; inputs: none
041A4A             0088*   ; prerequisites: vdu_sprite_select
041A4A             0089*   vdu_sprite_next_frame:
041A4A 21 55 1A 04 0090*       ld hl,@cmd
041A4E 01 03 00 00 0091*       ld bc,@end-@cmd
041A52 5B DF       0092*       rst.lil $18
041A54 C9          0093*       ret
041A55 17 1B 08    0094*   @cmd: db 23,27,8
041A58             0095*   @end:
041A58             0096*   
041A58             0097*   ; VDU 23, 27, 9: Select previous frame of current sprite
041A58             0098*   ; inputs: none
041A58             0099*   ; prerequisites: vdu_sprite_select
041A58             0100*   vdu_sprite_prev_frame:
041A58 21 63 1A 04 0101*       ld hl,@cmd
041A5C 01 03 00 00 0102*       ld bc,@end-@cmd
041A60 5B DF       0103*       rst.lil $18
041A62 C9          0104*       ret
041A63 17 1B 09    0105*   @cmd: db 23,27,9
041A66             0106*   @end:
041A66             0107*   
041A66             0108*   ; VDU 23, 27, 10, n: Select the nth frame of current sprite
041A66             0109*   ; inputs: a is frame number to select
041A66             0110*   ; prerequisites: vdu_sprite_select
041A66             0111*   vdu_sprite_select_frame:
041A66 32 78 1A 04 0112*       ld (@frame),a
041A6A 21 75 1A 04 0113*       ld hl,@cmd
041A6E 01 04 00 00 0114*       ld bc,@end-@cmd
041A72 5B DF       0115*       rst.lil $18
041A74 C9          0116*       ret
041A75 17 1B 0A    0117*   @cmd:    db 23,27,10
041A78 00          0118*   @frame:  db 0x00
041A79             0119*   @end:
041A79             0120*   
041A79             0121*   ; VDU 23, 27, 11: Show current sprite
041A79             0122*   ; inputs: none
041A79             0123*   ; prerequisites: vdu_sprite_select
041A79             0124*   vdu_sprite_show:
041A79 21 84 1A 04 0125*       ld hl,@cmd
041A7D 01 03 00 00 0126*       ld bc,@end-@cmd
041A81 5B DF       0127*       rst.lil $18
041A83 C9          0128*       ret
041A84 17 1B 0B    0129*   @cmd: db 23,27,11
041A87             0130*   @end:
041A87             0131*   
041A87             0132*   ; VDU 23, 27, 12: Hide current sprite
041A87             0133*   ; inputs: none
041A87             0134*   ; prerequisites: vdu_sprite_select
041A87             0135*   vdu_sprite_hide:
041A87 21 92 1A 04 0136*       ld hl,@cmd
041A8B 01 03 00 00 0137*       ld bc,@end-@cmd
041A8F 5B DF       0138*       rst.lil $18
041A91 C9          0139*       ret
041A92 17 1B 0C    0140*   @cmd: db 23,27,12
041A95             0141*   @end:
041A95             0142*   
041A95             0143*   ; VDU 23, 27, 13, x; y;: Move current sprite to pixel position x, y
041A95             0144*   ; inputs: bc is x coordinate, de is y coordinate
041A95             0145*   ; prerequisites: vdu_sprite_select
041A95             0146*   vdu_sprite_move_abs:
041A95 ED 43 AD 1A 0147*       ld (@xpos),bc
       04          
041A9A ED 53 AF 1A 0148*       ld (@ypos),de
       04          
041A9F 21 AA 1A 04 0149*       ld hl,@cmd
041AA3 01 07 00 00 0150*       ld bc,@end-@cmd
041AA7 5B DF       0151*       rst.lil $18
041AA9 C9          0152*       ret
041AAA 17 1B 0D    0153*   @cmd:  db 23,27,13
041AAD 00 00       0154*   @xpos: dw 0x0000
041AAF 00 00       0155*   @ypos: dw 0x0000
041AB1 00          0156*   @end:  db 0x00 ; padding
041AB2             0157*   
041AB2             0158*   ; VDU 23, 27, 14, x; y;: Move current sprite by x, y pixels
041AB2             0159*   ; inputs: bc is x coordinate, de is y coordinate
041AB2             0160*   ; prerequisites: vdu_sprite_select
041AB2             0161*   vdu_sprite_move_rel:
041AB2 ED 43 CA 1A 0162*       ld (@dx),bc
       04          
041AB7 ED 53 CC 1A 0163*       ld (@dy),de
       04          
041ABC 21 C7 1A 04 0164*       ld hl,@cmd
041AC0 01 07 00 00 0165*       ld bc,@end-@cmd
041AC4 5B DF       0166*       rst.lil $18
041AC6 C9          0167*       ret
041AC7 17 1B 0E    0168*   @cmd: db 23,27,14
041ACA 00 00       0169*   @dx:  dw 0x0000
041ACC 00 00       0170*   @dy:  dw 0x0000
041ACE 00          0171*   @end: db 0x00 ; padding
041ACF             0172*   
041ACF             0173*   ; VDU 23, 27, 13, x; y;: Move current sprite to pixel position x, y
041ACF             0174*   ; USING 16.8 FIXED POINT COORDINATES
041ACF             0175*   ; inputs: ub.c is x coordinate, ud.e is y coordinate
041ACF             0176*   ;   the fractional portiion of the inputs are truncated
041ACF             0177*   ;   leaving only the 16-bit integer portion
041ACF             0178*   ; prerequisites: vdu_sprite_select
041ACF             0179*   vdu_sprite_move_abs168:
041ACF             0180*   ; offset inputs by the gfx origin
041ACF             0181*   ; y coordinate
041ACF 21 00 30 00 0182*       ld hl,origin_top*256
041AD3 19          0183*       add hl,de
041AD4 22 F6 1A 04 0184*       ld (@ypos-1),hl
041AD8             0185*   ; x coordinate
041AD8 21 00 80 00 0186*       ld hl,origin_left*256
041ADC 09          0187*       add hl,bc
041ADD 22 F4 1A 04 0188*       ld (@xpos-1),hl
041AE1             0189*   ; prepare vdu command
041AE1 3E 0D       0190*       ld a,13       ; restore the final byte of the command
041AE3 32 F4 1A 04 0191*       ld (@cmd+2),a ; string that got stomped on by bcu
041AE7 21 F2 1A 04 0192*       ld hl,@cmd
041AEB 01 07 00 00 0193*       ld bc,@end-@cmd
041AEF 5B DF       0194*       rst.lil $18
041AF1 C9          0195*       ret
041AF2 17 1B 0D    0196*   @cmd:  db 23,27,13
041AF5 00 00       0197*   @xpos: dw 0x0000
041AF7 00 00       0198*   @ypos: dw 0x0000
041AF9             0199*   @end:  ; no padding required b/c we shifted de right
041AF9             0200*   
041AF9             0201*   ; VDU 23, 27, 14, x; y;: Move current sprite by x, y pixels
041AF9             0202*   ; USING 16.8 FIXED POINT COORDINATES
041AF9             0203*   ; inputs: ub.c is dx, ud.e is dy
041AF9             0204*   ;   the fractional portiion of the inputs are truncated
041AF9             0205*   ;   leaving only the 16-bit integer portion
041AF9             0206*   ; prerequisites: vdu_sprite_select
041AF9             0207*   vdu_sprite_move_rel168:
041AF9             0208*   ; populate in the reverse of normal to keep the
041AF9             0209*   ; inputs from stomping on each other
041AF9 ED 53 18 1B 0210*       ld (@dy-1),de
       04          
041AFE ED 43 16 1B 0211*       ld (@dx-1),bc
       04          
041B03 3E 0E       0212*       ld a,14       ; restore the final byte of the command
041B05 32 16 1B 04 0213*       ld (@cmd+2),a ; string that got stomped on by bcu
041B09 21 14 1B 04 0214*       ld hl,@cmd
041B0D 01 07 00 00 0215*       ld bc,@end-@cmd
041B11 5B DF       0216*       rst.lil $18
041B13 C9          0217*       ret
041B14 17 1B 0E    0218*   @cmd:  db 23,27,14
041B17 00 00       0219*   @dx: dw 0x0000
041B19 00 00       0220*   @dy: dw 0x0000
041B1B             0221*   @end:  ; no padding required b/c we shifted de right
041B1B             0222*   
041B1B             0223*   ; VDU 23, 27, 15: Update the sprites in the GPU
041B1B             0224*   ; inputs: none
041B1B             0225*   vdu_sprite_update:
041B1B 21 26 1B 04 0226*       ld hl,@cmd
041B1F 01 03 00 00 0227*       ld bc,@end-@cmd
041B23 5B DF       0228*       rst.lil $18
041B25 C9          0229*       ret
041B26 17 1B 0F    0230*   @cmd: db 23,27,15
041B29             0231*   @end:
041B29             0232*   
041B29             0233*   ; VDU 23, 27, 16: Reset bitmaps and sprites and clear all data
041B29             0234*   ; inputs: none
041B29             0235*   vdu_sprite_bmp_reset:
041B29 21 34 1B 04 0236*       ld hl,@cmd
041B2D 01 03 00 00 0237*       ld bc,@end-@cmd
041B31 5B DF       0238*       rst.lil $18
041B33 C9          0239*       ret
041B34 17 1B 10    0240*   @cmd: db 23,27,16
041B37             0241*   @end:
041B37             0242*   
041B37             0243*   ; VDU 23, 27, 17: Reset sprites (only) and clear all data
041B37             0244*   ; inputs: none
041B37             0245*   vdu_sprite_reset:
041B37 21 42 1B 04 0246*       ld hl,@cmd
041B3B 01 03 00 00 0247*       ld bc,@end-@cmd
041B3F 5B DF       0248*       rst.lil $18
041B41 C9          0249*       ret
041B42 17 1B 11    0250*   @cmd: db 23,27,17
041B45             0251*   @end:
041B45             0252*   
041B45             0253*   ; VDU 23, 27, 18, n: Set the current sprite GCOL paint mode to n **
041B45             0254*   ; inputs: a is the GCOL paint mode
041B45             0255*   ; prerequisites: vdu_sprite_select
041B45             0256*   vdu_sprite_set_gcol:
041B45 32 57 1B 04 0257*       ld (@mode),a
041B49 21 54 1B 04 0258*       ld hl,@cmd
041B4D 01 04 00 00 0259*       ld bc,@end-@cmd
041B51 5B DF       0260*       rst.lil $18
041B53 C9          0261*       ret
041B54 17 1B 12    0262*   @cmd:  db 23,27,18
041B57 00          0263*   @mode: db 0x00
041B58             0264*   @end:
041B58             0265*   
041B58             0266*   ; VDU 23, 27, &26, n;: Add bitmap n as a frame to current sprite using a 16-bit buffer ID
041B58             0267*   ; inputs: hl=bufferId
041B58             0268*   ; prerequisites: vdu_sprite_select
041B58             0269*   vdu_sprite_add_buff:
041B58 22 6A 1B 04 0270*       ld (@bufferId),hl
041B5C 21 67 1B 04 0271*       ld hl,@cmd
041B60 01 05 00 00 0272*       ld bc,@end-@cmd
041B64 5B DF       0273*       rst.lil $18
041B66 C9          0274*       ret
041B67 17 1B 26    0275*   @cmd:      db 23,27,0x26
041B6A 00 00       0276*   @bufferId: dw 0x0000
041B6C 00          0277*   @end:      db 0x00 ; padding
041B6D             0045        include "agnb_api.inc"
041B6D             0001*   ; Canonical AGNB image/audio loader API
041B6D             0002*   ; =====================================
041B6D             0003*   ;
041B6D             0004*   ; Public entry points:
041B6D             0005*   ;   agnb_load_images: DE -> zero-terminated AGNB 0.1 image filename
041B6D             0006*   ;   agnb_load_images_with_callback:
041B6D             0007*   ;                     DE -> filename, HL -> completed-image callback
041B6D             0008*   ;   agnb_load_audio:  DE -> zero-terminated AGNB 0.2 audio filename
041B6D             0009*   ;   agnb_load_audio_with_callback:
041B6D             0010*   ;                     DE -> filename, HL -> completed-audio callback
041B6D             0011*   ;
041B6D             0012*   ; Applications own plotting, playback, input, timing, and debug behavior.
041B6D             0013*   ; External dependencies and reference implementations are documented in
041B6D             0014*   ; README.md and agnb_dependencies.inc.
041B6D             0015*   ;
041B6D             0016*   ; AGNB 0.1 image-container layout
041B6D             0017*   ; ===============================
041B6D             0018*   ;
041B6D             0019*   ; AGNB is a RIFF container. All integer fields are unsigned little-endian.
041B6D             0020*   ; Every chunk begins with a four-byte ID and a u32 payload size. The payload
041B6D             0021*   ; follows immediately and is padded with zero bytes to a four-byte boundary.
041B6D             0022*   ; The stored chunk size excludes its eight-byte header and alignment padding.
041B6D             0023*   ;
041B6D             0024*   ;     RIFF  u32(file size - 8)  AGNB
041B6D             0025*   ;       VERS  size=2
041B6D             0026*   ;         u8 major=0
041B6D             0027*   ;         u8 minor=1
041B6D             0028*   ;       LIST  type=BUFR
041B6D             0029*   ;         BHDR  size=2
041B6D             0030*   ;           u16 bufferId
041B6D             0031*   ;         IMAG  size=5
041B6D             0032*   ;           u16 width
041B6D             0033*   ;           u16 height
041B6D             0034*   ;           u8  format=1        ; RGBA2222
041B6D             0035*   ;         DATA  size=width*height
041B6D             0036*   ;           u8 pixels[]         ; row-major, no row padding
041B6D             0037*   ;
041B6D             0038*   ; VERS occurs once before the LIST records. Each version 0.1 LIST BUFR record
041B6D             0039*   ; contains exactly BHDR, IMAG, and DATA in that order. The LIST payload starts
041B6D             0040*   ; with its four-byte BUFR type, followed by those nested chunks. Readers must
041B6D             0041*   ; validate the enclosing RIFF/LIST bounds and the BHDR/IMAG metadata before
041B6D             0042*   ; reading or uploading DATA. Chunk traversal advances by:
041B6D             0043*   ;
041B6D             0044*   ;     8 + ((payload_size + 3) & ~3)
041B6D             0045*   ;
041B6D             0046*   ; The offsets below are indices from the beginning of the named header or
041B6D             0047*   ; payload. RIFF and chunk sizes are u32 values even though ADL registers are
041B6D             0048*   ; 24-bit, so their high byte must not be silently discarded during validation.
041B6D             0049*   
041B6D             0050*   ; RIFF file header: "RIFF", u32 size, "AGNB"
041B6D             0051*   agnb_riff_id:              equ 0
041B6D             0052*   agnb_riff_size:            equ 4
041B6D             0053*   agnb_riff_form:            equ 8
041B6D             0054*   agnb_riff_header_size:     equ 12
041B6D             0055*   
041B6D             0056*   ; Generic RIFF chunk header: FourCC ID, u32 payload size
041B6D             0057*   agnb_chunk_id:             equ 0
041B6D             0058*   agnb_chunk_size:           equ 4
041B6D             0059*   agnb_chunk_data:           equ 8
041B6D             0060*   agnb_chunk_header_size:    equ 8
041B6D             0061*   
041B6D             0062*   ; VERS payload
041B6D             0063*   agnb_vers_major:           equ 0
041B6D             0064*   agnb_vers_minor:           equ 1
041B6D             0065*   agnb_vers_payload_size:    equ 2
041B6D             0066*   
041B6D             0067*   ; LIST BUFR payload
041B6D             0068*   agnb_list_type:            equ 0
041B6D             0069*   agnb_list_chunks:          equ 4
041B6D             0070*   agnb_list_type_size:       equ 4
041B6D             0071*   
041B6D             0072*   ; BHDR payload
041B6D             0073*   agnb_bhdr_bufferId:        equ 0
041B6D             0074*   agnb_bhdr_payload_size:    equ 2
041B6D             0075*   
041B6D             0076*   ; IMAG payload
041B6D             0077*   agnb_imag_width:           equ 0
041B6D             0078*   agnb_imag_height:          equ 2
041B6D             0079*   agnb_imag_format:          equ 4
041B6D             0080*   agnb_imag_payload_size:    equ 5
041B6D             0081*   
041B6D             0082*   ; DATA payload
041B6D             0083*   agnb_data_pixels:          equ 0
041B6D             0084*   
041B6D             0085*   ; Values supported by the version 0.1 image loader
041B6D             0086*   agnb_version_major:        equ 0
041B6D             0087*   agnb_version_minor:        equ 1
041B6D             0088*   agnb_image_rgba2222:       equ 1
041B6D             0089*   
041B6D             0090*   
041B6D             0091*   ; FourCC constants
041B6D             0092*   ; ----------------
041B6D             0093*   ; Store each identifier exactly as it appears on disk. agnb_compare_fourcc
041B6D             0094*   ; compares one of these tables with four bytes read from the container.
041B6D             0095*   
041B6D 52 49 46 46 0096*   agnb_id_riff:              db "RIFF"
041B71 41 47 4E 42 0097*   agnb_id_agnb:              db "AGNB"
041B75 56 45 52 53 0098*   agnb_id_vers:              db "VERS"
041B79 4C 49 53 54 0099*   agnb_id_list:              db "LIST"
041B7D 42 55 46 52 0100*   agnb_id_bufr:              db "BUFR"
041B81 42 48 44 52 0101*   agnb_id_bhdr:              db "BHDR"
041B85 49 4D 41 47 0102*   agnb_id_imag:              db "IMAG"
041B89 44 41 54 41 0103*   agnb_id_data:              db "DATA"
041B8D             0104*   
041B8D             0105*   
041B8D             0106*   ; Reader result codes
041B8D             0107*   ; -------------------
041B8D             0108*   ; Public routines will return A=0 with Z set on success, or one of these
041B8D             0109*   ; nonzero values with NZ set on failure. The same value is stored in
041B8D             0110*   ; agnb_last_error.
041B8D             0111*   
041B8D             0112*   agnb_error_ok:             equ 0
041B8D             0113*   agnb_error_open:           equ 1
041B8D             0114*   agnb_error_read:           equ 2
041B8D             0115*   agnb_error_seek:           equ 3
041B8D             0116*   agnb_error_riff_id:        equ 4
041B8D             0117*   agnb_error_riff_form:      equ 5
041B8D             0118*   agnb_error_version:        equ 6
041B8D             0119*   agnb_error_chunk:          equ 7
041B8D             0120*   agnb_error_bounds:         equ 8
041B8D             0121*   agnb_error_bufferId:       equ 9
041B8D             0122*   agnb_error_metadata:       equ 10
041B8D             0123*   agnb_error_data_size:      equ 11
041B8D             0124*   agnb_error_vdp:            equ 12
041B8D             0125*   agnb_error_eof:            equ 13
041B8D             0126*   agnb_error_not_implemented: equ 255
041B8D             0127*   
041B8D             0128*   
041B8D             0129*   ; FatFS file structure
041B8D             0130*   ; --------------------
041B8D             0131*   ; The direct ffs_* API needs one caller-owned FIL. Its field indices come from
041B8D             0132*   ; mos_api.inc. No FILINFO is needed for opening, reading, seeking, or closing
041B8D             0133*   ; the single known container filename.
041B8D             0134*   
041B8D             0135*   agnb_fil_size:             equ fil_dir_ptr+3
041B8D             0136*   agnb_fil:
041B8D 00 00 00 00 0137*       blkb agnb_fil_size,0
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
041BB1             0138*   
041BB1             0139*   
041BB1             0140*   ; Reader-state structure
041BB1             0141*   ; ----------------------
041BB1             0142*   ; RIFF sizes and offsets are u32 and are kept as four bytes even though most
041BB1             0143*   ; eZ80 arithmetic is 24-bit. The byte at offset +3 must participate in bounds
041BB1             0144*   ; checks and FatFS seeks.
041BB1             0145*   
041BB1             0146*   agnb_state_file_size:      equ 0  ; u32 physical size from FIL object
041BB1             0147*   agnb_state_riff_end:       equ 4  ; u32 first byte after RIFF contents
041BB1             0148*   agnb_state_list_end:       equ 8  ; u32 first byte after current LIST payload
041BB1             0149*   agnb_state_chunk_size:     equ 12 ; u32 current chunk payload size
041BB1             0150*   agnb_state_chunk_end:      equ 16 ; u32 first byte after current payload
041BB1             0151*   agnb_state_file_offset:    equ 20 ; u32 current logical read position
041BB1             0152*   agnb_state_bytes_read:     equ 24 ; u32 last read count (high byte normally 0)
041BB1             0153*   agnb_state_size:           equ 28
041BB1             0154*   
041BB1             0155*   agnb_state:
041BB1 00 00 00 00 0156*       blkb agnb_state_size,0
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
041BCD             0157*   
041BCD             0158*   
041BCD             0159*   ; Normalized image metadata
041BCD             0160*   ; -------------------------
041BCD             0161*   ; BHDR and IMAG are copied here and validated completely before DATA is read.
041BCD             0162*   
041BCD             0163*   agnb_meta_bufferId:        equ 0  ; u16 writer-specified VDP bufferId
041BCD             0164*   agnb_meta_width:           equ 2  ; u16 pixels
041BCD             0165*   agnb_meta_height:          equ 4  ; u16 pixels
041BCD             0166*   agnb_meta_format:          equ 6  ; u8, version 0.1 requires RGBA2222
041BCD             0167*   agnb_meta_data_size:       equ 7  ; u32 DATA payload size
041BCD             0168*   agnb_meta_size:            equ 11
041BCD             0169*   
041BCD             0170*   agnb_metadata:
041BCD 00 00 00 00 0171*       blkb agnb_meta_size,0
       00 00 00 00 
       00 00 00    
041BD8             0172*   
041BD8             0173*   ; Retained u32 result from agnb_calculate_image_data_size for validation and
041BD8             0174*   ; temporary test inspection. The high byte is zero for the 24-bit product.
041BD8             0175*   agnb_expected_data_size:
041BD8 00 00 00 00 0176*       blkb 4,0
041BDC             0177*   
041BDC             0178*   ; Working counters used by agnb_stream_data. DATA sizes accepted by the image
041BDC             0179*   ; loader have already been constrained to 24 bits.
041BDC             0180*   agnb_stream_remaining:
041BDC 00 00 00    0181*       blkb 3,0
041BDF             0182*   agnb_stream_block_size:
041BDF 00 00 00    0183*       blkb 3,0
041BE2             0184*   agnb_padding_size:
041BE2 00          0185*       db 0
041BE3             0186*   
041BE3             0187*   ; Record-validation flags. These are reset at the start of each LIST BUFR.
041BE3             0188*   agnb_record_has_bhdr:      equ 0
041BE3             0189*   agnb_record_has_imag:      equ 1
041BE3             0190*   agnb_record_has_data:      equ 2
041BE3             0191*   
041BE3 00          0192*   agnb_record_flags:         db 0
041BE4 00          0193*   agnb_last_error:           db agnb_error_ok
041BE5 00          0194*   agnb_file_is_open:         db 0
041BE6             0195*   
041BE6             0196*   
041BE6             0197*   ; Reusable I/O storage
041BE6             0198*   ; --------------------
041BE6             0199*   ; The 12-byte buffer is large enough for either the RIFF file header or a
041BE6             0200*   ; generic chunk header plus the four-byte LIST type. DATA is streamed through
041BE6             0201*   ; the application's existing 8 KiB SRAM filedata area.
041BE6             0202*   
041BE6             0203*   agnb_header:
041BE6 00 00 00 00 0204*       blkb agnb_riff_header_size,0
       00 00 00 00 
       00 00 00 00 
041BF2             0205*   
041BF2             0206*   ; Loader-owned transfer window. Wolf3D's fixed SRAM is occupied by map and
041BF2             0207*   ; sprite state, so the API cannot assume the harness's 0xB7E000 scratch area.
041BF2 00 00 00 00 0208*   agnb_io_buffer:            blkb 8192,0
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
