0468C9 06 11       0163*       ld b,17 ; y
0468CB CD 31 13 04 0164*       call vdu_move_cursor
0468CF 3E 80       0165*       ld a,%10000000 ; bit 7 changes once per second
0468D1 CD DA 12 04 0166*       call multiPurposeDelay
