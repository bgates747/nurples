047BDE             0089*   
047BDE             0090*   player_spawn_laser:
047BDE             0091*    ; check laser spawn timer
047BDE FD 21 5D 7B 0092*       ld iy,tmr_laser
       04          
047BE3 CD B3 12 04 0093*       call timestamp_tmr_get
047BE7 F0          0094*       ret p ; not time to fire
