0487E2             0001*   ; Purple Nurples stable runtime telemetry ABI, version 1.
0487E2             0002*   ;
0487E2             0003*   ; Host readers use telemetry_write_seq as a seqlock: read an even sequence,
0487E2             0004*   ; copy telemetry_size bytes, then accept the copy only if the sequence is still
0487E2             0005*   ; the same even value. All multi-byte values are little-endian.
0487E2             0006*   
0487E2             0007*   TELEMETRY_VERSION_MAJOR: equ 1
0487E2             0008*   TELEMETRY_VERSION_MINOR: equ 0
0487E2             0009*   TELEMETRY_FLAG_LEGACY_POINTER_BRIDGE: equ 0
0487E2             0010*   TELEMETRY_FLAG_SESSION_VALID: equ 1
0487E2             0011*   TELEMETRY_FLAG_LEVEL_VALID: equ 2
0487E2             0012*   TELEMETRY_FLAG_ACTORS_VALID: equ 3
0487E2             0013*   
0487E2             0014*   TELEMETRY_LIFECYCLE_RESPAWN:     equ %00000001
0487E2             0015*   TELEMETRY_LIFECYCLE_PLAYER_DEAD: equ %00000010
0487E2             0016*   TELEMETRY_DISPATCH_IDLE: equ 0
0487E2             0017*   
0487E2             0018*   TELEMETRY_OUTCOME_RUNNING:          equ 0
0487E2             0019*   TELEMETRY_OUTCOME_LEVEL_TRANSITION: equ 1
0487E2             0020*   TELEMETRY_OUTCOME_GAME_OVER:        equ 2
0487E2             0021*   TELEMETRY_OUTCOME_VICTORY:          equ 3
0487E2             0022*   TELEMETRY_OUTCOME_EXIT:             equ 4
0487E2             0023*   TELEMETRY_OUTCOME_FAULT:            equ 5
0487E2             0024*   TELEMETRY_OUTCOME_RESPAWN:          equ 6
0487E2             0025*   TELEMETRY_OUTCOME_PLAYER_DEAD:      equ 7
