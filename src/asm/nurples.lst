046481             0001*   ; UART ports for reading joystick input
046481             0002*   ; bit tests: 0 means actuated, 1 means not actuated
046481             0003*   portC: 	EQU 	$9E ; reads dpad input
046481             0004*   joy1_u: equ 1
046481             0005*   joy1_d: equ 3
046481             0006*   joy1_l: equ 5
046481             0007*   joy1_r: equ 7
046481             0008*   portD: 	EQU 	$A2 ; reads buttons
046481             0009*   btn1_a: equ 5
046481             0010*   
046481             0011*   ; process player keyboard input, set player bitmap
046481             0012*   ; velocities and draw player bitmap at updated coordinates
046481             0013*   ; Inputs: player_x/y set at desired position
046481             0014*   ; Returns: player bitmap drawn at updated position
046481             0015*   ; Destroys: probably everything except maybe iy
046481             0016*   ; NOTE: in mode 9 we draw the ship as a sprite, not a bitmap
046481             0017*   ; TODO: requires sprite implementation
046481             0018*   player_input:
046481             0019*   ; point to player sprite record
046481 FD 21 1A 89 0020*       ld iy,player_begin
       04          
046486 FD 22 49 67 0021*       ld (table_pointer),iy
       04          
04648B             0022*   ; reset player component velocities to zero as the default
04648B 21 00 00 00 0023*       ld hl,0
04648F FD 2F 07    0024*       ld (iy+sprite_xvel),hl
046492 FD 2F 0A    0025*       ld (iy+sprite_yvel),hl
046495             0026*   ; make ship the active sprite
046495 FD 7E 00    0027*       ld a,(iy+sprite_id)
046498 CD AE 19 04 0028*       call vdu_sprite_select
04649C             0029*   ; check for keypresses and branch accordingly
04649C             0030*       MOSCALL    mos_getkbmap ;ix = pointer to MOS virtual keys table
                       M1 Args: function=mos_getkbmap 
04649C 3E 1E       0001*M1 			LD	A, function
04649E 5B CF       0002*M1 			RST.LIL	08h
0464A0             0031*   ; do player directional input
0464A0 AF          0032*       xor a ; clear flags
0464A1 DB 9E       0033*       in a,(portC) ; read dpad input
0464A3 57          0034*       ld d,a ; save dpad input
0464A4 3E 01       0035*       ld a,1 ; set ship's default animation to center
0464A6             0036*   ; 26 Left: move player left
0464A6 DD CB 03 4E 0037*       bit 1,(ix+3)
0464AA C2 B8 64 04 0038*       jp nz,@F
0464AE             0039*   ; test dpad left
0464AE CB 6A       0040*       bit joy1_l,d
0464B0 CA B8 64 04 0041*       jp z,@F
0464B4 C3 C4 64 04 0042*       jp @right
0464B8             0043*   @@:
0464B8 FD 27 07    0044*       ld hl,(iy+sprite_xvel)
0464BB 01 00 FD FF 0045*       ld bc,-player_speed
0464BF 09          0046*       add hl,bc
0464C0 FD 2F 07    0047*       ld (iy+sprite_xvel),hl
0464C3 3D          0048*       dec a ; set ship's animation to left
0464C4             0049*   @right:
0464C4             0050*   ; 122 Right: move player right
0464C4 DD CB 0F 4E 0051*       bit 1,(ix+15)
0464C8 C2 D6 64 04 0052*       jp nz,@F
0464CC             0053*   ; test dpad right
0464CC CB 7A       0054*       bit joy1_r,d
0464CE CA D6 64 04 0055*       jp z,@F
0464D2 C3 E2 64 04 0056*       jp @up
0464D6             0057*   @@:
0464D6 FD 27 07    0058*       ld hl,(iy+sprite_xvel)
0464D9 01 00 03 00 0059*       ld bc,player_speed
0464DD 09          0060*       add hl,bc
0464DE FD 2F 07    0061*       ld (iy+sprite_xvel),hl
0464E1 3C          0062*       inc a ; set ship's animation to right
0464E2             0063*   @up:
0464E2             0064*   ; 58 Up: move player up
0464E2 DD CB 07 4E 0065*       bit 1,(ix+7)
0464E6 C2 F4 64 04 0066*       jp nz,@F
0464EA             0067*   ; test dpad up
0464EA CB 4A       0068*       bit joy1_u,d
0464EC CA F4 64 04 0069*       jp z,@F
0464F0 C3 FF 64 04 0070*       jp @dn
0464F4             0071*   @@:
0464F4 FD 27 0A    0072*       ld hl,(iy+sprite_yvel)
0464F7 01 00 FD FF 0073*       ld bc,-player_speed
0464FB 09          0074*       add hl,bc
0464FC FD 2F 0A    0075*       ld (iy+sprite_yvel),hl
0464FF             0076*   @dn:
0464FF             0077*   ; 42 Down: move player down
0464FF DD CB 05 4E 0078*       bit 1,(ix+5)
046503 C2 11 65 04 0079*       jp nz,@F
046507             0080*   ; test dpad down
046507 CB 5A       0081*       bit joy1_d,d
046509 CA 11 65 04 0082*       jp z,@F
04650D C3 1C 65 04 0083*       jp @frame
046511             0084*   @@:
046511 FD 27 0A    0085*       ld hl,(iy+sprite_yvel)
046514 01 00 03 00 0086*       ld bc,player_speed
046518 09          0087*       add hl,bc
046519 FD 2F 0A    0088*       ld (iy+sprite_yvel),hl
04651C             0089*   @frame:
04651C             0090*   ; a should land here loaded with the correct frame
04651C CD 11 1A 04 0091*       call vdu_sprite_select_frame
046520             0092*   ; draw player at updated position
046520 FD 21 1A 89 0093*       ld iy,player_begin
       04          
046525 FD 22 49 67 0094*       ld (table_pointer),iy
       04          
04652A CD 4F 6A 04 0095*       call move_sprite
04652E FD 07 01    0096*       ld bc,(iy+sprite_x)
046531 FD 17 04    0097*       ld de,(iy+sprite_y)
046534 CD 7A 1A 04 0098*       call vdu_sprite_move_abs168
046538             0099*   
046538             0100*   ; process player laser fire
046538             0101*   ; do player fire button input
046538             0102*   ; read joystick fire button
046538 AF          0103*       xor a ; clear flags
