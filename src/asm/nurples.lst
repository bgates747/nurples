0478B3 C3 CB 78 04 0081*       jp @compare
0478B7             0082*   @electrode:
0478B7 11 45 7A 04 0083*       ld de,move_electrode
0478BB C3 CB 78 04 0084*       jp @compare
0478BF             0085*   @lightning:
0478BF 11 E7 7B 04 0086*       ld de,move_lightning
0478C3 C3 CB 78 04 0087*       jp @compare
0478C7             0088*   @crater:
0478C7 11 F7 79 04 0089*       ld de,move_crater
0478CB             0090*   @compare:
0478CB B7          0091*       or a
0478CC ED 52       0092*       sbc hl,de
0478CE C2 D6 78 04 0093*       jp nz,@invalid
0478D2 D5          0094*       push de
0478D3 E1          0095*       pop hl ; publish the fixed expected address, not writable record data
0478D4 37          0096*       scf
0478D5 C9          0097*       ret
0478D6             0098*   @invalid:
0478D6 AF          0099*       xor a
0478D7 C9          0100*       ret
