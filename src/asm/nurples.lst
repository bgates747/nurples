041252             0262*   ; ===============================================
041252             0263*   ; Timer functions
041252             0264*   ; -----------------------------------------------
041252             0265*   ; set a countdown timer
041252             0266*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041252             0267*   ; returns: hl = current time
041252             0268*   tmr_set:
041252 FD 2F 03    0269*       ld (iy+3),hl            ; set time remaining
041255             0270*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041255 3E 08       0001*M1 			LD	A, function
041257 5B CF       0002*M1 			RST.LIL	08h
041259 DD 27 00    0271*       ld hl,(ix+sysvar_time)  ; get current time
04125C FD 2F 00    0272*       ld (iy+0),hl            ; set start time
04125F C9          0273*       ret
041260             0274*   
041260             0275*   ; gets time remaining on a countdown timer
041260             0276*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041260             0277*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
041260             0278*   ;          sign flags: pos = time not expired,zero or neg = time expired
041260             0279*   tmr_get:
041260             0280*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041260 3E 08       0001*M1 			LD	A, function
041262 5B CF       0002*M1 			RST.LIL	08h
041264 DD 17 00    0281*       ld de,(ix+sysvar_time)  ; get current time
041267 FD 27 00    0282*       ld hl,(iy+0)            ; get start time
04126A AF          0283*       xor a                   ; clear carry
04126B ED 52       0284*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
04126D FD 17 03    0285*       ld de,(iy+3)            ; get timer set value
041270 AF          0286*       xor a                   ; clear carry
041271 ED 5A       0287*       adc hl,de               ; hl = time remaining
041273             0288*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
041273 C9          0289*       ret
041274             0290*   
041274             0291*   tmr_test: ds 6 ; example of a buffer to hold timer data
04127A             0292*   
       FF FF FF FF 
       FF FF 
04127A 00 00 00    0293*   timestamp_now: dl 0
04127D 00 00 00    0294*   timestamp_old: dl 0
041280 00 00 00    0295*   timestamp_chg: dl 0
041283             0296*   
041283             0297*   ; update the global timestamp from the system clock
041283             0298*   ; inputs: none
041283             0299*   ; returns: hl = time elapsed in 1/120ths of a second
041283             0300*   ;          de = current time
041283             0301*   ;          ix = pointer to syvars table
041283             0302*   ; destroys: af,hl,de,ix
041283             0303*   timestamp_tick:
041283 ED 5B 7A 12 0304*       ld de,(timestamp_now)   ; get previous time
       04          
041288 ED 53 7D 12 0305*       ld (timestamp_old),de   ; save previous time
       04          
04128D             0306*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04128D 3E 08       0001*M1 			LD	A, function
04128F 5B CF       0002*M1 			RST.LIL	08h
041291 DD 27 00    0307*       ld hl,(ix+sysvar_time)  ; get current time
041294 22 7A 12 04 0308*       ld (timestamp_now),hl   ; save current time
041298 AF          0309*       xor a                   ; clear carry
041299 ED 52       0310*       sbc hl,de               ; hl = time elapsed
04129B 22 80 12 04 0311*       ld (timestamp_chg),hl   ; save elapsed time
04129F C9          0312*       ret
0412A0             0313*   
0412A0             0314*   ; set a countdown timer
0412A0             0315*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412A0             0316*   ; requires: timestamp_tick to be called at least once before this function
0412A0             0317*   ; returns: hl = current time
0412A0             0318*   ; destroys: hl
0412A0             0319*   timestamp_tmr_set:
0412A0 FD 2F 03    0320*       ld (iy+3),hl            ; set time remaining
0412A3 2A 7A 12 04 0321*       ld hl,(timestamp_now)   ; get current timestamp
0412A7 FD 2F 00    0322*       ld (iy+0),hl            ; set start time
0412AA C9          0323*       ret
0412AB             0324*   
0412AB             0325*   ; gets time remaining on a countdown timer following the global timestamp
0412AB             0326*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412AB             0327*   ; requires: timestamp_tick to be called at least once before this function
0412AB             0328*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
0412AB             0329*   ;          sign flags: pos = time not expired,zero or neg = time expired
0412AB             0330*   ; destroys: af,hl,de
0412AB             0331*   timestamp_tmr_get:
0412AB ED 5B 7A 12 0332*       ld de,(timestamp_now)   ; get current timestamp
       04          
0412B0 FD 27 00    0333*       ld hl,(iy+0)            ; get start time
0412B3 AF          0334*       xor a                   ; clear carry
0412B4 ED 52       0335*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
0412B6 FD 17 03    0336*       ld de,(iy+3)            ; get timer set value
0412B9 AF          0337*       xor a                   ; clear carry
0412BA ED 5A       0338*       adc hl,de               ; hl = time remaining
0412BC             0339*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
0412BC C9          0340*       ret
0412BD             0341*   
0412BD             0342*   ; set a stopwatch
0412BD             0343*   ; returns: hl = start time
0412BD             0344*   ; destroys: hl,ix
0412BD             0345*   stopwatch_set:
0412BD             0346*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0412BD 3E 08       0001*M1 			LD	A, function
0412BF 5B CF       0002*M1 			RST.LIL	08h
0412C1 DD 27 00    0347*       ld hl,(ix+sysvar_time)  ; get current time
0412C4 22 D9 12 04 0348*       ld (stopwatch_started),hl            ; set start time
0412C8 C9          0349*       ret
0412C9             0350*   
0412C9             0351*   ; gets time elapsed on a stopwatch
0412C9             0352*   ; returns: hl = time elapsed in 1/120ths of a second
0412C9             0353*   ; destroys: af,hl,de,ix
0412C9             0354*   stopwatch_get:
0412C9             0355*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0412C9 3E 08       0001*M1 			LD	A, function
0412CB 5B CF       0002*M1 			RST.LIL	08h
0412CD DD 27 00    0356*       ld hl,(ix+sysvar_time)  ; get current time
0412D0 ED 5B D9 12 0357*       ld de,(stopwatch_started)            ; get start time
       04          
0412D5 AF          0358*       xor a                   ; clear carry
0412D6 ED 52       0359*       sbc hl,de               ; hl = time elapsed (will always be zero or positive)
0412D8 C9          0360*       ret
0412D9             0361*   
0412D9             0362*   stopwatch_started: ds 3 ; buffer to hold stopwatch start time
0412DC             0363*   
0412DC             0364*   ; ------------------
0412DC             0365*   ; delay routine
0412DC             0366*   ; Author: Richard Turrnidge
0412DC             0367*   ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.asm
0412DC             0368*   ; routine waits a fixed time,then returns
0412DC             0369*   ; arrive with A =  the delay byte. One bit to be set only.
0412DC             0370*   ; eg. ld A,00000100b
0412DC             0371*   
0412DC             0372*   multiPurposeDelay:
       FF FF FF 
0412DC F5          0373*       push af
0412DD C5          0374*       push bc
0412DE DD E5       0375*       push ix
0412E0 47          0376*       ld b,a
0412E1 3E 08       0377*       ld a,$08
0412E3 5B CF       0378*       RST.LIL	08h                 ; get IX pointer to sysvars
0412E5             0379*   
0412E5             0380*   waitLoop:
0412E5             0381*   
0412E5 DD 7E 00    0382*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
0412E8             0383*   
0412E8             0384*                                   ;   we check if bit set is same as last time we checked.
0412E8             0385*                                   ;   bit 0 - don't use
0412E8             0386*                                   ;   bit 1 - changes 64 times per second
0412E8             0387*                                   ;   bit 2 - changes 32 times per second
0412E8             0388*                                   ;   bit 3 - changes 16 times per second
0412E8             0389*   
0412E8             0390*                                   ;   bit 4 - changes 8 times per second
0412E8             0391*                                   ;   bit 5 - changes 4 times per second
0412E8             0392*                                   ;   bit 6 - changes 2 times per second
0412E8             0393*                                   ;   bit 7 - changes 1 times per second
0412E8 A0          0394*       and b
0412E9 4F          0395*       ld c,a
0412EA 3A FB 12 04 0396*       ld a,(oldTimeStamp)
0412EE B9          0397*       cp c                        ; is A same as last value?
0412EF 28 F4       0398*       jr z,waitLoop              ; loop here if it is
0412F1 79          0399*       ld a,c
0412F2 32 FB 12 04 0400*       ld (oldTimeStamp),a        ; set new value
0412F6             0401*   
0412F6 DD E1       0402*       pop ix
0412F8 C1          0403*       pop bc
0412F9 F1          0404*       pop af
0412FA C9          0405*       ret
0412FB             0406*   
0412FB 00          0407*   oldTimeStamp:   .db 00h
