04771A ED 4B E2 76 0039*       ld bc,(tiles_x_plot)
       04          
04771F ED 5B E6 76 0040*       ld de,(tiles_y_plot)
       04          
047724 CD 62 19 04 0041*       call vdu_plot_bmp
047728             0042*   ; bump x-coords the width of one tile and save it
047728 2A E2 76 04 0043*       ld hl,(tiles_x_plot)
04772C 01 10 00 00 0044*       ld bc,16
047730 09          0045*       add hl,bc
047731 22 E2 76 04 0046*       ld (tiles_x_plot),hl
047735             0047*   ; prepare to loop to next column
047735 E1          0048*       pop hl ; get back pointer to tile def
047736 23          0049*       inc hl ; bump it to the next column
047737 C1          0050*       pop bc ; snag our loop counter
047738 10 D4       0051*       djnz @loop
04773A             0052*   ; increment tiles plotting y-coordinate
04773A             0053*   ; (we use ix b/c we want to preserve hl for the next step)
04773A DD 2A E6 76 0054*       ld ix,(tiles_y_plot)
       04          
04773F 11 01 00 00 0055*       ld de,1
047743 DD 19       0056*       add ix,de
047745 DD 22 E6 76 0057*       ld (tiles_y_plot),ix
       04          
04774A DD 7D       0058*       ld a,ixl
04774C FE 01       0059*       cp 1
04774E CA 54 77 04 0060*       jp z,@next_row
047752 AF          0061*       xor a ; no level-complete result this frame
047753 C9          0062*       ret
