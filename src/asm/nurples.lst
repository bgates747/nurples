044E75 21 02 04 00 0153*       ld hl,BUF_BG_STARS_4
044E79 CD C4 14 04 0154*       call vdu_buff_select
044E7D 01 00 00 00 0155*       ld bc,0
044E81 11 00 01 00 0156*       ld de,field_top+256
044E85 CD FA 18 04 0157*       call vdu_plot_bmp
044E89 C9          0158*       ret
