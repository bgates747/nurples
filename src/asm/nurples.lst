0474AD ED 52       0275*       sbc hl,de ; hl = bytes to copy
0474AF E5          0276*       push hl
0474B0 C1          0277*       pop bc ; bytes to copy
0474B1             0278*   ; compute target address
0474B1 ED 5B 12 73 0279*       ld de,(tile_stack_pointer)
       04          
0474B6             0280*   ; copy bytes
0474B6 E1          0281*       pop hl ; copy from address
