048075             0004*   origin_top: equ 48
048075             0005*   origin_left: equ 128
048075             0006*   field_top: equ 0
048075             0007*   field_bottom: equ screen_bottom-origin_top
048075             0008*   field_left: equ 0
048075             0009*   field_right: equ 255
048075             0010*   sprite_top: equ field_top
048075             0011*   sprite_bottom: equ field_bottom-15
048075             0012*   sprite_left: equ field_left
048075             0013*   sprite_right: equ field_right-15
048075             0014*   tile_bottom: equ screen_bottom+1
