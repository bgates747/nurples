04700F             0001*   ; ###### tile TABLE FIELD INDICES ######
04700F             0002*   tile_table_record_size:         equ  64; bytes per tile record
04700F             0003*   tile_id:                 equ   0; 1 bytes ;unique tileId, zero-based
04700F             0004*   ; tile state variables
04700F             0005*   tile_state_variables:    equ   1; beginning of tile state variables
04700F             0006*   tile_x:                  equ   1; 3 bytes ;16.8 fractional x position in pixels
04700F             0007*   tile_y:                  equ   4; 3 bytes ;16.8 fractional y position in pixels
04700F             0008*   tile_xvel:               equ   7; 3 bytes ;x-component velocity, 16.8 fixed, pixels
04700F             0009*   tile_yvel:               equ  10; 3 bytes ;y-component velocity, 16.8 fixed, pixels
04700F             0010*   tile_vel:                equ  13; 3 bytes ;velocity px/frame (16.8 fixed)
04700F             0011*   tile_heading:            equ  16; 3 bytes ;tile movement direction deg256 16.8 fixed
04700F             0012*   tile_orientation:        equ  19; 3 bytes ;orientation bits
04700F             0013*   ; tile definition variables
04700F             0014*   tile_definitions:        equ  22; beginnning of tile definition variables
04700F             0015*   tile_type:               equ  22; 1 bytes ;type of tile as defined in enemies.inc
04700F             0016*   tile_base_bufferId:      equ  23; 3 bytes ;bitmap bufferId
04700F             0017*   tile_move_program:       equ  26; 3 bytes ;address of tile's behavior subroutine
04700F             0018*   tile_collisions:         equ  29; 1 bytes ;see collisions.inc constants for bit definitions
04700F             0019*   tile_dim_x:              equ  30; 1 bytes ;tile width in pixels
04700F             0020*   tile_dim_y:              equ  31; 1 bytes ;tile height in pixels
04700F             0021*   tile_num_orientations:   equ  32; 1 bytes ;number of orientations for this tile
04700F             0022*   tile_num_animations:     equ  33; 1 bytes ;number of animations for this tile
04700F             0023*   tile_animation:          equ  34; 1 bytes ;current animation index, zero-based
04700F             0024*   tile_animation_timer:    equ  35; 1 bytes ;when hits zero, draw next animation
04700F             0025*   tile_move_timer:         equ  36; 1 bytes ;when zero, go to next move program, or step
04700F             0026*   tile_move_step:          equ  37; 1 bytes ;stage in a move program sequence, varies
04700F             0027*   tile_points:             equ  38; 1 bytes ;points awarded for killing this tile type
04700F             0028*   tile_shield_damage:      equ  39; 1 bytes ;shield points deducted for collision
04700F             0029*   tile_frame:              equ  40; 1 bytes ;current animation frame
04700F             0030*   tile_definitions_size:   equ  tile_frame-tile_definitions+1
04700F             0031*   
