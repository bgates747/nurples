041041             0056*   
041041             0057*   ; Draw the splash and advance its marching logo after one complete game image.
041041             0058*   ; The callback result is ignored by AGNB, so an impossible extra callback is
041041             0059*   ; latched for validation after the loader returns.
041041             0060*   img_load_agnb_progress:
041041 2A 04 10 04 0061*       ld hl,(game_load_remaining)
041045 11 00 00 00 0062*       ld de,0
041049 B7          0063*       or a
04104A ED 52       0064*       sbc hl,de
04104C 20 08       0065*       jr nz,@record_expected
04104E 3E 01       0066*       ld a,1
041050 32 07 10 04 0067*       ld (game_load_callback_overflow),a
041054 AF          0068*       xor a
041055 C9          0069*       ret
041056             0070*   
041056             0071*   @record_expected:
041056 2B          0072*       dec hl
041057 22 04 10 04 0073*       ld (game_load_remaining),hl
04105B ED 5B 01 10 0074*       ld de,(game_load_index)
       04          
041060 13          0075*       inc de
041061 ED 53 01 10 0076*       ld (game_load_index),de
       04          
