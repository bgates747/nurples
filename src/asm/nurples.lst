0485EF             0071        include "targeting.inc"
0485EF             0001*   ; compute orientation to player
0485EF             0002*   ; based on relative positions
0485EF             0003*   ; returns: uh.l 16.8 fixed angle256 to player
0485EF             0004*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
0485EF             0005*   ;    representing delta-x/y *to* target respectively
0485EF             0006*   ; inputs: iy pointed at sprite record
0485EF             0007*   ; destroys: everything except iy (sprite record pointer)
0485EF             0008*   orientation_to_player:
0485EF DD 21 60 9C 0009*       ld ix,player_begin
       04          
0485F4             0010*   ; compute dx
0485F4 DD 27 01    0011*       ld hl,(ix+sprite_x)
0485F7 FD 17 01    0012*       ld de,(iy+sprite_x)
0485FA B7          0013*       or a ; clear carry
0485FB ED 52       0014*       sbc hl,de ; dx
0485FD E5          0015*       push hl ; save dx
0485FE             0016*   ; compute dy
0485FE DD 27 04    0017*       ld hl,(ix+sprite_y)
048601 FD 17 04    0018*       ld de,(iy+sprite_y)
048604 B7          0019*       or a ; clear carry
048605 ED 52       0020*       sbc hl,de ; dy
048607 EB          0021*       ex de,hl ; de = dy
048608             0022*   ; compute angle to player
048608 C1          0023*       pop bc ; dx (was hl)
048609 C5          0024*       push bc ; save dx
04860A D5          0025*       push de ; save dy
04860B CD EA 07 04 0026*       call atan2_168fast ; uh.l = angle to player
04860F 3E E0       0027*       ld a,%11100000
048611 A5          0028*       and l ; round angle to nearest 32th of a circle
048612 6F          0029*       ld l,a
048613 22 64 86 04 0030*       ld (Bearing_t),hl ; return angle to player
048617 D1          0031*       pop de ; restore dy
048618 C1          0032*       pop bc ; restore dx
048619 C9          0033*       ret
04861A             0034*   ; end orientation_to_player
04861A             0035*   
04861A             0036*   ; compute orientation to player
04861A             0037*   ; based on relative positions
04861A             0038*   ; returns: uh.l 16.8 fixed angle256 to player
04861A             0039*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
04861A             0040*   ;    representing delta-x/y *to* target respectively
04861A             0041*   ; inputs: iy pointed at tile record
04861A             0042*   ; destroys: everything except iy (tile record pointer)
04861A             0043*   tile_orientation_to_player:
04861A DD 21 60 9C 0044*       ld ix,player_begin
       04          
04861F             0045*   ; compute dx
04861F DD 27 01    0046*       ld hl,(ix+sprite_x)
048622 FD 17 01    0047*       ld de,(iy+tile_x)
048625 B7          0048*       or a ; clear carry
048626 ED 52       0049*       sbc hl,de ; dx
048628 E5          0050*       push hl ; save dx
048629             0051*   ; compute dy
048629 DD 27 04    0052*       ld hl,(ix+sprite_y)
04862C FD 17 04    0053*       ld de,(iy+tile_y)
04862F B7          0054*       or a ; clear carry
048630 ED 52       0055*       sbc hl,de ; dy
048632 EB          0056*       ex de,hl ; de = dy
048633             0057*   ; compute angle to player
048633 C1          0058*       pop bc ; dx (was hl)
048634 CD EA 07 04 0059*       call atan2_168fast ; uh.l = angle to player
048638 3E E0       0060*       ld a,%11100000
04863A A5          0061*       and l ; round angle to nearest 32th of a circle
04863B 6F          0062*       ld l,a
04863C 22 64 86 04 0063*       ld (Bearing_t),hl
048640 C9          0064*       ret
048641             0065*   ; end tile_orientation_to_player
048641             0066*   
048641             0067*   ; compute orientation to coordinate
048641             0068*   ; based on relative positions
048641             0069*   ; returns: uh.l 16.8 fixed angle256 to coordinate
048641             0070*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
048641             0071*   ;    representing delta-x/y *to* target respectively
048641             0072*   ; inputs: iy pointed at sprite record, ub.c,ud.e are target x,y coordinates
048641             0073*   ; destroys: everything except iy (sprite record pointer)
048641             0074*   bearing_to_coord:
048641             0075*   ; compute dx
048641 C5          0076*       push bc
048642 E1          0077*       pop hl
048643 FD 07 01    0078*       ld bc,(iy+sprite_x)
048646 B7          0079*       or a ; clear carry
048647 ED 42       0080*       sbc hl,bc ; dx
048649 E5          0081*       push hl ; save dx
04864A             0082*   ; compute dy
04864A EB          0083*       ex de,hl
04864B FD 17 04    0084*       ld de,(iy+sprite_y)
04864E B7          0085*       or a ; clear carry
04864F ED 52       0086*       sbc hl,de ; dy
048651 EB          0087*       ex de,hl ; de = dy
048652             0088*   ; compute angle to coordinate
048652 C1          0089*       pop bc ; dx (was hl)
048653 C5          0090*       push bc ; save dx
048654 D5          0091*       push de ; save dy
048655 CD EA 07 04 0092*       call atan2_168fast ; uh.l = angle to coordinate
048659 3E E0       0093*       ld a,%11100000
04865B A5          0094*       and l ; round angle to nearest 32th of a circle
04865C 6F          0095*       ld l,a
04865D 22 64 86 04 0096*       ld (Bearing_t),hl ; return angle to coordinate
048661 D1          0097*       pop de ; restore dy
048662 C1          0098*       pop bc ; restore dx
048663 C9          0099*       ret
048664             0100*   ; end bearing_to_coord
048664             0101*   
048664             0102*   ; targeting_computer variables fixed 16.8 format
048664 00 00 00    0103*   Bearing_t: dl 0x000000 ; angle to target
048667 00 00 00    0104*   Heading_t: dl 0x000000 ; angle of target motion
04866A 00 00 00    0105*   Vp: dl 0x000000 ; velocity of projectile
04866D 00 00 00    0106*   Vp_x: dl 0x000000 ; x component of projectile velocity
048670 00 00 00    0107*   Vp_y: dl 0x000000 ; y component of projectile velocity
048673 00 00 00    0108*   Vt: dl 0x000000 ; velocity of target
048676 00 00 00    0109*   Vt_x: dl 0x000000 ; x component of target velocity
048679 00 00 00    0110*   Vt_y: dl 0x000000 ; y component of target velocity
04867C 00 00 00    0111*   Heading_p: dl 0x000000 ; angle of projectile motion
04867F 00 00 00    0112*   lead_angle: dl 0x000000 ; lead angle
048682             0113*   
048682             0114*   ; Inputs:   Vp velocity of projectile set,
048682             0115*   ;           iy pointed to sprite record,
048682             0116*   ;           player position and velocities correctly set
048682             0117*   ; Outputs:  uh.l is the 16.8 fixed firing angle256
048682             0118*   ;           ub.c and ud.e are the 16.8 fixed x,y component projectile velocities
048682             0119*   ; https://old.robowiki.net/cgi-bin/robowiki?LinearTargeting
048682             0120*   targeting_computer:
048682 DD 21 60 9C 0121*       ld ix,player_begin
       04          
048687             0122*   ; ; compute target velocity from x,y component velocities
048687             0123*   ;     ld bc,(ix+sprite_xvel)
048687             0124*   ;     ld de,(ix+sprite_yvel)
048687             0125*   ;     ld hl,-1*256 ; account for vertical ground movement
048687             0126*   ;     add hl,de
048687             0127*   ;     ex de,hl ; ud.e = player_yvel-1
048687             0128*   ;     call cartesian_to_polar_sm ; uh.l = Heading_t, ud.e = Vt
048687             0129*   ;     ld (Heading_t),hl ; PASSES
048687             0130*   ;     ld (Vt),de ; PASSES
048687             0131*   ; ; Bearing_t should have been set by prerequisite call to orientation_to_player
048687             0132*   ; ; compute Heading_t-Bearing_t PASSES
048687             0133*   ;     ld de,(Bearing_t)
048687             0134*   ;     and a ; clear carry
048687             0135*   ;     sbc hl,de ; Uh.l = Heading_t-Bearing_t
048687             0136*   ; ; compute sin(Heading_t-Bearing_t)
048687             0137*   ;     call sin168 ; uh.l = sin(Heading_t-Bearing_t)
048687             0138*   ; ; compute (Vt*sin(Heading_t-Bearing_t))
048687             0139*   ;     ld de,(Vt)
048687             0140*   ;     call smul168 ; uh.l = (Vt*sin(Heading_t-Bearing_t))
048687             0141*   ; ; compute (Vt * sin(Heading_t-Bearing_t)) / Vp
048687             0142*   ;     ld de,(Vp)
048687             0143*   ;     call sdiv168 ; ud.e = (Vt*sin(Heading_t-Bearing_t)) / Vp
048687             0144*   ;     ex de,hl ; uh.l = (Vt*sin(Heading_t-Bearing_t)) / Vp
048687             0145*   ; ; answer is in radians, convert to degrees256
048687             0146*   ;     ld de,0x0028BE ; 40.74 = 57.29578*256/360
048687             0147*   ;     call smul168 ; uh.l = angle in degrees256
048687             0148*   ;     ld (lead_angle),hl ; TODO: fix this
048687             0149*   ; ; add lead angle to target bearing
048687             0150*   ;     ld de,(Bearing_t)
048687             0151*   ;     add hl,de ; h.l = lead angle+target bearing
048687             0152*   
048687 2A 64 86 04 0153*       ld hl,(Bearing_t) ; TODO: fix this
04868B             0154*   
04868B E5          0155*       push hl
04868C             0156*   
04868C             0157*   ; compute component projectile velocities
04868C ED 5B 6A 86 0158*       ld de,(Vp) ; Vp should have been set by caller
       04          
048691 CD F0 06 04 0159*       call polar_to_cartesian ; ub.c = Vp_x, ud.e = Vp_y
048695 ED 43 6D 86 0160*       ld (Vp_x),bc
       04          
04869A             0161*       ; inc d ; account for vertical ground movement
04869A ED 53 70 86 0162*       ld (Vp_y),de
       04          
04869F E1          0163*       pop hl ; uh.l = lead angle+target bearing
0486A0 22 7C 86 04 0164*       ld (Heading_p),hl
0486A4             0165*   
0486A4 C9          0166*       ret
0486A5             0167*   
0486A5             0168*   ; debug print the results
