047A8E 21 7B 7A 04 0019*       ld hl,lightning_defaults
047A92             0020*   ; get next available active tile id
047A92 CD CA 74 04 0021*       call spawn_active_tile
047A96 D0          0022*       ret nc ; no carry means no free active tile slots, so we go home
047A97             0023*   ; other specific initialization
047A97 C9          0024*       ret
047A98             0025*   ; end activate_lightning
047A98             0026*   
047A98             0027*   move_lightning:
