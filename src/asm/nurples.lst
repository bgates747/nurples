040FD9             0001*   ; Purple Nurples AGNB startup integration
040FD9             0002*   ; =======================================
040FD9             0003*   ;
040FD9             0004*   ; UI and gameplay bitmaps retain their established explicit VDP buffer IDs,
040FD9             0005*   ; now carried in two canonical AGNB 0.1 containers. The loose VDU font loader
040FD9             0006*   ; remains separate.
040FD9             0007*   
040FD9 75 69 2E 61 0008*   ui_agnb_filename:   db "ui.agnb",0
       67 6E 62 00 
040FE1 67 61 6D 65 0009*   game_agnb_filename: db "game.agnb",0
       2E 61 67 6E 
       62 00       
040FEB             0010*   
040FEB             0011*   ; The 160x106 logo travels from just inside the lower edge to an 8-pixel top
040FEB             0012*   ; margin. Keep these expressions unambiguous because ez80asm evaluates complex
040FEB             0013*   ; arithmetic left-to-right.
040FEB             0014*   logo_y_start:    equ 224*256
040FEB             0015*   logo_y_end:      equ 8*256
040FEB             0016*   logo_y_distance: equ -216*256
040FEB             0017*   
040FEB 00 00 00    0018*   logo_xpos: dl 0
040FEE 00 00 00    0019*   logo_ypos: dl 0
040FF1 00 00 00    0020*   logo_yvel: dl 0
040FF4             0021*   
040FF4 00 00 00    0022*   game_load_index:             dl 0
040FF7 00 00 00    0023*   game_load_remaining:         dl 0
040FFA 00          0024*   game_load_callback_overflow: db 0
040FFB             0025*   
040FFB             0026*   
040FFB             0027*   ; Print one completion breadcrumb at a safe record boundary. The canonical
040FFB             0028*   ; loader invokes this only after the bitmap has been fully created.
040FFB             0029*   img_load_agnb_breadcrumb:
040FFB 3E 2E       0030*       ld a,'.'
040FFD 5B D7       0031*       rst.lil 10h
040FFF AF          0032*       xor a
041000 C9          0033*       ret
041001             0034*   
041001             0035*   
041001             0036*   ; Initialize exact 16.8 accumulated displacement for all game.agnb records.
041001             0037*   img_load_init:
041001 21 00 00 00 0038*       ld hl,0
041005 22 EB 0F 04 0039*       ld (logo_xpos),hl
041009 22 F4 0F 04 0040*       ld (game_load_index),hl
04100D 7D          0041*       ld a,l
04100E 32 FA 0F 04 0042*       ld (game_load_callback_overflow),a
041012             0043*   
041012 21 00 E0 00 0044*       ld hl,logo_y_start
041016 22 EE 0F 04 0045*       ld (logo_ypos),hl
04101A             0046*   
04101A 21 5E 01 00 0047*       ld hl,game_num_images
04101E 22 F7 0F 04 0048*       ld (game_load_remaining),hl
041022             0049*   
041022 21 00 28 FF 0050*       ld hl,logo_y_distance
041026 11 00 5E 01 0051*       ld de,game_num_images*256
04102A CD 75 06 04 0052*       call sdiv168 ; DE = signed 16.8 distance per completed bitmap
04102E ED 53 F1 0F 0053*       ld (logo_yvel),de
       04          
041033 C9          0054*       ret
041034             0055*   
041034             0056*   
041034             0057*   ; Draw the splash and advance its marching logo after one complete game image.
041034             0058*   ; The callback result is ignored by AGNB, so an impossible extra callback is
041034             0059*   ; latched for validation after the loader returns.
041034             0060*   img_load_agnb_progress:
041034 2A F7 0F 04 0061*       ld hl,(game_load_remaining)
041038 11 00 00 00 0062*       ld de,0
04103C B7          0063*       or a
04103D ED 52       0064*       sbc hl,de
04103F 20 08       0065*       jr nz,@record_expected
041041 3E 01       0066*       ld a,1
041043 32 FA 0F 04 0067*       ld (game_load_callback_overflow),a
041047 AF          0068*       xor a
041048 C9          0069*       ret
041049             0070*   
041049             0071*   @record_expected:
041049 2B          0072*       dec hl
04104A 22 F7 0F 04 0073*       ld (game_load_remaining),hl
04104E ED 5B F4 0F 0074*       ld de,(game_load_index)
       04          
041053 13          0075*       inc de
041054 ED 53 F4 0F 0076*       ld (game_load_index),de
       04          
041059             0077*   
041059             0078*   ; Clear before repainting because screen mode 8 is single-buffered.
041059 CD C5 13 04 0079*       call vdu_cls
04105D 21 2C 00 00 0080*       ld hl,BUF_SPLASH_BG
041061 CD D7 14 04 0081*       call vdu_buff_select
041065 01 00 00 00 0082*       ld bc,0
041069 11 00 00 00 0083*       ld de,0
04106D CD 0D 19 04 0084*       call vdu_plot_bmp
041071             0085*   
041071 CD A2 10 04 0086*       call move_logo
041075             0087*   
041075             0088*   ; Show deterministic record progress without retaining 350 pathname strings.
041075 CD 5C 00 04 0089*       call printInline
041079 4C 6F 61 64 0090*       asciz "Loading images: "
       69 6E 67 20 
       69 6D 61 67 
       65 73 3A 20 
       00          
04108A 2A F4 0F 04 0091*       ld hl,(game_load_index)
04108E CD C8 00 04 0092*       call printDec
041092 CD 5C 00 04 0093*       call printInline
041096 2F 00       0094*       asciz "/"
041098 21 5E 01 00 0095*       ld hl,game_num_images
04109C CD C8 00 04 0096*       call printDec
0410A0             0097*   
0410A0 AF          0098*       xor a
0410A1 C9          0099*       ret
0410A2             0100*   
0410A2             0101*   
0410A2             0102*   move_logo:
0410A2             0103*   ; Snap the last callback to the exact endpoint so fixed-point division
0410A2             0104*   ; remainder cannot accumulate into a visible shortfall.
0410A2 2A F7 0F 04 0105*       ld hl,(game_load_remaining)
0410A6 11 00 00 00 0106*       ld de,0
0410AA B7          0107*       or a
0410AB ED 52       0108*       sbc hl,de
0410AD 20 06       0109*       jr nz,@accumulate
0410AF 21 00 08 00 0110*       ld hl,logo_y_end
0410B3 18 0A       0111*       jr @position_ready
0410B5             0112*   
0410B5             0113*   @accumulate:
0410B5 2A EE 0F 04 0114*       ld hl,(logo_ypos)
0410B9 ED 5B F1 0F 0115*       ld de,(logo_yvel)
       04          
0410BE 19          0116*       add hl,de
0410BF             0117*   
0410BF             0118*   @position_ready:
0410BF 22 EE 0F 04 0119*       ld (logo_ypos),hl
0410C3 21 2D 00 00 0120*       ld hl,BUF_SPLASH_LOGO
0410C7 CD D7 14 04 0121*       call vdu_buff_select
0410CB ED 4B EB 0F 0122*       ld bc,(logo_xpos)
       04          
0410D0 ED 5B EE 0F 0123*       ld de,(logo_ypos)
       04          
0410D5 CD 29 19 04 0124*       call vdu_plot_bmp168
0410D9 C9          0125*       ret
0410DA             0126*   
0410DA             0127*   
0410DA             0128*   ; Load the bootstrap graphics while reporting one dot per finalized bitmap.
0410DA             0129*   ; outputs: canonical AGNB status in A/Z
0410DA             0130*   load_ui_images:
0410DA 11 D9 0F 04 0131*       ld de,ui_agnb_filename
0410DE 21 FB 0F 04 0132*       ld hl,img_load_agnb_breadcrumb
0410E2 C3 1A 3C 04 0133*       jp agnb_load_images_with_callback
0410E6             0134*   
0410E6             0135*   
0410E6             0136*   ; Load all backgrounds, sprites, and DG tiles through one persistent handle.
0410E6             0137*   ; The postcondition guards both catalog drift and callback overrun.
0410E6             0138*   ; outputs: A=0/Z on exact success; AGNB metadata error/NZ otherwise
0410E6             0139*   load_game_images:
0410E6 CD 01 10 04 0140*       call img_load_init
0410EA 11 E1 0F 04 0141*       ld de,game_agnb_filename
0410EE 21 34 10 04 0142*       ld hl,img_load_agnb_progress
0410F2 CD 1A 3C 04 0143*       call agnb_load_images_with_callback
0410F6 C0          0144*       ret nz
0410F7             0145*   
0410F7 2A F7 0F 04 0146*       ld hl,(game_load_remaining)
0410FB 11 00 00 00 0147*       ld de,0
0410FF B7          0148*       or a
041100 ED 52       0149*       sbc hl,de
041102 20 09       0150*       jr nz,@count_error
041104 3A FA 0F 04 0151*       ld a,(game_load_callback_overflow)
041108 B7          0152*       or a
041109 20 02       0153*       jr nz,@count_error
04110B AF          0154*       xor a
04110C C9          0155*       ret
04110D             0156*   
04110D             0157*   @count_error:
04110D 3E 0A       0158*       ld a,agnb_error_metadata
04110F 32 8F 1B 04 0159*       ld (agnb_last_error),a
041113 B7          0160*       or a
041114 C9          0161*       ret
041115             0039        include "timer.inc"
041115             0001*   ; Table 32. Timer Control Registers
041115             0002*   TMR0_CTL: equ 80h
041115             0003*   TMR1_CTL: equ 83h
041115             0004*   TMR2_CTL: equ 86h
041115             0005*   TMR3_CTL: equ 89h
041115             0006*   TMR4_CTL: equ 8Ch
041115             0007*   TMR5_CTL: equ 8Fh
041115             0008*   
041115             0009*   ; each timer register takes three bytes:
041115             0010*   ;   0: control register
041115             0011*   ;   1: low byte of timer reset value
041115             0012*   ;   2: high byte of timer reset value
041115             0013*   ; note that the value is only 8-bits,so we use in0/out0 i/o calls,
041115             0014*   ; which correctly force the high and upper bytes of the address bus to zero
041115             0015*   
041115             0016*   TMR_REG_CTL: equ 0
041115             0017*   TMR_RES_LOW: equ 1
041115             0018*   TMR_RES_HIGH: equ 2
041115             0019*   
041115             0020*   ; Timer Control Register Bit Definitions
041115             0021*   PRT_IRQ_0:    equ %00000000 ; The timer does not reach its end-of-count value.
041115             0022*                               ; This bit is reset to 0 every time the TMRx_CTL register is read.
041115             0023*   PRT_IRQ_1:    equ %10000000 ; The timer reaches its end-of-count value. If IRQ_EN is set to 1,
041115             0024*                               ; an interrupt signal is sent to the CPU. This bit remains 1 until
041115             0025*                               ; the TMRx_CTL register is read.
041115             0026*   
041115             0027*   IRQ_EN_0:     equ %00000000 ; Timer interrupt requests are disabled.
041115             0028*   IRQ_EN_1:     equ %01000000 ; Timer interrupt requests are enabled.
041115             0029*   
041115             0030*   PRT_MODE_0:   equ %00000000 ; The timer operates in SINGLE PASS mode. PRT_EN (bit 0) is reset to
041115             0031*                               ;  0,and counting stops when the end-of-count value is reached.
041115             0032*   PRT_MODE_1:   equ %00010000 ; The timer operates in CONTINUOUS mode. The timer reload value is
041115             0033*                               ; written to the counter when the end-of-count value is reached.
041115             0034*   
041115             0035*   ; CLK_DIV is a 2-bit mask that sets the timer input source clock divider
041115             0036*   CLK_DIV_256:  equ %00001100 ;
041115             0037*   CLK_DIV_64:   equ %00001000 ;
041115             0038*   CLK_DIV_16:   equ %00000100 ;
041115             0039*   CLK_DIV_4:    equ %00000000 ;
041115             0040*   
041115             0041*   RST_EN_0:     equ %00000000 ; The reload and restart function is disabled.
041115             0042*   RST_EN_1:     equ %00000010 ; The reload and restart function is enabled.
041115             0043*                               ; When a 1 is written to this bit,the values in the reload registers
041115             0044*                               ;  are loaded into the downcounter when the timer restarts. The
041115             0045*                               ; programmer must ensure that this bit is set to 1 each time
041115             0046*                               ; SINGLE-PASS mode is used.
041115             0047*   
041115             0048*   ; disable/enable the programmable reload timer
041115             0049*   PRT_EN_0:     equ %00000000 ;
041115             0050*   PRT_EN_1:     equ %00000001 ;
041115             0051*   
041115             0052*   ; Table 37. Timer Input Source Select Register
041115             0053*   ; Each of the 4 timers are allocated two bits of the 8-bit register
041115             0054*   ; in little-endian order,with TMR0 using bits 0 and 1,TMR1 using bits 2 and 3,etc.
041115             0055*   ;   00: System clock / CLK_DIV
041115             0056*   ;   01: RTC / CLK_DIV
041115             0057*   ;   NOTE: these are the values given in the manual,but it may be a typo
041115             0058*   ;   10: GPIO port B pin 1.
041115             0059*   ;   11: GPIO port B pin 1.
041115             0060*   TMR_ISS:   equ 92h ; register address
041115             0061*   
041115             0062*   ; Table 51. Real-Time Clock Control Register
041115             0063*   RTC_CTRL: equ EDh ; register address
041115             0064*   
041115             0065*   ; alarm interrupt disable/enable
041115             0066*   RTC_ALARM_0:    equ %00000000
041115             0067*   RTC_ALARM_1:    equ %10000000
041115             0068*   
041115             0069*   ; interrupt on alarm disable/enable
041115             0070*   RTC_INT_ENT_0:  equ %00000000
041115             0071*   RTC_INT_ENT_1:  equ %01000000
041115             0072*   
041115             0073*   RTC_BCD_EN_0:   equ %00000000   ; RTC count and alarm registers are binary
041115             0074*   RTC_BCD_EN_1:   equ %00100000   ; RTC count and alarm registers are BCD
041115             0075*   
041115             0076*   RTC_CLK_SEL_0:  equ %00000000   ; RTC clock source is crystal oscillator output (32768 Hz).
041115             0077*                                   ; On-chip 32768 Hz oscillator is enabled.
041115             0078*   RTC_CLK_SEL_1:  equ %00010000   ; RTC clock source is power line frequency input as set by FREQ_SEL.
041115             0079*                                   ; On-chip 32768 Hz oscillator is disabled.
041115             0080*   
041115             0081*   RTC_FREQ_SEL_0: equ %00000000   ; 60 Hz power line frequency.
041115             0082*   RTC_FREQ_SEL_1: equ %00001000   ; 50 Hz power line frequency.
041115             0083*   
041115             0084*   RTC_SLP_WAKE_0: equ %00000000   ; RTC does not generate a sleep-mode recovery reset.
041115             0085*   RTC_SLP_WAKE_1: equ %00000010   ; RTC generates a sleep-mode recovery reset.
041115             0086*   
041115             0087*   RTC_UNLOCK_0:   equ %00000000   ; RTC count registers are locked to prevent Write access.
041115             0088*                                   ; RTC counter is enabled.
041115             0089*   RTC_UNLOCK_1:   equ %00000001   ; RTC count registers are unlocked to allow Write access.
041115             0090*                                   ; RTC counter is disabled.
041115             0091*   
041115             0092*   ; prt_reload_emulator: equ 11234 ; 1/102.4 seconds on emulator with 16 clock divider
041115             0093*   
041115             0094*   prt_reload_emulator: equ 11519 ; 1 centisecond on emulator with 16 clock divider
041115             0095*   prt_reload_hardware: equ 11532 ; 1 centisecond on hardware with 16 clock divider
041115 00 00 00    0096*   prt_reload: dl 0x000000
041118             0097*   
041118             0098*   ; returns: a = 0 if running on hardware,1 if running on emulator
041118             0099*   ;          de = number PRT interrupts during test interval
041118             0100*   prt_calibrate:
041118 CD 3A 14 04 0101*       call vdu_vblank
04111C             0102*   ; set a MOS timer
04111C 21 78 00 00 0103*       ld hl,120*1 ; 1 second
041120 FD 21 A0 12 0104*       ld iy,tmr_test
       04          
041125 CD 7E 12 04 0105*       call tmr_set
041129             0106*   ; set a PRT timer
041129             0107*       ; ld hl,prt_reload_hardware
041129             0108*       ; ld hl,prt_reload_emulator
041129 21 05 2D 00 0109*       ld hl,prt_reload_emulator + prt_reload_hardware / 2
04112D 22 15 11 04 0110*       ld (prt_reload),hl
041131 CD B9 11 04 0111*       call prt_set
041135             0112*   @loop:
041135             0113*   ; check time remaining on MOS timer
041135 CD 8C 12 04 0114*       call tmr_get
041139 CA 43 11 04 0115*       jp z,@done ; time expired,so quit
04113D FA 43 11 04 0116*       jp m,@done ; time past expiration (negative),so quit
041141 18 F2       0117*       jr @loop
041143             0118*   @done:
041143 ED 5B 07 12 0119*       ld de,(prt_irq_counter)
       04          
041148 01 0C 2D 00 0120*       ld bc,prt_reload_hardware ; default value for running on hardware
04114C ED 43 15 11 0121*       ld (prt_reload),bc
       04          
041151 21 64 00 00 0122*       ld hl,100 ; halfway between 101 for real hardware and 99 for emulator
041155 AF          0123*       xor a ; clear carry,zero is default value for running on hardware
041156 32 78 11 04 0124*       ld (is_emulator),a
04115A ED 52       0125*       sbc hl,de
04115C 21 79 11 04 0126*       ld hl,on_hardware ; default message for running on hardware
041160 CA 18 11 04 0127*       jp z,prt_calibrate ; zero result is indeterminate so we try again
041164 F8          0128*       ret m ; negative result means we're on hardware
041165 3C          0129*       inc a ; we're on emulator
041166 32 78 11 04 0130*       ld (is_emulator),a
04116A 01 FF 2C 00 0131*       ld bc,prt_reload_emulator
04116E ED 43 15 11 0132*       ld (prt_reload),bc
       04          
041173 21 8F 11 04 0133*       ld hl,on_emulator
041177 C9          0134*       ret
041178 00          0135*   is_emulator: db 0
041179 52 75 6E 6E 0136*   on_hardware: defb "Running on hardware\r\n",0
       69 6E 67 20 
       6F 6E 20 68 
       61 72 64 77 
       61 72 65 0D 
       0A 00       
