04226F             0024*   spawn_explosion:
04226F 21 5C 22 04 0025*       ld hl,explosion_defaults
042273 DD 21 9E 9E 0026*       ld ix,explosions_base
       04          
042278 06 08       0027*       ld b,explosions_max
04227A CD BF 81 04 0028*       call spawn_sprite_from_sprite
04227E D2 0B 81 04 0029*       jp nc,table_deactivate_sprite ; no carry means no free sprite slots, so we deactivate parent sprite and go home
042282             0030*   ; other specific initialization
042282 21 00 00 00 0031*       ld hl,0
042286 DD 2F 07    0032*       ld (ix+sprite_xvel),hl
042289 21 00 01 00 0033*       ld hl,1*256
04228D DD 2F 0A    0034*       ld (ix+sprite_yvel),hl
042290             0035*   ; deactivate parent sprite
042290 C3 0B 81 04 0036*       jp table_deactivate_sprite
042294             0037*   ; end spawn_explosion
042294             0038*   
042294             0039*   spawn_explosion_player:
042294 FD 21 9E 9C 0040*       ld iy,player_begin
       04          
042299 FD 22 C2 80 0041*       ld (table_pointer),iy
       04          
04229E 21 5C 22 04 0042*       ld hl,explosion_defaults
0422A2 DD 21 9E 9E 0043*       ld ix,explosions_base
       04          
0422A7 06 08       0044*       ld b,explosions_max
0422A9 CD BF 81 04 0045*       call spawn_sprite_from_sprite
0422AD D8          0046*       ret c ; carry is the only indication that IX names a valid explosion
0422AE             0047*   ; no slot: keep the player hidden and return failure without exposing invalid IX
0422AE CD 0B 81 04 0048*       call table_deactivate_sprite
0422B2 AF          0049*       xor a ; clear carry after the VDU calls in table_deactivate_sprite
0422B3 C9          0050*       ret
0422B4             0051*   ; end spawn_explosion_player
0422B4             0052*   
0422B4             0053*   tile_spawn_explosion:
0422B4 21 5C 22 04 0054*       ld hl,explosion_defaults
0422B8 DD 21 9E 9E 0055*       ld ix,explosions_base
       04          
0422BD 06 08       0056*       ld b,explosions_max
0422BF CD 92 8D 04 0057*       call spawn_sprite_from_tile
0422C3 D2 C5 8A 04 0058*       jp nc,table_deactivate_tile ; no carry means no free sprite slots, so we deactivate parent tile and go home
0422C7             0059*   ; other specific initialization
0422C7 21 00 00 00 0060*       ld hl,0
0422CB DD 2F 07    0061*       ld (ix+sprite_xvel),hl
0422CE 21 00 01 00 0062*       ld hl,1*256
0422D2 DD 2F 0A    0063*       ld (ix+sprite_yvel),hl
0422D5             0064*   ; deactivate parent sprite
0422D5 C3 C5 8A 04 0065*       jp table_deactivate_tile
0422D9             0066*   ; end tile_spawn_explosion
0422D9             0067*   
0422D9             0068*   move_explosion:
0422D9             0069*   ; run the movement program for the explosion
0422D9 CD 87 82 04 0070*       call move_sprite
0422DD B7          0071*       or a ; a will be non-zero if have scrolled off screen
0422DE C2 0B 81 04 0072*       jp nz,table_deactivate_sprite
0422E2             0073*   ; do the animations
0422E2 FD 35 23    0074*       dec (iy+sprite_animation_timer)
0422E5 C0          0075*       ret nz ; not time to bump animation frame
0422E6 FD 34 28    0076*       inc (iy+sprite_frame)
0422E9 FD 35 22    0077*       dec (iy+sprite_animation)
0422EC CA 0B 81 04 0078*       jp z,table_deactivate_sprite ; reached the end of the animations
0422F0 3E 08       0079*       ld a,explosion_animation_ticks ; reset animation timer
0422F2 FD 77 23    0080*       ld (iy+sprite_animation_timer),a
0422F5 C9          0081*       ret
0422F6             0082*   ; end move_explosion
0422F6             0083*   
0422F6             0084*   move_explosions:
0422F6             0085*   ; initialize pointers and loop counter
0422F6 FD 21 9E 9E 0086*       ld iy,explosions_base ; set iy to first record in table
       04          
0422FB 06 08       0087*       ld b,explosions_max ; loop counter
0422FD CD F1 81 04 0088*       call move_sprite_group
042301 C9          0089*       ret
042302             0090*   ; end move_explosions
042302             0091*   
042302             0092*   init_explosions:
042302             0093*   ; set pointer to explosion sprite table
042302 FD 21 9E 9E 0094*       ld iy,explosions_base
       04          
042307 FD 7E 00    0095*       ld a,(iy+sprite_id) ; sprite id
04230A 1E 08       0096*       ld e,explosions_max ; sprite loop counter
04230C             0097*   ; define explosion sprites
04230C             0098*   @sprites_loop:
04230C F5          0099*       push af
04230D D5          0100*       push de
04230E CD DD 18 04 0101*   	call vdu_sprite_select
042312 CD F0 18 04 0102*   	call vdu_sprite_clear_frames
042316 21 09 01 00 0103*   	ld hl,BUF_EXPLOSION_A
04231A 06 05       0104*   	ld b,5 ; 5 bitmaps for explosion
04231C             0105*   @frames_loop:
04231C C5          0106*   	push bc
04231D E5          0107*   	push hl
04231E CD 32 1A 04 0108*   	call vdu_sprite_add_buff
042322 E1          0109*   	pop hl
042323 23          0110*   	inc hl
042324 C1          0111*   	pop bc
042325 10 F5       0112*   	djnz @frames_loop
042327 D1          0113*       pop de ; sprite loop counter
042328 F1          0114*       pop af ; sprite id
042329 3C          0115*       inc a
04232A 1D          0116*       dec e
04232B C2 0C 23 04 0117*       jp nz,@sprites_loop
04232F C9          0118*       ret
042330             0119*   ; end init_explosions
