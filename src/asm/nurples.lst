044B2C             0034*   move_enemy_seeker_orbit:
044B2C             0035*   ; compute x coordinate of orbit origin based on sprite id
044B2C 3E 05       0036*       ld a,seeker_min_sprite_id
044B2E FD 96 00    0037*       sub (iy+sprite_id)
044B31 6F          0038*       ld l,a
044B32 26 55       0039*       ld h,85 ; 1/3 the playing field width
044B34 ED 6C       0040*       mlt hl
044B36 3E 40       0041*       ld a,64 ; 1/4 of the playing field width
044B38 85          0042*       add a,l ; a = x coordinate of orbit origin
044B39 FD 77 25    0043*       ld (iy+sprite_move_step),a ; as good a place as any to store it
044B3C             0044*   ; initialize orbit angle
044B3C AF          0045*       xor a
044B3D FD 77 13    0046*       ld (iy+sprite_orientation),a
044B40             0047*   ; ; initialize move timer
044B40             0048*   ;     inc a ; set to 1
044B40             0049*   ;     ld (iy+sprite_move_timer),a
044B40             0050*   ; init done, so update move program
044B40 21 47 4B 04 0051*       ld hl,move_enemy_seeker_orbit_stage1 ; update move program pointer
044B44 FD 2F 1A    0052*       ld (iy+sprite_move_program),hl
044B47             0053*   ; fall through to the persistent orbit behavior
044B47             0054*   move_enemy_seeker_orbit_stage1:
044B47             0055*   ; ; check whether time to update orbit angle
044B47             0056*   ;     dec (iy+sprite_move_timer)
044B47             0057*   ;     jp nz,@F ; not time to change so simply movethe sprite on the current heading
044B47             0058*   ;     inc (iy+sprite_move_timer) ; reset timer to 1
044B47             0059*   ; update the target coordinates based on orbit angle and radius
044B47 FD 34 13    0060*       inc (iy+sprite_orientation) ; increment angle
044B4A 21 00 00 00 0061*       ld hl,0 ; clear hlu and l
044B4E FD 66 13    0062*       ld h,(iy+sprite_orientation) ; uh.l = angle
044B51 11 00 80 00 0063*       ld de,128*256 ; ud.e = radius
044B55 CD F6 06 04 0064*       call polar_to_cartesian ; u.bc, u.de = x,y offsets
044B59 FD 7E 25    0065*       ld a,(iy+sprite_move_step) ; x coordinate of orbit origin
044B5C 80          0066*       add a,b ; add x offset
044B5D 01 00 00 00 0067*       ld bc,0 ; bcu and c
044B61 47          0068*       ld b,a ; ub.c = x
044B62 21 00 A8 00 0069*       ld hl,336/2*256
044B66 19          0070*       add hl,de
044B67 EB          0071*       ex de,hl ; ud.e = y
044B68 CD 4E 6F 04 0072*       call bearing_to_coord ; uh.l = angle to coordinate
044B6C FD 2F 10    0073*       ld (iy+sprite_heading),hl ; save angle as heading
044B6F             0074*   ; compute component velocities, save them in sprite record, and move the sprite
044B6F CD 84 6A 04 0075*       call sprite_compute_velocities
044B73             0076*   @@:
044B73 CD E3 69 04 0077*       call move_sprite ; move the sprite
