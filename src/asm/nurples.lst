048917 3C          0099*       inc a
048918 11 00 00 00 0100*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
04891C 57          0101*       ld d,a ; candidate index into tile table
04891D 1E 40       0102*       ld e,tile_table_record_size
04891F ED 5C       0103*       mlt de ; de is now the offset to the table entry
048921 DD 21 87 A1 0104*       ld ix,tile_table_base ; point to base address of tile table
       04          
048926 DD 19       0105*       add ix,de ; ix is now the address of the table entry
