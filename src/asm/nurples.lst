044B98             0015*   
044B98             0016*   seeker_defaults:
044B98 01          0017*       db enemy_air            ; type
044B99 53 01 00    0018*       dl BUF_SEEKER_000       ; base_bufferId
044B9C EC 4C 04    0019*       dl en_nav_seek_zag    ; move_program
044B9F 40          0020*       db %01000000            ; collisions bit 6 signals sprite alive
044BA0 10          0021*       db 16                   ; dim_x
044BA1 10          0022*       db 16                   ; dim_y
044BA2 20          0023*       db 32                   ; num_orientations
044BA3 01          0024*       db 1                    ; num_animations
044BA4 00          0025*       db 0                    ; animation
044BA5 00          0026*       db 0                    ; animation_timer
044BA6 01          0027*       db 1                    ; move_timer
044BA7 00          0028*       db 0                    ; move_step
