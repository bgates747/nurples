041231 CD C8 00 04 0244*       call printDec
041235             0245*   
041235 2A 49 12 04 0246*       ld hl,(prt_loops)
041239 CD C8 00 04 0247*       call printDec
04123D             0248*   
04123D FD E1       0249*       pop iy
04123F DD E1       0250*       pop ix
041241 D1          0251*       pop de
041242 C1          0252*       pop bc
041243 E1          0253*       pop hl
041244 F1          0254*       pop af
041245 C9          0255*       ret
041246             0256*   
