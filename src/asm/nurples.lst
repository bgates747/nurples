049015             0018*   activate_turret_fireball:
049015 21 02 90 04 0019*       ld hl,turret_fireball_defaults
049019             0020*   ; get next available active tile id
049019 CD 02 8B 04 0021*       call spawn_active_tile
04901D D0          0022*       ret nc ; no carry means no free active tile slots, so we go home
04901E             0023*   ; other specific initialization
04901E CD 14 05 04 0024*       call rand_8     ; snag a random number
049022 E6 1F       0025*       and %00011111 ; keep only 5 lowest bits (max 31)
049024 DD 77 24    0026*       ld (ix+tile_move_timer),a ; when this hits zero,will spawn a fireball
049027 C9          0027*       ret
049028             0028*   ; end activate_turret_fireball
049028             0029*   
049028             0030*   move_turret_fireball:
049028 CD 23 8D 04 0031*       call move_active_tile
