047D6D 3A 8A 7D 04 0011*       ld a,(discharge_fuel_timer_max)
047D71 32 89 7D 04 0012*       ld (discharge_fuel_timer),a
047D75 DD 21 5B 7D 0013*       ld ix,bar_fuel
       04          
047D7A 3A 88 7D 04 0014*       ld a,(player_fuel_max)
047D7E DD 77 00    0015*       ld (ix+bar_val),a
047D81 CD 05 7D 04 0016*       call bar_update_h
047D85 C9          0017*       ret
047D86             0018*   ; end init_bar_fuel
047D86             0019*   
047D86 40          0020*   player_fuel: db 64 ; integer
047D87 00          0021*   player_fuel_last: db 0 ; integer
047D88 40          0022*   player_fuel_max: db 64 ; integer
047D89 00          0023*   discharge_fuel_timer: db 0
047D8A 40          0024*   discharge_fuel_timer_max: db 64 ;
047D8B             0025*   discharge_fuel:
047D8B             0026*   ; check fuel timer
047D8B 21 89 7D 04 0027*       ld hl,discharge_fuel_timer
047D8F 35          0028*       dec (hl)
047D90 C0          0029*       ret nz ; not time to discharge fuel so return
047D91             0030*   ; reset fuel discharge timer
047D91 3A 8A 7D 04 0031*       ld a,(discharge_fuel_timer_max)
047D95 77          0032*       ld (hl),a
047D96             0033*   ; discharge fuel
047D96 21 86 7D 04 0034*       ld hl,player_fuel
047D9A 35          0035*       dec (hl)
047D9B CA A4 7D 04 0036*       jp z,@no_fuel
047D9F FA A4 7D 04 0037*       jp m,@no_fuel
047DA3 C9          0038*       ret ; fuel not zero so return
047DA4             0039*   @no_fuel:
047DA4 36 00       0040*       ld (hl),0 ; TODO: implement out-of-fuel handler
047DA6 C9          0041*       ret
047DA7             0042*   ; end discharge_fuel
047DA7             0043*   
047DA7             0044*   draw_fuel:
047DA7 CD 8B 7D 04 0045*       call discharge_fuel
047DAB 21 87 7D 04 0046*       ld hl,player_fuel_last
047DAF 3A 86 7D 04 0047*       ld a,(player_fuel)
047DB3 BE          0048*       cp (hl)
047DB4 C8          0049*       ret z ; no change to update
047DB5 77          0050*       ld (hl),a
047DB6 DD 21 5B 7D 0051*       ld ix,bar_fuel
       04          
047DBB DD 77 00    0052*       ld (ix+bar_val),a ; TODO: this is redundant
047DBE CD 05 7D 04 0053*       call bar_update_h
047DC2 C9          0054*       ret
047DC3             0055*   ; end draw_fuel
047DC3             0063        include "player_input.inc"
047DC3             0001*   ; UART ports for reading joystick input
047DC3             0002*   ; bit tests: 0 means actuated, 1 means not actuated
047DC3             0003*   portC: 	EQU 	$9E ; reads dpad input
047DC3             0004*   joy1_u: equ 1
047DC3             0005*   joy1_d: equ 3
047DC3             0006*   joy1_l: equ 5
047DC3             0007*   joy1_r: equ 7
047DC3             0008*   portD: 	EQU 	$A2 ; reads buttons
047DC3             0009*   btn1_a: equ 5
047DC3             0010*   
047DC3             0011*   ; process player keyboard input, set player bitmap
047DC3             0012*   ; velocities and draw player bitmap at updated coordinates
047DC3             0013*   ; Inputs: player_x/y set at desired position
047DC3             0014*   ; Returns: player bitmap drawn at updated position
047DC3             0015*   ; Destroys: probably everything except maybe iy
047DC3             0016*   ; NOTE: in mode 9 we draw the ship as a sprite, not a bitmap
047DC3             0017*   ; TODO: requires sprite implementation
047DC3             0018*   player_input:
047DC3             0019*   ; point to player sprite record
047DC3 FD 21 03 A0 0020*       ld iy,player_begin
       04          
047DC8 FD 22 89 80 0021*       ld (table_pointer),iy
       04          
047DCD             0022*   ; reset player component velocities to zero as the default
047DCD 21 00 00 00 0023*       ld hl,0
047DD1 FD 2F 07    0024*       ld (iy+sprite_xvel),hl
047DD4 FD 2F 0A    0025*       ld (iy+sprite_yvel),hl
047DD7             0026*   ; make ship the active sprite
047DD7 FD 7E 00    0027*       ld a,(iy+sprite_id)
047DDA CD DB 18 04 0028*       call vdu_sprite_select
047DDE             0029*   ; check for keypresses and branch accordingly
047DDE             0030*       MOSCALL    mos_getkbmap ;ix = pointer to MOS virtual keys table
                       M1 Args: function=mos_getkbmap 
047DDE 3E 1E       0001*M1 			LD	A, function
047DE0 5B CF       0002*M1 			RST.LIL	08h
047DE2             0031*   ; do player directional input
047DE2 AF          0032*       xor a ; clear flags
047DE3 DB 9E       0033*       in a,(portC) ; read dpad input
047DE5 57          0034*       ld d,a ; save dpad input
047DE6 3E 01       0035*       ld a,1 ; set ship's default animation to center
047DE8             0036*   ; 26 Left: move player left
047DE8 DD CB 03 4E 0037*       bit 1,(ix+3)
047DEC C2 FA 7D 04 0038*       jp nz,@F
047DF0             0039*   ; test dpad left
047DF0 CB 6A       0040*       bit joy1_l,d
047DF2 CA FA 7D 04 0041*       jp z,@F
047DF6 C3 06 7E 04 0042*       jp @right
047DFA             0043*   @@:
047DFA FD 27 07    0044*       ld hl,(iy+sprite_xvel)
047DFD 01 00 FD FF 0045*       ld bc,-player_speed
047E01 09          0046*       add hl,bc
047E02 FD 2F 07    0047*       ld (iy+sprite_xvel),hl
047E05 3D          0048*       dec a ; set ship's animation to left
047E06             0049*   @right:
047E06             0050*   ; 122 Right: move player right
047E06 DD CB 0F 4E 0051*       bit 1,(ix+15)
047E0A C2 18 7E 04 0052*       jp nz,@F
047E0E             0053*   ; test dpad right
047E0E CB 7A       0054*       bit joy1_r,d
047E10 CA 18 7E 04 0055*       jp z,@F
047E14 C3 24 7E 04 0056*       jp @up
047E18             0057*   @@:
047E18 FD 27 07    0058*       ld hl,(iy+sprite_xvel)
047E1B 01 00 03 00 0059*       ld bc,player_speed
047E1F 09          0060*       add hl,bc
047E20 FD 2F 07    0061*       ld (iy+sprite_xvel),hl
047E23 3C          0062*       inc a ; set ship's animation to right
047E24             0063*   @up:
047E24             0064*   ; 58 Up: move player up
047E24 DD CB 07 4E 0065*       bit 1,(ix+7)
047E28 C2 36 7E 04 0066*       jp nz,@F
047E2C             0067*   ; test dpad up
047E2C CB 4A       0068*       bit joy1_u,d
047E2E CA 36 7E 04 0069*       jp z,@F
047E32 C3 41 7E 04 0070*       jp @dn
047E36             0071*   @@:
047E36 FD 27 0A    0072*       ld hl,(iy+sprite_yvel)
047E39 01 00 FD FF 0073*       ld bc,-player_speed
047E3D 09          0074*       add hl,bc
047E3E FD 2F 0A    0075*       ld (iy+sprite_yvel),hl
047E41             0076*   @dn:
047E41             0077*   ; 42 Down: move player down
047E41 DD CB 05 4E 0078*       bit 1,(ix+5)
047E45 C2 53 7E 04 0079*       jp nz,@F
047E49             0080*   ; test dpad down
047E49 CB 5A       0081*       bit joy1_d,d
047E4B CA 53 7E 04 0082*       jp z,@F
047E4F C3 5E 7E 04 0083*       jp @frame
047E53             0084*   @@:
047E53 FD 27 0A    0085*       ld hl,(iy+sprite_yvel)
047E56 01 00 03 00 0086*       ld bc,player_speed
047E5A 09          0087*       add hl,bc
047E5B FD 2F 0A    0088*       ld (iy+sprite_yvel),hl
047E5E             0089*   @frame:
047E5E             0090*   ; a should land here loaded with the correct frame
047E5E CD 3E 19 04 0091*       call vdu_sprite_select_frame
047E62             0092*   ; draw player at updated position
047E62 FD 21 03 A0 0093*       ld iy,player_begin
       04          
047E67 FD 22 89 80 0094*       ld (table_pointer),iy
       04          
047E6C CD 4E 82 04 0095*       call move_sprite
047E70 FD 07 01    0096*       ld bc,(iy+sprite_x)
047E73 FD 17 04    0097*       ld de,(iy+sprite_y)
047E76 CD A7 19 04 0098*       call vdu_sprite_move_abs168
047E7A             0099*   
047E7A             0100*   ; process player laser fire
047E7A             0101*   ; do player fire button input
047E7A             0102*   ; read joystick fire button
047E7A AF          0103*       xor a ; clear flags
047E7B DB A2       0104*       in a,(portD) ; read joypad fire button input
047E7D CB 6F       0105*       bit btn1_a,a
047E7F CA 20 7F 04 0106*       jp z,player_spawn_laser
047E83             0107*   ; 99 Space: fire main weapon
047E83 DD CB 0C 56 0108*       bit 2,(ix+12)
047E87 C2 20 7F 04 0109*       jp nz,player_spawn_laser
047E8B             0110*   ; no fire button pressed so go home
047E8B C9          0111*       ret
047E8C             0112*   ; end player_input
047E8C             0064        include "player_laser.inc"
047E8C             0001*   laser_defaults:
047E8C 06          0002*       db player_air        ; type
047E8D 4E 01 00    0003*       dl BUF_LASER_A	    ; base_bufferId
047E90 7D 7F 04    0004*       dl move_player_laser	; move_program
047E93 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
047E94 05          0006*       db 5	                ; dim_x
047E95 0D          0007*       db 13                   ; dim_y
047E96 01          0008*       db 1                    ; num_orientations
047E97 02          0009*       db 2                    ; num_animations
047E98 00          0010*       db 0	                ; animation
047E99 02          0011*       db laser_animation_timer_reset ; animation_timer
047E9A 00          0012*       db 0	                ; move_timer
047E9B 00          0013*       db 0	                ; move_step
047E9C 00          0014*       db 0	                ; points
047E9D 00          0015*       db 0	                ; shield_damage
047E9E 00          0016*       db 0                    ; frame
047E9F             0017*   
047E9F             0018*   
047E9F             0019*   player_lasers_max: equ 4
047E9F             0020*   laser_speed: equ 4*256 ; 6 pixels per frame 16.8 fixed
047E9F             0021*   tmr_laser: ds 6 ; rate timer for firing laser
       FF FF FF FF 
       FF FF 
047EA5 0C 00 00    0022*   tmr_laser_reset: dl 120/10
047EA8             0023*   laser_animation_timer_reset: equ 2 ; animate every two frames
047EA8             0024*   
047EA8 40          0025*   laser_power: db 64 ; integer
047EA9 00          0026*   laser_power_last: db 0 ; integer
047EAA 40          0027*   laser_power_max: db 64 ; integer
047EAB 04          0028*   laser_power_per_shot: db 4 ; integer
047EAC 00          0029*   charge_laser_timer: db 0
047EAD 06          0030*   charge_laser_timer_max: db 6
047EAE             0031*   bar_laser:
047EAE 00 00 00    0032*       dl 0 ; value
047EB1 08 00 00    0033*       dl 8 ; x0
047EB4 30 01 00    0034*       dl 304 ; y0
047EB7 0F 00 00    0035*       dl 8+7 ; x1
047EBA 6F 01 00    0036*       dl 304+63 ; y1
047EBD F0 00 00    0037*       dl 304-64 ; y-plot coordinate
047EC0             0038*   
047EC0             0039*   init_bar_laser:
047EC0 3A AD 7E 04 0040*       ld a,(charge_laser_timer_max)
047EC4 32 AC 7E 04 0041*       ld (charge_laser_timer),a
047EC8 DD 21 AE 7E 0042*       ld ix,bar_laser
       04          
047ECD 3A AA 7E 04 0043*       ld a,(laser_power_max)
047ED1 DD 77 00    0044*       ld (ix+bar_val),a
047ED4 CD A9 7C 04 0045*       call bar_update_v
047ED8 C9          0046*       ret
047ED9             0047*   ; end init_bar_laser
047ED9             0048*   
047ED9             0049*   init_player_laser:
047ED9             0050*   ; set pointer to laser sprite table
047ED9 FD 21 03 9F 0051*       ld iy,player_weapons_begin
       04          
047EDE FD 7E 00    0052*       ld a,(iy+sprite_id) ; sprite id
047EE1 1E 04       0053*       ld e,player_lasers_max ; sprite loop counter
047EE3             0054*   ; define laser sprites
047EE3             0055*   @sprites_loop:
047EE3 F5          0056*       push af
047EE4 D5          0057*       push de
047EE5 CD DB 18 04 0058*   	call vdu_sprite_select
047EE9 CD EE 18 04 0059*   	call vdu_sprite_clear_frames
047EED 21 4E 01 00 0060*   	ld hl,BUF_LASER_A
047EF1 06 02       0061*   	ld b,2 ; two bitmaps for laser
047EF3             0062*   @frames_loop:
047EF3 C5          0063*   	push bc
047EF4 E5          0064*   	push hl
047EF5 CD 30 1A 04 0065*   	call vdu_sprite_add_buff
047EF9 E1          0066*   	pop hl
047EFA 23          0067*   	inc hl
047EFB C1          0068*   	pop bc
047EFC 10 F5       0069*   	djnz @frames_loop
047EFE D1          0070*       pop de ; sprite loop counter
047EFF F1          0071*       pop af ; sprite id
047F00 3C          0072*       inc a
047F01 1D          0073*       dec e
047F02 C2 E3 7E 04 0074*       jp nz,@sprites_loop
047F06             0075*   ; set laser firing timer to zero
047F06 FD 21 9F 7E 0076*       ld iy,tmr_laser
       04          
047F0B 21 00 00 00 0077*       ld hl,0
047F0F CD 9E 12 04 0078*       call timestamp_tmr_set
047F13 C9          0079*       ret
047F14             0080*   ; end init_player_laser
047F14             0081*   
047F14             0082*   player_move_weapons:
047F14             0083*   ; initialize pointers and loop counter
047F14 FD 21 03 9F 0084*       ld iy,player_weapons_begin ; set iy to first record in table
       04          
047F19 06 04       0085*       ld b,player_lasers_max ; loop counter
047F1B CD B8 81 04 0086*       call move_sprite_group
047F1F C9          0087*       ret
047F20             0088*   ; end player_move_weapons
047F20             0089*   
047F20             0090*   player_spawn_laser:
047F20             0091*    ; check laser spawn timer
047F20 FD 21 9F 7E 0092*       ld iy,tmr_laser
       04          
047F25 CD A9 12 04 0093*       call timestamp_tmr_get
047F29 F0          0094*       ret p ; not time to fire
047F2A             0095*   ; check laser power
047F2A 3A A8 7E 04 0096*       ld a,(laser_power)
047F2E 21 AB 7E 04 0097*       ld hl,laser_power_per_shot
047F32 96          0098*       sub (hl) ; units of power per laser shot
047F33 D8          0099*       ret c ; not enough power to fire
047F34             0100*   ; update power to reflect firing
047F34 32 A8 7E 04 0101*       ld (laser_power),a
047F38             0102*   ; reset timer
047F38 2A A5 7E 04 0103*       ld hl,(tmr_laser_reset)
047F3C CD 9E 12 04 0104*       call timestamp_tmr_set
047F40             0105*   ; fire the laser
047F40 DD 21 03 9F 0106*       ld ix,player_weapons_begin
       04          
047F45 06 04       0107*       ld b,player_lasers_max
047F47 FD 21 03 A0 0108*       ld iy,player_begin
       04          
047F4C FD 22 89 80 0109*       ld (table_pointer),iy
       04          
047F51 21 8C 7E 04 0110*       ld hl,laser_defaults
047F55 CD 86 81 04 0111*       call spawn_sprite_from_sprite
047F59 D0          0112*       ret nc ; no carry means no free sprite slots, so we go home
047F5A             0113*   ; other specific initialization
047F5A             0114*   ; ------------------------------------------------
047F5A FD 21 03 A0 0115*       ld iy,player_begin
       04          
047F5F             0116*   ; x-coordinate
047F5F FD 27 01    0117*       ld hl,(iy+sprite_x)
047F62 11 00 05 00 0118*       ld de,5*256 ; horizontal center with player sprite
047F66 19          0119*       add hl,de
047F67 DD 2F 01    0120*       ld (ix+sprite_x),hl
047F6A             0121*   ; y-coordinate
047F6A FD 27 04    0122*       ld hl,(iy+sprite_y)
047F6D 11 00 FA FF 0123*       ld de,-6*256 ; set laser y a few pixels above player
047F71 19          0124*       add hl,de
047F72 DD 2F 04    0125*       ld (ix+sprite_y),hl
047F75             0126*   ; set laser velocity
047F75 21 00 FC FF 0127*       ld hl,-laser_speed
047F79 DD 2F 0A    0128*       ld (ix+sprite_yvel),hl
047F7C C9          0129*       ret
047F7D             0130*   ; end player_spawn_laser
047F7D             0131*   
047F7D             0132*   move_player_laser:
047F7D             0133*   ; run the movement program for the laser
047F7D CD 4E 82 04 0134*       call move_sprite
047F81 3A 8C 80 04 0135*       ld a,(sprite_screen_edge)
047F85 E6 08       0136*       and a,collide_top ; check collision with top of screen
047F87 CA 8F 7F 04 0137*       jp z,@F ; still on screen
047F8B C3 D2 80 04 0138*       jp table_deactivate_sprite
047F8F             0139*   @@: ; check animation timer
047F8F FD 35 23    0140*       dec (iy+sprite_animation_timer)
047F92 C2 A6 7F 04 0141*       jp nz,@F
047F96 3E 02       0142*       ld a,laser_animation_timer_reset
047F98 FD 77 23    0143*       ld (iy+sprite_animation_timer),a
047F9B FD 7E 00    0144*       ld a,(iy+sprite_id)
047F9E CD DB 18 04 0145*       call vdu_sprite_select
047FA2 CD 22 19 04 0146*       call vdu_sprite_next_frame
047FA6             0147*   @@: ; all done
047FA6 C9          0148*       ret
047FA7             0149*   ; end move_player_laser
