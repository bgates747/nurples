0481F1             0232*   ; call the behavior subroutines for a specified sprite group
0481F1             0233*   ; inputs: iy = pointer to sprite group, b = number of records in sprite group
0481F1             0234*   move_sprite_group:
0481F1 C5          0235*       push bc ; backup loop counter
0481F2 FD E5       0236*       push iy ; backup table pointer
0481F4             0237*   @move_loop:
0481F4 FD 22 C2 80 0238*       ld (table_pointer),iy ; update table pointer
       04          
0481F9 C5          0239*       push bc ; backup loop counter
0481FA             0240*   ; check top bit of sprite_type to see if sprite is just spawned
0481FA FD CB 16 7E 0241*       bit 7,(iy+sprite_type)
0481FE C2 33 82 04 0242*       jp nz,@next_record ; if just spawned, skip to next record
048202             0243*   ; check sprite_just_died bit
048202 FD CB 1D 7E 0244*       bit sprite_just_died,(iy+sprite_collisions)
048206 C2 6A 82 04 0245*       jp nz,@sprite_died ; if just died, deactivate sprite
04820A             0246*   ; check sprite_alive bit to see if sprite is active
04820A FD CB 1D 76 0247*       bit sprite_alive,(iy+sprite_collisions)
04820E CA 33 82 04 0248*       jp z,@next_record ; ... skip to next record
048212             0249*   ; otherwise move the sprite
048212 FD 27 1A    0250*       ld hl,(iy+sprite_move_program) ; load the behavior subroutine address
048215             0251*       CALL_HL ; run the behavior subroutine
                       M1 Args: none
048215 01 1B 82 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
048219 C5          0002*M1     push bc ; which constitutes the return address
04821A E9          0003*M1     jp (hl) ; Jump to the address in HL
04821B FD 7E 00    0252*       ld a,(iy+sprite_id) ; get spriteId
04821E CD DD 18 04 0253*       call vdu_sprite_select ; select sprite
048222 FD 7E 28    0254*       ld a,(iy+sprite_frame)
048225 CD 40 19 04 0255*       call vdu_sprite_select_frame
048229 FD 07 01    0256*       ld bc,(iy+sprite_x)
04822C FD 17 04    0257*       ld de,(iy+sprite_y)
04822F CD A9 19 04 0258*       call vdu_sprite_move_abs168
048233             0259*   ; fall through to @next_record
048233             0260*   @next_record:
048233 ED 33 40    0261*       lea iy,iy+table_record_size
048236 AF          0262*       xor a ; clears carry flag
048237 32 C5 80 04 0263*       ld (sprite_screen_edge),a ; clear screen edge collision flag
04823B C1          0264*       pop bc ; get back our loop counter
04823C 10 B6       0265*       djnz @move_loop ; loop until we've checked all the records
04823E             0266*   ; reset all just spawned flags
04823E FD E1       0267*       pop iy ; get back table pointer
048240 C1          0268*       pop bc ; get back loop counter
048241             0269*   @reset_just_spawned:
048241 C5          0270*       push bc ; back up loop counter
048242 FD CB 16 7E 0271*       bit 7,(iy+sprite_type) ; check if just spawned
048246 CA 63 82 04 0272*       jp z,@F
04824A FD CB 16 BE 0273*       res 7,(iy+sprite_type) ; clear just spawned flag
04824E FD 7E 00    0274*       ld a,(iy+sprite_id)
048251 CD DD 18 04 0275*       call vdu_sprite_select
048255 FD 07 01    0276*       ld bc,(iy+sprite_x)
048258 FD 17 04    0277*       ld de,(iy+sprite_y)
04825B CD A9 19 04 0278*       call vdu_sprite_move_abs168
04825F CD 53 19 04 0279*       call vdu_sprite_show
