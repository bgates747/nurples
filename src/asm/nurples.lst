04653B CB 6F       0105*       bit btn1_a,a
04653D CA DB 65 04 0106*       jp z,player_spawn_laser
046541             0107*   ; 99 Space: fire main weapon
046541 DD CB 0C 56 0108*       bit 2,(ix+12)
046545 C2 DB 65 04 0109*       jp nz,player_spawn_laser
046549             0110*   ; no fire button pressed so go home
046549 C9          0111*       ret
04654A             0112*   ; end player_input
