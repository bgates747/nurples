04128B             0263*   ; Timer functions
04128B             0264*   ; -----------------------------------------------
04128B             0265*   ; set a countdown timer
04128B             0266*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
04128B             0267*   ; returns: hl = current time
04128B             0268*   tmr_set:
04128B FD 2F 03    0269*       ld (iy+3),hl            ; set time remaining
04128E             0270*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04128E 3E 08       0001*M1 			LD	A, function
041290 5B CF       0002*M1 			RST.LIL	08h
041292 DD 27 00    0271*       ld hl,(ix+sysvar_time)  ; get current time
041295 FD 2F 00    0272*       ld (iy+0),hl            ; set start time
041298 C9          0273*       ret
041299             0274*   
041299             0275*   ; gets time remaining on a countdown timer
041299             0276*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041299             0277*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
041299             0278*   ;          sign flags: pos = time not expired,zero or neg = time expired
041299             0279*   tmr_get:
041299             0280*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041299 3E 08       0001*M1 			LD	A, function
04129B 5B CF       0002*M1 			RST.LIL	08h
04129D DD 17 00    0281*       ld de,(ix+sysvar_time)  ; get current time
0412A0 FD 27 00    0282*       ld hl,(iy+0)            ; get start time
0412A3 AF          0283*       xor a                   ; clear carry
0412A4 ED 52       0284*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
0412A6 FD 17 03    0285*       ld de,(iy+3)            ; get timer set value
0412A9 AF          0286*       xor a                   ; clear carry
0412AA ED 5A       0287*       adc hl,de               ; hl = time remaining
0412AC             0288*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
0412AC C9          0289*       ret
