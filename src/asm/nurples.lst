047A25             0059        include "player_state.inc"
047A25             0001*   player_defaults:
047A25 05          0002*       db player               ; type
047A26 73 01 00    0003*       dl BUF_SHIP_0L          ; base_bufferId
047A29 8F 7A 04    0004*       dl do_player            ; move_program
047A2C 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
047A2D 10          0006*       db 16                   ; dim_x
047A2E 10          0007*       db 16                   ; dim_y
047A2F 01          0008*       db 1                    ; num_orientations
047A30 01          0009*       db 1                    ; num_animations
047A31 00          0010*       db 0                    ; animation
047A32 00          0011*       db 0                    ; animation_timer
047A33 00          0012*       db 0                    ; move_timer
047A34 00          0013*       db 0                    ; move_step
047A35 00          0014*       db 0                    ; points
047A36 00          0015*       db 0                    ; shield_damage
047A37 00          0016*       db 0                    ; frame
047A38             0017*   
047A38 5F 7B 04    0018*   player_state:  dl player_alive
047A3B             0019*   player_event_none: equ 0
047A3B             0020*   player_event_game_over: equ 1
047A3B 00          0021*   player_event: db player_event_none
047A3C             0022*   player_fault_bad_state: equ 0
047A3C 00          0023*   player_fault_flags: db 0 ; latched fail-closed diagnostics
047A3D 00          0024*   player_ships: db 0
047A3E 03          0025*   player_ships_max: db 3
047A3F             0026*   player_speed: equ 3*256 ; pixels per frame 16.8 fixed
047A3F             0027*   
047A3F             0028*   draw_player_ships:
047A3F             0029*   ; activate mfd
047A3F DD 21 BC 7C 0030*       ld ix,mfd_ships
       04          
047A44 CD C3 7D 04 0031*       call mfd_activate
047A48             0032*   ; blank out previously drawn ships
047A48 AF          0033*       xor a ; color mode 0
047A49 0E 00       0034*       ld c,c_black
047A4B CD C3 13 04 0035*       call vdu_gcol
047A4F 01 00 00 00 0036*       ld bc,0
047A53 11 00 00 00 0037*       ld de,0
047A57 DD 21 4F 00 0038*       ld ix,0+79
       00          
047A5C FD 21 0F 00 0039*       ld iy,0+15
       00          
047A61 CD E0 18 04 0040*       call vdu_plot_rf
047A65             0041*   ; draw the ships remaining
047A65 21 2B 00 00 0042*       ld hl,BUF_SHIP_MFD
047A69 CD 93 14 04 0043*       call vdu_buff_select
047A6D 3A 3D 7A 04 0044*       ld a,(player_ships) ; loop counter
047A71 01 00 00 00 0045*       ld bc,0 ; starting x-coordinate
047A75             0046*   @loop:
047A75 3D          0047*       dec a ; we don't count the ship we're flying
047A76 C8          0048*       ret z
047A77 F5          0049*       push af ; back up loop counter
047A78 C5          0050*       push bc ; save x-coordinate
047A79 11 00 00 00 0051*       ld de,0 ; y-coordinate
047A7D CD A3 18 04 0052*       call vdu_plot_bmp
047A81 C1          0053*       pop bc ; restore x-coordinate
047A82 21 10 00 00 0054*       ld hl,16 ; bump x-coords
047A86 09          0055*       add hl,bc
047A87 E5          0056*       push hl
047A88 C1          0057*       pop bc ; bc = new x-coordinate
047A89 F1          0058*       pop af
047A8A C3 75 7A 04 0059*       jp @loop
047A8E C9          0060*       ret
047A8F             0061*   ; end draw_player_ships
047A8F             0062*   
047A8F             0063*   do_player:
047A8F 2A 38 7A 04 0064*       ld hl,(player_state)
047A93 CD AF 7A 04 0065*       call player_state_pointer_valid
047A97 DA A8 7A 04 0066*       jp c,@dispatch
047A9B 21 3C 7A 04 0067*       ld hl,player_fault_flags
047A9F CB C6       0068*       set player_fault_bad_state,(hl)
047AA1 3E 01       0069*       ld a,player_event_game_over
047AA3 32 3B 7A 04 0070*       ld (player_event),a
047AA7 C9          0071*       ret
047AA8             0072*   @dispatch:
047AA8             0073*       CALL_HL
                       M1 Args: none
047AA8 01 AE 7A 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
047AAC C5          0002*M1     push bc ; which constitutes the return address
047AAD E9          0003*M1     jp (hl) ; Jump to the address in HL
047AAE C9          0074*       ret
047AAF             0075*   ; end do_player
047AAF             0076*   
047AAF             0077*   ; Exact stabilization whitelist for writable legacy player-state pointers.
047AAF             0078*   ; Invalid actor state is surfaced as an event for the global coordinator.
047AAF             0079*   player_state_pointer_valid:
047AAF 11 5F 7B 04 0080*       ld de,player_alive
047AB3 CD D7 7A 04 0081*       call @matches
047AB7 CA D5 7A 04 0082*       jp z,@valid
047ABB 11 95 7B 04 0083*       ld de,player_dying
047ABF CD D7 7A 04 0084*       call @matches
047AC3 CA D5 7A 04 0085*       jp z,@valid
047AC7 11 31 7C 04 0086*       ld de,player_dead
047ACB CD D7 7A 04 0087*       call @matches
047ACF CA D5 7A 04 0088*       jp z,@valid
047AD3 AF          0089*       xor a
047AD4 C9          0090*       ret
047AD5             0091*   @valid:
047AD5 37          0092*       scf
047AD6 C9          0093*       ret
047AD7             0094*   @matches:
047AD7 E5          0095*       push hl
047AD8 B7          0096*       or a
047AD9 ED 52       0097*       sbc hl,de
047ADB E1          0098*       pop hl
047ADC C9          0099*       ret
047ADD             0100*   ; end player_state_pointer_valid
047ADD             0101*   
047ADD             0102*   ; set initial player position
047ADD             0103*   ; inputs: none,everything is hardcoded
047ADD             0104*   ; outputs: player_x/y set to bottom-left corner of screen
047ADD             0105*   ; destroys: pretty much everything
047ADD             0106*   player_init:
047ADD 3A 65 81 04 0107*       ld a,(player_shields_max)
047AE1 32 64 81 04 0108*       ld (player_shields),a
047AE5 3A FD 7F 04 0109*       ld a,(laser_power_max)
047AE9 32 FB 7F 04 0110*       ld (laser_power),a
047AED 3A DB 7E 04 0111*       ld a,(player_fuel_max)
047AF1 32 D9 7E 04 0112*       ld (player_fuel),a
047AF5             0113*   ; set all to zero so they will update
047AF5 AF          0114*       xor a
047AF6 32 FC 7F 04 0115*       ld (laser_power_last),a
047AFA 32 66 81 04 0116*       ld (player_shields_last),a
047AFE 32 DA 7E 04 0117*       ld (player_fuel_last),a
047B02             0118*   ; set player sprite record with defaults
047B02 DD 21 23 A2 0119*       ld ix,player_begin
       04          
047B07 21 25 7A 04 0120*       ld hl,player_defaults
047B0B 01 00 00 00 0121*       ld bc,0*256
047B0F 11 00 40 01 0122*       ld de,sprite_bottom*256
047B13 3E 01       0123*       ld a,1
047B15 CD EC 82 04 0124*       call spawn_sprite_from_coords
047B19 D0          0125*       ret nc ; IX is invalid when the one-record player pool is full
047B1A DD CB 16 BE 0126*       res 7,(ix+sprite_type)
047B1E             0127*   ; load sprite frames
047B1E DD 7E 00    0128*       ld a,(ix+sprite_id)
047B21 CD 44 19 04 0129*       call vdu_sprite_select
047B25 CD 57 19 04 0130*       call vdu_sprite_clear_frames
047B29 21 73 01 00 0131*       ld hl,BUF_SHIP_0L
047B2D CD 99 1A 04 0132*       call vdu_sprite_add_buff
047B31 21 74 01 00 0133*       ld hl,BUF_SHIP_1C
047B35 CD 99 1A 04 0134*       call vdu_sprite_add_buff
047B39 21 75 01 00 0135*       ld hl,BUF_SHIP_2R
047B3D CD 99 1A 04 0136*       call vdu_sprite_add_buff
047B41             0137*   @draw:
047B41 01 00 00 00 0138*       ld bc,0*256
047B45 11 00 40 01 0139*       ld de,sprite_bottom*256
047B49 CD 10 1A 04 0140*       call vdu_sprite_move_abs168
047B4D CD BA 19 04 0141*       call vdu_sprite_show
047B51 21 5F 7B 04 0142*       ld hl,player_alive
047B55 22 38 7A 04 0143*       ld (player_state),hl
047B59 DD CB 1D F6 0144*       set sprite_alive,(ix+sprite_collisions)
047B5D 37          0145*       scf ; publish successful initialization to the caller
047B5E C9          0146*       ret
047B5F             0147*   ; end player_init
047B5F             0148*   
047B5F             0149*   player_alive:
047B5F CD 16 7F 04 0150*       call player_input
047B63 CD 67 80 04 0151*       call player_move_weapons
047B67 C9          0152*       ret
047B68             0153*   ; end player_alive
047B68             0154*   
047B68             0155*   kill_player:
047B68             0156*   ; update_shields callers still own their collision-record index registers
047B68 F5          0157*       push af
047B69 C5          0158*       push bc
047B6A DD E5       0159*       push ix
047B6C FD E5       0160*       push iy
047B6E             0161*   ; set player collision flag to dead
047B6E DD 21 23 A2 0162*       ld ix,player_begin
       04          
047B73 DD CB 1D B6 0163*       res sprite_alive,(ix+sprite_collisions)
047B77             0164*   ; change seeker move program to move_enemy_seeker_orbit
047B77 FD 21 63 A2 0165*       ld iy,seekers_base
       04          
047B7C 21 F1 21 04 0166*       ld hl,move_enemy_seeker_orbit
047B80 06 03       0167*       ld b,seekers_max
047B82 CD E8 84 04 0168*       call change_sprite_group_move_program
047B86             0169*   ; set player state to dying
047B86 21 95 7B 04 0170*       ld hl,player_dying
047B8A 22 38 7A 04 0171*       ld (player_state),hl
047B8E FD E1       0172*       pop iy
047B90 DD E1       0173*       pop ix
047B92 C1          0174*       pop bc
047B93 F1          0175*       pop af
047B94 C9          0176*       ret
047B95             0177*   ; end kill_player
047B95             0178*   
047B95             0179*   player_dying:
047B95             0180*   ; spawn explosions at player location
047B95 06 10       0181*       ld b,16 ; loop counter
047B97             0182*   @loop_explode:
047B97 C5          0183*       push bc ; save loop counter
047B98 CD 60 23 04 0184*       call spawn_explosion_player
047B9C D2 AE 7B 04 0185*       jp nc,@animate_initial ; never dereference IX after allocation failure
047BA0 21 00 00 00 0186*       ld hl,0
047BA4 DD 2F 07    0187*       ld (ix+sprite_xvel),hl
047BA7 21 00 01 00 0188*       ld hl,1*256
047BAB DD 2F 0A    0189*       ld (ix+sprite_yvel),hl
047BAE             0190*   ; move explosions for a few frames
047BAE             0191*   @animate_initial:
047BAE 06 10       0192*       ld b,16 ; loop counter
047BB0             0193*   @loop_animate:
047BB0 C5          0194*       push bc
047BB1 CD F4 7B 04 0195*       call @animate
047BB5 C1          0196*       pop bc
047BB6 10 F8       0197*       djnz @loop_animate
047BB8 C1          0198*       pop bc
047BB9 10 DC       0199*       djnz @loop_explode
047BBB             0200*   ; delay until grand finale
047BBB 06 10       0201*       ld b,16 ; loop counter
047BBD             0202*   @loop_delay:
047BBD C5          0203*       push bc
047BBE CD F4 7B 04 0204*       call @animate
047BC2 C1          0205*       pop bc
047BC3 10 F8       0206*       djnz @loop_delay
047BC5             0207*   ; set up the grand finale
047BC5 06 08       0208*       ld b,explosions_max ; loop counter
047BC7             0209*   @loop_spawn_finale:
047BC7 C5          0210*       push bc
047BC8 CD 60 23 04 0211*       call spawn_explosion_player
047BCC D2 DE 7B 04 0212*       jp nc,@next_finale_spawn ; IX is outside the explosion pool on failure
047BD0 CD 11 7C 04 0213*       call @rand
047BD4 DD 2F 07    0214*       ld (ix+sprite_xvel),hl
047BD7 CD 11 7C 04 0215*       call @rand
047BDB DD 2F 0A    0216*       ld (ix+sprite_yvel),hl
047BDE             0217*   @next_finale_spawn:
047BDE C1          0218*       pop bc
047BDF 10 E6       0219*       djnz @loop_spawn_finale
047BE1 06 29       0220*       ld b,explosion_lifetime_updates ; clear just-spawned, then finish all frames
047BE3             0221*   @loop_finale_animate:
047BE3 C5          0222*       push bc
047BE4 CD F4 7B 04 0223*       call @animate
047BE8 C1          0224*       pop bc
047BE9 10 F8       0225*       djnz @loop_finale_animate
047BEB             0226*   
047BEB             0227*   ; set game state to player dead
047BEB 21 31 7C 04 0228*       ld hl,player_dead
047BEF 22 38 7A 04 0229*       ld (player_state),hl
047BF3 C9          0230*       ret
047BF4             0231*   @animate:
047BF4 CD D9 8F 04 0232*       call tiles_plot
047BF8 CD BE 81 04 0233*       call set_gfx_playing_field
047BFC CD 67 80 04 0234*       call player_move_weapons
047C00 CD 95 20 04 0235*       call do_enemies
047C04 CD C2 23 04 0236*       call move_explosions
047C08 CD B9 91 04 0237*       call move_tiles
047C0C CD F6 13 04 0238*       call vdu_vblank
047C10 C9          0239*       ret
047C11             0240*   @rand:
047C11 21 00 00 00 0241*       ld hl,0
047C15 CD 14 05 04 0242*       call rand_8
047C19 47          0243*       ld b,a
047C1A E6 01       0244*       and %00000001
047C1C 67          0245*       ld h,a
047C1D 68          0246*       ld l,b
047C1E CB 78       0247*       bit 7,b
047C20 C8          0248*       ret z
047C21 CD 7C 04 04 0249*       call neg_hlu
047C25 C9          0250*       ret
047C26             0251*   ; end player_dying
