048EC7 ED 52       0109*       sbc hl,de ; if not the same address, loop
048EC9 C2 C0 8E 04 0110*       jp nz,@find_loop
048ECD ED 33 FD    0111*       lea iy,iy-3 ; back up to the record we want
048ED0 FD 22 F6 89 0112*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
048ED5 FD 37 00    0113*       ld iy,(iy) ; iy points to the tile stack record
048ED8 FD 22 F9 89 0114*       ld (tile_table_pointer),iy ; set pointer to this tile record
       04          
048EDD C3 A1 8D 04 0115*       jp activate_crater
048EE1 F3 86 04    0116*   @tile_stack_pointer: dl tile_stack ; pointer to current stack record, initialized to tile_stack
048EE4 00 00 00    0117*   @tile_y: dl 0 ; y position of tiles to kill
