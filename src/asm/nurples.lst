044E92 3E 90       0165*       ld a,16+128 ; darkest blue
044E94 CD E3 13 04 0166*       call vdu_colour_text
044E98 3E 3A       0167*       ld a,58 ; dark orange
044E9A CD E3 13 04 0168*       call vdu_colour_text
