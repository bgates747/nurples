0421C4             0103*   
0421C4             0104*   ; contains the logic for how to move the enemy
0421C4             0105*   ; and then does the moving
0421C4             0106*   ; inputs: a fully-populated active sprite table
0421C4             0107*   ;         player position variables
0421C4             0108*   ; destroys: everything except index registers
0421C4             0109*   ; outputs: moving enemies
0421C4             0110*   en_nav_seek_zag:
0421C4             0111*   ; set velocity and orientation by player's relative location
0421C4             0112*   ; move enemies y-axis
0421C4             0113*   ; where is player relative to us?
0421C4 CD 1A 86 04 0114*       call orientation_to_player ; uh.l angle to player, ub.c, ud.e = dx, dy
0421C8             0115*   ; is player above or below us?
0421C8 ED 53 37 03 0116*       ld (ude),de ; dy
       04          
0421CD 3A 39 03 04 0117*       ld a,(ude+2) ; deu
0421D1 17          0118*       rla ; shift sign bit into carry
0421D2 D2 FA 21 04 0119*       jp nc,@zig_zag ; player is below,evade
0421D6             0120*   ; player is even or above,so home in on current heading
0421D6 FD 2F 10    0121*       ld (iy+sprite_heading),hl ; save sprite heading
0421D9             0122*   ; fall through to @compute_velocities
0421D9             0123*   @compute_velocities:
0421D9 CD 28 83 04 0124*       call sprite_compute_velocities
0421DD CD 87 82 04 0125*       call move_sprite ; move the sprite
0421E1 B7          0126*       or a ; a will be non-zero if have collided with screen edge
0421E2 C2 05 22 04 0127*       jp nz,@zag_switch ; switch direction
0421E6 C3 87 21 04 0128*       jp move_enemy_seeker ; didn't hit an edge so check collisions and move sprite
0421EA             0129*   @zig_zag_start:
0421EA FD 2A C2 80 0130*       ld iy,(table_pointer)
       04          
0421EF CD 14 05 04 0131*       call rand_8
0421F3 E6 3F       0132*       and %00111111 ; limit it to 64
0421F5 CB DF       0133*       set 3,a ; make sure it's at least 8
0421F7 FD 77 24    0134*       ld (iy+sprite_move_timer),a ; store it
0421FA             0135*       ; fall through to @zig_zag
0421FA             0136*   @zig_zag:
0421FA FD 7E 24    0137*       ld a,(iy+sprite_move_timer)
0421FD 3D          0138*       dec a
0421FE FD 77 24    0139*       ld (iy+sprite_move_timer),a
042201 C2 27 22 04 0140*       jp nz,@zig_zag_no_switch
042205             0141*   @zag_switch:
042205             0142*       ; otherwise flip direction and restart timer
042205 FD 7E 25    0143*       ld a,(iy+sprite_move_step)
042208 EE 01       0144*       xor %1 ; flips bit zero
04220A FD 77 25    0145*       ld (iy+sprite_move_step),a ; store it
04220D C2 1C 22 04 0146*       jp nz,@F ; zag right
042211             0147*   ;otherwise zag left
042211 21 00 A0 00 0148*       ld hl,160*256; southwest heading
042215 FD 2F 10    0149*       ld (iy+sprite_heading),hl ; save sprite heading
042218 C3 EA 21 04 0150*       jp @zig_zag_start
04221C             0151*   @@: ; zag right
04221C 21 00 60 00 0152*       ld hl,96*256; southeast heading
042220 FD 2F 10    0153*       ld (iy+sprite_heading),hl ; save sprite heading
042223 C3 EA 21 04 0154*       jp @zig_zag_start
042227             0155*   @zig_zag_no_switch:
042227             0156*       ; ld a,(sprite_orientation)
042227 FD 27 10    0157*       ld hl,(iy+sprite_heading)
04222A C3 D9 21 04 0158*       jp @compute_velocities
04222E             0159*   ; end en_nav_seek_zag
