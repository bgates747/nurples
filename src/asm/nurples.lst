046726             0003*   screen_bottom: equ 383
046726             0004*   origin_top: equ 48
046726             0005*   origin_left: equ 128
046726             0006*   field_top: equ 0
046726             0007*   field_bottom: equ screen_bottom-origin_top
046726             0008*   field_left: equ 0
046726             0009*   field_right: equ 255
046726             0010*   sprite_top: equ field_top
046726             0011*   sprite_bottom: equ field_bottom-15
046726             0012*   sprite_left: equ field_left
046726             0013*   sprite_right: equ field_right-15
046726             0014*   tile_bottom: equ screen_bottom+1
046726             0015*   
