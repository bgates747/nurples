048DE3 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
048DE4 10          0006*       db 16                   ; dim_x
048DE5 10          0007*       db 16                   ; dim_y
048DE6 01          0008*       db 1                    ; num_orientations
048DE7 01          0009*       db 1                    ; num_animations
048DE8 00          0010*       db 0                    ; animation
048DE9 00          0011*       db 0                    ; animation_timer
048DEA 00          0012*       db 0                    ; move_timer
048DEB 00          0013*       db 0                    ; move_step
048DEC 05          0014*       db 5                    ; points
048DED FC          0015*       db -4                   ; shield_damage
