04950E 01          0008*       db 1                    ; num_orientations
04950F 01          0009*       db 1                    ; num_animations
049510 00          0010*       db 0                    ; animation
049511 10          0011*       db 16                   ; animation_timer
049512 00          0012*       db 0                    ; move_timer
049513 00          0013*       db 0                    ; move_step
049514 05          0014*       db 5                    ; points
049515 00          0015*       db 0                    ; shield_damage
