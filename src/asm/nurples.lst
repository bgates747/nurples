049546 FD 7E 28    0040*       ld a,(iy+tile_frame)
049549 3C          0041*       inc a
04954A E6 07       0042*       and %00000111 ; modulo 8
04954C FD 77 28    0043*       ld (iy+tile_frame),a
04954F CD 3E 92 04 0044*       call draw_active_tile
