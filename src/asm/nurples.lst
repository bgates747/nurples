0421BE             0103*   
0421BE             0104*   ; contains the logic for how to move the enemy
0421BE             0105*   ; and then does the moving
0421BE             0106*   ; inputs: a fully-populated active sprite table
0421BE             0107*   ;         player position variables
0421BE             0108*   ; destroys: everything except index registers
0421BE             0109*   ; outputs: moving enemies
0421BE             0110*   en_nav_seek_zag:
0421BE             0111*   ; set velocity and orientation by player's relative location
0421BE             0112*   ; move enemies y-axis
0421BE             0113*   ; where is player relative to us?
0421BE CD EF 85 04 0114*       call orientation_to_player ; uh.l angle to player, ub.c, ud.e = dx, dy
0421C2             0115*   ; is player above or below us?
0421C2 ED 53 37 03 0116*       ld (ude),de ; dy
       04          
0421C7 3A 39 03 04 0117*       ld a,(ude+2) ; deu
0421CB 17          0118*       rla ; shift sign bit into carry
0421CC D2 F4 21 04 0119*       jp nc,@zig_zag ; player is below,evade
0421D0             0120*   ; player is even or above,so home in on current heading
0421D0 FD 2F 10    0121*       ld (iy+sprite_heading),hl ; save sprite heading
0421D3             0122*   ; fall through to @compute_velocities
0421D3             0123*   @compute_velocities:
0421D3 CD FE 82 04 0124*       call sprite_compute_velocities
0421D7 CD 5D 82 04 0125*       call move_sprite ; move the sprite
0421DB B7          0126*       or a ; a will be non-zero if have collided with screen edge
0421DC C2 FF 21 04 0127*       jp nz,@zag_switch ; switch direction
0421E0 C3 81 21 04 0128*       jp move_enemy_seeker ; didn't hit an edge so check collisions and move sprite
0421E4             0129*   @zig_zag_start:
0421E4 FD 2A 98 80 0130*       ld iy,(table_pointer)
       04          
0421E9 CD 14 05 04 0131*       call rand_8
0421ED E6 3F       0132*       and %00111111 ; limit it to 64
0421EF CB DF       0133*       set 3,a ; make sure it's at least 8
0421F1 FD 77 24    0134*       ld (iy+sprite_move_timer),a ; store it
0421F4             0135*       ; fall through to @zig_zag
0421F4             0136*   @zig_zag:
0421F4 FD 7E 24    0137*       ld a,(iy+sprite_move_timer)
0421F7 3D          0138*       dec a
0421F8 FD 77 24    0139*       ld (iy+sprite_move_timer),a
0421FB C2 21 22 04 0140*       jp nz,@zig_zag_no_switch
0421FF             0141*   @zag_switch:
0421FF             0142*       ; otherwise flip direction and restart timer
0421FF FD 7E 25    0143*       ld a,(iy+sprite_move_step)
042202 EE 01       0144*       xor %1 ; flips bit zero
042204 FD 77 25    0145*       ld (iy+sprite_move_step),a ; store it
042207 C2 16 22 04 0146*       jp nz,@F ; zag right
04220B             0147*   ;otherwise zag left
04220B 21 00 A0 00 0148*       ld hl,160*256; southwest heading
04220F FD 2F 10    0149*       ld (iy+sprite_heading),hl ; save sprite heading
042212 C3 E4 21 04 0150*       jp @zig_zag_start
042216             0151*   @@: ; zag right
042216 21 00 60 00 0152*       ld hl,96*256; southeast heading
04221A FD 2F 10    0153*       ld (iy+sprite_heading),hl ; save sprite heading
04221D C3 E4 21 04 0154*       jp @zig_zag_start
042221             0155*   @zig_zag_no_switch:
042221             0156*       ; ld a,(sprite_orientation)
042221 FD 27 10    0157*       ld hl,(iy+sprite_heading)
042224 C3 D3 21 04 0158*       jp @compute_velocities
042228             0159*   ; end en_nav_seek_zag
