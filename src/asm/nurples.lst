044F6E DD 22 BA 8B 0127*       ld (tiles_row_defs),ix
       04          
044F73             0128*   ; reset tile rows and plot coordinates
044F73 21 FF FF FF 0129*       ld hl,-1
044F77 22 EB 8C 04 0130*       ld (bg_y_plot),hl
044F7B 23          0131*       inc hl
044F7C 22 C6 8B 04 0132*       ld (tiles_x_plot),hl
044F80 21 F1 FF FF 0133*       ld hl,-15
044F84 22 CA 8B 04 0134*       ld (tiles_y_plot),hl
