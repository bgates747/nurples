041030 0B          0065*       dec bc
041031 79          0066*       ld a,c
041032 B7          0067*       or a
041033 C2 06 10 04 0068*       jp nz,img_load_main
041037 78          0069*       ld a,b
041038 B7          0070*       or a
041039 C2 06 10 04 0071*       jp nz,img_load_main
04103D C9          0072*       ret
