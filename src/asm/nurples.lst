047B8A 01          0009*       db 1                    ; num_animations
047B8B 00          0010*       db 0                    ; animation
047B8C 10          0011*       db 16                   ; animation_timer
047B8D 00          0012*       db 0                    ; move_timer
047B8E 00          0013*       db 0                    ; move_step
047B8F 05          0014*       db 5                    ; points
