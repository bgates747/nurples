041419 01 03 00 00 0130*   	ld bc,@end-@cmd
04141D 5B DF       0131*   	rst.lil $18
04141F C9          0132*   	ret
041420 12          0133*   @cmd:  db 18
041421 00          0134*   @mode: db 0
041422 00          0135*   @col:  db 0
041423             0136*   @end:
041423             0137*   
041423             0138*   
041423             0139*   ; VDU 28, left, bottom, right, top: Set text viewport **
041423             0140*   ; MIND THE LITTLE-ENDIANESS
041423             0141*   ; inputs: c=left,b=bottom,e=right,d=top
041423             0142*   ; outputs; nothing
041423             0143*   ; destroys: a might make it out alive
041423             0144*   vdu_set_txt_viewport:
041423 ED 43 39 14 0145*       ld (@lb),bc
       04          
041428 ED 53 3B 14 0146*   	ld (@rt),de
       04          
04142D 21 38 14 04 0147*   	ld hl,@cmd
041431 01 05 00 00 0148*   	ld bc,@end-@cmd
041435 5B DF       0149*   	rst.lil $18
041437 C9          0150*   	ret
041438 1C          0151*   @cmd:   db 28 ; set text viewport command
041439 00 00       0152*   @lb: 	dw 0x0000 ; set by bc
04143B 00 00       0153*   @rt: 	dw 0x0000 ; set by de
04143D 00          0154*   @end:   db 0x00	  ; padding
04143E             0155*   
04143E             0156*   ; VDP query/timing fault bits
04143E             0157*   vdu_timing_fault_vblank_timeout: equ 0
04143E             0158*   vdu_timing_fault_colour_query:  equ 1
04143E 00          0159*   vdu_timing_fault_flags: db 0
04143F             0160*   
04143F             0161*   ; VDU 23, 0, &94, n: Read a current text colour through the MOS screen-pixel
04143F             0162*   ; result packet.
04143F             0163*   ; inputs:  a = 128 for text foreground, 129 for text background
04143F             0164*   ; outputs: carry set and a = logical colour 0..63 on success
04143F             0165*   ;          carry clear on timeout or an invalid response
04143F             0166*   ; preserves: bc, de, hl, ix
04143F             0167*   vdu_get_text_colour:
04143F C5          0168*       push bc
041440 D5          0169*       push de
041441 E5          0170*       push hl
041442 DD E5       0171*       push ix
041444 F5          0172*       push af
041445             0173*       MOSCALL mos_sysvars
                       M1 Args: function=mos_sysvars 
041445 3E 08       0001*M1 			LD	A, function
041447 5B CF       0002*M1 			RST.LIL	08h
041449 F1          0174*       pop af
04144A 6F          0175*       ld l,a
04144B DD CB 04 96 0176*       res 2,(ix+sysvar_vpd_pflags)
04144F 3E 17       0177*       ld a,23
041451 5B D7       0178*       rst.lil $10
041453 AF          0179*       xor a
041454 5B D7       0180*       rst.lil $10
041456 3E 94       0181*       ld a,$94
041458 5B D7       0182*       rst.lil $10
04145A 7D          0183*       ld a,l
04145B 5B D7       0184*       rst.lil $10
04145D 01 00 00 00 0185*       ld bc,0 ; at most 65,536 polls; never hang during process entry
041461             0186*   @wait:
041461 DD CB 04 56 0187*       bit 2,(ix+sysvar_vpd_pflags)
041465 C2 74 14 04 0188*       jp nz,@received
041469 0D          0189*       dec c
04146A C2 61 14 04 0190*       jp nz,@wait
04146E 10 F1       0191*       djnz @wait
041470 C3 7D 14 04 0192*       jp @failed
041474             0193*   @received:
041474 DD 7E 16    0194*       ld a,(ix+sysvar_scrpixelIndex)
041477 FE 40       0195*       cp 64
041479 DA 88 14 04 0196*       jp c,@success
04147D             0197*   @failed:
04147D 21 3E 14 04 0198*       ld hl,vdu_timing_fault_flags
041481 CB CE       0199*       set vdu_timing_fault_colour_query,(hl)
041483 AF          0200*       xor a ; deterministic failure value and carry clear
041484 C3 89 14 04 0201*       jp @done
041488             0202*   @success:
041488 37          0203*       scf
041489             0204*   @done:
041489 DD E1       0205*       pop ix
04148B E1          0206*       pop hl
04148C D1          0207*       pop de
04148D C1          0208*       pop bc
04148E C9          0209*       ret
04148F             0210*   ; end vdu_get_text_colour
04148F             0211*   
04148F             0212*   ; Wait for VBLANK interrupt
04148F             0213*   vdu_vblank:
04148F C5          0214*       push bc
041490 D5          0215*       push de
041491 DD E5       0216*       push ix
041493             0217*   	MOSCALL	mos_sysvars
                       M1 Args: function=mos_sysvars 
041493 3E 08       0001*M1 			LD	A, function
041495 5B CF       0002*M1 			RST.LIL	08h
041497 DD 5E 00    0218*       ld e,(ix+sysvar_time+0)
04149A 01 00 00 00 0219*       ld bc,0 ; 65,536 polls before failing open
04149E             0220*   @wait:
04149E DD 7E 00    0221*       ld a,(ix+sysvar_time+0)
0414A1 BB          0222*       cp e
0414A2 C2 B7 14 04 0223*       jp nz,@done
0414A6 0D          0224*       dec c
0414A7 C2 9E 14 04 0225*       jp nz,@wait
0414AB 10 F1       0226*       djnz @wait
0414AD 3A 3E 14 04 0227*       ld a,(vdu_timing_fault_flags)
0414B1 F6 01       0228*       or %00000001
0414B3 32 3E 14 04 0229*       ld (vdu_timing_fault_flags),a
0414B7             0230*   @done:
0414B7 DD E1       0231*       pop ix
0414B9 D1          0232*       pop de
0414BA C1          0233*       pop bc
0414BB C9          0234*       RET
