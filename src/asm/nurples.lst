048DA2             0156*   draw_active_tile:
048DA2 FD 27 17    0157*       ld hl,(iy+tile_base_bufferId)
048DA5 FD 7E 28    0158*       ld a,(iy+tile_frame)
048DA8 85          0159*       add a,l ; TODO: with a little work we could make all tile base buffer ids align to 256
048DA9 6F          0160*       ld l,a
048DAA 3E 00       0161*       ld a,0 ; preserve carry
048DAC 8C          0162*       adc a,h
048DAD 67          0163*       ld h,a
048DAE CD 93 14 04 0164*       call vdu_buff_select ; buffer id of animation frame
048DB2 FD 07 01    0165*       ld bc,(iy+tile_x)
048DB5 FD 17 04    0166*       ld de,(iy+tile_y)
048DB8 CD BF 18 04 0167*       call vdu_plot_bmp168
048DBC C9          0168*       ret
048DBD             0169*   ; end draw_active_tile
048DBD             0170*   
048DBD             0171*   ; create a new sprite at the same location as the current tile
048DBD             0172*   ; inputs: hl = pointer to new sprite default settings, tile_table_pointer = current tile
048DBD             0173*   ;         ix = pointer to sprite group, b = number of records in sprite group
048DBD             0174*   spawn_sprite_from_tile:
048DBD E5          0175*       push hl ; back up pointer to new sprite defaults
048DBE CD 2F 7E 04 0176*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
048DC2 E1          0177*       pop hl ; restore pointer to new sprite defaults
048DC3 D0          0178*       ret nc ; no carry means no free sprite slots, so we go home
048DC4             0179*   ; copy default settings to new sprite
048DC4 DD E5       0180*       push ix ; back up pointer to new sprite record
048DC6 ED 32 16    0181*       lea ix,ix+sprite_definitions ; bump pointer to copy to
048DC9 DD E5       0182*       push ix ; pointer to default sprite settings
048DCB D1          0183*       pop de ; address to copy to
048DCC 01 13 00 00 0184*       ld bc,sprite_definitions_size ; copy only bytes provided by defaults
048DD0 ED B0       0185*       ldir ; copies defaults to new sprite record
048DD2 DD E1       0186*       pop ix ; restore pointer to new sprite record
048DD4             0187*   ; copy sprite position from existing tile
048DD4 FD 2A A9 88 0188*       ld iy,(tile_table_pointer) ; get existing tile record
       04          
048DD9 FD 27 01    0189*       ld hl,(iy+tile_x)
048DDC DD 2F 01    0190*       ld (ix+sprite_x),hl
048DDF FD 27 04    0191*       ld hl,(iy+tile_y)
048DE2 DD 2F 04    0192*       ld (ix+sprite_y),hl
048DE5             0193*   ; clear motion state retained by a previously used physical record
048DE5 21 00 00 00 0194*       ld hl,0
048DE9 DD 2F 07    0195*       ld (ix+sprite_xvel),hl
048DEC DD 2F 0A    0196*       ld (ix+sprite_yvel),hl
048DEF DD 2F 0D    0197*       ld (ix+sprite_vel),hl
048DF2 DD 2F 10    0198*       ld (ix+sprite_heading),hl
048DF5 DD 2F 13    0199*       ld (ix+sprite_orientation),hl
048DF8             0200*   ; return to caller
048DF8 DD CB 16 FE 0201*       set 7,(ix+sprite_type) ; set just spawned flag
048DFC DD CB 1D F6 0202*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
048E00 37          0203*       scf ; set carry flag to indicate success
048E01 C9          0204*       ret
048E02             0205*   ; end spawn_sprite_from_tile
048E02             0206*   
048E02             0207*   ; create a new tile at the same location as the current tile
048E02             0208*   ; inputs: tile_table_pointer = current tile
048E02             0209*   spawn_active_tile_from_tile:
048E02             0210*   ; copy default settings to new tile
048E02 DD 2A A9 88 0211*       ld ix,(tile_table_pointer) ; get existing tile record
       04          
048E07 ED 32 16    0212*       lea ix,ix+tile_definitions ; bump pointer to copy to
048E0A DD E5       0213*       push ix ; pointer to default tile settings
048E0C D1          0214*       pop de ; address to copy to
048E0D 01 13 00 00 0215*       ld bc,tile_definitions_size ; copy only bytes provided by defaults
048E11 ED B0       0216*       ldir ; copies defaults to new tile record
048E13 DD 2A A9 88 0217*       ld ix,(tile_table_pointer) ; restore pointer to new tile record
       04          
048E18 C9          0218*       ret
048E19             0219*   ; end spawn_active_tile_from_tile
