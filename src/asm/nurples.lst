04219E FD 7E 00    0091*       ld a,(iy+sprite_id)
0421A1 CD D7 18 04 0092*       call vdu_sprite_select
0421A5 CD 29 83 04 0093*       call sprite_frame_heading ; a, sprite_frame set to heading-based frame
0421A9 CD 3A 19 04 0094*       call vdu_sprite_select_frame
0421AD C9          0095*       ret
