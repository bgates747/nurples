0410AF             0101*   
0410AF             0102*   move_logo:
0410AF             0103*   ; Snap the last callback to the exact endpoint so fixed-point division
0410AF             0104*   ; remainder cannot accumulate into a visible shortfall.
0410AF 2A 04 10 04 0105*       ld hl,(game_load_remaining)
0410B3 11 00 00 00 0106*       ld de,0
0410B7 B7          0107*       or a
0410B8 ED 52       0108*       sbc hl,de
0410BA 20 06       0109*       jr nz,@accumulate
0410BC 21 00 08 00 0110*       ld hl,logo_y_end
0410C0 18 0A       0111*       jr @position_ready
0410C2             0112*   
0410C2             0113*   @accumulate:
0410C2 2A FB 0F 04 0114*       ld hl,(logo_ypos)
0410C6 ED 5B FE 0F 0115*       ld de,(logo_yvel)
       04          
0410CB 19          0116*       add hl,de
0410CC             0117*   
