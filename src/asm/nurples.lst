0412FA DD 27 00    0347*       ld hl,(ix+sysvar_time)  ; get current time
0412FD 22 12 13 04 0348*       ld (stopwatch_started),hl            ; set start time
041301 C9          0349*       ret
041302             0350*   
041302             0351*   ; gets time elapsed on a stopwatch
