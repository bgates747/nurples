04208A 19          0041*       add hl,de
04208B DD 2F 01    0042*       ld (ix+sprite_x),hl
04208E DD 27 04    0043*       ld hl,(ix+sprite_y)
042091 DD 17 0A    0044*       ld de,(ix+sprite_yvel)
