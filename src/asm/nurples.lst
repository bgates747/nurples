048693             0083    
048693             0084    ; --- MAIN PROGRAM FILE ---
048693             0085    main:
048693             0086    ; start a new game
048693 AF          0087        xor a
048694 32 DF 6A 04 0088        ld (game_exit_requested),a
048698 21 4D 6C 04 0089        ld hl,game_init
04869C 22 DB 6A 04 0090        ld (game_state),hl
0486A0             0091    main_loop:
0486A0             0092    ; update the global timestamp
0486A0 CD BC 12 04 0093        call timestamp_tick
0486A4             0094    ; do gamestate logic
0486A4 CD E0 6A 04 0095        call do_game
0486A8             0096    ; state handlers return through the dispatcher; honor an orderly exit request
0486A8 3A DF 6A 04 0097        ld a,(game_exit_requested)
0486AC B7          0098        or a
0486AD C2 C6 86 04 0099        jp nz,main_end
0486B1             0100    ; wait for the next vblank mitigate flicker and for loop timing
0486B1 CD 27 14 04 0101        call vdu_vblank
0486B5             0102    ; poll keyboard for escape keypress
0486B5 3E 08       0103        ld a, $08 ; code to send to MOS
0486B7 5B CF       0104        rst.lil $08 ; get IX pointer to System Variables
0486B9 DD 7E 05    0105        ld a, (ix + $05) ; get ASCII code of key pressed
0486BC FE 1B       0106        cp 27 ; check if 27 (ascii code for ESC)
0486BE CA C6 86 04 0107        jp z, main_end ; if pressed, jump to exit
0486C2             0108    ; escape not pressed so loop
0486C2 C3 A0 86 04 0109        jp main_loop
0486C6             0110    
0486C6             0111    main_end:
0486C6             0112    ; restore original screen mode
0486C6 3A 4C 6C 04 0113        ld a,(original_screen_mode)
0486CA CD 98 14 04 0114        call vdu_set_screen_mode
0486CE             0115    ; print thanks for playing message
0486CE CD 5C 00 04 0116        call printInline
0486D2 54 68 61 6E 0117        asciz "Thank you for playing\r\n"
       6B 20 79 6F 
       75 20 66 6F 
       72 20 70 6C 
       61 79 69 6E 
       67 0D 0A 00 
0486EA 21 E9 43 04 0118        ld hl,purple_nurples_ascii
0486EE CD 63 00 04 0119        call printString
0486F2 C9          0120        ret
0486F3             0121    ; end main
0486F3             0122    
0486F3             0123    ; needs to be the final include to leave room for the sprite and tile tables
0486F3             0124        include "tables.inc"
0486F3             0001*   ; #### THIS IS THE SPACE ALLOCATED TO THE SPRITE TABLE ####
0486F3             0002*   table_base: equ $
0486F3             0003*   player_weapons_begin: equ table_base
0486F3             0004*   player_lasers_begin: equ player_weapons_begin
0486F3             0005*   player_lasers_end: equ table_record_size*player_lasers_max+player_lasers_begin
0486F3             0006*   player_lasers_end_sprite_id: equ [player_lasers_end-table_base]/table_record_size
0486F3             0007*   player_weapons_end: equ table_record_size*player_lasers_max+player_weapons_begin
0486F3             0008*   player_begin: equ player_weapons_end
0486F3             0009*   player_end: equ table_record_size+player_begin
0486F3             0010*   enemy_sprites_begin: equ player_end
0486F3             0011*   seekers_base: equ enemy_sprites_begin
0486F3             0012*   seeker_min_sprite_id: equ [seekers_base-table_base]/table_record_size
0486F3             0013*   seekers_end: equ table_record_size*seekers_max+seekers_base
0486F3             0014*   seekers_end_sprite_id: equ [seekers_end-table_base]/table_record_size
0486F3             0015*   fireballs_base: equ seekers_end
0486F3             0016*   fireballs_end: equ table_record_size*fireballs_max+fireballs_base
0486F3             0017*   fireballs_end_sprite_id: equ [fireballs_end-table_base]/table_record_size
0486F3             0018*   enemy_sprites_end: equ fireballs_end
0486F3             0019*   explosions_base: equ enemy_sprites_end
0486F3             0020*   explosions_end: equ table_record_size*explosions_max+explosions_base
0486F3             0021*   explosions_end_sprite_id: equ [explosions_end-table_base]/table_record_size
0486F3             0022*   table_end: equ explosions_end
0486F3             0023*   
0486F3             0024*   table_num_records: equ [table_end-table_base]/table_record_size
0486F3             0025*   table_num_enemy_records: equ [enemy_sprites_end-enemy_sprites_begin]/table_record_size
0486F3             0026*   
0486F3             0027*   ; ### THIS IS THE SPACE ALLOCATED TO THE ACTIVE TILES TABLE ###
0486F3             0028*   tile_table_base: equ table_end
0486F3             0029*   tile_table_end: equ 256*tile_table_record_size+tile_table_base
