049C27             0082    ; --- MAIN PROGRAM FILE ---
049C27             0083    main:
049C27             0084    ; start a new game
049C27 AF          0085        xor a
049C28 32 4E 81 04 0086        ld (game_exit_requested),a
049C2C 21 BC 82 04 0087        ld hl,game_init
049C30 22 4A 81 04 0088        ld (game_state),hl
049C34             0089    main_loop:
049C34             0090    ; update the global timestamp
049C34 CD 8B 12 04 0091        call timestamp_tick
049C38             0092    ; do gamestate logic
049C38 CD 4F 81 04 0093        call do_game
049C3C             0094    ; state handlers return through the dispatcher; honor an orderly exit request
049C3C 3A 4E 81 04 0095        ld a,(game_exit_requested)
049C40 B7          0096        or a
049C41 C2 5A 9C 04 0097        jp nz,main_end
049C45             0098    ; wait for the next vblank mitigate flicker and for loop timing
049C45 CD F6 13 04 0099        call vdu_vblank
049C49             0100    ; poll keyboard for escape keypress
049C49 3E 08       0101        ld a, $08 ; code to send to MOS
049C4B 5B CF       0102        rst.lil $08 ; get IX pointer to System Variables
049C4D DD 7E 05    0103        ld a, (ix + $05) ; get ASCII code of key pressed
049C50 FE 1B       0104        cp 27 ; check if 27 (ascii code for ESC)
049C52 CA 5A 9C 04 0105        jp z, main_end ; if pressed, jump to exit
049C56             0106    ; escape not pressed so loop
049C56 C3 34 9C 04 0107        jp main_loop
049C5A             0108    
049C5A             0109    main_end:
049C5A             0110    ; restore original screen mode
049C5A 3A BB 82 04 0111        ld a,(original_screen_mode)
049C5E CD 67 14 04 0112        call vdu_set_screen_mode
049C62             0113    ; print thanks for playing message
049C62 CD 5C 00 04 0114        call printInline
049C66 54 68 61 6E 0115        asciz "Thank you for playing\r\n"
       6B 20 79 6F 
       75 20 66 6F 
       72 20 70 6C 
       61 79 69 6E 
       67 0D 0A 00 
049C7E 21 AE 1A 04 0116        ld hl,purple_nurples_ascii
049C82 CD 63 00 04 0117        call printString
049C86 C9          0118        ret
049C87             0119    ; end main
049C87             0120    
049C87             0121    ; needs to be the final include to leave room for the sprite and tile tables
049C87             0122        include "tables.inc"
049C87             0001*   ; #### THIS IS THE SPACE ALLOCATED TO THE SPRITE TABLE ####
049C87             0002*   table_base: equ $
049C87             0003*   player_weapons_begin: equ table_base
049C87             0004*   player_lasers_begin: equ player_weapons_begin
049C87             0005*   player_lasers_end: equ table_record_size*player_lasers_max+player_lasers_begin
049C87             0006*   player_lasers_end_sprite_id: equ [player_lasers_end-table_base]/table_record_size
049C87             0007*   player_weapons_end: equ table_record_size*player_lasers_max+player_weapons_begin
049C87             0008*   player_begin: equ player_weapons_end
049C87             0009*   player_end: equ table_record_size+player_begin
049C87             0010*   enemy_sprites_begin: equ player_end
049C87             0011*   seekers_base: equ enemy_sprites_begin
049C87             0012*   seeker_min_sprite_id: equ [seekers_base-table_base]/table_record_size
049C87             0013*   seekers_end: equ table_record_size*seekers_max+seekers_base
049C87             0014*   seekers_end_sprite_id: equ [seekers_end-table_base]/table_record_size
049C87             0015*   fireballs_base: equ seekers_end
049C87             0016*   fireballs_end: equ table_record_size*fireballs_max+fireballs_base
049C87             0017*   fireballs_end_sprite_id: equ [fireballs_end-table_base]/table_record_size
049C87             0018*   enemy_sprites_end: equ fireballs_end
049C87             0019*   explosions_base: equ enemy_sprites_end
049C87             0020*   explosions_end: equ table_record_size*explosions_max+explosions_base
049C87             0021*   explosions_end_sprite_id: equ [explosions_end-table_base]/table_record_size
049C87             0022*   table_end: equ explosions_end
049C87             0023*   
049C87             0024*   table_num_records: equ [table_end-table_base]/table_record_size
049C87             0025*   table_num_enemy_records: equ [enemy_sprites_end-enemy_sprites_begin]/table_record_size
049C87             0026*   
049C87             0027*   ; ### THIS IS THE SPACE ALLOCATED TO THE ACTIVE TILES TABLE ###
049C87             0028*   tile_table_base: equ table_end
049C87             0029*   tile_table_end: equ 256*tile_table_record_size+tile_table_base
