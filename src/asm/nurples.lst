044E2C DD 27 04    0123*       ld hl,(ix+4)
044E2F 22 8F 75 04 0124*       ld (cur_baseBufferId),hl
044E33             0125*   ; set tiles_row_defs
044E33 ED 32 07    0126*       lea ix,ix+7 ; ix points to definition of first tile of first row
044E36 DD 22 87 75 0127*       ld (tiles_row_defs),ix
       04          
044E3B             0128*   ; reset tile rows and plot coordinates
044E3B 21 FF FF FF 0129*       ld hl,-1
044E3F 22 AE 76 04 0130*       ld (bg_y_plot),hl
044E43 23          0131*       inc hl
044E44 22 93 75 04 0132*       ld (tiles_x_plot),hl
044E48 21 F1 FF FF 0133*       ld hl,-15
044E4C 22 97 75 04 0134*       ld (tiles_y_plot),hl
