0480AE             0070*   table_init:
0480AE             0071*   ; clear the sprite table
0480AE AF          0072*       xor a ; write zeroes to sprite table
0480AF 21 03 9F 04 0073*       ld hl,table_base ; address to copy from
0480B3 01 00 05 00 0074*       ld bc,table_end-table_base ; number of bytes to clear
0480B7 CD 5F 03 04 0075*       call clear_mem
0480BB             0076*   ; write sprite ids
0480BB DD 21 03 9F 0077*       ld ix,table_base
       04          
0480C0 AF          0078*       xor a ; sprite id
0480C1 0E 00       0079*       ld c,0 ; sprite type
0480C3 06 14       0080*       ld b,table_num_records ; loop counter
0480C5             0081*   @loop:
0480C5 DD 77 00    0082*       ld (ix+sprite_id),a
0480C8 DD 71 16    0083*       ld (ix+sprite_type),c
0480CB ED 32 40    0084*       lea ix,ix+table_record_size
0480CE 3C          0085*       inc a
0480CF 10 F4       0086*       djnz @loop
0480D1 C9          0087*       ret
0480D2             0088*   ; end table_init
