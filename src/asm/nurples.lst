0475BE             0701*   player_dead:
0475BE             0702*   ; decrement lives
0475BE 3A 90 70 04 0703*       ld a,(player_ships)
0475C2 3D          0704*       dec a
0475C3 32 90 70 04 0705*       ld (player_ships),a
0475C7 C2 D2 75 04 0706*       jp nz,@respawn
0475CB             0707*   ; actors publish outcomes; the global playing state owns the phase transition
0475CB 3E 01       0708*       ld a,player_event_game_over
0475CD 32 8B 70 04 0709*       ld (player_event),a
0475D1 C9          0710*       ret
0475D2             0711*   @respawn:
0475D2 3E 01       0712*       ld a,TELEMETRY_LIFECYCLE_RESPAWN
0475D4 CD 40 9E 04 0713*       call telemetry_post_lifecycle
0475D8 CD 92 70 04 0714*       call draw_player_ships
0475DC             0715*   ; Preserve score, terrain position, active tiles and the current enemy world.
0475DC             0716*   ; The player alone begins a fresh logical lifetime and shared entrance.
0475DC CD 09 72 04 0717*       call player_init_respawn
0475E0 DA EB 75 04 0718*       jp c,@player_ready
0475E4             0719*   ; allocation should be impossible after table_init; recover without touching IX
0475E4 3E 01       0720*       ld a,player_event_game_over
0475E6 32 8B 70 04 0721*       ld (player_event),a
0475EA C9          0722*       ret
0475EB             0723*   @player_ready:
0475EB             0724*   ; Keep the enemy scheduler live; individual actors reconcile with the player
0475EB             0725*   ; lifecycle and return from holding behavior when grace expires.
0475EB 21 AD 4A 04 0726*       ld hl,enemies_alive
0475EF 22 4D 4A 04 0727*       ld (enemies_state), hl
0475F3 C9          0728*       ret
0475F4             0729*   ; end player_dead
