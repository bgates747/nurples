048A7F DD 2F 01    0315*       ld (ix+tile_x),hl
048A82 2A 2A 8B 04 0316*       ld hl,(tiles_y_plot-1) ; shift up one byte to get 16.8 fixed point
048A86 DD 2F 04    0317*       ld (ix+tile_y),hl
048A89             0318*   ; set default tile velocities
048A89 21 00 00 00 0319*       ld hl,0
048A8D DD 2F 07    0320*       ld (ix+tile_xvel),hl
048A90 DD 2F 0D    0321*       ld (ix+tile_vel),hl
048A93 DD 2F 10    0322*       ld (ix+tile_heading),hl
048A96 DD 2F 13    0323*       ld (ix+tile_orientation),hl
