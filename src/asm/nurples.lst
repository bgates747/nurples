04403C AF          0863*       xor a
04403D 32 93 1B 04 0864*       ld (agnb_expected_data_size+3),a
044041 C9          0865*       ret
044042             0866*   
044042             0867*   ; Validate the current RGBA2222 DATA size against width * height.
044042             0868*   ; inputs:  normalized IMAG metadata and DATA size in agnb_metadata
044042             0869*   ; outputs: A=0 and Z set on success
044042             0870*   ;          A=agnb_error_data_size and NZ set on mismatch
