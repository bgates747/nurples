044AA4 0E 01 00    0006*       dl BUF_FIREBALL_2_000   ; base_bufferId
044AA7 F5 4A 04    0007*       dl move_enemy_fireball  ; move_program
044AAA 40          0008*       db %01000000            ; collisions bit 6 signals sprite alive
044AAB 10          0009*       db 16                   ; dim_x
044AAC 10          0010*       db 16                   ; dim_y
044AAD 20          0011*       db 32                   ; num_orientations
044AAE 02          0012*       db 2                    ; num_animations
044AAF 00          0013*       db 0                    ; animation
044AB0 08          0014*       db 8                    ; animation_timer
044AB1 00          0015*       db 0                    ; move_timer
044AB2 00          0016*       db 0                    ; move_step
044AB3 00          0017*       db 0                    ; points
