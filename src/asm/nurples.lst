045F21             0061        include "player_state.inc"
045F21             0001*   player_defaults:
045F21 05          0002*       db player               ; type
045F22 73 01 00    0003*       dl BUF_SHIP_0L          ; base_bufferId
045F25 8B 5F 04    0004*       dl do_player            ; move_program
045F28 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
045F29 10          0006*       db 16                   ; dim_x
045F2A 10          0007*       db 16                   ; dim_y
045F2B 01          0008*       db 1                    ; num_orientations
045F2C 01          0009*       db 1                    ; num_animations
045F2D 00          0010*       db 0                    ; animation
045F2E 00          0011*       db 0                    ; animation_timer
045F2F 00          0012*       db 0                    ; move_timer
045F30 00          0013*       db 0                    ; move_step
045F31 00          0014*       db 0                    ; points
045F32 00          0015*       db 0                    ; shield_damage
045F33 00          0016*       db 0                    ; frame
045F34             0017*   
045F34 5B 60 04    0018*   player_state:  dl player_alive
045F37             0019*   player_event_none: equ 0
045F37             0020*   player_event_game_over: equ 1
045F37 00          0021*   player_event: db player_event_none
045F38             0022*   player_fault_bad_state: equ 0
045F38 00          0023*   player_fault_flags: db 0 ; latched fail-closed diagnostics
045F39 00          0024*   player_ships: db 0
045F3A 03          0025*   player_ships_max: db 3
045F3B             0026*   player_speed: equ 3*256 ; pixels per frame 16.8 fixed
045F3B             0027*   
045F3B             0028*   draw_player_ships:
045F3B             0029*   ; activate mfd
045F3B DD 21 B8 61 0030*       ld ix,mfd_ships
       04          
045F40 CD BF 62 04 0031*       call mfd_activate
045F44             0032*   ; blank out previously drawn ships
045F44 AF          0033*       xor a ; color mode 0
045F45 0E 00       0034*       ld c,c_black
045F47 CD F4 13 04 0035*       call vdu_gcol
045F4B 01 00 00 00 0036*       ld bc,0
045F4F 11 00 00 00 0037*       ld de,0
045F53 DD 21 4F 00 0038*       ld ix,0+79
       00          
045F58 FD 21 0F 00 0039*       ld iy,0+15
       00          
045F5D CD 37 19 04 0040*       call vdu_plot_rf
045F61             0041*   ; draw the ships remaining
045F61 21 2B 00 00 0042*       ld hl,BUF_SHIP_MFD
045F65 CD C4 14 04 0043*       call vdu_buff_select
045F69 3A 39 5F 04 0044*       ld a,(player_ships) ; loop counter
045F6D 01 00 00 00 0045*       ld bc,0 ; starting x-coordinate
045F71             0046*   @loop:
045F71 3D          0047*       dec a ; we don't count the ship we're flying
045F72 C8          0048*       ret z
045F73 F5          0049*       push af ; back up loop counter
045F74 C5          0050*       push bc ; save x-coordinate
045F75 11 00 00 00 0051*       ld de,0 ; y-coordinate
045F79 CD FA 18 04 0052*       call vdu_plot_bmp
045F7D C1          0053*       pop bc ; restore x-coordinate
045F7E 21 10 00 00 0054*       ld hl,16 ; bump x-coords
045F82 09          0055*       add hl,bc
045F83 E5          0056*       push hl
045F84 C1          0057*       pop bc ; bc = new x-coordinate
045F85 F1          0058*       pop af
045F86 C3 71 5F 04 0059*       jp @loop
045F8A C9          0060*       ret
045F8B             0061*   ; end draw_player_ships
045F8B             0062*   
045F8B             0063*   do_player:
045F8B 2A 34 5F 04 0064*       ld hl,(player_state)
045F8F CD AB 5F 04 0065*       call player_state_pointer_valid
045F93 DA A4 5F 04 0066*       jp c,@dispatch
045F97 21 38 5F 04 0067*       ld hl,player_fault_flags
045F9B CB C6       0068*       set player_fault_bad_state,(hl)
045F9D 3E 01       0069*       ld a,player_event_game_over
045F9F 32 37 5F 04 0070*       ld (player_event),a
045FA3 C9          0071*       ret
045FA4             0072*   @dispatch:
045FA4             0073*       CALL_HL
                       M1 Args: none
045FA4 01 AA 5F 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
045FA8 C5          0002*M1     push bc ; which constitutes the return address
045FA9 E9          0003*M1     jp (hl) ; Jump to the address in HL
045FAA C9          0074*       ret
045FAB             0075*   ; end do_player
045FAB             0076*   
045FAB             0077*   ; Exact stabilization whitelist for writable legacy player-state pointers.
045FAB             0078*   ; Invalid actor state is surfaced as an event for the global coordinator.
045FAB             0079*   player_state_pointer_valid:
045FAB 11 5B 60 04 0080*       ld de,player_alive
045FAF CD D3 5F 04 0081*       call @matches
045FB3 CA D1 5F 04 0082*       jp z,@valid
