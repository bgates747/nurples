0407F0             0460*   ; atan2_(ub.c,ud.e) --> uh.l
0407F0             0461*   ; inputs: ub.c and ud.e are dx and dy in 16.8 fixed format
0407F0             0462*   ;   whether inputs are integers or fractional doesn't matter
0407F0             0463*   ;   so long as the sign bit of the upper byte is correct
0407F0             0464*   ; output: uh.l is the 16.8 fixed angle in degrees 256
0407F0             0465*   ; angles are COMPASS HEADINGS based on
0407F0             0466*   ; screen coordinate conventions,where the y axis is flipped
0407F0             0467*   ; #E0 224      0       32 #20
0407F0             0468*   ;        -x,-y | +x,-y
0407F0             0469*   ; #C0 192------+------ 64 #40
