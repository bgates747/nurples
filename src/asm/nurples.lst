044AB6             0021*   enemy_spawn_fireball:
044AB6 21 A3 4A 04 0022*       ld hl,fireball_defaults
044ABA DD 21 D8 8F 0023*       ld ix,fireballs_base
       04          
044ABF 06 04       0024*       ld b,fireballs_max
044AC1 CD 78 79 04 0025*       call spawn_sprite_from_tile
044AC5 D0          0026*       ret nc ; no carry means no free sprite slots, so we go home
044AC6             0027*   ; other specific initialization
044AC6             0028*   ; ------------------------------------------------
044AC6             0029*   ; copy sprite heading and component velocities from targeting_computer
044AC6 2A 7E 70 04 0030*       ld hl,(Bearing_t)
044ACA 11 00 80 00 0031*       ld de,128*256 ; rotate 128 degrees
044ACE 19          0032*       add hl,de
044ACF DD 2F 10    0033*       ld (ix+sprite_heading),hl
044AD2 2A 87 70 04 0034*       ld hl,(Vp_x)
044AD6 DD 2F 07    0035*       ld (ix+sprite_xvel),hl
044AD9 2A 8A 70 04 0036*       ld hl,(Vp_y)
044ADD DD 2F 0A    0037*       ld (ix+sprite_yvel),hl
044AE0             0038*   ; move projectile one frame's distance so it isn't drawn right over turret
044AE0 DD 27 01    0039*       ld hl,(ix+sprite_x)
044AE3 DD 17 07    0040*       ld de,(ix+sprite_xvel)
044AE6 19          0041*       add hl,de
044AE7 DD 2F 01    0042*       ld (ix+sprite_x),hl
044AEA DD 27 04    0043*       ld hl,(ix+sprite_y)
044AED DD 17 0A    0044*       ld de,(ix+sprite_yvel)
044AF0 19          0045*       add hl,de
044AF1 DD 2F 04    0046*       ld (ix+sprite_y),hl
044AF4 C9          0047*       ret
