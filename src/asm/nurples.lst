047274 CD 03 1A 04 0337*       call vdu_sprite_select
047278 CD 16 1A 04 0338*       call vdu_sprite_clear_frames
04727C 21 73 01 00 0339*       ld hl,BUF_SHIP_0L
047280 CD 58 1B 04 0340*       call vdu_sprite_add_buff
047284 21 74 01 00 0341*       ld hl,BUF_SHIP_1C
047288 CD 58 1B 04 0342*       call vdu_sprite_add_buff
04728C 21 75 01 00 0343*       ld hl,BUF_SHIP_2R
047290 CD 58 1B 04 0344*       call vdu_sprite_add_buff
047294             0345*   @draw:
047294 01 00 08 00 0346*       ld bc,player_entry_start_x*256
