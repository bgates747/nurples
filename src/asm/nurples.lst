048207             0074*   table_init:
048207             0075*   ; clear the sprite table
048207 AF          0076*       xor a ; write zeroes to sprite table
048208 32 E5 81 04 0077*       ld (sprite_fault_flags),a
04820C 21 23 A1 04 0078*       ld hl,table_base ; address to copy from
048210 01 00 05 00 0079*       ld bc,table_end-table_base ; number of bytes to clear
048214 CD 5B 03 04 0080*       call clear_mem
048218             0081*   ; write sprite ids
048218 DD 21 23 A1 0082*       ld ix,table_base
       04          
04821D AF          0083*       xor a ; sprite id
04821E 0E 00       0084*       ld c,0 ; sprite type
048220 06 14       0085*       ld b,table_num_records ; loop counter
048222             0086*   @loop:
048222 DD 77 00    0087*       ld (ix+sprite_id),a
048225 DD 71 16    0088*       ld (ix+sprite_type),c
048228 ED 32 40    0089*       lea ix,ix+table_record_size
04822B 3C          0090*       inc a
04822C 10 F4       0091*       djnz @loop
04822E C9          0092*       ret
04822F             0093*   ; end table_init
04822F             0094*   
04822F             0095*   ; Validate a record pointer and its stable identity byte against the physical
04822F             0096*   ; 64-byte slot it occupies in the sprite table.
04822F             0097*   ; inputs: iy = candidate sprite record
04822F             0098*   ; outputs: carry set only for an aligned in-range pointer with the expected id
04822F             0099*   ; destroys: a,de,hl
04822F             0100*   sprite_table_record_pointer_valid:
04822F FD E5       0101*       push iy
048231 E1          0102*       pop hl
048232 11 23 A1 04 0103*       ld de,table_base
048236 B7          0104*       or a
048237 ED 52       0105*       sbc hl,de ; offset from the sprite-table base
048239 DA 63 82 04 0106*       jp c,@invalid
04823D 11 00 05 00 0107*       ld de,table_end-table_base
048241 B7          0108*       or a
048242 ED 52       0109*       sbc hl,de
048244 D2 63 82 04 0110*       jp nc,@invalid
048248 19          0111*       add hl,de ; restore the in-range offset
048249 7D          0112*       ld a,l
04824A E6 3F       0113*       and table_record_size-1
04824C C2 63 82 04 0114*       jp nz,@invalid
048250             0115*   ; Convert the aligned offset to its record id: H*4 + L/64.
048250 7C          0116*       ld a,h
048251 87          0117*       add a,a
048252 87          0118*       add a,a
048253 57          0119*       ld d,a
048254 7D          0120*       ld a,l
048255 07          0121*       rlca
048256 07          0122*       rlca
048257 E6 03       0123*       and %00000011
048259 B2          0124*       or d
04825A FD BE 00    0125*       cp (iy+sprite_id)
04825D C2 63 82 04 0126*       jp nz,@invalid
048261 37          0127*       scf
048262 C9          0128*       ret
048263             0129*   @invalid:
048263 AF          0130*       xor a
048264 C9          0131*       ret
048265             0132*   ; end sprite_table_record_pointer_valid
048265             0133*   
048265             0134*   ; deactivate the sprite with the given id
048265             0135*   ; inputs: iy set to sprite record
048265             0136*   ; outputs: nothing
048265             0137*   ; destroys: a,de,hl
048265             0138*   table_deactivate_sprite:
048265 CD 2F 82 04 0139*       call sprite_table_record_pointer_valid
048269 D2 85 82 04 0140*       jp nc,@invalid
04826D FD 7E 00    0141*       ld a,(iy+sprite_id) ; get spriteId
048270 FD E5       0142*       push iy
048272 CD 44 19 04 0143*       call vdu_sprite_select ; select sprite
048276 CD C8 19 04 0144*       call vdu_sprite_hide
04827A FD E1       0145*       pop iy
04827C FD CB 1D B6 0146*       res sprite_alive,(iy+sprite_collisions)
048280 FD CB 1D BE 0147*       res sprite_just_died,(iy+sprite_collisions)
048284 C9          0148*       ret
048285             0149*   @invalid:
048285 21 E5 81 04 0150*       ld hl,sprite_fault_flags
048289 CB C6       0151*       set sprite_fault_bad_record,(hl)
04828B C9          0152*       ret
04828C             0153*   ; end table_deactivate_sprite
04828C             0154*   
04828C             0155*   sprites_init:
04828C             0156*   ; initialize sprites
04828C CD 78 1A 04 0157*   	call vdu_sprite_reset ; clear sprite data in vdp
048290 AF          0158*   	xor a ; loop counter / sprite id
048291             0159*   @sprite_loop:
048291 F5          0160*   	push af ; save loop counter / sprite id
048292 CD 44 19 04 0161*   	call vdu_sprite_select
048296 21 00 01 00 0162*   	ld hl,BUF_CRATER_0 ; can be anything, but why not a smoking hole in the ground?
04829A CD 99 1A 04 0163*   	call vdu_sprite_add_buff
04829E F1          0164*   	pop af ; restore loop counter / sprite id
04829F 3C          0165*       inc a
0482A0 FE 14       0166*       cp table_num_records
0482A2 C2 91 82 04 0167*       jp nz,@sprite_loop
0482A6 CD 78 19 04 0168*   	call vdu_sprite_activate
0482AA             0169*   
