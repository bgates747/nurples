0469FD 32 E0 66 04 0479*       ld (sprite_screen_edge),a
046A01             0480*   ; y-axis first since we already have it in hl
046A01 11 00 00 00 0481*       ld de,-sprite_top*256
046A05 ED 5A       0482*       adc hl,de
046A07 FA 31 6A 04 0483*       jp m,@top
