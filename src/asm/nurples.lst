041777             0041        include "vdu_buffered_api.inc"
041777             0001*   ; https://agonconsole8.github.io/agon-docs/vdp/Buffered-Commands-API/
041777             0002*   
041777             0003*   ; Command 0: Write block to a buffer
041777             0004*   ; VDU 23, 0, &A0, bufferId; 0, length; <buffer-data>
041777             0005*   ; inputs: hl = bufferId, bc = length of data, de = pointer to data
041777             0006*   vdu_write_block_to_buffer:
041777             0007*   ; back up input parameters
041777 D5          0008*       push de ; pointer to data
041778 C5          0009*       push bc ; length of data
041779             0010*   ; set up the vdu command string
041779 22 99 17 04 0011*       ld (@bufferId),hl
04177D ED 43 9C 17 0012*       ld (@length),bc
       04          
041782 AF          0013*       xor a ; load buffer
041783 32 9B 17 04 0014*       ld (@bufferId+2),a
041787 21 96 17 04 0015*       ld hl,@cmd0
04178B 01 08 00 00 0016*       ld bc,@end0-@cmd0
04178F 5B DF       0017*       rst.lil $18
041791             0018*   ; send the buffer data
041791 C1          0019*       pop bc ; length of data
041792 E1          0020*       pop hl ; pointer to data (was de)
041793 5B DF       0021*       rst.lil $18 ; send it
041795 C9          0022*       ret
041796             0023*   ; command string data
041796 17 00 A0    0024*   @cmd0:      db 23,0,0xA0
041799 00 00       0025*   @bufferId:	dw 0x0000
04179B 00          0026*               db 0 ; load buffer
04179C 00 00       0027*   @length:	dw 0x0000
04179E 00          0028*   @end0:      db 0x00 ; padding
04179F             0029*   ; end vdu_write_block_to_buffer
04179F             0030*   
04179F             0031*   ; Command 1: Call a buffer
04179F             0032*   ; VDU 23, 0, &A0, bufferId; 1
04179F             0033*   ; inputs: hl = bufferId
04179F             0034*   vdu_call_buffer:
04179F 22 B7 17 04 0035*       ld (@bufferId),hl
0417A3 3E 01       0036*       ld a,1 ; call buffer
0417A5 32 B9 17 04 0037*       ld (@bufferId+2),a
0417A9 21 B4 17 04 0038*       ld hl,@cmd
0417AD 01 06 00 00 0039*       ld bc,@end-@cmd
0417B1 5B DF       0040*       rst.lil $18
0417B3 C9          0041*       ret
0417B4 17 00 A0    0042*   @cmd:     db 23,0,0xA0
0417B7 00 00       0043*   @bufferId: dw 0x0000
0417B9 01          0044*              db 1 ; call buffer
0417BA             0045*   @end:
0417BA             0046*   ; end vdu_call_buffer
0417BA             0047*   
0417BA             0048*   ; Command 2: Clear a buffer
0417BA             0049*   ; VDU 23, 0 &A0, bufferId; 2
0417BA             0050*   ; inputs: hl = bufferId
0417BA             0051*   vdu_clear_buffer:
0417BA 22 D2 17 04 0052*       ld (@bufferId),hl
0417BE 3E 02       0053*       ld a,2 ; clear buffer
0417C0 32 D4 17 04 0054*       ld (@bufferId+2),a
0417C4 21 CF 17 04 0055*       ld hl,@cmd
0417C8 01 06 00 00 0056*       ld bc,@end-@cmd
0417CC 5B DF       0057*       rst.lil $18
0417CE C9          0058*       ret
0417CF 17 00 A0    0059*   @cmd:     db 23,0,0xA0
0417D2 00 00       0060*   @bufferId: dw 0x0000
0417D4 02          0061*              db 2 ; clear buffer
0417D5             0062*   @end:
0417D5             0063*   ; end vdu_clear_buffer
0417D5             0064*   
0417D5             0065*   ; Clear all buffers
0417D5             0066*   ; inputs: none
0417D5             0067*   vdu_clear_all_buffers:
0417D5             0068*   ; clear all buffers
0417D5 21 E0 17 04 0069*       ld hl,@beg
0417D9 01 06 00 00 0070*       ld bc,@end-@beg
0417DD 5B DF       0071*       rst.lil $18
0417DF C9          0072*       ret
0417E0 17 00 A0    0073*   @beg: db 23,0,$A0
0417E3 FF FF       0074*         dw -1 ; bufferId -1 (65535) means clear all buffers
0417E5 02          0075*         db 2  ; command 2: clear a buffer
0417E6             0076*   @end:
0417E6             0077*   ; end vdu_clear_all_buffers
0417E6             0078*   
0417E6             0079*   ; Command 3: Create a writeable buffer
0417E6             0080*   ; VDU 23, 0 &A0, bufferId; 3, length;
0417E6             0081*   ; inputs: hl = bufferId, bc = length
0417E6             0082*   vdu_create_writeable_buffer:
0417E6 22 03 18 04 0083*       ld (@bufferId),hl
0417EA ED 43 06 18 0084*       ld (@length),bc
       04          
0417EF 3E 03       0085*       ld a,3 ; create writeable buffer
0417F1 32 05 18 04 0086*       ld (@bufferId+2),a
0417F5 21 00 18 04 0087*       ld hl,@cmd
0417F9 01 08 00 00 0088*       ld bc,@end-@cmd
0417FD 5B DF       0089*       rst.lil $18
0417FF C9          0090*       ret
041800 17 00 A0    0091*   @cmd:     db 23,0,0xA0
041803 00 00       0092*   @bufferId: dw 0x0000
041805 03          0093*              db 3 ; create writeable buffer
041806 00 00       0094*   @length: dw 0x0000
041808 00          0095*   @end:     db 0x00 ; padding
041809             0096*   ; end vdu_create_writeable_buffer
041809             0097*   
041809             0098*   ; Command 4: Set output stream to a buffer
041809             0099*   ; VDU 23, 0 &A0, bufferId; 4
041809             0100*   ; inputs: hl = bufferId
041809             0101*   vdu_set_output_stream_buffer:
041809 22 21 18 04 0102*       ld (@bufferId),hl
04180D 3E 04       0103*       ld a,4 ; set output stream to buffer
04180F 32 23 18 04 0104*       ld (@bufferId+2),a
041813 21 1E 18 04 0105*       ld hl,@cmd
041817 01 06 00 00 0106*       ld bc,@end-@cmd
04181B 5B DF       0107*       rst.lil $18
04181D C9          0108*       ret
04181E 17 00 A0    0109*   @cmd:     db 23,0,0xA0
041821 00 00       0110*   @bufferId: dw 0x0000
041823 04          0111*              db 4 ; set output stream to buffer
041824 00          0112*   @end:     db 0x00 ; padding
041825             0113*   ; end vdu_set_output_stream_buffer
041825             0114*   
041825             0115*   ; Command 5: Adjust buffer contents
041825             0116*   ; VDU 23, 0, &A0, bufferId; 5, operation, offset; [count;] <operand>, [arguments]
041825             0117*   vdu_adjust_buffer:
041825 C9          0118*       ret ; TODO: implement
041826             0119*   ; end vdu_adjust_buffer
041826             0120*   
041826             0121*   ; Command 6: Conditionally call a buffer
041826             0122*   ; VDU 23, 0, &A0, bufferId; 6, operation, checkBufferId; checkOffset; [arguments]
041826             0123*   vdu_call_buffer_conditional:
041826 C9          0124*       ret ; TODO: implement
041827             0125*   ; end vdu_call_buffer_conditional
041827             0126*   
041827             0127*   ; Command 7: Jump to a buffer
041827             0128*   ; VDU 23, 0, &A0, bufferId; 7
041827             0129*   ; inputs: hl = bufferId
041827             0130*   vdu_jump_to_buffer:
041827 22 3F 18 04 0131*       ld (@bufferId),hl
04182B 3E 07       0132*       ld a,7 ; jump to buffer
04182D 32 41 18 04 0133*       ld (@bufferId+2),a
041831 21 3C 18 04 0134*       ld hl,@cmd
041835 01 06 00 00 0135*       ld bc,@end-@cmd
041839 5B DF       0136*       rst.lil $18
04183B C9          0137*       ret
04183C 17 00 A0    0138*   @cmd:     db 23,0,0xA0
04183F 00 00       0139*   @bufferId: dw 0x0000
041841 07          0140*              db 7 ; jump to buffer
041842 00          0141*   @end:     db 0x00 ; padding
041843             0142*   ; end vdu_jump_to_buffer
041843             0143*   
041843             0144*   ; Command 8: Conditional Jump to a buffer
041843             0145*   ; VDU 23, 0, &A0, bufferId; 8, operation, checkBufferId; checkOffset; [arguments]
041843             0146*   vdu_jump_to_buffer_conditional:
041843 C9          0147*       ret ; TODO: implement
041844             0148*   ; end vdu_jump_to_buffer_conditional
041844             0149*   
041844             0150*   ; Command 9: Jump to an offset in a buffer
041844             0151*   ; VDU 23, 0, &A0, bufferId; 9, offset; offsetHighByte, [blockNumber;]
041844             0152*   vdu_jump_to_buffer_offset:
041844 C9          0153*       ret ; TODO: implement
041845             0154*   ; end vdu_jump_to_buffer_offset
041845             0155*   
041845             0156*   ; Command 10: Conditional jump to an offset in a buffer
041845             0157*   ; VDU 23, 0, &A0, bufferId; 10, offset; offsetHighByte, [blockNumber;] [arguments]
041845             0158*   vdu_jump_to_buffer_offset_conditional:
041845 C9          0159*       ret ; TODO: implement
041846             0160*   ; end vdu_jump_to_buffer_offset_conditional
041846             0161*   
041846             0162*   ; Command 11: Call buffer with an offset
041846             0163*   ; VDU 23, 0, &A0, bufferId; 11, offset; offsetHighByte, [blockNumber;]
041846             0164*   vdu_call_buffer_offset:
041846 C9          0165*       ret ; TODO: implement
041847             0166*   ; end vdu_call_buffer_offset
