048E00 DD 21 03 A0 0030*       ld ix,player_begin
       04          
048E05 DD CB 1D 76 0031*       bit sprite_alive,(ix+sprite_collisions)
048E09 CA 1D 8E 04 0032*       jp z,@laser ; player is dead so don't check for collisions
048E0D CD 14 20 04 0033*       call check_enemy_collision_player
048E11 C2 1D 8E 04 0034*       jp nz,@laser ; no collision so check laser collision
048E15 CD 37 80 04 0035*       call update_shields
048E19 C3 2A 8E 04 0036*       jp kill_electrode
