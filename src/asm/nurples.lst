044C76             0199*   ; end init_enemy_seekers
044C76             0053        include "explosion.inc"
044C76             0001*   explosions_max: equ 8
044C76             0002*   explosion_animation_count: equ 5
044C76             0003*   explosion_animation_ticks: equ 8
044C76             0004*   ; One update clears the just-spawned flag, then every animation frame runs for
044C76             0005*   ; explosion_animation_ticks updates.
044C76             0006*   explosion_lifetime_updates: equ explosion_animation_count*explosion_animation_ticks+1
044C76             0007*   explosion_defaults:
044C76 04          0008*       db explosion            ; type
044C77 09 01 00    0009*       dl BUF_EXPLOSION_A	    ; base_bufferId
044C7A F3 4C 04    0010*       dl move_explosion	    ; move_program
044C7D 40          0011*       db %01000000            ; collisions bit 6 signals sprite alive
044C7E 07          0012*       db 7	                ; dim_x
044C7F 07          0013*       db 7                    ; dim_y
044C80 01          0014*       db 1                    ; num_orientations
044C81 05          0015*       db explosion_animation_count ; num_animations
044C82 05          0016*       db explosion_animation_count ; animation
044C83 08          0017*       db explosion_animation_ticks ; animation_timer
044C84 00          0018*       db 0	                ; move_timer
044C85 00          0019*       db 0	                ; move_step
044C86 00          0020*       db 0	                ; points
