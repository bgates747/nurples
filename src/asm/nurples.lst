0413C9 DD E1       0158*       POP	IX
0413CB C9          0159*       RET
0413CC             0160*   
0413CC             0161*   ; VDU 29, x; y;: Set graphics origin
0413CC             0162*   ; This command sets the graphics origin.
0413CC             0163*   ; The origin is the point on the screen where the coordinates (0,0) are located.
0413CC             0164*   ; inputs: bc=x0,de=y0
0413CC             0165*   ; outputs; nothing
0413CC             0166*   ; destroys: a might make it out alive
0413CC             0167*   vdu_set_gfx_origin:
0413CC ED 43 E2 13 0168*       ld (@x0),bc
       04          
0413D1 ED 53 E4 13 0169*       ld (@y0),de
       04          
0413D6 21 E1 13 04 0170*       ld hl,@cmd
0413DA 01 05 00 00 0171*       ld bc,@end-@cmd
0413DE 5B DF       0172*       rst.lil $18
0413E0 C9          0173*       ret
0413E1 1D          0174*   @cmd:   db 29 ; set graphics origin command
0413E2 00 00       0175*   @x0: 	dw 0x0000 ; set by bc
0413E4 00 00       0176*   @y0: 	dw 0x0000 ; set by de
0413E6 00          0177*   @end:   db 0x00	  ; padding
0413E7             0178*   
0413E7             0179*   ; VDU 24, left; bottom; right; top;: Set graphics viewport
0413E7             0180*   ; NOTE: the order of the y-coordinate parameters are inverted
0413E7             0181*   ; 	because we have turned off logical screen scaling
0413E7             0182*   ; NOTE: coordinates are relative to current gfx origin
0413E7             0183*   ; inputs: bc=x0,de=y0,ix=x1,iy=y1
0413E7             0184*   ; outputs; nothing
0413E7             0185*   ; destroys: a might make it out alive
0413E7             0186*   vdu_set_gfx_viewport:
0413E7 ED 43 07 14 0187*       ld (@x0),bc
       04          
0413EC FD 22 09 14 0188*       ld (@y1),iy
       04          
0413F1 DD 22 0B 14 0189*   	ld (@x1),ix
       04          
0413F6 ED 53 0D 14 0190*   	ld (@y0),de
       04          
0413FB 21 06 14 04 0191*   	ld hl,@cmd
0413FF 01 09 00 00 0192*   	ld bc,@end-@cmd
041403 5B DF       0193*   	rst.lil $18
041405 C9          0194*   	ret
041406 18          0195*   @cmd:   db 24 ; set graphics viewport command
041407 00 00       0196*   @x0: 	dw 0x0000 ; set by bc
041409 00 00       0197*   @y1: 	dw 0x0000 ; set by iy
04140B 00 00       0198*   @x1: 	dw 0x0000 ; set by ix
04140D 00 00       0199*   @y0: 	dw 0x0000 ; set by de
04140F 00          0200*   @end:   db 0x00	  ; padding
041410             0201*   
041410             0202*   ; SCREEN MODES
041410             0203*   ; ===============================
041410             0204*   ; Mode  Horz  Vert  Cols  Refresh
041410             0205*   ; ---   ----  ----  ----  -------
041410             0206*   ; 11    320   240   2     60hz
041410             0207*   ; 139   320   240   2     60hz
041410             0208*   ; 23    512   384   2     60hz
041410             0209*   ; 151   512   384   2     60hz
041410             0210*   ; 6     640   240   2     60hz
041410             0211*   ; 134   640   240   2     60hz
041410             0212*   ; 2     640   480   2     60hz
041410             0213*   ; 130   640   480   2     60hz
041410             0214*   ; 17    800   600   2     60hz
041410             0215*   ; 145   800   600   2     60hz
041410             0216*   ; 18    1024  768   2     60hz
041410             0217*   ; 146   1024  768   2     60hz
041410             0218*   ; ---   ----  ----  ----  -------
041410             0219*   ; 10    320   240   4     60hz
041410             0220*   ; 138   320   240   4     60hz
041410             0221*   ; 22    512   384   4     60hz
041410             0222*   ; 150   512   384   4     60hz
041410             0223*   ; 5     640   240   4     60hz
041410             0224*   ; 133   640   240   4     60hz
041410             0225*   ; 1     640   480   4     60hz
041410             0226*   ; 129   640   480   4     60hz
041410             0227*   ; 16    800   600   4     60hz
041410             0228*   ; 19    1024  768   4     60hz
041410             0229*   ; ---   ----  ----  ----  -------
041410             0230*   ; 9     320   240   16    60hz
041410             0231*   ; 137   320   240   16    60hz
041410             0232*   ; 21    512   384   16    60hz
041410             0233*   ; 149   512   384   16    60hz
041410             0234*   ; 4     640   240   16    60hz
041410             0235*   ; 132   640   240   16    60hz
041410             0236*   ; 0     640   480   16    60hz
041410             0237*   ; 7     n/a   n/a   16    60hz
041410             0238*   ; ---   ----  ----  ----  -------
041410             0239*   ; 8     320   240   64    60hz
041410             0240*   ; 136   320   240   64    60hz
041410             0241*   ; 20    512   384   64    60hz
041410             0242*   ; 3     640   240   64    60hz
041410             0243*   ; ---   ----  ----  ----  -------
041410             0244*   vdu_set_screen_mode:
041410 32 20 14 04 0245*   	ld (@arg),a
041414 21 1F 14 04 0246*   	ld hl,@cmd
041418 01 02 00 00 0247*   	ld bc,@end-@cmd
04141C 5B DF       0248*   	rst.lil $18
04141E C9          0249*   	ret
04141F 16          0250*   @cmd: db 22 ; set screen mode
041420 00          0251*   @arg: db 0  ; screen mode parameter
041421             0252*   @end:
041421             0253*   
041421             0254*   ; get the current screen mode
041421             0255*   ; inputs: none
041421             0256*   ; outputs: a=screen mode
041421             0257*   ; destroys: af, ix
041421             0258*   vdu_get_screen_mode:
041421             0259*       MOSCALL mos_sysvars
                       M1 Args: function=mos_sysvars 
041421 3E 08       0001*M1 			LD	A, function
041423 5B CF       0002*M1 			RST.LIL	08h
041425 DD 7E 27    0260*       ld a,(IX+sysvar_scrMode)
041428 C9          0261*       ret
041429             0262*   ; end vdu_get_screen_mode
041429             0263*   
041429             0264*   ; VDU 23, 0, &C0, n: Turn logical screen scaling on and off *
041429             0265*   ; inputs: a is scaling mode, 1=on, 0=off
041429             0266*   ; note: default setting on boot is scaling ON
041429             0267*   vdu_set_scaling:
041429 32 3B 14 04 0268*   	ld (@arg),a
04142D 21 38 14 04 0269*   	ld hl,@cmd
041431 01 04 00 00 0270*   	ld bc,@end-@cmd
041435 5B DF       0271*   	rst.lil $18
041437 C9          0272*   	ret
041438 17 00 C0    0273*   @cmd: db 23,0,0xC0
04143B 00          0274*   @arg: db 0  ; scaling on/off
04143C             0275*   @end:
04143C             0276*   
04143C             0277*   ; VDU 23, 27, &20, bufferId; : Select bitmap (using a buffer ID)
04143C             0278*   ; inputs: hl=bufferId
04143C             0279*   vdu_buff_select:
04143C 22 4E 14 04 0280*   	ld (@bufferId),hl
041440 21 4B 14 04 0281*   	ld hl,@cmd
041444 01 05 00 00 0282*   	ld bc,@end-@cmd
041448 5B DF       0283*   	rst.lil $18
04144A C9          0284*   	ret
04144B 17 1B 20    0285*   @cmd: db 23,27,0x20
04144E 00 00       0286*   @bufferId: dw 0x0000
041450 00          0287*   @end: db 0x00 ; padding
041451             0288*   
041451             0289*   ; VDU 23, 27, &21, w; h; format: Create bitmap from selected buffer
041451             0290*   ; inputs: a=format; bc=width; de=height
041451             0291*   ; prerequisites: buffer selected by vdu_bmp_select or vdu_buff_select
041451             0292*   ; formats: https://agonconsole8.github.io/agon-docs/VDP---Bitmaps-API.html
041451             0293*   ; 0 	RGBA8888 (4-bytes per pixel)
041451             0294*   ; 1 	RGBA2222 (1-bytes per pixel)
041451             0295*   ; 2 	Mono/Mask (1-bit per pixel)
041451             0296*   ; 3 	Reserved for internal use by VDP (“native” format)
041451             0297*   vdu_bmp_create:
041451 ED 43 6D 14 0298*       ld (@width),bc
       04          
041456 ED 53 6F 14 0299*       ld (@height),de
       04          
04145B 32 71 14 04 0300*       ld (@fmt),a
04145F 21 6A 14 04 0301*   	ld hl,@cmd
041463 01 08 00 00 0302*   	ld bc,@end-@cmd
041467 5B DF       0303*   	rst.lil $18
041469 C9          0304*   	ret
04146A 17 1B 21    0305*   @cmd:       db 23,27,0x21
04146D 00 00       0306*   @width:     dw 0x0000
04146F 00 00       0307*   @height:    dw 0x0000
041471 00          0308*   @fmt:       db 0x00
041472             0309*   @end:
041472             0310*   
041472             0311*   ; load an rgba2222 image file to a working buffer and make it an rgba8888 bitmap in a target buffer
041472             0312*   ; inputs: bc,de image width,height ; hl = targetBufferId ; ix = file size ; iy = pointer to filename
041472             0313*   vdu_load_img_rgba2_to_8:
041472             0314*   ; backup the target buffer id and image dimensions
041472 E5          0315*       push hl
041473 D5          0316*       push de
041474 C5          0317*       push bc
041475             0318*   ; load the rgba2 image to working buffer 65534
041475 21 FE FF 00 0319*       ld hl,65534 ; temporary working buffer id
041479 CD 50 15 04 0320*   	call vdu_load_buffer_from_file
04147D             0321*   ; restore the image dimensions and target buffer id
04147D C1          0322*       pop bc
04147E D1          0323*       pop de
04147F E1          0324*       pop hl
041480             0325*   ; fall through to vdu_rgba2_to_8
041480             0326*   
041480             0327*   ; https://discord.com/channels/1158535358624039014/1158536711148675072/1257757461729771771
041480             0328*   ; ok, so the "expand bitmap" can be used, when coupled with a "reverse" - the expanded bitmap _doesn't_ come out "right" otherwise, cos of endian-ness
041480             0329*   ; the "expand bitmap" command is:
041480             0330*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
041480             0331*   ; and then to reverse the byte order to fix endian-ness:
041480             0332*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
041480             0333*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
041480             0334*   ; VDU 23,27,&20,targetBufferID%;
041480             0335*   ; VDU 23,27,&21,width%;height%;0
041480             0336*   ; -------------------------------------------------------------------
041480             0337*   ; inputs: bc,de image width,height ; hl = targetBufferId
041480             0338*   ; prerequisites: rgba2 image data loaded into workingBufferId 65534
041480             0339*   vdu_rgba2_to_8:
041480             0340*   ; load the image dimensions and buffer id parameters
041480 ED 43 DC 14 0341*       ld (@width),bc
       04          
041485 ED 53 DE 14 0342*       ld (@height),de
       04          
04148A 22 C1 14 04 0343*       ld (@bufferId0),hl
04148E 22 CE 14 04 0344*       ld (@bufferId2),hl
041492 22 D7 14 04 0345*       ld (@bufferId1),hl
041496             0346*   ; clean up bytes that got stomped on by the ID loads
041496 3E 48       0347*       ld a,0x48
041498 32 C3 14 04 0348*       ld (@bufferId0+2),a
04149C 3E 17       0349*       ld a,23
04149E 32 D9 14 04 0350*       ld (@bufferId1+2),a
0414A2 3E 18       0351*       ld a,24
0414A4 32 D0 14 04 0352*       ld (@bufferId2+2),a
0414A8 AF          0353*       xor a
0414A9 32 E0 14 04 0354*       ld (@height+2),a
0414AD             0355*   ; send the vdu command strings
0414AD 21 B8 14 04 0356*       ld hl,@beg
0414B1 01 29 00 00 0357*       ld bc,@end-@beg
0414B5 5B DF       0358*       rst.lil $18
0414B7 C9          0359*       ret
0414B8             0360*   @beg:
0414B8             0361*   ; Command 14: Consolidate blocks in a buffer
0414B8             0362*   ; VDU 23, 0, &A0, bufferId; 14
0414B8 17 00 A0    0363*       db 23,0,0xA0
0414BB FE FF       0364*       dw 65534 ; workingBufferId
0414BD 0E          0365*       db 14 ; consolidate blocks
0414BE             0366*   ; the "expand bitmap" command is:
0414BE             0367*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
0414BE 17 00 A0    0368*       db 23,0,0xA0
0414C1 00 00       0369*   @bufferId0: dw 0x0000 ; targetBufferId
0414C3 48          0370*       db 0x48 ; given as decimal command 72 in the docs
0414C4 02          0371*       db 2 ; options mask: %00000011 is the number of bits per pixel in the source bitmap
0414C5 FE FF       0372*       dw 65534 ; sourceBufferId
0414C7 00 7F BF FF 0373*       db 0x00,0x7F,0xBF,0xFF ; expanding to bytes by bit-shifting?
0414CB             0374*   ; reverse the byte order to fix endian-ness:
0414CB             0375*   ; Command 24: Reverse the order of data of blocks within a buffer
0414CB             0376*   ; VDU 23, 0, &A0, bufferId; 24, options, [valueSize;] [chunkSize;]
0414CB             0377*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
0414CB 17 00 A0    0378*       db 23,0,0xA0
0414CE 00 00       0379*   @bufferId2:    dw 0x0000 ; targetBufferId
0414D0 18          0380*       db 24 ; reverse byte order
0414D1 04          0381*       db 4 ; option: Reverse data of the value size within chunk of data of the specified size
0414D2 04 00       0382*       dw 4 ; size (4 bytes)
0414D4             0383*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
0414D4             0384*   ; VDU 23,27,&20,targetBufferID%;
0414D4 17 1B 20    0385*       db 23,27,0x20 ; select bitmap
0414D7 00 00       0386*   @bufferId1: dw 0x0000 ; targetBufferId
0414D9             0387*   ; VDU 23,27,&21,width%;height%;0
0414D9 17 1B 21    0388*       db 23,27,0x21 ; create bitmap from buffer
0414DC 00 00       0389*   @width: dw 0x0000
0414DE 00 00       0390*   @height: dw 0x0000
0414E0 00          0391*       db 0x00 ; rgba8888 format
0414E1             0392*   @end:
0414E1             0393*   
0414E1             0394*   ; scratch variables
0414E1 00 00 00    0395*   bufferId0: dl 0x000000
0414E4 00 00 00    0396*   bufferId1: dl 0x000000
0414E7             0397*   
0414E7             0398*   ; load a vdu buffer from local memory
0414E7             0399*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
0414E7             0400*   vdu_load_buffer:
0414E7 ED 43 10 15 0401*       ld (@length),bc
       04          
0414EC D5          0402*       push de ; save data pointer
0414ED             0403*   ; send the vdu command string
0414ED 7D          0404*       ld a,l
0414EE 32 0D 15 04 0405*       ld (@bufferId),a
0414F2 7C          0406*       ld a,h
0414F3 32 0E 15 04 0407*       ld (@bufferId+1),a
0414F7 21 0A 15 04 0408*       ld hl,@cmd
0414FB 01 08 00 00 0409*       ld bc,@end-@cmd
0414FF 5B DF       0410*       rst.lil $18
041501             0411*   ; send the buffer data
041501 E1          0412*       pop hl ; pointer to data
041502 ED 4B 10 15 0413*       ld bc,(@length)
       04          
041507 5B DF       0414*       rst.lil $18 ; send it
041509 C9          0415*       ret
04150A             0416*   ; Upload data :: VDU 23, 0 &A0, bufferId; 0, length; <buffer-data>
04150A 17 00 A0    0417*   @cmd:       db 23,0,0xA0
04150D 00 00       0418*   @bufferId:	dw 0x0000
04150F 00          0419*   		    db 0 ; load buffer
041510 00 00       0420*   @length:	dw 0x0000
041512 00          0421*   @end: db 0 ; padding
041513             0422*   
041513             0423*   ; Command 14: Consolidate blocks in a buffer
041513             0424*   vdu_consolidate_buffer:
041513             0425*   ; set parameters for vdu call
041513 7D          0426*       ld a,l
041514 32 2B 15 04 0427*       ld (@bufferId),a
041518 7C          0428*       ld a,h
041519 32 2C 15 04 0429*       ld (@bufferId+1),a
04151D 21 28 15 04 0430*       ld hl,@beg
041521 01 06 00 00 0431*       ld bc,@end-@beg
041525 5B DF       0432*       rst.lil $18
041527 C9          0433*       ret
041528             0434*   ; VDU 23, 0, &A0, bufferId; 14
041528 17 00 A0    0435*   @beg: db 23,0,0xA0
04152B 00 00       0436*   @bufferId: dw 0x0000
04152D 0E          0437*              db 14
04152E             0438*   @end:
04152E             0439*   
04152E             0440*   ; load an image file to a buffer and make it a bitmap
04152E             0441*   ; inputs: a = image type ; bc,de image width,height ; hl = bufferId ; ix = file size ; iy = pointer to filename
04152E             0442*   vdu_load_img:
04152E             0443*   ; back up image type and dimension parameters
04152E 22 E1 14 04 0444*       ld (bufferId0),hl
041532 F5          0445*       push af
041533 C5          0446*   	push bc
041534 D5          0447*   	push de
041535             0448*   ; load the image
041535 CD 50 15 04 0449*   	call vdu_load_buffer_from_file
041539             0450*   ; now make it a bitmap
041539 2A E1 14 04 0451*       ld hl,(bufferId0)
04153D CD 13 15 04 0452*       call vdu_consolidate_buffer
041541 2A E1 14 04 0453*       ld hl,(bufferId0)
041545 CD 3C 14 04 0454*       call vdu_buff_select
041549 D1          0455*   	pop de ; image height
04154A C1          0456*   	pop bc ; image width
04154B F1          0457*   	pop af ; image type
04154C C3 51 14 04 0458*   	jp vdu_bmp_create ; will return to caller from there
041550             0459*   
041550             0460*   ; inputs: hl = bufferId; iy = pointer to filename
041550             0461*   vdu_load_buffer_from_file:
041550 22 E1 14 04 0462*       ld (bufferId0),hl
041554             0463*   
041554             0464*   ; clear target buffer
041554 CD FC 16 04 0465*       call vdu_clear_buffer
041558             0466*   
041558             0467*   ; open the file in read mode
041558             0468*   ; Open a file
041558             0469*   ; HLU: Filename
041558             0470*   ;   C: Mode
041558             0471*   ; Returns:
041558             0472*   ;   A: Filehandle, or 0 if couldn't open
041558 FD E5       0473*   	push iy ; pointer to filename
04155A E1          0474*   	pop hl
04155B 0E 01       0475*   	ld c,fa_read
04155D             0476*       MOSCALL mos_fopen
                       M1 Args: function=mos_fopen 
04155D 3E 0A       0001*M1 			LD	A, function
04155F 5B CF       0002*M1 			RST.LIL	08h
041561 32 9C 15 04 0477*       ld (@filehandle),a
041565             0478*   
041565             0479*   @read_file:
041565             0480*   ; Read a block of data from a file
041565             0481*   ;   C: Filehandle
041565             0482*   ; HLU: Pointer to where to write the data to
041565             0483*   ; DEU: Number of bytes to read
041565             0484*   ; Returns:
041565             0485*   ; DEU: Number of bytes read
041565 3A 9C 15 04 0486*       ld a,(@filehandle)
041569 4F          0487*       ld c,a
04156A 21 00 E0 B7 0488*       ld hl,filedata
04156E 11 00 20 00 0489*       ld de,8192 ; max we can read into onboard sram at one time
041572             0490*       MOSCALL mos_fread
                       M1 Args: function=mos_fread 
041572 3E 1A       0001*M1 			LD	A, function
041574 5B CF       0002*M1 			RST.LIL	08h
041576             0491*   
041576             0492*   ; test de for zero bytes read
041576 21 00 00 00 0493*       ld hl,0
04157A AF          0494*       xor a ; clear carry
04157B ED 52       0495*       sbc hl,de
04157D CA 93 15 04 0496*       jp z,@close_file
041581             0497*   
041581             0498*   ; load a vdu buffer from local memory
041581             0499*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
041581 2A E1 14 04 0500*       ld hl,(bufferId0)
041585 D5          0501*       push de ; chunksize
041586 C1          0502*       pop bc
041587 11 00 E0 B7 0503*       ld de,filedata
04158B CD E7 14 04 0504*       call vdu_load_buffer
04158F             0505*   
04158F             0506*   ; read the next block
04158F C3 65 15 04 0507*       jp @read_file
041593             0508*   
041593             0509*   ; close the file
041593             0510*   @close_file:
041593 3A 9C 15 04 0511*       ld a,(@filehandle)
041597             0512*       MOSCALL mos_fclose
                       M1 Args: function=mos_fclose 
041597 3E 0B       0001*M1 			LD	A, function
041599 5B CF       0002*M1 			RST.LIL	08h
04159B C9          0513*       ret ; vdu_load_buffer_from_file
04159C             0514*   
04159C 00          0515*   @filehandle: db 0 ; file handle
04159D 00 00 00    0516*   @fil: dl 0 ; pointer to FIL struct
0415A0             0517*   
0415A0 00 00 00    0518*   @chunkpointer: dl 0 ; pointer to current chunk
0415A3             0519*   
0415A3             0520*   ; File information structure (FILINFO)
0415A3             0521*   @filinfo:
0415A3 00 00 00 00 0522*   @filinfo_fsize:    blkb 4, 0   ; File size (4 bytes)
0415A7 00 00       0523*   @filinfo_fdate:    blkb 2, 0   ; Modified date (2 bytes)
0415A9 00 00       0524*   @filinfo_ftime:    blkb 2, 0   ; Modified time (2 bytes)
0415AB 00          0525*   @filinfo_fattrib:  blkb 1, 0   ; File attribute (1 byte)
