0413E2             0086*   ;     VDU 23, 7, extent, direction, speed: Scroll the screen
0413E2             0087*   ; inputs: a, extent; l, direction; h; speed
0413E2             0088*   vdu_scroll_down:
0413E2 32 F7 13 04 0089*   	ld (@extent),a
0413E6 22 F8 13 04 0090*   	ld (@dir),hl ; implicitly populates @speed
0413EA 21 F5 13 04 0091*   	ld hl,@cmd
0413EE 01 05 00 00 0092*   	ld bc,@end-@cmd
0413F2 5B DF       0093*   	rst.lil $18     ;; Sending command to VDP
0413F4 C9          0094*   	ret
0413F5 17 07       0095*   @cmd:       db 23,7
0413F7 00          0096*   @extent:    db 0x00 ; 0 current text window, 1 entire screen, 2 curr gfx viewport
0413F8 00          0097*   @dir:       db 0x00 ; 0 right, 1 left, 2 down, 3 up
0413F9 00          0098*   @speed:     db 0x00 ; pixels
0413FA 00          0099*   @end:		db 0x00 ; padding
0413FB             0100*   
0413FB             0101*   ; COLOUR MODES
0413FB             0102*   ; Mode	Effect
0413FB             0103*   ; 0	Set on-screen pixel to target colour value
0413FB             0104*   ; 1	OR value with the on-screen pixel
0413FB             0105*   ; 2	AND value with the on-screen pixel
0413FB             0106*   ; 3	XOR value with the on-screen pixel
0413FB             0107*   ; 4	Invert the on-screen pixel
0413FB             0108*   ; 5	No operation
0413FB             0109*   ; 6	AND the inverse of the specified colour with the on-screen pixel
0413FB             0110*   ; 7	OR the inverse of the specified colour with the on-screen pixel
0413FB             0111*   
0413FB             0112*   ; VDU 17, colour: Define text colour (COLOUR)
0413FB             0113*   vdu_colour_text:
0413FB 32 0B 14 04 0114*   	ld (@arg),a
