04140A             0206*   ; 11    320   240   2     60hz
04140A             0207*   ; 139   320   240   2     60hz
04140A             0208*   ; 23    512   384   2     60hz
04140A             0209*   ; 151   512   384   2     60hz
04140A             0210*   ; 6     640   240   2     60hz
04140A             0211*   ; 134   640   240   2     60hz
04140A             0212*   ; 2     640   480   2     60hz
04140A             0213*   ; 130   640   480   2     60hz
04140A             0214*   ; 17    800   600   2     60hz
04140A             0215*   ; 145   800   600   2     60hz
04140A             0216*   ; 18    1024  768   2     60hz
04140A             0217*   ; 146   1024  768   2     60hz
04140A             0218*   ; ---   ----  ----  ----  -------
04140A             0219*   ; 10    320   240   4     60hz
04140A             0220*   ; 138   320   240   4     60hz
04140A             0221*   ; 22    512   384   4     60hz
04140A             0222*   ; 150   512   384   4     60hz
04140A             0223*   ; 5     640   240   4     60hz
04140A             0224*   ; 133   640   240   4     60hz
04140A             0225*   ; 1     640   480   4     60hz
04140A             0226*   ; 129   640   480   4     60hz
04140A             0227*   ; 16    800   600   4     60hz
04140A             0228*   ; 19    1024  768   4     60hz
