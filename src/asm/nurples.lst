048DC6 E6 03       0037*       and %00000011 ; modulo 4
048DC8 FD 77 28    0038*       ld (iy+tile_frame),a
048DCB C3 2A 8D 04 0039*       jp draw_active_tile
048DCF             0040*   @make_crater:
