046F94             0143*   ;     call sdiv168 ; ud.e = (Vt*sin(Heading_t-Bearing_t)) / Vp
046F94             0144*   ;     ex de,hl ; uh.l = (Vt*sin(Heading_t-Bearing_t)) / Vp
046F94             0145*   ; ; answer is in radians, convert to degrees256
046F94             0146*   ;     ld de,0x0028BE ; 40.74 = 57.29578*256/360
046F94             0147*   ;     call smul168 ; uh.l = angle in degrees256
