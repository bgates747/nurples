043B9D             0209*   agnb_io_buffer_size:       equ 8192
043B9D             0210*   
043B9D             0211*   ; Application callback invoked after each image has been finalized.
043B9D 00 00 00    0212*   agnb_image_callback:       dl 0
043BA0             0213*   
043BA0             0214*   ; Reader subroutine interface
043BA0             0215*   ; ---------------------------
043BA0             0216*   ; These labels establish the intended decomposition and calling contracts.
043BA0             0217*   ; They deliberately fail with agnb_error_not_implemented until replaced with
043BA0             0218*   ; real code, preventing an incomplete loader from reporting false success.
043BA0             0219*   
043BA0             0220*   ; Compare two FourCC values.
043BA0             0221*   ; inputs:  HL = pointer to first FourCC, DE = pointer to second FourCC
043BA0             0222*   ; outputs: Z set when all four bytes match, Z reset when any byte differs
043BA0             0223*   ; preserves: BC, DE, HL
043BA0             0224*   ; destroys: A
043BA0             0225*   agnb_compare_fourcc:
043BA0 C5          0226*       push bc
043BA1 D5          0227*       push de
043BA2 E5          0228*       push hl
043BA3 06 04       0229*       ld b,4
043BA5             0230*   @loop:
043BA5 1A          0231*       ld a,(de)
043BA6 BE          0232*       cp (hl)
043BA7 20 04       0233*       jr nz,@done ; exit with Z reset if any byte differs, indicating a mismatch
043BA9 13          0234*       inc de
043BAA 23          0235*       inc hl
043BAB 10 F8       0236*       djnz @loop ; if we fall throgh at the end of the loop Z is set, indicating a match
043BAD             0237*   @done:
043BAD E1          0238*       pop hl
043BAE D1          0239*       pop de
043BAF C1          0240*       pop bc
043BB0 C9          0241*       ret
043BB1             0242*   
043BB1             0243*   ; Open a container for reading.
043BB1             0244*   ; inputs:  DE = zero-terminated filename (normally agnb_filename)
043BB1             0245*   ; outputs: A=0 and Z set on success; A=agnb_error_open and NZ set on failure
043BB1             0246*   ;          agnb_fil initialized and agnb_file_is_open set on success
043BB1             0247*   ; destroys: AF, BC, HL
043BB1             0248*   agnb_open:
043BB1             0249*   ; begin fail-closed: do not leave stale success state if ffs_fopen fails
043BB1 AF          0250*       xor a
043BB2 32 90 1B 04 0251*       ld (agnb_file_is_open),a
043BB6 32 8F 1B 04 0252*       ld (agnb_last_error),a
043BBA             0253*   
043BBA             0254*   ; Each newly opened container starts at physical and logical offset zero.
043BBA             0255*   ; The original single-container caller received this state from BSS
043BBA             0256*   ; initialization; consecutive container loads must establish it explicitly.
043BBA 21 00 00 00 0257*       ld hl,0
043BBE 22 70 1B 04 0258*       ld (agnb_state+agnb_state_file_offset),hl
043BC2 22 74 1B 04 0259*       ld (agnb_state+agnb_state_bytes_read),hl
043BC6 32 73 1B 04 0260*       ld (agnb_state+agnb_state_file_offset+3),a
043BCA 32 77 1B 04 0261*       ld (agnb_state+agnb_state_bytes_read+3),a
043BCE             0262*   
043BCE             0263*   ; open the caller-supplied filename into our single reader-owned FIL
043BCE 21 38 1B 04 0264*       ld hl,agnb_fil
043BD2 0E 01       0265*       ld c,fa_read
043BD4             0266*       FFSCALL ffs_fopen
                       M1 Args: function=ffs_fopen 
043BD4 FD E5       0001*M1     push iy
043BD6 3E 80       0002*M1     ld a,function
043BD8 5B CF       0003*M1     rst.lil $08
043BDA FD E1       0004*M1     pop iy
043BDC B7          0267*       or a
043BDD 20 08       0268*       jr nz,@error
043BDF             0269*   
043BDF             0270*   ; ffs_fopen succeeded
043BDF 3E 01       0271*       ld a,1
043BE1 32 90 1B 04 0272*       ld (agnb_file_is_open),a
043BE5 AF          0273*       xor a
043BE6 C9          0274*       ret
043BE7             0275*   
043BE7             0276*   @error:
043BE7 3E 01       0277*       ld a,agnb_error_open
043BE9 32 8F 1B 04 0278*       ld (agnb_last_error),a
043BED B7          0279*       or a
043BEE C9          0280*       ret
043BEF             0281*   
043BEF             0282*   ; Close agnb_fil if open and clear agnb_file_is_open.
043BEF             0283*   ; outputs: A=0 and Z set if closed or already closed
043BEF             0284*   ;          nonzero FatFS result and NZ set if ffs_fclose fails
043BEF             0285*   ; destroys: HL
043BEF             0286*   agnb_close:
043BEF             0287*   ; An unopened file is already in the requested state.
043BEF 3A 90 1B 04 0288*       ld a,(agnb_file_is_open)
043BF3 B7          0289*       or a
043BF4 28 14       0290*       jr z,@success
043BF6             0291*   
043BF6             0292*   ; Close our single reader-owned FIL.
043BF6 21 38 1B 04 0293*       ld hl,agnb_fil
043BFA             0294*       FFSCALL ffs_fclose
                       M1 Args: function=ffs_fclose 
043BFA FD E5       0001*M1     push iy
043BFC 3E 81       0002*M1     ld a,function
043BFE 5B CF       0003*M1     rst.lil $08
043C00 FD E1       0004*M1     pop iy
043C02 B7          0295*       or a
043C03 20 0B       0296*       jr nz,agnb_error_close
043C05             0297*   
043C05             0298*   ; Only clear the open flag after FatFS confirms the close.
043C05 AF          0299*       xor a
043C06 32 90 1B 04 0300*       ld (agnb_file_is_open),a
043C0A             0301*   @success:
043C0A AF          0302*       xor a
043C0B 32 8F 1B 04 0303*       ld (agnb_last_error),a
043C0F C9          0304*       ret
043C10             0305*   
043C10             0306*   agnb_error_close:
043C10             0307*   ; Placeholder in case we determine that close failures need a dedicated AGNB
043C10             0308*   ; error code or recovery path. For now retain and return the nonzero FRESULT,
043C10             0309*   ; and leave agnb_file_is_open set because FatFS did not confirm the close.
043C10 32 8F 1B 04 0310*       ld (agnb_last_error),a
043C14 B7          0311*       or a
043C15 C9          0312*       ret
043C16             0313*   
043C16             0314*   ; Top-level image load operation.
043C16             0315*   ; inputs:  DE = zero-terminated container filename
043C16             0316*   ; outputs: A=0 and Z set after all valid LIST BUFR image records are uploaded
043C16             0317*   ;          and finalized at their explicit IDs; nonzero error and NZ otherwise
043C16             0318*   ; destroys: AF, BC, DE, HL, IX
043C16             0319*   agnb_load_images:
043C16 21 85 3C 04 0320*       ld hl,agnb_image_callback_noop
043C1A             0321*   
043C1A             0322*   ; Callback-enabled image loader.
043C1A             0323*   ; inputs: DE = filename; HL = callback whose result is ignored
043C1A             0324*   agnb_load_images_with_callback:
043C1A 22 9D 3B 04 0325*       ld (agnb_image_callback),hl
043C1E CD B1 3B 04 0326*       call agnb_open
043C22 C0          0327*       ret nz
043C23             0328*   
043C23 CD FC 3C 04 0329*       call agnb_read_riff_header
043C27 20 47       0330*       jr nz,@load_error
043C29 CD D0 3D 04 0331*       call agnb_read_vers
043C2D 20 41       0332*       jr nz,@load_error
043C2F             0333*   
043C2F             0334*   @next_record:
043C2F             0335*   ; End only at the exact declared RIFF boundary. A position beyond it is an
043C2F             0336*   ; internal bounds failure; a position before it must begin another LIST BUFR.
043C2F 3A 73 1B 04 0337*       ld a,(agnb_state+agnb_state_file_offset+3)
043C33 21 63 1B 04 0338*       ld hl,agnb_state+agnb_state_riff_end+3
043C37 BE          0339*       cp (hl)
043C38 38 12       0340*       jr c,@read_record
043C3A 20 2E       0341*       jr nz,@bad_bounds
043C3C 2A 70 1B 04 0342*       ld hl,(agnb_state+agnb_state_file_offset)
043C40 ED 5B 60 1B 0343*       ld de,(agnb_state+agnb_state_riff_end)
       04          
043C45 B7          0344*       or a
043C46 ED 52       0345*       sbc hl,de
043C48 28 32       0346*       jr z,@success
043C4A 30 1E       0347*       jr nc,@bad_bounds
043C4C             0348*   
043C4C             0349*   @read_record:
043C4C CD 3B 3E 04 0350*       call agnb_read_buffer_list
043C50 20 1E       0351*       jr nz,@load_error
043C52 CD 58 40 04 0352*       call agnb_stream_data
043C56 20 18       0353*       jr nz,@load_error
043C58 CD F8 40 04 0354*       call agnb_finalize_image
043C5C 20 12       0355*       jr nz,@load_error
043C5E             0356*   
043C5E             0357*   ; Give the application one completed-bitmap boundary per record.
043C5E             0358*   ; Metadata remains valid for the duration of the callback.
043C5E CD 80 3C 04 0359*       call agnb_call_image_callback
043C62             0360*   
043C62 CD 21 41 04 0361*       call agnb_finish_buffer_list
043C66 20 08       0362*       jr nz,@load_error
043C68 18 C5       0363*       jr @next_record
043C6A             0364*   
043C6A             0365*   @bad_bounds:
043C6A 3E 08       0366*       ld a,agnb_error_bounds
043C6C 32 8F 1B 04 0367*       ld (agnb_last_error),a
043C70             0368*   @load_error:
043C70             0369*   ; Preserve the parser/transport error while still closing the open file.
043C70 F5          0370*       push af
043C71 CD EF 3B 04 0371*       call agnb_close
043C75 F1          0372*       pop af
043C76 32 8F 1B 04 0373*       ld (agnb_last_error),a
043C7A B7          0374*       or a
043C7B C9          0375*       ret
043C7C             0376*   
043C7C             0377*   @success:
043C7C C3 EF 3B 04 0378*       jp agnb_close
043C80             0379*   
043C80             0380*   ; The CALL above has already stacked the continuation address. Tail-jump to
043C80             0381*   ; the selected callback so its RET resumes the loader without clobbering BC.
043C80             0382*   agnb_call_image_callback:
043C80 2A 9D 3B 04 0383*       ld hl,(agnb_image_callback)
043C84 E9          0384*       jp (hl)
043C85             0385*   
043C85             0386*   agnb_image_callback_noop:
043C85 AF          0387*       xor a
043C86 C9          0388*       ret
043C87             0389*   
043C87             0390*   ; Read exactly BC bytes from agnb_fil into DE.
043C87             0391*   ; inputs:  BC = requested u24 length, DE = destination
043C87             0392*   ; outputs: A=0 and Z set after the complete request is satisfied
043C87             0393*   ;          nonzero error code and NZ set on FatFS error or premature EOF
043C87             0394*   ;          state offset/count updated after every successful FatFS read
043C87             0395*   ; destroys: BC, DE, HL
043C87             0396*   agnb_read_exact:
043C87             0397*   ; A zero-length request is already complete.
043C87 21 00 00 00 0398*       ld hl,0
043C8B B7          0399*       or a
043C8C ED 42       0400*       sbc hl,bc
043C8E 28 62       0401*       jr z,@success
043C90             0402*   
043C90             0403*   @read:
043C90             0404*   ; ffs_fread replaces BC with the number of bytes actually read, so retain the
043C90             0405*   ; remaining request on the stack. It preserves DE, our current destination.
043C90 C5          0406*       push bc
043C91 21 38 1B 04 0407*       ld hl,agnb_fil
043C95             0408*       FFSCALL ffs_fread
