044AAD             0049*   
044AAD             0050*   move_enemy_fireball:
044AAD             0051*   ; run the movement program for the fireball enemy
044AAD CD 0D 6A 04 0052*       call move_sprite
044AB1 3A 0A 67 04 0053*       ld a,(sprite_screen_edge)
044AB5 B7          0054*       or a ; a will be non-zero if have scrolled off screen
044AB6 C2 8B 67 04 0055*       jp nz,table_deactivate_sprite
044ABA DD 21 86 88 0056*       ld ix,player_begin
       04          
044ABF DD CB 1D 76 0057*       bit sprite_alive,(ix+sprite_collisions)
044AC3 CA D7 4A 04 0058*       jp z,@animate ; player is dead so don't check for collisions
044AC7 CD D8 49 04 0059*       call check_enemy_collision_player
044ACB C2 D7 4A 04 0060*       jp nz,@animate ; no collision so do animation
044ACF CD B5 66 04 0061*       call update_shields
044AD3 C3 96 4C 04 0062*       jp spawn_explosion
044AD7             0063*   @animate:
044AD7             0064*   ; check the animation timer
044AD7 FD 35 23    0065*       dec (iy+sprite_animation_timer)
044ADA C0          0066*       ret nz ; not time to animate
044ADB             0067*   ; reset the animation timer and bump animation
044ADB 3E 08       0068*       ld a,8
044ADD FD 77 23    0069*       ld (iy+sprite_animation_timer),a
044AE0 FD 7E 22    0070*       ld a,(iy+sprite_animation)
044AE3 3C          0071*       inc a
044AE4 E6 01       0072*       and %00000001 ; modulo 2
044AE6 FD 77 22    0073*       ld (iy+sprite_animation),a
044AE9 CD C4 6A 04 0074*       call sprite_frame_heading_animation ; a, sprite_frame set to heading-based frame
044AED CD 1E 1A 04 0075*       call vdu_sprite_select_frame
044AF1 C9          0076*       ret
044AF2             0077*   ; end move_enemy_fireball
044AF2             0078*   
044AF2             0079*   init_enemy_fireballs:
044AF2             0080*   ; set pointer to seeker sprite table
044AF2 FD 21 86 89 0081*       ld iy,fireballs_base
       04          
