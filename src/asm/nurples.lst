046658 3A D9 65 04 0096*       ld a,(laser_power)
04665C 21 DC 65 04 0097*       ld hl,laser_power_per_shot
046660 96          0098*       sub (hl) ; units of power per laser shot
046661 D8          0099*       ret c ; not enough power to fire
046662             0100*   ; update power to reflect firing
046662 32 D9 65 04 0101*       ld (laser_power),a
046666             0102*   ; reset timer
046666 2A D6 65 04 0103*       ld hl,(tmr_laser_reset)
04666A CD E4 12 04 0104*       call timestamp_tmr_set
04666E             0105*   ; fire the laser
04666E DD 21 D8 8D 0106*       ld ix,player_weapons_begin
       04          
046673 06 04       0107*       ld b,player_lasers_max
