044BB8             0102*   ; end move_enemy_seeker
044BB8             0103*   
044BB8             0104*   ; contains the logic for how to move the enemy
044BB8             0105*   ; and then does the moving
044BB8             0106*   ; inputs: a fully-populated active sprite table
044BB8             0107*   ;         player position variables
044BB8             0108*   ; destroys: everything except index registers
044BB8             0109*   ; outputs: moving enemies
044BB8             0110*   en_nav_seek_zag:
044BB8             0111*   ; set velocity and orientation by player's relative location
044BB8             0112*   ; move enemies y-axis
044BB8             0113*   ; where is player relative to us?
044BB8 CD FC 6E 04 0114*       call orientation_to_player ; uh.l angle to player, ub.c, ud.e = dx, dy
044BBC             0115*   ; is player above or below us?
044BBC ED 53 37 03 0116*       ld (ude),de ; dy
       04          
044BC1 3A 39 03 04 0117*       ld a,(ude+2) ; deu
044BC5 17          0118*       rla ; shift sign bit into carry
044BC6 D2 EF 4B 04 0119*       jp nc,@zig_zag ; player is below,evade
044BCA             0120*   ; player is even or above,so home in on current heading
044BCA FD 2F 10    0121*       ld (iy+sprite_heading),hl ; save sprite heading
044BCD             0122*   ; fall through to @compute_velocities
044BCD             0123*   @compute_velocities:
044BCD CD 84 6A 04 0124*       call sprite_compute_velocities
044BD1 CD E3 69 04 0125*       call move_sprite ; move the sprite
044BD5 B7          0126*       or a ; a will be non-zero if have collided with screen edge
044BD6 C2 06 4C 04 0127*       jp nz,@edge_switch ; switch direction, but never move twice in one frame
044BDA C3 7B 4B 04 0128*       jp move_enemy_seeker ; didn't hit an edge so check collisions and move sprite
044BDE             0129*   @reset_zig_zag_timer:
044BDE FD 2A DD 66 0130*       ld iy,(table_pointer)
       04          
044BE3 CD 14 05 04 0131*       call rand_8
044BE7 E6 3F       0132*       and %00111111 ; limit it to 64
044BE9 CB DF       0133*       set 3,a ; make sure it's at least 8
044BEB FD 77 24    0134*       ld (iy+sprite_move_timer),a ; store it
044BEE C9          0135*       ret
044BEF             0136*   @zig_zag:
044BEF FD 7E 24    0137*       ld a,(iy+sprite_move_timer)
044BF2 3D          0138*       dec a
044BF3 FD 77 24    0139*       ld (iy+sprite_move_timer),a
044BF6 C2 2E 4C 04 0140*       jp nz,@zig_zag_no_switch
044BFA             0141*   @zag_switch:
044BFA CD 12 4C 04 0142*       call @switch_zag_heading
044BFE CD DE 4B 04 0143*       call @reset_zig_zag_timer
044C02 C3 2E 4C 04 0144*       jp @zig_zag_no_switch
044C06             0145*   @edge_switch:
044C06             0146*   ; The generic mover has already clamped/bounced this seeker. Choose the next
044C06             0147*   ; zag and return through collision handling; moving again here can loop forever
044C06             0148*   ; at the bottom edge because both zag headings point downward.
044C06 CD 12 4C 04 0149*       call @switch_zag_heading
044C0A CD DE 4B 04 0150*       call @reset_zig_zag_timer
044C0E C3 7B 4B 04 0151*       jp move_enemy_seeker
044C12             0152*   @switch_zag_heading:
044C12 FD 7E 25    0153*       ld a,(iy+sprite_move_step)
044C15 EE 01       0154*       xor %1 ; flips bit zero
044C17 FD 77 25    0155*       ld (iy+sprite_move_step),a ; store it
044C1A C2 26 4C 04 0156*       jp nz,@right ; zag right
044C1E             0157*   ;otherwise zag left
044C1E 21 00 A0 00 0158*       ld hl,160*256; southwest heading
044C22 FD 2F 10    0159*       ld (iy+sprite_heading),hl ; save sprite heading
044C25 C9          0160*       ret
044C26             0161*   @right:
044C26 21 00 60 00 0162*       ld hl,96*256; southeast heading
044C2A FD 2F 10    0163*       ld (iy+sprite_heading),hl ; save sprite heading
044C2D C9          0164*       ret
044C2E             0165*   @zig_zag_no_switch:
044C2E             0166*       ; ld a,(sprite_orientation)
044C2E FD 27 10    0167*       ld hl,(iy+sprite_heading)
044C31 C3 CD 4B 04 0168*       jp @compute_velocities
