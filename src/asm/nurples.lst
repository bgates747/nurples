049DDA             0150*   load_command_buffer:
049DDA 21 02 30 00 0151*       ld hl,cmd0_buffer
049DDE CD FA 16 04 0152*       call vdu_clear_buffer
049DE2 21 02 30 00 0153*       ld hl,cmd0_buffer
049DE6 01 1D 00 00 0154*       ld bc,ps_cmd0_end-ps_cmd0
049DEA 11 0B 9E 04 0155*       ld de,ps_cmd0
049DEE CD B7 16 04 0156*       call vdu_write_block_to_buffer
049DF2             0157*   
049DF2 21 03 30 00 0158*       ld hl,cmd1_buffer
049DF6 CD FA 16 04 0159*       call vdu_clear_buffer
049DFA 21 03 30 00 0160*       ld hl,cmd1_buffer
049DFE 01 1D 00 00 0161*       ld bc,ps_cmd1_end-ps_cmd1
049E02 11 28 9E 04 0162*       ld de,ps_cmd1
049E06 CD B7 16 04 0163*       call vdu_write_block_to_buffer
049E0A C9          0164*       ret
049E0B             0165*   ps_cmd0:
049E0B             0166*   ; vdu_buffer_to_sound command string
049E0B             0167*   ; Command 5: Buffer to sound
049E0B             0168*   ; VDU 23, 0, &85, channel (ignored), 5, 2, bufferId; format, [sampleRate;]
049E0B 17 00 85    0169*       db 23,0,0x85 ; vdu sound command header
049E0E 00          0170*       db 0x00 ; channel (ignored)
049E0F 05          0171*       db 0x05 ; buffer to sound command
049E10 02          0172*       db 0x02 ; command 2 create sample
049E11 00 30       0173*       dw ch0_buffer
049E13 08          0174*       db 0+8 ; 0 = 8-bit signed PCM mono, 8 = sample rate argument follows
049E14 00 10       0175*       dw sample_rate ; Hz
049E16             0176*   ; vdu_play_sfx command string
049E16             0177*   ; Command 4: Set waveform
049E16             0178*   ; VDU 23, 0, &85, channel, 4, waveformOrSample, [bufferId;]
049E16 17 00 85    0179*       db 23,0,$85 ; vdu sound command header
049E19 00          0180*       db 0 ; channel
049E1A 04          0181*       db 4 ; set waveform command
049E1B 08          0182*       db 8 ; waveform 8 = sample
049E1C 00 30       0183*       dw ch0_buffer ; sample bufferId
049E1E             0184*   ; Command 0: Play note
049E1E             0185*   ; VDU 23, 0, &85, channel, 0, volume, frequency; duration;
049E1E 17 00 85    0186*       db 23,0,$85 ; vdu sound command header
049E21 00          0187*       db 0 ; channel
049E22 00          0188*       db 0 ; play note command
049E23 7F          0189*       db 127  ; volume 127 = max
049E24 00 00       0190*       dw 0 ; frequency (relevant only for tuneable samples)
049E26 00 00       0191*       dw 0 ; duration (ms), zero means play one time in full
049E28             0192*   ps_cmd0_end:
049E28             0193*   
049E28             0194*   ps_cmd1:
049E28             0195*   ; vdu_buffer_to_sound command string
049E28             0196*   ; Command 5: Buffer to sound
049E28             0197*   ; VDU 23, 0, &85, channel (ignored), 5, 2, bufferId; format, [sampleRate;]
049E28 17 00 85    0198*       db 23,0,0x85 ; vdu sound command header
049E2B 00          0199*       db 0x00 ; channel (ignored)
049E2C 05          0200*       db 0x05 ; buffer to sound command
049E2D 02          0201*       db 0x02 ; command 2 create sample
049E2E 01 30       0202*       dw ch1_buffer
049E30 08          0203*       db 0+8 ; 0 = 8-bit signed PCM mono, 8 = sample rate argument follows
049E31 00 10       0204*       dw sample_rate ; Hz
049E33             0205*   ; vdu_play_sfx command string
049E33             0206*   ; Command 4: Set waveform
049E33             0207*   ; VDU 23, 0, &85, channel, 4, waveformOrSample, [bufferId;]
049E33 17 00 85    0208*       db 23,0,$85 ; vdu sound command header
049E36 01          0209*       db 1 ; channel
049E37 04          0210*       db 4 ; set waveform command
049E38 08          0211*       db 8 ; waveform 8 = sample
049E39 01 30       0212*       dw ch1_buffer ; sample bufferId
049E3B             0213*   ; Command 0: Play note
049E3B             0214*   ; VDU 23, 0, &85, channel, 0, volume, frequency; duration;
049E3B 17 00 85    0215*       db 23,0,$85 ; vdu sound command header
049E3E 01          0216*       db 1 ; channel
049E3F 00          0217*       db 0 ; play note command
049E40 7F          0218*       db 127  ; volume 127 = max
049E41 00 00       0219*       dw 0 ; frequency (relevant only for tuneable samples)
049E43 00 00       0220*       dw 0 ; duration (ms), zero means play one time in full
