04799C CD 75 75 04 0021*       call spawn_active_tile
0479A0             0022*       ; ret nc ; no carry means no free active tile slots, so we go home
0479A0             0023*   ; other specific initialization
0479A0 C9          0024*       ret
0479A1             0025*   ; end activate_electrode
0479A1             0026*   
0479A1             0027*   move_electrode:
0479A1 CD CB 77 04 0028*       call move_active_tile
0479A5 CA DD 74 04 0029*       jp z,table_deactivate_tile
0479A9 DD 21 1A 89 0030*       ld ix,player_begin
       04          
0479AE DD CB 1D 76 0031*       bit sprite_alive,(ix+sprite_collisions)
0479B2 CA C6 79 04 0032*       jp z,@laser ; player is dead so don't check for collisions
0479B6 CD CB 49 04 0033*       call check_enemy_collision_player
0479BA C2 C6 79 04 0034*       jp nz,@laser ; no collision so check laser collision
0479BE CD F7 66 04 0035*       call update_shields
0479C2 C3 D3 79 04 0036*       jp kill_electrode
0479C6             0037*   @laser:
0479C6 CD BF 49 04 0038*       call check_enemy_collision_laser
0479CA C0          0039*       ret nz ; no collision so we're done
0479CB CD 9A 66 04 0040*       call update_score
0479CF C3 D3 79 04 0041*       jp kill_electrode
0479D3             0042*   ; end move_electrode
0479D3             0043*   
0479D3             0044*   kill_electrode:
0479D3             0045*   ; Preserve the source record itself. Removing earlier stack entries may change
0479D3             0046*   ; its dense-stack slot, so the slot is rediscovered after the scan.
0479D3 FD 22 22 7B 0047*       ld (@source_tile_pointer),iy
       04          
0479D8 FD 27 04    0048*       ld hl,(iy+tile_y)
0479DB 22 1F 7B 04 0049*       ld (@tile_y),hl
0479DF             0050*   ; activate blank tile bitmap only after source data no longer depends on IY
0479DF 21 76 01 00 0051*       ld hl,BUF_TILE_BLANK
0479E3 CD D7 14 04 0052*       call vdu_buff_select
0479E7             0053*   ; Bound the scan to the entry count at its start. Each processed or removed
0479E7             0054*   ; entry consumes one unit; removal leaves IX on the shifted successor.
0479E7 3A C3 73 04 0055*       ld a,(num_active_tiles)
0479EB 32 25 7B 04 0056*       ld (@tiles_remaining),a
0479EF DD 21 BA 70 0057*       ld ix,tile_stack ; set ix to first record in table
       04          
0479F4             0058*   @check_loop:
0479F4 3A 25 7B 04 0059*       ld a,(@tiles_remaining)
0479F8 B7          0060*       or a
0479F9 CA AB 7A 04 0061*       jp z,@scan_done
0479FD 3D          0062*       dec a
0479FE 32 25 7B 04 0063*       ld (@tiles_remaining),a
047A02             0064*   ; validate the stack slot before loading its pointer
047A02 DD E5       0065*       push ix
047A04 E1          0066*       pop hl
047A05 CD 6E 74 04 0067*       call tile_stack_pointer_valid
047A09 D2 AB 7A 04 0068*       jp nc,@scan_done
047A0D DD 22 1C 7B 0069*       ld (@tile_stack_pointer),ix ; update stack pointer
       04          
047A12             0070*   ; validate the record before reading any fields
047A12 DD 31 00    0071*       ld iy,(ix)
047A15 CD A7 74 04 0072*       call tile_table_record_pointer_valid
047A19 D2 87 7A 04 0073*       jp nc,@bad_record
047A1D             0074*   ; check top bit of tile_type to see if tile is just spawned
047A1D FD CB 16 7E 0075*       bit 7,(iy+tile_type)
047A21 C2 9F 7A 04 0076*       jp nz,@next_record ; if just spawned, skip to next record
047A25             0077*   ; check sprite_alive bit to see if tile is active
047A25 FD CB 1D 76 0078*       bit sprite_alive,(iy+tile_collisions)
047A29 CA 75 7A 04 0079*       jp z,@inactive_record
047A2D             0080*   ; check tile type
047A2D FD 7E 16    0081*       ld a,(iy+tile_type)
047A30 FE 0A       0082*       cp tile_lightning ; check if tile is lightning
047A32 C2 9F 7A 04 0083*       jp nz,@next_record ; if not lightning, skip to next record
047A36             0084*   ; check tile position
047A36 DD 22 BD 73 0085*       ld (tile_stack_pointer),ix
       04          
047A3B FD 22 C0 73 0086*       ld (tile_table_pointer),iy
       04          
047A40 FD 27 04    0087*       ld hl,(iy+tile_y)
047A43 ED 5B 1F 7B 0088*       ld de,(@tile_y)
       04          
047A48 B7          0089*       or a ; clear carry
047A49 E5          0090*       push hl
047A4A ED 52       0091*       sbc hl,de
047A4C E1          0092*       pop hl
047A4D CA 5D 7A 04 0093*       jp z,@kill_it
047A51 01 00 01 00 0094*       ld bc,1*256
047A55 09          0095*       add hl,bc
047A56 B7          0096*       or a
047A57 ED 52       0097*       sbc hl,de
047A59 C2 9F 7A 04 0098*       jp nz,@next_record
047A5D             0099*   @kill_it: ; deactivate tile and replace with inactive blank tile
047A5D FD 07 01    0100*       ld bc,(iy+tile_x) ; get x position (ud.e already has y-position)
047A60 FD E5       0101*       push iy
047A62 CD 29 19 04 0102*       call vdu_plot_bmp168 ; plot blank tile (bitmap was activated at beginning of proc)
047A66 FD E1       0103*       pop iy
047A68 CD DD 74 04 0104*       call table_deactivate_tile
047A6C DD 2A 1C 7B 0105*       ld ix,(@tile_stack_pointer) ; get back stack pointer
       04          
047A71 C3 F4 79 04 0106*       jp @check_loop ; deactivate tile naturally advances to next record
047A75             0107*   @inactive_record:
047A75             0108*   ; A valid inactive record violates the dense-stack invariant but is safe to
047A75             0109*   ; remove. Keep IX on this slot so the shifted successor is checked next.
047A75 DD 22 BD 73 0110*       ld (tile_stack_pointer),ix
       04          
047A7A CD DD 74 04 0111*       call table_deactivate_tile
047A7E DD 2A 1C 7B 0112*       ld ix,(@tile_stack_pointer)
       04          
047A83 C3 F4 79 04 0113*       jp @check_loop
047A87             0114*   @bad_record:
047A87             0115*   ; The slot itself was validated, so it can be quarantined without touching the
047A87             0116*   ; malformed record pointer. Continue at the successor shifted into this slot.
047A87 21 CA 73 04 0117*       ld hl,tile_fault_flags
047A8B CB C6       0118*       set tile_fault_bad_record,(hl)
047A8D DD 22 BD 73 0119*       ld (tile_stack_pointer),ix
       04          
047A92 CD 21 75 04 0120*       call tile_stack_quarantine_entry
047A96 DD 2A 1C 7B 0121*       ld ix,(@tile_stack_pointer)
       04          
047A9B C3 F4 79 04 0122*       jp @check_loop
047A9F             0123*    ; get back stack pointer and loop
047A9F             0124*   @next_record:
047A9F DD 2A 1C 7B 0125*       ld ix,(@tile_stack_pointer)
       04          
047AA4 ED 32 03    0126*       lea ix,ix+3 ; next tile stack record
047AA7 C3 F4 79 04 0127*       jp @check_loop ; loop until we've checked all the records
047AAB             0128*   @scan_done:
047AAB             0129*   ; Rediscover the source cursor after any compaction. This search is bounded by
047AAB             0130*   ; the current dense-stack count and validates each slot before loading it.
047AAB 3A C3 73 04 0131*       ld a,(num_active_tiles)
047AAF 32 25 7B 04 0132*       ld (@tiles_remaining),a
047AB3 FD 21 BA 70 0133*       ld iy,tile_stack
       04          
047AB8             0134*   @find_loop:
047AB8 3A 25 7B 04 0135*       ld a,(@tiles_remaining)
047ABC B7          0136*       or a
047ABD CA FF 7A 04 0137*       jp z,@source_not_found
047AC1 3D          0138*       dec a
047AC2 32 25 7B 04 0139*       ld (@tiles_remaining),a
047AC6 FD E5       0140*       push iy
047AC8 E1          0141*       pop hl
047AC9 CD 6E 74 04 0142*       call tile_stack_pointer_valid
047ACD D2 FF 7A 04 0143*       jp nc,@source_not_found
047AD1 FD 27 00    0144*       ld hl,(iy)
047AD4 ED 33 03    0145*       lea iy,iy+3 ; next tile stack record
047AD7 ED 5B 22 7B 0146*       ld de,(@source_tile_pointer)
       04          
047ADC B7          0147*       or a ; clear carry
047ADD ED 52       0148*       sbc hl,de ; if not the same address, loop
047ADF C2 B8 7A 04 0149*       jp nz,@find_loop
047AE3 ED 33 FD    0150*       lea iy,iy-3 ; back up to the record we want
047AE6 FD 22 BD 73 0151*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
047AEB FD 37 00    0152*       ld iy,(iy) ; iy points to the tile stack record
047AEE CD A7 74 04 0153*       call tile_table_record_pointer_valid
047AF2 D2 FF 7A 04 0154*       jp nc,@source_not_found
047AF6 FD 22 C0 73 0155*       ld (tile_table_pointer),iy ; set pointer to this tile record
       04          
047AFB C3 4B 79 04 0156*       jp transform_active_tile_to_crater
047AFF             0157*   @source_not_found:
047AFF             0158*   ; Fail closed and make the outer traversal's normal +3 step land exactly on
047AFF             0159*   ; the current logical end. It will then stop on the validated range check.
047AFF 21 CA 73 04 0160*       ld hl,tile_fault_flags
047B03 CB C6       0161*       set tile_fault_bad_record,(hl)
047B05 3A C3 73 04 0162*       ld a,(num_active_tiles)
047B09 21 00 00 00 0163*       ld hl,0
047B0D 67          0164*       ld h,a
047B0E 2E 03       0165*       ld l,3
047B10 ED 6C       0166*       mlt hl
047B12 11 B7 70 04 0167*       ld de,tile_stack-3
047B16 19          0168*       add hl,de
047B17 22 BD 73 04 0169*       ld (tile_stack_pointer),hl
047B1B C9          0170*       ret
047B1C BA 70 04    0171*   @tile_stack_pointer: dl tile_stack ; pointer to current stack record, initialized to tile_stack
047B1F 00 00 00    0172*   @tile_y: dl 0 ; y position of tiles to kill
047B22 00 00 00    0173*   @source_tile_pointer: dl 0
047B25 00          0174*   @tiles_remaining: db 0
