041422 C9          0261*       ret
041423             0262*   ; end vdu_get_screen_mode
041423             0263*   
041423             0264*   ; VDU 23, 0, &C0, n: Turn logical screen scaling on and off *
041423             0265*   ; inputs: a is scaling mode, 1=on, 0=off
041423             0266*   ; note: default setting on boot is scaling ON
041423             0267*   vdu_set_scaling:
041423 32 35 14 04 0268*   	ld (@arg),a
041427 21 32 14 04 0269*   	ld hl,@cmd
04142B 01 04 00 00 0270*   	ld bc,@end-@cmd
04142F 5B DF       0271*   	rst.lil $18
041431 C9          0272*   	ret
041432 17 00 C0    0273*   @cmd: db 23,0,0xC0
