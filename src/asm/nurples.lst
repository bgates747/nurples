0465C0 19          0124*       add hl,de
0465C1 DD 2F 04    0125*       ld (ix+sprite_y),hl
0465C4             0126*   ; set laser velocity
0465C4 21 00 FC FF 0127*       ld hl,-laser_speed
0465C8 DD 2F 0A    0128*       ld (ix+sprite_yvel),hl
