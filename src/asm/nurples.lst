047DFC             0169*   ; update a vertical bar display
047DFC             0170*   ; inputs: ix points to bar structure
047DFC             0171*   ;         bar_val set by caller
047DFC             0172*   ; prerequisite: bar_init called before first use
047DFC             0173*   bar_update_v:
047DFC             0174*   ; set gfx viewport
047DFC DD E5       0175*       push ix ; preserve pointer
047DFE DD 07 03    0176*       ld bc,(ix+bar_x0)
047E01 DD 17 06    0177*       ld de,(ix+bar_y0)
047E04 DD 31 0C    0178*       ld iy,(ix+bar_y1)
047E07 DD 37 09    0179*       ld ix,(ix+bar_x1)
047E0A CD 3E 14 04 0180*       call vdu_set_gfx_viewport
047E0E DD E1       0181*       pop ix ; restore pointer
047E10             0182*   ; select the color based on the value thresholds
047E10 DD 17 00    0183*       ld de,(ix+bar_val)
047E13 21 EF FF FF 0184*       ld hl,-bar_red
047E17 19          0185*       add hl,de
047E18 D2 35 7E 04 0186*       jp nc,@red
047E1C 21 DF FF FF 0187*       ld hl,-bar_yellow
047E20 19          0188*       add hl,de
047E21 D2 2D 7E 04 0189*       jp nc,@yellow
047E25 21 05 00 00 0190*       ld hl,BUF_BAR_V_2 ; green
047E29 C3 39 7E 04 0191*       jp @select
047E2D             0192*   @yellow:
047E2D 21 04 00 00 0193*       ld hl,BUF_BAR_V_1 ; yellow
047E31 C3 39 7E 04 0194*       jp @select
047E35             0195*   @red:
047E35 21 03 00 00 0196*       ld hl,BUF_BAR_V_0 ; red
047E39             0197*   @select:
047E39 CD 93 14 04 0198*       call vdu_buff_select
047E3D             0199*   ; get x-plot position
047E3D DD 07 03    0200*       ld bc,(ix+bar_x0)
047E40             0201*   ; compute y-plot position
047E40 DD 17 00    0202*       ld de,(ix+bar_val)
047E43 21 40 00 00 0203*       ld hl,64
047E47 AF          0204*       xor a ; clear carry
047E48 ED 52       0205*       sbc hl,de
047E4A DD 17 0F    0206*       ld de,(ix+bar_y)
047E4D 19          0207*       add hl,de
047E4E 7D          0208*       ld a,l
047E4F E6 FC       0209*       and %11111100 ; round to nearest 4 pixels
047E51 6F          0210*       ld l,a
047E52 EB          0211*       ex de,hl
047E53 CD A3 18 04 0212*       call vdu_plot_bmp
047E57 C9          0213*       ret
047E58             0214*   ; end bar_update_v
047E58             0215*   
