048EB4 CD 9D 7C 04 0040*       call update_score
048EB8 C3 BC 8E 04 0041*       jp kill_electrode
048EBC             0042*   ; end move_electrode
048EBC             0043*   
048EBC             0044*   kill_electrode:
048EBC             0045*   ; Preserve the source record itself. Removing earlier stack entries may change
048EBC             0046*   ; its dense-stack slot, so the slot is rediscovered after the scan.
048EBC FD 22 0B 90 0047*       ld (@source_tile_pointer),iy
       04          
048EC1 FD 27 04    0048*       ld hl,(iy+tile_y)
048EC4 22 08 90 04 0049*       ld (@tile_y),hl
048EC8             0050*   ; activate blank tile bitmap only after source data no longer depends on IY
048EC8 21 76 01 00 0051*       ld hl,BUF_TILE_BLANK
048ECC CD 93 14 04 0052*       call vdu_buff_select
048ED0             0053*   ; Bound the scan to the entry count at its start. Each processed or removed
048ED0             0054*   ; entry consumes one unit; removal leaves IX on the shifted successor.
048ED0 3A AC 88 04 0055*       ld a,(num_active_tiles)
048ED4 32 0E 90 04 0056*       ld (@tiles_remaining),a
048ED8 DD 21 A3 85 0057*       ld ix,tile_stack ; set ix to first record in table
       04          
048EDD             0058*   @check_loop:
048EDD 3A 0E 90 04 0059*       ld a,(@tiles_remaining)
048EE1 B7          0060*       or a
048EE2 CA 94 8F 04 0061*       jp z,@scan_done
048EE6 3D          0062*       dec a
048EE7 32 0E 90 04 0063*       ld (@tiles_remaining),a
048EEB             0064*   ; validate the stack slot before loading its pointer
048EEB DD E5       0065*       push ix
048EED E1          0066*       pop hl
048EEE CD 57 89 04 0067*       call tile_stack_pointer_valid
048EF2 D2 94 8F 04 0068*       jp nc,@scan_done
048EF6 DD 22 05 90 0069*       ld (@tile_stack_pointer),ix ; update stack pointer
       04          
048EFB             0070*   ; validate the record before reading any fields
048EFB DD 31 00    0071*       ld iy,(ix)
048EFE CD 90 89 04 0072*       call tile_table_record_pointer_valid
048F02 D2 70 8F 04 0073*       jp nc,@bad_record
048F06             0074*   ; check top bit of tile_type to see if tile is just spawned
048F06 FD CB 16 7E 0075*       bit 7,(iy+tile_type)
048F0A C2 88 8F 04 0076*       jp nz,@next_record ; if just spawned, skip to next record
048F0E             0077*   ; check sprite_alive bit to see if tile is active
048F0E FD CB 1D 76 0078*       bit sprite_alive,(iy+tile_collisions)
048F12 CA 5E 8F 04 0079*       jp z,@inactive_record
048F16             0080*   ; check tile type
048F16 FD 7E 16    0081*       ld a,(iy+tile_type)
048F19 FE 0A       0082*       cp tile_lightning ; check if tile is lightning
048F1B C2 88 8F 04 0083*       jp nz,@next_record ; if not lightning, skip to next record
048F1F             0084*   ; check tile position
048F1F DD 22 A6 88 0085*       ld (tile_stack_pointer),ix
       04          
048F24 FD 22 A9 88 0086*       ld (tile_table_pointer),iy
       04          
048F29 FD 27 04    0087*       ld hl,(iy+tile_y)
048F2C ED 5B 08 90 0088*       ld de,(@tile_y)
       04          
048F31 B7          0089*       or a ; clear carry
048F32 E5          0090*       push hl
048F33 ED 52       0091*       sbc hl,de
048F35 E1          0092*       pop hl
048F36 CA 46 8F 04 0093*       jp z,@kill_it
048F3A 01 00 01 00 0094*       ld bc,1*256
048F3E 09          0095*       add hl,bc
048F3F B7          0096*       or a
048F40 ED 52       0097*       sbc hl,de
048F42 C2 88 8F 04 0098*       jp nz,@next_record
048F46             0099*   @kill_it: ; deactivate tile and replace with inactive blank tile
048F46 FD 07 01    0100*       ld bc,(iy+tile_x) ; get x position (ud.e already has y-position)
048F49 FD E5       0101*       push iy
048F4B CD BF 18 04 0102*       call vdu_plot_bmp168 ; plot blank tile (bitmap was activated at beginning of proc)
048F4F FD E1       0103*       pop iy
048F51 CD C6 89 04 0104*       call table_deactivate_tile
048F55 DD 2A 05 90 0105*       ld ix,(@tile_stack_pointer) ; get back stack pointer
       04          
048F5A C3 DD 8E 04 0106*       jp @check_loop ; deactivate tile naturally advances to next record
048F5E             0107*   @inactive_record:
048F5E             0108*   ; A valid inactive record violates the dense-stack invariant but is safe to
048F5E             0109*   ; remove. Keep IX on this slot so the shifted successor is checked next.
048F5E DD 22 A6 88 0110*       ld (tile_stack_pointer),ix
       04          
048F63 CD C6 89 04 0111*       call table_deactivate_tile
048F67 DD 2A 05 90 0112*       ld ix,(@tile_stack_pointer)
       04          
048F6C C3 DD 8E 04 0113*       jp @check_loop
048F70             0114*   @bad_record:
048F70             0115*   ; The slot itself was validated, so it can be quarantined without touching the
048F70             0116*   ; malformed record pointer. Continue at the successor shifted into this slot.
048F70 21 B3 88 04 0117*       ld hl,tile_fault_flags
048F74 CB C6       0118*       set tile_fault_bad_record,(hl)
048F76 DD 22 A6 88 0119*       ld (tile_stack_pointer),ix
       04          
048F7B CD 0A 8A 04 0120*       call tile_stack_quarantine_entry
048F7F DD 2A 05 90 0121*       ld ix,(@tile_stack_pointer)
       04          
048F84 C3 DD 8E 04 0122*       jp @check_loop
048F88             0123*    ; get back stack pointer and loop
048F88             0124*   @next_record:
048F88 DD 2A 05 90 0125*       ld ix,(@tile_stack_pointer)
       04          
048F8D ED 32 03    0126*       lea ix,ix+3 ; next tile stack record
048F90 C3 DD 8E 04 0127*       jp @check_loop ; loop until we've checked all the records
048F94             0128*   @scan_done:
048F94             0129*   ; Rediscover the source cursor after any compaction. This search is bounded by
048F94             0130*   ; the current dense-stack count and validates each slot before loading it.
048F94 3A AC 88 04 0131*       ld a,(num_active_tiles)
048F98 32 0E 90 04 0132*       ld (@tiles_remaining),a
048F9C FD 21 A3 85 0133*       ld iy,tile_stack
       04          
048FA1             0134*   @find_loop:
048FA1 3A 0E 90 04 0135*       ld a,(@tiles_remaining)
048FA5 B7          0136*       or a
048FA6 CA E8 8F 04 0137*       jp z,@source_not_found
048FAA 3D          0138*       dec a
048FAB 32 0E 90 04 0139*       ld (@tiles_remaining),a
048FAF FD E5       0140*       push iy
048FB1 E1          0141*       pop hl
048FB2 CD 57 89 04 0142*       call tile_stack_pointer_valid
048FB6 D2 E8 8F 04 0143*       jp nc,@source_not_found
048FBA FD 27 00    0144*       ld hl,(iy)
048FBD ED 33 03    0145*       lea iy,iy+3 ; next tile stack record
048FC0 ED 5B 0B 90 0146*       ld de,(@source_tile_pointer)
       04          
048FC5 B7          0147*       or a ; clear carry
048FC6 ED 52       0148*       sbc hl,de ; if not the same address, loop
048FC8 C2 A1 8F 04 0149*       jp nz,@find_loop
048FCC ED 33 FD    0150*       lea iy,iy-3 ; back up to the record we want
048FCF FD 22 A6 88 0151*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
048FD4 FD 37 00    0152*       ld iy,(iy) ; iy points to the tile stack record
048FD7 CD 90 89 04 0153*       call tile_table_record_pointer_valid
048FDB D2 E8 8F 04 0154*       jp nc,@source_not_found
048FDF FD 22 A9 88 0155*       ld (tile_table_pointer),iy ; set pointer to this tile record
       04          
048FE4 C3 34 8E 04 0156*       jp transform_active_tile_to_crater
048FE8             0157*   @source_not_found:
048FE8             0158*   ; Fail closed and make the outer traversal's normal +3 step land exactly on
048FE8             0159*   ; the current logical end. It will then stop on the validated range check.
048FE8 21 B3 88 04 0160*       ld hl,tile_fault_flags
048FEC CB C6       0161*       set tile_fault_bad_record,(hl)
048FEE 3A AC 88 04 0162*       ld a,(num_active_tiles)
048FF2 21 00 00 00 0163*       ld hl,0
048FF6 67          0164*       ld h,a
048FF7 2E 03       0165*       ld l,3
048FF9 ED 6C       0166*       mlt hl
048FFB 11 A0 85 04 0167*       ld de,tile_stack-3
048FFF 19          0168*       add hl,de
049000 22 A6 88 04 0169*       ld (tile_stack_pointer),hl
049004 C9          0170*       ret
049005 A3 85 04    0171*   @tile_stack_pointer: dl tile_stack ; pointer to current stack record, initialized to tile_stack
049008 00 00 00    0172*   @tile_y: dl 0 ; y position of tiles to kill
04900B 00 00 00    0173*   @source_tile_pointer: dl 0
04900E 00          0174*   @tiles_remaining: db 0
