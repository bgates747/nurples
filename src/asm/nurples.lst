047B4A             0001*   laser_defaults:
047B4A 06          0002*       db player_air        ; type
047B4B 4E 01 00    0003*       dl BUF_LASER_A	    ; base_bufferId
047B4E 3B 7C 04    0004*       dl move_player_laser	; move_program
047B51 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
047B52 05          0006*       db 5	                ; dim_x
047B53 0D          0007*       db 13                   ; dim_y
047B54 01          0008*       db 1                    ; num_orientations
047B55 02          0009*       db 2                    ; num_animations
047B56 00          0010*       db 0	                ; animation
047B57 02          0011*       db laser_animation_timer_reset ; animation_timer
047B58 00          0012*       db 0	                ; move_timer
047B59 00          0013*       db 0	                ; move_step
047B5A 00          0014*       db 0	                ; points
047B5B 00          0015*       db 0	                ; shield_damage
047B5C 00          0016*       db 0                    ; frame
047B5D             0017*   
