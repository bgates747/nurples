045F89             0062        include "player_state.inc"
045F89             0001*   player_defaults:
045F89 05          0002*       db player               ; type
045F8A 73 01 00    0003*       dl BUF_SHIP_0L          ; base_bufferId
045F8D F6 5F 04    0004*       dl do_player            ; move_program
045F90 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
045F91 10          0006*       db 16                   ; dim_x
045F92 10          0007*       db 16                   ; dim_y
045F93 01          0008*       db 1                    ; num_orientations
045F94 01          0009*       db 1                    ; num_animations
045F95 00          0010*       db 0                    ; animation
045F96 00          0011*       db 0                    ; animation_timer
045F97 00          0012*       db 0                    ; move_timer
045F98 00          0013*       db 0                    ; move_step
045F99 00          0014*       db 0                    ; points
045F9A 00          0015*       db 0                    ; shield_damage
045F9B 00          0016*       db 0                    ; frame
045F9C             0017*   
045F9C E2 60 04    0018*   player_state:  dl player_alive
045F9F             0019*   player_event_none: equ 0
045F9F             0020*   player_event_game_over: equ 1
045F9F 00          0021*   player_event: db player_event_none
045FA0             0022*   player_fault_bad_state: equ 0
045FA0 00          0023*   player_fault_flags: db 0 ; latched fail-closed diagnostics
045FA1             0024*   player_dying_phase_initial: equ 0
045FA1             0025*   player_dying_phase_delay: equ 1
045FA1             0026*   player_dying_phase_finale: equ 2
045FA1             0027*   player_dying_phase_finish: equ 3
045FA1             0028*   ; The finale spawn frame itself performs lifetime update one later in the
045FA1             0029*   ; global loop; FINISH therefore waits only the remaining updates.
045FA1             0030*   player_dying_finish_frames: equ explosion_lifetime_updates-1
045FA1 00          0031*   player_dying_phase: db player_dying_phase_initial
045FA2 00          0032*   player_dying_timer: db 0
045FA3 00          0033*   player_dying_spawns: db 0
045FA4 00          0034*   player_ships: db 0
045FA5 03          0035*   player_ships_max: db 3
045FA6             0036*   player_speed: equ 3*256 ; pixels per frame 16.8 fixed
045FA6             0037*   
045FA6             0038*   draw_player_ships:
045FA6             0039*   ; activate mfd
045FA6 DD 21 9D 62 0040*       ld ix,mfd_ships
       04          
045FAB CD A4 63 04 0041*       call mfd_activate
045FAF             0042*   ; blank out previously drawn ships
045FAF AF          0043*       xor a ; color mode 0
045FB0 0E 00       0044*       ld c,c_black
045FB2 CD 0C 14 04 0045*       call vdu_gcol
045FB6 01 00 00 00 0046*       ld bc,0
045FBA 11 00 00 00 0047*       ld de,0
045FBE DD 21 4F 00 0048*       ld ix,0+79
       00          
045FC3 FD 21 0F 00 0049*       ld iy,0+15
       00          
045FC8 CD 9F 19 04 0050*       call vdu_plot_rf
045FCC             0051*   ; draw the ships remaining
045FCC 21 2B 00 00 0052*       ld hl,BUF_SHIP_MFD
045FD0 CD 2C 15 04 0053*       call vdu_buff_select
045FD4 3A A4 5F 04 0054*       ld a,(player_ships) ; loop counter
045FD8 01 00 00 00 0055*       ld bc,0 ; starting x-coordinate
045FDC             0056*   @loop:
045FDC 3D          0057*       dec a ; we don't count the ship we're flying
045FDD C8          0058*       ret z
045FDE F5          0059*       push af ; back up loop counter
045FDF C5          0060*       push bc ; save x-coordinate
045FE0 11 00 00 00 0061*       ld de,0 ; y-coordinate
045FE4 CD 62 19 04 0062*       call vdu_plot_bmp
045FE8 C1          0063*       pop bc ; restore x-coordinate
045FE9 21 10 00 00 0064*       ld hl,16 ; bump x-coords
045FED 09          0065*       add hl,bc
045FEE E5          0066*       push hl
045FEF C1          0067*       pop bc ; bc = new x-coordinate
045FF0 F1          0068*       pop af
045FF1 C3 DC 5F 04 0069*       jp @loop
045FF5 C9          0070*       ret
045FF6             0071*   ; end draw_player_ships
045FF6             0072*   
045FF6             0073*   do_player:
045FF6 2A 9C 5F 04 0074*       ld hl,(player_state)
045FFA CD 16 60 04 0075*       call player_state_pointer_valid
045FFE DA 0F 60 04 0076*       jp c,@dispatch
046002 21 A0 5F 04 0077*       ld hl,player_fault_flags
046006 CB C6       0078*       set player_fault_bad_state,(hl)
046008 3E 01       0079*       ld a,player_event_game_over
04600A 32 9F 5F 04 0080*       ld (player_event),a
04600E C9          0081*       ret
04600F             0082*   @dispatch:
04600F             0083*       CALL_HL
                       M1 Args: none
04600F 01 15 60 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
046013 C5          0002*M1     push bc ; which constitutes the return address
046014 E9          0003*M1     jp (hl) ; Jump to the address in HL
046015 C9          0084*       ret
046016             0085*   ; end do_player
046016             0086*   
046016             0087*   ; Exact stabilization whitelist for writable legacy player-state pointers.
046016             0088*   ; Invalid actor state is surfaced as an event for the global coordinator.
046016             0089*   player_state_pointer_valid:
046016 11 E2 60 04 0090*       ld de,player_alive
04601A CD 3E 60 04 0091*       call @matches
04601E CA 3C 60 04 0092*       jp z,@valid
046022 11 25 61 04 0093*       ld de,player_dying
046026 CD 3E 60 04 0094*       call @matches
04602A CA 3C 60 04 0095*       jp z,@valid
04602E 11 0C 62 04 0096*       ld de,player_dead
046032 CD 3E 60 04 0097*       call @matches
046036 CA 3C 60 04 0098*       jp z,@valid
04603A AF          0099*       xor a
04603B C9          0100*       ret
04603C             0101*   @valid:
04603C 37          0102*       scf
04603D C9          0103*       ret
04603E             0104*   @matches:
04603E E5          0105*       push hl
04603F B7          0106*       or a
046040 ED 52       0107*       sbc hl,de
046042 E1          0108*       pop hl
046043 C9          0109*       ret
046044             0110*   ; end player_state_pointer_valid
046044             0111*   
046044             0112*   ; set initial player position
046044             0113*   ; inputs: none,everything is hardcoded
046044             0114*   ; outputs: player_x/y set to bottom-left corner of screen
046044             0115*   ; destroys: pretty much everything
046044             0116*   player_init:
046044 3A 40 67 04 0117*       ld a,(player_shields_max)
046048 32 3F 67 04 0118*       ld (player_shields),a
04604C 3A DB 65 04 0119*       ld a,(laser_power_max)
046050 32 D9 65 04 0120*       ld (laser_power),a
046054 3A B9 64 04 0121*       ld a,(player_fuel_max)
046058 32 B7 64 04 0122*       ld (player_fuel),a
04605C             0123*   ; Gameplay timers belong to a life, not to the cockpit drawing routines.
04605C 3A DE 65 04 0124*       ld a,(charge_laser_timer_max)
046060 32 DD 65 04 0125*       ld (charge_laser_timer),a
046064 3A BB 64 04 0126*       ld a,(discharge_fuel_timer_max)
046068 32 BA 64 04 0127*       ld (discharge_fuel_timer),a
04606C             0128*   ; set all to zero so they will update
04606C AF          0129*       xor a
04606D 32 DA 65 04 0130*       ld (laser_power_last),a
046071 32 41 67 04 0131*       ld (player_shields_last),a
046075 32 B8 64 04 0132*       ld (player_fuel_last),a
046079             0133*   ; A live player must not expose stale diagnostics from the previous death.
046079 32 A1 5F 04 0134*       ld (player_dying_phase),a
04607D 32 A2 5F 04 0135*       ld (player_dying_timer),a
046081 32 A3 5F 04 0136*       ld (player_dying_spawns),a
046085             0137*   ; set player sprite record with defaults
046085 DD 21 D8 8E 0138*       ld ix,player_begin
       04          
04608A 21 89 5F 04 0139*       ld hl,player_defaults
04608E 01 00 00 00 0140*       ld bc,0*256
046092 11 00 40 01 0141*       ld de,sprite_bottom*256
046096 3E 01       0142*       ld a,1
046098 CD AD 68 04 0143*       call spawn_sprite_from_coords
04609C D0          0144*       ret nc ; IX is invalid when the one-record player pool is full
04609D DD CB 16 BE 0145*       res 7,(ix+sprite_type)
0460A1             0146*   ; load sprite frames
0460A1 DD 7E 00    0147*       ld a,(ix+sprite_id)
0460A4 CD 03 1A 04 0148*       call vdu_sprite_select
0460A8 CD 16 1A 04 0149*       call vdu_sprite_clear_frames
0460AC 21 73 01 00 0150*       ld hl,BUF_SHIP_0L
0460B0 CD 58 1B 04 0151*       call vdu_sprite_add_buff
0460B4 21 74 01 00 0152*       ld hl,BUF_SHIP_1C
0460B8 CD 58 1B 04 0153*       call vdu_sprite_add_buff
0460BC 21 75 01 00 0154*       ld hl,BUF_SHIP_2R
0460C0 CD 58 1B 04 0155*       call vdu_sprite_add_buff
0460C4             0156*   @draw:
0460C4 01 00 00 00 0157*       ld bc,0*256
0460C8 11 00 40 01 0158*       ld de,sprite_bottom*256
0460CC CD CF 1A 04 0159*       call vdu_sprite_move_abs168
0460D0 CD 79 1A 04 0160*       call vdu_sprite_show
0460D4 21 E2 60 04 0161*       ld hl,player_alive
0460D8 22 9C 5F 04 0162*       ld (player_state),hl
0460DC DD CB 1D F6 0163*       set sprite_alive,(ix+sprite_collisions)
0460E0 37          0164*       scf ; publish successful initialization to the caller
0460E1 C9          0165*       ret
0460E2             0166*   ; end player_init
0460E2             0167*   
0460E2             0168*   player_alive:
0460E2 CD F4 64 04 0169*       call player_input
0460E6 CD 42 66 04 0170*       call player_move_weapons
0460EA C9          0171*       ret
0460EB             0172*   ; end player_alive
0460EB             0173*   
0460EB             0174*   kill_player:
0460EB             0175*   ; update_shields callers still own their collision-record index registers
0460EB F5          0176*       push af
0460EC C5          0177*       push bc
0460ED DD E5       0178*       push ix
0460EF FD E5       0179*       push iy
0460F1             0180*   ; set player collision flag to dead
0460F1 DD 21 D8 8E 0181*       ld ix,player_begin
       04          
0460F6 DD CB 1D B6 0182*       res sprite_alive,(ix+sprite_collisions)
0460FA             0183*   ; change seeker move program to move_enemy_seeker_orbit
0460FA FD 21 18 8F 0184*       ld iy,seekers_base
       04          
0460FF 21 94 4B 04 0185*       ld hl,move_enemy_seeker_orbit
046103 06 03       0186*       ld b,seekers_max
046105 CD A9 6A 04 0187*       call change_sprite_group_move_program
046109             0188*   ; set player state to dying
046109 AF          0189*       xor a
04610A 32 A1 5F 04 0190*       ld (player_dying_phase),a
04610E 32 A2 5F 04 0191*       ld (player_dying_timer),a
046112 32 A3 5F 04 0192*       ld (player_dying_spawns),a
046116 21 25 61 04 0193*       ld hl,player_dying
04611A 22 9C 5F 04 0194*       ld (player_state),hl
04611E FD E1       0195*       pop iy
046120 DD E1       0196*       pop ix
046122 C1          0197*       pop bc
046123 F1          0198*       pop af
046124 C9          0199*       ret
046125             0200*   ; end kill_player
046125             0201*   
046125             0202*   player_dying:
046125             0203*   ; This actor update is deliberately bounded to one frame. The global playing
046125             0204*   ; loop, not the actor, advances enemies, explosions, tiles, and VBlank.
046125 CD 42 66 04 0205*       call player_move_weapons
046129 3A A1 5F 04 0206*       ld a,(player_dying_phase)
04612D B7          0207*       or a
04612E CA 5F 61 04 0208*       jp z,@initial
046132 FE 01       0209*       cp player_dying_phase_delay
046134 CA A6 61 04 0210*       jp z,@delay
046138 FE 02       0211*       cp player_dying_phase_finale
04613A CA BE 61 04 0212*       jp z,@finale
04613E             0213*   ; Finish only after the finale explosions have had their full lifetime.
04613E 3A A2 5F 04 0214*       ld a,(player_dying_timer)
046142 3C          0215*       inc a
046143 32 A2 5F 04 0216*       ld (player_dying_timer),a
046147 FE 28       0217*       cp player_dying_finish_frames
046149 D8          0218*       ret c
04614A 3E 10       0219*       ld a,STATE_NEW_EVENT_PLAYER_DEAD
04614C CD 37 88 04 0220*       call telemetry_post_events
046150 3E 02       0221*       ld a,TELEMETRY_LIFECYCLE_PLAYER_DEAD
046152 CD 3E 88 04 0222*       call telemetry_post_lifecycle
046156 21 0C 62 04 0223*       ld hl,player_dead
04615A 22 9C 5F 04 0224*       ld (player_state),hl
04615E C9          0225*       ret
04615F             0226*   
04615F             0227*   @initial:
04615F             0228*   ; Preserve the old cadence: one rising explosion every sixteen outer frames.
04615F 3A A2 5F 04 0229*       ld a,(player_dying_timer)
046163 B7          0230*       or a
046164 C2 87 61 04 0231*       jp nz,@tick_initial
046168 CD 03 4D 04 0232*       call spawn_explosion_player
04616C D2 7E 61 04 0233*       jp nc,@initial_spawned
046170 21 00 00 00 0234*       ld hl,0
046174 DD 2F 07    0235*       ld (ix+sprite_xvel),hl
046177 21 00 01 00 0236*       ld hl,1*256
04617B DD 2F 0A    0237*       ld (ix+sprite_yvel),hl
04617E             0238*   @initial_spawned:
04617E 3A A3 5F 04 0239*       ld a,(player_dying_spawns)
046182 3C          0240*       inc a
046183 32 A3 5F 04 0241*       ld (player_dying_spawns),a
046187             0242*   @tick_initial:
046187 3A A2 5F 04 0243*       ld a,(player_dying_timer)
04618B 3C          0244*       inc a
04618C E6 0F       0245*       and 15
04618E 32 A2 5F 04 0246*       ld (player_dying_timer),a
046192 C0          0247*       ret nz
046193 3A A3 5F 04 0248*       ld a,(player_dying_spawns)
046197 FE 10       0249*       cp 16
046199 D8          0250*       ret c
04619A 3E 01       0251*       ld a,player_dying_phase_delay
04619C 32 A1 5F 04 0252*       ld (player_dying_phase),a
0461A0 AF          0253*       xor a
0461A1 32 A3 5F 04 0254*       ld (player_dying_spawns),a
0461A5 C9          0255*       ret
0461A6             0256*   
0461A6             0257*   @delay:
0461A6 3A A2 5F 04 0258*       ld a,(player_dying_timer)
0461AA 3C          0259*       inc a
0461AB 32 A2 5F 04 0260*       ld (player_dying_timer),a
0461AF FE 10       0261*       cp 16
0461B1 D8          0262*       ret c
0461B2 AF          0263*       xor a
0461B3 32 A2 5F 04 0264*       ld (player_dying_timer),a
0461B7 3E 02       0265*       ld a,player_dying_phase_finale
0461B9 32 A1 5F 04 0266*       ld (player_dying_phase),a
0461BD C9          0267*       ret
0461BE             0268*   
0461BE             0269*   @finale:
0461BE             0270*   ; Spread allocations across frames so pool pressure can never turn this actor
0461BE             0271*   ; into a blocking burst. Allocation failure remains a harmless skipped effect.
0461BE CD 03 4D 04 0272*       call spawn_explosion_player
0461C2 D2 D4 61 04 0273*       jp nc,@finale_spawned
0461C6 CD EC 61 04 0274*       call @rand
0461CA DD 2F 07    0275*       ld (ix+sprite_xvel),hl
0461CD CD EC 61 04 0276*       call @rand
0461D1 DD 2F 0A    0277*       ld (ix+sprite_yvel),hl
0461D4             0278*   @finale_spawned:
0461D4 3A A3 5F 04 0279*       ld a,(player_dying_spawns)
0461D8 3C          0280*       inc a
0461D9 32 A3 5F 04 0281*       ld (player_dying_spawns),a
0461DD FE 08       0282*       cp explosions_max
0461DF D8          0283*       ret c
0461E0 AF          0284*       xor a
0461E1 32 A2 5F 04 0285*       ld (player_dying_timer),a
0461E5 3E 03       0286*       ld a,player_dying_phase_finish
0461E7 32 A1 5F 04 0287*       ld (player_dying_phase),a
0461EB C9          0288*       ret
0461EC             0289*   @rand:
0461EC 21 00 00 00 0290*       ld hl,0
0461F0 CD 14 05 04 0291*       call rand_8
0461F4 47          0292*       ld b,a
0461F5 E6 01       0293*       and %00000001
0461F7 67          0294*       ld h,a
0461F8 68          0295*       ld l,b
0461F9 CB 78       0296*       bit 7,b
0461FB C8          0297*       ret z
0461FC CD 7C 04 04 0298*       call neg_hlu
046200 C9          0299*       ret
046201             0300*   ; end player_dying
