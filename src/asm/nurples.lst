048DF7             0024*   
048DF7             0025*   move_crater:
048DF7 CD 23 8D 04 0026*       call move_active_tile
048DFB CA C5 8A 04 0027*       jp z,table_deactivate_tile
048DFF             0028*   ; do animation
048DFF FD 35 23    0029*       dec (iy+tile_animation_timer)
048E02 C0          0030*       ret nz ; not time to animate
048E03 FD 35 22    0031*       dec (iy+sprite_animation) ; check whether time to transition to crater
048E06 CC 1C 8E 04 0032*       call z,@make_crater
048E0A 3E 08       0033*       ld a,8
048E0C FD 77 23    0034*       ld (iy+tile_animation_timer),a
048E0F FD 7E 28    0035*       ld a,(iy+tile_frame)
048E12 3C          0036*       inc a
048E13 E6 03       0037*       and %00000011 ; modulo 4
048E15 FD 77 28    0038*       ld (iy+tile_frame),a
048E18 C3 77 8D 04 0039*       jp draw_active_tile
048E1C             0040*   @make_crater:
048E1C 21 00 01 00 0041*       ld hl,BUF_CRATER_0
048E20 FD 2F 17    0042*       ld (iy+tile_base_bufferId),hl
048E23 3E FF       0043*       ld a,-1 ; will wrap to zero on return
048E25 FD 77 28    0044*       ld (iy+tile_frame),a
048E28 C9          0045*       ret
048E29             0046*   ; end move_crater
048E29             0076        include "tile_electrode.inc"
048E29             0001*   electrode_defaults:
048E29 09          0002*       db 9                    ; type
048E2A 76 01 00    0003*       dl BUF_TILE_BLANK       ; base_bufferId
048E2D 45 8E 04    0004*       dl move_electrode       ; move_program
048E30 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
048E31 10          0006*       db 16                   ; dim_x
048E32 10          0007*       db 16                   ; dim_y
048E33 01          0008*       db 1                    ; num_orientations
048E34 01          0009*       db 1                    ; num_animations
048E35 00          0010*       db 0                    ; animation
048E36 00          0011*       db 0                    ; animation_timer
048E37 00          0012*       db 0                    ; move_timer
048E38 00          0013*       db 0                    ; move_step
048E39 05          0014*       db 5                    ; points
048E3A FC          0015*       db -4                   ; shield_damage
048E3B 00          0016*       db 0                    ; frame
048E3C             0017*   
048E3C             0018*   activate_electrode:
048E3C 21 29 8E 04 0019*       ld hl,electrode_defaults
048E40             0020*   ; get next available active tile id
048E40 CD 02 8B 04 0021*       call spawn_active_tile
048E44             0022*       ; ret nc ; no carry means no free active tile slots, so we go home
048E44             0023*   ; other specific initialization
048E44 C9          0024*       ret
048E45             0025*   ; end activate_electrode
048E45             0026*   
048E45             0027*   move_electrode:
048E45 CD 23 8D 04 0028*       call move_active_tile
048E49 CA C5 8A 04 0029*       jp z,table_deactivate_tile
048E4D DD 21 9E 9C 0030*       ld ix,player_begin
       04          
048E52 DD CB 1D 76 0031*       bit sprite_alive,(ix+sprite_collisions)
048E56 CA 6A 8E 04 0032*       jp z,@laser ; player is dead so don't check for collisions
048E5A CD 16 20 04 0033*       call check_enemy_collision_player
048E5E C2 6A 8E 04 0034*       jp nz,@laser ; no collision so check laser collision
048E62 CD 70 80 04 0035*       call update_shields
048E66 C3 77 8E 04 0036*       jp kill_electrode
048E6A             0037*   @laser:
048E6A CD 0A 20 04 0038*       call check_enemy_collision_laser
048E6E C0          0039*       ret nz ; no collision so we're done
048E6F CD 13 80 04 0040*       call update_score
048E73 C3 77 8E 04 0041*       jp kill_electrode
048E77             0042*   ; end move_electrode
048E77             0043*   
048E77             0044*   kill_electrode:
048E77             0045*   ; activate blank tile bitmap
048E77 21 76 01 00 0046*       ld hl,BUF_TILE_BLANK
048E7B CD 3C 14 04 0047*       call vdu_buff_select
048E7F             0048*   ; save y-coordinate of collision tile
048E7F FD 27 04    0049*       ld hl,(iy+tile_y)
048E82 22 31 8F 04 0050*       ld (@tile_y),hl
048E86             0051*   ; initialize pointers
048E86 2A 30 8A 04 0052*       ld hl,(tile_stack_pointer)
048E8A ED 27       0053*       ld hl,(hl) ; pointer to this tile table record
048E8C E5          0054*       push hl ; save pointer to this tile table record
048E8D DD 21 2D 87 0055*       ld ix,tile_stack ; set ix to first record in table
       04          
048E92             0056*   @check_loop:
048E92 DD 22 2E 8F 0057*       ld (@tile_stack_pointer),ix ; update stack pointer
       04          
048E97 DD 7E 02    0058*       ld a,(ix+2)
048E9A B7          0059*       or a ; will be zero if at end of stack
048E9B CA 07 8F 04 0060*       jp z,@done ; end of stack so we're done
048E9F             0061*   ; point ix to tile record
048E9F DD 37 00    0062*       ld ix,(ix) ; ix points to the tile record being checked
048EA2             0063*   ; check top bit of tile_type to see if tile is just spawned
048EA2 DD CB 16 7E 0064*       bit 7,(ix+tile_type)
048EA6 C2 FB 8E 04 0065*       jp nz,@next_record ; if just spawned, skip to next record
048EAA             0066*   ; check sprite_alive bit to see if tile is active
048EAA DD CB 1D 76 0067*       bit sprite_alive,(ix+sprite_collisions)
048EAE C8          0068*       ret z ; end of stack so we're done
048EAF             0069*   ; check tile type
048EAF DD 7E 16    0070*       ld a,(ix+tile_type)
048EB2 FE 0A       0071*       cp tile_lightning ; check if tile is lightning
048EB4 C2 FB 8E 04 0072*       jp nz,@next_record ; if not an electrode, skip to next record
048EB8             0073*   ; check tile position
048EB8 FD 2A 2E 8F 0074*       ld iy,(@tile_stack_pointer)
       04          
048EBD FD 22 30 8A 0075*       ld (tile_stack_pointer),iy
       04          
048EC2 FD 37 00    0076*       ld iy,(iy) ; pointer to tile record to kill
048EC5 FD 22 33 8A 0077*       ld (tile_table_pointer),iy
       04          
048ECA DD 27 04    0078*       ld hl,(ix+tile_y)
048ECD ED 5B 31 8F 0079*       ld de,(@tile_y)
       04          
048ED2 B7          0080*       or a ; clear carry
048ED3 E5          0081*       push hl
048ED4 ED 52       0082*       sbc hl,de
048ED6 E1          0083*       pop hl
048ED7 CA E7 8E 04 0084*       jp z,@kill_it
048EDB 01 00 01 00 0085*       ld bc,1*256
048EDF 09          0086*       add hl,bc
048EE0 B7          0087*       or a
048EE1 ED 52       0088*       sbc hl,de
048EE3 C2 FB 8E 04 0089*       jp nz,@next_record
048EE7             0090*   @kill_it: ; deactivate tile and replace with inactive blank tile
048EE7 FD 07 01    0091*       ld bc,(iy+tile_x) ; get x position (ud.e already has y-position)
048EEA CD 58 18 04 0092*       call vdu_plot_bmp168 ; plot blank tile (bitmap was activated at beginning of proc)
048EEE CD C5 8A 04 0093*       call table_deactivate_tile
048EF2 DD 2A 2E 8F 0094*       ld ix,(@tile_stack_pointer) ; get back stack pointer
       04          
048EF7 C3 92 8E 04 0095*       jp @check_loop ; deactivate tile naturally advances to next record
048EFB             0096*    ; get back stack pointer and loop
048EFB             0097*   @next_record:
048EFB DD 2A 2E 8F 0098*       ld ix,(@tile_stack_pointer)
       04          
048F00 ED 32 03    0099*       lea ix,ix+3 ; next tile stack record
048F03 C3 92 8E 04 0100*       jp @check_loop ; loop until we've checked all the records
048F07             0101*   @done:
048F07             0102*   ; find this tile record in the tile stack
048F07 D1          0103*       pop de ; restore pointer to this tile table record (was hl)
048F08 FD 21 2D 87 0104*       ld iy,tile_stack ; set ix to first record in table
       04          
048F0D             0105*   @find_loop:
048F0D FD 27 00    0106*       ld hl,(iy)
048F10 ED 33 03    0107*       lea iy,iy+3 ; next tile stack record
048F13 B7          0108*       or a ; clear carry
048F14 ED 52       0109*       sbc hl,de ; if not the same address, loop
048F16 C2 0D 8F 04 0110*       jp nz,@find_loop
048F1A ED 33 FD    0111*       lea iy,iy-3 ; back up to the record we want
048F1D FD 22 30 8A 0112*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
048F22 FD 37 00    0113*       ld iy,(iy) ; iy points to the tile stack record
048F25 FD 22 33 8A 0114*       ld (tile_table_pointer),iy ; set pointer to this tile record
       04          
048F2A C3 EE 8D 04 0115*       jp activate_crater
048F2E 2D 87 04    0116*   @tile_stack_pointer: dl tile_stack ; pointer to current stack record, initialized to tile_stack
048F31 00 00 00    0117*   @tile_y: dl 0 ; y position of tiles to kill
