043BAA             0209*   agnb_io_buffer_size:       equ 8192
043BAA             0210*   
043BAA             0211*   ; Application callback invoked after each image has been finalized.
043BAA 00 00 00    0212*   agnb_image_callback:       dl 0
043BAD             0213*   
043BAD             0214*   ; Reader subroutine interface
043BAD             0215*   ; ---------------------------
043BAD             0216*   ; These labels establish the intended decomposition and calling contracts.
043BAD             0217*   ; They deliberately fail with agnb_error_not_implemented until replaced with
043BAD             0218*   ; real code, preventing an incomplete loader from reporting false success.
043BAD             0219*   
043BAD             0220*   ; Compare two FourCC values.
043BAD             0221*   ; inputs:  HL = pointer to first FourCC, DE = pointer to second FourCC
043BAD             0222*   ; outputs: Z set when all four bytes match, Z reset when any byte differs
043BAD             0223*   ; preserves: BC, DE, HL
043BAD             0224*   ; destroys: A
043BAD             0225*   agnb_compare_fourcc:
043BAD C5          0226*       push bc
043BAE D5          0227*       push de
043BAF E5          0228*       push hl
043BB0 06 04       0229*       ld b,4
043BB2             0230*   @loop:
043BB2 1A          0231*       ld a,(de)
043BB3 BE          0232*       cp (hl)
043BB4 20 04       0233*       jr nz,@done ; exit with Z reset if any byte differs, indicating a mismatch
043BB6 13          0234*       inc de
043BB7 23          0235*       inc hl
043BB8 10 F8       0236*       djnz @loop ; if we fall throgh at the end of the loop Z is set, indicating a match
043BBA             0237*   @done:
043BBA E1          0238*       pop hl
043BBB D1          0239*       pop de
043BBC C1          0240*       pop bc
043BBD C9          0241*       ret
043BBE             0242*   
043BBE             0243*   ; Open a container for reading.
043BBE             0244*   ; inputs:  DE = zero-terminated filename (normally agnb_filename)
043BBE             0245*   ; outputs: A=0 and Z set on success; A=agnb_error_open and NZ set on failure
043BBE             0246*   ;          agnb_fil initialized and agnb_file_is_open set on success
043BBE             0247*   ; destroys: AF, BC, HL
043BBE             0248*   agnb_open:
043BBE             0249*   ; begin fail-closed: do not leave stale success state if ffs_fopen fails
043BBE AF          0250*       xor a
043BBF 32 9D 1B 04 0251*       ld (agnb_file_is_open),a
043BC3 32 9C 1B 04 0252*       ld (agnb_last_error),a
043BC7             0253*   
043BC7             0254*   ; Each newly opened container starts at physical and logical offset zero.
043BC7             0255*   ; The original single-container caller received this state from BSS
043BC7             0256*   ; initialization; consecutive container loads must establish it explicitly.
043BC7 21 00 00 00 0257*       ld hl,0
043BCB 22 7D 1B 04 0258*       ld (agnb_state+agnb_state_file_offset),hl
043BCF 22 81 1B 04 0259*       ld (agnb_state+agnb_state_bytes_read),hl
043BD3 32 80 1B 04 0260*       ld (agnb_state+agnb_state_file_offset+3),a
043BD7 32 84 1B 04 0261*       ld (agnb_state+agnb_state_bytes_read+3),a
043BDB             0262*   
043BDB             0263*   ; open the caller-supplied filename into our single reader-owned FIL
043BDB 21 45 1B 04 0264*       ld hl,agnb_fil
043BDF 0E 01       0265*       ld c,fa_read
043BE1             0266*       FFSCALL ffs_fopen
                       M1 Args: function=ffs_fopen 
043BE1 FD E5       0001*M1     push iy
043BE3 3E 80       0002*M1     ld a,function
043BE5 5B CF       0003*M1     rst.lil $08
043BE7 FD E1       0004*M1     pop iy
043BE9 B7          0267*       or a
043BEA 20 08       0268*       jr nz,@error
043BEC             0269*   
043BEC             0270*   ; ffs_fopen succeeded
043BEC 3E 01       0271*       ld a,1
043BEE 32 9D 1B 04 0272*       ld (agnb_file_is_open),a
043BF2 AF          0273*       xor a
043BF3 C9          0274*       ret
043BF4             0275*   
043BF4             0276*   @error:
043BF4 3E 01       0277*       ld a,agnb_error_open
043BF6 32 9C 1B 04 0278*       ld (agnb_last_error),a
043BFA B7          0279*       or a
043BFB C9          0280*       ret
043BFC             0281*   
043BFC             0282*   ; Close agnb_fil if open and clear agnb_file_is_open.
043BFC             0283*   ; outputs: A=0 and Z set if closed or already closed
043BFC             0284*   ;          nonzero FatFS result and NZ set if ffs_fclose fails
043BFC             0285*   ; destroys: HL
043BFC             0286*   agnb_close:
043BFC             0287*   ; An unopened file is already in the requested state.
043BFC 3A 9D 1B 04 0288*       ld a,(agnb_file_is_open)
043C00 B7          0289*       or a
043C01 28 14       0290*       jr z,@success
043C03             0291*   
043C03             0292*   ; Close our single reader-owned FIL.
043C03 21 45 1B 04 0293*       ld hl,agnb_fil
043C07             0294*       FFSCALL ffs_fclose
                       M1 Args: function=ffs_fclose 
043C07 FD E5       0001*M1     push iy
043C09 3E 81       0002*M1     ld a,function
043C0B 5B CF       0003*M1     rst.lil $08
043C0D FD E1       0004*M1     pop iy
043C0F B7          0295*       or a
043C10 20 0B       0296*       jr nz,agnb_error_close
043C12             0297*   
043C12             0298*   ; Only clear the open flag after FatFS confirms the close.
043C12 AF          0299*       xor a
043C13 32 9D 1B 04 0300*       ld (agnb_file_is_open),a
043C17             0301*   @success:
043C17 AF          0302*       xor a
043C18 32 9C 1B 04 0303*       ld (agnb_last_error),a
043C1C C9          0304*       ret
043C1D             0305*   
043C1D             0306*   agnb_error_close:
043C1D             0307*   ; Placeholder in case we determine that close failures need a dedicated AGNB
043C1D             0308*   ; error code or recovery path. For now retain and return the nonzero FRESULT,
043C1D             0309*   ; and leave agnb_file_is_open set because FatFS did not confirm the close.
043C1D 32 9C 1B 04 0310*       ld (agnb_last_error),a
043C21 B7          0311*       or a
043C22 C9          0312*       ret
043C23             0313*   
043C23             0314*   ; Top-level image load operation.
043C23             0315*   ; inputs:  DE = zero-terminated container filename
043C23             0316*   ; outputs: A=0 and Z set after all valid LIST BUFR image records are uploaded
043C23             0317*   ;          and finalized at their explicit IDs; nonzero error and NZ otherwise
043C23             0318*   ; destroys: AF, BC, DE, HL, IX
043C23             0319*   agnb_load_images:
043C23 21 92 3C 04 0320*       ld hl,agnb_image_callback_noop
043C27             0321*   
043C27             0322*   ; Callback-enabled image loader.
043C27             0323*   ; inputs: DE = filename; HL = callback whose result is ignored
043C27             0324*   agnb_load_images_with_callback:
043C27 22 AA 3B 04 0325*       ld (agnb_image_callback),hl
043C2B CD BE 3B 04 0326*       call agnb_open
043C2F C0          0327*       ret nz
043C30             0328*   
043C30 CD 09 3D 04 0329*       call agnb_read_riff_header
043C34 20 47       0330*       jr nz,@load_error
043C36 CD DD 3D 04 0331*       call agnb_read_vers
043C3A 20 41       0332*       jr nz,@load_error
043C3C             0333*   
043C3C             0334*   @next_record:
043C3C             0335*   ; End only at the exact declared RIFF boundary. A position beyond it is an
043C3C             0336*   ; internal bounds failure; a position before it must begin another LIST BUFR.
043C3C 3A 80 1B 04 0337*       ld a,(agnb_state+agnb_state_file_offset+3)
043C40 21 70 1B 04 0338*       ld hl,agnb_state+agnb_state_riff_end+3
043C44 BE          0339*       cp (hl)
043C45 38 12       0340*       jr c,@read_record
043C47 20 2E       0341*       jr nz,@bad_bounds
043C49 2A 7D 1B 04 0342*       ld hl,(agnb_state+agnb_state_file_offset)
043C4D ED 5B 6D 1B 0343*       ld de,(agnb_state+agnb_state_riff_end)
       04          
043C52 B7          0344*       or a
043C53 ED 52       0345*       sbc hl,de
043C55 28 32       0346*       jr z,@success
043C57 30 1E       0347*       jr nc,@bad_bounds
043C59             0348*   
043C59             0349*   @read_record:
043C59 CD 48 3E 04 0350*       call agnb_read_buffer_list
043C5D 20 1E       0351*       jr nz,@load_error
043C5F CD 65 40 04 0352*       call agnb_stream_data
043C63 20 18       0353*       jr nz,@load_error
043C65 CD 05 41 04 0354*       call agnb_finalize_image
043C69 20 12       0355*       jr nz,@load_error
043C6B             0356*   
043C6B             0357*   ; Give the application one completed-bitmap boundary per record.
043C6B             0358*   ; Metadata remains valid for the duration of the callback.
043C6B CD 8D 3C 04 0359*       call agnb_call_image_callback
043C6F             0360*   
043C6F CD 2E 41 04 0361*       call agnb_finish_buffer_list
043C73 20 08       0362*       jr nz,@load_error
043C75 18 C5       0363*       jr @next_record
043C77             0364*   
043C77             0365*   @bad_bounds:
043C77 3E 08       0366*       ld a,agnb_error_bounds
043C79 32 9C 1B 04 0367*       ld (agnb_last_error),a
043C7D             0368*   @load_error:
043C7D             0369*   ; Preserve the parser/transport error while still closing the open file.
043C7D F5          0370*       push af
043C7E CD FC 3B 04 0371*       call agnb_close
043C82 F1          0372*       pop af
043C83 32 9C 1B 04 0373*       ld (agnb_last_error),a
043C87 B7          0374*       or a
043C88 C9          0375*       ret
043C89             0376*   
043C89             0377*   @success:
043C89 C3 FC 3B 04 0378*       jp agnb_close
043C8D             0379*   
043C8D             0380*   ; The CALL above has already stacked the continuation address. Tail-jump to
043C8D             0381*   ; the selected callback so its RET resumes the loader without clobbering BC.
043C8D             0382*   agnb_call_image_callback:
043C8D 2A AA 3B 04 0383*       ld hl,(agnb_image_callback)
043C91 E9          0384*       jp (hl)
043C92             0385*   
043C92             0386*   agnb_image_callback_noop:
043C92 AF          0387*       xor a
043C93 C9          0388*       ret
043C94             0389*   
043C94             0390*   ; Read exactly BC bytes from agnb_fil into DE.
043C94             0391*   ; inputs:  BC = requested u24 length, DE = destination
043C94             0392*   ; outputs: A=0 and Z set after the complete request is satisfied
043C94             0393*   ;          nonzero error code and NZ set on FatFS error or premature EOF
043C94             0394*   ;          state offset/count updated after every successful FatFS read
043C94             0395*   ; destroys: BC, DE, HL
043C94             0396*   agnb_read_exact:
043C94             0397*   ; A zero-length request is already complete.
043C94 21 00 00 00 0398*       ld hl,0
043C98 B7          0399*       or a
043C99 ED 42       0400*       sbc hl,bc
043C9B 28 62       0401*       jr z,@success
043C9D             0402*   
043C9D             0403*   @read:
043C9D             0404*   ; ffs_fread replaces BC with the number of bytes actually read, so retain the
043C9D             0405*   ; remaining request on the stack. It preserves DE, our current destination.
043C9D C5          0406*       push bc
043C9E 21 45 1B 04 0407*       ld hl,agnb_fil
043CA2             0408*       FFSCALL ffs_fread
                       M1 Args: function=ffs_fread 
043CA2 FD E5       0001*M1     push iy
043CA4 3E 82       0002*M1     ld a,function
043CA6 5B CF       0003*M1     rst.lil $08
043CA8 FD E1       0004*M1     pop iy
043CAA B7          0409*       or a
