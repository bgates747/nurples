0469E3             0465*   move_sprite:
0469E3 FD 2A DD 66 0466*       ld iy,(table_pointer)
       04          
0469E8             0467*   ; x-axis movement
0469E8 FD 27 01    0468*       ld hl,(iy+sprite_x)
0469EB FD 17 07    0469*       ld de,(iy+sprite_xvel)
0469EE 19          0470*       add hl,de
0469EF FD 2F 01    0471*       ld (iy+sprite_x),hl
0469F2             0472*   ; y-axis movement
