04636B 21 EF FF FF 0231*       ld hl,-bar_red
04636F 19          0232*       add hl,de
046370 D2 8D 63 04 0233*       jp nc,@red
046374 21 DF FF FF 0234*       ld hl,-bar_yellow
046378 19          0235*       add hl,de
046379 D2 85 63 04 0236*       jp nc,@yellow
04637D 21 02 00 00 0237*       ld hl,BUF_BAR_H_2 ; green
046381 C3 91 63 04 0238*       jp @select
046385             0239*   @yellow:
046385 21 01 00 00 0240*       ld hl,BUF_BAR_H_1 ; yellow
046389 C3 91 63 04 0241*       jp @select
04638D             0242*   @red:
