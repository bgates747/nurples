044ACA             0063*   @animate:
044ACA             0064*   ; check the animation timer
044ACA FD 35 23    0065*       dec (iy+sprite_animation_timer)
044ACD C0          0066*       ret nz ; not time to animate
044ACE             0067*   ; reset the animation timer and bump animation
044ACE 3E 08       0068*       ld a,8
044AD0 FD 77 23    0069*       ld (iy+sprite_animation_timer),a
044AD3 FD 7E 22    0070*       ld a,(iy+sprite_animation)
044AD6 3C          0071*       inc a
044AD7 E6 01       0072*       and %00000001 ; modulo 2
044AD9 FD 77 22    0073*       ld (iy+sprite_animation),a
044ADC CD 06 6B 04 0074*       call sprite_frame_heading_animation ; a, sprite_frame set to heading-based frame
044AE0 CD 11 1A 04 0075*       call vdu_sprite_select_frame
044AE4 C9          0076*       ret
