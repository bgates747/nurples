044E89 01 00 00 00 0150*       ld bc,0
044E8D 11 00 00 00 0151*       ld de,field_top
044E91 CD 1A 19 04 0152*       call vdu_plot_bmp
044E95 21 02 04 00 0153*       ld hl,BUF_BG_STARS_4
044E99 CD E4 14 04 0154*       call vdu_buff_select
044E9D 01 00 00 00 0155*       ld bc,0
044EA1 11 00 01 00 0156*       ld de,field_top+256
044EA5 CD 1A 19 04 0157*       call vdu_plot_bmp
044EA9 C9          0158*       ret
