0479C9             0039*   init_bar_laser:
0479C9 DD 21 B7 79 0040*       ld ix,bar_laser
       04          
0479CE 21 00 00 00 0041*       ld hl,0
0479D2 3A B3 79 04 0042*       ld a,(laser_power_max)
0479D6 6F          0043*       ld l,a
0479D7 DD 2F 00    0044*       ld (ix+bar_val),hl
0479DA CD 7F 77 04 0045*       call bar_update_v
0479DE C9          0046*       ret
0479DF             0047*   ; end init_bar_laser
0479DF             0048*   
0479DF             0049*   init_player_laser:
0479DF             0050*   ; set pointer to laser sprite table
0479DF FD 21 E2 A3 0051*       ld iy,player_weapons_begin
       04          
0479E4 FD 7E 00    0052*       ld a,(iy+sprite_id) ; sprite id
0479E7 1E 04       0053*       ld e,player_lasers_max ; sprite loop counter
0479E9             0054*   ; define laser sprites
0479E9             0055*   @sprites_loop:
0479E9 F5          0056*       push af
0479EA D5          0057*       push de
0479EB CD 03 1A 04 0058*   	call vdu_sprite_select
0479EF CD 16 1A 04 0059*   	call vdu_sprite_clear_frames
0479F3 21 4E 01 00 0060*   	ld hl,BUF_LASER_A
0479F7 06 02       0061*   	ld b,2 ; two bitmaps for laser
0479F9             0062*   @frames_loop:
0479F9 C5          0063*   	push bc
0479FA E5          0064*   	push hl
0479FB CD 58 1B 04 0065*   	call vdu_sprite_add_buff
0479FF E1          0066*   	pop hl
047A00 23          0067*   	inc hl
047A01 C1          0068*   	pop bc
047A02 10 F5       0069*   	djnz @frames_loop
047A04 D1          0070*       pop de ; sprite loop counter
047A05 F1          0071*       pop af ; sprite id
047A06 3C          0072*       inc a
047A07 1D          0073*       dec e
047A08 C2 E9 79 04 0074*       jp nz,@sprites_loop
047A0C             0075*   ; set laser firing timer to zero
047A0C FD 21 A8 79 0076*       ld iy,tmr_laser
       04          
047A11 21 00 00 00 0077*       ld hl,0
047A15 CD E4 12 04 0078*       call timestamp_tmr_set
047A19 C9          0079*       ret
