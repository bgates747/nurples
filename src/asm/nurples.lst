047938             0059        include "player_state.inc"
047938             0001*   player_defaults:
047938 05          0002*       db player               ; type
047939 73 01 00    0003*       dl BUF_SHIP_0L          ; base_bufferId
04793C A0 79 04    0004*       dl do_player            ; move_program
04793F 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
047940 10          0006*       db 16                   ; dim_x
047941 10          0007*       db 16                   ; dim_y
047942 01          0008*       db 1                    ; num_orientations
047943 01          0009*       db 1                    ; num_animations
047944 00          0010*       db 0                    ; animation
047945 00          0011*       db 0                    ; animation_timer
047946 00          0012*       db 0                    ; move_timer
047947 00          0013*       db 0                    ; move_step
047948 00          0014*       db 0                    ; points
047949 00          0015*       db 0                    ; shield_damage
04794A 00          0016*       db 0                    ; frame
04794B             0017*   
04794B 2D 7A 04    0018*   player_state:  dl player_alive
04794E 00          0019*   player_ships: db 0
04794F 03          0020*   player_ships_max: db 3
047950             0021*   player_speed: equ 3*256 ; pixels per frame 16.8 fixed
047950             0022*   
047950             0023*   draw_player_ships:
047950             0024*   ; activate mfd
047950 DD 21 9D 7B 0025*       ld ix,mfd_ships
       04          
047955 CD A4 7C 04 0026*       call mfd_activate
047959             0027*   ; blank out previously drawn ships
047959 AF          0028*       xor a ; color mode 0
04795A 0E 00       0029*       ld c,c_black
04795C CD 89 13 04 0030*       call vdu_gcol
047960 01 00 00 00 0031*       ld bc,0
047964 11 00 00 00 0032*       ld de,0
047968 DD 21 4F 00 0033*       ld ix,0+79
       00          
04796D FD 21 0F 00 0034*       ld iy,0+15
       00          
047972 CD 79 18 04 0035*       call vdu_plot_rf
047976             0036*   ; draw the ships remaining
047976 21 2B 00 00 0037*       ld hl,BUF_SHIP_MFD
04797A CD 3C 14 04 0038*       call vdu_buff_select
04797E 3A 4E 79 04 0039*       ld a,(player_ships) ; loop counter
047982 01 00 00 00 0040*       ld bc,0 ; starting x-coordinate
047986             0041*   @loop:
047986 3D          0042*       dec a ; we don't count the ship we're flying
047987 C8          0043*       ret z
047988 F5          0044*       push af ; back up loop counter
047989 C5          0045*       push bc ; save x-coordinate
04798A 11 00 00 00 0046*       ld de,0 ; y-coordinate
04798E CD 3C 18 04 0047*       call vdu_plot_bmp
047992 C1          0048*       pop bc ; restore x-coordinate
047993 21 10 00 00 0049*       ld hl,16 ; bump x-coords
047997 09          0050*       add hl,bc
047998 E5          0051*       push hl
047999 C1          0052*       pop bc ; bc = new x-coordinate
04799A F1          0053*       pop af
04799B C3 86 79 04 0054*       jp @loop
04799F C9          0055*       ret
0479A0             0056*   ; end draw_player_ships
0479A0             0057*   
0479A0             0058*   do_player:
0479A0 2A 4B 79 04 0059*       ld hl,(player_state)
0479A4             0060*       CALL_HL
                       M1 Args: none
0479A4 01 AA 79 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
0479A8 C5          0002*M1     push bc ; which constitutes the return address
