047A9E             0001*   lightning_defaults:
047A9E 0A          0002*       db tile_lightning       ; type
047A9F 50 01 00    0003*       dl BUF_LIGHTNING_H_0    ; base_bufferId
047AA2 BB 7A 04    0004*       dl move_lightning       ; move_program
047AA5 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
047AA6 10          0006*       db 16                   ; dim_x
047AA7 10          0007*       db 16                   ; dim_y
047AA8 01          0008*       db 1                    ; num_orientations
047AA9 02          0009*       db 2                    ; num_animations
047AAA 00          0010*       db 0                    ; animation
047AAB 08          0011*       db 8                    ; animation_timer
047AAC 00          0012*       db 0                    ; move_timer
047AAD 00          0013*       db 0                    ; move_step
047AAE 00          0014*       db 0                    ; points
047AAF FF          0015*       db -1                    ; shield_damage
