044029 2B          0855*       dec hl
04402A 52 23       0856*       inc.s hl ; undocumented: preserves HL and clears HLU
04402C EB          0857*       ex de,hl
04402D 2A 87 1B 04 0858*       ld hl,(agnb_metadata+agnb_meta_width)
044031 2B          0859*       dec hl
044032 52 23       0860*       inc.s hl ; undocumented: preserves HL and clears HLU
044034 CD 63 03 04 0861*       call umul24
