048098             0001*   ; sprite_type
048098             0002*   enemy_dead: equ 0
048098             0003*   enemy_air: equ 1
048098             0004*   enemy_ground: equ 2
048098             0005*   enemy_projectile: equ 3
048098             0006*   explosion: equ 4
048098             0007*   player: equ 5
048098             0008*   player_air: equ 6
048098             0009*   player_ground: equ 7
048098             0010*   
048098             0011*   ; ###### SPRITE TABLE FIELD INDICES ######
048098             0012*   table_record_size:         equ  64; bytes per sprite record
048098             0013*   sprite_id:                 equ   0; 1 bytes ;unique spriteId, zero-based
048098             0014*   ; sprite state variables
048098             0015*   sprite_state_variables:    equ   1; beginning of sprite state variables
048098             0016*   sprite_x:                  equ   1; 3 bytes ;16.8 fractional x position in pixels
048098             0017*   sprite_y:                  equ   4; 3 bytes ;16.8 fractional y position in pixels
048098             0018*   sprite_xvel:               equ   7; 3 bytes ;x-component velocity, 16.8 fixed, pixels
048098             0019*   sprite_yvel:               equ  10; 3 bytes ;y-component velocity, 16.8 fixed, pixels
048098             0020*   sprite_vel:                equ  13; 3 bytes ;velocity px/frame (16.8 fixed)
048098             0021*   sprite_heading:            equ  16; 3 bytes ;sprite movement direction deg256 16.8 fixed
048098             0022*   sprite_orientation:        equ  19; 3 bytes ;orientation bits
048098             0023*   ; sprite definition variables
048098             0024*   sprite_definitions:        equ  22; beginnning of sprite definition variables
048098             0025*   sprite_type:               equ  22; 1 bytes ;type of sprite as defined in enemies.inc
048098             0026*   sprite_base_bufferId:      equ  23; 3 bytes ;bitmap bufferId
048098             0027*   sprite_move_program:       equ  26; 3 bytes ;address of sprite's behavior subroutine
048098             0028*   sprite_collisions:         equ  29; 1 bytes ;see collisions.inc constants for bit definitions
048098             0029*   sprite_dim_x:              equ  30; 1 bytes ;sprite width in pixels
048098             0030*   sprite_dim_y:              equ  31; 1 bytes ;sprite height in pixels
048098             0031*   sprite_num_orientations:   equ  32; 1 bytes ;number of orientations for this sprite
048098             0032*   sprite_num_animations:     equ  33; 1 bytes ;number of animations for this sprite
048098             0033*   sprite_animation:          equ  34; 1 bytes ;current animation index, zero-based
048098             0034*   sprite_animation_timer:    equ  35; 1 bytes ;when hits zero, draw next animation
048098             0035*   sprite_move_timer:         equ  36; 1 bytes ;when zero, go to next move program, or step
048098             0036*   sprite_move_step:          equ  37; 1 bytes ;stage in a move program sequence, varies
048098             0037*   sprite_points:             equ  38; 1 bytes ;points awarded for killing this sprite type
048098             0038*   sprite_shield_damage:      equ  39; 1 bytes ;shield points deducted for collision
048098             0039*   sprite_frame:              equ  40; 1 bytes ;current animation frame
048098             0040*   
048098             0041*   ; ###### SPRITE TABLE VARIABLES ######
048098             0042*   ; pointer to top address of current record, initialized to table_base
048098 60 9B 04    0043*   table_pointer: dl table_base
04809B             0044*   
04809B             0045*   ; flag indicating collision with screen edge
04809B 00          0046*   sprite_screen_edge: db #00
04809C             0047*   
04809C             0048*   ; ######### COLLISION SPRITE PARAMETERS ##########
04809C             0049*   ; integer coordinates are all that are needed for collision calculations
04809C 00          0050*   collision_x: db 0x00
04809D 00          0051*   collision_y: db 0x00
04809E 00          0052*   collision_dim_x: db 0x00
04809F 00          0053*   collision_dim_y: db 0x00
0480A0             0054*   
0480A0             0055*   ; scratch variables
0480A0 00          0056*   x: db 0x00 ; 8-bit signed integer
0480A1 00          0057*   y: db 0x00 ; 8-bit signed integer
0480A2 00 00 00    0058*   x0: dl 0x000000 ; 16.8 signed fixed place
0480A5 00 00 00    0059*   y0: dl 0x000000 ; 16.8 signed fixed place
0480A8 00 00 00    0060*   incx1: dl 0x000000 ; 16.8 signed fixed place
0480AB 00 00 00    0061*   incy1: dl 0x000000 ; 16.8 signed fixed place
0480AE 00 00 00    0062*   incx2: dl 0x000000 ; 16.8 signed fixed place
0480B1 00 00 00    0063*   incy2: dl 0x000000 ; 16.8 signed fixed place
0480B4             0064*   
0480B4             0065*   ; sprite_heading: dl 0x000000 ; signed fixed 16.8
0480B4 00 00 00    0066*   radius: dl 0x000000 ; signed fixed 16.8 (but should always be positive)
0480B7 00 00 00    0067*   sin_sprite_heading: dl 0x000000 ; signed fixed 16.8
0480BA 00 00 00    0068*   cos_sprite_heading: dl 0x000000 ; signed fixed 16.8
