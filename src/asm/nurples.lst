0468D9             0157*   @waitLoop:
0468D9 C5          0158*       push bc
0468DA 78          0159*       ld a,b
0468DB 3D          0160*       dec a
0468DC CD 3B 90 04 0161*       call printHexA
0468E0 0E 26       0162*       ld c,38 ; x
0468E2 06 11       0163*       ld b,17 ; y
0468E4 CD 2D 13 04 0164*       call vdu_move_cursor
0468E8 3E 80       0165*       ld a,%10000000 ; bit 7 changes once per second
0468EA CD D6 12 04 0166*       call multiPurposeDelay
0468EE C1          0167*       pop bc
0468EF 10 E8       0168*       djnz @waitLoop
0468F1 C9          0169*       ret
0468F2             0170*   ; end start_level_countdown
