044BAB             0033*   enemy_spawn_seeker:
044BAB 21 98 4B 04 0034*       ld hl,seeker_defaults
044BAF DD 21 22 A5 0035*       ld ix,seekers_base
       04          
044BB4 06 03       0036*       ld b,seekers_max
044BB6 CD 57 8F 04 0037*       call spawn_sprite_from_tile
044BBA D0          0038*       ret nc ; no carry means no free sprite slots, so we go home
044BBB             0039*   ; other specific initialization
044BBB 21 80 02 00 0040*       ld hl,speed_seeker
044BBF DD 2F 0D    0041*       ld (ix+sprite_vel),hl
