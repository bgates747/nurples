0421F1             0034*   move_enemy_seeker_orbit:
0421F1             0035*   ; compute x coordinate of orbit origin based on sprite id
0421F1 3E 05       0036*       ld a,seeker_min_sprite_id
0421F3 FD 96 00    0037*       sub (iy+sprite_id)
0421F6 6F          0038*       ld l,a
0421F7 26 55       0039*       ld h,85 ; 1/3 the playing field width
0421F9 ED 6C       0040*       mlt hl
0421FB 3E 40       0041*       ld a,64 ; 1/4 of the playing field width
0421FD 85          0042*       add a,l ; a = x coordinate of orbit origin
0421FE FD 77 25    0043*       ld (iy+sprite_move_step),a ; as good a place as any to store it
042201             0044*   ; initialize orbit angle
042201 AF          0045*       xor a
042202 FD 77 13    0046*       ld (iy+sprite_orientation),a
042205             0047*   ; ; initialize move timer
042205             0048*   ;     inc a ; set to 1
042205             0049*   ;     ld (iy+sprite_move_timer),a
042205             0050*   ; init done, so update move program
042205 21 0C 22 04 0051*       ld hl,move_enemy_seeker_orbit_stage1 ; update move program pointer
042209 FD 2F 1A    0052*       ld (iy+sprite_move_program),hl
04220C             0053*   ; fall through to the persistent orbit behavior
04220C             0054*   move_enemy_seeker_orbit_stage1:
04220C             0055*   ; ; check whether time to update orbit angle
04220C             0056*   ;     dec (iy+sprite_move_timer)
04220C             0057*   ;     jp nz,@F ; not time to change so simply movethe sprite on the current heading
04220C             0058*   ;     inc (iy+sprite_move_timer) ; reset timer to 1
04220C             0059*   ; update the target coordinates based on orbit angle and radius
04220C FD 34 13    0060*       inc (iy+sprite_orientation) ; increment angle
04220F 21 00 00 00 0061*       ld hl,0 ; clear hlu and l
042213 FD 66 13    0062*       ld h,(iy+sprite_orientation) ; uh.l = angle
042216 11 00 80 00 0063*       ld de,128*256 ; ud.e = radius
04221A CD F6 06 04 0064*       call polar_to_cartesian ; u.bc, u.de = x,y offsets
04221E FD 7E 25    0065*       ld a,(iy+sprite_move_step) ; x coordinate of orbit origin
042221 80          0066*       add a,b ; add x offset
042222 01 00 00 00 0067*       ld bc,0 ; bcu and c
042226 47          0068*       ld b,a ; ub.c = x
042227 21 00 A8 00 0069*       ld hl,336/2*256
04222B 19          0070*       add hl,de
04222C EB          0071*       ex de,hl ; ud.e = y
04222D CD E2 84 04 0072*       call bearing_to_coord ; uh.l = angle to coordinate
042231 FD 2F 10    0073*       ld (iy+sprite_heading),hl ; save angle as heading
