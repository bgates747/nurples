041434 00 00       0146*   @lb: 	dw 0x0000 ; set by bc
041436 00 00       0147*   @rt: 	dw 0x0000 ; set by de
041438 00          0148*   @end:   db 0x00	  ; padding
041439             0149*   
041439             0150*   ; Wait for VBLANK interrupt
041439             0151*   vdu_timing_fault_vblank_timeout: equ 0
041439 00          0152*   vdu_timing_fault_flags: db 0
04143A             0153*   vdu_vblank:
