04140A             0244*   vdu_set_screen_mode:
04140A 32 1A 14 04 0245*   	ld (@arg),a
04140E 21 19 14 04 0246*   	ld hl,@cmd
041412 01 02 00 00 0247*   	ld bc,@end-@cmd
041416 5B DF       0248*   	rst.lil $18
041418 C9          0249*   	ret
041419 16          0250*   @cmd: db 22 ; set screen mode
04141A 00          0251*   @arg: db 0  ; screen mode parameter
04141B             0252*   @end:
