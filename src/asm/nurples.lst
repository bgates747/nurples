048990             0175*   ; destroys: a,de,hl
048990             0176*   tile_table_record_pointer_valid:
048990 FD E5       0177*       push iy
048992 E1          0178*       pop hl
048993 11 87 A1 04 0179*       ld de,tile_table_base
048997 B7          0180*       or a
048998 ED 52       0181*       sbc hl,de ; offset from the tile-table base
04899A DA C4 89 04 0182*       jp c,@invalid
04899E 11 00 40 00 0183*       ld de,tile_table_end-tile_table_base
0489A2 B7          0184*       or a
0489A3 ED 52       0185*       sbc hl,de
0489A5 D2 C4 89 04 0186*       jp nc,@invalid
0489A9 19          0187*       add hl,de ; restore the in-range offset
0489AA 7D          0188*       ld a,l
0489AB E6 3F       0189*       and tile_table_record_size-1
0489AD C2 C4 89 04 0190*       jp nz,@invalid
0489B1             0191*   ; Convert the aligned offset to its stable record id: H*4 + L/64.
0489B1 7C          0192*       ld a,h
0489B2 87          0193*       add a,a
0489B3 87          0194*       add a,a
0489B4 57          0195*       ld d,a
0489B5 7D          0196*       ld a,l
0489B6 07          0197*       rlca
0489B7 07          0198*       rlca
0489B8 E6 03       0199*       and %00000011
0489BA B2          0200*       or d
0489BB FD BE 00    0201*       cp (iy+tile_id)
0489BE C2 C4 89 04 0202*       jp nz,@invalid
0489C2 37          0203*       scf
0489C3 C9          0204*       ret
0489C4             0205*   @invalid:
