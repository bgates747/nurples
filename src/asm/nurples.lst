040F4A 77 1D 00    1317*       dl 0x001D77 ; 0000E2, 41.438
040F4D 8E 1D 00    1318*       dl 0x001D8E ; 0000E3, 41.564
040F50 A5 1D 00    1319*       dl 0x001DA5 ; 0000E4, 41.689
