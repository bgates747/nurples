047967             0165*   
047967             0166*   bar_yellow: equ 33
047967             0167*   bar_red: equ 17
047967             0168*   
047967             0169*   ; update a vertical bar display
047967             0170*   ; inputs: ix points to bar structure
047967             0171*   ;         bar_val set by caller
047967             0172*   ; prerequisite: bar_init called before first use
047967             0173*   bar_update_v:
047967             0174*   ; set gfx viewport
047967 DD E5       0175*       push ix ; preserve pointer
047969 DD 07 03    0176*       ld bc,(ix+bar_x0)
04796C DD 17 06    0177*       ld de,(ix+bar_y0)
04796F DD 31 0C    0178*       ld iy,(ix+bar_y1)
047972 DD 37 09    0179*       ld ix,(ix+bar_x1)
047975 CD 3E 14 04 0180*       call vdu_set_gfx_viewport
047979 DD E1       0181*       pop ix ; restore pointer
04797B             0182*   ; select the color based on the value thresholds
04797B DD 17 00    0183*       ld de,(ix+bar_val)
04797E 21 EF FF FF 0184*       ld hl,-bar_red
047982 19          0185*       add hl,de
047983 D2 A0 79 04 0186*       jp nc,@red
047987 21 DF FF FF 0187*       ld hl,-bar_yellow
04798B 19          0188*       add hl,de
04798C D2 98 79 04 0189*       jp nc,@yellow
047990 21 05 00 00 0190*       ld hl,BUF_BAR_V_2 ; green
047994 C3 A4 79 04 0191*       jp @select
047998             0192*   @yellow:
047998 21 04 00 00 0193*       ld hl,BUF_BAR_V_1 ; yellow
04799C C3 A4 79 04 0194*       jp @select
0479A0             0195*   @red:
0479A0 21 03 00 00 0196*       ld hl,BUF_BAR_V_0 ; red
0479A4             0197*   @select:
0479A4 CD 93 14 04 0198*       call vdu_buff_select
0479A8             0199*   ; get x-plot position
0479A8 DD 07 03    0200*       ld bc,(ix+bar_x0)
0479AB             0201*   ; compute y-plot position
0479AB DD 17 00    0202*       ld de,(ix+bar_val)
0479AE 21 40 00 00 0203*       ld hl,64
0479B2 AF          0204*       xor a ; clear carry
0479B3 ED 52       0205*       sbc hl,de
0479B5 DD 17 0F    0206*       ld de,(ix+bar_y)
0479B8 19          0207*       add hl,de
0479B9 7D          0208*       ld a,l
0479BA E6 FC       0209*       and %11111100 ; round to nearest 4 pixels
0479BC 6F          0210*       ld l,a
0479BD EB          0211*       ex de,hl
0479BE CD A3 18 04 0212*       call vdu_plot_bmp
0479C2 C9          0213*       ret
0479C3             0214*   ; end bar_update_v
0479C3             0215*   
