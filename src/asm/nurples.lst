0410F1             0038        include "timer.inc"
0410F1             0001*   ; Table 32. Timer Control Registers
0410F1             0002*   TMR0_CTL: equ 80h
0410F1             0003*   TMR1_CTL: equ 83h
0410F1             0004*   TMR2_CTL: equ 86h
0410F1             0005*   TMR3_CTL: equ 89h
0410F1             0006*   TMR4_CTL: equ 8Ch
0410F1             0007*   TMR5_CTL: equ 8Fh
0410F1             0008*   
0410F1             0009*   ; each timer register takes three bytes:
0410F1             0010*   ;   0: control register
0410F1             0011*   ;   1: low byte of timer reset value
0410F1             0012*   ;   2: high byte of timer reset value
0410F1             0013*   ; note that the value is only 8-bits,so we use in0/out0 i/o calls,
0410F1             0014*   ; which correctly force the high and upper bytes of the address bus to zero
0410F1             0015*   
0410F1             0016*   TMR_REG_CTL: equ 0
0410F1             0017*   TMR_RES_LOW: equ 1
0410F1             0018*   TMR_RES_HIGH: equ 2
0410F1             0019*   
0410F1             0020*   ; Timer Control Register Bit Definitions
0410F1             0021*   PRT_IRQ_0:    equ %00000000 ; The timer does not reach its end-of-count value.
0410F1             0022*                               ; This bit is reset to 0 every time the TMRx_CTL register is read.
0410F1             0023*   PRT_IRQ_1:    equ %10000000 ; The timer reaches its end-of-count value. If IRQ_EN is set to 1,
0410F1             0024*                               ; an interrupt signal is sent to the CPU. This bit remains 1 until
0410F1             0025*                               ; the TMRx_CTL register is read.
0410F1             0026*   
0410F1             0027*   IRQ_EN_0:     equ %00000000 ; Timer interrupt requests are disabled.
0410F1             0028*   IRQ_EN_1:     equ %01000000 ; Timer interrupt requests are enabled.
0410F1             0029*   
0410F1             0030*   PRT_MODE_0:   equ %00000000 ; The timer operates in SINGLE PASS mode. PRT_EN (bit 0) is reset to
0410F1             0031*                               ;  0,and counting stops when the end-of-count value is reached.
0410F1             0032*   PRT_MODE_1:   equ %00010000 ; The timer operates in CONTINUOUS mode. The timer reload value is
0410F1             0033*                               ; written to the counter when the end-of-count value is reached.
0410F1             0034*   
0410F1             0035*   ; CLK_DIV is a 2-bit mask that sets the timer input source clock divider
0410F1             0036*   CLK_DIV_256:  equ %00001100 ;
0410F1             0037*   CLK_DIV_64:   equ %00001000 ;
0410F1             0038*   CLK_DIV_16:   equ %00000100 ;
0410F1             0039*   CLK_DIV_4:    equ %00000000 ;
0410F1             0040*   
0410F1             0041*   RST_EN_0:     equ %00000000 ; The reload and restart function is disabled.
0410F1             0042*   RST_EN_1:     equ %00000010 ; The reload and restart function is enabled.
0410F1             0043*                               ; When a 1 is written to this bit,the values in the reload registers
0410F1             0044*                               ;  are loaded into the downcounter when the timer restarts. The
0410F1             0045*                               ; programmer must ensure that this bit is set to 1 each time
0410F1             0046*                               ; SINGLE-PASS mode is used.
0410F1             0047*   
0410F1             0048*   ; disable/enable the programmable reload timer
0410F1             0049*   PRT_EN_0:     equ %00000000 ;
0410F1             0050*   PRT_EN_1:     equ %00000001 ;
0410F1             0051*   
0410F1             0052*   ; Table 37. Timer Input Source Select Register
0410F1             0053*   ; Each of the 4 timers are allocated two bits of the 8-bit register
0410F1             0054*   ; in little-endian order,with TMR0 using bits 0 and 1,TMR1 using bits 2 and 3,etc.
0410F1             0055*   ;   00: System clock / CLK_DIV
0410F1             0056*   ;   01: RTC / CLK_DIV
0410F1             0057*   ;   NOTE: these are the values given in the manual,but it may be a typo
0410F1             0058*   ;   10: GPIO port B pin 1.
0410F1             0059*   ;   11: GPIO port B pin 1.
0410F1             0060*   TMR_ISS:   equ 92h ; register address
0410F1             0061*   
0410F1             0062*   ; Table 51. Real-Time Clock Control Register
0410F1             0063*   RTC_CTRL: equ EDh ; register address
0410F1             0064*   
0410F1             0065*   ; alarm interrupt disable/enable
0410F1             0066*   RTC_ALARM_0:    equ %00000000
0410F1             0067*   RTC_ALARM_1:    equ %10000000
0410F1             0068*   
0410F1             0069*   ; interrupt on alarm disable/enable
0410F1             0070*   RTC_INT_ENT_0:  equ %00000000
0410F1             0071*   RTC_INT_ENT_1:  equ %01000000
0410F1             0072*   
0410F1             0073*   RTC_BCD_EN_0:   equ %00000000   ; RTC count and alarm registers are binary
0410F1             0074*   RTC_BCD_EN_1:   equ %00100000   ; RTC count and alarm registers are BCD
0410F1             0075*   
0410F1             0076*   RTC_CLK_SEL_0:  equ %00000000   ; RTC clock source is crystal oscillator output (32768 Hz).
0410F1             0077*                                   ; On-chip 32768 Hz oscillator is enabled.
0410F1             0078*   RTC_CLK_SEL_1:  equ %00010000   ; RTC clock source is power line frequency input as set by FREQ_SEL.
0410F1             0079*                                   ; On-chip 32768 Hz oscillator is disabled.
0410F1             0080*   
0410F1             0081*   RTC_FREQ_SEL_0: equ %00000000   ; 60 Hz power line frequency.
0410F1             0082*   RTC_FREQ_SEL_1: equ %00001000   ; 50 Hz power line frequency.
0410F1             0083*   
0410F1             0084*   RTC_SLP_WAKE_0: equ %00000000   ; RTC does not generate a sleep-mode recovery reset.
0410F1             0085*   RTC_SLP_WAKE_1: equ %00000010   ; RTC generates a sleep-mode recovery reset.
0410F1             0086*   
0410F1             0087*   RTC_UNLOCK_0:   equ %00000000   ; RTC count registers are locked to prevent Write access.
0410F1             0088*                                   ; RTC counter is enabled.
0410F1             0089*   RTC_UNLOCK_1:   equ %00000001   ; RTC count registers are unlocked to allow Write access.
0410F1             0090*                                   ; RTC counter is disabled.
0410F1             0091*   
0410F1             0092*   ; prt_reload_emulator: equ 11234 ; 1/102.4 seconds on emulator with 16 clock divider
0410F1             0093*   
0410F1             0094*   prt_reload_emulator: equ 11519 ; 1 centisecond on emulator with 16 clock divider
0410F1             0095*   prt_reload_hardware: equ 11532 ; 1 centisecond on hardware with 16 clock divider
0410F1 00 00 00    0096*   prt_reload: dl 0x000000
0410F4             0097*   
0410F4             0098*   ; returns: a = 0 if running on hardware,1 if running on emulator
0410F4             0099*   ;          de = number PRT interrupts during test interval
0410F4             0100*   prt_calibrate:
0410F4 CD F6 13 04 0101*       call vdu_vblank
0410F8             0102*   ; set a MOS timer
0410F8 21 78 00 00 0103*       ld hl,120*1 ; 1 second
0410FC FD 21 7C 12 0104*       ld iy,tmr_test
       04          
041101 CD 5A 12 04 0105*       call tmr_set
041105             0106*   ; set a PRT timer
041105             0107*       ; ld hl,prt_reload_hardware
041105             0108*       ; ld hl,prt_reload_emulator
041105 21 05 2D 00 0109*       ld hl,prt_reload_emulator + prt_reload_hardware / 2
041109 22 F1 10 04 0110*       ld (prt_reload),hl
04110D CD 95 11 04 0111*       call prt_set
041111             0112*   @loop:
041111             0113*   ; check time remaining on MOS timer
041111 CD 68 12 04 0114*       call tmr_get
041115 CA 1F 11 04 0115*       jp z,@done ; time expired,so quit
041119 FA 1F 11 04 0116*       jp m,@done ; time past expiration (negative),so quit
04111D 18 F2       0117*       jr @loop
04111F             0118*   @done:
04111F ED 5B E3 11 0119*       ld de,(prt_irq_counter)
       04          
041124 01 0C 2D 00 0120*       ld bc,prt_reload_hardware ; default value for running on hardware
041128 ED 43 F1 10 0121*       ld (prt_reload),bc
       04          
04112D 21 64 00 00 0122*       ld hl,100 ; halfway between 101 for real hardware and 99 for emulator
041131 AF          0123*       xor a ; clear carry,zero is default value for running on hardware
041132 32 54 11 04 0124*       ld (is_emulator),a
041136 ED 52       0125*       sbc hl,de
041138 21 55 11 04 0126*       ld hl,on_hardware ; default message for running on hardware
04113C CA F4 10 04 0127*       jp z,prt_calibrate ; zero result is indeterminate so we try again
041140 F8          0128*       ret m ; negative result means we're on hardware
041141 3C          0129*       inc a ; we're on emulator
041142 32 54 11 04 0130*       ld (is_emulator),a
041146 01 FF 2C 00 0131*       ld bc,prt_reload_emulator
04114A ED 43 F1 10 0132*       ld (prt_reload),bc
       04          
04114F 21 6B 11 04 0133*       ld hl,on_emulator
041153 C9          0134*       ret
041154 00          0135*   is_emulator: db 0
041155 52 75 6E 6E 0136*   on_hardware: defb "Running on hardware\r\n",0
       69 6E 67 20 
       6F 6E 20 68 
       61 72 64 77 
       61 72 65 0D 
       0A 00       
04116B 52 75 6E 6E 0137*   on_emulator: defb "Running on emulator\r\n",0
       69 6E 67 20 
       6F 6E 20 65 
       6D 75 6C 61 
       74 6F 72 0D 
       0A 00       
041181             0138*   
041181 43 61 6C 69 0139*   calibrating_timer: defb "Calibrating timer\r\n",0
       62 72 61 74 
       69 6E 67 20 
       74 69 6D 65 
       72 0D 0A 00 
041195             0140*   
041195             0141*   ; set PRT timer
041195             0142*   prt_set:
041195 21 00 00 00 0143*       ld hl,0
041199 22 E3 11 04 0144*       ld (prt_irq_counter),hl
04119D 2A F1 10 04 0145*       ld hl,(prt_reload)
0411A1 ED 29 84    0146*       out0 (TMR1_CTL+TMR_RES_LOW),l
0411A4 ED 21 85    0147*   	out0 (TMR1_CTL+TMR_RES_HIGH),h
0411A7             0148*   ; disable timer
0411A7 3E 06       0149*       ld a,PRT_IRQ_0 | IRQ_EN_0 | PRT_MODE_0 | CLK_DIV_16 | RST_EN_1 | PRT_EN_0
