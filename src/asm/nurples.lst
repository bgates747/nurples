049B0E             0081    
049B0E             0082    ; --- MAIN PROGRAM FILE ---
049B0E             0083    main:
049B0E             0084    ; start a new game
049B0E 21 47 84 04 0085        ld hl,game_init
049B12 22 55 83 04 0086        ld (game_state),hl
049B16             0087    main_loop:
049B16             0088    ; update the global timestamp
049B16 CD 7D 12 04 0089        call timestamp_tick
049B1A             0090    ; do gamestate logic
049B1A CD 58 83 04 0091        call do_game
049B1E             0092    ; wait for the next vblank mitigate flicker and for loop timing
049B1E CD B5 13 04 0093        call vdu_vblank
049B22             0094    ; poll keyboard for escape keypress
049B22 3E 08       0095        ld a, $08 ; code to send to MOS
049B24 5B CF       0096        rst.lil $08 ; get IX pointer to System Variables
049B26 DD 7E 05    0097        ld a, (ix + $05) ; get ASCII code of key pressed
049B29 FE 1B       0098        cp 27 ; check if 27 (ascii code for ESC)
049B2B CA 33 9B 04 0099        jp z, main_end ; if pressed, jump to exit
049B2F             0100    ; escape not pressed so loop
049B2F C3 16 9B 04 0101        jp main_loop
049B33             0102    
049B33             0103    main_end:
049B33             0104    ; restore original screen mode
049B33 3A 46 84 04 0105        ld a,(original_screen_mode)
049B37 CD 0A 14 04 0106        call vdu_set_screen_mode
049B3B             0107    ; print thanks for playing message
049B3B CD 5C 00 04 0108        call printInline
049B3F 54 68 61 6E 0109        asciz "Thank you for playing\r\n"
       6B 20 79 6F 
       75 20 66 6F 
       72 20 70 6C 
       61 79 69 6E 
       67 0D 0A 00 
049B57 21 41 1A 04 0110        ld hl,purple_nurples_ascii
049B5B CD 63 00 04 0111        call printString
049B5F C9          0112        ret
049B60             0113    ; end main
049B60             0114    
049B60             0115    ; needs to be the final include to leave room for the sprite and tile tables
049B60             0116        include "tables.inc"
049B60             0001*   ; #### THIS IS THE SPACE ALLOCATED TO THE SPRITE TABLE ####
049B60             0002*   table_base: equ $
049B60             0003*   player_weapons_begin: equ table_base
049B60             0004*   player_lasers_begin: equ player_weapons_begin
049B60             0005*   player_lasers_end: equ table_record_size*player_lasers_max+player_lasers_begin
049B60             0006*   player_weapons_end: equ table_record_size*player_lasers_max+player_weapons_begin
049B60             0007*   player_begin: equ player_weapons_end
049B60             0008*   player_end: equ table_record_size+player_begin
049B60             0009*   enemy_sprites_begin: equ player_end
049B60             0010*   seekers_base: equ enemy_sprites_begin
049B60             0011*   seeker_min_sprite_id: equ [seekers_base-table_base]/table_record_size
049B60             0012*   seekers_end: equ table_record_size*seekers_max+seekers_base
049B60             0013*   fireballs_base: equ seekers_end
049B60             0014*   fireballs_end: equ table_record_size*fireballs_max+fireballs_base
049B60             0015*   enemy_sprites_end: equ fireballs_end
049B60             0016*   explosions_base: equ enemy_sprites_end
049B60             0017*   explosions_end: equ table_record_size*explosions_max+explosions_base
049B60             0018*   table_end: equ explosions_end
049B60             0019*   
049B60             0020*   table_num_records: equ table_end-table_base/table_record_size
049B60             0021*   table_num_enemy_records: equ enemy_sprites_end-enemy_sprites_begin/table_record_size
049B60             0022*   
049B60             0023*   ; ### THIS IS THE SPACE ALLOCATED TO THE ACTIVE TILES TABLE ###
049B60             0024*   tile_table_base: equ table_end
049B60             0025*   tile_table_end: equ 256*tile_table_record_size+tile_table_base
