042328             0001*   explosions_max: equ 8
042328             0002*   explosion_animation_count: equ 5
042328             0003*   explosion_animation_ticks: equ 8
042328             0004*   ; One update clears the just-spawned flag, then every animation frame runs for
042328             0005*   ; explosion_animation_ticks updates.
042328             0006*   explosion_lifetime_updates: equ explosion_animation_count*explosion_animation_ticks+1
042328             0007*   explosion_defaults:
042328 04          0008*       db explosion            ; type
042329 09 01 00    0009*       dl BUF_EXPLOSION_A	    ; base_bufferId
04232C A5 23 04    0010*       dl move_explosion	    ; move_program
04232F 40          0011*       db %01000000            ; collisions bit 6 signals sprite alive
042330 07          0012*       db 7	                ; dim_x
042331 07          0013*       db 7                    ; dim_y
042332 01          0014*       db 1                    ; num_orientations
042333 05          0015*       db explosion_animation_count ; num_animations
042334 05          0016*       db explosion_animation_count ; animation
042335 08          0017*       db explosion_animation_ticks ; animation_timer
042336 00          0018*       db 0	                ; move_timer
042337 00          0019*       db 0	                ; move_step
042338 00          0020*       db 0	                ; points
042339 00          0021*       db 0	                ; shield_damage
04233A 00          0022*       db 0                    ; frame
