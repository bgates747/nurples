0477CA             0041*   
0477CA             0042*   activate_null_tile:
0477CA C9          0043*       ret ; dummy routine, do nothing
0477CB             0044*   move_active_tile:
0477CB             0045*   ; y-axis movement
0477CB FD 27 04    0046*       ld hl,(iy+tile_y)
0477CE FD 17 0A    0047*       ld de,(iy+tile_yvel)
0477D1 19          0048*       add hl,de
0477D2 FD 2F 04    0049*       ld (iy+tile_y),hl
0477D5             0050*   ; detect screen edge collisions
0477D5             0051*   ; y-axis bottom is all we need to test
0477D5 11 00 80 FE 0052*       ld de,-tile_bottom*256
0477D9 ED 5A       0053*       adc hl,de
0477DB F8          0054*       ret m ; still on screen so do nothing further
0477DC AF          0055*       xor a ; signal caller that tile has scrolled off screen
0477DD C9          0056*       ret
0477DE             0057*   ; end move_active_tile
0477DE             0058*   
0477DE             0059*   ; Exact stabilization whitelist for writable legacy tile callbacks.
0477DE             0060*   ; inputs: iy = validated tile record, hl = stored callback
0477DE             0061*   ; outputs: carry set and hl = expected callback on an exact type/program match
0477DE             0062*   ; destroys: a,de,hl
0477DE             0063*   tile_move_program_valid:
0477DE FD 7E 16    0064*       ld a,(iy+tile_type)
0477E1 FE 01       0065*       cp tile_pad_small
0477E3 CA 03 78 04 0066*       jp z,@pad_small
0477E7 FE 05       0067*       cp tile_turret_fireball
0477E9 CA 0B 78 04 0068*       jp z,@turret_fireball
0477ED FE 09       0069*       cp tile_electrode
0477EF CA 13 78 04 0070*       jp z,@electrode
0477F3 FE 0A       0071*       cp tile_lightning
0477F5 CA 1B 78 04 0072*       jp z,@lightning
0477F9 FE 10       0073*       cp tile_crater
0477FB CA 23 78 04 0074*       jp z,@crater
0477FF C3 32 78 04 0075*       jp @invalid
047803             0076*   @pad_small:
047803 11 A5 7B 04 0077*       ld de,move_pad_small
047807 C3 27 78 04 0078*       jp @compare
04780B             0079*   @turret_fireball:
04780B 11 1A 7C 04 0080*       ld de,move_turret_fireball
04780F C3 27 78 04 0081*       jp @compare
047813             0082*   @electrode:
047813 11 A1 79 04 0083*       ld de,move_electrode
047817 C3 27 78 04 0084*       jp @compare
04781B             0085*   @lightning:
04781B 11 43 7B 04 0086*       ld de,move_lightning
04781F C3 27 78 04 0087*       jp @compare
047823             0088*   @crater:
047823 11 53 79 04 0089*       ld de,move_crater
047827             0090*   @compare:
047827 B7          0091*       or a
047828 ED 52       0092*       sbc hl,de
04782A C2 32 78 04 0093*       jp nz,@invalid
04782E D5          0094*       push de
04782F E1          0095*       pop hl ; publish the fixed expected address, not writable record data
047830 37          0096*       scf
047831 C9          0097*       ret
047832             0098*   @invalid:
047832 AF          0099*       xor a
047833 C9          0100*       ret
047834             0101*   ; end tile_move_program_valid
047834             0102*   
047834             0103*   move_tiles:
047834             0104*   ; initialize the dense-stack cursor
047834 3A C3 73 04 0105*       ld a,(num_active_tiles)
047838 B7          0106*       or a
047839 C8          0107*       ret z
04783A FD 21 BA 70 0108*       ld iy,tile_stack ; set iy to first record in table
       04          
04783F             0109*   @move_loop:
04783F FD E5       0110*       push iy
047841 E1          0111*       pop hl
047842 CD 6E 74 04 0112*       call tile_stack_pointer_valid
047846 D0          0113*       ret nc ; normal end-of-stack or fail-closed malformed cursor
047847 FD 22 BD 73 0114*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
04784C             0115*   ; point iy to tile record
04784C FD 37 00    0116*       ld iy,(iy) ; iy points to the current tile record
04784F CD A7 74 04 0117*       call tile_table_record_pointer_valid
047853 D2 9D 78 04 0118*       jp nc,@bad_record
047857 FD 22 C0 73 0119*       ld (tile_table_pointer),iy ; update table pointer
       04          
04785C             0120*   ; check top bit of tile_type to see if tile is just spawned
04785C FD CB 16 7E 0121*       bit 7,(iy+tile_type)
047860 C2 8D 78 04 0122*       jp nz,@just_spawned ; if just spawned, skip to next record
047864             0123*   ; check sprite_alive bit to see if tile is active
047864 FD CB 1D 76 0124*       bit sprite_alive,(iy+tile_collisions)
047868 CA 95 78 04 0125*       jp z,@inactive_record
04786C             0126*   ; otherwise we prepare to move the tile
04786C FD 27 1A    0127*       ld hl,(iy+tile_move_program) ; load the behavior subroutine address
04786F CD DE 77 04 0128*       call tile_move_program_valid
047873 D2 AB 78 04 0129*       jp nc,@bad_move_program
047877 FD E5       0130*       push iy ; callbacks may use index registers internally but do not own them
047879             0131*       CALL_HL
                       M1 Args: none
047879 01 7F 78 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
04787D C5          0002*M1     push bc ; which constitutes the return address
04787E E9          0003*M1     jp (hl) ; Jump to the address in HL
04787F FD E1       0132*       pop iy
047881             0133*    ; get back stack pointer and loop
047881             0134*   @next_record:
047881 FD 2A BD 73 0135*       ld iy,(tile_stack_pointer)
       04          
047886 ED 33 03    0136*       lea iy,iy+3 ; next tile stack record
047889 C3 3F 78 04 0137*       jp @move_loop ; loop until we've checked all the records
04788D             0138*   @just_spawned:
04788D FD CB 16 BE 0139*       res 7,(iy+tile_type) ; clear just spawned flag
047891 C3 81 78 04 0140*       jp @next_record
047895             0141*   @inactive_record:
047895 CD DD 74 04 0142*       call table_deactivate_tile
047899 C3 81 78 04 0143*       jp @next_record
04789D             0144*   @bad_record:
04789D 21 CA 73 04 0145*       ld hl,tile_fault_flags
0478A1 CB C6       0146*       set tile_fault_bad_record,(hl)
0478A3 CD 21 75 04 0147*       call tile_stack_quarantine_entry
0478A7 C3 81 78 04 0148*       jp @next_record
0478AB             0149*   @bad_move_program:
0478AB 21 CA 73 04 0150*       ld hl,tile_fault_flags
0478AF CB CE       0151*       set tile_fault_bad_move_program,(hl)
0478B1 CD DD 74 04 0152*       call table_deactivate_tile
0478B5 C3 81 78 04 0153*       jp @next_record
0478B9             0154*   ; end move_tiles
0478B9             0155*   
0478B9             0156*   draw_active_tile:
0478B9 FD 27 17    0157*       ld hl,(iy+tile_base_bufferId)
0478BC FD 7E 28    0158*       ld a,(iy+tile_frame)
0478BF 85          0159*       add a,l ; TODO: with a little work we could make all tile base buffer ids align to 256
0478C0 6F          0160*       ld l,a
0478C1 3E 00       0161*       ld a,0 ; preserve carry
0478C3 8C          0162*       adc a,h
0478C4 67          0163*       ld h,a
0478C5 CD D7 14 04 0164*       call vdu_buff_select ; buffer id of animation frame
0478C9 FD 07 01    0165*       ld bc,(iy+tile_x)
0478CC FD 17 04    0166*       ld de,(iy+tile_y)
0478CF CD 29 19 04 0167*       call vdu_plot_bmp168
0478D3 C9          0168*       ret
0478D4             0169*   ; end draw_active_tile
0478D4             0170*   
0478D4             0171*   ; create a new sprite at the same location as the current tile
0478D4             0172*   ; inputs: hl = pointer to new sprite default settings, tile_table_pointer = current tile
0478D4             0173*   ;         ix = pointer to sprite group, b = number of records in sprite group
0478D4             0174*   spawn_sprite_from_tile:
0478D4 E5          0175*       push hl ; back up pointer to new sprite defaults
0478D5 CD 2C 68 04 0176*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
0478D9 E1          0177*       pop hl ; restore pointer to new sprite defaults
0478DA D0          0178*       ret nc ; no carry means no free sprite slots, so we go home
0478DB             0179*   ; copy default settings to new sprite
0478DB DD E5       0180*       push ix ; back up pointer to new sprite record
0478DD ED 32 16    0181*       lea ix,ix+sprite_definitions ; bump pointer to copy to
0478E0 DD E5       0182*       push ix ; pointer to default sprite settings
0478E2 D1          0183*       pop de ; address to copy to
0478E3 01 13 00 00 0184*       ld bc,sprite_definitions_size ; copy only bytes provided by defaults
0478E7 ED B0       0185*       ldir ; copies defaults to new sprite record
0478E9 DD E1       0186*       pop ix ; restore pointer to new sprite record
0478EB             0187*   ; copy sprite position from existing tile
0478EB FD 2A C0 73 0188*       ld iy,(tile_table_pointer) ; get existing tile record
       04          
0478F0 FD 27 01    0189*       ld hl,(iy+tile_x)
0478F3 DD 2F 01    0190*       ld (ix+sprite_x),hl
0478F6 FD 27 04    0191*       ld hl,(iy+tile_y)
0478F9 DD 2F 04    0192*       ld (ix+sprite_y),hl
0478FC             0193*   ; clear motion state retained by a previously used physical record
0478FC 21 00 00 00 0194*       ld hl,0
047900 DD 2F 07    0195*       ld (ix+sprite_xvel),hl
047903 DD 2F 0A    0196*       ld (ix+sprite_yvel),hl
047906 DD 2F 0D    0197*       ld (ix+sprite_vel),hl
047909 DD 2F 10    0198*       ld (ix+sprite_heading),hl
04790C DD 2F 13    0199*       ld (ix+sprite_orientation),hl
04790F             0200*   ; return to caller
04790F DD CB 16 FE 0201*       set 7,(ix+sprite_type) ; set just spawned flag
047913 DD CB 1D F6 0202*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
047917 37          0203*       scf ; set carry flag to indicate success
047918 C9          0204*       ret
047919             0205*   ; end spawn_sprite_from_tile
047919             0206*   
047919             0207*   ; create a new tile at the same location as the current tile
047919             0208*   ; inputs: tile_table_pointer = current tile
047919             0209*   spawn_active_tile_from_tile:
047919             0210*   ; copy default settings to new tile
047919 DD 2A C0 73 0211*       ld ix,(tile_table_pointer) ; get existing tile record
       04          
04791E ED 32 16    0212*       lea ix,ix+tile_definitions ; bump pointer to copy to
047921 DD E5       0213*       push ix ; pointer to default tile settings
047923 D1          0214*       pop de ; address to copy to
047924 01 13 00 00 0215*       ld bc,tile_definitions_size ; copy only bytes provided by defaults
047928 ED B0       0216*       ldir ; copies defaults to new tile record
04792A DD 2A C0 73 0217*       ld ix,(tile_table_pointer) ; restore pointer to new tile record
       04          
04792F C9          0218*       ret
047930             0219*   ; end spawn_active_tile_from_tile
047930             0077        include "tile_crater.inc"
047930             0001*   crater_defaults:
047930 10          0002*       db tile_crater          ; type
047931 04 01 00    0003*       dl BUF_CRATER_A      ; base_bufferId
047934 53 79 04    0004*       dl move_crater          ; move_program
047937 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
047938 10          0006*       db 16                   ; dim_x
047939 10          0007*       db 16                   ; dim_y
04793A 01          0008*       db 1                    ; num_orientations
04793B 04          0009*       db 4                    ; num_animations
04793C 05          0010*       db 5	                ; animation
04793D 08          0011*       db 8                    ; animation_timer
04793E 00          0012*       db 0                    ; move_timer
04793F 00          0013*       db 0                    ; move_step
047940 00          0014*       db 0                    ; points
047941 00          0015*       db 0                    ; shield_damage
047942 00          0016*       db 0                    ; frame
047943             0017*   
047943             0018*   activate_crater:
047943 21 30 79 04 0019*       ld hl,crater_defaults
047947 C3 75 75 04 0020*       jp spawn_active_tile
04794B             0021*   ; end activate_crater
04794B             0022*   
04794B             0023*   ; Replace an existing active tile without allocating or changing its position.
04794B             0024*   transform_active_tile_to_crater:
04794B 21 30 79 04 0025*       ld hl,crater_defaults
04794F C3 19 79 04 0026*       jp spawn_active_tile_from_tile
047953             0027*   ; end transform_active_tile_to_crater
047953             0028*   
047953             0029*   move_crater:
047953 CD CB 77 04 0030*       call move_active_tile
047957 CA DD 74 04 0031*       jp z,table_deactivate_tile
04795B             0032*   ; do animation
04795B FD 35 23    0033*       dec (iy+tile_animation_timer)
04795E C0          0034*       ret nz ; not time to animate
04795F FD 35 22    0035*       dec (iy+sprite_animation) ; check whether time to transition to crater
047962 CC 78 79 04 0036*       call z,@make_crater
047966 3E 08       0037*       ld a,8
047968 FD 77 23    0038*       ld (iy+tile_animation_timer),a
04796B FD 7E 28    0039*       ld a,(iy+tile_frame)
04796E 3C          0040*       inc a
04796F E6 03       0041*       and %00000011 ; modulo 4
047971 FD 77 28    0042*       ld (iy+tile_frame),a
047974 C3 B9 78 04 0043*       jp draw_active_tile
047978             0044*   @make_crater:
047978 21 00 01 00 0045*       ld hl,BUF_CRATER_0
04797C FD 2F 17    0046*       ld (iy+tile_base_bufferId),hl
04797F 3E FF       0047*       ld a,-1 ; will wrap to zero on return
047981 FD 77 28    0048*       ld (iy+tile_frame),a
047984 C9          0049*       ret
047985             0050*   ; end move_crater
047985             0078        include "tile_electrode.inc"
047985             0001*   electrode_defaults:
047985 09          0002*       db tile_electrode       ; type
047986 76 01 00    0003*       dl BUF_TILE_BLANK       ; base_bufferId
047989 A1 79 04    0004*       dl move_electrode       ; move_program
04798C 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
04798D 10          0006*       db 16                   ; dim_x
04798E 10          0007*       db 16                   ; dim_y
04798F 01          0008*       db 1                    ; num_orientations
047990 01          0009*       db 1                    ; num_animations
047991 00          0010*       db 0                    ; animation
047992 00          0011*       db 0                    ; animation_timer
047993 00          0012*       db 0                    ; move_timer
047994 00          0013*       db 0                    ; move_step
047995 05          0014*       db 5                    ; points
047996 FC          0015*       db -4                   ; shield_damage
047997 00          0016*       db 0                    ; frame
