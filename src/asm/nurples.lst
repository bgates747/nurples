041498             0221*   ; 11    320   240   2     60hz
041498             0222*   ; 139   320   240   2     60hz
041498             0223*   ; 23    512   384   2     60hz
041498             0224*   ; 151   512   384   2     60hz
041498             0225*   ; 6     640   240   2     60hz
041498             0226*   ; 134   640   240   2     60hz
041498             0227*   ; 2     640   480   2     60hz
041498             0228*   ; 130   640   480   2     60hz
041498             0229*   ; 17    800   600   2     60hz
041498             0230*   ; 145   800   600   2     60hz
041498             0231*   ; 18    1024  768   2     60hz
041498             0232*   ; 146   1024  768   2     60hz
041498             0233*   ; ---   ----  ----  ----  -------
041498             0234*   ; 10    320   240   4     60hz
041498             0235*   ; 138   320   240   4     60hz
041498             0236*   ; 22    512   384   4     60hz
041498             0237*   ; 150   512   384   4     60hz
041498             0238*   ; 5     640   240   4     60hz
041498             0239*   ; 133   640   240   4     60hz
041498             0240*   ; 1     640   480   4     60hz
041498             0241*   ; 129   640   480   4     60hz
041498             0242*   ; 16    800   600   4     60hz
041498             0243*   ; 19    1024  768   4     60hz
041498             0244*   ; ---   ----  ----  ----  -------
041498             0245*   ; 9     320   240   16    60hz
041498             0246*   ; 137   320   240   16    60hz
041498             0247*   ; 21    512   384   16    60hz
041498             0248*   ; 149   512   384   16    60hz
041498             0249*   ; 4     640   240   16    60hz
041498             0250*   ; 132   640   240   16    60hz
041498             0251*   ; 0     640   480   16    60hz
041498             0252*   ; 7     n/a   n/a   16    60hz
041498             0253*   ; ---   ----  ----  ----  -------
041498             0254*   ; 8     320   240   64    60hz
041498             0255*   ; 136   320   240   64    60hz
041498             0256*   ; 20    512   384   64    60hz
041498             0257*   ; 3     640   240   64    60hz
