0485A3             0001*   ; ###### tile TABLE FIELD INDICES ######
0485A3             0002*   tile_table_record_size:         equ  64; bytes per tile record
0485A3             0003*   tile_id:                 equ   0; 1 bytes ;unique tileId, zero-based
0485A3             0004*   ; tile state variables
0485A3             0005*   tile_state_variables:    equ   1; beginning of tile state variables
0485A3             0006*   tile_x:                  equ   1; 3 bytes ;16.8 fractional x position in pixels
0485A3             0007*   tile_y:                  equ   4; 3 bytes ;16.8 fractional y position in pixels
0485A3             0008*   tile_xvel:               equ   7; 3 bytes ;x-component velocity, 16.8 fixed, pixels
0485A3             0009*   tile_yvel:               equ  10; 3 bytes ;y-component velocity, 16.8 fixed, pixels
0485A3             0010*   tile_vel:                equ  13; 3 bytes ;velocity px/frame (16.8 fixed)
0485A3             0011*   tile_heading:            equ  16; 3 bytes ;tile movement direction deg256 16.8 fixed
0485A3             0012*   tile_orientation:        equ  19; 3 bytes ;orientation bits
0485A3             0013*   ; tile definition variables
0485A3             0014*   tile_definitions:        equ  22; beginnning of tile definition variables
0485A3             0015*   tile_type:               equ  22; 1 bytes ;type of tile as defined in enemies.inc
0485A3             0016*   tile_base_bufferId:      equ  23; 3 bytes ;bitmap bufferId
0485A3             0017*   tile_move_program:       equ  26; 3 bytes ;address of tile's behavior subroutine
0485A3             0018*   tile_collisions:         equ  29; 1 bytes ;see collisions.inc constants for bit definitions
0485A3             0019*   tile_dim_x:              equ  30; 1 bytes ;tile width in pixels
