044ABC             0004*           dl fireball_custom_span_mismatch
044ABC             0005*       .endif
044ABC             0006*   
044ABC             0007*   speed_fireball: equ 4*256 ; 6 pixels per frame 16.8 fixed
044ABC             0008*   fireballs_max: equ 4
044ABC             0009*   
044ABC             0010*   fireball_defaults:
044ABC 03          0011*       db enemy_projectile     ; type
044ABD 0E 01 00    0012*       dl BUF_FIREBALL_2_000   ; base_bufferId
044AC0 24 4B 04    0013*       dl move_enemy_fireball  ; move_program
044AC3 40          0014*       db %01000000            ; collisions bit 6 signals sprite alive
044AC4 10          0015*       db 16                   ; dim_x
044AC5 10          0016*       db 16                   ; dim_y
044AC6 20          0017*       db 32                   ; num_orientations
044AC7 02          0018*       db 2                    ; num_animations
044AC8 00          0019*       db 0                    ; animation
044AC9 08          0020*       db 8                    ; animation_timer
044ACA 00          0021*       db 0                    ; move_timer
044ACB 00          0022*       db 0                    ; move_step
044ACC 00          0023*       db 0                    ; points
044ACD FE          0024*       db -2                   ; shield_damage
044ACE 00          0025*       db 0                    ; frame
044ACF             0026*   
044ACF             0027*   enemy_spawn_fireball:
044ACF 21 BC 4A 04 0028*       ld hl,fireball_defaults
044AD3 DD 21 E2 A5 0029*       ld ix,fireballs_base
       04          
044AD8 06 04       0030*       ld b,fireballs_max
044ADA CD 57 8F 04 0031*       call spawn_sprite_from_tile
044ADE D0          0032*       ret nc ; no carry means no free sprite slots, so we go home
044ADF             0033*   ; other specific initialization
044ADF             0034*   ; ------------------------------------------------
044ADF             0035*   ; Copy the final projectile heading and component velocities from the targeting
044ADF             0036*   ; computer. Bearing_t points directly at the player; Heading_p includes lead.
044ADF 2A 66 85 04 0037*       ld hl,(Heading_p)
044AE3 11 00 80 00 0038*       ld de,128*256 ; rotate 128 degrees
044AE7 19          0039*       add hl,de
044AE8 DD 2F 10    0040*       ld (ix+sprite_heading),hl
044AEB 2A 57 85 04 0041*       ld hl,(Vp_x)
044AEF DD 2F 07    0042*       ld (ix+sprite_xvel),hl
044AF2 2A 5A 85 04 0043*       ld hl,(Vp_y)
044AF6 DD 2F 0A    0044*       ld (ix+sprite_yvel),hl
044AF9             0045*   ; move projectile one frame's distance so it isn't drawn right over turret
044AF9 DD 27 01    0046*       ld hl,(ix+sprite_x)
044AFC DD 17 07    0047*       ld de,(ix+sprite_xvel)
044AFF 19          0048*       add hl,de
044B00 DD 2F 01    0049*       ld (ix+sprite_x),hl
044B03 DD 27 04    0050*       ld hl,(ix+sprite_y)
044B06 DD 17 0A    0051*       ld de,(ix+sprite_yvel)
044B09 19          0052*       add hl,de
044B0A DD 2F 04    0053*       ld (ix+sprite_y),hl
044B0D             0054*   ; select the heading-derived artwork immediately rather than exposing frame
044B0D             0055*   ; zero for the first complete eight-tick animation interval
044B0D DD E5       0056*       push ix
044B0F FD E1       0057*       pop iy
044B11 CD E5 7F 04 0058*       call sprite_frame_heading_animation
044B15 FD 7E 00    0059*       ld a,(iy+sprite_id)
044B18 CD 03 1A 04 0060*       call vdu_sprite_select
044B1C FD 7E 28    0061*       ld a,(iy+sprite_frame)
044B1F CD 66 1A 04 0062*       call vdu_sprite_select_frame
044B23 C9          0063*       ret
044B24             0064*   ; end enemy_spawn_fireball
044B24             0065*   
044B24             0066*   move_enemy_fireball:
044B24             0067*   ; run the movement program for the fireball enemy
044B24 CD 2E 7F 04 0068*       call move_sprite
044B28 3A 97 7B 04 0069*       ld a,(sprite_screen_edge)
044B2C B7          0070*       or a ; a will be non-zero if have scrolled off screen
044B2D C2 14 7C 04 0071*       jp nz,table_deactivate_sprite
044B31 DD 21 E2 A4 0072*       ld ix,player_begin
       04          
044B36 DD CB 1D 76 0073*       bit sprite_alive,(ix+sprite_collisions)
044B3A CA 4E 4B 04 0074*       jp z,@animate ; player is dead so don't check for collisions
044B3E CD 39 4A 04 0075*       call check_enemy_collision_player
044B42 C2 4E 4B 04 0076*       jp nz,@animate ; no collision so do animation
044B46 CD 42 7B 04 0077*       call update_shields
044B4A C3 AA 4D 04 0078*       jp spawn_explosion
044B4E             0079*   @animate:
044B4E             0080*   ; check the animation timer
044B4E FD 35 23    0081*       dec (iy+sprite_animation_timer)
044B51 C0          0082*       ret nz ; not time to animate
044B52             0083*   ; reset the animation timer and bump animation
044B52 3E 08       0084*       ld a,8
044B54 FD 77 23    0085*       ld (iy+sprite_animation_timer),a
044B57 FD 7E 22    0086*       ld a,(iy+sprite_animation)
044B5A 3C          0087*       inc a
044B5B E6 01       0088*       and %00000001 ; modulo 2
044B5D FD 77 22    0089*       ld (iy+sprite_animation),a
044B60 CD E5 7F 04 0090*       call sprite_frame_heading_animation ; a, sprite_frame set to heading-based frame
044B64 CD 66 1A 04 0091*       call vdu_sprite_select_frame
044B68 C9          0092*       ret
044B69             0093*   ; end move_enemy_fireball
044B69             0094*   
044B69             0095*   init_enemy_fireballs:
044B69             0096*   ; set pointer to seeker sprite table
044B69 FD 21 E2 A5 0097*       ld iy,fireballs_base
       04          
044B6E FD 7E 00    0098*       ld a,(iy+sprite_id) ; sprite id
044B71 1E 04       0099*       ld e,fireballs_max ; sprite loop counter
044B73             0100*   ; define seeker sprites
044B73             0101*   @sprites_loop:
044B73 F5          0102*       push af
044B74 D5          0103*       push de
044B75 CD 03 1A 04 0104*       call vdu_sprite_select
044B79 CD 16 1A 04 0105*       call vdu_sprite_clear_frames
044B7D 21 0E 01 00 0106*       ld hl,BUF_FIREBALL_2_000
044B81 06 40       0107*       ld b,2*32 ; 2 animations * 32 orientations
044B83             0108*   @frames_loop:
044B83 C5          0109*       push bc
044B84 E5          0110*       push hl
044B85 CD 58 1B 04 0111*       call vdu_sprite_add_buff
044B89 E1          0112*       pop hl
044B8A 23          0113*       inc hl
044B8B C1          0114*       pop bc
044B8C 10 F5       0115*       djnz @frames_loop
044B8E D1          0116*       pop de ; sprite loop counter
044B8F F1          0117*       pop af ; sprite id
044B90 3C          0118*       inc a
044B91 1D          0119*       dec e
044B92 C2 73 4B 04 0120*       jp nz,@sprites_loop
044B96 C9          0121*       ret
044B97             0122*   ; end init_enemy_fireballs
044B97             0054        include "enemy_seeker.inc"
044B97             0001*   seeker_state_seek: equ 0
