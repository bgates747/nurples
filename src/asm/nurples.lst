048957             0133*   ; Validate an address into the dense tile-stack entries currently in use.
048957             0134*   ; inputs: hl = candidate tile-stack address
048957             0135*   ; outputs: carry set for an aligned slot in the active dense-stack range
048957             0136*   ; destroys: a,de,hl
048957             0137*   tile_stack_pointer_valid:
048957 11 A3 85 04 0138*       ld de,tile_stack
04895B B7          0139*       or a
04895C ED 52       0140*       sbc hl,de
04895E DA 8E 89 04 0141*       jp c,@invalid
048962 3A AC 88 04 0142*       ld a,(num_active_tiles)
048966 B7          0143*       or a
048967 CA 8E 89 04 0144*       jp z,@invalid
04896B 11 00 00 00 0145*       ld de,0
04896F 57          0146*       ld d,a
048970 1E 03       0147*       ld e,3
048972 ED 5C       0148*       mlt de
048974 B7          0149*       or a
048975 ED 52       0150*       sbc hl,de
048977 D2 8E 89 04 0151*       jp nc,@invalid
04897B 19          0152*       add hl,de ; restore the in-range offset
04897C             0153*   ; For offsets below 768, divisibility by three can be tested without a loop.
04897C             0154*   ; 256 == 1 (mod 3), and multiplication by 171 maps byte multiples of three
04897C             0155*   ; into 0..85 while every non-multiple maps into 86..255.
