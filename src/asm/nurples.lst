049096             0100*   do_active_tiles:
049096             0101*   ; initialize tiles loop
049096 21 00 00 00 0102*       ld hl,0 ; init plotting x-coordinate
04909A 22 D2 8F 04 0103*       ld (tiles_x_plot),hl
04909E 2A C6 8F 04 0104*       ld hl,(tiles_row_defs)
0490A2 3A CC 8F 04 0105*       ld a,(tiles_cols)
0490A6 47          0106*       ld b,a ; column loop counter
0490A7             0107*   @loop:
0490A7 C5          0108*       push bc ; save the loop counter
0490A8             0109*   ; read the tile defintion for the current column
0490A8 7E          0110*       ld a,(hl) ; a has tile definition
0490A9 E5          0111*       push hl ; save pointer to tile definition
0490AA B7          0112*       or a ; check for null tile
0490AB CA CB 90 04 0113*       jp z,@next_tile ; skip to next tile if null
0490AF FE 11       0114*       cp tile_activation_routines_count ; carry reset if active tile
0490B1 D2 CB 90 04 0115*       jp nc,@next_tile ; skip to next tile if not active
0490B5             0116*   ; call the tile activation routine
0490B5 21 1C 91 04 0117*       ld hl,tile_activation_routines
0490B9 11 00 00 00 0118*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
0490BD 16 03       0119*       ld d,3 ; three bytes per table entry
0490BF 5F          0120*       ld e,a ; a is the tile type
0490C0 ED 5C       0121*       mlt de ; de is now the offset to the table entry
0490C2 19          0122*       add hl,de ; hl is now the address of the table entry
0490C3 ED 27       0123*       ld hl,(hl) ; hl is now the activation routine address
0490C5             0124*       CALL_HL ; call the activation routine
                       M1 Args: none
0490C5 01 CB 90 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
0490C9 C5          0002*M1     push bc ; which constitutes the return address
0490CA E9          0003*M1     jp (hl) ; Jump to the address in HL
0490CB             0125*   @next_tile:
0490CB             0126*   ; bump x-coords the width of one tile and save it
0490CB 2A D2 8F 04 0127*       ld hl,(tiles_x_plot)
0490CF 01 10 00 00 0128*       ld bc,16
0490D3 09          0129*       add hl,bc
0490D4 22 D2 8F 04 0130*       ld (tiles_x_plot),hl
0490D8             0131*   ; prepare to loop to next column
0490D8 E1          0132*       pop hl ; get back pointer to tile def
0490D9 23          0133*       inc hl ; bump it to the next column
0490DA C1          0134*       pop bc ; snag our loop counter
0490DB 10 CA       0135*       djnz @loop
0490DD C9          0136*       ret ; done
0490DE             0137*   ; end do_active_tiles
