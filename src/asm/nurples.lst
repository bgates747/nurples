0470FB             0143*   @dispatch:
0470FB             0144*       CALL_HL
                       M1 Args: none
0470FB 01 01 71 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
0470FF C5          0002*M1     push bc ; which constitutes the return address
047100 E9          0003*M1     jp (hl) ; Jump to the address in HL
047101 C9          0145*       ret
