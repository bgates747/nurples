046A4F             0459*   ; compute a sprite's new position based on its component x,y velocities
046A4F             0460*   ; with screen boundary checking and update its sprite table record accordingly
046A4F             0461*   ; inputs: table_pointer set to sprite record
046A4F             0462*   ; returns: updated x, y positions and edge collision flags in sprite_screen_edge
046A4F             0463*   ; destroys: everything
046A4F             0464*   ; note: actual rendering of sprite must be handled by caller
046A4F             0465*   move_sprite:
046A4F FD 2A 49 67 0466*       ld iy,(table_pointer)
       04          
046A54             0467*   ; x-axis movement
046A54 FD 27 01    0468*       ld hl,(iy+sprite_x)
046A57 FD 17 07    0469*       ld de,(iy+sprite_xvel)
046A5A 19          0470*       add hl,de
046A5B FD 2F 01    0471*       ld (iy+sprite_x),hl
046A5E             0472*   ; y-axis movement
046A5E FD 27 04    0473*       ld hl,(iy+sprite_y)
046A61 FD 17 0A    0474*       ld de,(iy+sprite_yvel)
046A64 19          0475*       add hl,de
046A65 FD 2F 04    0476*       ld (iy+sprite_y),hl
046A68             0477*   ; detect screen edge collisions
046A68 AF          0478*       xor a ; reset screen edge collision flag and clear carry
046A69 32 4C 67 04 0479*       ld (sprite_screen_edge),a
046A6D             0480*   ; y-axis first since we already have it in hl
046A6D 11 00 00 00 0481*       ld de,-sprite_top*256
046A71 ED 5A       0482*       adc hl,de
046A73 FA 9D 6A 04 0483*       jp m,@top
046A77 ED 52       0484*       sbc hl,de ; hl back to original value
046A79 11 00 C0 FE 0485*       ld de,-sprite_bottom*256
046A7D ED 5A       0486*       adc hl,de
046A7F F2 A7 6A 04 0487*       jp p,@bottom
046A83             0488*   @xaxis:
046A83 FD 27 01    0489*       ld hl,(iy+sprite_x)
046A86 11 00 00 00 0490*       ld de,-sprite_left*256
046A8A ED 5A       0491*       adc hl,de
046A8C FA C2 6A 04 0492*       jp m,@left
046A90 ED 52       0493*       sbc hl,de ; hl back to original value
046A92 11 00 10 FF 0494*       ld de,-sprite_right*256
046A96 ED 5A       0495*       adc hl,de
046A98 F2 D0 6A 04 0496*       jp p,@right
046A9C             0497*   ; no edge collisions so go home
046A9C C9          0498*       ret
046A9D             0499*   @top:
046A9D 3E 08       0500*       ld a,collide_top
046A9F 21 00 00 00 0501*       ld hl,sprite_top*256
046AA3 C3 AD 6A 04 0502*       jp @collide_y
046AA7             0503*   @bottom:
046AA7 3E 04       0504*       ld a,collide_bottom
046AA9 21 00 40 01 0505*       ld hl,sprite_bottom*256
046AAD             0506*   @collide_y:
046AAD 32 4C 67 04 0507*       ld (sprite_screen_edge),a
046AB1 FD 2F 04    0508*       ld (iy+sprite_y),hl
046AB4             0509*   ; reverse y-axis velocity
046AB4 FD 27 0A    0510*       ld hl,(iy+sprite_yvel)
046AB7 CD 7C 04 04 0511*       call neg_hlu
046ABB FD 2F 0A    0512*       ld (iy+sprite_yvel),hl
046ABE             0513*   ; go check for x-axis collisions
046ABE C3 83 6A 04 0514*       jp @xaxis
046AC2             0515*   @left:
046AC2 3A 4C 67 04 0516*       ld a,(sprite_screen_edge)
046AC6 F6 02       0517*       or a,collide_left
046AC8 21 00 00 00 0518*       ld hl,sprite_left*256
046ACC C3 DA 6A 04 0519*       jp @collide_x
046AD0             0520*   @right:
046AD0 3A 4C 67 04 0521*       ld a,(sprite_screen_edge)
046AD4 F6 01       0522*       or a,collide_right
046AD6 21 00 F0 00 0523*       ld hl,sprite_right*256
046ADA             0524*   @collide_x:
046ADA 32 4C 67 04 0525*       ld (sprite_screen_edge),a
046ADE FD 2F 01    0526*       ld (iy+sprite_x),hl
046AE1             0527*   ; reverse x-axis velocity
046AE1 FD 27 07    0528*       ld hl,(iy+sprite_xvel)
046AE4 CD 7C 04 04 0529*       call neg_hlu
046AE8 FD 2F 07    0530*       ld (iy+sprite_xvel),hl
046AEB             0531*   ; final collision flag to a and return
046AEB 3A 4C 67 04 0532*       ld a,(sprite_screen_edge)
