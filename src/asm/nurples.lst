04873E             0083        include "runtime_init.inc"
04873E             0001*   ; Process-entry initialization
04873E             0002*   ; ============================
04873E             0003*   ;
04873E             0004*   ; MOS RUN re-enters the resident binary; it does not restore DB/DL initializers.
04873E             0005*   ; Only state whose lifetime is one application invocation belongs here. Session,
04873E             0006*   ; level, life, table, loader, and arithmetic scratch state is initialized by its
04873E             0007*   ; owning routine before first use.
04873E             0008*   
04873E             0009*   runtime_process_init:
04873E             0010*   ; Process control bytes are ordinary resident RAM. Reset them explicitly on
04873E             0011*   ; every MOS RUN instead of relying on their assembled DB values.
04873E AF          0012*       xor a
04873F 32 4B 6B 04 0013*       ld (game_exit_requested),a
048743 32 4A 5F 04 0014*       ld (player_event),a
048747 32 4C 5F 04 0015*       ld (player_dying_phase),a
04874B 32 4D 5F 04 0016*       ld (player_dying_timer),a
04874F 32 4E 5F 04 0017*       ld (player_dying_spawns),a
048753             0018*   
048753             0019*   ; Diagnostic latches describe this invocation only.
048753 32 4A 6B 04 0020*       ld (game_fault_flags),a
048757 32 E2 49 04 0021*       ld (enemies_fault_flags),a
04875B 32 4B 5F 04 0022*       ld (player_fault_flags),a
04875F 32 4D 67 04 0023*       ld (sprite_fault_flags),a
048763 32 CA 73 04 0024*       ld (tile_fault_flags),a
048767 32 77 13 04 0025*       ld (timer_fault_flags),a
04876B 32 39 14 04 0026*       ld (vdu_timing_fault_flags),a
04876F             0027*   
04876F             0028*   ; Small persistent helpers that otherwise inherit their previous RUN values.
04876F 32 13 4B 04 0029*       ld (seekers_count),a
048773 32 4C 67 04 0030*       ld (sprite_screen_edge),a
048777 32 78 13 04 0031*       ld (oldTimeStamp),a
04877B 21 00 00 00 0032*       ld hl,0
04877F 22 4A 05 04 0033*       ld (seed1),hl
048783 22 4D 05 04 0034*       ld (seed2),hl
048787             0035*   
048787             0036*   ; Publish valid dispatcher states before the first tick. Their owning init
048787             0037*   ; routines will republish the same operational states after resources exist.
048787 21 B8 6C 04 0038*       ld hl,game_init
04878B 22 47 6B 04 0039*       ld (game_state),hl
04878F 21 3F 4A 04 0040*       ld hl,enemies_alive
048793 22 DF 49 04 0041*       ld (enemies_state),hl
048797 21 81 60 04 0042*       ld hl,player_alive
04879B 22 47 5F 04 0043*       ld (player_state),hl
04879F             0044*   
04879F             0045*   ; Restore the documented random seed and establish a current clock baseline.
04879F 3E 50       0046*       ld a,$50
0487A1 32 28 05 04 0047*       ld (r_seed),a
0487A5 CD AF 12 04 0048*       call timestamp_init
0487A9 C9          0049*       ret
0487AA             0050*   ; end runtime_process_init
0487AA             0084    
0487AA             0085    ; --- MAIN PROGRAM FILE ---
0487AA             0086    main:
0487AA             0087    ; Establish a new process lifetime. MOS RUN does not reload initialized data.
0487AA CD 3E 87 04 0088        call runtime_process_init
0487AE             0089    ; Capture the caller's display mode exactly once, before game_init changes VDP
0487AE             0090    ; state. In-process restarts must not replace this with the gameplay mode.
0487AE CD BC 14 04 0091        call vdu_get_screen_mode
0487B2 32 B7 6C 04 0092        ld (original_screen_mode),a
0487B6             0093    main_loop:
0487B6             0094    ; update the global timestamp
0487B6 CD C7 12 04 0095        call timestamp_tick
0487BA             0096    ; do gamestate logic
0487BA CD 4C 6B 04 0097        call do_game
0487BE             0098    ; state handlers return through the dispatcher; honor an orderly exit request
0487BE 3A 4B 6B 04 0099        ld a,(game_exit_requested)
0487C2 B7          0100        or a
0487C3 C2 DC 87 04 0101        jp nz,main_end
0487C7             0102    ; wait for the next vblank mitigate flicker and for loop timing
0487C7 CD 3A 14 04 0103        call vdu_vblank
0487CB             0104    ; poll keyboard for escape keypress
0487CB 3E 08       0105        ld a, $08 ; code to send to MOS
0487CD 5B CF       0106        rst.lil $08 ; get IX pointer to System Variables
0487CF DD 7E 05    0107        ld a, (ix + $05) ; get ASCII code of key pressed
0487D2 FE 1B       0108        cp 27 ; check if 27 (ascii code for ESC)
0487D4 CA DC 87 04 0109        jp z, main_end ; if pressed, jump to exit
0487D8             0110    ; escape not pressed so loop
0487D8 C3 B6 87 04 0111        jp main_loop
0487DC             0112    
0487DC             0113    main_end:
0487DC             0114    ; Release application-owned VDP state. Select the permanent system font before
0487DC             0115    ; deleting the custom-font buffer, and detach sprites before their bitmaps.
0487DC 21 FF FF 00 0116        ld hl,65535
0487E0 AF          0117        xor a
0487E1 CD 5A 18 04 0118        call vdu_font_select
0487E5 CD E2 1A 04 0119        call vdu_sprite_reset
0487E9 CD E8 17 04 0120        call vdu_clear_all_buffers
0487ED             0121    ; restore original screen mode
0487ED 3A B7 6C 04 0122        ld a,(original_screen_mode)
0487F1 CD AB 14 04 0123        call vdu_set_screen_mode
0487F5             0124    ; print thanks for playing message
0487F5 CD 5C 00 04 0125        call printInline
0487F9 54 68 61 6E 0126        asciz "Thank you for playing\r\n"
       6B 20 79 6F 
       75 20 66 6F 
       72 20 70 6C 
       61 79 69 6E 
       67 0D 0A 00 
048811 21 FC 43 04 0127        ld hl,purple_nurples_ascii
048815 CD 63 00 04 0128        call printString
048819 C9          0129        ret
04881A             0130    ; end main
04881A             0131    
04881A             0132    ; needs to be the final include to leave room for the sprite and tile tables
04881A             0133        include "tables.inc"
04881A             0001*   ; #### THIS IS THE SPACE ALLOCATED TO THE SPRITE TABLE ####
04881A             0002*   table_base: equ $
04881A             0003*   player_weapons_begin: equ table_base
04881A             0004*   player_lasers_begin: equ player_weapons_begin
04881A             0005*   player_lasers_end: equ table_record_size*player_lasers_max+player_lasers_begin
04881A             0006*   player_lasers_end_sprite_id: equ [player_lasers_end-table_base]/table_record_size
04881A             0007*   player_weapons_end: equ table_record_size*player_lasers_max+player_weapons_begin
04881A             0008*   player_begin: equ player_weapons_end
04881A             0009*   player_end: equ table_record_size+player_begin
04881A             0010*   enemy_sprites_begin: equ player_end
04881A             0011*   seekers_base: equ enemy_sprites_begin
04881A             0012*   seeker_min_sprite_id: equ [seekers_base-table_base]/table_record_size
04881A             0013*   seekers_end: equ table_record_size*seekers_max+seekers_base
04881A             0014*   seekers_end_sprite_id: equ [seekers_end-table_base]/table_record_size
04881A             0015*   fireballs_base: equ seekers_end
04881A             0016*   fireballs_end: equ table_record_size*fireballs_max+fireballs_base
04881A             0017*   fireballs_end_sprite_id: equ [fireballs_end-table_base]/table_record_size
04881A             0018*   enemy_sprites_end: equ fireballs_end
04881A             0019*   explosions_base: equ enemy_sprites_end
04881A             0020*   explosions_end: equ table_record_size*explosions_max+explosions_base
04881A             0021*   explosions_end_sprite_id: equ [explosions_end-table_base]/table_record_size
04881A             0022*   table_end: equ explosions_end
04881A             0023*   
04881A             0024*   table_num_records: equ [table_end-table_base]/table_record_size
04881A             0025*   table_num_enemy_records: equ [enemy_sprites_end-enemy_sprites_begin]/table_record_size
04881A             0026*   
04881A             0027*   ; ### THIS IS THE SPACE ALLOCATED TO THE ACTIVE TILES TABLE ###
04881A             0028*   tile_table_base: equ table_end
