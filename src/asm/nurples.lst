047A0A 09          0249*       add hl,bc
047A0B 7D          0250*       ld a,l
047A0C E6 FC       0251*       and %11111100 ; round to nearest 4 pixels
047A0E 6F          0252*       ld l,a
047A0F E5          0253*       push hl
047A10 C1          0254*       pop bc
047A11             0255*   ; get y-plot position
047A11 DD 17 06    0256*       ld de,(ix+bar_y0)
047A14 CD A3 18 04 0257*       call vdu_plot_bmp
047A18 C9          0258*       ret
