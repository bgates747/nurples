04893B             0071        include "targeting.inc"
04893B             0001*   ; compute orientation to player
04893B             0002*   ; based on relative positions
04893B             0003*   ; returns: uh.l 16.8 fixed angle256 to player
04893B             0004*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
04893B             0005*   ;    representing delta-x/y *to* target respectively
04893B             0006*   ; inputs: iy pointed at sprite record
04893B             0007*   ; destroys: everything except iy (sprite record pointer)
04893B             0008*   orientation_to_player:
04893B DD 21 23 A2 0009*       ld ix,player_begin
       04          
048940             0010*   ; compute dx
048940 DD 27 01    0011*       ld hl,(ix+sprite_x)
048943 FD 17 01    0012*       ld de,(iy+sprite_x)
048946 B7          0013*       or a ; clear carry
048947 ED 52       0014*       sbc hl,de ; dx
048949 E5          0015*       push hl ; save dx
04894A             0016*   ; compute dy
04894A DD 27 04    0017*       ld hl,(ix+sprite_y)
04894D FD 17 04    0018*       ld de,(iy+sprite_y)
048950 B7          0019*       or a ; clear carry
048951 ED 52       0020*       sbc hl,de ; dy
048953 EB          0021*       ex de,hl ; de = dy
048954             0022*   ; compute angle to player
048954 C1          0023*       pop bc ; dx (was hl)
048955 C5          0024*       push bc ; save dx
048956 D5          0025*       push de ; save dy
048957 CD F0 07 04 0026*       call atan2_168fast ; uh.l = angle to player
04895B 3E E0       0027*       ld a,%11100000
04895D A5          0028*       and l ; round angle to nearest 32th of a circle
04895E 6F          0029*       ld l,a
04895F 22 B0 89 04 0030*       ld (Bearing_t),hl ; return angle to player
048963 D1          0031*       pop de ; restore dy
048964 C1          0032*       pop bc ; restore dx
048965 C9          0033*       ret
048966             0034*   ; end orientation_to_player
048966             0035*   
048966             0036*   ; compute orientation to player
048966             0037*   ; based on relative positions
048966             0038*   ; returns: uh.l 16.8 fixed angle256 to player
048966             0039*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
048966             0040*   ;    representing delta-x/y *to* target respectively
048966             0041*   ; inputs: iy pointed at tile record
048966             0042*   ; destroys: everything except iy (tile record pointer)
048966             0043*   tile_orientation_to_player:
048966 DD 21 23 A2 0044*       ld ix,player_begin
       04          
04896B             0045*   ; compute dx
04896B DD 27 01    0046*       ld hl,(ix+sprite_x)
04896E FD 17 01    0047*       ld de,(iy+tile_x)
048971 B7          0048*       or a ; clear carry
048972 ED 52       0049*       sbc hl,de ; dx
048974 E5          0050*       push hl ; save dx
048975             0051*   ; compute dy
048975 DD 27 04    0052*       ld hl,(ix+sprite_y)
048978 FD 17 04    0053*       ld de,(iy+tile_y)
04897B B7          0054*       or a ; clear carry
04897C ED 52       0055*       sbc hl,de ; dy
04897E EB          0056*       ex de,hl ; de = dy
04897F             0057*   ; compute angle to player
04897F C1          0058*       pop bc ; dx (was hl)
048980 CD F0 07 04 0059*       call atan2_168fast ; uh.l = angle to player
048984 3E E0       0060*       ld a,%11100000
048986 A5          0061*       and l ; round angle to nearest 32th of a circle
048987 6F          0062*       ld l,a
048988 22 B0 89 04 0063*       ld (Bearing_t),hl
04898C C9          0064*       ret
04898D             0065*   ; end tile_orientation_to_player
04898D             0066*   
04898D             0067*   ; compute orientation to coordinate
04898D             0068*   ; based on relative positions
04898D             0069*   ; returns: uh.l 16.8 fixed angle256 to coordinate
04898D             0070*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
04898D             0071*   ;    representing delta-x/y *to* target respectively
04898D             0072*   ; inputs: iy pointed at sprite record, ub.c,ud.e are target x,y coordinates
04898D             0073*   ; destroys: everything except iy (sprite record pointer)
04898D             0074*   bearing_to_coord:
04898D             0075*   ; compute dx
04898D C5          0076*       push bc
04898E E1          0077*       pop hl
04898F FD 07 01    0078*       ld bc,(iy+sprite_x)
048992 B7          0079*       or a ; clear carry
048993 ED 42       0080*       sbc hl,bc ; dx
048995 E5          0081*       push hl ; save dx
048996             0082*   ; compute dy
048996 EB          0083*       ex de,hl
048997 FD 17 04    0084*       ld de,(iy+sprite_y)
04899A B7          0085*       or a ; clear carry
04899B ED 52       0086*       sbc hl,de ; dy
04899D EB          0087*       ex de,hl ; de = dy
04899E             0088*   ; compute angle to coordinate
04899E C1          0089*       pop bc ; dx (was hl)
04899F C5          0090*       push bc ; save dx
0489A0 D5          0091*       push de ; save dy
0489A1 CD F0 07 04 0092*       call atan2_168fast ; uh.l = angle to coordinate
0489A5 3E E0       0093*       ld a,%11100000
0489A7 A5          0094*       and l ; round angle to nearest 32th of a circle
0489A8 6F          0095*       ld l,a
0489A9 22 B0 89 04 0096*       ld (Bearing_t),hl ; return angle to coordinate
0489AD D1          0097*       pop de ; restore dy
0489AE C1          0098*       pop bc ; restore dx
0489AF C9          0099*       ret
0489B0             0100*   ; end bearing_to_coord
0489B0             0101*   
0489B0             0102*   ; targeting_computer variables fixed 16.8 format
0489B0 00 00 00    0103*   Bearing_t: dl 0x000000 ; angle to target
0489B3 00 00 00    0104*   Heading_t: dl 0x000000 ; angle of target motion
0489B6 00 00 00    0105*   Vp: dl 0x000000 ; velocity of projectile
0489B9 00 00 00    0106*   Vp_x: dl 0x000000 ; x component of projectile velocity
0489BC 00 00 00    0107*   Vp_y: dl 0x000000 ; y component of projectile velocity
0489BF 00 00 00    0108*   Vt: dl 0x000000 ; velocity of target
0489C2 00 00 00    0109*   Vt_x: dl 0x000000 ; x component of target velocity
0489C5 00 00 00    0110*   Vt_y: dl 0x000000 ; y component of target velocity
0489C8 00 00 00    0111*   Heading_p: dl 0x000000 ; angle of projectile motion
0489CB 00 00 00    0112*   lead_angle: dl 0x000000 ; lead angle
0489CE             0113*   
0489CE             0114*   ; Inputs:   Vp velocity of projectile set,
0489CE             0115*   ;           iy pointed to sprite record,
0489CE             0116*   ;           player position and velocities correctly set
0489CE             0117*   ; Outputs:  uh.l is the 16.8 fixed firing angle256
0489CE             0118*   ;           ub.c and ud.e are the 16.8 fixed x,y component projectile velocities
0489CE             0119*   ; https://old.robowiki.net/cgi-bin/robowiki?LinearTargeting
0489CE             0120*   targeting_computer:
0489CE DD 21 23 A2 0121*       ld ix,player_begin
       04          
0489D3             0122*   ; ; compute target velocity from x,y component velocities
0489D3             0123*   ;     ld bc,(ix+sprite_xvel)
0489D3             0124*   ;     ld de,(ix+sprite_yvel)
0489D3             0125*   ;     ld hl,-1*256 ; account for vertical ground movement
0489D3             0126*   ;     add hl,de
0489D3             0127*   ;     ex de,hl ; ud.e = player_yvel-1
0489D3             0128*   ;     call cartesian_to_polar_sm ; uh.l = Heading_t, ud.e = Vt
0489D3             0129*   ;     ld (Heading_t),hl ; PASSES
0489D3             0130*   ;     ld (Vt),de ; PASSES
0489D3             0131*   ; ; Bearing_t should have been set by prerequisite call to orientation_to_player
0489D3             0132*   ; ; compute Heading_t-Bearing_t PASSES
0489D3             0133*   ;     ld de,(Bearing_t)
0489D3             0134*   ;     and a ; clear carry
0489D3             0135*   ;     sbc hl,de ; Uh.l = Heading_t-Bearing_t
0489D3             0136*   ; ; compute sin(Heading_t-Bearing_t)
0489D3             0137*   ;     call sin168 ; uh.l = sin(Heading_t-Bearing_t)
0489D3             0138*   ; ; compute (Vt*sin(Heading_t-Bearing_t))
0489D3             0139*   ;     ld de,(Vt)
0489D3             0140*   ;     call smul168 ; uh.l = (Vt*sin(Heading_t-Bearing_t))
0489D3             0141*   ; ; compute (Vt * sin(Heading_t-Bearing_t)) / Vp
0489D3             0142*   ;     ld de,(Vp)
0489D3             0143*   ;     call sdiv168 ; ud.e = (Vt*sin(Heading_t-Bearing_t)) / Vp
0489D3             0144*   ;     ex de,hl ; uh.l = (Vt*sin(Heading_t-Bearing_t)) / Vp
0489D3             0145*   ; ; answer is in radians, convert to degrees256
0489D3             0146*   ;     ld de,0x0028BE ; 40.74 = 57.29578*256/360
0489D3             0147*   ;     call smul168 ; uh.l = angle in degrees256
0489D3             0148*   ;     ld (lead_angle),hl ; TODO: fix this
0489D3             0149*   ; ; add lead angle to target bearing
0489D3             0150*   ;     ld de,(Bearing_t)
0489D3             0151*   ;     add hl,de ; h.l = lead angle+target bearing
0489D3             0152*   
0489D3 2A B0 89 04 0153*       ld hl,(Bearing_t) ; TODO: fix this
0489D7             0154*   
0489D7 E5          0155*       push hl
0489D8             0156*   
0489D8             0157*   ; compute component projectile velocities
0489D8 ED 5B B6 89 0158*       ld de,(Vp) ; Vp should have been set by caller
       04          
0489DD CD F6 06 04 0159*       call polar_to_cartesian ; ub.c = Vp_x, ud.e = Vp_y
0489E1 ED 43 B9 89 0160*       ld (Vp_x),bc
       04          
0489E6             0161*       ; inc d ; account for vertical ground movement
0489E6 ED 53 BC 89 0162*       ld (Vp_y),de
       04          
0489EB E1          0163*       pop hl ; uh.l = lead angle+target bearing
0489EC 22 C8 89 04 0164*       ld (Heading_p),hl
0489F0             0165*   
0489F0 C9          0166*       ret
0489F1             0167*   
