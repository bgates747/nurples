04484F 00          0023*       db 0 ; string terminator
044850             0049        include "collisions.inc"
044850             0001*   ; ====== COLLISION DETECTION ======
044850             0002*   ; --- constants ---
044850             0003*   ; sprite_collisions flags
044850             0004*   ; collides_with_player: equ %00000001
044850             0005*   ; collides_with_laser: equ %00000010
044850             0006*   sprite_alive: equ 6; set when sprite is alive
044850             0007*   sprite_just_died: equ 7; set when sprite just died
044850             0008*   collide_top: equ %00001000
044850             0009*   collide_bottom: equ %00000100
044850             0010*   collide_left: equ %00000010
044850             0011*   collide_right: equ %00000001
044850             0012*   
044850 00 00 00    0013*   collision_table_pointer: dl 0x000000 ; pointer to the sprite in the group being checked for collision
044853             0014*   
044853             0015*   collision_draw_hitboxes:
044853             0016*   ; draw hitbox for ix collider
044853 DD E5       0017*       push ix
044855 FD E5       0018*       push iy
044857 AF          0019*       xor a ; color mode 0
044858 0E 09       0020*       ld c,c_red
04485A CD F4 13 04 0021*       call vdu_gcol
04485E 01 00 00 00 0022*       ld bc,0
044862 DD 4E 02    0023*       ld c,(ix+sprite_x+1)
044865 DD 46 03    0024*       ld b,(ix+sprite_x+2)
044868 11 00 00 00 0025*       ld de,0
04486C DD 5E 05    0026*       ld e,(ix+sprite_y+1)
04486F DD 56 06    0027*       ld d,(ix+sprite_y+2)
044872 21 00 00 00 0028*       ld hl,0 ; clear hlu and h
044876 DD 6E 1E    0029*       ld l,(ix+sprite_dim_x)
044879 09          0030*       add hl,bc ; hl = x1
04487A E5          0031*       push hl ; save x1
04487B 21 00 00 00 0032*       ld hl,0 ; clear hlu and h
04487F DD 6E 1F    0033*       ld l,(ix+sprite_dim_y)
044882 19          0034*       add hl,de ; hl = y1
044883 DD E1       0035*       pop ix ; ix = x1 (was hl)
044885 E5          0036*       push hl
044886 FD E1       0037*       pop iy ; iy = y1
044888 CD 37 19 04 0038*       call vdu_plot_rf
04488C FD E1       0039*       pop iy
04488E DD E1       0040*       pop ix
044890             0041*   
044890             0042*   ; draw hitbox for iy collider
044890 DD E5       0043*       push ix
044892 FD E5       0044*       push iy
044894 AF          0045*       xor a ; color mode 0
044895 0E 0A       0046*       ld c,c_green
044897 CD F4 13 04 0047*       call vdu_gcol
04489B 01 00 00 00 0048*       ld bc,0
04489F FD 4E 02    0049*       ld c,(iy+sprite_x+1)
0448A2 FD 46 03    0050*       ld b,(iy+sprite_x+2)
0448A5 11 00 00 00 0051*       ld de,0
0448A9 FD 5E 05    0052*       ld e,(iy+sprite_y+1)
0448AC FD 56 06    0053*       ld d,(iy+sprite_y+2)
0448AF 21 00 00 00 0054*       ld hl,0 ; clear hlu and h
0448B3 FD 6E 1E    0055*       ld l,(iy+sprite_dim_x)
0448B6 09          0056*       add hl,bc ; hl = x1
0448B7 E5          0057*       push hl ; save x1
0448B8 21 00 00 00 0058*       ld hl,0 ; clear hlu and h
0448BC FD 6E 1F    0059*       ld l,(iy+sprite_dim_y)
0448BF 19          0060*       add hl,de ; hl = y1
0448C0 DD E1       0061*       pop ix ; ix = x1 (was hl)
0448C2 E5          0062*       push hl
0448C3 FD E1       0063*       pop iy ; iy = y1
0448C5 CD 37 19 04 0064*       call vdu_plot_rf
0448C9 FD E1       0065*       pop iy
0448CB DD E1       0066*       pop ix
0448CD C9          0067*       ret
0448CE             0068*   ; end collision_draw_hitboxes
0448CE             0069*   
0448CE             0070*   ; check_collision:
0448CE             0071*   ; Detects collision using bounding box method.
0448CE             0072*   ; Inputs:
0448CE             0073*   ;   IX -> Sprite/Tile table for Collider A
0448CE             0074*   ;   IY -> Sprite/Tile table for Collider B
0448CE             0075*   ; Outputs:
0448CE             0076*   ;   a = 0, zero flag set, positive sign, carry reset -> Collision detected
0448CE             0077*   ;   a = -1, zero flag reset, negative sign, carry set -> No collision detected
0448CE             0078*   ; Destroys: HL, DE, AF
0448CE             0079*   check_collision:
0448CE             0080*   check_collision_box:
0448CE             0081*   ; Test 1: (ay + ah) - by < 0
0448CE 21 00 00 00 0082*       ld hl,0                     ; Clear hlu
0448D2 DD 6E 05    0083*       ld l,(ix+sprite_y+1)        ; Load ay integer part low byte
0448D5 DD 66 06    0084*       ld h,(ix+sprite_y+2)        ; Load ay integer part high byte
0448D8 11 00 00 00 0085*       ld de,0                     ; Clear deu and d
0448DC DD 5E 1F    0086*       ld e,(ix+sprite_dim_y)      ; Load ah
0448DF 19          0087*       add hl,de                   ; (ay + ah)
0448E0 FD 5E 05    0088*       ld e,(iy+sprite_y+1)        ; Load by integer part low byte
0448E3 FD 56 06    0089*       ld d,(iy+sprite_y+2)        ; Load by integer part high byte
0448E6 AF          0090*       xor a                       ; Clear carry
0448E7 ED 52       0091*       sbc hl,de                   ; (ay + ah) - by
0448E9 FA 4C 49 04 0092*       jp m,@not_collision         ; No collision if negative
0448ED             0093*   
0448ED             0094*   ; Test 2: ay - (by + bh) < 0
0448ED 21 00 00 00 0095*       ld hl,0                     ; Clear hlu
0448F1 FD 6E 05    0096*       ld l,(iy+sprite_y+1)        ; Load by integer part low byte
0448F4 FD 66 06    0097*       ld h,(iy+sprite_y+2)        ; Load by integer part high byte
0448F7 11 00 00 00 0098*       ld de,0                     ; Clear deu and d
0448FB FD 5E 1F    0099*       ld e,(iy+sprite_dim_y)      ; Load bh
0448FE 19          0100*       add hl,de                   ; (by + bh)
0448FF DD 5E 05    0101*       ld e,(ix+sprite_y+1)        ; Load ay integer part low byte
044902 DD 56 06    0102*       ld d,(ix+sprite_y+2)        ; Load ay integer part high byte
044905 AF          0103*       xor a                       ; Clear carry
044906 ED 52       0104*       sbc hl,de                   ; (by + bh) - ay
044908 FA 4C 49 04 0105*       jp m,@not_collision         ; No collision if negative
04490C             0106*   
04490C             0107*   ; Test 3: (ax + aw) - bx < 0
04490C 21 00 00 00 0108*       ld hl,0                     ; Clear hlu
044910 DD 6E 02    0109*       ld l,(ix+sprite_x+1)        ; Load ax integer part low byte
044913 DD 66 03    0110*       ld h,(ix+sprite_x+2)        ; Load ax integer part high byte
044916 11 00 00 00 0111*       ld de,0                     ; Clear deu and d
04491A DD 5E 1E    0112*       ld e,(ix+sprite_dim_x)      ; Load aw
04491D 19          0113*       add hl,de                   ; (ax + aw)
04491E FD 5E 02    0114*       ld e,(iy+sprite_x+1)        ; Load bx integer part low byte
044921 FD 56 03    0115*       ld d,(iy+sprite_x+2)        ; Load bx integer part high byte
044924 AF          0116*       xor a                       ; Clear carry
044925 ED 52       0117*       sbc hl,de                   ; (ax + aw) - bx
044927 FA 4C 49 04 0118*       jp m,@not_collision         ; No collision if negative
04492B             0119*   
04492B             0120*   ; Test 4: ax - (bx + bw) < 0
04492B 21 00 00 00 0121*       ld hl,0                     ; Clear hlu
04492F FD 6E 02    0122*       ld l,(iy+sprite_x+1)        ; Load bx integer part low byte
044932 FD 66 03    0123*       ld h,(iy+sprite_x+2)        ; Load bx integer part high byte
044935 11 00 00 00 0124*       ld de,0                     ; Clear deu and d
044939 FD 5E 1E    0125*       ld e,(iy+sprite_dim_x)      ; Load bw
04493C 19          0126*       add hl,de                   ; (bx + bw)
04493D DD 5E 02    0127*       ld e,(ix+sprite_x+1)        ; Load ax integer part low byte
044940 DD 56 03    0128*       ld d,(ix+sprite_x+2)        ; Load ax integer part high byte
044943 AF          0129*       xor a                       ; Clear carry
044944 ED 52       0130*       sbc hl,de                   ; (bx + bw) - ax
044946 FA 4C 49 04 0131*       jp m,@not_collision         ; No collision if negative
04494A             0132*   
04494A             0133*   ; If all tests pass, collision is detected
04494A             0134*   @is_collision:
04494A AF          0135*       xor a                       ; Clear accumulator and flags (a = 0)
04494B C9          0136*       ret                         ; Return with zero flag set
04494C             0137*   
04494C             0138*   ; No collision detected
04494C             0139*   @not_collision:
04494C 3D          0140*       dec a                       ; Set a to -1
04494D C9          0141*       ret                         ; Return with carry set
04494E             0142*   ; End check_collision_box
04494E             0143*   
04494E             0144*   
04494E             0145*   ; this routine detects collisions between two collidable objects,
04494E             0146*   ; which can include sprites, active tiles, or any screen coordinate
04494E             0147*   ; which has been set up with a sprite table structure that includes dim_x
04494E             0148*   ; representing the radius of the collidable object
04494E             0149*   ; inputs: ix and iy point to the colliding objects' sprite/tile table records
04494E             0150*   ; outputs: uh.l = distance - sum of radii
04494E             0151*   ;          zero flag set if collision detected
04494E             0152*   ;          dx168 and dy168 are also populated with the signed displacements
04494E             0153*   ; destroys: everything except indexes
04494E             0154*   ; check_collision:
04494E             0155*   check_collision_cartesian:
04494E             0156*   ; compute dx = x1-x0
04494E DD 27 01    0157*       ld hl,(ix+sprite_x)
044951 FD 17 01    0158*       ld de,(iy+sprite_x)
044954 AF          0159*       xor a ; clear carry
044955 ED 52       0160*       sbc hl,de
044957 22 84 07 04 0161*       ld (dx168),hl ; dx to scratch
04495B             0162*   ; compute dy = y1-y0
04495B DD 27 04    0163*       ld hl,(ix+sprite_y)
04495E FD 17 04    0164*       ld de,(iy+sprite_y)
044961 AF          0165*       xor a ; clear carry
044962 ED 52       0166*       sbc hl,de ; hl = dy
044964 22 8A 07 04 0167*       ld (dy168),hl ; dy to scratch
044968             0168*   ; compute euclidean distance between centers
044968 CD 90 07 04 0169*       call distance168 ; uh.l = distance
04496C             0170*   ; check for overlap by summing half the radii
04496C DD 7E 1E    0171*       ld a,(ix+sprite_dim_x)
04496F CB 3F       0172*       srl a ; divide by 2
044971 FD 5E 1E    0173*       ld e,(iy+sprite_dim_x)
044974 CB 3B       0174*       srl e ; divide by 2
044976 83          0175*       add a,e
044977 11 00 00 00 0176*       ld de,0 ; clear deu and e
04497B 57          0177*       ld d,a ; ud.e = sum of radii
04497C B7          0178*       or a ; clear carry
04497D ED 52       0179*       sbc hl,de ; uh.l = distance - sum of radii
04497F C8          0180*       ret z ; return collision
044980 F0          0181*       ret p ; return no collision
044981 AF          0182*       xor a ; return collision
044982 C9          0183*       ret
044983             0184*   ; end check_collision_cartesian
044983             0185*   
044983             0186*   ; check collisions of a sprite or tile against a sprite group
044983             0187*   ; inputs: iy = pointer to sprite or tile record being checked
044983             0188*   ;         ix = pointer to sprite group, b = number of records in sprite group
044983             0189*   check_sprite_group_collisions:
044983             0190*   @collision_loop:
044983 DD 22 50 48 0191*       ld (collision_table_pointer),ix ; update table pointer
       04          
044988 C5          0192*       push bc ; backup loop counter
044989             0193*   ; check sprite_collisions sprite_alive flag to see if sprite is active
044989 DD CB 1D 76 0194*       bit sprite_alive,(ix+sprite_collisions)
04498D CA A3 49 04 0195*       jp z,@next_record ; not alive so skip to next record
044991             0196*   ; sprite alive so check for collision
044991 CD CE 48 04 0197*       call check_collision
044995 C2 A3 49 04 0198*       jp nz,@next_record ; no collision
044999             0199*   ; set sprite_just_died flag for each entity and return to caller
044999 C1          0200*       pop bc ; dummy pop to balance stack
04499A DD CB 1D FE 0201*       set sprite_just_died,(ix+sprite_collisions)
04499E FD CB 1D FE 0202*       set sprite_just_died,(iy+sprite_collisions)
0449A2 C9          0203*       ret
0449A3             0204*   @next_record:
0449A3 C1          0205*       pop bc ; get back our loop counter
0449A4 ED 32 40    0206*       lea ix,ix+table_record_size
0449A7 10 DA       0207*       djnz @collision_loop ; loop until we've checked all the records
0449A9             0208*   ; return to caller
0449A9 AF          0209*       xor a
0449AA 3C          0210*       inc a ; resets sign flag and a to non-zero indicating no collision
0449AB C9          0211*       ret
0449AC             0212*   ; end check_sprite_group_collisions
0449AC             0213*   
0449AC             0214*   check_enemy_collision_laser: ; check for collisions with laser
0449AC DD 21 F3 86 0215*       ld ix,player_lasers_begin
       04          
0449B1 06 04       0216*       ld b,player_lasers_max
0449B3 CD 83 49 04 0217*       call check_sprite_group_collisions
0449B7 C9          0218*       ret
0449B8             0219*   ; end check_enemy_collision_laser
0449B8             0220*   
0449B8             0221*   check_enemy_collision_player: ; check for collisions with player
0449B8 DD 21 F3 87 0222*       ld ix,player_begin
       04          
0449BD CD CE 48 04 0223*       call check_collision
0449C1 C0          0224*       ret nz ; no collision so nothing to do
0449C2 DD CB 1D FE 0225*       set sprite_just_died,(ix+sprite_collisions)
0449C6 FD CB 1D FE 0226*       set sprite_just_died,(iy+sprite_collisions)
0449CA AF          0227*       xor a ; signal collision detected
0449CB C9          0228*       ret
0449CC             0229*   ; end check_enemy_collision_player
0449CC             0050        include "enemies.inc"
0449CC 2C 4A 04    0001*   enemies_state: dl enemies_alive
0449CF             0002*   enemies_fault_bad_state: equ 0
0449CF 00          0003*   enemies_fault_flags: db 0 ; latched fail-closed diagnostics
0449D0             0004*   
0449D0             0005*   do_enemies:
0449D0 2A CC 49 04 0006*       ld hl,(enemies_state)
0449D4 CD F2 49 04 0007*       call enemies_state_pointer_valid
0449D8 DA EB 49 04 0008*       jp c,@dispatch
0449DC 21 CF 49 04 0009*       ld hl,enemies_fault_flags
0449E0 CB C6       0010*       set enemies_fault_bad_state,(hl)
0449E2 21 39 4A 04 0011*       ld hl,enemies_dead ; actor-local fail-closed state for the next tick
0449E6 22 CC 49 04 0012*       ld (enemies_state),hl
0449EA C9          0013*       ret
0449EB             0014*   @dispatch:
0449EB             0015*       CALL_HL
                       M1 Args: none
0449EB 01 F1 49 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
0449EF C5          0002*M1     push bc ; which constitutes the return address
0449F0 E9          0003*M1     jp (hl) ; Jump to the address in HL
0449F1 C9          0016*       ret
0449F2             0017*   
0449F2             0018*   ; Exact stabilization whitelist for writable legacy enemy-state pointers.
0449F2             0019*   enemies_state_pointer_valid:
0449F2 11 2C 4A 04 0020*       ld de,enemies_alive
0449F6 CD 26 4A 04 0021*       call @matches
0449FA CA 24 4A 04 0022*       jp z,@valid
0449FE 11 38 4A 04 0023*       ld de,enemies_despawning
044A02 CD 26 4A 04 0024*       call @matches
044A06 CA 24 4A 04 0025*       jp z,@valid
044A0A 11 39 4A 04 0026*       ld de,enemies_dead
044A0E CD 26 4A 04 0027*       call @matches
044A12 CA 24 4A 04 0028*       jp z,@valid
044A16 11 3A 4A 04 0029*       ld de,enemies_respawning
044A1A CD 26 4A 04 0030*       call @matches
044A1E CA 24 4A 04 0031*       jp z,@valid
044A22 AF          0032*       xor a
044A23 C9          0033*       ret
044A24             0034*   @valid:
044A24 37          0035*       scf
044A25 C9          0036*       ret
044A26             0037*   @matches:
044A26 E5          0038*       push hl
044A27 B7          0039*       or a
044A28 ED 52       0040*       sbc hl,de
044A2A E1          0041*       pop hl
044A2B C9          0042*       ret
044A2C             0043*   ; end enemies_state_pointer_valid
044A2C             0044*   
044A2C             0045*   enemies_alive:
044A2C FD 21 33 88 0046*       ld iy,enemy_sprites_begin
       04          
044A31 06 07       0047*       ld b,table_num_enemy_records
044A33 CD 11 69 04 0048*       call move_sprite_group
044A37 C9          0049*       ret
044A38             0050*   
044A38             0051*   enemies_despawning:
044A38 C9          0052*       ret
044A39             0053*   
044A39             0054*   enemies_dead:
044A39 C9          0055*       ret
044A3A             0056*   
044A3A             0057*   enemies_respawning:
044A3A C9          0058*       ret
044A3B             0051        include "enemy_fireball.inc"
044A3B             0001*   speed_fireball: equ 4*256 ; 6 pixels per frame 16.8 fixed
044A3B             0002*   fireballs_max: equ 4
044A3B             0003*   
044A3B             0004*   fireball_defaults:
044A3B 03          0005*       db enemy_projectile     ; type
044A3C 0E 01 00    0006*       dl BUF_FIREBALL_2_000   ; base_bufferId
044A3F 8D 4A 04    0007*       dl move_enemy_fireball  ; move_program
044A42 40          0008*       db %01000000            ; collisions bit 6 signals sprite alive
044A43 10          0009*       db 16                   ; dim_x
044A44 10          0010*       db 16                   ; dim_y
044A45 20          0011*       db 32                   ; num_orientations
044A46 02          0012*       db 2                    ; num_animations
044A47 00          0013*       db 0                    ; animation
044A48 08          0014*       db 8                    ; animation_timer
044A49 00          0015*       db 0                    ; move_timer
044A4A 00          0016*       db 0                    ; move_step
044A4B 00          0017*       db 0                    ; points
044A4C FE          0018*       db -2                   ; shield_damage
044A4D 00          0019*       db 0                    ; frame
044A4E             0020*   
044A4E             0021*   enemy_spawn_fireball:
044A4E 21 3B 4A 04 0022*       ld hl,fireball_defaults
044A52 DD 21 F3 88 0023*       ld ix,fireballs_base
       04          
044A57 06 04       0024*       ld b,fireballs_max
044A59 CD 29 78 04 0025*       call spawn_sprite_from_tile
044A5D D0          0026*       ret nc ; no carry means no free sprite slots, so we go home
044A5E             0027*   ; other specific initialization
044A5E             0028*   ; ------------------------------------------------
044A5E             0029*   ; copy sprite heading and component velocities from targeting_computer
044A5E 2A 71 6F 04 0030*       ld hl,(Bearing_t)
044A62 11 00 80 00 0031*       ld de,128*256 ; rotate 128 degrees
044A66 19          0032*       add hl,de
044A67 DD 2F 10    0033*       ld (ix+sprite_heading),hl
044A6A 2A 7A 6F 04 0034*       ld hl,(Vp_x)
044A6E DD 2F 07    0035*       ld (ix+sprite_xvel),hl
044A71 2A 7D 6F 04 0036*       ld hl,(Vp_y)
044A75 DD 2F 0A    0037*       ld (ix+sprite_yvel),hl
044A78             0038*   ; move projectile one frame's distance so it isn't drawn right over turret
044A78 DD 27 01    0039*       ld hl,(ix+sprite_x)
044A7B DD 17 07    0040*       ld de,(ix+sprite_xvel)
044A7E 19          0041*       add hl,de
044A7F DD 2F 01    0042*       ld (ix+sprite_x),hl
044A82 DD 27 04    0043*       ld hl,(ix+sprite_y)
