044D73             0005*   tileset_ptrs:
044D73             0006*       ; dl tiles_xevious_levels
044D73 27 4F 04    0007*       dl tileset_00_levels
044D76 00 00 00    0008*   tileset_ptrs_end: dl 0 ; list terminator
044D79             0009*   tileset_ptrs_count: equ [tileset_ptrs_end-tileset_ptrs]/3
044D79             0010*   
044D79             0011*   ; get a pointer to the current tileset
044D79             0012*   ; inputs: tileset_ptr_idx
044D79             0013*   ; returns: ix = pointer to tileset levels lut
044D79             0014*   get_tileset_ptr:
044D79 3A 70 4D 04 0015*       ld a,(tileset_ptr_idx)
044D7D FE 01       0016*       cp tileset_ptrs_count
044D7F DA 88 4D 04 0017*       jp c,@index_valid
044D83 AF          0018*       xor a ; corrupt/out-of-range selectors recover to the first tileset
044D84 32 70 4D 04 0019*       ld (tileset_ptr_idx),a
044D88             0020*   @index_valid:
044D88 11 00 00 00 0021*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
044D8C 57          0022*       ld d,a ; d = tileset index
044D8D 1E 03       0023*       ld e,3 ; three bytes per index record
044D8F ED 5C       0024*       mlt de ; offset into tileset_ptrs lut
044D91 DD 21 73 4D 0025*       ld ix,tileset_ptrs
       04          
044D96 DD 19       0026*       add ix,de ; ix = pointer to tileset_ptrs record
044D98 C9          0027*       ret
044D99             0028*   ; end get_tileset_ptr
044D99             0029*   
044D99             0030*   ; intialize a tileset
044D99             0031*   ; inputs: a = index into tileset_ptrs
044D99             0032*   init_tileset:
044D99 32 70 4D 04 0033*       ld (tileset_ptr_idx),a ; store new tileset index
044D9D CD 79 4D 04 0034*       call get_tileset_ptr ; ix = pointer to tileset_ptrs record
044DA1 DD 37 00    0035*       ld ix,(ix) ; ix = pointer to tileset levels lut
044DA4 DD 7E FF    0036*       ld a,(ix-1) ; number of levels in the tileset
044DA7 32 C5 4D 04 0037*       ld (num_levels),a
044DAB AF          0038*       xor a ; reset current level to zero
044DAC 32 C4 4D 04 0039*       ld (cur_level),a
044DB0 C3 25 4E 04 0040*       jp init_level
044DB4             0041*   ; end init_tileset
044DB4             0042*   
044DB4             0043*   next_tileset:
044DB4 3A 70 4D 04 0044*       ld a,(tileset_ptr_idx)
044DB8 3C          0045*       inc a ; bump to next index
044DB9 FE 01       0046*       cp tileset_ptrs_count
044DBB DA 99 4D 04 0047*       jp c,init_tileset
044DBF AF          0048*       xor a ; wrap to the first tileset without dereferencing the terminator
044DC0 C3 99 4D 04 0049*       jp init_tileset
044DC4             0050*   ; end next_tileset
044DC4             0051*   
044DC4 00          0052*   cur_level: db 0
044DC5 00          0053*   num_levels: db 0
044DC6             0054*   
044DC6             0055*   ; get a pointer to the current level lookup record
044DC6             0056*   ; inputs: tileset_ptr_idx, cur_level
044DC6             0057*   ; returns: ix = pointer to level definition
044DC6             0058*   get_level_ptr:
044DC6 CD 79 4D 04 0059*       call get_tileset_ptr
044DCA DD 37 00    0060*       ld ix,(ix) ; ix = pointer to tileset levels lut
044DCD DD 7E FF    0061*       ld a,(ix-1) ; refresh the count after any outer-selector recovery
044DD0 32 C5 4D 04 0062*       ld (num_levels),a
044DD4 47          0063*       ld b,a
044DD5 3A C4 4D 04 0064*       ld a,(cur_level)
044DD9 B8          0065*       cp b
044DDA DA E3 4D 04 0066*       jp c,@index_valid
044DDE             0067*   @index_invalid:
044DDE AF          0068*       xor a ; corrupt/out-of-range selectors recover to the first level
044DDF 32 C4 4D 04 0069*       ld (cur_level),a
044DE3             0070*   @index_valid:
044DE3 11 00 00 00 0071*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
044DE7 57          0072*       ld d,a ; d = level index
044DE8 1E 03       0073*       ld e,3 ; three bytes per level record
044DEA ED 5C       0074*       mlt de ; offset into tileset levels lut
044DEC DD 19       0075*       add ix,de ; ix = pointer to level record
044DEE C9          0076*       ret
044DEF             0077*   ; end get_level_ptr
044DEF             0078*   
044DEF             0079*   ; advance to the next level in the current tileset
044DEF             0080*   ; inputs: tileset_ptr_idx, cur_level
044DEF             0081*   next_level:
044DEF             0082*   ; update starting score
044DEF 2A 94 66 04 0083*       ld hl,(player_score)
044DF3 22 97 66 04 0084*       ld (player_starting_score),hl
044DF7             0085*   ; refresh the authoritative inner-table count before advancing
044DF7 CD 79 4D 04 0086*       call get_tileset_ptr
044DFB DD 37 00    0087*       ld ix,(ix)
044DFE DD 7E FF    0088*       ld a,(ix-1)
044E01 32 C5 4D 04 0089*       ld (num_levels),a
044E05 47          0090*       ld b,a
044E06             0091*   ; select the next valid level without indexing the terminator
044E06 3A C4 4D 04 0092*       ld a,(cur_level)
044E0A 3C          0093*       inc a ; bump to next level
044E0B CA 1C 4E 04 0094*       jp z,@advance_tileset ; guard a corrupt 255 index wrapping to zero
044E0F B8          0095*       cp b
044E10 D2 1C 4E 04 0096*       jp nc,@advance_tileset
044E14 32 C4 4D 04 0097*       ld (cur_level),a
044E18 C3 25 4E 04 0098*       jp init_level
044E1C             0099*   @advance_tileset:
044E1C AF          0100*       xor a
044E1D 32 C4 4D 04 0101*       ld (cur_level),a
044E21 C3 B4 4D 04 0102*       jp next_tileset
044E25             0103*   ; end next_level
