0485FD             0195*       ; ld de,-1*256 ; account for vertical ground movement
0485FD             0196*       ; add hl,de
0485FD             0197*       ; call print_s168_hl
0485FD             0198*   
0485FD CD 5C 00 04 0199*       call printInline
048601 0D 0A 4C 64 0200*       asciz "\r\nLda"
       61 00       
048607 2A 69 85 04 0201*       ld hl,(lead_angle)
04860B CD ED 01 04 0202*       call print_s168_hl
04860F             0203*   
