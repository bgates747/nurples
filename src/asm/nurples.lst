04669A             0006*   ; outputs: hl,player_score = updated score
04669A             0007*   ; destroys: hl,de
04669A             0008*   update_score:
04669A 11 00 00 00 0009*       ld de,0 ; clear deu and d
04669E FD 5E 26    0010*       ld e,(iy+sprite_points)
0466A1 2A 94 66 04 0011*       ld hl,(player_score)
0466A5 19          0012*       add hl,de
0466A6 22 94 66 04 0013*       ld (player_score),hl
0466AA CD AF 66 04 0014*       call print_score
0466AE C9          0015*       ret
0466AF             0016*   ; end update_score
0466AF             0017*   
0466AF             0018*   ; text coordinates for score display
0466AF             0019*   score_x: equ 50
0466AF             0020*   score_y: equ 33
0466AF             0021*   ; inputs: none
0466AF             0022*   print_score:
0466AF             0023*   ; set text colors
0466AF 3E 80       0024*       ld a,c_black+128
0466B1 CD F6 13 04 0025*       call vdu_colour_text
0466B5 3E 0A       0026*       ld a,c_green
0466B7 CD F6 13 04 0027*       call vdu_colour_text
0466BB             0028*   ; print the score
0466BB 0E 32       0029*       ld c,score_x
0466BD 06 21       0030*       ld b,score_y
0466BF CD B1 13 04 0031*       call vdu_move_cursor
0466C3 2A 94 66 04 0032*       ld hl,(player_score)
0466C7 CD C8 00 04 0033*       call printDec
0466CB C9          0034*       ret
0466CC             0035*   ; end print_score
