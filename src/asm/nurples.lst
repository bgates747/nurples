040FFA 11 00 88 01 0024*       ld de,[sprites_num_images+tiles_dg_num_images+ui_num_images]*256
040FFE CD 75 06 04 0025*       call sdiv168 ; ud.e = distance / num images = y velocity
041002 ED 53 9C 10 0026*       ld (logo_yvel),de
       04          
041007             0027*   ; all done
