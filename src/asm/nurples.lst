045F41             0061        include "player_state.inc"
045F41             0001*   player_defaults:
045F41 05          0002*       db player               ; type
045F42 73 01 00    0003*       dl BUF_SHIP_0L          ; base_bufferId
045F45 AB 5F 04    0004*       dl do_player            ; move_program
045F48 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
045F49 10          0006*       db 16                   ; dim_x
045F4A 10          0007*       db 16                   ; dim_y
045F4B 01          0008*       db 1                    ; num_orientations
045F4C 01          0009*       db 1                    ; num_animations
045F4D 00          0010*       db 0                    ; animation
045F4E 00          0011*       db 0                    ; animation_timer
045F4F 00          0012*       db 0                    ; move_timer
045F50 00          0013*       db 0                    ; move_step
045F51 00          0014*       db 0                    ; points
045F52 00          0015*       db 0                    ; shield_damage
045F53 00          0016*       db 0                    ; frame
045F54             0017*   
045F54 8B 60 04    0018*   player_state:  dl player_alive
045F57             0019*   player_event_none: equ 0
045F57             0020*   player_event_game_over: equ 1
045F57 00          0021*   player_event: db player_event_none
045F58             0022*   player_fault_bad_state: equ 0
045F58 00          0023*   player_fault_flags: db 0 ; latched fail-closed diagnostics
045F59 00          0024*   player_ships: db 0
045F5A 03          0025*   player_ships_max: db 3
045F5B             0026*   player_speed: equ 3*256 ; pixels per frame 16.8 fixed
045F5B             0027*   
045F5B             0028*   draw_player_ships:
045F5B             0029*   ; activate mfd
045F5B DD 21 E8 61 0030*       ld ix,mfd_ships
       04          
045F60 CD EF 62 04 0031*       call mfd_activate
045F64             0032*   ; blank out previously drawn ships
045F64 AF          0033*       xor a ; color mode 0
045F65 0E 00       0034*       ld c,c_black
045F67 CD 14 14 04 0035*       call vdu_gcol
045F6B 01 00 00 00 0036*       ld bc,0
045F6F 11 00 00 00 0037*       ld de,0
045F73 DD 21 4F 00 0038*       ld ix,0+79
       00          
045F78 FD 21 0F 00 0039*       ld iy,0+15
       00          
045F7D CD 57 19 04 0040*       call vdu_plot_rf
045F81             0041*   ; draw the ships remaining
045F81 21 2B 00 00 0042*       ld hl,BUF_SHIP_MFD
045F85 CD E4 14 04 0043*       call vdu_buff_select
045F89 3A 59 5F 04 0044*       ld a,(player_ships) ; loop counter
045F8D 01 00 00 00 0045*       ld bc,0 ; starting x-coordinate
045F91             0046*   @loop:
045F91 3D          0047*       dec a ; we don't count the ship we're flying
045F92 C8          0048*       ret z
045F93 F5          0049*       push af ; back up loop counter
045F94 C5          0050*       push bc ; save x-coordinate
045F95 11 00 00 00 0051*       ld de,0 ; y-coordinate
045F99 CD 1A 19 04 0052*       call vdu_plot_bmp
045F9D C1          0053*       pop bc ; restore x-coordinate
045F9E 21 10 00 00 0054*       ld hl,16 ; bump x-coords
045FA2 09          0055*       add hl,bc
045FA3 E5          0056*       push hl
045FA4 C1          0057*       pop bc ; bc = new x-coordinate
045FA5 F1          0058*       pop af
045FA6 C3 91 5F 04 0059*       jp @loop
045FAA C9          0060*       ret
045FAB             0061*   ; end draw_player_ships
045FAB             0062*   
045FAB             0063*   do_player:
045FAB 2A 54 5F 04 0064*       ld hl,(player_state)
045FAF CD CB 5F 04 0065*       call player_state_pointer_valid
045FB3 DA C4 5F 04 0066*       jp c,@dispatch
045FB7 21 58 5F 04 0067*       ld hl,player_fault_flags
045FBB CB C6       0068*       set player_fault_bad_state,(hl)
