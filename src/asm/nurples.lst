042373 06 08       0044*       ld b,explosions_max
042375 CD 94 7E 04 0045*       call spawn_sprite_from_sprite
042379 D8          0046*       ret c ; carry is the only indication that IX names a valid explosion
04237A             0047*   ; no slot: keep the player hidden and return failure without exposing invalid IX
04237A CD D0 7D 04 0048*       call table_deactivate_sprite
04237E AF          0049*       xor a ; clear carry after the VDU calls in table_deactivate_sprite
04237F C9          0050*       ret
