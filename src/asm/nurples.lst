04800D C1          0659*       pop bc ; bc = number of frames
04800E E1          0660*       pop hl ; = base bufferId
04800F             0661*   @load_frames:
04800F C5          0662*       push bc ; back up loop counter
048010 E5          0663*       push hl ; back up base bufferId
048011 CD 58 1B 04 0664*       call vdu_sprite_add_buff
048015 E1          0665*       pop hl ; restore base bufferId
048016 23          0666*       inc hl ; bump it to the next frame
048017             0667*   ; decrement loop counter
048017 C1          0668*       pop bc
048018 0B          0669*       dec bc
048019 79          0670*       ld a,c
04801A B7          0671*       or a
04801B C2 0F 80 04 0672*       jp nz,@load_frames
04801F 78          0673*       ld a,b
048020 B7          0674*       or a
048021 C2 0F 80 04 0675*       jp nz,@load_frames
048025 C9          0676*       ret
048026             0677*   ; end sprite_load_frames
