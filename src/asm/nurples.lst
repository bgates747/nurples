0492A8 D1          0214*       pop de ; address to copy to
0492A9 01 13 00 00 0215*       ld bc,tile_definitions_size ; copy only bytes provided by defaults
0492AD ED B0       0216*       ldir ; copies defaults to new tile record
0492AF DD 2A 54 8D 0217*       ld ix,(tile_table_pointer) ; restore pointer to new tile record
       04          
0492B4 C9          0218*       ret
0492B5             0219*   ; end spawn_active_tile_from_tile
