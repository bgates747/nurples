04790F             0060        include "player_state.inc"
04790F             0001*   player_defaults:
04790F 05          0002*       db player               ; type
047910 73 01 00    0003*       dl BUF_SHIP_0L          ; base_bufferId
047913 77 79 04    0004*       dl do_player            ; move_program
047916 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
047917 10          0006*       db 16                   ; dim_x
047918 10          0007*       db 16                   ; dim_y
047919 01          0008*       db 1                    ; num_orientations
04791A 01          0009*       db 1                    ; num_animations
04791B 00          0010*       db 0                    ; animation
04791C 00          0011*       db 0                    ; animation_timer
04791D 00          0012*       db 0                    ; move_timer
04791E 00          0013*       db 0                    ; move_step
04791F 00          0014*       db 0                    ; points
047920 00          0015*       db 0                    ; shield_damage
047921 00          0016*       db 0                    ; frame
047922             0017*   
047922 10 7A 04    0018*   player_state:  dl player_alive
047925 00          0019*   player_ships: db 0
047926 03          0020*   player_ships_max: db 3
047927             0021*   player_speed: equ 3*256 ; pixels per frame 16.8 fixed
047927             0022*   
047927             0023*   draw_player_ships:
047927             0024*   ; activate mfd
047927 DD 21 69 7B 0025*       ld ix,mfd_ships
       04          
04792C CD 70 7C 04 0026*       call mfd_activate
047930             0027*   ; blank out previously drawn ships
047930 AF          0028*       xor a ; color mode 0
047931 0E 00       0029*       ld c,c_black
047933 CD 87 13 04 0030*       call vdu_gcol
047937 01 00 00 00 0031*       ld bc,0
04793B 11 00 00 00 0032*       ld de,0
04793F DD 21 4F 00 0033*       ld ix,0+79
       00          
047944 FD 21 0F 00 0034*       ld iy,0+15
       00          
047949 CD 77 18 04 0035*       call vdu_plot_rf
04794D             0036*   ; draw the ships remaining
04794D 21 2B 00 00 0037*       ld hl,BUF_SHIP_MFD
047951 CD 3A 14 04 0038*       call vdu_buff_select
047955 3A 25 79 04 0039*       ld a,(player_ships) ; loop counter
047959 01 00 00 00 0040*       ld bc,0 ; starting x-coordinate
04795D             0041*   @loop:
04795D 3D          0042*       dec a ; we don't count the ship we're flying
04795E C8          0043*       ret z
04795F F5          0044*       push af ; back up loop counter
047960 C5          0045*       push bc ; save x-coordinate
047961 11 00 00 00 0046*       ld de,0 ; y-coordinate
047965 CD 3A 18 04 0047*       call vdu_plot_bmp
047969 C1          0048*       pop bc ; restore x-coordinate
04796A 21 10 00 00 0049*       ld hl,16 ; bump x-coords
04796E 09          0050*       add hl,bc
04796F E5          0051*       push hl
047970 C1          0052*       pop bc ; bc = new x-coordinate
047971 F1          0053*       pop af
047972 C3 5D 79 04 0054*       jp @loop
047976 C9          0055*       ret
047977             0056*   ; end draw_player_ships
047977             0057*   
047977             0058*   do_player:
047977 2A 22 79 04 0059*       ld hl,(player_state)
04797B             0060*       CALL_HL
                       M1 Args: none
04797B 01 81 79 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
04797F C5          0002*M1     push bc ; which constitutes the return address
047980 E9          0003*M1     jp (hl) ; Jump to the address in HL
047981 C9          0061*       ret
047982             0062*   ; end do_player
047982             0063*   
047982             0064*   ; set initial player position
047982             0065*   ; inputs: none,everything is hardcoded
047982             0066*   ; outputs: player_x/y set to bottom-left corner of screen
047982             0067*   ; destroys: pretty much everything
047982             0068*   player_init:
047982 3A 12 80 04 0069*       ld a,(player_shields_max)
047986 32 11 80 04 0070*       ld (player_shields),a
04798A 3A AA 7E 04 0071*       ld a,(laser_power_max)
04798E 32 A8 7E 04 0072*       ld (laser_power),a
047992 3A 88 7D 04 0073*       ld a,(player_fuel_max)
047996 32 86 7D 04 0074*       ld (player_fuel),a
04799A             0075*   ; set all to zero so they will update
04799A AF          0076*       xor a
04799B 32 A9 7E 04 0077*       ld (laser_power_last),a
04799F 32 13 80 04 0078*       ld (player_shields_last),a
0479A3 32 87 7D 04 0079*       ld (player_fuel_last),a
0479A7             0080*   ; set player sprite record with defaults
0479A7 DD 21 03 A0 0081*       ld ix,player_begin
       04          
