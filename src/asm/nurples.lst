0418D2 21 DD 18 04 0070*       ld hl,@cmd
0418D6 01 06 00 00 0071*       ld bc,@end-@cmd
0418DA 5B DF       0072*       rst.lil $18
0418DC C9          0073*       ret
0418DD 17 00 95 04 0074*   @cmd: db 23, 0, 0x95, 4
0418E1 00 00       0075*   @bufferId: dw 0x0000
0418E3 00          0076*   @end: db 0x00 ; padding
0418E4             0077*   
0418E4             0078*   ; Copy system font to buffer
0418E4             0079*   ; inputs: hl = bufferId
0418E4             0080*   ; VDU 23, 0, &95, 5, bufferId;: Copy system font to buffer
0418E4             0081*   vdu_font_copy_system:
0418E4 22 F7 18 04 0082*       ld (@bufferId),hl
