046035 3E 01       0135*       ld a,1
046037 CD 3E 68 04 0136*       call spawn_sprite_from_coords
04603B D0          0137*       ret nc ; IX is invalid when the one-record player pool is full
04603C DD CB 16 BE 0138*       res 7,(ix+sprite_type)
