04807D CD C6 13 04 0020*       call vdu_set_gfx_origin
048081 01 00 00 00 0021*       ld bc,field_left
048085 11 00 00 00 0022*       ld de,field_top
048089 DD 21 FF 00 0023*       ld ix,field_right
       00          
04808E FD 21 4F 01 0024*       ld iy,field_bottom
       00          
048093 CD E1 13 04 0025*       call vdu_set_gfx_viewport
048097 C9          0026*       ret
