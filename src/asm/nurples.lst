04147F C9          0276*       ret
041480             0277*   ; end vdu_get_screen_mode
041480             0278*   
041480             0279*   ; VDU 23, 0, &C0, n: Turn logical screen scaling on and off *
041480             0280*   ; inputs: a is scaling mode, 1=on, 0=off
041480             0281*   ; note: default setting on boot is scaling ON
041480             0282*   vdu_set_scaling:
041480 32 92 14 04 0283*   	ld (@arg),a
041484 21 8F 14 04 0284*   	ld hl,@cmd
041488 01 04 00 00 0285*   	ld bc,@end-@cmd
04148C 5B DF       0286*   	rst.lil $18
04148E C9          0287*   	ret
04148F 17 00 C0    0288*   @cmd: db 23,0,0xC0
041492 00          0289*   @arg: db 0  ; scaling on/off
041493             0290*   @end:
041493             0291*   
041493             0292*   ; VDU 23, 27, &20, bufferId; : Select bitmap (using a buffer ID)
041493             0293*   ; inputs: hl=bufferId
041493             0294*   vdu_buff_select:
041493 22 A5 14 04 0295*   	ld (@bufferId),hl
041497 21 A2 14 04 0296*   	ld hl,@cmd
04149B 01 05 00 00 0297*   	ld bc,@end-@cmd
04149F 5B DF       0298*   	rst.lil $18
0414A1 C9          0299*   	ret
0414A2 17 1B 20    0300*   @cmd: db 23,27,0x20
0414A5 00 00       0301*   @bufferId: dw 0x0000
0414A7 00          0302*   @end: db 0x00 ; padding
0414A8             0303*   
0414A8             0304*   ; VDU 23, 27, &21, w; h; format: Create bitmap from selected buffer
0414A8             0305*   ; inputs: a=format; bc=width; de=height
0414A8             0306*   ; prerequisites: buffer selected by vdu_bmp_select or vdu_buff_select
0414A8             0307*   ; formats: https://agonconsole8.github.io/agon-docs/VDP---Bitmaps-API.html
0414A8             0308*   ; 0 	RGBA8888 (4-bytes per pixel)
0414A8             0309*   ; 1 	RGBA2222 (1-bytes per pixel)
0414A8             0310*   ; 2 	Mono/Mask (1-bit per pixel)
0414A8             0311*   ; 3 	Reserved for internal use by VDP (“native” format)
0414A8             0312*   vdu_bmp_create:
0414A8 ED 43 C4 14 0313*       ld (@width),bc
       04          
0414AD ED 53 C6 14 0314*       ld (@height),de
       04          
0414B2 32 C8 14 04 0315*       ld (@fmt),a
0414B6 21 C1 14 04 0316*   	ld hl,@cmd
0414BA 01 08 00 00 0317*   	ld bc,@end-@cmd
0414BE 5B DF       0318*   	rst.lil $18
0414C0 C9          0319*   	ret
0414C1 17 1B 21    0320*   @cmd:       db 23,27,0x21
0414C4 00 00       0321*   @width:     dw 0x0000
0414C6 00 00       0322*   @height:    dw 0x0000
0414C8 00          0323*   @fmt:       db 0x00
0414C9             0324*   @end:
0414C9             0325*   
0414C9             0326*   ; load an rgba2222 image file to a working buffer and make it an rgba8888 bitmap in a target buffer
0414C9             0327*   ; inputs: bc,de image width,height ; hl = targetBufferId ; ix = file size ; iy = pointer to filename
0414C9             0328*   vdu_load_img_rgba2_to_8:
0414C9             0329*   ; backup the target buffer id and image dimensions
0414C9 E5          0330*       push hl
0414CA D5          0331*       push de
0414CB C5          0332*       push bc
0414CC             0333*   ; load the rgba2 image to working buffer 65534
0414CC 21 FE FF 00 0334*       ld hl,65534 ; temporary working buffer id
0414D0 CD B3 15 04 0335*   	call vdu_load_buffer_from_file
0414D4             0336*   ; restore the image dimensions and target buffer id
0414D4 C1          0337*       pop bc
0414D5 D1          0338*       pop de
0414D6 E1          0339*       pop hl
0414D7 D0          0340*       ret nc ; leave the cleared target untouched when the source cannot open
0414D8             0341*   ; fall through to vdu_rgba2_to_8
0414D8             0342*   
0414D8             0343*   ; https://discord.com/channels/1158535358624039014/1158536711148675072/1257757461729771771
0414D8             0344*   ; ok, so the "expand bitmap" can be used, when coupled with a "reverse" - the expanded bitmap _doesn't_ come out "right" otherwise, cos of endian-ness
0414D8             0345*   ; the "expand bitmap" command is:
0414D8             0346*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
0414D8             0347*   ; and then to reverse the byte order to fix endian-ness:
0414D8             0348*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
0414D8             0349*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
0414D8             0350*   ; VDU 23,27,&20,targetBufferID%;
0414D8             0351*   ; VDU 23,27,&21,width%;height%;0
0414D8             0352*   ; -------------------------------------------------------------------
0414D8             0353*   ; inputs: bc,de image width,height ; hl = targetBufferId
0414D8             0354*   ; prerequisites: rgba2 image data loaded into workingBufferId 65534
0414D8             0355*   vdu_rgba2_to_8:
0414D8             0356*   ; load the image dimensions and buffer id parameters
0414D8 ED 43 34 15 0357*       ld (@width),bc
       04          
0414DD ED 53 36 15 0358*       ld (@height),de
       04          
0414E2 22 19 15 04 0359*       ld (@bufferId0),hl
0414E6 22 26 15 04 0360*       ld (@bufferId2),hl
0414EA 22 2F 15 04 0361*       ld (@bufferId1),hl
0414EE             0362*   ; clean up bytes that got stomped on by the ID loads
0414EE 3E 48       0363*       ld a,0x48
0414F0 32 1B 15 04 0364*       ld (@bufferId0+2),a
0414F4 3E 17       0365*       ld a,23
0414F6 32 31 15 04 0366*       ld (@bufferId1+2),a
0414FA 3E 18       0367*       ld a,24
0414FC 32 28 15 04 0368*       ld (@bufferId2+2),a
041500 AF          0369*       xor a
041501 32 38 15 04 0370*       ld (@height+2),a
041505             0371*   ; send the vdu command strings
041505 21 10 15 04 0372*       ld hl,@beg
041509 01 29 00 00 0373*       ld bc,@end-@beg
04150D 5B DF       0374*       rst.lil $18
04150F C9          0375*       ret
041510             0376*   @beg:
041510             0377*   ; Command 14: Consolidate blocks in a buffer
041510             0378*   ; VDU 23, 0, &A0, bufferId; 14
041510 17 00 A0    0379*       db 23,0,0xA0
041513 FE FF       0380*       dw 65534 ; workingBufferId
041515 0E          0381*       db 14 ; consolidate blocks
041516             0382*   ; the "expand bitmap" command is:
041516             0383*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
041516 17 00 A0    0384*       db 23,0,0xA0
041519 00 00       0385*   @bufferId0: dw 0x0000 ; targetBufferId
04151B 48          0386*       db 0x48 ; given as decimal command 72 in the docs
04151C 02          0387*       db 2 ; options mask: %00000011 is the number of bits per pixel in the source bitmap
04151D FE FF       0388*       dw 65534 ; sourceBufferId
04151F 00 7F BF FF 0389*       db 0x00,0x7F,0xBF,0xFF ; expanding to bytes by bit-shifting?
041523             0390*   ; reverse the byte order to fix endian-ness:
041523             0391*   ; Command 24: Reverse the order of data of blocks within a buffer
041523             0392*   ; VDU 23, 0, &A0, bufferId; 24, options, [valueSize;] [chunkSize;]
041523             0393*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
041523 17 00 A0    0394*       db 23,0,0xA0
041526 00 00       0395*   @bufferId2:    dw 0x0000 ; targetBufferId
041528 18          0396*       db 24 ; reverse byte order
041529 04          0397*       db 4 ; option: Reverse data of the value size within chunk of data of the specified size
04152A 04 00       0398*       dw 4 ; size (4 bytes)
04152C             0399*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
04152C             0400*   ; VDU 23,27,&20,targetBufferID%;
04152C 17 1B 20    0401*       db 23,27,0x20 ; select bitmap
04152F 00 00       0402*   @bufferId1: dw 0x0000 ; targetBufferId
041531             0403*   ; VDU 23,27,&21,width%;height%;0
041531 17 1B 21    0404*       db 23,27,0x21 ; create bitmap from buffer
041534 00 00       0405*   @width: dw 0x0000
041536 00 00       0406*   @height: dw 0x0000
041538 00          0407*       db 0x00 ; rgba8888 format
041539             0408*   @end:
041539             0409*   
041539             0410*   ; scratch variables
041539 00 00 00    0411*   bufferId0: dl 0x000000
04153C 00 00 00    0412*   bufferId1: dl 0x000000
04153F             0413*   
04153F             0414*   ; load a vdu buffer from local memory
04153F             0415*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
04153F             0416*   vdu_load_buffer:
04153F ED 43 68 15 0417*       ld (@length),bc
       04          
041544 D5          0418*       push de ; save data pointer
041545             0419*   ; send the vdu command string
041545 7D          0420*       ld a,l
041546 32 65 15 04 0421*       ld (@bufferId),a
04154A 7C          0422*       ld a,h
04154B 32 66 15 04 0423*       ld (@bufferId+1),a
04154F 21 62 15 04 0424*       ld hl,@cmd
041553 01 08 00 00 0425*       ld bc,@end-@cmd
041557 5B DF       0426*       rst.lil $18
041559             0427*   ; send the buffer data
041559 E1          0428*       pop hl ; pointer to data
04155A ED 4B 68 15 0429*       ld bc,(@length)
       04          
04155F 5B DF       0430*       rst.lil $18 ; send it
041561 C9          0431*       ret
041562             0432*   ; Upload data :: VDU 23, 0 &A0, bufferId; 0, length; <buffer-data>
041562 17 00 A0    0433*   @cmd:       db 23,0,0xA0
041565 00 00       0434*   @bufferId:	dw 0x0000
041567 00          0435*   		    db 0 ; load buffer
041568 00 00       0436*   @length:	dw 0x0000
04156A 00          0437*   @end: db 0 ; padding
04156B             0438*   
04156B             0439*   ; Command 14: Consolidate blocks in a buffer
04156B             0440*   vdu_consolidate_buffer:
04156B             0441*   ; set parameters for vdu call
04156B 7D          0442*       ld a,l
04156C 32 83 15 04 0443*       ld (@bufferId),a
041570 7C          0444*       ld a,h
041571 32 84 15 04 0445*       ld (@bufferId+1),a
041575 21 80 15 04 0446*       ld hl,@beg
041579 01 06 00 00 0447*       ld bc,@end-@beg
04157D 5B DF       0448*       rst.lil $18
04157F C9          0449*       ret
041580             0450*   ; VDU 23, 0, &A0, bufferId; 14
041580 17 00 A0    0451*   @beg: db 23,0,0xA0
041583 00 00       0452*   @bufferId: dw 0x0000
041585 0E          0453*              db 14
041586             0454*   @end:
041586             0455*   
041586             0456*   ; load an image file to a buffer and make it a bitmap
041586             0457*   ; inputs: a = image type ; bc,de image width,height ; hl = bufferId ; ix = file size ; iy = pointer to filename
041586             0458*   vdu_load_img:
041586             0459*   ; back up image type and dimension parameters
041586 22 39 15 04 0460*       ld (bufferId0),hl
04158A F5          0461*       push af
04158B C5          0462*   	push bc
04158C D5          0463*   	push de
04158D             0464*   ; load the image
04158D CD B3 15 04 0465*   	call vdu_load_buffer_from_file
041591 DA 9A 15 04 0466*       jp c,@loaded
041595             0467*   ; balance the saved arguments and fail without creating an empty bitmap
041595 D1          0468*   	pop de
041596 C1          0469*   	pop bc
041597 F1          0470*   	pop af
041598 B7          0471*       or a ; preserve A while reasserting the carry-clear failure contract
041599 C9          0472*       ret
04159A             0473*   @loaded:
04159A             0474*   ; now make it a bitmap
04159A 2A 39 15 04 0475*       ld hl,(bufferId0)
04159E CD 6B 15 04 0476*       call vdu_consolidate_buffer
0415A2 2A 39 15 04 0477*       ld hl,(bufferId0)
0415A6 CD 93 14 04 0478*       call vdu_buff_select
0415AA D1          0479*   	pop de ; image height
0415AB C1          0480*   	pop bc ; image width
0415AC F1          0481*   	pop af ; image type
0415AD CD A8 14 04 0482*   	call vdu_bmp_create
0415B1 37          0483*       scf
0415B2 C9          0484*       ret
0415B3             0485*   
0415B3             0486*   ; inputs: hl = bufferId; iy = pointer to filename
0415B3             0487*   ; outputs: carry set after a complete read/close; carry clear if open failed
0415B3             0488*   vdu_load_buffer_from_file:
0415B3 22 39 15 04 0489*       ld (bufferId0),hl
0415B7             0490*   
0415B7             0491*   ; clear target buffer
0415B7 CD 63 17 04 0492*       call vdu_clear_buffer
0415BB             0493*   
0415BB             0494*   ; open the file in read mode
0415BB             0495*   ; Open a file
0415BB             0496*   ; HLU: Filename
0415BB             0497*   ;   C: Mode
0415BB             0498*   ; Returns:
0415BB             0499*   ;   A: Filehandle, or 0 if couldn't open
0415BB FD E5       0500*   	push iy ; pointer to filename
0415BD E1          0501*   	pop hl
0415BE 0E 01       0502*       ld c,fa_read
0415C0             0503*       MOSCALL mos_fopen
                       M1 Args: function=mos_fopen 
0415C0 3E 0A       0001*M1 			LD	A, function
0415C2 5B CF       0002*M1 			RST.LIL	08h
0415C4 B7          0504*       or a
0415C5 C8          0505*       ret z ; carry clear: do not read or close the all-files handle zero
0415C6 32 03 16 04 0506*       ld (@filehandle),a
0415CA             0507*   
0415CA             0508*   @read_file:
0415CA             0509*   ; Read a block of data from a file
0415CA             0510*   ;   C: Filehandle
0415CA             0511*   ; HLU: Pointer to where to write the data to
0415CA             0512*   ; DEU: Number of bytes to read
0415CA             0513*   ; Returns:
0415CA             0514*   ; DEU: Number of bytes read
0415CA 3A 03 16 04 0515*       ld a,(@filehandle)
0415CE 4F          0516*       ld c,a
0415CF 21 00 E0 B7 0517*       ld hl,filedata
0415D3 11 00 20 00 0518*       ld de,8192 ; max we can read into onboard sram at one time
0415D7             0519*       MOSCALL mos_fread
                       M1 Args: function=mos_fread 
0415D7 3E 1A       0001*M1 			LD	A, function
0415D9 5B CF       0002*M1 			RST.LIL	08h
0415DB             0520*   
0415DB             0521*   ; test de for zero bytes read
0415DB 21 00 00 00 0522*       ld hl,0
0415DF AF          0523*       xor a ; clear carry
0415E0 ED 52       0524*       sbc hl,de
0415E2 CA F8 15 04 0525*       jp z,@close_file
0415E6             0526*   
0415E6             0527*   ; load a vdu buffer from local memory
0415E6             0528*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
0415E6 2A 39 15 04 0529*       ld hl,(bufferId0)
0415EA D5          0530*       push de ; chunksize
0415EB C1          0531*       pop bc
0415EC 11 00 E0 B7 0532*       ld de,filedata
0415F0 CD 3F 15 04 0533*       call vdu_load_buffer
0415F4             0534*   
0415F4             0535*   ; read the next block
0415F4 C3 CA 15 04 0536*       jp @read_file
0415F8             0537*   
0415F8             0538*   ; close the file
0415F8             0539*   @close_file:
0415F8 3A 03 16 04 0540*       ld a,(@filehandle)
0415FC 4F          0541*       ld c,a
0415FD             0542*       MOSCALL mos_fclose
                       M1 Args: function=mos_fclose 
0415FD 3E 0B       0001*M1 			LD	A, function
0415FF 5B CF       0002*M1 			RST.LIL	08h
041601 37          0543*       scf
041602 C9          0544*       ret ; vdu_load_buffer_from_file
