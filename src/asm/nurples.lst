0407E3             0459*   ; atan2_(ub.c,ud.e) --> uh.l
0407E3             0460*   ; inputs: ub.c and ud.e are dx and dy in 16.8 fixed format
0407E3             0461*   ;   whether inputs are integers or fractional doesn't matter
0407E3             0462*   ;   so long as the sign bit of the upper byte is correct
0407E3             0463*   ; output: uh.l is the 16.8 fixed angle in degrees 256
0407E3             0464*   ; angles are COMPASS HEADINGS based on
0407E3             0465*   ; screen coordinate conventions,where the y axis is flipped
0407E3             0466*   ; #E0 224      0       32 #20
0407E3             0467*   ;        -x,-y | +x,-y
0407E3             0468*   ; #C0 192------+------ 64 #40
