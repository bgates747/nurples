047A7B CB C6       0161*       set tile_fault_bad_record,(hl)
047A7D 3A 3B 73 04 0162*       ld a,(num_active_tiles)
047A81 21 00 00 00 0163*       ld hl,0
047A85 67          0164*       ld h,a
047A86 2E 03       0165*       ld l,3
047A88 ED 6C       0166*       mlt hl
047A8A 11 2F 70 04 0167*       ld de,tile_stack-3
047A8E 19          0168*       add hl,de
047A8F 22 35 73 04 0169*       ld (tile_stack_pointer),hl
047A93 C9          0170*       ret
