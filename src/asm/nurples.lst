044AFA 1E 04       0083*       ld e,fireballs_max ; sprite loop counter
044AFC             0084*   ; define seeker sprites
044AFC             0085*   @sprites_loop:
044AFC F5          0086*       push af
044AFD D5          0087*       push de
044AFE CD BB 19 04 0088*       call vdu_sprite_select
044B02 CD CE 19 04 0089*       call vdu_sprite_clear_frames
044B06 21 0E 01 00 0090*       ld hl,BUF_FIREBALL_2_000
044B0A 06 40       0091*       ld b,2*32 ; 2 animations * 32 orientations
044B0C             0092*   @frames_loop:
044B0C C5          0093*       push bc
044B0D E5          0094*       push hl
044B0E CD 10 1B 04 0095*       call vdu_sprite_add_buff
044B12 E1          0096*       pop hl
044B13 23          0097*       inc hl
044B14 C1          0098*       pop bc
044B15 10 F5       0099*       djnz @frames_loop
044B17 D1          0100*       pop de ; sprite loop counter
044B18 F1          0101*       pop af ; sprite id
044B19 3C          0102*       inc a
044B1A 1D          0103*       dec e
044B1B C2 FC 4A 04 0104*       jp nz,@sprites_loop
044B1F C9          0105*       ret
