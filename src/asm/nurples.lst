047ADC CD B5 66 04 0036*       call update_shields
047AE0             0037*   @animate:
047AE0 FD 35 23    0038*       dec (iy+tile_animation_timer)
047AE3 C0          0039*       ret nz ; not time to animate
047AE4             0040*   ; reset the animation timer and bump animation
047AE4 3E 08       0041*       ld a,8
047AE6 FD 77 23    0042*       ld (iy+tile_animation_timer),a
047AE9 FD 7E 28    0043*       ld a,(iy+tile_frame)
047AEC 3C          0044*       inc a
047AED E6 01       0045*       and %00000001 ; modulo 1
047AEF FD 77 28    0046*       ld (iy+tile_frame),a
047AF2 C3 31 78 04 0047*       jp draw_active_tile
047AF6 C9          0048*       ret
