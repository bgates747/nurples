047978             0170*   
047978             0171*   ; create a new sprite at the same location as the current tile
047978             0172*   ; inputs: hl = pointer to new sprite default settings, tile_table_pointer = current tile
047978             0173*   ;         ix = pointer to sprite group, b = number of records in sprite group
047978             0174*   spawn_sprite_from_tile:
047978 E5          0175*       push hl ; back up pointer to new sprite defaults
047979 CD 9B 68 04 0176*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
04797D E1          0177*       pop hl ; restore pointer to new sprite defaults
04797E D0          0178*       ret nc ; no carry means no free sprite slots, so we go home
04797F             0179*   ; copy default settings to new sprite
04797F DD E5       0180*       push ix ; back up pointer to new sprite record
047981 ED 32 16    0181*       lea ix,ix+sprite_definitions ; bump pointer to copy to
047984 DD E5       0182*       push ix ; pointer to default sprite settings
047986 D1          0183*       pop de ; address to copy to
047987 01 13 00 00 0184*       ld bc,sprite_definitions_size ; copy only bytes provided by defaults
04798B ED B0       0185*       ldir ; copies defaults to new sprite record
04798D DD E1       0186*       pop ix ; restore pointer to new sprite record
04798F             0187*   ; copy sprite position from existing tile
04798F FD 2A 68 74 0188*       ld iy,(tile_table_pointer) ; get existing tile record
       04          
047994 FD 27 01    0189*       ld hl,(iy+tile_x)
047997 DD 2F 01    0190*       ld (ix+sprite_x),hl
04799A FD 27 04    0191*       ld hl,(iy+tile_y)
04799D DD 2F 04    0192*       ld (ix+sprite_y),hl
0479A0             0193*   ; clear motion state retained by a previously used physical record
0479A0 21 00 00 00 0194*       ld hl,0
0479A4 DD 2F 07    0195*       ld (ix+sprite_xvel),hl
0479A7 DD 2F 0A    0196*       ld (ix+sprite_yvel),hl
0479AA DD 2F 0D    0197*       ld (ix+sprite_vel),hl
0479AD DD 2F 10    0198*       ld (ix+sprite_heading),hl
0479B0 DD 2F 13    0199*       ld (ix+sprite_orientation),hl
0479B3             0200*   ; return to caller
0479B3 DD CB 16 FE 0201*       set 7,(ix+sprite_type) ; set just spawned flag
0479B7 DD CB 1D F6 0202*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
0479BB 37          0203*       scf ; set carry flag to indicate success
0479BC C9          0204*       ret
0479BD             0205*   ; end spawn_sprite_from_tile
0479BD             0206*   
0479BD             0207*   ; create a new tile at the same location as the current tile
0479BD             0208*   ; inputs: tile_table_pointer = current tile
0479BD             0209*   spawn_active_tile_from_tile:
0479BD             0210*   ; copy default settings to new tile
0479BD DD 2A 68 74 0211*       ld ix,(tile_table_pointer) ; get existing tile record
       04          
0479C2 ED 32 16    0212*       lea ix,ix+tile_definitions ; bump pointer to copy to
0479C5 DD E5       0213*       push ix ; pointer to default tile settings
0479C7 D1          0214*       pop de ; address to copy to
0479C8 01 13 00 00 0215*       ld bc,tile_definitions_size ; copy only bytes provided by defaults
0479CC ED B0       0216*       ldir ; copies defaults to new tile record
0479CE DD 2A 68 74 0217*       ld ix,(tile_table_pointer) ; restore pointer to new tile record
