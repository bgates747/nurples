047AA0             0031*   ; do player directional input
047AA0 AF          0032*       xor a ; clear flags
047AA1 DB 9E       0033*       in a,(portC) ; read dpad input
047AA3 57          0034*       ld d,a ; save dpad input
047AA4 3E 01       0035*       ld a,1 ; set ship's default animation to center
047AA6             0036*   ; 26 Left: move player left
047AA6 DD CB 03 4E 0037*       bit 1,(ix+3)
047AAA C2 B8 7A 04 0038*       jp nz,@F
047AAE             0039*   ; test dpad left
047AAE CB 6A       0040*       bit joy1_l,d
047AB0 CA B8 7A 04 0041*       jp z,@F
047AB4 C3 C4 7A 04 0042*       jp @right
047AB8             0043*   @@:
047AB8 FD 27 07    0044*       ld hl,(iy+sprite_xvel)
047ABB 01 00 FD FF 0045*       ld bc,-player_speed
047ABF 09          0046*       add hl,bc
047AC0 FD 2F 07    0047*       ld (iy+sprite_xvel),hl
047AC3 3D          0048*       dec a ; set ship's animation to left
047AC4             0049*   @right:
047AC4             0050*   ; 122 Right: move player right
047AC4 DD CB 0F 4E 0051*       bit 1,(ix+15)
047AC8 C2 D6 7A 04 0052*       jp nz,@F
047ACC             0053*   ; test dpad right
047ACC CB 7A       0054*       bit joy1_r,d
047ACE CA D6 7A 04 0055*       jp z,@F
047AD2 C3 E2 7A 04 0056*       jp @up
047AD6             0057*   @@:
047AD6 FD 27 07    0058*       ld hl,(iy+sprite_xvel)
047AD9 01 00 03 00 0059*       ld bc,player_speed
047ADD 09          0060*       add hl,bc
047ADE FD 2F 07    0061*       ld (iy+sprite_xvel),hl
047AE1 3C          0062*       inc a ; set ship's animation to right
047AE2             0063*   @up:
047AE2             0064*   ; 58 Up: move player up
047AE2 DD CB 07 4E 0065*       bit 1,(ix+7)
047AE6 C2 F4 7A 04 0066*       jp nz,@F
047AEA             0067*   ; test dpad up
047AEA CB 4A       0068*       bit joy1_u,d
047AEC CA F4 7A 04 0069*       jp z,@F
047AF0 C3 FF 7A 04 0070*       jp @dn
047AF4             0071*   @@:
047AF4 FD 27 0A    0072*       ld hl,(iy+sprite_yvel)
047AF7 01 00 FD FF 0073*       ld bc,-player_speed
047AFB 09          0074*       add hl,bc
047AFC FD 2F 0A    0075*       ld (iy+sprite_yvel),hl
047AFF             0076*   @dn:
047AFF             0077*   ; 42 Down: move player down
047AFF DD CB 05 4E 0078*       bit 1,(ix+5)
047B03 C2 11 7B 04 0079*       jp nz,@F
047B07             0080*   ; test dpad down
047B07 CB 5A       0081*       bit joy1_d,d
047B09 CA 11 7B 04 0082*       jp z,@F
047B0D C3 1C 7B 04 0083*       jp @frame
047B11             0084*   @@:
047B11 FD 27 0A    0085*       ld hl,(iy+sprite_yvel)
047B14 01 00 03 00 0086*       ld bc,player_speed
047B18 09          0087*       add hl,bc
047B19 FD 2F 0A    0088*       ld (iy+sprite_yvel),hl
047B1C             0089*   @frame:
047B1C             0090*   ; a should land here loaded with the correct frame
047B1C CD A7 19 04 0091*       call vdu_sprite_select_frame
047B20             0092*   ; draw player at updated position
047B20 FD 21 87 9D 0093*       ld iy,player_begin
       04          
