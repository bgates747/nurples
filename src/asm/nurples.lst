041720             0040        include "vdu_buffered_api.inc"
041720             0001*   ; https://agonconsole8.github.io/agon-docs/vdp/Buffered-Commands-API/
041720             0002*   
041720             0003*   ; Command 0: Write block to a buffer
041720             0004*   ; VDU 23, 0, &A0, bufferId; 0, length; <buffer-data>
041720             0005*   ; inputs: hl = bufferId, bc = length of data, de = pointer to data
041720             0006*   vdu_write_block_to_buffer:
041720             0007*   ; back up input parameters
041720 D5          0008*       push de ; pointer to data
041721 C5          0009*       push bc ; length of data
041722             0010*   ; set up the vdu command string
041722 22 42 17 04 0011*       ld (@bufferId),hl
041726 ED 43 45 17 0012*       ld (@length),bc
       04          
04172B AF          0013*       xor a ; load buffer
04172C 32 44 17 04 0014*       ld (@bufferId+2),a
041730 21 3F 17 04 0015*       ld hl,@cmd0
041734 01 08 00 00 0016*       ld bc,@end0-@cmd0
041738 5B DF       0017*       rst.lil $18
04173A             0018*   ; send the buffer data
04173A C1          0019*       pop bc ; length of data
04173B E1          0020*       pop hl ; pointer to data (was de)
04173C 5B DF       0021*       rst.lil $18 ; send it
04173E C9          0022*       ret
04173F             0023*   ; command string data
04173F 17 00 A0    0024*   @cmd0:      db 23,0,0xA0
041742 00 00       0025*   @bufferId:	dw 0x0000
041744 00          0026*               db 0 ; load buffer
041745 00 00       0027*   @length:	dw 0x0000
041747 00          0028*   @end0:      db 0x00 ; padding
041748             0029*   ; end vdu_write_block_to_buffer
041748             0030*   
041748             0031*   ; Command 1: Call a buffer
041748             0032*   ; VDU 23, 0, &A0, bufferId; 1
041748             0033*   ; inputs: hl = bufferId
041748             0034*   vdu_call_buffer:
041748 22 60 17 04 0035*       ld (@bufferId),hl
04174C 3E 01       0036*       ld a,1 ; call buffer
04174E 32 62 17 04 0037*       ld (@bufferId+2),a
041752 21 5D 17 04 0038*       ld hl,@cmd
041756 01 06 00 00 0039*       ld bc,@end-@cmd
04175A 5B DF       0040*       rst.lil $18
04175C C9          0041*       ret
04175D 17 00 A0    0042*   @cmd:     db 23,0,0xA0
041760 00 00       0043*   @bufferId: dw 0x0000
041762 01          0044*              db 1 ; call buffer
041763             0045*   @end:
041763             0046*   ; end vdu_call_buffer
041763             0047*   
041763             0048*   ; Command 2: Clear a buffer
041763             0049*   ; VDU 23, 0 &A0, bufferId; 2
041763             0050*   ; inputs: hl = bufferId
041763             0051*   vdu_clear_buffer:
041763 22 7B 17 04 0052*       ld (@bufferId),hl
041767 3E 02       0053*       ld a,2 ; clear buffer
041769 32 7D 17 04 0054*       ld (@bufferId+2),a
04176D 21 78 17 04 0055*       ld hl,@cmd
041771 01 06 00 00 0056*       ld bc,@end-@cmd
041775 5B DF       0057*       rst.lil $18
041777 C9          0058*       ret
041778 17 00 A0    0059*   @cmd:     db 23,0,0xA0
04177B 00 00       0060*   @bufferId: dw 0x0000
04177D 02          0061*              db 2 ; clear buffer
04177E             0062*   @end:
04177E             0063*   ; end vdu_clear_buffer
04177E             0064*   
04177E             0065*   ; Clear all buffers
04177E             0066*   ; inputs: none
04177E             0067*   vdu_clear_all_buffers:
04177E             0068*   ; clear all buffers
04177E 21 89 17 04 0069*       ld hl,@beg
041782 01 06 00 00 0070*       ld bc,@end-@beg
041786 5B DF       0071*       rst.lil $18
041788 C9          0072*       ret
041789 17 00 A0    0073*   @beg: db 23,0,$A0
04178C FF FF       0074*         dw -1 ; bufferId -1 (65535) means clear all buffers
04178E 02          0075*         db 2  ; command 2: clear a buffer
04178F             0076*   @end:
04178F             0077*   ; end vdu_clear_all_buffers
04178F             0078*   
04178F             0079*   ; Command 3: Create a writeable buffer
04178F             0080*   ; VDU 23, 0 &A0, bufferId; 3, length;
04178F             0081*   ; inputs: hl = bufferId, bc = length
04178F             0082*   vdu_create_writeable_buffer:
04178F 22 AC 17 04 0083*       ld (@bufferId),hl
041793 ED 43 AF 17 0084*       ld (@length),bc
       04          
041798 3E 03       0085*       ld a,3 ; create writeable buffer
04179A 32 AE 17 04 0086*       ld (@bufferId+2),a
04179E 21 A9 17 04 0087*       ld hl,@cmd
0417A2 01 08 00 00 0088*       ld bc,@end-@cmd
0417A6 5B DF       0089*       rst.lil $18
0417A8 C9          0090*       ret
0417A9 17 00 A0    0091*   @cmd:     db 23,0,0xA0
0417AC 00 00       0092*   @bufferId: dw 0x0000
0417AE 03          0093*              db 3 ; create writeable buffer
0417AF 00 00       0094*   @length: dw 0x0000
0417B1 00          0095*   @end:     db 0x00 ; padding
0417B2             0096*   ; end vdu_create_writeable_buffer
0417B2             0097*   
0417B2             0098*   ; Command 4: Set output stream to a buffer
0417B2             0099*   ; VDU 23, 0 &A0, bufferId; 4
0417B2             0100*   ; inputs: hl = bufferId
0417B2             0101*   vdu_set_output_stream_buffer:
0417B2 22 CA 17 04 0102*       ld (@bufferId),hl
0417B6 3E 04       0103*       ld a,4 ; set output stream to buffer
0417B8 32 CC 17 04 0104*       ld (@bufferId+2),a
0417BC 21 C7 17 04 0105*       ld hl,@cmd
0417C0 01 06 00 00 0106*       ld bc,@end-@cmd
0417C4 5B DF       0107*       rst.lil $18
0417C6 C9          0108*       ret
0417C7 17 00 A0    0109*   @cmd:     db 23,0,0xA0
0417CA 00 00       0110*   @bufferId: dw 0x0000
0417CC 04          0111*              db 4 ; set output stream to buffer
0417CD 00          0112*   @end:     db 0x00 ; padding
0417CE             0113*   ; end vdu_set_output_stream_buffer
0417CE             0114*   
0417CE             0115*   ; Command 5: Adjust buffer contents
0417CE             0116*   ; VDU 23, 0, &A0, bufferId; 5, operation, offset; [count;] <operand>, [arguments]
0417CE             0117*   vdu_adjust_buffer:
0417CE C9          0118*       ret ; TODO: implement
0417CF             0119*   ; end vdu_adjust_buffer
0417CF             0120*   
0417CF             0121*   ; Command 6: Conditionally call a buffer
0417CF             0122*   ; VDU 23, 0, &A0, bufferId; 6, operation, checkBufferId; checkOffset; [arguments]
0417CF             0123*   vdu_call_buffer_conditional:
0417CF C9          0124*       ret ; TODO: implement
0417D0             0125*   ; end vdu_call_buffer_conditional
0417D0             0126*   
0417D0             0127*   ; Command 7: Jump to a buffer
0417D0             0128*   ; VDU 23, 0, &A0, bufferId; 7
0417D0             0129*   ; inputs: hl = bufferId
0417D0             0130*   vdu_jump_to_buffer:
0417D0 22 E8 17 04 0131*       ld (@bufferId),hl
0417D4 3E 07       0132*       ld a,7 ; jump to buffer
0417D6 32 EA 17 04 0133*       ld (@bufferId+2),a
0417DA 21 E5 17 04 0134*       ld hl,@cmd
0417DE 01 06 00 00 0135*       ld bc,@end-@cmd
0417E2 5B DF       0136*       rst.lil $18
0417E4 C9          0137*       ret
0417E5 17 00 A0    0138*   @cmd:     db 23,0,0xA0
0417E8 00 00       0139*   @bufferId: dw 0x0000
0417EA 07          0140*              db 7 ; jump to buffer
0417EB 00          0141*   @end:     db 0x00 ; padding
0417EC             0142*   ; end vdu_jump_to_buffer
0417EC             0143*   
0417EC             0144*   ; Command 8: Conditional Jump to a buffer
0417EC             0145*   ; VDU 23, 0, &A0, bufferId; 8, operation, checkBufferId; checkOffset; [arguments]
0417EC             0146*   vdu_jump_to_buffer_conditional:
0417EC C9          0147*       ret ; TODO: implement
0417ED             0148*   ; end vdu_jump_to_buffer_conditional
0417ED             0149*   
0417ED             0150*   ; Command 9: Jump to an offset in a buffer
0417ED             0151*   ; VDU 23, 0, &A0, bufferId; 9, offset; offsetHighByte, [blockNumber;]
0417ED             0152*   vdu_jump_to_buffer_offset:
0417ED C9          0153*       ret ; TODO: implement
0417EE             0154*   ; end vdu_jump_to_buffer_offset
0417EE             0155*   
0417EE             0156*   ; Command 10: Conditional jump to an offset in a buffer
0417EE             0157*   ; VDU 23, 0, &A0, bufferId; 10, offset; offsetHighByte, [blockNumber;] [arguments]
0417EE             0158*   vdu_jump_to_buffer_offset_conditional:
0417EE C9          0159*       ret ; TODO: implement
0417EF             0160*   ; end vdu_jump_to_buffer_offset_conditional
0417EF             0161*   
0417EF             0162*   ; Command 11: Call buffer with an offset
0417EF             0163*   ; VDU 23, 0, &A0, bufferId; 11, offset; offsetHighByte, [blockNumber;]
0417EF             0164*   vdu_call_buffer_offset:
0417EF C9          0165*       ret ; TODO: implement
0417F0             0166*   ; end vdu_call_buffer_offset
0417F0             0167*   
0417F0             0041        include "vdu_fonts.inc"
0417F0             0001*   ; select font
0417F0             0002*   ; inputs: hl = bufferId, a = font flags
0417F0             0003*   ; Flags:
0417F0             0004*   ; Bit	Description
0417F0             0005*   ; 0	Adjust cursor position to ensure text baseline is aligned
0417F0             0006*   ;   0: Do not adjust cursor position (best for changing font on a new line)
0417F0             0007*   ;   1: Adjust cursor position (best for changing font in the middle of a line)
0417F0             0008*   ; 1-7	Reserved for future use
0417F0             0009*   ; VDU 23, 0, &95, 0, bufferId; flags: Select font
0417F0             0010*   vdu_font_select:
0417F0 22 07 18 04 0011*       ld (@bufferId),hl
0417F4 32 09 18 04 0012*       ld (@flags),a
0417F8 21 03 18 04 0013*       ld hl,@cmd
0417FC 01 07 00 00 0014*       ld bc,@end-@cmd
041800 5B DF       0015*       rst.lil $18
041802 C9          0016*       ret
041803 17 00 95 00 0017*   @cmd: db 23, 0, 0x95, 0
041807 00 00       0018*   @bufferId: dw 0x0000
041809 00          0019*   @flags: db 0x00
04180A             0020*   @end:
04180A             0021*   
04180A             0022*   ; create font from buffer
04180A             0023*   ; inputs: hl = bufferId, e = width, d = height, d = ascent, a = flags
04180A             0024*   ; VDU 23, 0, &95, 1, bufferId; width, height, ascent, flags: Create font from buffer
04180A             0025*   vdu_font_create:
04180A 22 2F 18 04 0026*       ld (@bufferId),hl
04180E ED 53 31 18 0027*       ld (@width),de ; also loads height
       04          
041813 32 34 18 04 0028*       ld (@flags),a
041817 7A          0029*       ld a,d ; height
041818 32 33 18 04 0030*       ld (@ascent),a ; ascent = height
04181C             0031*   ; consolidate buffer
04181C CD 6B 15 04 0032*       call vdu_consolidate_buffer
041820             0033*   ; create font
041820 21 2B 18 04 0034*       ld hl,@cmd
041824 01 0A 00 00 0035*       ld bc,@end-@cmd
041828 5B DF       0036*       rst.lil $18
04182A C9          0037*       ret
04182B 17 00 95 01 0038*   @cmd: db 23, 0, 0x95, 1
04182F 00 00       0039*   @bufferId: dw 0x0000
041831 00          0040*   @width: db 0x00
041832 00          0041*   @height: db 0x00
041833 00          0042*   @ascent: db 0x00
041834 00          0043*   @flags: db 0x00
041835             0044*   @end:
041835             0045*   
041835             0046*   ; set or adjust font property
041835             0047*   ; inputs: hl = bufferId, a = field, de = value
041835             0048*   ; VDU 23, 0, &95, 2, bufferId; field, value;: Set or adjust font property
041835             0049*   vdu_font_property:
041835 22 51 18 04 0050*       ld (@bufferId),hl
041839 32 53 18 04 0051*       ld (@field),a
04183D ED 53 54 18 0052*       ld (@value),de
       04          
041842 21 4D 18 04 0053*       ld hl,@cmd
041846 01 09 00 00 0054*       ld bc,@end-@cmd
04184A 5B DF       0055*       rst.lil $18
04184C C9          0056*       ret
04184D 17 00 95 02 0057*   @cmd: db 23, 0, 0x95, 2
041851 00 00       0058*   @bufferId: dw 0x0000
041853 00          0059*   @field: db 0x00
041854 00 00       0060*   @value: dw 0x0000
041856 00          0061*   @end: db 0x00 ; padding
041857             0062*   
041857             0063*   ; VDU 23, 0, &95, 3, bufferId; [<args>]: Reserved
041857             0064*   
041857             0065*   ; Clear/Delete font
041857             0066*   ; inputs: hl = bufferId
041857             0067*   ; VDU 23, 0, &95, 4, bufferId;: Clear/Delete font
041857             0068*   vdu_font_clear:
041857 22 6A 18 04 0069*       ld (@bufferId),hl
04185B 21 66 18 04 0070*       ld hl,@cmd
04185F 01 06 00 00 0071*       ld bc,@end-@cmd
041863 5B DF       0072*       rst.lil $18
041865 C9          0073*       ret
041866 17 00 95 04 0074*   @cmd: db 23, 0, 0x95, 4
04186A 00 00       0075*   @bufferId: dw 0x0000
04186C 00          0076*   @end: db 0x00 ; padding
04186D             0077*   
04186D             0078*   ; Copy system font to buffer
04186D             0079*   ; inputs: hl = bufferId
04186D             0080*   ; VDU 23, 0, &95, 5, bufferId;: Copy system font to buffer
04186D             0081*   vdu_font_copy_system:
04186D 22 80 18 04 0082*       ld (@bufferId),hl
041871 21 7C 18 04 0083*       ld hl,@cmd
041875 01 06 00 00 0084*       ld bc,@end-@cmd
041879 5B DF       0085*       rst.lil $18
04187B C9          0086*       ret
04187C 17 00 95 05 0087*   @cmd: db 23, 0, 0x95, 5
041880 00 00       0088*   @bufferId: dw 0x0000
041882 00          0089*   @end: db 0x00 ; padding
041883             0042        include "vdu_plot.inc"
041883             0001*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
041883             0002*   ; PLOT code 	(Decimal) 	Effect
041883             0003*   ; &00-&07 	0-7 	Solid line, includes both ends
041883             0004*   plot_sl_both: equ 0x00
041883             0005*   
041883             0006*   ; &08-&0F 	8-15 	Solid line, final point omitted
041883             0007*   plot_sl_first: equ 0x08
041883             0008*   
041883             0009*   ; &10-&17 	16-23 	Not supported (Dot-dash line, includes both ends, pattern restarted)
041883             0010*   ; &18-&1F 	24-31 	Not supported (Dot-dash line, first point omitted, pattern restarted)
041883             0011*   
041883             0012*   ; &20-&27 	32-39 	Solid line, first point omitted
041883             0013*   plot_sl_last: equ 0x20
041883             0014*   
041883             0015*   ; &28-&2F 	40-47 	Solid line, both points omitted
041883             0016*   plot_sl_none: equ 0x28
041883             0017*   
041883             0018*   ; &30-&37 	48-55 	Not supported (Dot-dash line, first point omitted, pattern continued)
041883             0019*   ; &38-&3F 	56-63 	Not supported (Dot-dash line, both points omitted, pattern continued)
041883             0020*   
041883             0021*   ; &40-&47 	64-71 	Point plot
041883             0022*   plot_pt: equ 0x40
041883             0023*   
041883             0024*   ; &48-&4F 	72-79 	Line fill left and right to non-background §§
041883             0025*   plot_lf_lr_non_bg: equ 0x48
041883             0026*   
041883             0027*   ; &50-&57 	80-87 	Triangle fill
041883             0028*   plot_tf: equ 0x50
041883             0029*   
041883             0030*   ; &58-&5F 	88-95 	Line fill right to background §§
041883             0031*   plot_lf_r_bg: equ 0x58
041883             0032*   
041883             0033*   ; &60-&67 	96-103 	Rectangle fill
041883             0034*   plot_rf: equ 0x60
041883             0035*   
041883             0036*   ; &68-&6F 	104-111 	Line fill left and right to foreground §§
041883             0037*   plot_lf_lr_fg: equ 0x60
041883             0038*   
041883             0039*   ; &70-&77 	112-119 	Parallelogram fill
041883             0040*   plot_pf: equ 0x70
041883             0041*   
041883             0042*   ; &78-&7F 	120-127 	Line fill right to non-foreground §§
041883             0043*   plot_lf_r_non_fg: equ 0x78
041883             0044*   
041883             0045*   ; &80-&87 	128-135 	Not supported (Flood until non-background)
041883             0046*   ; &88-&8F 	136-143 	Not supported (Flood until foreground)
041883             0047*   
041883             0048*   ; &90-&97 	144-151 	Circle outline
041883             0049*   plot_co: equ 0x90
041883             0050*   
041883             0051*   ; &98-&9F 	152-159 	Circle fill
041883             0052*   plot_cf: equ 0x98
041883             0053*   
041883             0054*   ; &A0-&A7 	160-167 	Not supported (Circular arc)
041883             0055*   ; &A8-&AF 	168-175 	Not supported (Circular segment)
041883             0056*   ; &B0-&B7 	176-183 	Not supported (Circular sector)
041883             0057*   
041883             0058*   ; &B8-&BF 	184-191 	Rectangle copy/move
041883             0059*   plot_rcm: equ 0xB8
041883             0060*   
041883             0061*   ; &C0-&C7 	192-199 	Not supported (Ellipse outline)
041883             0062*   ; &C8-&CF 	200-207 	Not supported (Ellipse fill)
041883             0063*   ; &D0-&D7 	208-215 	Not defined
041883             0064*   ; &D8-&DF 	216-223 	Not defined
041883             0065*   ; &E0-&E7 	224-231 	Not defined
041883             0066*   
041883             0067*   ; &E8-&EF 	232-239 	Bitmap plot §
041883             0068*   plot_bmp: equ 0xE8
041883             0069*   
041883             0070*   ; &F0-&F7 	240-247 	Not defined
041883             0071*   ; &F8-&FF 	248-255 	Not defined
041883             0072*   
041883             0073*   ; § Support added in Agon Console8 VDP 2.1.0 §§ Support added in
041883             0074*   ; Agon Console8 VDP 2.2.0
041883             0075*   
041883             0076*   ; Within each group of eight plot codes, the effects are as follows:
041883             0077*   ; Plot code 	Effect
041883             0078*   ; 0 	Move relative
041883             0079*   mv_rel: equ 0
041883             0080*   
041883             0081*   ; 1 	Plot relative in current foreground colour
041883             0082*   dr_rel_fg: equ 1
041883             0083*   
041883             0084*   ; 2 	Not supported (Plot relative in logical inverse colour)
041883             0085*   ; 3 	Plot relative in current background colour
041883             0086*   dr_rel_bg: equ 3
041883             0087*   
041883             0088*   ; 4 	Move absolute
041883             0089*   mv_abs: equ 4
041883             0090*   
041883             0091*   ; 5 	Plot absolute in current foreground colour
041883             0092*   dr_abs_fg: equ 5
041883             0093*   
041883             0094*   ; 6 	Not supported (Plot absolute in logical inverse colour)
041883             0095*   ; 7 	Plot absolute in current background colour
041883             0096*   dr_abs_bg: equ 7
041883             0097*   
041883             0098*   ; Codes 0-3 use the position data provided as part of the command
041883             0099*   ; as a relative position, adding the position given to the current
041883             0100*   ; graphical cursor position. Codes 4-7 use the position data provided
041883             0101*   ; as part of the command as an absolute position, setting the current
041883             0102*   ; graphical cursor position to the position given.
041883             0103*   
041883             0104*   ; Codes 2 and 6 on Acorn systems plot using a logical inverse of the
041883             0105*   ; current pixel colour. These operations cannot currently be supported
041883             0106*   ; by the graphics system the Agon VDP uses, so these codes are not
041883             0107*   ; supported. Support for these codes may be added in a future version
041883             0108*   ; of the VDP firmware.
041883             0109*   
041883             0110*   ; 16 colour palette constants
041883             0111*   c_black: equ 0
041883             0112*   c_red_dk: equ 1
041883             0113*   c_green_dk: equ 2
041883             0114*   c_yellow_dk: equ 3
041883             0115*   c_blue_dk: equ 4
041883             0116*   c_magenta_dk: equ 5
041883             0117*   c_cyan_dk: equ 6
041883             0118*   c_grey: equ 7
041883             0119*   c_grey_dk: equ 8
041883             0120*   c_red: equ 9
041883             0121*   c_green: equ 10
041883             0122*   c_yellow: equ 11
041883             0123*   c_blue: equ 12
041883             0124*   c_magenta: equ 13
041883             0125*   c_cyan: equ 14
041883             0126*   c_white: equ 15
041883             0127*   
041883             0128*   ; VDU 25, mode, x; y;: PLOT command
041883             0129*   ; inputs: a=mode, bc=x0, de=y0
041883             0130*   vdu_plot:
041883 32 9D 18 04 0131*       ld (@mode),a
041887 ED 43 9E 18 0132*       ld (@x0),bc
       04          
04188C ED 53 A0 18 0133*       ld (@y0),de
       04          
041891 21 9C 18 04 0134*   	ld hl,@cmd
041895 01 06 00 00 0135*   	ld bc,@end-@cmd
041899 5B DF       0136*   	rst.lil $18
04189B C9          0137*   	ret
04189C 19          0138*   @cmd:   db 25
04189D 00          0139*   @mode:  db 0
04189E 00 00       0140*   @x0: 	dw 0
0418A0 00 00       0141*   @y0: 	dw 0
0418A2 00          0142*   @end:   db 0 ; extra byte to soak up deu
0418A3             0143*   
0418A3             0144*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
0418A3             0145*   ; &E8-&EF 	232-239 	Bitmap plot §
0418A3             0146*   ; VDU 25, mode, x; y;: PLOT command
0418A3             0147*   ; inputs: bc=x0, de=y0
0418A3             0148*   ; prerequisites: vdu_buff_select
0418A3             0149*   vdu_plot_bmp:
0418A3 ED 43 BA 18 0150*       ld (@x0),bc
       04          
0418A8 ED 53 BC 18 0151*       ld (@y0),de
       04          
0418AD 21 B8 18 04 0152*   	ld hl,@cmd
0418B1 01 06 00 00 0153*   	ld bc,@end-@cmd
0418B5 5B DF       0154*   	rst.lil $18
0418B7 C9          0155*   	ret
0418B8 19          0156*   @cmd:   db 25
0418B9 ED          0157*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
0418BA 00 00       0158*   @x0: 	dw 0x0000
0418BC 00 00       0159*   @y0: 	dw 0x0000
0418BE 00          0160*   @end:   db 0x00 ; padding
0418BF             0161*   
0418BF             0162*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
0418BF             0163*   ; &E8-&EF 	232-239 	Bitmap plot §
0418BF             0164*   ; VDU 25, mode, x; y;: PLOT command
0418BF             0165*   ; inputs: bc=x0, de=y0
0418BF             0166*   ; USING 16.8 FIXED POINT COORDINATES
0418BF             0167*   ; inputs: ub.c is x coordinate, ud.e is y coordinate
0418BF             0168*   ;   the fractional portiion of the inputs are truncated
0418BF             0169*   ;   leaving only the 16-bit integer portion
0418BF             0170*   ; prerequisites: vdu_buff_select
0418BF             0171*   vdu_plot_bmp168:
0418BF             0172*   ; populate in the reverse of normal to keep the
0418BF             0173*   ; inputs from stomping on each other
0418BF ED 53 DD 18 0174*       ld (@y0-1),de
       04          
0418C4 ED 43 DB 18 0175*       ld (@x0-1),bc
       04          
0418C9 3E ED       0176*       ld a,plot_bmp+dr_abs_fg ; 0xED
0418CB 32 DB 18 04 0177*       ld (@mode),a ; restore the mode byte that got stomped on by bcu
0418CF 21 DA 18 04 0178*   	ld hl,@cmd
0418D3 01 06 00 00 0179*   	ld bc,@end-@cmd
0418D7 5B DF       0180*   	rst.lil $18
0418D9 C9          0181*   	ret
0418DA 19          0182*   @cmd:   db 25
0418DB ED          0183*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
0418DC 00 00       0184*   @x0: 	dw 0x0000
0418DE 00 00       0185*   @y0: 	dw 0x0000
0418E0             0186*   @end:  ; no padding required b/c we shifted de right
0418E0             0187*   
0418E0             0188*   ; draw a filled rectangle
0418E0             0189*   vdu_plot_rf:
0418E0 ED 43 07 19 0190*       ld (@x0),bc
       04          
0418E5 ED 53 09 19 0191*       ld (@y0),de
       04          
0418EA DD 22 0D 19 0192*       ld (@x1),ix
       04          
0418EF FD 22 0F 19 0193*       ld (@y1),iy
       04          
0418F4 3E 19       0194*       ld a,25 ; we have to reload the 2nd plot command
0418F6 32 0B 19 04 0195*       ld (@cmd1),a ; because the 24-bit y0 load stomped on it
0418FA 21 05 19 04 0196*   	ld hl,@cmd0
0418FE 01 0C 00 00 0197*   	ld bc,@end-@cmd0
041902 5B DF       0198*   	rst.lil $18
041904 C9          0199*       ret
041905 19          0200*   @cmd0:  db 25 ; plot
041906 04          0201*   @arg0:  db plot_sl_both+mv_abs
041907 00 00       0202*   @x0:    dw 0x0000
041909 00 00       0203*   @y0:    dw 0x0000
04190B 19          0204*   @cmd1:  db 25 ; plot
04190C 65          0205*   @arg1:  db plot_rf+dr_abs_fg
04190D 00 00       0206*   @x1:    dw 0x0000
04190F 00 00       0207*   @y1:    dw 0x0000
041911 00          0208*   @end:   db 0x00 ; padding
041912             0209*   
041912             0210*   ; draw a filled circle
041912             0211*   vdu_plot_cf:
041912 ED 43 39 19 0212*       ld (@x0),bc
       04          
041917 ED 53 3B 19 0213*       ld (@y0),de
       04          
04191C DD 22 3F 19 0214*       ld (@x1),ix
       04          
041921 FD 22 41 19 0215*       ld (@y1),iy
       04          
041926 3E 19       0216*       ld a,25 ; we have to reload the 2nd plot command
041928 32 3D 19 04 0217*       ld (@cmd1),a ; because the 24-bit y0 load stomped on it
04192C 21 37 19 04 0218*   	ld hl,@cmd0
041930 01 0C 00 00 0219*   	ld bc,@end-@cmd0
041934 5B DF       0220*   	rst.lil $18
041936 C9          0221*       ret
041937 19          0222*   @cmd0:  db 25 ; plot
041938 04          0223*   @arg0:  db plot_sl_both+mv_abs
041939 00 00       0224*   @x0:    dw 0x0000
04193B 00 00       0225*   @y0:    dw 0x0000
04193D 19          0226*   @cmd1:  db 25 ; plot
04193E 9D          0227*   @arg1:  db plot_cf+dr_abs_fg
04193F 00 00       0228*   @x1:    dw 0x0000
041941 00 00       0229*   @y1:    dw 0x0000
041943 00          0230*   @end:   db 0x00 ; padding
041944             0043        include "vdu_sprites.inc"
041944             0001*   ; ; https://github.com/AgonConsole8/agon-docs/blob/main/VDP---Bitmaps-API.md
041944             0002*   ; the VDP can support up to 256 sprites. They must be defined
041944             0003*   ; contiguously, and so the first sprite is sprite 0.
041944             0004*   ; (In contrast, bitmaps can have any ID from 0 to 65534.)
041944             0005*   ; Once a selection of sprites have been defined, you can activate
041944             0006*   ; them using the VDU 23, 27, 7, n command, where n is the number
041944             0007*   ; of sprites to activate. This will activate the first n sprites,
041944             0008*   ; starting with sprite 0. All sprites from 0 to n-1 must be defined.
041944             0009*   
041944             0010*   ; A single sprite can have multiple "frames", referring to
041944             0011*   ; different bitmaps.
041944             0012*   ; (These bitmaps do not need to be the same size.)
041944             0013*   ; This allows a sprite to include an animation sequence,
041944             0014*   ; which can be stepped through one frame at a time, or picked
041944             0015*   ; in any order.
041944             0016*   
041944             0017*   ; Any format of bitmap can be used as a sprite frame. It should
041944             0018*   ; be noted however that "native" format bitmaps are not
041944             0019*   ; recommended for use as sprite frames, as they cannot get
041944             0020*   ; erased from the screen. (As noted above, the "native" bitmap
041944             0021*   ; format is not really intended for general use.) This is part
041944             0022*   ; of why from Agon Console8 VDP 2.6.0 bitmaps captured from the
041944             0023*   ; screen are now stored in RGBA2222 format.
041944             0024*   
041944             0025*   ; An "active" sprite can be hidden, so it will stop being drawn,
041944             0026*   ; and then later shown again.
041944             0027*   
041944             0028*   ; Moving sprites around the screen is done by changing the
041944             0029*   ; position of the sprite. This can be done either by setting
041944             0030*   ; the absolute position of the sprite, or by moving the sprite
041944             0031*   ; by a given number of pixels. (Sprites are positioned using
041944             0032*   ; pixel coordinates, and not by the logical OS coordinate system.)
041944             0033*   ; In the current sprite system, sprites will not update their
041944             0034*   ; position on-screen until either another drawing operation is
041944             0035*   ; performed or an explicit VDU 23, 27, 15 command is performed.
041944             0036*   
041944             0037*   ; VDU 23, 27, 4, n: Select sprite n
041944             0038*   ; inputs: a is the 8-bit sprite id
041944             0039*   vdu_sprite_select:
041944 32 56 19 04 0040*       ld (@sprite),a
041948 21 53 19 04 0041*       ld hl,@cmd
04194C 01 04 00 00 0042*       ld bc,@end-@cmd
041950 5B DF       0043*       rst.lil $18
041952 C9          0044*       ret
041953 17 1B 04    0045*   @cmd:    db 23,27,4
041956 00          0046*   @sprite: db 0x00
041957             0047*   @end:
041957             0048*   
041957             0049*   ; VDU 23, 27, 5: Clear frames in current sprite
041957             0050*   ; inputs: none
041957             0051*   ; prerequisites: vdu_sprite_select
041957             0052*   vdu_sprite_clear_frames:
041957 21 62 19 04 0053*       ld hl,@cmd
04195B 01 03 00 00 0054*       ld bc,@end-@cmd
04195F 5B DF       0055*       rst.lil $18
041961 C9          0056*       ret
041962 17 1B 05    0057*   @cmd: db 23,27,5
041965             0058*   @end:
041965             0059*   
041965             0060*   ; VDU 23, 27, 6, n: Add bitmap n as a frame to current sprite (where bitmap's buffer ID is 64000+n)
041965             0061*   ; inputs: a is the 8-bit bitmap number
041965             0062*   ; prerequisites: vdu_sprite_select
041965             0063*   vdu_sprite_add_bmp:
041965 32 77 19 04 0064*       ld (@bmp),a
041969 21 74 19 04 0065*       ld hl,@cmd
04196D 01 04 00 00 0066*       ld bc,@end-@cmd
041971 5B DF       0067*       rst.lil $18
041973 C9          0068*       ret
041974 17 1B 06    0069*   @cmd: db 23,27,6
041977 00          0070*   @bmp: db 0x00
041978             0071*   @end:
041978             0072*   
041978             0073*   ; VDU 23, 27, 7, n: Activate n sprites
041978             0074*   ; inputs: a is the number of sprites to activate
041978             0075*   ; prerequisites: each sprite activated must have at least one frame attached to it
041978             0076*   vdu_sprite_activate:
041978 32 8A 19 04 0077*       ld (@num),a
04197C 21 87 19 04 0078*       ld hl,@cmd
041980 01 04 00 00 0079*       ld bc,@end-@cmd
041984 5B DF       0080*       rst.lil $18
041986 C9          0081*       ret
041987 17 1B 07    0082*   @cmd: db 23,27,7
04198A 00          0083*   @num: db 0x00
04198B             0084*   @end:
04198B             0085*   
04198B             0086*   ; VDU 23, 27, 8: Select next frame of current sprite
04198B             0087*   ; inputs: none
04198B             0088*   ; prerequisites: vdu_sprite_select
04198B             0089*   vdu_sprite_next_frame:
04198B 21 96 19 04 0090*       ld hl,@cmd
04198F 01 03 00 00 0091*       ld bc,@end-@cmd
041993 5B DF       0092*       rst.lil $18
041995 C9          0093*       ret
041996 17 1B 08    0094*   @cmd: db 23,27,8
041999             0095*   @end:
041999             0096*   
041999             0097*   ; VDU 23, 27, 9: Select previous frame of current sprite
041999             0098*   ; inputs: none
041999             0099*   ; prerequisites: vdu_sprite_select
041999             0100*   vdu_sprite_prev_frame:
041999 21 A4 19 04 0101*       ld hl,@cmd
04199D 01 03 00 00 0102*       ld bc,@end-@cmd
0419A1 5B DF       0103*       rst.lil $18
0419A3 C9          0104*       ret
0419A4 17 1B 09    0105*   @cmd: db 23,27,9
0419A7             0106*   @end:
0419A7             0107*   
0419A7             0108*   ; VDU 23, 27, 10, n: Select the nth frame of current sprite
0419A7             0109*   ; inputs: a is frame number to select
0419A7             0110*   ; prerequisites: vdu_sprite_select
0419A7             0111*   vdu_sprite_select_frame:
0419A7 32 B9 19 04 0112*       ld (@frame),a
0419AB 21 B6 19 04 0113*       ld hl,@cmd
0419AF 01 04 00 00 0114*       ld bc,@end-@cmd
0419B3 5B DF       0115*       rst.lil $18
0419B5 C9          0116*       ret
0419B6 17 1B 0A    0117*   @cmd:    db 23,27,10
0419B9 00          0118*   @frame:  db 0x00
0419BA             0119*   @end:
0419BA             0120*   
0419BA             0121*   ; VDU 23, 27, 11: Show current sprite
0419BA             0122*   ; inputs: none
0419BA             0123*   ; prerequisites: vdu_sprite_select
0419BA             0124*   vdu_sprite_show:
0419BA 21 C5 19 04 0125*       ld hl,@cmd
0419BE 01 03 00 00 0126*       ld bc,@end-@cmd
0419C2 5B DF       0127*       rst.lil $18
0419C4 C9          0128*       ret
0419C5 17 1B 0B    0129*   @cmd: db 23,27,11
0419C8             0130*   @end:
0419C8             0131*   
0419C8             0132*   ; VDU 23, 27, 12: Hide current sprite
0419C8             0133*   ; inputs: none
0419C8             0134*   ; prerequisites: vdu_sprite_select
0419C8             0135*   vdu_sprite_hide:
0419C8 21 D3 19 04 0136*       ld hl,@cmd
0419CC 01 03 00 00 0137*       ld bc,@end-@cmd
0419D0 5B DF       0138*       rst.lil $18
0419D2 C9          0139*       ret
0419D3 17 1B 0C    0140*   @cmd: db 23,27,12
0419D6             0141*   @end:
0419D6             0142*   
0419D6             0143*   ; VDU 23, 27, 13, x; y;: Move current sprite to pixel position x, y
0419D6             0144*   ; inputs: bc is x coordinate, de is y coordinate
0419D6             0145*   ; prerequisites: vdu_sprite_select
0419D6             0146*   vdu_sprite_move_abs:
0419D6 ED 43 EE 19 0147*       ld (@xpos),bc
       04          
0419DB ED 53 F0 19 0148*       ld (@ypos),de
       04          
0419E0 21 EB 19 04 0149*       ld hl,@cmd
0419E4 01 07 00 00 0150*       ld bc,@end-@cmd
0419E8 5B DF       0151*       rst.lil $18
0419EA C9          0152*       ret
0419EB 17 1B 0D    0153*   @cmd:  db 23,27,13
0419EE 00 00       0154*   @xpos: dw 0x0000
0419F0 00 00       0155*   @ypos: dw 0x0000
0419F2 00          0156*   @end:  db 0x00 ; padding
0419F3             0157*   
0419F3             0158*   ; VDU 23, 27, 14, x; y;: Move current sprite by x, y pixels
0419F3             0159*   ; inputs: bc is x coordinate, de is y coordinate
0419F3             0160*   ; prerequisites: vdu_sprite_select
0419F3             0161*   vdu_sprite_move_rel:
0419F3 ED 43 0B 1A 0162*       ld (@dx),bc
       04          
0419F8 ED 53 0D 1A 0163*       ld (@dy),de
       04          
0419FD 21 08 1A 04 0164*       ld hl,@cmd
041A01 01 07 00 00 0165*       ld bc,@end-@cmd
041A05 5B DF       0166*       rst.lil $18
041A07 C9          0167*       ret
041A08 17 1B 0E    0168*   @cmd: db 23,27,14
041A0B 00 00       0169*   @dx:  dw 0x0000
041A0D 00 00       0170*   @dy:  dw 0x0000
041A0F 00          0171*   @end: db 0x00 ; padding
041A10             0172*   
041A10             0173*   ; VDU 23, 27, 13, x; y;: Move current sprite to pixel position x, y
041A10             0174*   ; USING 16.8 FIXED POINT COORDINATES
041A10             0175*   ; inputs: ub.c is x coordinate, ud.e is y coordinate
041A10             0176*   ;   the fractional portiion of the inputs are truncated
041A10             0177*   ;   leaving only the 16-bit integer portion
041A10             0178*   ; prerequisites: vdu_sprite_select
041A10             0179*   vdu_sprite_move_abs168:
041A10             0180*   ; offset inputs by the gfx origin
041A10             0181*   ; y coordinate
041A10 21 00 30 00 0182*       ld hl,origin_top*256
041A14 19          0183*       add hl,de
041A15 22 37 1A 04 0184*       ld (@ypos-1),hl
041A19             0185*   ; x coordinate
041A19 21 00 80 00 0186*       ld hl,origin_left*256
041A1D 09          0187*       add hl,bc
041A1E 22 35 1A 04 0188*       ld (@xpos-1),hl
041A22             0189*   ; prepare vdu command
041A22 3E 0D       0190*       ld a,13       ; restore the final byte of the command
041A24 32 35 1A 04 0191*       ld (@cmd+2),a ; string that got stomped on by bcu
041A28 21 33 1A 04 0192*       ld hl,@cmd
041A2C 01 07 00 00 0193*       ld bc,@end-@cmd
041A30 5B DF       0194*       rst.lil $18
041A32 C9          0195*       ret
041A33 17 1B 0D    0196*   @cmd:  db 23,27,13
041A36 00 00       0197*   @xpos: dw 0x0000
041A38 00 00       0198*   @ypos: dw 0x0000
041A3A             0199*   @end:  ; no padding required b/c we shifted de right
041A3A             0200*   
041A3A             0201*   ; VDU 23, 27, 14, x; y;: Move current sprite by x, y pixels
041A3A             0202*   ; USING 16.8 FIXED POINT COORDINATES
041A3A             0203*   ; inputs: ub.c is dx, ud.e is dy
041A3A             0204*   ;   the fractional portiion of the inputs are truncated
041A3A             0205*   ;   leaving only the 16-bit integer portion
041A3A             0206*   ; prerequisites: vdu_sprite_select
041A3A             0207*   vdu_sprite_move_rel168:
041A3A             0208*   ; populate in the reverse of normal to keep the
041A3A             0209*   ; inputs from stomping on each other
041A3A ED 53 59 1A 0210*       ld (@dy-1),de
       04          
041A3F ED 43 57 1A 0211*       ld (@dx-1),bc
       04          
041A44 3E 0E       0212*       ld a,14       ; restore the final byte of the command
041A46 32 57 1A 04 0213*       ld (@cmd+2),a ; string that got stomped on by bcu
041A4A 21 55 1A 04 0214*       ld hl,@cmd
041A4E 01 07 00 00 0215*       ld bc,@end-@cmd
041A52 5B DF       0216*       rst.lil $18
041A54 C9          0217*       ret
041A55 17 1B 0E    0218*   @cmd:  db 23,27,14
041A58 00 00       0219*   @dx: dw 0x0000
041A5A 00 00       0220*   @dy: dw 0x0000
041A5C             0221*   @end:  ; no padding required b/c we shifted de right
041A5C             0222*   
041A5C             0223*   ; VDU 23, 27, 15: Update the sprites in the GPU
041A5C             0224*   ; inputs: none
041A5C             0225*   vdu_sprite_update:
041A5C 21 67 1A 04 0226*       ld hl,@cmd
041A60 01 03 00 00 0227*       ld bc,@end-@cmd
041A64 5B DF       0228*       rst.lil $18
041A66 C9          0229*       ret
041A67 17 1B 0F    0230*   @cmd: db 23,27,15
041A6A             0231*   @end:
041A6A             0232*   
041A6A             0233*   ; VDU 23, 27, 16: Reset bitmaps and sprites and clear all data
041A6A             0234*   ; inputs: none
041A6A             0235*   vdu_sprite_bmp_reset:
041A6A 21 75 1A 04 0236*       ld hl,@cmd
041A6E 01 03 00 00 0237*       ld bc,@end-@cmd
041A72 5B DF       0238*       rst.lil $18
041A74 C9          0239*       ret
041A75 17 1B 10    0240*   @cmd: db 23,27,16
041A78             0241*   @end:
041A78             0242*   
041A78             0243*   ; VDU 23, 27, 17: Reset sprites (only) and clear all data
041A78             0244*   ; inputs: none
041A78             0245*   vdu_sprite_reset:
041A78 21 83 1A 04 0246*       ld hl,@cmd
041A7C 01 03 00 00 0247*       ld bc,@end-@cmd
041A80 5B DF       0248*       rst.lil $18
041A82 C9          0249*       ret
