04140A             0231*   ; 137   320   240   16    60hz
04140A             0232*   ; 21    512   384   16    60hz
04140A             0233*   ; 149   512   384   16    60hz
04140A             0234*   ; 4     640   240   16    60hz
04140A             0235*   ; 132   640   240   16    60hz
04140A             0236*   ; 0     640   480   16    60hz
04140A             0237*   ; 7     n/a   n/a   16    60hz
