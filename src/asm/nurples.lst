04185A             0042        include "vdu_fonts.inc"
04185A             0001*   ; select font
04185A             0002*   ; inputs: hl = bufferId, a = font flags
04185A             0003*   ; Flags:
04185A             0004*   ; Bit	Description
04185A             0005*   ; 0	Adjust cursor position to ensure text baseline is aligned
04185A             0006*   ;   0: Do not adjust cursor position (best for changing font on a new line)
04185A             0007*   ;   1: Adjust cursor position (best for changing font in the middle of a line)
04185A             0008*   ; 1-7	Reserved for future use
04185A             0009*   ; VDU 23, 0, &95, 0, bufferId; flags: Select font
04185A             0010*   vdu_font_select:
04185A 22 71 18 04 0011*       ld (@bufferId),hl
04185E 32 73 18 04 0012*       ld (@flags),a
041862 21 6D 18 04 0013*       ld hl,@cmd
041866 01 07 00 00 0014*       ld bc,@end-@cmd
04186A 5B DF       0015*       rst.lil $18
04186C C9          0016*       ret
04186D 17 00 95 00 0017*   @cmd: db 23, 0, 0x95, 0
041871 00 00       0018*   @bufferId: dw 0x0000
041873 00          0019*   @flags: db 0x00
041874             0020*   @end:
041874             0021*   
041874             0022*   ; create font from buffer
041874             0023*   ; inputs: hl = bufferId, e = width, d = height, d = ascent, a = flags
041874             0024*   ; VDU 23, 0, &95, 1, bufferId; width, height, ascent, flags: Create font from buffer
041874             0025*   vdu_font_create:
041874 22 99 18 04 0026*       ld (@bufferId),hl
041878 ED 53 9B 18 0027*       ld (@width),de ; also loads height
       04          
04187D 32 9E 18 04 0028*       ld (@flags),a
041881 7A          0029*       ld a,d ; height
041882 32 9D 18 04 0030*       ld (@ascent),a ; ascent = height
041886             0031*   ; consolidate buffer
041886 CD AF 15 04 0032*       call vdu_consolidate_buffer
04188A             0033*   ; create font
04188A 21 95 18 04 0034*       ld hl,@cmd
04188E 01 0A 00 00 0035*       ld bc,@end-@cmd
041892 5B DF       0036*       rst.lil $18
041894 C9          0037*       ret
041895 17 00 95 01 0038*   @cmd: db 23, 0, 0x95, 1
041899 00 00       0039*   @bufferId: dw 0x0000
04189B 00          0040*   @width: db 0x00
04189C 00          0041*   @height: db 0x00
04189D 00          0042*   @ascent: db 0x00
04189E 00          0043*   @flags: db 0x00
04189F             0044*   @end:
04189F             0045*   
04189F             0046*   ; set or adjust font property
04189F             0047*   ; inputs: hl = bufferId, a = field, de = value
04189F             0048*   ; VDU 23, 0, &95, 2, bufferId; field, value;: Set or adjust font property
04189F             0049*   vdu_font_property:
04189F 22 BB 18 04 0050*       ld (@bufferId),hl
0418A3 32 BD 18 04 0051*       ld (@field),a
0418A7 ED 53 BE 18 0052*       ld (@value),de
       04          
0418AC 21 B7 18 04 0053*       ld hl,@cmd
0418B0 01 09 00 00 0054*       ld bc,@end-@cmd
0418B4 5B DF       0055*       rst.lil $18
0418B6 C9          0056*       ret
0418B7 17 00 95 02 0057*   @cmd: db 23, 0, 0x95, 2
0418BB 00 00       0058*   @bufferId: dw 0x0000
0418BD 00          0059*   @field: db 0x00
0418BE 00 00       0060*   @value: dw 0x0000
0418C0 00          0061*   @end: db 0x00 ; padding
0418C1             0062*   
0418C1             0063*   ; VDU 23, 0, &95, 3, bufferId; [<args>]: Reserved
0418C1             0064*   
0418C1             0065*   ; Clear/Delete font
0418C1             0066*   ; inputs: hl = bufferId
0418C1             0067*   ; VDU 23, 0, &95, 4, bufferId;: Clear/Delete font
0418C1             0068*   vdu_font_clear:
0418C1 22 D4 18 04 0069*       ld (@bufferId),hl
0418C5 21 D0 18 04 0070*       ld hl,@cmd
0418C9 01 06 00 00 0071*       ld bc,@end-@cmd
0418CD 5B DF       0072*       rst.lil $18
0418CF C9          0073*       ret
0418D0 17 00 95 04 0074*   @cmd: db 23, 0, 0x95, 4
0418D4 00 00       0075*   @bufferId: dw 0x0000
0418D6 00          0076*   @end: db 0x00 ; padding
0418D7             0077*   
0418D7             0078*   ; Copy system font to buffer
0418D7             0079*   ; inputs: hl = bufferId
0418D7             0080*   ; VDU 23, 0, &95, 5, bufferId;: Copy system font to buffer
0418D7             0081*   vdu_font_copy_system:
0418D7 22 EA 18 04 0082*       ld (@bufferId),hl
0418DB 21 E6 18 04 0083*       ld hl,@cmd
0418DF 01 06 00 00 0084*       ld bc,@end-@cmd
0418E3 5B DF       0085*       rst.lil $18
0418E5 C9          0086*       ret
0418E6 17 00 95 05 0087*   @cmd: db 23, 0, 0x95, 5
0418EA 00 00       0088*   @bufferId: dw 0x0000
0418EC 00          0089*   @end: db 0x00 ; padding
0418ED             0043        include "vdu_plot.inc"
0418ED             0001*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
0418ED             0002*   ; PLOT code 	(Decimal) 	Effect
0418ED             0003*   ; &00-&07 	0-7 	Solid line, includes both ends
0418ED             0004*   plot_sl_both: equ 0x00
0418ED             0005*   
0418ED             0006*   ; &08-&0F 	8-15 	Solid line, final point omitted
0418ED             0007*   plot_sl_first: equ 0x08
0418ED             0008*   
0418ED             0009*   ; &10-&17 	16-23 	Not supported (Dot-dash line, includes both ends, pattern restarted)
0418ED             0010*   ; &18-&1F 	24-31 	Not supported (Dot-dash line, first point omitted, pattern restarted)
0418ED             0011*   
0418ED             0012*   ; &20-&27 	32-39 	Solid line, first point omitted
0418ED             0013*   plot_sl_last: equ 0x20
0418ED             0014*   
0418ED             0015*   ; &28-&2F 	40-47 	Solid line, both points omitted
0418ED             0016*   plot_sl_none: equ 0x28
0418ED             0017*   
0418ED             0018*   ; &30-&37 	48-55 	Not supported (Dot-dash line, first point omitted, pattern continued)
0418ED             0019*   ; &38-&3F 	56-63 	Not supported (Dot-dash line, both points omitted, pattern continued)
0418ED             0020*   
0418ED             0021*   ; &40-&47 	64-71 	Point plot
0418ED             0022*   plot_pt: equ 0x40
0418ED             0023*   
0418ED             0024*   ; &48-&4F 	72-79 	Line fill left and right to non-background §§
0418ED             0025*   plot_lf_lr_non_bg: equ 0x48
0418ED             0026*   
0418ED             0027*   ; &50-&57 	80-87 	Triangle fill
0418ED             0028*   plot_tf: equ 0x50
0418ED             0029*   
0418ED             0030*   ; &58-&5F 	88-95 	Line fill right to background §§
0418ED             0031*   plot_lf_r_bg: equ 0x58
0418ED             0032*   
0418ED             0033*   ; &60-&67 	96-103 	Rectangle fill
0418ED             0034*   plot_rf: equ 0x60
0418ED             0035*   
0418ED             0036*   ; &68-&6F 	104-111 	Line fill left and right to foreground §§
0418ED             0037*   plot_lf_lr_fg: equ 0x60
0418ED             0038*   
0418ED             0039*   ; &70-&77 	112-119 	Parallelogram fill
0418ED             0040*   plot_pf: equ 0x70
0418ED             0041*   
0418ED             0042*   ; &78-&7F 	120-127 	Line fill right to non-foreground §§
0418ED             0043*   plot_lf_r_non_fg: equ 0x78
0418ED             0044*   
0418ED             0045*   ; &80-&87 	128-135 	Not supported (Flood until non-background)
0418ED             0046*   ; &88-&8F 	136-143 	Not supported (Flood until foreground)
0418ED             0047*   
0418ED             0048*   ; &90-&97 	144-151 	Circle outline
0418ED             0049*   plot_co: equ 0x90
0418ED             0050*   
0418ED             0051*   ; &98-&9F 	152-159 	Circle fill
0418ED             0052*   plot_cf: equ 0x98
0418ED             0053*   
0418ED             0054*   ; &A0-&A7 	160-167 	Not supported (Circular arc)
0418ED             0055*   ; &A8-&AF 	168-175 	Not supported (Circular segment)
0418ED             0056*   ; &B0-&B7 	176-183 	Not supported (Circular sector)
0418ED             0057*   
0418ED             0058*   ; &B8-&BF 	184-191 	Rectangle copy/move
0418ED             0059*   plot_rcm: equ 0xB8
0418ED             0060*   
0418ED             0061*   ; &C0-&C7 	192-199 	Not supported (Ellipse outline)
0418ED             0062*   ; &C8-&CF 	200-207 	Not supported (Ellipse fill)
0418ED             0063*   ; &D0-&D7 	208-215 	Not defined
0418ED             0064*   ; &D8-&DF 	216-223 	Not defined
0418ED             0065*   ; &E0-&E7 	224-231 	Not defined
0418ED             0066*   
0418ED             0067*   ; &E8-&EF 	232-239 	Bitmap plot §
0418ED             0068*   plot_bmp: equ 0xE8
0418ED             0069*   
0418ED             0070*   ; &F0-&F7 	240-247 	Not defined
0418ED             0071*   ; &F8-&FF 	248-255 	Not defined
0418ED             0072*   
0418ED             0073*   ; § Support added in Agon Console8 VDP 2.1.0 §§ Support added in
0418ED             0074*   ; Agon Console8 VDP 2.2.0
0418ED             0075*   
0418ED             0076*   ; Within each group of eight plot codes, the effects are as follows:
0418ED             0077*   ; Plot code 	Effect
0418ED             0078*   ; 0 	Move relative
0418ED             0079*   mv_rel: equ 0
0418ED             0080*   
0418ED             0081*   ; 1 	Plot relative in current foreground colour
0418ED             0082*   dr_rel_fg: equ 1
0418ED             0083*   
0418ED             0084*   ; 2 	Not supported (Plot relative in logical inverse colour)
0418ED             0085*   ; 3 	Plot relative in current background colour
0418ED             0086*   dr_rel_bg: equ 3
0418ED             0087*   
0418ED             0088*   ; 4 	Move absolute
0418ED             0089*   mv_abs: equ 4
0418ED             0090*   
0418ED             0091*   ; 5 	Plot absolute in current foreground colour
0418ED             0092*   dr_abs_fg: equ 5
0418ED             0093*   
0418ED             0094*   ; 6 	Not supported (Plot absolute in logical inverse colour)
0418ED             0095*   ; 7 	Plot absolute in current background colour
0418ED             0096*   dr_abs_bg: equ 7
0418ED             0097*   
0418ED             0098*   ; Codes 0-3 use the position data provided as part of the command
0418ED             0099*   ; as a relative position, adding the position given to the current
0418ED             0100*   ; graphical cursor position. Codes 4-7 use the position data provided
0418ED             0101*   ; as part of the command as an absolute position, setting the current
0418ED             0102*   ; graphical cursor position to the position given.
0418ED             0103*   
0418ED             0104*   ; Codes 2 and 6 on Acorn systems plot using a logical inverse of the
0418ED             0105*   ; current pixel colour. These operations cannot currently be supported
0418ED             0106*   ; by the graphics system the Agon VDP uses, so these codes are not
0418ED             0107*   ; supported. Support for these codes may be added in a future version
0418ED             0108*   ; of the VDP firmware.
0418ED             0109*   
0418ED             0110*   ; 16 colour palette constants
0418ED             0111*   c_black: equ 0
0418ED             0112*   c_red_dk: equ 1
0418ED             0113*   c_green_dk: equ 2
0418ED             0114*   c_yellow_dk: equ 3
0418ED             0115*   c_blue_dk: equ 4
0418ED             0116*   c_magenta_dk: equ 5
0418ED             0117*   c_cyan_dk: equ 6
0418ED             0118*   c_grey: equ 7
0418ED             0119*   c_grey_dk: equ 8
0418ED             0120*   c_red: equ 9
0418ED             0121*   c_green: equ 10
0418ED             0122*   c_yellow: equ 11
0418ED             0123*   c_blue: equ 12
0418ED             0124*   c_magenta: equ 13
0418ED             0125*   c_cyan: equ 14
0418ED             0126*   c_white: equ 15
0418ED             0127*   
0418ED             0128*   ; VDU 25, mode, x; y;: PLOT command
0418ED             0129*   ; inputs: a=mode, bc=x0, de=y0
0418ED             0130*   vdu_plot:
0418ED 32 07 19 04 0131*       ld (@mode),a
0418F1 ED 43 08 19 0132*       ld (@x0),bc
       04          
0418F6 ED 53 0A 19 0133*       ld (@y0),de
       04          
0418FB 21 06 19 04 0134*   	ld hl,@cmd
0418FF 01 06 00 00 0135*   	ld bc,@end-@cmd
041903 5B DF       0136*   	rst.lil $18
041905 C9          0137*   	ret
041906 19          0138*   @cmd:   db 25
041907 00          0139*   @mode:  db 0
041908 00 00       0140*   @x0: 	dw 0
04190A 00 00       0141*   @y0: 	dw 0
04190C 00          0142*   @end:   db 0 ; extra byte to soak up deu
04190D             0143*   
04190D             0144*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
04190D             0145*   ; &E8-&EF 	232-239 	Bitmap plot §
04190D             0146*   ; VDU 25, mode, x; y;: PLOT command
04190D             0147*   ; inputs: bc=x0, de=y0
04190D             0148*   ; prerequisites: vdu_buff_select
04190D             0149*   vdu_plot_bmp:
04190D ED 43 24 19 0150*       ld (@x0),bc
       04          
041912 ED 53 26 19 0151*       ld (@y0),de
       04          
041917 21 22 19 04 0152*   	ld hl,@cmd
04191B 01 06 00 00 0153*   	ld bc,@end-@cmd
04191F 5B DF       0154*   	rst.lil $18
041921 C9          0155*   	ret
041922 19          0156*   @cmd:   db 25
041923 ED          0157*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
041924 00 00       0158*   @x0: 	dw 0x0000
041926 00 00       0159*   @y0: 	dw 0x0000
041928 00          0160*   @end:   db 0x00 ; padding
041929             0161*   
041929             0162*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
041929             0163*   ; &E8-&EF 	232-239 	Bitmap plot §
041929             0164*   ; VDU 25, mode, x; y;: PLOT command
041929             0165*   ; inputs: bc=x0, de=y0
041929             0166*   ; USING 16.8 FIXED POINT COORDINATES
041929             0167*   ; inputs: ub.c is x coordinate, ud.e is y coordinate
041929             0168*   ;   the fractional portiion of the inputs are truncated
041929             0169*   ;   leaving only the 16-bit integer portion
041929             0170*   ; prerequisites: vdu_buff_select
041929             0171*   vdu_plot_bmp168:
041929             0172*   ; populate in the reverse of normal to keep the
041929             0173*   ; inputs from stomping on each other
041929 ED 53 47 19 0174*       ld (@y0-1),de
       04          
04192E ED 43 45 19 0175*       ld (@x0-1),bc
       04          
041933 3E ED       0176*       ld a,plot_bmp+dr_abs_fg ; 0xED
041935 32 45 19 04 0177*       ld (@mode),a ; restore the mode byte that got stomped on by bcu
041939 21 44 19 04 0178*   	ld hl,@cmd
04193D 01 06 00 00 0179*   	ld bc,@end-@cmd
041941 5B DF       0180*   	rst.lil $18
041943 C9          0181*   	ret
041944 19          0182*   @cmd:   db 25
041945 ED          0183*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
041946 00 00       0184*   @x0: 	dw 0x0000
041948 00 00       0185*   @y0: 	dw 0x0000
04194A             0186*   @end:  ; no padding required b/c we shifted de right
04194A             0187*   
04194A             0188*   ; draw a filled rectangle
04194A             0189*   vdu_plot_rf:
04194A ED 43 71 19 0190*       ld (@x0),bc
       04          
04194F ED 53 73 19 0191*       ld (@y0),de
       04          
041954 DD 22 77 19 0192*       ld (@x1),ix
       04          
041959 FD 22 79 19 0193*       ld (@y1),iy
       04          
04195E 3E 19       0194*       ld a,25 ; we have to reload the 2nd plot command
041960 32 75 19 04 0195*       ld (@cmd1),a ; because the 24-bit y0 load stomped on it
041964 21 6F 19 04 0196*   	ld hl,@cmd0
041968 01 0C 00 00 0197*   	ld bc,@end-@cmd0
04196C 5B DF       0198*   	rst.lil $18
04196E C9          0199*       ret
04196F 19          0200*   @cmd0:  db 25 ; plot
041970 04          0201*   @arg0:  db plot_sl_both+mv_abs
041971 00 00       0202*   @x0:    dw 0x0000
041973 00 00       0203*   @y0:    dw 0x0000
041975 19          0204*   @cmd1:  db 25 ; plot
041976 65          0205*   @arg1:  db plot_rf+dr_abs_fg
041977 00 00       0206*   @x1:    dw 0x0000
041979 00 00       0207*   @y1:    dw 0x0000
04197B 00          0208*   @end:   db 0x00 ; padding
04197C             0209*   
04197C             0210*   ; draw a filled circle
04197C             0211*   vdu_plot_cf:
04197C ED 43 A3 19 0212*       ld (@x0),bc
       04          
041981 ED 53 A5 19 0213*       ld (@y0),de
       04          
041986 DD 22 A9 19 0214*       ld (@x1),ix
       04          
04198B FD 22 AB 19 0215*       ld (@y1),iy
       04          
041990 3E 19       0216*       ld a,25 ; we have to reload the 2nd plot command
041992 32 A7 19 04 0217*       ld (@cmd1),a ; because the 24-bit y0 load stomped on it
041996 21 A1 19 04 0218*   	ld hl,@cmd0
04199A 01 0C 00 00 0219*   	ld bc,@end-@cmd0
04199E 5B DF       0220*   	rst.lil $18
0419A0 C9          0221*       ret
0419A1 19          0222*   @cmd0:  db 25 ; plot
0419A2 04          0223*   @arg0:  db plot_sl_both+mv_abs
0419A3 00 00       0224*   @x0:    dw 0x0000
0419A5 00 00       0225*   @y0:    dw 0x0000
0419A7 19          0226*   @cmd1:  db 25 ; plot
0419A8 9D          0227*   @arg1:  db plot_cf+dr_abs_fg
0419A9 00 00       0228*   @x1:    dw 0x0000
0419AB 00 00       0229*   @y1:    dw 0x0000
0419AD 00          0230*   @end:   db 0x00 ; padding
0419AE             0044        include "vdu_sprites.inc"
0419AE             0001*   ; ; https://github.com/AgonConsole8/agon-docs/blob/main/VDP---Bitmaps-API.md
0419AE             0002*   ; the VDP can support up to 256 sprites. They must be defined
0419AE             0003*   ; contiguously, and so the first sprite is sprite 0.
0419AE             0004*   ; (In contrast, bitmaps can have any ID from 0 to 65534.)
0419AE             0005*   ; Once a selection of sprites have been defined, you can activate
0419AE             0006*   ; them using the VDU 23, 27, 7, n command, where n is the number
0419AE             0007*   ; of sprites to activate. This will activate the first n sprites,
0419AE             0008*   ; starting with sprite 0. All sprites from 0 to n-1 must be defined.
0419AE             0009*   
0419AE             0010*   ; A single sprite can have multiple "frames", referring to
0419AE             0011*   ; different bitmaps.
0419AE             0012*   ; (These bitmaps do not need to be the same size.)
0419AE             0013*   ; This allows a sprite to include an animation sequence,
0419AE             0014*   ; which can be stepped through one frame at a time, or picked
0419AE             0015*   ; in any order.
0419AE             0016*   
0419AE             0017*   ; Any format of bitmap can be used as a sprite frame. It should
0419AE             0018*   ; be noted however that "native" format bitmaps are not
0419AE             0019*   ; recommended for use as sprite frames, as they cannot get
0419AE             0020*   ; erased from the screen. (As noted above, the "native" bitmap
0419AE             0021*   ; format is not really intended for general use.) This is part
0419AE             0022*   ; of why from Agon Console8 VDP 2.6.0 bitmaps captured from the
0419AE             0023*   ; screen are now stored in RGBA2222 format.
0419AE             0024*   
0419AE             0025*   ; An "active" sprite can be hidden, so it will stop being drawn,
0419AE             0026*   ; and then later shown again.
0419AE             0027*   
0419AE             0028*   ; Moving sprites around the screen is done by changing the
0419AE             0029*   ; position of the sprite. This can be done either by setting
0419AE             0030*   ; the absolute position of the sprite, or by moving the sprite
0419AE             0031*   ; by a given number of pixels. (Sprites are positioned using
0419AE             0032*   ; pixel coordinates, and not by the logical OS coordinate system.)
0419AE             0033*   ; In the current sprite system, sprites will not update their
0419AE             0034*   ; position on-screen until either another drawing operation is
0419AE             0035*   ; performed or an explicit VDU 23, 27, 15 command is performed.
0419AE             0036*   
0419AE             0037*   ; VDU 23, 27, 4, n: Select sprite n
0419AE             0038*   ; inputs: a is the 8-bit sprite id
0419AE             0039*   vdu_sprite_select:
0419AE 32 C0 19 04 0040*       ld (@sprite),a
0419B2 21 BD 19 04 0041*       ld hl,@cmd
0419B6 01 04 00 00 0042*       ld bc,@end-@cmd
0419BA 5B DF       0043*       rst.lil $18
0419BC C9          0044*       ret
0419BD 17 1B 04    0045*   @cmd:    db 23,27,4
0419C0 00          0046*   @sprite: db 0x00
0419C1             0047*   @end:
0419C1             0048*   
0419C1             0049*   ; VDU 23, 27, 5: Clear frames in current sprite
0419C1             0050*   ; inputs: none
0419C1             0051*   ; prerequisites: vdu_sprite_select
0419C1             0052*   vdu_sprite_clear_frames:
0419C1 21 CC 19 04 0053*       ld hl,@cmd
0419C5 01 03 00 00 0054*       ld bc,@end-@cmd
0419C9 5B DF       0055*       rst.lil $18
0419CB C9          0056*       ret
0419CC 17 1B 05    0057*   @cmd: db 23,27,5
0419CF             0058*   @end:
0419CF             0059*   
0419CF             0060*   ; VDU 23, 27, 6, n: Add bitmap n as a frame to current sprite (where bitmap's buffer ID is 64000+n)
0419CF             0061*   ; inputs: a is the 8-bit bitmap number
0419CF             0062*   ; prerequisites: vdu_sprite_select
0419CF             0063*   vdu_sprite_add_bmp:
0419CF 32 E1 19 04 0064*       ld (@bmp),a
0419D3 21 DE 19 04 0065*       ld hl,@cmd
0419D7 01 04 00 00 0066*       ld bc,@end-@cmd
0419DB 5B DF       0067*       rst.lil $18
0419DD C9          0068*       ret
0419DE 17 1B 06    0069*   @cmd: db 23,27,6
0419E1 00          0070*   @bmp: db 0x00
0419E2             0071*   @end:
0419E2             0072*   
0419E2             0073*   ; VDU 23, 27, 7, n: Activate n sprites
0419E2             0074*   ; inputs: a is the number of sprites to activate
0419E2             0075*   ; prerequisites: each sprite activated must have at least one frame attached to it
0419E2             0076*   vdu_sprite_activate:
0419E2 32 F4 19 04 0077*       ld (@num),a
0419E6 21 F1 19 04 0078*       ld hl,@cmd
0419EA 01 04 00 00 0079*       ld bc,@end-@cmd
0419EE 5B DF       0080*       rst.lil $18
0419F0 C9          0081*       ret
0419F1 17 1B 07    0082*   @cmd: db 23,27,7
0419F4 00          0083*   @num: db 0x00
0419F5             0084*   @end:
0419F5             0085*   
0419F5             0086*   ; VDU 23, 27, 8: Select next frame of current sprite
0419F5             0087*   ; inputs: none
0419F5             0088*   ; prerequisites: vdu_sprite_select
0419F5             0089*   vdu_sprite_next_frame:
0419F5 21 00 1A 04 0090*       ld hl,@cmd
0419F9 01 03 00 00 0091*       ld bc,@end-@cmd
0419FD 5B DF       0092*       rst.lil $18
0419FF C9          0093*       ret
041A00 17 1B 08    0094*   @cmd: db 23,27,8
041A03             0095*   @end:
041A03             0096*   
041A03             0097*   ; VDU 23, 27, 9: Select previous frame of current sprite
041A03             0098*   ; inputs: none
041A03             0099*   ; prerequisites: vdu_sprite_select
041A03             0100*   vdu_sprite_prev_frame:
041A03 21 0E 1A 04 0101*       ld hl,@cmd
041A07 01 03 00 00 0102*       ld bc,@end-@cmd
041A0B 5B DF       0103*       rst.lil $18
041A0D C9          0104*       ret
041A0E 17 1B 09    0105*   @cmd: db 23,27,9
041A11             0106*   @end:
041A11             0107*   
041A11             0108*   ; VDU 23, 27, 10, n: Select the nth frame of current sprite
041A11             0109*   ; inputs: a is frame number to select
041A11             0110*   ; prerequisites: vdu_sprite_select
041A11             0111*   vdu_sprite_select_frame:
041A11 32 23 1A 04 0112*       ld (@frame),a
041A15 21 20 1A 04 0113*       ld hl,@cmd
041A19 01 04 00 00 0114*       ld bc,@end-@cmd
041A1D 5B DF       0115*       rst.lil $18
041A1F C9          0116*       ret
041A20 17 1B 0A    0117*   @cmd:    db 23,27,10
041A23 00          0118*   @frame:  db 0x00
041A24             0119*   @end:
041A24             0120*   
041A24             0121*   ; VDU 23, 27, 11: Show current sprite
041A24             0122*   ; inputs: none
041A24             0123*   ; prerequisites: vdu_sprite_select
041A24             0124*   vdu_sprite_show:
041A24 21 2F 1A 04 0125*       ld hl,@cmd
041A28 01 03 00 00 0126*       ld bc,@end-@cmd
041A2C 5B DF       0127*       rst.lil $18
041A2E C9          0128*       ret
041A2F 17 1B 0B    0129*   @cmd: db 23,27,11
041A32             0130*   @end:
041A32             0131*   
041A32             0132*   ; VDU 23, 27, 12: Hide current sprite
041A32             0133*   ; inputs: none
041A32             0134*   ; prerequisites: vdu_sprite_select
041A32             0135*   vdu_sprite_hide:
041A32 21 3D 1A 04 0136*       ld hl,@cmd
041A36 01 03 00 00 0137*       ld bc,@end-@cmd
041A3A 5B DF       0138*       rst.lil $18
041A3C C9          0139*       ret
041A3D 17 1B 0C    0140*   @cmd: db 23,27,12
041A40             0141*   @end:
041A40             0142*   
041A40             0143*   ; VDU 23, 27, 13, x; y;: Move current sprite to pixel position x, y
041A40             0144*   ; inputs: bc is x coordinate, de is y coordinate
041A40             0145*   ; prerequisites: vdu_sprite_select
041A40             0146*   vdu_sprite_move_abs:
041A40 ED 43 58 1A 0147*       ld (@xpos),bc
       04          
041A45 ED 53 5A 1A 0148*       ld (@ypos),de
       04          
041A4A 21 55 1A 04 0149*       ld hl,@cmd
041A4E 01 07 00 00 0150*       ld bc,@end-@cmd
041A52 5B DF       0151*       rst.lil $18
041A54 C9          0152*       ret
041A55 17 1B 0D    0153*   @cmd:  db 23,27,13
041A58 00 00       0154*   @xpos: dw 0x0000
041A5A 00 00       0155*   @ypos: dw 0x0000
041A5C 00          0156*   @end:  db 0x00 ; padding
041A5D             0157*   
041A5D             0158*   ; VDU 23, 27, 14, x; y;: Move current sprite by x, y pixels
041A5D             0159*   ; inputs: bc is x coordinate, de is y coordinate
041A5D             0160*   ; prerequisites: vdu_sprite_select
041A5D             0161*   vdu_sprite_move_rel:
041A5D ED 43 75 1A 0162*       ld (@dx),bc
       04          
041A62 ED 53 77 1A 0163*       ld (@dy),de
       04          
041A67 21 72 1A 04 0164*       ld hl,@cmd
041A6B 01 07 00 00 0165*       ld bc,@end-@cmd
041A6F 5B DF       0166*       rst.lil $18
041A71 C9          0167*       ret
041A72 17 1B 0E    0168*   @cmd: db 23,27,14
041A75 00 00       0169*   @dx:  dw 0x0000
041A77 00 00       0170*   @dy:  dw 0x0000
041A79 00          0171*   @end: db 0x00 ; padding
041A7A             0172*   
041A7A             0173*   ; VDU 23, 27, 13, x; y;: Move current sprite to pixel position x, y
041A7A             0174*   ; USING 16.8 FIXED POINT COORDINATES
041A7A             0175*   ; inputs: ub.c is x coordinate, ud.e is y coordinate
041A7A             0176*   ;   the fractional portiion of the inputs are truncated
041A7A             0177*   ;   leaving only the 16-bit integer portion
041A7A             0178*   ; prerequisites: vdu_sprite_select
041A7A             0179*   vdu_sprite_move_abs168:
041A7A             0180*   ; offset inputs by the gfx origin
041A7A             0181*   ; y coordinate
041A7A 21 00 30 00 0182*       ld hl,origin_top*256
041A7E 19          0183*       add hl,de
041A7F 22 A1 1A 04 0184*       ld (@ypos-1),hl
041A83             0185*   ; x coordinate
041A83 21 00 80 00 0186*       ld hl,origin_left*256
041A87 09          0187*       add hl,bc
041A88 22 9F 1A 04 0188*       ld (@xpos-1),hl
041A8C             0189*   ; prepare vdu command
041A8C 3E 0D       0190*       ld a,13       ; restore the final byte of the command
041A8E 32 9F 1A 04 0191*       ld (@cmd+2),a ; string that got stomped on by bcu
041A92 21 9D 1A 04 0192*       ld hl,@cmd
041A96 01 07 00 00 0193*       ld bc,@end-@cmd
041A9A 5B DF       0194*       rst.lil $18
041A9C C9          0195*       ret
041A9D 17 1B 0D    0196*   @cmd:  db 23,27,13
041AA0 00 00       0197*   @xpos: dw 0x0000
041AA2 00 00       0198*   @ypos: dw 0x0000
