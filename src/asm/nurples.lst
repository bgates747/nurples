042010 DD 21 60 9C 0222*       ld ix,player_begin
       04          
042015 CD 26 1F 04 0223*       call check_collision
042019 C0          0224*       ret nz ; no collision so nothing to do
04201A DD CB 1D FE 0225*       set sprite_just_died,(ix+sprite_collisions)
04201E FD CB 1D FE 0226*       set sprite_just_died,(iy+sprite_collisions)
042022 AF          0227*       xor a ; signal collision detected
042023 C9          0228*       ret
