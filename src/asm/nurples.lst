       2E 61 67 6E 
       62 00       
040FF8             0010*   
040FF8             0011*   ; The 160x106 logo travels from just inside the lower edge to an 8-pixel top
040FF8             0012*   ; margin. Keep these expressions unambiguous because ez80asm evaluates complex
040FF8             0013*   ; arithmetic left-to-right.
040FF8             0014*   logo_y_start:    equ 224*256
040FF8             0015*   logo_y_end:      equ 8*256
040FF8             0016*   logo_y_distance: equ -216*256
040FF8             0017*   
040FF8 00 00 00    0018*   logo_xpos: dl 0
040FFB 00 00 00    0019*   logo_ypos: dl 0
040FFE 00 00 00    0020*   logo_yvel: dl 0
041001             0021*   
041001 00 00 00    0022*   game_load_index:             dl 0
041004 00 00 00    0023*   game_load_remaining:         dl 0
041007 00          0024*   game_load_callback_overflow: db 0
041008             0025*   
041008             0026*   
041008             0027*   ; Print one completion breadcrumb at a safe record boundary. The canonical
041008             0028*   ; loader invokes this only after the bitmap has been fully created.
041008             0029*   img_load_agnb_breadcrumb:
041008 3E 2E       0030*       ld a,'.'
04100A 5B D7       0031*       rst.lil 10h
04100C AF          0032*       xor a
04100D C9          0033*       ret
04100E             0034*   
04100E             0035*   
04100E             0036*   ; Initialize exact 16.8 accumulated displacement for all game.agnb records.
04100E             0037*   img_load_init:
04100E 21 00 00 00 0038*       ld hl,0
041012 22 F8 0F 04 0039*       ld (logo_xpos),hl
041016 22 01 10 04 0040*       ld (game_load_index),hl
04101A 7D          0041*       ld a,l
04101B 32 07 10 04 0042*       ld (game_load_callback_overflow),a
04101F             0043*   
04101F 21 00 E0 00 0044*       ld hl,logo_y_start
041023 22 FB 0F 04 0045*       ld (logo_ypos),hl
041027             0046*   
041027 21 5E 01 00 0047*       ld hl,game_num_images
04102B 22 04 10 04 0048*       ld (game_load_remaining),hl
04102F             0049*   
04102F 21 00 28 FF 0050*       ld hl,logo_y_distance
041033 11 00 5E 01 0051*       ld de,game_num_images*256
041037 CD 75 06 04 0052*       call sdiv168 ; DE = signed 16.8 distance per completed bitmap
04103B ED 53 FE 0F 0053*       ld (logo_yvel),de
       04          
041040 C9          0054*       ret
041041             0055*   
041041             0056*   
041041             0057*   ; Draw the splash and advance its marching logo after one complete game image.
041041             0058*   ; The callback result is ignored by AGNB, so an impossible extra callback is
041041             0059*   ; latched for validation after the loader returns.
041041             0060*   img_load_agnb_progress:
041041 2A 04 10 04 0061*       ld hl,(game_load_remaining)
041045 11 00 00 00 0062*       ld de,0
041049 B7          0063*       or a
04104A ED 52       0064*       sbc hl,de
04104C 20 08       0065*       jr nz,@record_expected
04104E 3E 01       0066*       ld a,1
041050 32 07 10 04 0067*       ld (game_load_callback_overflow),a
041054 AF          0068*       xor a
041055 C9          0069*       ret
041056             0070*   
041056             0071*   @record_expected:
041056 2B          0072*       dec hl
041057 22 04 10 04 0073*       ld (game_load_remaining),hl
04105B ED 5B 01 10 0074*       ld de,(game_load_index)
       04          
041060 13          0075*       inc de
041061 ED 53 01 10 0076*       ld (game_load_index),de
       04          
041066             0077*   
041066             0078*   ; Clear before repainting because screen mode 8 is single-buffered.
041066 CD D2 13 04 0079*       call vdu_cls
04106A 21 2C 00 00 0080*       ld hl,BUF_SPLASH_BG
04106E CD E4 14 04 0081*       call vdu_buff_select
041072 01 00 00 00 0082*       ld bc,0
041076 11 00 00 00 0083*       ld de,0
04107A CD 1A 19 04 0084*       call vdu_plot_bmp
04107E             0085*   
04107E CD AF 10 04 0086*       call move_logo
041082             0087*   
041082             0088*   ; Show deterministic record progress without retaining 350 pathname strings.
041082 CD 5C 00 04 0089*       call printInline
041086 4C 6F 61 64 0090*       asciz "Loading images: "
       69 6E 67 20 
       69 6D 61 67 
       65 73 3A 20 
       00          
041097 2A 01 10 04 0091*       ld hl,(game_load_index)
