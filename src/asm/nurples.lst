04401C 2B          0855*       dec hl
04401D 52 23       0856*       inc.s hl ; undocumented: preserves HL and clears HLU
04401F EB          0857*       ex de,hl
044020 2A 7A 1B 04 0858*       ld hl,(agnb_metadata+agnb_meta_width)
044024 2B          0859*       dec hl
044025 52 23       0860*       inc.s hl ; undocumented: preserves HL and clears HLU
044027 CD 63 03 04 0861*       call umul24
04402B 22 83 1B 04 0862*       ld (agnb_expected_data_size),hl
04402F AF          0863*       xor a
044030 32 86 1B 04 0864*       ld (agnb_expected_data_size+3),a
044034 C9          0865*       ret
