044CAE             0039*   spawn_explosion_player:
044CAE FD 21 1A 89 0040*       ld iy,player_begin
       04          
044CB3 FD 22 49 67 0041*       ld (table_pointer),iy
       04          
044CB8 21 76 4C 04 0042*       ld hl,explosion_defaults
044CBC DD 21 1A 8B 0043*       ld ix,explosions_base
       04          
