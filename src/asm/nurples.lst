04656F             0090*   player_spawn_laser:
04656F             0091*    ; check laser spawn timer
04656F FD 21 EE 64 0092*       ld iy,tmr_laser
       04          
046574 CD E4 12 04 0093*       call timestamp_tmr_get
046578 F0          0094*       ret p ; not time to fire
046579             0095*   ; check laser power
046579 3A F7 64 04 0096*       ld a,(laser_power)
04657D 21 FA 64 04 0097*       ld hl,laser_power_per_shot
046581 96          0098*       sub (hl) ; units of power per laser shot
046582 D8          0099*       ret c ; not enough power to fire
046583             0100*   ; update power to reflect firing
046583 32 F7 64 04 0101*       ld (laser_power),a
046587             0102*   ; reset timer
046587 2A F4 64 04 0103*       ld hl,(tmr_laser_reset)
04658B CD D9 12 04 0104*       call timestamp_tmr_set
04658F             0105*   ; fire the laser
04658F DD 21 F3 86 0106*       ld ix,player_weapons_begin
       04          
046594 06 04       0107*       ld b,player_lasers_max
046596 FD 21 F3 87 0108*       ld iy,player_begin
       04          
04659B FD 22 DD 66 0109*       ld (table_pointer),iy
       04          
0465A0 21 DB 64 04 0110*       ld hl,laser_defaults
0465A4 CD 25 68 04 0111*       call spawn_sprite_from_sprite
0465A8 D0          0112*       ret nc ; no carry means no free sprite slots, so we go home
0465A9             0113*   ; other specific initialization
0465A9             0114*   ; ------------------------------------------------
0465A9 FD 21 F3 87 0115*       ld iy,player_begin
       04          
