044862 00          0023*       db 0 ; string terminator
044863             0049        include "collisions.inc"
044863             0001*   ; ====== COLLISION DETECTION ======
044863             0002*   ; --- constants ---
044863             0003*   ; sprite_collisions flags
044863             0004*   ; collides_with_player: equ %00000001
044863             0005*   ; collides_with_laser: equ %00000010
044863             0006*   sprite_alive: equ 6; set when sprite is alive
044863             0007*   sprite_just_died: equ 7; set when sprite just died
044863             0008*   collide_top: equ %00001000
044863             0009*   collide_bottom: equ %00000100
044863             0010*   collide_left: equ %00000010
044863             0011*   collide_right: equ %00000001
044863             0012*   
044863 00 00 00    0013*   collision_table_pointer: dl 0x000000 ; pointer to the sprite in the group being checked for collision
044866             0014*   
044866             0015*   collision_draw_hitboxes:
044866             0016*   ; draw hitbox for ix collider
044866 DD E5       0017*       push ix
044868 FD E5       0018*       push iy
04486A AF          0019*       xor a ; color mode 0
04486B 0E 09       0020*       ld c,c_red
04486D CD 07 14 04 0021*       call vdu_gcol
044871 01 00 00 00 0022*       ld bc,0
044875 DD 4E 02    0023*       ld c,(ix+sprite_x+1)
044878 DD 46 03    0024*       ld b,(ix+sprite_x+2)
04487B 11 00 00 00 0025*       ld de,0
04487F DD 5E 05    0026*       ld e,(ix+sprite_y+1)
044882 DD 56 06    0027*       ld d,(ix+sprite_y+2)
044885 21 00 00 00 0028*       ld hl,0 ; clear hlu and h
044889 DD 6E 1E    0029*       ld l,(ix+sprite_dim_x)
04488C 09          0030*       add hl,bc ; hl = x1
04488D E5          0031*       push hl ; save x1
04488E 21 00 00 00 0032*       ld hl,0 ; clear hlu and h
044892 DD 6E 1F    0033*       ld l,(ix+sprite_dim_y)
044895 19          0034*       add hl,de ; hl = y1
044896 DD E1       0035*       pop ix ; ix = x1 (was hl)
044898 E5          0036*       push hl
044899 FD E1       0037*       pop iy ; iy = y1
04489B CD 4A 19 04 0038*       call vdu_plot_rf
04489F FD E1       0039*       pop iy
0448A1 DD E1       0040*       pop ix
0448A3             0041*   
0448A3             0042*   ; draw hitbox for iy collider
0448A3 DD E5       0043*       push ix
0448A5 FD E5       0044*       push iy
0448A7 AF          0045*       xor a ; color mode 0
0448A8 0E 0A       0046*       ld c,c_green
0448AA CD 07 14 04 0047*       call vdu_gcol
0448AE 01 00 00 00 0048*       ld bc,0
0448B2 FD 4E 02    0049*       ld c,(iy+sprite_x+1)
0448B5 FD 46 03    0050*       ld b,(iy+sprite_x+2)
0448B8 11 00 00 00 0051*       ld de,0
0448BC FD 5E 05    0052*       ld e,(iy+sprite_y+1)
0448BF FD 56 06    0053*       ld d,(iy+sprite_y+2)
0448C2 21 00 00 00 0054*       ld hl,0 ; clear hlu and h
0448C6 FD 6E 1E    0055*       ld l,(iy+sprite_dim_x)
0448C9 09          0056*       add hl,bc ; hl = x1
0448CA E5          0057*       push hl ; save x1
0448CB 21 00 00 00 0058*       ld hl,0 ; clear hlu and h
0448CF FD 6E 1F    0059*       ld l,(iy+sprite_dim_y)
0448D2 19          0060*       add hl,de ; hl = y1
0448D3 DD E1       0061*       pop ix ; ix = x1 (was hl)
0448D5 E5          0062*       push hl
0448D6 FD E1       0063*       pop iy ; iy = y1
0448D8 CD 4A 19 04 0064*       call vdu_plot_rf
0448DC FD E1       0065*       pop iy
0448DE DD E1       0066*       pop ix
0448E0 C9          0067*       ret
0448E1             0068*   ; end collision_draw_hitboxes
0448E1             0069*   
0448E1             0070*   ; check_collision:
0448E1             0071*   ; Detects collision using bounding box method.
0448E1             0072*   ; Inputs:
0448E1             0073*   ;   IX -> Sprite/Tile table for Collider A
0448E1             0074*   ;   IY -> Sprite/Tile table for Collider B
0448E1             0075*   ; Outputs:
0448E1             0076*   ;   a = 0, zero flag set, positive sign, carry reset -> Collision detected
0448E1             0077*   ;   a = -1, zero flag reset, negative sign, carry set -> No collision detected
0448E1             0078*   ; Destroys: HL, DE, AF
0448E1             0079*   check_collision:
0448E1             0080*   check_collision_box:
0448E1             0081*   ; Test 1: (ay + ah) - by < 0
0448E1 21 00 00 00 0082*       ld hl,0                     ; Clear hlu
0448E5 DD 6E 05    0083*       ld l,(ix+sprite_y+1)        ; Load ay integer part low byte
0448E8 DD 66 06    0084*       ld h,(ix+sprite_y+2)        ; Load ay integer part high byte
0448EB 11 00 00 00 0085*       ld de,0                     ; Clear deu and d
0448EF DD 5E 1F    0086*       ld e,(ix+sprite_dim_y)      ; Load ah
0448F2 19          0087*       add hl,de                   ; (ay + ah)
0448F3 FD 5E 05    0088*       ld e,(iy+sprite_y+1)        ; Load by integer part low byte
0448F6 FD 56 06    0089*       ld d,(iy+sprite_y+2)        ; Load by integer part high byte
0448F9 AF          0090*       xor a                       ; Clear carry
0448FA ED 52       0091*       sbc hl,de                   ; (ay + ah) - by
0448FC FA 5F 49 04 0092*       jp m,@not_collision         ; No collision if negative
044900             0093*   
044900             0094*   ; Test 2: ay - (by + bh) < 0
044900 21 00 00 00 0095*       ld hl,0                     ; Clear hlu
044904 FD 6E 05    0096*       ld l,(iy+sprite_y+1)        ; Load by integer part low byte
044907 FD 66 06    0097*       ld h,(iy+sprite_y+2)        ; Load by integer part high byte
04490A 11 00 00 00 0098*       ld de,0                     ; Clear deu and d
04490E FD 5E 1F    0099*       ld e,(iy+sprite_dim_y)      ; Load bh
044911 19          0100*       add hl,de                   ; (by + bh)
044912 DD 5E 05    0101*       ld e,(ix+sprite_y+1)        ; Load ay integer part low byte
044915 DD 56 06    0102*       ld d,(ix+sprite_y+2)        ; Load ay integer part high byte
044918 AF          0103*       xor a                       ; Clear carry
044919 ED 52       0104*       sbc hl,de                   ; (by + bh) - ay
04491B FA 5F 49 04 0105*       jp m,@not_collision         ; No collision if negative
04491F             0106*   
04491F             0107*   ; Test 3: (ax + aw) - bx < 0
04491F 21 00 00 00 0108*       ld hl,0                     ; Clear hlu
044923 DD 6E 02    0109*       ld l,(ix+sprite_x+1)        ; Load ax integer part low byte
044926 DD 66 03    0110*       ld h,(ix+sprite_x+2)        ; Load ax integer part high byte
044929 11 00 00 00 0111*       ld de,0                     ; Clear deu and d
04492D DD 5E 1E    0112*       ld e,(ix+sprite_dim_x)      ; Load aw
044930 19          0113*       add hl,de                   ; (ax + aw)
044931 FD 5E 02    0114*       ld e,(iy+sprite_x+1)        ; Load bx integer part low byte
044934 FD 56 03    0115*       ld d,(iy+sprite_x+2)        ; Load bx integer part high byte
044937 AF          0116*       xor a                       ; Clear carry
044938 ED 52       0117*       sbc hl,de                   ; (ax + aw) - bx
04493A FA 5F 49 04 0118*       jp m,@not_collision         ; No collision if negative
04493E             0119*   
04493E             0120*   ; Test 4: ax - (bx + bw) < 0
04493E 21 00 00 00 0121*       ld hl,0                     ; Clear hlu
044942 FD 6E 02    0122*       ld l,(iy+sprite_x+1)        ; Load bx integer part low byte
044945 FD 66 03    0123*       ld h,(iy+sprite_x+2)        ; Load bx integer part high byte
044948 11 00 00 00 0124*       ld de,0                     ; Clear deu and d
04494C FD 5E 1E    0125*       ld e,(iy+sprite_dim_x)      ; Load bw
04494F 19          0126*       add hl,de                   ; (bx + bw)
044950 DD 5E 02    0127*       ld e,(ix+sprite_x+1)        ; Load ax integer part low byte
044953 DD 56 03    0128*       ld d,(ix+sprite_x+2)        ; Load ax integer part high byte
044956 AF          0129*       xor a                       ; Clear carry
044957 ED 52       0130*       sbc hl,de                   ; (bx + bw) - ax
044959 FA 5F 49 04 0131*       jp m,@not_collision         ; No collision if negative
04495D             0132*   
04495D             0133*   ; If all tests pass, collision is detected
04495D             0134*   @is_collision:
04495D AF          0135*       xor a                       ; Clear accumulator and flags (a = 0)
04495E C9          0136*       ret                         ; Return with zero flag set
04495F             0137*   
04495F             0138*   ; No collision detected
04495F             0139*   @not_collision:
04495F 3D          0140*       dec a                       ; Set a to -1
044960 C9          0141*       ret                         ; Return with carry set
044961             0142*   ; End check_collision_box
044961             0143*   
044961             0144*   
044961             0145*   ; this routine detects collisions between two collidable objects,
044961             0146*   ; which can include sprites, active tiles, or any screen coordinate
044961             0147*   ; which has been set up with a sprite table structure that includes dim_x
044961             0148*   ; representing the radius of the collidable object
044961             0149*   ; inputs: ix and iy point to the colliding objects' sprite/tile table records
044961             0150*   ; outputs: uh.l = distance - sum of radii
044961             0151*   ;          zero flag set if collision detected
044961             0152*   ;          dx168 and dy168 are also populated with the signed displacements
044961             0153*   ; destroys: everything except indexes
044961             0154*   ; check_collision:
044961             0155*   check_collision_cartesian:
044961             0156*   ; compute dx = x1-x0
044961 DD 27 01    0157*       ld hl,(ix+sprite_x)
044964 FD 17 01    0158*       ld de,(iy+sprite_x)
044967 AF          0159*       xor a ; clear carry
044968 ED 52       0160*       sbc hl,de
04496A 22 77 07 04 0161*       ld (dx168),hl ; dx to scratch
04496E             0162*   ; compute dy = y1-y0
04496E DD 27 04    0163*       ld hl,(ix+sprite_y)
044971 FD 17 04    0164*       ld de,(iy+sprite_y)
044974 AF          0165*       xor a ; clear carry
044975 ED 52       0166*       sbc hl,de ; hl = dy
044977 22 7D 07 04 0167*       ld (dy168),hl ; dy to scratch
04497B             0168*   ; compute euclidean distance between centers
04497B CD 83 07 04 0169*       call distance168 ; uh.l = distance
04497F             0170*   ; check for overlap by summing half the radii
04497F DD 7E 1E    0171*       ld a,(ix+sprite_dim_x)
044982 CB 3F       0172*       srl a ; divide by 2
044984 FD 5E 1E    0173*       ld e,(iy+sprite_dim_x)
044987 CB 3B       0174*       srl e ; divide by 2
044989 83          0175*       add a,e
04498A 11 00 00 00 0176*       ld de,0 ; clear deu and e
04498E 57          0177*       ld d,a ; ud.e = sum of radii
04498F B7          0178*       or a ; clear carry
044990 ED 52       0179*       sbc hl,de ; uh.l = distance - sum of radii
044992 C8          0180*       ret z ; return collision
044993 F0          0181*       ret p ; return no collision
044994 AF          0182*       xor a ; return collision
044995 C9          0183*       ret
044996             0184*   ; end check_collision_cartesian
044996             0185*   
044996             0186*   ; check collisions of a sprite or tile against a sprite group
044996             0187*   ; inputs: iy = pointer to sprite or tile record being checked
044996             0188*   ;         ix = pointer to sprite group, b = number of records in sprite group
044996             0189*   check_sprite_group_collisions:
044996             0190*   @collision_loop:
044996 DD 22 63 48 0191*       ld (collision_table_pointer),ix ; update table pointer
       04          
04499B C5          0192*       push bc ; backup loop counter
04499C             0193*   ; check sprite_collisions sprite_alive flag to see if sprite is active
04499C DD CB 1D 76 0194*       bit sprite_alive,(ix+sprite_collisions)
0449A0 CA B6 49 04 0195*       jp z,@next_record ; not alive so skip to next record
0449A4             0196*   ; sprite alive so check for collision
0449A4 CD E1 48 04 0197*       call check_collision
0449A8 C2 B6 49 04 0198*       jp nz,@next_record ; no collision
0449AC             0199*   ; set sprite_just_died flag for each entity and return to caller
0449AC C1          0200*       pop bc ; dummy pop to balance stack
0449AD DD CB 1D FE 0201*       set sprite_just_died,(ix+sprite_collisions)
0449B1 FD CB 1D FE 0202*       set sprite_just_died,(iy+sprite_collisions)
0449B5 C9          0203*       ret
0449B6             0204*   @next_record:
0449B6 C1          0205*       pop bc ; get back our loop counter
0449B7 ED 32 40    0206*       lea ix,ix+table_record_size
0449BA 10 DA       0207*       djnz @collision_loop ; loop until we've checked all the records
0449BC             0208*   ; return to caller
0449BC AF          0209*       xor a
0449BD 3C          0210*       inc a ; resets sign flag and a to non-zero indicating no collision
0449BE C9          0211*       ret
0449BF             0212*   ; end check_sprite_group_collisions
0449BF             0213*   
0449BF             0214*   check_enemy_collision_laser: ; check for collisions with laser
0449BF DD 21 1A 88 0215*       ld ix,player_lasers_begin
       04          
0449C4 06 04       0216*       ld b,player_lasers_max
0449C6 CD 96 49 04 0217*       call check_sprite_group_collisions
0449CA C9          0218*       ret
0449CB             0219*   ; end check_enemy_collision_laser
0449CB             0220*   
0449CB             0221*   check_enemy_collision_player: ; check for collisions with player
0449CB DD 21 1A 89 0222*       ld ix,player_begin
       04          
0449D0 CD E1 48 04 0223*       call check_collision
0449D4 C0          0224*       ret nz ; no collision so nothing to do
0449D5 DD CB 1D FE 0225*       set sprite_just_died,(ix+sprite_collisions)
0449D9 FD CB 1D FE 0226*       set sprite_just_died,(iy+sprite_collisions)
0449DD AF          0227*       xor a ; signal collision detected
0449DE C9          0228*       ret
0449DF             0229*   ; end check_enemy_collision_player
0449DF             0050        include "enemies.inc"
0449DF 3F 4A 04    0001*   enemies_state: dl enemies_alive
0449E2             0002*   enemies_fault_bad_state: equ 0
0449E2 00          0003*   enemies_fault_flags: db 0 ; latched fail-closed diagnostics
0449E3             0004*   
0449E3             0005*   do_enemies:
0449E3 2A DF 49 04 0006*       ld hl,(enemies_state)
0449E7 CD 05 4A 04 0007*       call enemies_state_pointer_valid
0449EB DA FE 49 04 0008*       jp c,@dispatch
0449EF 21 E2 49 04 0009*       ld hl,enemies_fault_flags
0449F3 CB C6       0010*       set enemies_fault_bad_state,(hl)
0449F5 21 4C 4A 04 0011*       ld hl,enemies_dead ; actor-local fail-closed state for the next tick
0449F9 22 DF 49 04 0012*       ld (enemies_state),hl
0449FD C9          0013*       ret
0449FE             0014*   @dispatch:
0449FE             0015*       CALL_HL
                       M1 Args: none
0449FE 01 04 4A 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
044A02 C5          0002*M1     push bc ; which constitutes the return address
044A03 E9          0003*M1     jp (hl) ; Jump to the address in HL
044A04 C9          0016*       ret
044A05             0017*   
044A05             0018*   ; Exact stabilization whitelist for writable legacy enemy-state pointers.
044A05             0019*   enemies_state_pointer_valid:
044A05 11 3F 4A 04 0020*       ld de,enemies_alive
044A09 CD 39 4A 04 0021*       call @matches
044A0D CA 37 4A 04 0022*       jp z,@valid
044A11 11 4B 4A 04 0023*       ld de,enemies_despawning
044A15 CD 39 4A 04 0024*       call @matches
044A19 CA 37 4A 04 0025*       jp z,@valid
044A1D 11 4C 4A 04 0026*       ld de,enemies_dead
044A21 CD 39 4A 04 0027*       call @matches
044A25 CA 37 4A 04 0028*       jp z,@valid
044A29 11 4D 4A 04 0029*       ld de,enemies_respawning
044A2D CD 39 4A 04 0030*       call @matches
044A31 CA 37 4A 04 0031*       jp z,@valid
044A35 AF          0032*       xor a
044A36 C9          0033*       ret
044A37             0034*   @valid:
044A37 37          0035*       scf
044A38 C9          0036*       ret
044A39             0037*   @matches:
044A39 E5          0038*       push hl
044A3A B7          0039*       or a
044A3B ED 52       0040*       sbc hl,de
044A3D E1          0041*       pop hl
044A3E C9          0042*       ret
044A3F             0043*   ; end enemies_state_pointer_valid
044A3F             0044*   
044A3F             0045*   enemies_alive:
044A3F FD 21 5A 89 0046*       ld iy,enemy_sprites_begin
       04          
044A44 06 07       0047*       ld b,table_num_enemy_records
044A46 CD 7D 69 04 0048*       call move_sprite_group
044A4A C9          0049*       ret
044A4B             0050*   
044A4B             0051*   enemies_despawning:
044A4B C9          0052*       ret
044A4C             0053*   
044A4C             0054*   enemies_dead:
044A4C C9          0055*       ret
044A4D             0056*   
044A4D             0057*   enemies_respawning:
044A4D C9          0058*       ret
044A4E             0051        include "enemy_fireball.inc"
044A4E             0001*   speed_fireball: equ 4*256 ; 6 pixels per frame 16.8 fixed
044A4E             0002*   fireballs_max: equ 4
044A4E             0003*   
044A4E             0004*   fireball_defaults:
044A4E 03          0005*       db enemy_projectile     ; type
044A4F 0E 01 00    0006*       dl BUF_FIREBALL_2_000   ; base_bufferId
044A52 A0 4A 04    0007*       dl move_enemy_fireball  ; move_program
044A55 40          0008*       db %01000000            ; collisions bit 6 signals sprite alive
044A56 10          0009*       db 16                   ; dim_x
044A57 10          0010*       db 16                   ; dim_y
044A58 20          0011*       db 32                   ; num_orientations
044A59 02          0012*       db 2                    ; num_animations
044A5A 00          0013*       db 0                    ; animation
044A5B 08          0014*       db 8                    ; animation_timer
044A5C 00          0015*       db 0                    ; move_timer
044A5D 00          0016*       db 0                    ; move_step
044A5E 00          0017*       db 0                    ; points
044A5F FE          0018*       db -2                   ; shield_damage
044A60 00          0019*       db 0                    ; frame
044A61             0020*   
044A61             0021*   enemy_spawn_fireball:
044A61 21 4E 4A 04 0022*       ld hl,fireball_defaults
044A65 DD 21 1A 8A 0023*       ld ix,fireballs_base
       04          
044A6A 06 04       0024*       ld b,fireballs_max
044A6C CD D4 78 04 0025*       call spawn_sprite_from_tile
044A70 D0          0026*       ret nc ; no carry means no free sprite slots, so we go home
044A71             0027*   ; other specific initialization
044A71             0028*   ; ------------------------------------------------
044A71             0029*   ; copy sprite heading and component velocities from targeting_computer
044A71 2A D6 6F 04 0030*       ld hl,(Bearing_t)
044A75 11 00 80 00 0031*       ld de,128*256 ; rotate 128 degrees
044A79 19          0032*       add hl,de
044A7A DD 2F 10    0033*       ld (ix+sprite_heading),hl
044A7D 2A DF 6F 04 0034*       ld hl,(Vp_x)
044A81 DD 2F 07    0035*       ld (ix+sprite_xvel),hl
044A84 2A E2 6F 04 0036*       ld hl,(Vp_y)
044A88 DD 2F 0A    0037*       ld (ix+sprite_yvel),hl
044A8B             0038*   ; move projectile one frame's distance so it isn't drawn right over turret
044A8B DD 27 01    0039*       ld hl,(ix+sprite_x)
044A8E DD 17 07    0040*       ld de,(ix+sprite_xvel)
044A91 19          0041*       add hl,de
044A92 DD 2F 01    0042*       ld (ix+sprite_x),hl
044A95 DD 27 04    0043*       ld hl,(ix+sprite_y)
044A98 DD 17 0A    0044*       ld de,(ix+sprite_yvel)
044A9B 19          0045*       add hl,de
044A9C DD 2F 04    0046*       ld (ix+sprite_y),hl
