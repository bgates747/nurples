042132             0034*   move_enemy_seeker_orbit:
042132             0035*   ; compute x coordinate of orbit origin based on sprite id
042132 3E 05       0036*       ld a,seeker_min_sprite_id
042134 FD 96 00    0037*       sub (iy+sprite_id)
042137 6F          0038*       ld l,a
042138 26 55       0039*       ld h,85 ; 1/3 the playing field width
04213A ED 6C       0040*       mlt hl
04213C 3E 40       0041*       ld a,64 ; 1/4 of the playing field width
04213E 85          0042*       add a,l ; a = x coordinate of orbit origin
04213F FD 77 25    0043*       ld (iy+sprite_move_step),a ; as good a place as any to store it
042142             0044*   ; initialize orbit angle
042142 AF          0045*       xor a
042143 FD 77 13    0046*       ld (iy+sprite_orientation),a
042146             0047*   ; ; initialize move timer
042146             0048*   ;     inc a ; set to 1
042146             0049*   ;     ld (iy+sprite_move_timer),a
042146             0050*   ; init done, so update move program
042146 21 4D 21 04 0051*       ld hl,@stage1 ; update move program pointer
04214A FD 2F 1A    0052*       ld (iy+sprite_move_program),hl
04214D             0053*   ; fall through to @stage1
04214D             0054*   @stage1:
04214D             0055*   ; ; check whether time to update orbit angle
04214D             0056*   ;     dec (iy+sprite_move_timer)
04214D             0057*   ;     jp nz,@F ; not time to change so simply movethe sprite on the current heading
04214D             0058*   ;     inc (iy+sprite_move_timer) ; reset timer to 1
04214D             0059*   ; update the target coordinates based on orbit angle and radius
04214D FD 34 13    0060*       inc (iy+sprite_orientation) ; increment angle
042150 21 00 00 00 0061*       ld hl,0 ; clear hlu and l
042154 FD 66 13    0062*       ld h,(iy+sprite_orientation) ; uh.l = angle
042157 11 00 80 00 0063*       ld de,128*256 ; ud.e = radius
04215B CD F0 06 04 0064*       call polar_to_cartesian ; u.bc, u.de = x,y offsets
04215F FD 7E 25    0065*       ld a,(iy+sprite_move_step) ; x coordinate of orbit origin
042162 80          0066*       add a,b ; add x offset
042163 01 00 00 00 0067*       ld bc,0 ; bcu and c
042167 47          0068*       ld b,a ; ub.c = x
042168 21 00 A8 00 0069*       ld hl,336/2*256
04216C 19          0070*       add hl,de
04216D EB          0071*       ex de,hl ; ud.e = y
04216E CD 41 86 04 0072*       call bearing_to_coord ; uh.l = angle to coordinate
042172 FD 2F 10    0073*       ld (iy+sprite_heading),hl ; save angle as heading
042175             0074*   ; compute component velocities, save them in sprite record, and move the sprite
042175 CD FE 82 04 0075*       call sprite_compute_velocities
042179             0076*   @@:
042179 CD 5D 82 04 0077*       call move_sprite ; move the sprite
04217D C3 81 21 04 0078*       jp move_enemy_seeker
