04803C             0469*   ; print bytes from an address to the screen in binary format
04803C             0470*   ; with the bits of each byte in reverse order (lsb first)
04803C             0471*   ; inputs: hl = address of first byte to print, a = number of bytes to print
04803C             0472*   ; outputs: values of each byte printed to screen separated by spaces
04803C             0473*   ; destroys: nothing
04803C             0474*   dumpMemoryBinRev:
04803C             0475*   ; save all registers to the stack
04803C F5          0476*       push af
04803D C5          0477*       push bc
04803E D5          0478*       push de
04803F E5          0479*       push hl
048040 DD E5       0480*       push ix
