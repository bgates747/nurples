041482             0199*   ; outputs; nothing
041482             0200*   ; destroys: a might make it out alive
041482             0201*   vdu_set_gfx_viewport:
041482 ED 43 A2 14 0202*       ld (@x0),bc
       04          
041487 FD 22 A4 14 0203*       ld (@y1),iy
       04          
04148C DD 22 A6 14 0204*   	ld (@x1),ix
       04          
041491 ED 53 A8 14 0205*   	ld (@y0),de
       04          
041496 21 A1 14 04 0206*   	ld hl,@cmd
04149A 01 09 00 00 0207*   	ld bc,@end-@cmd
04149E 5B DF       0208*   	rst.lil $18
0414A0 C9          0209*   	ret
0414A1 18          0210*   @cmd:   db 24 ; set graphics viewport command
0414A2 00 00       0211*   @x0: 	dw 0x0000 ; set by bc
0414A4 00 00       0212*   @y1: 	dw 0x0000 ; set by iy
0414A6 00 00       0213*   @x1: 	dw 0x0000 ; set by ix
0414A8 00 00       0214*   @y0: 	dw 0x0000 ; set by de
0414AA 00          0215*   @end:   db 0x00	  ; padding
0414AB             0216*   
0414AB             0217*   ; SCREEN MODES
0414AB             0218*   ; ===============================
0414AB             0219*   ; Mode  Horz  Vert  Cols  Refresh
0414AB             0220*   ; ---   ----  ----  ----  -------
0414AB             0221*   ; 11    320   240   2     60hz
0414AB             0222*   ; 139   320   240   2     60hz
0414AB             0223*   ; 23    512   384   2     60hz
0414AB             0224*   ; 151   512   384   2     60hz
0414AB             0225*   ; 6     640   240   2     60hz
0414AB             0226*   ; 134   640   240   2     60hz
0414AB             0227*   ; 2     640   480   2     60hz
0414AB             0228*   ; 130   640   480   2     60hz
0414AB             0229*   ; 17    800   600   2     60hz
0414AB             0230*   ; 145   800   600   2     60hz
0414AB             0231*   ; 18    1024  768   2     60hz
0414AB             0232*   ; 146   1024  768   2     60hz
0414AB             0233*   ; ---   ----  ----  ----  -------
0414AB             0234*   ; 10    320   240   4     60hz
0414AB             0235*   ; 138   320   240   4     60hz
0414AB             0236*   ; 22    512   384   4     60hz
0414AB             0237*   ; 150   512   384   4     60hz
0414AB             0238*   ; 5     640   240   4     60hz
0414AB             0239*   ; 133   640   240   4     60hz
0414AB             0240*   ; 1     640   480   4     60hz
0414AB             0241*   ; 129   640   480   4     60hz
0414AB             0242*   ; 16    800   600   4     60hz
0414AB             0243*   ; 19    1024  768   4     60hz
0414AB             0244*   ; ---   ----  ----  ----  -------
0414AB             0245*   ; 9     320   240   16    60hz
0414AB             0246*   ; 137   320   240   16    60hz
0414AB             0247*   ; 21    512   384   16    60hz
0414AB             0248*   ; 149   512   384   16    60hz
0414AB             0249*   ; 4     640   240   16    60hz
0414AB             0250*   ; 132   640   240   16    60hz
0414AB             0251*   ; 0     640   480   16    60hz
0414AB             0252*   ; 7     n/a   n/a   16    60hz
0414AB             0253*   ; ---   ----  ----  ----  -------
0414AB             0254*   ; 8     320   240   64    60hz
0414AB             0255*   ; 136   320   240   64    60hz
0414AB             0256*   ; 20    512   384   64    60hz
0414AB             0257*   ; 3     640   240   64    60hz
0414AB             0258*   ; ---   ----  ----  ----  -------
0414AB             0259*   vdu_set_screen_mode:
0414AB 32 BB 14 04 0260*   	ld (@arg),a
0414AF 21 BA 14 04 0261*   	ld hl,@cmd
0414B3 01 02 00 00 0262*   	ld bc,@end-@cmd
0414B7 5B DF       0263*   	rst.lil $18
0414B9 C9          0264*   	ret
0414BA 16          0265*   @cmd: db 22 ; set screen mode
0414BB 00          0266*   @arg: db 0  ; screen mode parameter
0414BC             0267*   @end:
0414BC             0268*   
0414BC             0269*   ; get the current screen mode
0414BC             0270*   ; inputs: none
0414BC             0271*   ; outputs: a=screen mode
0414BC             0272*   ; destroys: af, ix
0414BC             0273*   vdu_get_screen_mode:
0414BC             0274*       MOSCALL mos_sysvars
                       M1 Args: function=mos_sysvars 
0414BC 3E 08       0001*M1 			LD	A, function
0414BE 5B CF       0002*M1 			RST.LIL	08h
0414C0 DD 7E 27    0275*       ld a,(IX+sysvar_scrMode)
0414C3 C9          0276*       ret
0414C4             0277*   ; end vdu_get_screen_mode
0414C4             0278*   
0414C4             0279*   ; VDU 23, 0, &C0, n: Turn logical screen scaling on and off *
0414C4             0280*   ; inputs: a is scaling mode, 1=on, 0=off
0414C4             0281*   ; note: default setting on boot is scaling ON
0414C4             0282*   vdu_set_scaling:
0414C4 32 D6 14 04 0283*   	ld (@arg),a
0414C8 21 D3 14 04 0284*   	ld hl,@cmd
0414CC 01 04 00 00 0285*   	ld bc,@end-@cmd
0414D0 5B DF       0286*   	rst.lil $18
0414D2 C9          0287*   	ret
0414D3 17 00 C0    0288*   @cmd: db 23,0,0xC0
0414D6 00          0289*   @arg: db 0  ; scaling on/off
0414D7             0290*   @end:
0414D7             0291*   
0414D7             0292*   ; VDU 23, 27, &20, bufferId; : Select bitmap (using a buffer ID)
0414D7             0293*   ; inputs: hl=bufferId
0414D7             0294*   vdu_buff_select:
0414D7 22 E9 14 04 0295*   	ld (@bufferId),hl
0414DB 21 E6 14 04 0296*   	ld hl,@cmd
0414DF 01 05 00 00 0297*   	ld bc,@end-@cmd
0414E3 5B DF       0298*   	rst.lil $18
0414E5 C9          0299*   	ret
0414E6 17 1B 20    0300*   @cmd: db 23,27,0x20
0414E9 00 00       0301*   @bufferId: dw 0x0000
0414EB 00          0302*   @end: db 0x00 ; padding
0414EC             0303*   
0414EC             0304*   ; VDU 23, 27, &21, w; h; format: Create bitmap from selected buffer
0414EC             0305*   ; inputs: a=format; bc=width; de=height
0414EC             0306*   ; prerequisites: buffer selected by vdu_bmp_select or vdu_buff_select
0414EC             0307*   ; formats: https://agonconsole8.github.io/agon-docs/VDP---Bitmaps-API.html
0414EC             0308*   ; 0 	RGBA8888 (4-bytes per pixel)
0414EC             0309*   ; 1 	RGBA2222 (1-bytes per pixel)
0414EC             0310*   ; 2 	Mono/Mask (1-bit per pixel)
0414EC             0311*   ; 3 	Reserved for internal use by VDP (“native” format)
0414EC             0312*   vdu_bmp_create:
0414EC ED 43 08 15 0313*       ld (@width),bc
       04          
0414F1 ED 53 0A 15 0314*       ld (@height),de
       04          
0414F6 32 0C 15 04 0315*       ld (@fmt),a
0414FA 21 05 15 04 0316*   	ld hl,@cmd
0414FE 01 08 00 00 0317*   	ld bc,@end-@cmd
041502 5B DF       0318*   	rst.lil $18
041504 C9          0319*   	ret
041505 17 1B 21    0320*   @cmd:       db 23,27,0x21
041508 00 00       0321*   @width:     dw 0x0000
04150A 00 00       0322*   @height:    dw 0x0000
04150C 00          0323*   @fmt:       db 0x00
04150D             0324*   @end:
04150D             0325*   
04150D             0326*   ; load an rgba2222 image file to a working buffer and make it an rgba8888 bitmap in a target buffer
04150D             0327*   ; inputs: bc,de image width,height ; hl = targetBufferId ; ix = file size ; iy = pointer to filename
04150D             0328*   vdu_load_img_rgba2_to_8:
04150D             0329*   ; backup the target buffer id and image dimensions
04150D E5          0330*       push hl
04150E D5          0331*       push de
04150F C5          0332*       push bc
041510             0333*   ; load the rgba2 image to working buffer 65534
041510 21 FE FF 00 0334*       ld hl,65534 ; temporary working buffer id
041514 CD 1D 16 04 0335*   	call vdu_load_buffer_from_file
041518             0336*   ; restore the image dimensions and target buffer id
041518 C1          0337*       pop bc
041519 D1          0338*       pop de
04151A E1          0339*       pop hl
04151B D0          0340*       ret nc ; leave the cleared target untouched when the source cannot open
04151C             0341*   ; fall through to vdu_rgba2_to_8
04151C             0342*   
04151C             0343*   ; https://discord.com/channels/1158535358624039014/1158536711148675072/1257757461729771771
04151C             0344*   ; ok, so the "expand bitmap" can be used, when coupled with a "reverse" - the expanded bitmap _doesn't_ come out "right" otherwise, cos of endian-ness
04151C             0345*   ; the "expand bitmap" command is:
04151C             0346*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
04151C             0347*   ; and then to reverse the byte order to fix endian-ness:
04151C             0348*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
04151C             0349*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
04151C             0350*   ; VDU 23,27,&20,targetBufferID%;
04151C             0351*   ; VDU 23,27,&21,width%;height%;0
04151C             0352*   ; -------------------------------------------------------------------
04151C             0353*   ; inputs: bc,de image width,height ; hl = targetBufferId
04151C             0354*   ; prerequisites: rgba2 image data loaded into workingBufferId 65534
04151C             0355*   vdu_rgba2_to_8:
04151C             0356*   ; load the image dimensions and buffer id parameters
04151C ED 43 78 15 0357*       ld (@width),bc
       04          
041521 ED 53 7A 15 0358*       ld (@height),de
       04          
041526 22 5D 15 04 0359*       ld (@bufferId0),hl
04152A 22 6A 15 04 0360*       ld (@bufferId2),hl
04152E 22 73 15 04 0361*       ld (@bufferId1),hl
041532             0362*   ; clean up bytes that got stomped on by the ID loads
041532 3E 48       0363*       ld a,0x48
041534 32 5F 15 04 0364*       ld (@bufferId0+2),a
041538 3E 17       0365*       ld a,23
04153A 32 75 15 04 0366*       ld (@bufferId1+2),a
04153E 3E 18       0367*       ld a,24
041540 32 6C 15 04 0368*       ld (@bufferId2+2),a
041544 AF          0369*       xor a
041545 32 7C 15 04 0370*       ld (@height+2),a
041549             0371*   ; send the vdu command strings
041549 21 54 15 04 0372*       ld hl,@beg
04154D 01 29 00 00 0373*       ld bc,@end-@beg
041551 5B DF       0374*       rst.lil $18
041553 C9          0375*       ret
041554             0376*   @beg:
041554             0377*   ; Command 14: Consolidate blocks in a buffer
041554             0378*   ; VDU 23, 0, &A0, bufferId; 14
041554 17 00 A0    0379*       db 23,0,0xA0
041557 FE FF       0380*       dw 65534 ; workingBufferId
041559 0E          0381*       db 14 ; consolidate blocks
04155A             0382*   ; the "expand bitmap" command is:
04155A             0383*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
04155A 17 00 A0    0384*       db 23,0,0xA0
04155D 00 00       0385*   @bufferId0: dw 0x0000 ; targetBufferId
04155F 48          0386*       db 0x48 ; given as decimal command 72 in the docs
041560 02          0387*       db 2 ; options mask: %00000011 is the number of bits per pixel in the source bitmap
041561 FE FF       0388*       dw 65534 ; sourceBufferId
041563 00 7F BF FF 0389*       db 0x00,0x7F,0xBF,0xFF ; expanding to bytes by bit-shifting?
041567             0390*   ; reverse the byte order to fix endian-ness:
041567             0391*   ; Command 24: Reverse the order of data of blocks within a buffer
041567             0392*   ; VDU 23, 0, &A0, bufferId; 24, options, [valueSize;] [chunkSize;]
041567             0393*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
041567 17 00 A0    0394*       db 23,0,0xA0
04156A 00 00       0395*   @bufferId2:    dw 0x0000 ; targetBufferId
04156C 18          0396*       db 24 ; reverse byte order
04156D 04          0397*       db 4 ; option: Reverse data of the value size within chunk of data of the specified size
04156E 04 00       0398*       dw 4 ; size (4 bytes)
041570             0399*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
041570             0400*   ; VDU 23,27,&20,targetBufferID%;
041570 17 1B 20    0401*       db 23,27,0x20 ; select bitmap
041573 00 00       0402*   @bufferId1: dw 0x0000 ; targetBufferId
041575             0403*   ; VDU 23,27,&21,width%;height%;0
041575 17 1B 21    0404*       db 23,27,0x21 ; create bitmap from buffer
041578 00 00       0405*   @width: dw 0x0000
04157A 00 00       0406*   @height: dw 0x0000
04157C 00          0407*       db 0x00 ; rgba8888 format
04157D             0408*   @end:
04157D             0409*   
04157D             0410*   ; scratch variables
04157D 00 00 00    0411*   bufferId0: dl 0x000000
041580 00 00 00    0412*   bufferId1: dl 0x000000
041583             0413*   
041583             0414*   ; load a vdu buffer from local memory
041583             0415*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
041583             0416*   vdu_load_buffer:
041583 ED 43 AC 15 0417*       ld (@length),bc
       04          
041588 D5          0418*       push de ; save data pointer
041589             0419*   ; send the vdu command string
041589 7D          0420*       ld a,l
04158A 32 A9 15 04 0421*       ld (@bufferId),a
04158E 7C          0422*       ld a,h
04158F 32 AA 15 04 0423*       ld (@bufferId+1),a
041593 21 A6 15 04 0424*       ld hl,@cmd
041597 01 08 00 00 0425*       ld bc,@end-@cmd
04159B 5B DF       0426*       rst.lil $18
04159D             0427*   ; send the buffer data
04159D E1          0428*       pop hl ; pointer to data
04159E ED 4B AC 15 0429*       ld bc,(@length)
       04          
0415A3 5B DF       0430*       rst.lil $18 ; send it
0415A5 C9          0431*       ret
0415A6             0432*   ; Upload data :: VDU 23, 0 &A0, bufferId; 0, length; <buffer-data>
0415A6 17 00 A0    0433*   @cmd:       db 23,0,0xA0
0415A9 00 00       0434*   @bufferId:	dw 0x0000
0415AB 00          0435*   		    db 0 ; load buffer
0415AC 00 00       0436*   @length:	dw 0x0000
0415AE 00          0437*   @end: db 0 ; padding
0415AF             0438*   
0415AF             0439*   ; Command 14: Consolidate blocks in a buffer
0415AF             0440*   vdu_consolidate_buffer:
0415AF             0441*   ; set parameters for vdu call
0415AF 7D          0442*       ld a,l
0415B0 32 C7 15 04 0443*       ld (@bufferId),a
0415B4 7C          0444*       ld a,h
0415B5 32 C8 15 04 0445*       ld (@bufferId+1),a
0415B9 21 C4 15 04 0446*       ld hl,@beg
0415BD 01 06 00 00 0447*       ld bc,@end-@beg
0415C1 5B DF       0448*       rst.lil $18
0415C3 C9          0449*       ret
0415C4             0450*   ; VDU 23, 0, &A0, bufferId; 14
0415C4 17 00 A0    0451*   @beg: db 23,0,0xA0
0415C7 00 00       0452*   @bufferId: dw 0x0000
0415C9 0E          0453*              db 14
0415CA             0454*   @end:
0415CA             0455*   
0415CA             0456*   ; Convert a consolidated buffer to an explicitly rated audio sample.
0415CA             0457*   ; This is a dependency of the canonical AGNB API's dormant audio entry point;
0415CA             0458*   ; Purple Nurples currently creates no audio container and does not call it.
0415CA             0459*   ; inputs: HL=bufferId, A=base format (0 signed, 1 unsigned), DE=sample rate
0415CA             0460*   vdu_buffer_to_sound:
0415CA 22 EA 15 04 0461*       ld (@bufferId),hl
0415CE C6 08       0462*       add a,8
0415D0 32 EC 15 04 0463*       ld (@format),a
0415D4 ED 53 ED 15 0464*       ld (@sampleRate),de
       04          
0415D9 21 E4 15 04 0465*       ld hl,@cmd
0415DD 01 0B 00 00 0466*       ld bc,@end-@cmd
0415E1 5B DF       0467*       rst.lil $18
0415E3 C9          0468*       ret
0415E4 17 00 85    0469*   @cmd:        db 23,0,$85
0415E7 00 05 02    0470*                db 0,5,2
0415EA 00 00       0471*   @bufferId:   dw 0
0415EC 00          0472*   @format:     db 0
0415ED 00 00       0473*   @sampleRate: dw 0
0415EF             0474*   ; Native ADL stores three bytes from DE. This byte absorbs DEU outside the VDU
0415EF             0475*   ; packet, matching the canonical dependency implementation.
0415EF 00          0476*   @end:        db 0
0415F0             0477*   
0415F0             0478*   ; load an image file to a buffer and make it a bitmap
0415F0             0479*   ; inputs: a = image type ; bc,de image width,height ; hl = bufferId ; ix = file size ; iy = pointer to filename
0415F0             0480*   vdu_load_img:
0415F0             0481*   ; back up image type and dimension parameters
0415F0 22 7D 15 04 0482*       ld (bufferId0),hl
0415F4 F5          0483*       push af
0415F5 C5          0484*   	push bc
0415F6 D5          0485*   	push de
0415F7             0486*   ; load the image
0415F7 CD 1D 16 04 0487*   	call vdu_load_buffer_from_file
0415FB DA 04 16 04 0488*       jp c,@loaded
0415FF             0489*   ; balance the saved arguments and fail without creating an empty bitmap
0415FF D1          0490*   	pop de
041600 C1          0491*   	pop bc
041601 F1          0492*   	pop af
041602 B7          0493*       or a ; preserve A while reasserting the carry-clear failure contract
041603 C9          0494*       ret
041604             0495*   @loaded:
041604             0496*   ; now make it a bitmap
041604 2A 7D 15 04 0497*       ld hl,(bufferId0)
041608 CD AF 15 04 0498*       call vdu_consolidate_buffer
04160C 2A 7D 15 04 0499*       ld hl,(bufferId0)
041610 CD D7 14 04 0500*       call vdu_buff_select
041614 D1          0501*   	pop de ; image height
041615 C1          0502*   	pop bc ; image width
041616 F1          0503*   	pop af ; image type
041617 CD EC 14 04 0504*   	call vdu_bmp_create
04161B 37          0505*       scf
04161C C9          0506*       ret
04161D             0507*   
04161D             0508*   ; inputs: hl = bufferId; iy = pointer to filename
04161D             0509*   ; outputs: carry set after a complete read/close; carry clear if open failed
04161D             0510*   vdu_load_buffer_from_file:
04161D 22 7D 15 04 0511*       ld (bufferId0),hl
041621             0512*   
041621             0513*   ; clear target buffer
041621 CD CD 17 04 0514*       call vdu_clear_buffer
041625             0515*   
041625             0516*   ; open the file in read mode
041625             0517*   ; Open a file
041625             0518*   ; HLU: Filename
041625             0519*   ;   C: Mode
041625             0520*   ; Returns:
041625             0521*   ;   A: Filehandle, or 0 if couldn't open
041625 FD E5       0522*   	push iy ; pointer to filename
041627 E1          0523*   	pop hl
041628 0E 01       0524*       ld c,fa_read
04162A             0525*       MOSCALL mos_fopen
                       M1 Args: function=mos_fopen 
04162A 3E 0A       0001*M1 			LD	A, function
04162C 5B CF       0002*M1 			RST.LIL	08h
04162E B7          0526*       or a
04162F C8          0527*       ret z ; carry clear: do not read or close the all-files handle zero
041630 32 6D 16 04 0528*       ld (@filehandle),a
041634             0529*   
041634             0530*   @read_file:
041634             0531*   ; Read a block of data from a file
041634             0532*   ;   C: Filehandle
041634             0533*   ; HLU: Pointer to where to write the data to
041634             0534*   ; DEU: Number of bytes to read
041634             0535*   ; Returns:
041634             0536*   ; DEU: Number of bytes read
041634 3A 6D 16 04 0537*       ld a,(@filehandle)
041638 4F          0538*       ld c,a
041639 21 00 E0 B7 0539*       ld hl,filedata
04163D 11 00 20 00 0540*       ld de,8192 ; max we can read into onboard sram at one time
041641             0541*       MOSCALL mos_fread
                       M1 Args: function=mos_fread 
041641 3E 1A       0001*M1 			LD	A, function
041643 5B CF       0002*M1 			RST.LIL	08h
041645             0542*   
041645             0543*   ; test de for zero bytes read
041645 21 00 00 00 0544*       ld hl,0
041649 AF          0545*       xor a ; clear carry
04164A ED 52       0546*       sbc hl,de
04164C CA 62 16 04 0547*       jp z,@close_file
041650             0548*   
041650             0549*   ; load a vdu buffer from local memory
041650             0550*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
041650 2A 7D 15 04 0551*       ld hl,(bufferId0)
041654 D5          0552*       push de ; chunksize
041655 C1          0553*       pop bc
041656 11 00 E0 B7 0554*       ld de,filedata
04165A CD 83 15 04 0555*       call vdu_load_buffer
04165E             0556*   
04165E             0557*   ; read the next block
04165E C3 34 16 04 0558*       jp @read_file
041662             0559*   
041662             0560*   ; close the file
041662             0561*   @close_file:
041662 3A 6D 16 04 0562*       ld a,(@filehandle)
041666 4F          0563*       ld c,a
041667             0564*       MOSCALL mos_fclose
                       M1 Args: function=mos_fclose 
041667 3E 0B       0001*M1 			LD	A, function
041669 5B CF       0002*M1 			RST.LIL	08h
04166B 37          0565*       scf
04166C C9          0566*       ret ; vdu_load_buffer_from_file
04166D             0567*   
04166D 00          0568*   @filehandle: db 0 ; file handle
04166E 00 00 00    0569*   @fil: dl 0 ; pointer to FIL struct
041671             0570*   
041671 00 00 00    0571*   @chunkpointer: dl 0 ; pointer to current chunk
041674             0572*   
