048E2A             0043*   
048E2A             0044*   kill_electrode:
048E2A             0045*   ; activate blank tile bitmap
048E2A 21 76 01 00 0046*       ld hl,BUF_TILE_BLANK
048E2E CD 3A 14 04 0047*       call vdu_buff_select
048E32             0048*   ; save y-coordinate of collision tile
048E32 FD 27 04    0049*       ld hl,(iy+tile_y)
048E35 22 E4 8E 04 0050*       ld (@tile_y),hl
048E39             0051*   ; initialize pointers
048E39 2A F6 89 04 0052*       ld hl,(tile_stack_pointer)
048E3D ED 27       0053*       ld hl,(hl) ; pointer to this tile table record
048E3F E5          0054*       push hl ; save pointer to this tile table record
048E40 DD 21 F3 86 0055*       ld ix,tile_stack ; set ix to first record in table
       04          
048E45             0056*   @check_loop:
048E45 DD 22 E1 8E 0057*       ld (@tile_stack_pointer),ix ; update stack pointer
       04          
048E4A DD 7E 02    0058*       ld a,(ix+2)
048E4D B7          0059*       or a ; will be zero if at end of stack
048E4E CA BA 8E 04 0060*       jp z,@done ; end of stack so we're done
048E52             0061*   ; point ix to tile record
048E52 DD 37 00    0062*       ld ix,(ix) ; ix points to the tile record being checked
048E55             0063*   ; check top bit of tile_type to see if tile is just spawned
048E55 DD CB 16 7E 0064*       bit 7,(ix+tile_type)
048E59 C2 AE 8E 04 0065*       jp nz,@next_record ; if just spawned, skip to next record
048E5D             0066*   ; check sprite_alive bit to see if tile is active
048E5D DD CB 1D 76 0067*       bit sprite_alive,(ix+sprite_collisions)
048E61 C8          0068*       ret z ; end of stack so we're done
048E62             0069*   ; check tile type
048E62 DD 7E 16    0070*       ld a,(ix+tile_type)
048E65 FE 0A       0071*       cp tile_lightning ; check if tile is lightning
048E67 C2 AE 8E 04 0072*       jp nz,@next_record ; if not an electrode, skip to next record
048E6B             0073*   ; check tile position
048E6B FD 2A E1 8E 0074*       ld iy,(@tile_stack_pointer)
       04          
048E70 FD 22 F6 89 0075*       ld (tile_stack_pointer),iy
       04          
048E75 FD 37 00    0076*       ld iy,(iy) ; pointer to tile record to kill
048E78 FD 22 F9 89 0077*       ld (tile_table_pointer),iy
       04          
048E7D DD 27 04    0078*       ld hl,(ix+tile_y)
048E80 ED 5B E4 8E 0079*       ld de,(@tile_y)
       04          
048E85 B7          0080*       or a ; clear carry
048E86 E5          0081*       push hl
048E87 ED 52       0082*       sbc hl,de
048E89 E1          0083*       pop hl
048E8A CA 9A 8E 04 0084*       jp z,@kill_it
048E8E 01 00 01 00 0085*       ld bc,1*256
048E92 09          0086*       add hl,bc
048E93 B7          0087*       or a
048E94 ED 52       0088*       sbc hl,de
048E96 C2 AE 8E 04 0089*       jp nz,@next_record
048E9A             0090*   @kill_it: ; deactivate tile and replace with inactive blank tile
