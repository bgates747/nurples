048DD8             0193    ; needs to be the final include to leave room for the sprite and tile tables
048DD8             0194        include "tables.inc"
048DD8             0001*   ; #### THIS IS THE SPACE ALLOCATED TO THE SPRITE TABLE ####
048DD8             0002*   table_base: equ $
048DD8             0003*   player_weapons_begin: equ table_base
048DD8             0004*   player_lasers_begin: equ player_weapons_begin
048DD8             0005*   player_lasers_end: equ table_record_size*player_lasers_max+player_lasers_begin
048DD8             0006*   player_lasers_end_sprite_id: equ [player_lasers_end-table_base]/table_record_size
048DD8             0007*   player_weapons_end: equ table_record_size*player_lasers_max+player_weapons_begin
048DD8             0008*   player_begin: equ player_weapons_end
048DD8             0009*   player_end: equ table_record_size+player_begin
048DD8             0010*   enemy_sprites_begin: equ player_end
048DD8             0011*   seekers_base: equ enemy_sprites_begin
048DD8             0012*   seeker_min_sprite_id: equ [seekers_base-table_base]/table_record_size
048DD8             0013*   seekers_end: equ table_record_size*seekers_max+seekers_base
048DD8             0014*   seekers_end_sprite_id: equ [seekers_end-table_base]/table_record_size
048DD8             0015*   fireballs_base: equ seekers_end
048DD8             0016*   fireballs_end: equ table_record_size*fireballs_max+fireballs_base
048DD8             0017*   fireballs_end_sprite_id: equ [fireballs_end-table_base]/table_record_size
048DD8             0018*   enemy_sprites_end: equ fireballs_end
048DD8             0019*   explosions_base: equ enemy_sprites_end
048DD8             0020*   explosions_end: equ table_record_size*explosions_max+explosions_base
048DD8             0021*   explosions_end_sprite_id: equ [explosions_end-table_base]/table_record_size
048DD8             0022*   table_end: equ explosions_end
048DD8             0023*   
048DD8             0024*   table_num_records: equ [table_end-table_base]/table_record_size
048DD8             0025*   table_num_enemy_records: equ [enemy_sprites_end-enemy_sprites_begin]/table_record_size
048DD8             0026*   
048DD8             0027*   ; ### THIS IS THE SPACE ALLOCATED TO THE ACTIVE TILES TABLE ###
048DD8             0028*   tile_table_base: equ table_end
048DD8             0029*   tile_table_end: equ 256*tile_table_record_size+tile_table_base
