045F34             0061        include "player_state.inc"
045F34             0001*   player_defaults:
045F34 05          0002*       db player               ; type
045F35 73 01 00    0003*       dl BUF_SHIP_0L          ; base_bufferId
045F38 A1 5F 04    0004*       dl do_player            ; move_program
045F3B 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
045F3C 10          0006*       db 16                   ; dim_x
045F3D 10          0007*       db 16                   ; dim_y
045F3E 01          0008*       db 1                    ; num_orientations
045F3F 01          0009*       db 1                    ; num_animations
045F40 00          0010*       db 0                    ; animation
045F41 00          0011*       db 0                    ; animation_timer
045F42 00          0012*       db 0                    ; move_timer
045F43 00          0013*       db 0                    ; move_step
045F44 00          0014*       db 0                    ; points
045F45 00          0015*       db 0                    ; shield_damage
045F46 00          0016*       db 0                    ; frame
045F47             0017*   
045F47 81 60 04    0018*   player_state:  dl player_alive
045F4A             0019*   player_event_none: equ 0
045F4A             0020*   player_event_game_over: equ 1
045F4A 00          0021*   player_event: db player_event_none
045F4B             0022*   player_fault_bad_state: equ 0
045F4B 00          0023*   player_fault_flags: db 0 ; latched fail-closed diagnostics
045F4C             0024*   player_dying_phase_initial: equ 0
045F4C             0025*   player_dying_phase_delay: equ 1
045F4C             0026*   player_dying_phase_finale: equ 2
045F4C             0027*   player_dying_phase_finish: equ 3
045F4C 00          0028*   player_dying_phase: db player_dying_phase_initial
045F4D 00          0029*   player_dying_timer: db 0
045F4E 00          0030*   player_dying_spawns: db 0
045F4F 00          0031*   player_ships: db 0
045F50 03          0032*   player_ships_max: db 3
045F51             0033*   player_speed: equ 3*256 ; pixels per frame 16.8 fixed
045F51             0034*   
045F51             0035*   draw_player_ships:
045F51             0036*   ; activate mfd
045F51 DD 21 2A 62 0037*       ld ix,mfd_ships
       04          
045F56 CD 31 63 04 0038*       call mfd_activate
045F5A             0039*   ; blank out previously drawn ships
045F5A AF          0040*       xor a ; color mode 0
045F5B 0E 00       0041*       ld c,c_black
045F5D CD 07 14 04 0042*       call vdu_gcol
045F61 01 00 00 00 0043*       ld bc,0
045F65 11 00 00 00 0044*       ld de,0
045F69 DD 21 4F 00 0045*       ld ix,0+79
       00          
045F6E FD 21 0F 00 0046*       ld iy,0+15
       00          
045F73 CD 4A 19 04 0047*       call vdu_plot_rf
045F77             0048*   ; draw the ships remaining
045F77 21 2B 00 00 0049*       ld hl,BUF_SHIP_MFD
045F7B CD D7 14 04 0050*       call vdu_buff_select
045F7F 3A 4F 5F 04 0051*       ld a,(player_ships) ; loop counter
045F83 01 00 00 00 0052*       ld bc,0 ; starting x-coordinate
045F87             0053*   @loop:
045F87 3D          0054*       dec a ; we don't count the ship we're flying
045F88 C8          0055*       ret z
045F89 F5          0056*       push af ; back up loop counter
045F8A C5          0057*       push bc ; save x-coordinate
045F8B 11 00 00 00 0058*       ld de,0 ; y-coordinate
045F8F CD 0D 19 04 0059*       call vdu_plot_bmp
045F93 C1          0060*       pop bc ; restore x-coordinate
045F94 21 10 00 00 0061*       ld hl,16 ; bump x-coords
045F98 09          0062*       add hl,bc
045F99 E5          0063*       push hl
045F9A C1          0064*       pop bc ; bc = new x-coordinate
045F9B F1          0065*       pop af
045F9C C3 87 5F 04 0066*       jp @loop
045FA0 C9          0067*       ret
045FA1             0068*   ; end draw_player_ships
045FA1             0069*   
045FA1             0070*   do_player:
045FA1 2A 47 5F 04 0071*       ld hl,(player_state)
045FA5 CD C1 5F 04 0072*       call player_state_pointer_valid
045FA9 DA BA 5F 04 0073*       jp c,@dispatch
045FAD 21 4B 5F 04 0074*       ld hl,player_fault_flags
045FB1 CB C6       0075*       set player_fault_bad_state,(hl)
045FB3 3E 01       0076*       ld a,player_event_game_over
045FB5 32 4A 5F 04 0077*       ld (player_event),a
045FB9 C9          0078*       ret
045FBA             0079*   @dispatch:
045FBA             0080*       CALL_HL
                       M1 Args: none
045FBA 01 C0 5F 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
045FBE C5          0002*M1     push bc ; which constitutes the return address
045FBF E9          0003*M1     jp (hl) ; Jump to the address in HL
045FC0 C9          0081*       ret
045FC1             0082*   ; end do_player
