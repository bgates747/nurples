040F9A             0036        include "fonts.inc"
040F9A             0001*   fonts_load:
040F9A DD 21 9F 4D 0002*       ld ix,font_list ; pointer to font list lookup
       04          
040F9F 06 01       0003*       ld b,num_fonts ; loop counter
040FA1             0004*   
040FA1             0005*   @load_loop:
040FA1 C5          0006*       push bc ; save loop counter
040FA2             0007*   
040FA2             0008*   ; load font into a buffer
040FA2 DD 27 06    0009*       ld hl,(ix+font_list_bufferId)
040FA5 DD 31 09    0010*       ld iy,(ix+font_list_filename)
040FA8 DD E5       0011*       push ix ; mos_fread does not preserve the font-list cursor
040FAA CD 72 16 04 0012*       call vdu_load_buffer_from_file
040FAE DD E1       0013*       pop ix
040FB0 30 24       0014*       jr nc,@load_failed
040FB2             0015*   
040FB2             0016*   ; create font from buffer
040FB2 DD 27 06    0017*       ld hl,(ix+font_list_bufferId)
040FB5 DD 5E 00    0018*       ld e,(ix+font_list_width)
040FB8 DD 56 03    0019*       ld d,(ix+font_list_height)
040FBB 3E 00       0020*       ld a,0 ; flags
040FBD CD C9 18 04 0021*       call vdu_font_create
040FC1             0022*   
040FC1             0023*   ; select font
040FC1 DD 27 06    0024*       ld hl,(ix+font_list_bufferId)
040FC4 3E 01       0025*       ld a,1 ; flags
040FC6 CD AF 18 04 0026*       call vdu_font_select
040FCA             0027*   
040FCA             0028*   ; Report only a fully uploaded, created, and selected font.
040FCA 3E 2E       0029*       ld a,'.'
040FCC 5B D7       0030*       rst.lil 10h
040FCE             0031*   
040FCE             0032*   ; ; debug print filename
040FCE             0033*   ;     call printNewLine
040FCE             0034*   ;     ld hl,(ix+font_list_filename)
040FCE             0035*   ;     call printString
040FCE             0036*   
040FCE             0037*   ; advance font_list pointer to next record
040FCE             0038*   @next_font:
040FCE ED 32 0C    0039*       lea ix,ix+font_list_record_size
040FD1             0040*   
040FD1             0041*   ; restore loop counter
040FD1 C1          0042*       pop bc
040FD2 10 CD       0043*       djnz @load_loop
040FD4             0044*   
040FD4             0045*   ; all done: every font completed successfully
040FD4 37          0046*       scf
040FD5 C9          0047*       ret
040FD6             0048*   
040FD6             0049*   @load_failed:
040FD6             0050*   ; Balance the loop counter saved by this iteration and publish failure.
040FD6 C1          0051*       pop bc
040FD7 B7          0052*       or a ; clear carry
040FD8 C9          0053*       ret
