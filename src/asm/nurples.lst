044E49 1E 08       0105*       ld e,explosions_max ; sprite loop counter
044E4B             0106*   ; define explosion sprites
044E4B             0107*   @sprites_loop:
044E4B F5          0108*       push af
044E4C D5          0109*       push de
044E4D CD 03 1A 04 0110*   	call vdu_sprite_select
044E51 CD 16 1A 04 0111*   	call vdu_sprite_clear_frames
044E55 21 09 01 00 0112*   	ld hl,BUF_EXPLOSION_A
044E59 06 05       0113*   	ld b,5 ; 5 bitmaps for explosion
044E5B             0114*   @frames_loop:
044E5B C5          0115*   	push bc
044E5C E5          0116*   	push hl
044E5D CD 58 1B 04 0117*   	call vdu_sprite_add_buff
044E61 E1          0118*   	pop hl
044E62 23          0119*   	inc hl
044E63 C1          0120*   	pop bc
044E64 10 F5       0121*   	djnz @frames_loop
