048490             0071        include "targeting.inc"
048490             0001*   ; compute orientation to player
048490             0002*   ; based on relative positions
048490             0003*   ; returns: uh.l 16.8 fixed angle256 to player
048490             0004*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
048490             0005*   ;    representing delta-x/y *to* target respectively
048490             0006*   ; inputs: iy pointed at sprite record
048490             0007*   ; destroys: everything except iy (sprite record pointer)
048490             0008*   orientation_to_player:
048490 DD 21 87 9D 0009*       ld ix,player_begin
       04          
048495             0010*   ; compute dx
048495 DD 27 01    0011*       ld hl,(ix+sprite_x)
048498 FD 17 01    0012*       ld de,(iy+sprite_x)
04849B B7          0013*       or a ; clear carry
04849C ED 52       0014*       sbc hl,de ; dx
04849E E5          0015*       push hl ; save dx
04849F             0016*   ; compute dy
04849F DD 27 04    0017*       ld hl,(ix+sprite_y)
0484A2 FD 17 04    0018*       ld de,(iy+sprite_y)
0484A5 B7          0019*       or a ; clear carry
0484A6 ED 52       0020*       sbc hl,de ; dy
0484A8 EB          0021*       ex de,hl ; de = dy
0484A9             0022*   ; compute angle to player
0484A9 C1          0023*       pop bc ; dx (was hl)
0484AA C5          0024*       push bc ; save dx
0484AB D5          0025*       push de ; save dy
0484AC CD F0 07 04 0026*       call atan2_168fast ; uh.l = angle to player
0484B0 3E E0       0027*       ld a,%11100000
0484B2 A5          0028*       and l ; round angle to nearest 32th of a circle
0484B3 6F          0029*       ld l,a
0484B4 22 05 85 04 0030*       ld (Bearing_t),hl ; return angle to player
0484B8 D1          0031*       pop de ; restore dy
0484B9 C1          0032*       pop bc ; restore dx
0484BA C9          0033*       ret
0484BB             0034*   ; end orientation_to_player
0484BB             0035*   
0484BB             0036*   ; compute orientation to player
0484BB             0037*   ; based on relative positions
0484BB             0038*   ; returns: uh.l 16.8 fixed angle256 to player
0484BB             0039*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
0484BB             0040*   ;    representing delta-x/y *to* target respectively
0484BB             0041*   ; inputs: iy pointed at tile record
0484BB             0042*   ; destroys: everything except iy (tile record pointer)
0484BB             0043*   tile_orientation_to_player:
0484BB DD 21 87 9D 0044*       ld ix,player_begin
       04          
0484C0             0045*   ; compute dx
0484C0 DD 27 01    0046*       ld hl,(ix+sprite_x)
0484C3 FD 17 01    0047*       ld de,(iy+tile_x)
0484C6 B7          0048*       or a ; clear carry
0484C7 ED 52       0049*       sbc hl,de ; dx
0484C9 E5          0050*       push hl ; save dx
0484CA             0051*   ; compute dy
0484CA DD 27 04    0052*       ld hl,(ix+sprite_y)
0484CD FD 17 04    0053*       ld de,(iy+tile_y)
0484D0 B7          0054*       or a ; clear carry
0484D1 ED 52       0055*       sbc hl,de ; dy
0484D3 EB          0056*       ex de,hl ; de = dy
0484D4             0057*   ; compute angle to player
0484D4 C1          0058*       pop bc ; dx (was hl)
0484D5 CD F0 07 04 0059*       call atan2_168fast ; uh.l = angle to player
0484D9 3E E0       0060*       ld a,%11100000
0484DB A5          0061*       and l ; round angle to nearest 32th of a circle
0484DC 6F          0062*       ld l,a
0484DD 22 05 85 04 0063*       ld (Bearing_t),hl
0484E1 C9          0064*       ret
0484E2             0065*   ; end tile_orientation_to_player
0484E2             0066*   
0484E2             0067*   ; compute orientation to coordinate
0484E2             0068*   ; based on relative positions
0484E2             0069*   ; returns: uh.l 16.8 fixed angle256 to coordinate
0484E2             0070*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
0484E2             0071*   ;    representing delta-x/y *to* target respectively
0484E2             0072*   ; inputs: iy pointed at sprite record, ub.c,ud.e are target x,y coordinates
0484E2             0073*   ; destroys: everything except iy (sprite record pointer)
0484E2             0074*   bearing_to_coord:
0484E2             0075*   ; compute dx
0484E2 C5          0076*       push bc
0484E3 E1          0077*       pop hl
0484E4 FD 07 01    0078*       ld bc,(iy+sprite_x)
0484E7 B7          0079*       or a ; clear carry
0484E8 ED 42       0080*       sbc hl,bc ; dx
0484EA E5          0081*       push hl ; save dx
0484EB             0082*   ; compute dy
0484EB EB          0083*       ex de,hl
0484EC FD 17 04    0084*       ld de,(iy+sprite_y)
0484EF B7          0085*       or a ; clear carry
0484F0 ED 52       0086*       sbc hl,de ; dy
0484F2 EB          0087*       ex de,hl ; de = dy
0484F3             0088*   ; compute angle to coordinate
0484F3 C1          0089*       pop bc ; dx (was hl)
0484F4 C5          0090*       push bc ; save dx
0484F5 D5          0091*       push de ; save dy
0484F6 CD F0 07 04 0092*       call atan2_168fast ; uh.l = angle to coordinate
0484FA 3E E0       0093*       ld a,%11100000
0484FC A5          0094*       and l ; round angle to nearest 32th of a circle
0484FD 6F          0095*       ld l,a
0484FE 22 05 85 04 0096*       ld (Bearing_t),hl ; return angle to coordinate
048502 D1          0097*       pop de ; restore dy
048503 C1          0098*       pop bc ; restore dx
048504 C9          0099*       ret
048505             0100*   ; end bearing_to_coord
048505             0101*   
048505             0102*   ; targeting_computer variables fixed 16.8 format
048505 00 00 00    0103*   Bearing_t: dl 0x000000 ; angle to target
048508 00 00 00    0104*   Heading_t: dl 0x000000 ; angle of target motion
04850B 00 00 00    0105*   Vp: dl 0x000000 ; velocity of projectile
04850E 00 00 00    0106*   Vp_x: dl 0x000000 ; x component of projectile velocity
048511 00 00 00    0107*   Vp_y: dl 0x000000 ; y component of projectile velocity
048514 00 00 00    0108*   Vt: dl 0x000000 ; velocity of target
048517 00 00 00    0109*   Vt_x: dl 0x000000 ; x component of target velocity
04851A 00 00 00    0110*   Vt_y: dl 0x000000 ; y component of target velocity
04851D 00 00 00    0111*   Heading_p: dl 0x000000 ; angle of projectile motion
048520 00 00 00    0112*   lead_angle: dl 0x000000 ; lead angle
048523             0113*   
048523             0114*   ; Inputs:   Vp velocity of projectile set,
048523             0115*   ;           iy pointed to sprite record,
048523             0116*   ;           player position and velocities correctly set
048523             0117*   ; Outputs:  uh.l is the 16.8 fixed firing angle256
048523             0118*   ;           ub.c and ud.e are the 16.8 fixed x,y component projectile velocities
048523             0119*   ; https://old.robowiki.net/cgi-bin/robowiki?LinearTargeting
048523             0120*   targeting_computer:
048523 DD 21 87 9D 0121*       ld ix,player_begin
       04          
048528             0122*   ; ; compute target velocity from x,y component velocities
048528             0123*   ;     ld bc,(ix+sprite_xvel)
048528             0124*   ;     ld de,(ix+sprite_yvel)
048528             0125*   ;     ld hl,-1*256 ; account for vertical ground movement
048528             0126*   ;     add hl,de
048528             0127*   ;     ex de,hl ; ud.e = player_yvel-1
048528             0128*   ;     call cartesian_to_polar_sm ; uh.l = Heading_t, ud.e = Vt
048528             0129*   ;     ld (Heading_t),hl ; PASSES
048528             0130*   ;     ld (Vt),de ; PASSES
048528             0131*   ; ; Bearing_t should have been set by prerequisite call to orientation_to_player
048528             0132*   ; ; compute Heading_t-Bearing_t PASSES
048528             0133*   ;     ld de,(Bearing_t)
048528             0134*   ;     and a ; clear carry
048528             0135*   ;     sbc hl,de ; Uh.l = Heading_t-Bearing_t
048528             0136*   ; ; compute sin(Heading_t-Bearing_t)
048528             0137*   ;     call sin168 ; uh.l = sin(Heading_t-Bearing_t)
048528             0138*   ; ; compute (Vt*sin(Heading_t-Bearing_t))
048528             0139*   ;     ld de,(Vt)
048528             0140*   ;     call smul168 ; uh.l = (Vt*sin(Heading_t-Bearing_t))
048528             0141*   ; ; compute (Vt * sin(Heading_t-Bearing_t)) / Vp
048528             0142*   ;     ld de,(Vp)
048528             0143*   ;     call sdiv168 ; ud.e = (Vt*sin(Heading_t-Bearing_t)) / Vp
048528             0144*   ;     ex de,hl ; uh.l = (Vt*sin(Heading_t-Bearing_t)) / Vp
048528             0145*   ; ; answer is in radians, convert to degrees256
048528             0146*   ;     ld de,0x0028BE ; 40.74 = 57.29578*256/360
048528             0147*   ;     call smul168 ; uh.l = angle in degrees256
048528             0148*   ;     ld (lead_angle),hl ; TODO: fix this
048528             0149*   ; ; add lead angle to target bearing
048528             0150*   ;     ld de,(Bearing_t)
048528             0151*   ;     add hl,de ; h.l = lead angle+target bearing
048528             0152*   
048528 2A 05 85 04 0153*       ld hl,(Bearing_t) ; TODO: fix this
04852C             0154*   
04852C E5          0155*       push hl
04852D             0156*   
04852D             0157*   ; compute component projectile velocities
04852D ED 5B 0B 85 0158*       ld de,(Vp) ; Vp should have been set by caller
       04          
048532 CD F6 06 04 0159*       call polar_to_cartesian ; ub.c = Vp_x, ud.e = Vp_y
048536 ED 43 0E 85 0160*       ld (Vp_x),bc
       04          
04853B             0161*       ; inc d ; account for vertical ground movement
04853B ED 53 11 85 0162*       ld (Vp_y),de
       04          
048540 E1          0163*       pop hl ; uh.l = lead angle+target bearing
048541 22 1D 85 04 0164*       ld (Heading_p),hl
048545             0165*   
048545 C9          0166*       ret
048546             0167*   
