0464CB 35          0035*       dec (hl)
0464CC CA D5 64 04 0036*       jp z,@no_fuel
0464D0 FA D5 64 04 0037*       jp m,@no_fuel
0464D4 C9          0038*       ret ; fuel not zero so return
0464D5             0039*   @no_fuel:
