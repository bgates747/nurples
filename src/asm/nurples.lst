041500             0295*   ; 138   320   240   4     60hz
041500             0296*   ; 22    512   384   4     60hz
041500             0297*   ; 150   512   384   4     60hz
041500             0298*   ; 5     640   240   4     60hz
041500             0299*   ; 133   640   240   4     60hz
041500             0300*   ; 1     640   480   4     60hz
041500             0301*   ; 129   640   480   4     60hz
041500             0302*   ; 16    800   600   4     60hz
041500             0303*   ; 19    1024  768   4     60hz
