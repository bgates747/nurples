041482 01 05 00 00 0186*       ld bc,@end-@cmd
041486 5B DF       0187*       rst.lil $18
041488 C9          0188*       ret
041489 1D          0189*   @cmd:   db 29 ; set graphics origin command
04148A 00 00       0190*   @x0: 	dw 0x0000 ; set by bc
04148C 00 00       0191*   @y0: 	dw 0x0000 ; set by de
04148E 00          0192*   @end:   db 0x00	  ; padding
04148F             0193*   
04148F             0194*   ; VDU 24, left; bottom; right; top;: Set graphics viewport
04148F             0195*   ; NOTE: the order of the y-coordinate parameters are inverted
04148F             0196*   ; 	because we have turned off logical screen scaling
04148F             0197*   ; NOTE: coordinates are relative to current gfx origin
