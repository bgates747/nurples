044B3F             0033*   
044B3F             0034*   move_enemy_seeker_orbit:
044B3F             0035*   ; compute x coordinate of orbit origin based on sprite id
044B3F 3E 05       0036*       ld a,seeker_min_sprite_id
044B41 FD 96 00    0037*       sub (iy+sprite_id)
044B44 6F          0038*       ld l,a
044B45 26 55       0039*       ld h,85 ; 1/3 the playing field width
044B47 ED 6C       0040*       mlt hl
044B49 3E 40       0041*       ld a,64 ; 1/4 of the playing field width
044B4B 85          0042*       add a,l ; a = x coordinate of orbit origin
044B4C FD 77 25    0043*       ld (iy+sprite_move_step),a ; as good a place as any to store it
044B4F             0044*   ; initialize orbit angle
044B4F AF          0045*       xor a
044B50 FD 77 13    0046*       ld (iy+sprite_orientation),a
044B53             0047*   ; ; initialize move timer
044B53             0048*   ;     inc a ; set to 1
044B53             0049*   ;     ld (iy+sprite_move_timer),a
044B53             0050*   ; init done, so update move program
044B53 21 5A 4B 04 0051*       ld hl,move_enemy_seeker_orbit_stage1 ; update move program pointer
044B57 FD 2F 1A    0052*       ld (iy+sprite_move_program),hl
044B5A             0053*   ; fall through to the persistent orbit behavior
044B5A             0054*   move_enemy_seeker_orbit_stage1:
044B5A             0055*   ; ; check whether time to update orbit angle
044B5A             0056*   ;     dec (iy+sprite_move_timer)
044B5A             0057*   ;     jp nz,@F ; not time to change so simply movethe sprite on the current heading
044B5A             0058*   ;     inc (iy+sprite_move_timer) ; reset timer to 1
044B5A             0059*   ; update the target coordinates based on orbit angle and radius
044B5A FD 34 13    0060*       inc (iy+sprite_orientation) ; increment angle
044B5D 21 00 00 00 0061*       ld hl,0 ; clear hlu and l
044B61 FD 66 13    0062*       ld h,(iy+sprite_orientation) ; uh.l = angle
044B64 11 00 80 00 0063*       ld de,128*256 ; ud.e = radius
044B68 CD E9 06 04 0064*       call polar_to_cartesian ; u.bc, u.de = x,y offsets
044B6C FD 7E 25    0065*       ld a,(iy+sprite_move_step) ; x coordinate of orbit origin
044B6F 80          0066*       add a,b ; add x offset
044B70 01 00 00 00 0067*       ld bc,0 ; bcu and c
044B74 47          0068*       ld b,a ; ub.c = x
044B75 21 00 A8 00 0069*       ld hl,336/2*256
044B79 19          0070*       add hl,de
044B7A EB          0071*       ex de,hl ; ud.e = y
044B7B CD B3 6F 04 0072*       call bearing_to_coord ; uh.l = angle to coordinate
044B7F FD 2F 10    0073*       ld (iy+sprite_heading),hl ; save angle as heading
044B82             0074*   ; compute component velocities, save them in sprite record, and move the sprite
044B82 CD F0 6A 04 0075*       call sprite_compute_velocities
044B86             0076*   @@:
044B86 CD 4F 6A 04 0077*       call move_sprite ; move the sprite
044B8A C3 8E 4B 04 0078*       jp move_enemy_seeker
044B8E             0079*   ; end move_enemy_seeker_orbit
044B8E             0080*   
044B8E             0081*   move_enemy_seeker:
044B8E DD 21 1A 89 0082*       ld ix,player_begin
       04          
044B93 DD CB 1D 76 0083*       bit sprite_alive,(ix+sprite_collisions)
044B97 CA A3 4B 04 0084*       jp z,@F ; player is dead so don't check for collisions
044B9B CD CB 49 04 0085*       call check_enemy_collision_player
044B9F CA C3 4B 04 0086*       jp z,@player
044BA3             0087*   @@:
044BA3 CD BF 49 04 0088*       call check_enemy_collision_laser
044BA7 CA BB 4B 04 0089*       jp z,@laser
044BAB             0090*   ; change the animation frame to match heading
044BAB FD 7E 00    0091*       ld a,(iy+sprite_id)
044BAE CD AE 19 04 0092*       call vdu_sprite_select
044BB2 CD 1B 6B 04 0093*       call sprite_frame_heading ; a, sprite_frame set to heading-based frame
044BB6 CD 11 1A 04 0094*       call vdu_sprite_select_frame
044BBA C9          0095*       ret
044BBB             0096*   @laser:
044BBB CD 9A 66 04 0097*       call update_score
044BBF C3 89 4C 04 0098*       jp spawn_explosion
044BC3             0099*   @player:
044BC3 CD F7 66 04 0100*       call update_shields
044BC7 C3 89 4C 04 0101*       jp spawn_explosion
044BCB             0102*   ; end move_enemy_seeker
044BCB             0103*   
044BCB             0104*   ; contains the logic for how to move the enemy
044BCB             0105*   ; and then does the moving
044BCB             0106*   ; inputs: a fully-populated active sprite table
044BCB             0107*   ;         player position variables
044BCB             0108*   ; destroys: everything except index registers
044BCB             0109*   ; outputs: moving enemies
044BCB             0110*   en_nav_seek_zag:
044BCB             0111*   ; set velocity and orientation by player's relative location
044BCB             0112*   ; move enemies y-axis
044BCB             0113*   ; where is player relative to us?
044BCB CD 61 6F 04 0114*       call orientation_to_player ; uh.l angle to player, ub.c, ud.e = dx, dy
044BCF             0115*   ; is player above or below us?
044BCF ED 53 37 03 0116*       ld (ude),de ; dy
       04          
044BD4 3A 39 03 04 0117*       ld a,(ude+2) ; deu
044BD8 17          0118*       rla ; shift sign bit into carry
044BD9 D2 02 4C 04 0119*       jp nc,@zig_zag ; player is below,evade
044BDD             0120*   ; player is even or above,so home in on current heading
044BDD FD 2F 10    0121*       ld (iy+sprite_heading),hl ; save sprite heading
044BE0             0122*   ; fall through to @compute_velocities
044BE0             0123*   @compute_velocities:
044BE0 CD F0 6A 04 0124*       call sprite_compute_velocities
044BE4 CD 4F 6A 04 0125*       call move_sprite ; move the sprite
044BE8 B7          0126*       or a ; a will be non-zero if have collided with screen edge
044BE9 C2 19 4C 04 0127*       jp nz,@edge_switch ; switch direction, but never move twice in one frame
044BED C3 8E 4B 04 0128*       jp move_enemy_seeker ; didn't hit an edge so check collisions and move sprite
044BF1             0129*   @reset_zig_zag_timer:
044BF1 FD 2A 49 67 0130*       ld iy,(table_pointer)
       04          
044BF6 CD 14 05 04 0131*       call rand_8
044BFA E6 3F       0132*       and %00111111 ; limit it to 64
044BFC CB DF       0133*       set 3,a ; make sure it's at least 8
044BFE FD 77 24    0134*       ld (iy+sprite_move_timer),a ; store it
044C01 C9          0135*       ret
044C02             0136*   @zig_zag:
044C02 FD 7E 24    0137*       ld a,(iy+sprite_move_timer)
044C05 3D          0138*       dec a
044C06 FD 77 24    0139*       ld (iy+sprite_move_timer),a
044C09 C2 41 4C 04 0140*       jp nz,@zig_zag_no_switch
044C0D             0141*   @zag_switch:
044C0D CD 25 4C 04 0142*       call @switch_zag_heading
044C11 CD F1 4B 04 0143*       call @reset_zig_zag_timer
044C15 C3 41 4C 04 0144*       jp @zig_zag_no_switch
044C19             0145*   @edge_switch:
044C19             0146*   ; The generic mover has already clamped/bounced this seeker. Choose the next
044C19             0147*   ; zag and return through collision handling; moving again here can loop forever
044C19             0148*   ; at the bottom edge because both zag headings point downward.
044C19 CD 25 4C 04 0149*       call @switch_zag_heading
044C1D CD F1 4B 04 0150*       call @reset_zig_zag_timer
044C21 C3 8E 4B 04 0151*       jp move_enemy_seeker
044C25             0152*   @switch_zag_heading:
044C25 FD 7E 25    0153*       ld a,(iy+sprite_move_step)
044C28 EE 01       0154*       xor %1 ; flips bit zero
044C2A FD 77 25    0155*       ld (iy+sprite_move_step),a ; store it
044C2D C2 39 4C 04 0156*       jp nz,@right ; zag right
044C31             0157*   ;otherwise zag left
044C31 21 00 A0 00 0158*       ld hl,160*256; southwest heading
044C35 FD 2F 10    0159*       ld (iy+sprite_heading),hl ; save sprite heading
044C38 C9          0160*       ret
044C39             0161*   @right:
044C39 21 00 60 00 0162*       ld hl,96*256; southeast heading
044C3D FD 2F 10    0163*       ld (iy+sprite_heading),hl ; save sprite heading
044C40 C9          0164*       ret
044C41             0165*   @zig_zag_no_switch:
044C41             0166*       ; ld a,(sprite_orientation)
044C41 FD 27 10    0167*       ld hl,(iy+sprite_heading)
044C44 C3 E0 4B 04 0168*       jp @compute_velocities
044C48             0169*   ; end en_nav_seek_zag
044C48             0170*   
044C48             0171*   
044C48             0172*   init_enemy_seekers:
044C48             0173*   ; set pointer to seeker sprite table
044C48 FD 21 5A 89 0174*       ld iy,seekers_base
       04          
044C4D FD 7E 00    0175*       ld a,(iy+sprite_id) ; sprite id
044C50 1E 03       0176*       ld e,seekers_max ; sprite loop counter
044C52             0177*   ; define seeker sprites
044C52             0178*   @sprites_loop:
044C52 F5          0179*       push af
044C53 D5          0180*       push de
044C54 CD AE 19 04 0181*   	call vdu_sprite_select
044C58 CD C1 19 04 0182*   	call vdu_sprite_clear_frames
044C5C 21 53 01 00 0183*   	ld hl,BUF_SEEKER_000
044C60 06 20       0184*   	ld b,32 ; 32 bitmaps for seeker
044C62             0185*   @frames_loop:
044C62 C5          0186*   	push bc
044C63 E5          0187*   	push hl
044C64 CD 03 1B 04 0188*   	call vdu_sprite_add_buff
044C68 E1          0189*   	pop hl
044C69 23          0190*   	inc hl
044C6A C1          0191*   	pop bc
044C6B 10 F5       0192*   	djnz @frames_loop
044C6D D1          0193*       pop de ; sprite loop counter
044C6E F1          0194*       pop af ; sprite id
044C6F 3C          0195*       inc a
044C70 1D          0196*       dec e
044C71 C2 52 4C 04 0197*       jp nz,@sprites_loop
