0466AA BE          0043*       cp (hl)
0466AB C8          0044*       ret z ; no change to update
0466AC 77          0045*       ld (hl),a
0466AD DD 21 63 66 0046*       ld ix,bar_shields
       04          
0466B2 DD 77 00    0047*       ld (ix+bar_val),a ; TODO: this is redundant
0466B5 CD F8 62 04 0048*       call bar_update_v
0466B9 C9          0049*       ret
