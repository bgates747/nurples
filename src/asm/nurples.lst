046882 CD 76 13 04 0141*       call vdu_colour_text
046886 3E 3A       0142*       ld a,58 ; dark orange
046888 CD 76 13 04 0143*       call vdu_colour_text
04688C             0144*   ; print get ready message
04688C 0E 1B       0145*       ld c,27 ; x
04688E 06 10       0146*       ld b,16 ; y
046890 CD 31 13 04 0147*       call vdu_move_cursor
046894 CD 60 00 04 0148*       call printInline
046898 47 65 74 20 0149*       asciz "Get Ready!"
       52 65 61 64 
       79 21 00    
