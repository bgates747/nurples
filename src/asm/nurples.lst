047ACF BE          0170*       cp (hl)
047AD0 C8          0171*       ret z ; no change to update
047AD1 77          0172*       ld (hl),a
047AD2 DD 21 B7 79 0173*       ld ix,bar_laser
       04          
047AD7 DD 77 00    0174*       ld (ix+bar_val),a ; TODO: this is redundant
047ADA CD 7F 77 04 0175*       call bar_update_v
047ADE C9          0176*       ret
