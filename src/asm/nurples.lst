0466B5             0023*   
0466B5             0024*   ; inputs: iy set to sprite/tile record being tallied
0466B5             0025*   ; outputs: a/player_shields = updated shields, Z set when depleted
0466B5             0026*   ; destroys: hl,de; preserves bc,ix,iy
0466B5             0027*   update_shields:
