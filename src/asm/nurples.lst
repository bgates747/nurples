047D99 40          0024*   discharge_fuel_timer_max: db 64 ;
047D9A             0025*   discharge_fuel:
047D9A             0026*   ; check fuel timer
047D9A 21 98 7D 04 0027*       ld hl,discharge_fuel_timer
047D9E 35          0028*       dec (hl)
047D9F C0          0029*       ret nz ; not time to discharge fuel so return
047DA0             0030*   ; reset fuel discharge timer
047DA0 3A 99 7D 04 0031*       ld a,(discharge_fuel_timer_max)
