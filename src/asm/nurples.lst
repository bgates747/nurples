041403 01 02 00 00 0116*   	ld bc,@end-@cmd
041407 5B DF       0117*   	rst.lil $18
041409 C9          0118*   	ret
04140A 11          0119*   @cmd: db 17
04140B 00          0120*   @arg: db 0
04140C             0121*   @end:
04140C             0122*   
