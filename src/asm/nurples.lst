044B94             0033*   
044B94             0034*   move_enemy_seeker_orbit:
044B94             0035*   ; compute x coordinate of orbit origin based on sprite id
044B94 3E 05       0036*       ld a,seeker_min_sprite_id
044B96 FD 96 00    0037*       sub (iy+sprite_id)
044B99 6F          0038*       ld l,a
044B9A 26 55       0039*       ld h,85 ; 1/3 the playing field width
044B9C ED 6C       0040*       mlt hl
044B9E 3E 40       0041*       ld a,64 ; 1/4 of the playing field width
044BA0 85          0042*       add a,l ; a = x coordinate of orbit origin
044BA1 FD 77 25    0043*       ld (iy+sprite_move_step),a ; as good a place as any to store it
044BA4             0044*   ; initialize orbit angle
044BA4 AF          0045*       xor a
044BA5 FD 77 13    0046*       ld (iy+sprite_orientation),a
044BA8             0047*   ; ; initialize move timer
044BA8             0048*   ;     inc a ; set to 1
044BA8             0049*   ;     ld (iy+sprite_move_timer),a
044BA8             0050*   ; init done, so update move program
044BA8 21 AF 4B 04 0051*       ld hl,move_enemy_seeker_orbit_stage1 ; update move program pointer
044BAC FD 2F 1A    0052*       ld (iy+sprite_move_program),hl
044BAF             0053*   ; fall through to the persistent orbit behavior
044BAF             0054*   move_enemy_seeker_orbit_stage1:
044BAF             0055*   ; ; check whether time to update orbit angle
044BAF             0056*   ;     dec (iy+sprite_move_timer)
044BAF             0057*   ;     jp nz,@F ; not time to change so simply movethe sprite on the current heading
044BAF             0058*   ;     inc (iy+sprite_move_timer) ; reset timer to 1
044BAF             0059*   ; update the target coordinates based on orbit angle and radius
044BAF FD 34 13    0060*       inc (iy+sprite_orientation) ; increment angle
044BB2 21 00 00 00 0061*       ld hl,0 ; clear hlu and l
044BB6 FD 66 13    0062*       ld h,(iy+sprite_orientation) ; uh.l = angle
044BB9 11 00 80 00 0063*       ld de,128*256 ; ud.e = radius
044BBD CD E9 06 04 0064*       call polar_to_cartesian ; u.bc, u.de = x,y offsets
044BC1 FD 7E 25    0065*       ld a,(iy+sprite_move_step) ; x coordinate of orbit origin
044BC4 80          0066*       add a,b ; add x offset
044BC5 01 00 00 00 0067*       ld bc,0 ; bcu and c
044BC9 47          0068*       ld b,a ; ub.c = x
044BCA 21 00 A8 00 0069*       ld hl,336/2*256
044BCE 19          0070*       add hl,de
044BCF EB          0071*       ex de,hl ; ud.e = y
044BD0 CD 5B 70 04 0072*       call bearing_to_coord ; uh.l = angle to coordinate
044BD4 FD 2F 10    0073*       ld (iy+sprite_heading),hl ; save angle as heading
044BD7             0074*   ; compute component velocities, save them in sprite record, and move the sprite
044BD7 CD 5F 6B 04 0075*       call sprite_compute_velocities
044BDB             0076*   @@:
044BDB CD BE 6A 04 0077*       call move_sprite ; move the sprite
044BDF C3 E3 4B 04 0078*       jp move_enemy_seeker
044BE3             0079*   ; end move_enemy_seeker_orbit
044BE3             0080*   
044BE3             0081*   move_enemy_seeker:
044BE3 DD 21 D8 8E 0082*       ld ix,player_begin
       04          
044BE8 DD CB 1D 76 0083*       bit sprite_alive,(ix+sprite_collisions)
044BEC CA F8 4B 04 0084*       jp z,@F ; player is dead so don't check for collisions
044BF0 CD 20 4A 04 0085*       call check_enemy_collision_player
044BF4 CA 18 4C 04 0086*       jp z,@player
044BF8             0087*   @@:
044BF8 CD 14 4A 04 0088*       call check_enemy_collision_laser
044BFC CA 10 4C 04 0089*       jp z,@laser
044C00             0090*   ; change the animation frame to match heading
044C00 FD 7E 00    0091*       ld a,(iy+sprite_id)
044C03 CD 03 1A 04 0092*       call vdu_sprite_select
044C07 CD 8A 6B 04 0093*       call sprite_frame_heading ; a, sprite_frame set to heading-based frame
044C0B CD 66 1A 04 0094*       call vdu_sprite_select_frame
044C0F C9          0095*       ret
044C10             0096*   @laser:
044C10 CD 0D 67 04 0097*       call update_score
044C14 C3 DE 4C 04 0098*       jp spawn_explosion
044C18             0099*   @player:
044C18 CD 6A 67 04 0100*       call update_shields
044C1C C3 DE 4C 04 0101*       jp spawn_explosion
044C20             0102*   ; end move_enemy_seeker
044C20             0103*   
044C20             0104*   ; contains the logic for how to move the enemy
044C20             0105*   ; and then does the moving
044C20             0106*   ; inputs: a fully-populated active sprite table
044C20             0107*   ;         player position variables
044C20             0108*   ; destroys: everything except index registers
044C20             0109*   ; outputs: moving enemies
044C20             0110*   en_nav_seek_zag:
044C20             0111*   ; set velocity and orientation by player's relative location
044C20             0112*   ; move enemies y-axis
044C20             0113*   ; where is player relative to us?
044C20 CD 09 70 04 0114*       call orientation_to_player ; uh.l angle to player, ub.c, ud.e = dx, dy
044C24             0115*   ; is player above or below us?
044C24 ED 53 37 03 0116*       ld (ude),de ; dy
       04          
044C29 3A 39 03 04 0117*       ld a,(ude+2) ; deu
044C2D 17          0118*       rla ; shift sign bit into carry
044C2E D2 57 4C 04 0119*       jp nc,@zig_zag ; player is below,evade
044C32             0120*   ; player is even or above,so home in on current heading
044C32 FD 2F 10    0121*       ld (iy+sprite_heading),hl ; save sprite heading
044C35             0122*   ; fall through to @compute_velocities
044C35             0123*   @compute_velocities:
044C35 CD 5F 6B 04 0124*       call sprite_compute_velocities
044C39 CD BE 6A 04 0125*       call move_sprite ; move the sprite
044C3D B7          0126*       or a ; a will be non-zero if have collided with screen edge
044C3E C2 6E 4C 04 0127*       jp nz,@edge_switch ; switch direction, but never move twice in one frame
044C42 C3 E3 4B 04 0128*       jp move_enemy_seeker ; didn't hit an edge so check collisions and move sprite
044C46             0129*   @reset_zig_zag_timer:
044C46 FD 2A BC 67 0130*       ld iy,(table_pointer)
       04          
044C4B CD 14 05 04 0131*       call rand_8
044C4F E6 3F       0132*       and %00111111 ; limit it to 64
044C51 CB DF       0133*       set 3,a ; make sure it's at least 8
044C53 FD 77 24    0134*       ld (iy+sprite_move_timer),a ; store it
044C56 C9          0135*       ret
044C57             0136*   @zig_zag:
044C57 FD 7E 24    0137*       ld a,(iy+sprite_move_timer)
044C5A 3D          0138*       dec a
044C5B FD 77 24    0139*       ld (iy+sprite_move_timer),a
044C5E C2 96 4C 04 0140*       jp nz,@zig_zag_no_switch
044C62             0141*   @zag_switch:
044C62 CD 7A 4C 04 0142*       call @switch_zag_heading
044C66 CD 46 4C 04 0143*       call @reset_zig_zag_timer
044C6A C3 96 4C 04 0144*       jp @zig_zag_no_switch
044C6E             0145*   @edge_switch:
044C6E             0146*   ; The generic mover has already clamped/bounced this seeker. Choose the next
044C6E             0147*   ; zag and return through collision handling; moving again here can loop forever
044C6E             0148*   ; at the bottom edge because both zag headings point downward.
044C6E CD 7A 4C 04 0149*       call @switch_zag_heading
044C72 CD 46 4C 04 0150*       call @reset_zig_zag_timer
044C76 C3 E3 4B 04 0151*       jp move_enemy_seeker
044C7A             0152*   @switch_zag_heading:
044C7A FD 7E 25    0153*       ld a,(iy+sprite_move_step)
044C7D EE 01       0154*       xor %1 ; flips bit zero
044C7F FD 77 25    0155*       ld (iy+sprite_move_step),a ; store it
044C82 C2 8E 4C 04 0156*       jp nz,@right ; zag right
044C86             0157*   ;otherwise zag left
044C86 21 00 A0 00 0158*       ld hl,160*256; southwest heading
044C8A FD 2F 10    0159*       ld (iy+sprite_heading),hl ; save sprite heading
044C8D C9          0160*       ret
044C8E             0161*   @right:
044C8E 21 00 60 00 0162*       ld hl,96*256; southeast heading
044C92 FD 2F 10    0163*       ld (iy+sprite_heading),hl ; save sprite heading
044C95 C9          0164*       ret
044C96             0165*   @zig_zag_no_switch:
044C96             0166*       ; ld a,(sprite_orientation)
044C96 FD 27 10    0167*       ld hl,(iy+sprite_heading)
044C99 C3 35 4C 04 0168*       jp @compute_velocities
044C9D             0169*   ; end en_nav_seek_zag
044C9D             0170*   
044C9D             0171*   
044C9D             0172*   init_enemy_seekers:
044C9D             0173*   ; set pointer to seeker sprite table
044C9D FD 21 18 8F 0174*       ld iy,seekers_base
       04          
044CA2 FD 7E 00    0175*       ld a,(iy+sprite_id) ; sprite id
044CA5 1E 03       0176*       ld e,seekers_max ; sprite loop counter
044CA7             0177*   ; define seeker sprites
044CA7             0178*   @sprites_loop:
044CA7 F5          0179*       push af
044CA8 D5          0180*       push de
044CA9 CD 03 1A 04 0181*   	call vdu_sprite_select
044CAD CD 16 1A 04 0182*   	call vdu_sprite_clear_frames
044CB1 21 53 01 00 0183*   	ld hl,BUF_SEEKER_000
044CB5 06 20       0184*   	ld b,32 ; 32 bitmaps for seeker
044CB7             0185*   @frames_loop:
044CB7 C5          0186*   	push bc
044CB8 E5          0187*   	push hl
044CB9 CD 58 1B 04 0188*   	call vdu_sprite_add_buff
044CBD E1          0189*   	pop hl
044CBE 23          0190*   	inc hl
044CBF C1          0191*   	pop bc
044CC0 10 F5       0192*   	djnz @frames_loop
044CC2 D1          0193*       pop de ; sprite loop counter
044CC3 F1          0194*       pop af ; sprite id
