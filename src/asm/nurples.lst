044195             1075*   ; AGNB 0.2 audio loader
044195             1076*   ; =====================
044195             1077*   ;
044195             1078*   ; The generic RIFF/AGNB file, chunk, bounds, streaming, buffer-clear, buffer-
044195             1079*   ; load, and buffer-consolidation routines remain in agnb_api.inc. This file adds
044195             1080*   ; the audio-specific record path for:
044195             1081*   ;
044195             1082*   ;     LIST BUFR
044195             1083*   ;       BHDR  u16 bufferId
044195             1084*   ;       AUDI  u8 vdpFormat=0x09; u16 sampleRate
044195             1085*   ;       DATA  unsigned 8-bit mono PCM bytes
044195             1086*   ;
044195             1087*   ; AUDI format 0x09 means VDP base format 1 (unsigned 8-bit mono) with bit 3
044195             1088*   ; set to record that an explicit u16 sample rate follows. vdu_buffer_to_sound
044195             1089*   ; accepts the base format and adds bit 3 itself, so finalization masks it off.
044195             1090*   
044195             1091*   agnb_audio_version_major:  equ 0
044195             1092*   agnb_audio_version_minor:  equ 2
044195             1093*   
044195             1094*   agnb_audi_format:          equ 0 ; u8 VDP sample format byte
044195             1095*   agnb_audi_sample_rate:     equ 1 ; u16 Hz
044195             1096*   agnb_audi_payload_size:    equ 3
044195             1097*   
044195             1098*   agnb_audio_vdp_format:     equ 0x09 ; unsigned 8-bit mono + sample rate follows
044195             1099*   
044195 41 55 44 49 1100*   agnb_id_audi:              db "AUDI"
044199             1101*   
044199             1102*   ; Normalized metadata retained until DATA has been validated and streamed.
