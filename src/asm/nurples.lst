042296 CD 52 80 04 0125*       call move_sprite ; move the sprite
04229A B7          0126*       or a ; a will be non-zero if have collided with screen edge
04229B C2 CB 22 04 0127*       jp nz,@edge_switch ; switch direction, but never move twice in one frame
04229F C3 40 22 04 0128*       jp move_enemy_seeker ; didn't hit an edge so check collisions and move sprite
0422A3             0129*   @reset_zig_zag_timer:
0422A3 FD 2A 4C 7D 0130*       ld iy,(table_pointer)
       04          
0422A8 CD 14 05 04 0131*       call rand_8
