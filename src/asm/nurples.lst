046599             0089*   
046599             0090*   player_spawn_laser:
046599             0091*    ; check laser spawn timer
046599 FD 21 1B 65 0092*       ld iy,tmr_laser
       04          
04659E CD FC 12 04 0093*       call timestamp_tmr_get
0465A2 F0          0094*       ret p ; not time to fire
0465A3             0095*   ; check laser power
0465A3 3A 24 65 04 0096*       ld a,(laser_power)
0465A7 21 27 65 04 0097*       ld hl,laser_power_per_shot
0465AB 96          0098*       sub (hl) ; units of power per laser shot
0465AC D8          0099*       ret c ; not enough power to fire
0465AD             0100*   ; update power to reflect firing
0465AD 32 24 65 04 0101*       ld (laser_power),a
0465B1             0102*   ; reset timer
0465B1 2A 21 65 04 0103*       ld hl,(tmr_laser_reset)
0465B5 CD F1 12 04 0104*       call timestamp_tmr_set
0465B9             0105*   ; fire the laser
0465B9 DD 21 86 87 0106*       ld ix,player_weapons_begin
       04          
0465BE 06 04       0107*       ld b,player_lasers_max
0465C0 FD 21 86 88 0108*       ld iy,player_begin
       04          
0465C5 FD 22 07 67 0109*       ld (table_pointer),iy
       04          
0465CA 21 08 65 04 0110*       ld hl,laser_defaults
0465CE CD 4F 68 04 0111*       call spawn_sprite_from_sprite
0465D2 D0          0112*       ret nc ; no carry means no free sprite slots, so we go home
0465D3             0113*   ; other specific initialization
0465D3             0114*   ; ------------------------------------------------
0465D3 FD 21 86 88 0115*       ld iy,player_begin
       04          
0465D8             0116*   ; x-coordinate
0465D8 FD 27 01    0117*       ld hl,(iy+sprite_x)
0465DB 11 00 05 00 0118*       ld de,5*256 ; horizontal center with player sprite
0465DF 19          0119*       add hl,de
0465E0 DD 2F 01    0120*       ld (ix+sprite_x),hl
0465E3             0121*   ; y-coordinate
0465E3 FD 27 04    0122*       ld hl,(iy+sprite_y)
0465E6 11 00 FA FF 0123*       ld de,-6*256 ; set laser y a few pixels above player
0465EA 19          0124*       add hl,de
0465EB DD 2F 04    0125*       ld (ix+sprite_y),hl
0465EE             0126*   ; set laser velocity
0465EE 21 00 FC FF 0127*       ld hl,-laser_speed
0465F2 DD 2F 0A    0128*       ld (ix+sprite_yvel),hl
0465F5 C9          0129*       ret
