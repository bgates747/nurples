047797             0020*   tile_activation_routines:
047797 CA 77 04    0021*       dl activate_null_tile ; dummy spacer since tiled is 1-based
04779A 92 7B 04    0022*       dl activate_pad_small
04779D CA 77 04    0023*       dl activate_null_tile
0477A0 CA 77 04    0024*       dl activate_null_tile
0477A3 CA 77 04    0025*       dl activate_null_tile
0477A6 07 7C 04    0026*       dl activate_turret_fireball
0477A9 CA 77 04    0027*       dl activate_null_tile
0477AC CA 77 04    0028*       dl activate_null_tile
0477AF CA 77 04    0029*       dl activate_null_tile
0477B2 98 79 04    0030*       dl activate_electrode
0477B5 39 7B 04    0031*       dl activate_lightning
0477B8 98 79 04    0032*       dl activate_electrode
0477BB CA 77 04    0033*       dl activate_null_tile
0477BE CA 77 04    0034*       dl activate_null_tile
0477C1 CA 77 04    0035*       dl activate_null_tile
0477C4 CA 77 04    0036*       dl activate_null_tile ; tile 15
0477C7 43 79 04    0037*       dl activate_crater ; tile 16
