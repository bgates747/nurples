044D7D 00 00 00    0004*   tileset_ptr_idx: dl 0
044D80             0005*   tileset_ptrs:
044D80             0006*       ; dl tiles_xevious_levels
044D80 34 4F 04    0007*       dl tileset_00_levels
044D83 00 00 00    0008*   tileset_ptrs_end: dl 0 ; list terminator
044D86             0009*   tileset_ptrs_count: equ [tileset_ptrs_end-tileset_ptrs]/3
044D86             0010*   
044D86             0011*   ; get a pointer to the current tileset
044D86             0012*   ; inputs: tileset_ptr_idx
044D86             0013*   ; returns: ix = pointer to tileset levels lut
044D86             0014*   get_tileset_ptr:
044D86 3A 7D 4D 04 0015*       ld a,(tileset_ptr_idx)
044D8A FE 01       0016*       cp tileset_ptrs_count
044D8C DA 95 4D 04 0017*       jp c,@index_valid
044D90 AF          0018*       xor a ; corrupt/out-of-range selectors recover to the first tileset
044D91 32 7D 4D 04 0019*       ld (tileset_ptr_idx),a
044D95             0020*   @index_valid:
044D95 11 00 00 00 0021*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
044D99 57          0022*       ld d,a ; d = tileset index
044D9A 1E 03       0023*       ld e,3 ; three bytes per index record
044D9C ED 5C       0024*       mlt de ; offset into tileset_ptrs lut
044D9E DD 21 80 4D 0025*       ld ix,tileset_ptrs
       04          
044DA3 DD 19       0026*       add ix,de ; ix = pointer to tileset_ptrs record
044DA5 C9          0027*       ret
044DA6             0028*   ; end get_tileset_ptr
044DA6             0029*   
044DA6             0030*   ; intialize a tileset
044DA6             0031*   ; inputs: a = index into tileset_ptrs
044DA6             0032*   init_tileset:
044DA6 32 7D 4D 04 0033*       ld (tileset_ptr_idx),a ; store new tileset index
044DAA CD 86 4D 04 0034*       call get_tileset_ptr ; ix = pointer to tileset_ptrs record
044DAE DD 37 00    0035*       ld ix,(ix) ; ix = pointer to tileset levels lut
044DB1 DD 7E FF    0036*       ld a,(ix-1) ; number of levels in the tileset
044DB4 32 D2 4D 04 0037*       ld (num_levels),a
044DB8 AF          0038*       xor a ; reset current level to zero
044DB9 32 D1 4D 04 0039*       ld (cur_level),a
044DBD C3 32 4E 04 0040*       jp init_level
044DC1             0041*   ; end init_tileset
044DC1             0042*   
044DC1             0043*   next_tileset:
044DC1 3A 7D 4D 04 0044*       ld a,(tileset_ptr_idx)
044DC5 3C          0045*       inc a ; bump to next index
044DC6 FE 01       0046*       cp tileset_ptrs_count
044DC8 DA A6 4D 04 0047*       jp c,init_tileset
044DCC AF          0048*       xor a ; wrap to the first tileset without dereferencing the terminator
044DCD C3 A6 4D 04 0049*       jp init_tileset
044DD1             0050*   ; end next_tileset
044DD1             0051*   
044DD1 00          0052*   cur_level: db 0
044DD2 00          0053*   num_levels: db 0
044DD3             0054*   
044DD3             0055*   ; get a pointer to the current level lookup record
044DD3             0056*   ; inputs: tileset_ptr_idx, cur_level
044DD3             0057*   ; returns: ix = pointer to level definition
044DD3             0058*   get_level_ptr:
044DD3 CD 86 4D 04 0059*       call get_tileset_ptr
044DD7 DD 37 00    0060*       ld ix,(ix) ; ix = pointer to tileset levels lut
044DDA DD 7E FF    0061*       ld a,(ix-1) ; refresh the count after any outer-selector recovery
044DDD 32 D2 4D 04 0062*       ld (num_levels),a
044DE1 47          0063*       ld b,a
044DE2 3A D1 4D 04 0064*       ld a,(cur_level)
044DE6 B8          0065*       cp b
044DE7 DA F0 4D 04 0066*       jp c,@index_valid
044DEB             0067*   @index_invalid:
044DEB AF          0068*       xor a ; corrupt/out-of-range selectors recover to the first level
044DEC 32 D1 4D 04 0069*       ld (cur_level),a
044DF0             0070*   @index_valid:
044DF0 11 00 00 00 0071*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
044DF4 57          0072*       ld d,a ; d = level index
044DF5 1E 03       0073*       ld e,3 ; three bytes per level record
044DF7 ED 5C       0074*       mlt de ; offset into tileset levels lut
044DF9 DD 19       0075*       add ix,de ; ix = pointer to level record
044DFB C9          0076*       ret
044DFC             0077*   ; end get_level_ptr
044DFC             0078*   
044DFC             0079*   ; advance to the next level in the current tileset
044DFC             0080*   ; inputs: tileset_ptr_idx, cur_level
044DFC             0081*   next_level:
044DFC             0082*   ; update starting score
044DFC 2A 52 66 04 0083*       ld hl,(player_score)
044E00 22 55 66 04 0084*       ld (player_starting_score),hl
044E04             0085*   ; refresh the authoritative inner-table count before advancing
044E04 CD 86 4D 04 0086*       call get_tileset_ptr
044E08 DD 37 00    0087*       ld ix,(ix)
044E0B DD 7E FF    0088*       ld a,(ix-1)
044E0E 32 D2 4D 04 0089*       ld (num_levels),a
044E12 47          0090*       ld b,a
044E13             0091*   ; select the next valid level without indexing the terminator
044E13 3A D1 4D 04 0092*       ld a,(cur_level)
044E17 3C          0093*       inc a ; bump to next level
044E18 CA 29 4E 04 0094*       jp z,@advance_tileset ; guard a corrupt 255 index wrapping to zero
044E1C B8          0095*       cp b
044E1D D2 29 4E 04 0096*       jp nc,@advance_tileset
044E21 32 D1 4D 04 0097*       ld (cur_level),a
044E25 C3 32 4E 04 0098*       jp init_level
044E29             0099*   @advance_tileset:
044E29 AF          0100*       xor a
044E2A 32 D1 4D 04 0101*       ld (cur_level),a
044E2E C3 C1 4D 04 0102*       jp next_tileset
044E32             0103*   ; end next_level
044E32             0104*   
044E32             0105*   ; inputs: tileset_ptr_idx, cur_level
044E32             0106*   init_level:
044E32             0107*   ; ; initialize sprites and active tiles table
044E32             0108*   ;     call sprites_init
044E32             0109*   ;     call table_init
044E32             0110*   ;     call tile_table_init
044E32             0111*   ; set pointers
044E32 CD D3 4D 04 0112*       call get_level_ptr ; ix points to level lookup record
044E36 DD 37 00    0113*       ld ix,(ix) ; ix points to level definition
044E39             0114*   ; set tiles_cols
044E39 DD 7E 00    0115*       ld a,(ix+0)
044E3C 32 B0 75 04 0116*       ld (tiles_cols),a
044E40             0117*   ; set tiles_row counter
044E40 DD 7E 01    0118*       ld a,(ix+1)
044E43 32 AD 75 04 0119*       ld (tiles_row),a
044E47 AF          0120*       xor a
044E48 32 B1 75 04 0121*       ld (tiles_level_complete),a
044E4C             0122*   ; set cur_baseBufferId
044E4C DD 27 04    0123*       ld hl,(ix+4)
044E4F 22 B2 75 04 0124*       ld (cur_baseBufferId),hl
044E53             0125*   ; set tiles_row_defs
044E53 ED 32 07    0126*       lea ix,ix+7 ; ix points to definition of first tile of first row
044E56 DD 22 AA 75 0127*       ld (tiles_row_defs),ix
       04          
044E5B             0128*   ; reset tile rows and plot coordinates
044E5B 21 FF FF FF 0129*       ld hl,-1
044E5F 22 D1 76 04 0130*       ld (bg_y_plot),hl
044E63 23          0131*       inc hl
044E64 22 B6 75 04 0132*       ld (tiles_x_plot),hl
044E68 21 F1 FF FF 0133*       ld hl,-15
044E6C 22 BA 75 04 0134*       ld (tiles_y_plot),hl
