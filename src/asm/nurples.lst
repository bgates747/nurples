0411D6             0160*   prt_irq_init:
0411D6             0161*       ; set up interrupt vector table 2
0411D6 21 00 00 00 0162*   	ld hl,0
0411DA 3A 0C 01 00 0163*   	ld a,($10c)
0411DE 6F          0164*   	ld l,a
0411DF 3A 0D 01 00 0165*   	ld a,($10d)
0411E3 67          0166*   	ld h,a
0411E4             0167*   
0411E4             0168*   	; skip over CALL ($c3)
0411E4 23          0169*   	inc hl
0411E5             0170*   	; load address of jump into vector table 2 (in ram)
0411E5 ED 27       0171*   	ld hl,(hl)
0411E7             0172*   
0411E7             0173*   	; write CALL prt_irq_handler to vector table 2
0411E7 3E C3       0174*   	ld a,$c3
0411E9 77          0175*   	ld (hl),a
0411EA 23          0176*   	inc hl
0411EB 11 F2 11 04 0177*   	ld de,prt_irq_handler
0411EF ED 1F       0178*   	ld (hl),de
