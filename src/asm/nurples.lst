041797             0041        include "vdu_buffered_api.inc"
041797             0001*   ; https://agonconsole8.github.io/agon-docs/vdp/Buffered-Commands-API/
041797             0002*   
041797             0003*   ; Command 0: Write block to a buffer
041797             0004*   ; VDU 23, 0, &A0, bufferId; 0, length; <buffer-data>
041797             0005*   ; inputs: hl = bufferId, bc = length of data, de = pointer to data
041797             0006*   vdu_write_block_to_buffer:
041797             0007*   ; back up input parameters
041797 D5          0008*       push de ; pointer to data
041798 C5          0009*       push bc ; length of data
041799             0010*   ; set up the vdu command string
041799 22 B9 17 04 0011*       ld (@bufferId),hl
04179D ED 43 BC 17 0012*       ld (@length),bc
       04          
0417A2 AF          0013*       xor a ; load buffer
0417A3 32 BB 17 04 0014*       ld (@bufferId+2),a
0417A7 21 B6 17 04 0015*       ld hl,@cmd0
0417AB 01 08 00 00 0016*       ld bc,@end0-@cmd0
0417AF 5B DF       0017*       rst.lil $18
0417B1             0018*   ; send the buffer data
0417B1 C1          0019*       pop bc ; length of data
0417B2 E1          0020*       pop hl ; pointer to data (was de)
0417B3 5B DF       0021*       rst.lil $18 ; send it
0417B5 C9          0022*       ret
0417B6             0023*   ; command string data
0417B6 17 00 A0    0024*   @cmd0:      db 23,0,0xA0
0417B9 00 00       0025*   @bufferId:	dw 0x0000
0417BB 00          0026*               db 0 ; load buffer
0417BC 00 00       0027*   @length:	dw 0x0000
0417BE 00          0028*   @end0:      db 0x00 ; padding
0417BF             0029*   ; end vdu_write_block_to_buffer
0417BF             0030*   
0417BF             0031*   ; Command 1: Call a buffer
0417BF             0032*   ; VDU 23, 0, &A0, bufferId; 1
0417BF             0033*   ; inputs: hl = bufferId
0417BF             0034*   vdu_call_buffer:
0417BF 22 D7 17 04 0035*       ld (@bufferId),hl
0417C3 3E 01       0036*       ld a,1 ; call buffer
0417C5 32 D9 17 04 0037*       ld (@bufferId+2),a
0417C9 21 D4 17 04 0038*       ld hl,@cmd
0417CD 01 06 00 00 0039*       ld bc,@end-@cmd
0417D1 5B DF       0040*       rst.lil $18
0417D3 C9          0041*       ret
0417D4 17 00 A0    0042*   @cmd:     db 23,0,0xA0
0417D7 00 00       0043*   @bufferId: dw 0x0000
0417D9 01          0044*              db 1 ; call buffer
0417DA             0045*   @end:
0417DA             0046*   ; end vdu_call_buffer
0417DA             0047*   
0417DA             0048*   ; Command 2: Clear a buffer
0417DA             0049*   ; VDU 23, 0 &A0, bufferId; 2
0417DA             0050*   ; inputs: hl = bufferId
0417DA             0051*   vdu_clear_buffer:
0417DA 22 F2 17 04 0052*       ld (@bufferId),hl
0417DE 3E 02       0053*       ld a,2 ; clear buffer
0417E0 32 F4 17 04 0054*       ld (@bufferId+2),a
0417E4 21 EF 17 04 0055*       ld hl,@cmd
0417E8 01 06 00 00 0056*       ld bc,@end-@cmd
0417EC 5B DF       0057*       rst.lil $18
0417EE C9          0058*       ret
0417EF 17 00 A0    0059*   @cmd:     db 23,0,0xA0
0417F2 00 00       0060*   @bufferId: dw 0x0000
0417F4 02          0061*              db 2 ; clear buffer
0417F5             0062*   @end:
0417F5             0063*   ; end vdu_clear_buffer
0417F5             0064*   
0417F5             0065*   ; Clear all buffers
0417F5             0066*   ; inputs: none
0417F5             0067*   vdu_clear_all_buffers:
0417F5             0068*   ; clear all buffers
0417F5 21 00 18 04 0069*       ld hl,@beg
0417F9 01 06 00 00 0070*       ld bc,@end-@beg
0417FD 5B DF       0071*       rst.lil $18
0417FF C9          0072*       ret
041800 17 00 A0    0073*   @beg: db 23,0,$A0
041803 FF FF       0074*         dw -1 ; bufferId -1 (65535) means clear all buffers
041805 02          0075*         db 2  ; command 2: clear a buffer
041806             0076*   @end:
041806             0077*   ; end vdu_clear_all_buffers
041806             0078*   
041806             0079*   ; Command 3: Create a writeable buffer
041806             0080*   ; VDU 23, 0 &A0, bufferId; 3, length;
041806             0081*   ; inputs: hl = bufferId, bc = length
041806             0082*   vdu_create_writeable_buffer:
041806 22 23 18 04 0083*       ld (@bufferId),hl
04180A ED 43 26 18 0084*       ld (@length),bc
       04          
04180F 3E 03       0085*       ld a,3 ; create writeable buffer
041811 32 25 18 04 0086*       ld (@bufferId+2),a
041815 21 20 18 04 0087*       ld hl,@cmd
041819 01 08 00 00 0088*       ld bc,@end-@cmd
04181D 5B DF       0089*       rst.lil $18
04181F C9          0090*       ret
041820 17 00 A0    0091*   @cmd:     db 23,0,0xA0
041823 00 00       0092*   @bufferId: dw 0x0000
041825 03          0093*              db 3 ; create writeable buffer
041826 00 00       0094*   @length: dw 0x0000
041828 00          0095*   @end:     db 0x00 ; padding
041829             0096*   ; end vdu_create_writeable_buffer
041829             0097*   
041829             0098*   ; Command 4: Set output stream to a buffer
041829             0099*   ; VDU 23, 0 &A0, bufferId; 4
041829             0100*   ; inputs: hl = bufferId
041829             0101*   vdu_set_output_stream_buffer:
041829 22 41 18 04 0102*       ld (@bufferId),hl
04182D 3E 04       0103*       ld a,4 ; set output stream to buffer
04182F 32 43 18 04 0104*       ld (@bufferId+2),a
041833 21 3E 18 04 0105*       ld hl,@cmd
041837 01 06 00 00 0106*       ld bc,@end-@cmd
04183B 5B DF       0107*       rst.lil $18
04183D C9          0108*       ret
04183E 17 00 A0    0109*   @cmd:     db 23,0,0xA0
041841 00 00       0110*   @bufferId: dw 0x0000
041843 04          0111*              db 4 ; set output stream to buffer
041844 00          0112*   @end:     db 0x00 ; padding
041845             0113*   ; end vdu_set_output_stream_buffer
041845             0114*   
041845             0115*   ; Command 5: Adjust buffer contents
041845             0116*   ; VDU 23, 0, &A0, bufferId; 5, operation, offset; [count;] <operand>, [arguments]
041845             0117*   vdu_adjust_buffer:
041845 C9          0118*       ret ; TODO: implement
041846             0119*   ; end vdu_adjust_buffer
041846             0120*   
041846             0121*   ; Command 6: Conditionally call a buffer
041846             0122*   ; VDU 23, 0, &A0, bufferId; 6, operation, checkBufferId; checkOffset; [arguments]
041846             0123*   vdu_call_buffer_conditional:
041846 C9          0124*       ret ; TODO: implement
041847             0125*   ; end vdu_call_buffer_conditional
041847             0126*   
041847             0127*   ; Command 7: Jump to a buffer
041847             0128*   ; VDU 23, 0, &A0, bufferId; 7
041847             0129*   ; inputs: hl = bufferId
041847             0130*   vdu_jump_to_buffer:
041847 22 5F 18 04 0131*       ld (@bufferId),hl
04184B 3E 07       0132*       ld a,7 ; jump to buffer
04184D 32 61 18 04 0133*       ld (@bufferId+2),a
041851 21 5C 18 04 0134*       ld hl,@cmd
041855 01 06 00 00 0135*       ld bc,@end-@cmd
041859 5B DF       0136*       rst.lil $18
04185B C9          0137*       ret
04185C 17 00 A0    0138*   @cmd:     db 23,0,0xA0
04185F 00 00       0139*   @bufferId: dw 0x0000
041861 07          0140*              db 7 ; jump to buffer
041862 00          0141*   @end:     db 0x00 ; padding
041863             0142*   ; end vdu_jump_to_buffer
041863             0143*   
041863             0144*   ; Command 8: Conditional Jump to a buffer
041863             0145*   ; VDU 23, 0, &A0, bufferId; 8, operation, checkBufferId; checkOffset; [arguments]
041863             0146*   vdu_jump_to_buffer_conditional:
041863 C9          0147*       ret ; TODO: implement
041864             0148*   ; end vdu_jump_to_buffer_conditional
041864             0149*   
041864             0150*   ; Command 9: Jump to an offset in a buffer
041864             0151*   ; VDU 23, 0, &A0, bufferId; 9, offset; offsetHighByte, [blockNumber;]
041864             0152*   vdu_jump_to_buffer_offset:
041864 C9          0153*       ret ; TODO: implement
041865             0154*   ; end vdu_jump_to_buffer_offset
041865             0155*   
041865             0156*   ; Command 10: Conditional jump to an offset in a buffer
041865             0157*   ; VDU 23, 0, &A0, bufferId; 10, offset; offsetHighByte, [blockNumber;] [arguments]
041865             0158*   vdu_jump_to_buffer_offset_conditional:
041865 C9          0159*       ret ; TODO: implement
041866             0160*   ; end vdu_jump_to_buffer_offset_conditional
041866             0161*   
041866             0162*   ; Command 11: Call buffer with an offset
041866             0163*   ; VDU 23, 0, &A0, bufferId; 11, offset; offsetHighByte, [blockNumber;]
041866             0164*   vdu_call_buffer_offset:
041866 C9          0165*       ret ; TODO: implement
041867             0166*   ; end vdu_call_buffer_offset
