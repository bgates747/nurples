048908             0089*   ; affects: on success, bumps num_active_tiles by one, adds a tile pointer to the top of the tile stack
048908             0090*   tile_table_get_next_id:
048908             0091*   ; The byte-sized active count deliberately caps the dense stack at 255 entries.
048908 3A AC 88 04 0092*       ld a,(num_active_tiles)
04890C 3C          0093*       inc a
04890D CA 32 89 04 0094*       jp z,@not_found
048911             0095*   ; Search the entire ring rather than assuming the next physical record is free.
048911 06 00       0096*       ld b,0 ; DJNZ with zero visits all 256 tile records
048913 3A AF 88 04 0097*       ld a,(next_tile_id)
