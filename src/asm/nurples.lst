046A0D             0465*   move_sprite:
046A0D FD 2A 07 67 0466*       ld iy,(table_pointer)
       04          
046A12             0467*   ; x-axis movement
046A12 FD 27 01    0468*       ld hl,(iy+sprite_x)
046A15 FD 17 07    0469*       ld de,(iy+sprite_xvel)
