047D4C             0008*   player_air: equ 6
047D4C             0009*   player_ground: equ 7
047D4C             0010*   
047D4C             0011*   ; ###### SPRITE TABLE FIELD INDICES ######
047D4C             0012*   table_record_size:         equ  64; bytes per sprite record
047D4C             0013*   sprite_id:                 equ   0; 1 bytes ;unique spriteId, zero-based
047D4C             0014*   ; sprite state variables
047D4C             0015*   sprite_state_variables:    equ   1; beginning of sprite state variables
047D4C             0016*   sprite_x:                  equ   1; 3 bytes ;16.8 fractional x position in pixels
047D4C             0017*   sprite_y:                  equ   4; 3 bytes ;16.8 fractional y position in pixels
047D4C             0018*   sprite_xvel:               equ   7; 3 bytes ;x-component velocity, 16.8 fixed, pixels
047D4C             0019*   sprite_yvel:               equ  10; 3 bytes ;y-component velocity, 16.8 fixed, pixels
047D4C             0020*   sprite_vel:                equ  13; 3 bytes ;velocity px/frame (16.8 fixed)
047D4C             0021*   sprite_heading:            equ  16; 3 bytes ;sprite movement direction deg256 16.8 fixed
047D4C             0022*   sprite_orientation:        equ  19; 3 bytes ;orientation bits
047D4C             0023*   ; sprite definition variables
047D4C             0024*   sprite_definitions:        equ  22; beginnning of sprite definition variables
047D4C             0025*   sprite_type:               equ  22; 1 bytes ;type of sprite as defined in enemies.inc
047D4C             0026*   sprite_base_bufferId:      equ  23; 3 bytes ;bitmap bufferId
047D4C             0027*   sprite_move_program:       equ  26; 3 bytes ;address of sprite's behavior subroutine
047D4C             0028*   sprite_collisions:         equ  29; 1 bytes ;see collisions.inc constants for bit definitions
047D4C             0029*   sprite_dim_x:              equ  30; 1 bytes ;sprite width in pixels
047D4C             0030*   sprite_dim_y:              equ  31; 1 bytes ;sprite height in pixels
047D4C             0031*   sprite_num_orientations:   equ  32; 1 bytes ;number of orientations for this sprite
047D4C             0032*   sprite_num_animations:     equ  33; 1 bytes ;number of animations for this sprite
