048143             0144*   
048143             0145*   ; gets the next available sprite id for a particular sprite group
048143             0146*   ; inputs; ix = pointer to sprite group, b = number of records in sprite group
048143             0147*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
048143             0148*   ;      otherwise, a = 0, carry flag reset, ix pointing to highest sprite vars
048143             0149*   ; destroys: a,b,c,hl,ix
048143             0150*   table_get_next_id:
048143             0151*   @loop:
048143 DD CB 1D 76 0152*       bit sprite_alive,(ix+sprite_collisions)
048147 28 07       0153*       jr z,@found
048149 ED 32 40    0154*       lea ix,ix+table_record_size
04814C 10 F5       0155*       djnz @loop
04814E             0156*   @notfound:
04814E AF          0157*       xor a ; a = 0 and reset carry flag indicating that we didn't find a free sprite
04814F C9          0158*       ret
048150             0159*   @found:
048150             0160*   ; return sprite id
048150 DD 7E 00    0161*       ld a,(ix+sprite_id)
048153 37          0162*       scf ; sets carry flag indicating we found a free sprite
048154 C9          0163*       ret ; done
048155             0164*   ; end table_get_next_id
048155             0165*   
048155             0166*   ; create a new sprite at the prescribed coordinates
048155             0167*   ; inputs: hl = pointer to new sprite default settings, ub.c, ud.e = x,y position
048155             0168*   ;         ix = pointer to sprite group, a = number of records in sprite group
048155             0169*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
048155             0170*   ;      otherwise, a = 0, carry flag reset, ix pointing to highest sprite vars
048155             0171*   spawn_sprite_from_coords:
048155 ED 43 8F 81 0172*       ld (@sprite_x),bc ; store x-coordinate
       04          
04815A ED 53 92 81 0173*       ld (@sprite_y),de ; store y-coordinate
       04          
04815F 47          0174*       ld b,a ; number of records in sprite group
048160 E5          0175*       push hl ; back up pointer to new sprite defaults
048161 CD 43 81 04 0176*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
048165 E1          0177*       pop hl ; restore pointer to new sprite defaults
048166 D0          0178*       ret nc ; no carry means no free sprite slots, so we go home
048167             0179*   ; copy default settings to new sprite
048167 DD E5       0180*       push ix ; back up pointer to new sprite record
048169 ED 32 16    0181*       lea ix,ix+sprite_definitions ; bump pointer to copy to
04816C DD E5       0182*       push ix ; pointer to default sprite settings
04816E D1          0183*       pop de ; address to copy to
04816F 01 2A 00 00 0184*       ld bc,table_record_size-sprite_definitions ; number of bytes to copy
048173 ED B0       0185*       ldir ; copies defaults to new sprite record
048175 DD E1       0186*       pop ix ; restore pointer to new sprite record
048177             0187*   ; copy sprite position from existing sprite
048177 2A 8F 81 04 0188*       ld hl,(@sprite_x)
04817B DD 2F 01    0189*       ld (ix+sprite_x),hl
04817E 2A 92 81 04 0190*       ld hl,(@sprite_y)
048182 DD 2F 04    0191*       ld (ix+sprite_y),hl
048185             0192*   ; return to caller
048185 DD CB 16 FE 0193*       set 7,(ix+sprite_type) ; set just spawned flag
048189 DD CB 1D F6 0194*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
04818D 37          0195*       scf ; set carry flag to indicate success
04818E C9          0196*       ret
04818F 00 00 00    0197*   @sprite_x: dl 0 ; new sprite x-coordinate
048192 00 00 00    0198*   @sprite_y: dl 0 ; new sprite y-coordinate
048195             0199*   ; end spawn_sprite_from_coords
048195             0200*   
048195             0201*   ; create a new sprite at the same location as an existing sprite
048195             0202*   ; inputs: hl = pointer to new sprite default settings, table_pointer = existing sprite
048195             0203*   ;         ix = pointer to sprite group, b = number of records in sprite group
048195             0204*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
048195             0205*   ;      otherwise, a = 0, carry flag reset, ix pointing to highest sprite vars
048195             0206*   spawn_sprite_from_sprite:
048195 E5          0207*       push hl ; back up pointer to new sprite defaults
048196 CD 43 81 04 0208*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
04819A E1          0209*       pop hl ; restore pointer to new sprite defaults
04819B D0          0210*       ret nc ; no carry means no free sprite slots, so we go home
04819C             0211*   ; copy default settings to new sprite
04819C DD E5       0212*       push ix ; back up pointer to new sprite record
04819E ED 32 16    0213*       lea ix,ix+sprite_definitions ; bump pointer to copy to
0481A1 DD E5       0214*       push ix ; pointer to default sprite settings
0481A3 D1          0215*       pop de ; address to copy to
0481A4 01 2A 00 00 0216*       ld bc,table_record_size-sprite_definitions ; number of bytes to copy
0481A8 ED B0       0217*       ldir ; copies defaults to new sprite record
0481AA DD E1       0218*       pop ix ; restore pointer to new sprite record
0481AC             0219*   ; copy sprite position from existing sprite
0481AC FD 2A 98 80 0220*       ld iy,(table_pointer) ; get existing sprite record
       04          
0481B1 FD 27 01    0221*       ld hl,(iy+sprite_x)
0481B4 DD 2F 01    0222*       ld (ix+sprite_x),hl
0481B7 FD 27 04    0223*       ld hl,(iy+sprite_y)
0481BA DD 2F 04    0224*       ld (ix+sprite_y),hl
0481BD             0225*   ; return to caller
0481BD DD CB 16 FE 0226*       set 7,(ix+sprite_type) ; set just spawned flag
0481C1 DD CB 1D F6 0227*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
0481C5 37          0228*       scf ; set carry flag to indicate success
0481C6 C9          0229*       ret
0481C7             0230*   ; end spawn_sprite_from_sprite
0481C7             0231*   
0481C7             0232*   ; call the behavior subroutines for a specified sprite group
0481C7             0233*   ; inputs: iy = pointer to sprite group, b = number of records in sprite group
0481C7             0234*   move_sprite_group:
0481C7 C5          0235*       push bc ; backup loop counter
0481C8 FD E5       0236*       push iy ; backup table pointer
0481CA             0237*   @move_loop:
0481CA FD 22 98 80 0238*       ld (table_pointer),iy ; update table pointer
       04          
0481CF C5          0239*       push bc ; backup loop counter
0481D0             0240*   ; check top bit of sprite_type to see if sprite is just spawned
0481D0 FD CB 16 7E 0241*       bit 7,(iy+sprite_type)
0481D4 C2 09 82 04 0242*       jp nz,@next_record ; if just spawned, skip to next record
0481D8             0243*   ; check sprite_just_died bit
0481D8 FD CB 1D 7E 0244*       bit sprite_just_died,(iy+sprite_collisions)
0481DC C2 40 82 04 0245*       jp nz,@sprite_died ; if just died, deactivate sprite
0481E0             0246*   ; check sprite_alive bit to see if sprite is active
0481E0 FD CB 1D 76 0247*       bit sprite_alive,(iy+sprite_collisions)
0481E4 CA 09 82 04 0248*       jp z,@next_record ; ... skip to next record
0481E8             0249*   ; otherwise move the sprite
0481E8 FD 27 1A    0250*       ld hl,(iy+sprite_move_program) ; load the behavior subroutine address
0481EB             0251*       CALL_HL ; run the behavior subroutine
                       M1 Args: none
0481EB 01 F1 81 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
0481EF C5          0002*M1     push bc ; which constitutes the return address
0481F0 E9          0003*M1     jp (hl) ; Jump to the address in HL
0481F1 FD 7E 00    0252*       ld a,(iy+sprite_id) ; get spriteId
0481F4 CD D7 18 04 0253*       call vdu_sprite_select ; select sprite
0481F8 FD 7E 28    0254*       ld a,(iy+sprite_frame)
0481FB CD 3A 19 04 0255*       call vdu_sprite_select_frame
0481FF FD 07 01    0256*       ld bc,(iy+sprite_x)
048202 FD 17 04    0257*       ld de,(iy+sprite_y)
048205 CD A3 19 04 0258*       call vdu_sprite_move_abs168
048209             0259*   ; fall through to @next_record
048209             0260*   @next_record:
048209 ED 33 40    0261*       lea iy,iy+table_record_size
04820C AF          0262*       xor a ; clears carry flag
04820D 32 9B 80 04 0263*       ld (sprite_screen_edge),a ; clear screen edge collision flag
048211 C1          0264*       pop bc ; get back our loop counter
048212 10 B6       0265*       djnz @move_loop ; loop until we've checked all the records
048214             0266*   ; reset all just spawned flags
048214 FD E1       0267*       pop iy ; get back table pointer
048216 C1          0268*       pop bc ; get back loop counter
048217             0269*   @reset_just_spawned:
048217 C5          0270*       push bc ; back up loop counter
048218 FD CB 16 7E 0271*       bit 7,(iy+sprite_type) ; check if just spawned
04821C CA 39 82 04 0272*       jp z,@F
048220 FD CB 16 BE 0273*       res 7,(iy+sprite_type) ; clear just spawned flag
048224 FD 7E 00    0274*       ld a,(iy+sprite_id)
048227 CD D7 18 04 0275*       call vdu_sprite_select
04822B FD 07 01    0276*       ld bc,(iy+sprite_x)
04822E FD 17 04    0277*       ld de,(iy+sprite_y)
048231 CD A3 19 04 0278*       call vdu_sprite_move_abs168
048235 CD 4D 19 04 0279*       call vdu_sprite_show
048239             0280*   @@:
048239 ED 33 40    0281*       lea iy,iy+table_record_size
04823C C1          0282*       pop bc ; get back loop counter
04823D 10 D8       0283*       djnz @reset_just_spawned
04823F C9          0284*       ret
048240             0285*   @sprite_died:
048240 CD E1 80 04 0286*       call table_deactivate_sprite
048244 C3 09 82 04 0287*       jp @next_record
048248             0288*   ; end move_sprite_group
048248             0289*   
048248             0290*   ; update behavior subroutines for a specified sprite group
048248             0291*   ; inputs: hl = pointer to move program, iy = pointer to sprite group, b = number of records in sprite group
048248             0292*   change_sprite_group_move_program:
048248             0293*   @update_loop:
048248             0294*   ; check sprite_alive bit to see if sprite is active
048248 FD CB 1D 76 0295*       bit sprite_alive,(iy+sprite_collisions)
04824C CA 57 82 04 0296*       jp z,@next_record ; ... skip to next record
048250             0297*   ; otherwise load the behavior subroutine address
048250 FD 2F 1A    0298*       ld (iy+sprite_move_program),hl
048253             0299*    ; clear just spawned flag
048253 FD CB 16 BE 0300*       res 7,(iy+sprite_type)
048257             0301*   ; fall through to @next_record
048257             0302*   @next_record:
048257 ED 33 40    0303*       lea iy,iy+table_record_size
04825A 10 EC       0304*       djnz @update_loop ; loop until we've checked all the records
04825C C9          0305*       ret
04825D             0306*   ; end change_sprite_group_move_program
04825D             0307*   
04825D             0308*   ; compute a sprite's new position based on its component x,y velocities
04825D             0309*   ; with screen boundary checking and update its sprite table record accordingly
04825D             0310*   ; inputs: table_pointer set to sprite record
04825D             0311*   ; returns: updated x, y positions and edge collision flags in sprite_screen_edge
04825D             0312*   ; destroys: everything
04825D             0313*   ; note: actual rendering of sprite must be handled by caller
04825D             0314*   move_sprite:
04825D FD 2A 98 80 0315*       ld iy,(table_pointer)
       04          
048262             0316*   ; x-axis movement
048262 FD 27 01    0317*       ld hl,(iy+sprite_x)
048265 FD 17 07    0318*       ld de,(iy+sprite_xvel)
048268 19          0319*       add hl,de
048269 FD 2F 01    0320*       ld (iy+sprite_x),hl
04826C             0321*   ; y-axis movement
04826C FD 27 04    0322*       ld hl,(iy+sprite_y)
04826F FD 17 0A    0323*       ld de,(iy+sprite_yvel)
048272 19          0324*       add hl,de
048273 FD 2F 04    0325*       ld (iy+sprite_y),hl
048276             0326*   ; detect screen edge collisions
048276 AF          0327*       xor a ; reset screen edge collision flag and clear carry
048277 32 9B 80 04 0328*       ld (sprite_screen_edge),a
04827B             0329*   ; y-axis first since we already have it in hl
04827B 11 00 00 00 0330*       ld de,-sprite_top*256
04827F ED 5A       0331*       adc hl,de
048281 FA AB 82 04 0332*       jp m,@top
048285 ED 52       0333*       sbc hl,de ; hl back to original value
048287 11 00 C0 FE 0334*       ld de,-sprite_bottom*256
04828B ED 5A       0335*       adc hl,de
04828D F2 B5 82 04 0336*       jp p,@bottom
048291             0337*   @xaxis:
048291 FD 27 01    0338*       ld hl,(iy+sprite_x)
048294 11 00 00 00 0339*       ld de,-sprite_left*256
048298 ED 5A       0340*       adc hl,de
04829A FA D0 82 04 0341*       jp m,@left
04829E ED 52       0342*       sbc hl,de ; hl back to original value
0482A0 11 00 10 FF 0343*       ld de,-sprite_right*256
0482A4 ED 5A       0344*       adc hl,de
0482A6 F2 DE 82 04 0345*       jp p,@right
0482AA             0346*   ; no edge collisions so go home
0482AA C9          0347*       ret
0482AB             0348*   @top:
0482AB 3E 08       0349*       ld a,collide_top
0482AD 21 00 00 00 0350*       ld hl,sprite_top*256
0482B1 C3 BB 82 04 0351*       jp @collide_y
0482B5             0352*   @bottom:
0482B5 3E 04       0353*       ld a,collide_bottom
0482B7 21 00 40 01 0354*       ld hl,sprite_bottom*256
0482BB             0355*   @collide_y:
0482BB 32 9B 80 04 0356*       ld (sprite_screen_edge),a
0482BF FD 2F 04    0357*       ld (iy+sprite_y),hl
0482C2             0358*   ; reverse y-axis velocity
0482C2 FD 27 0A    0359*       ld hl,(iy+sprite_yvel)
0482C5 CD 7C 04 04 0360*       call neg_hlu
0482C9 FD 2F 0A    0361*       ld (iy+sprite_yvel),hl
0482CC             0362*   ; go check for x-axis collisions
0482CC C3 91 82 04 0363*       jp @xaxis
0482D0             0364*   @left:
0482D0 3A 9B 80 04 0365*       ld a,(sprite_screen_edge)
0482D4 F6 02       0366*       or a,collide_left
0482D6 21 00 00 00 0367*       ld hl,sprite_left*256
0482DA C3 E8 82 04 0368*       jp @collide_x
0482DE             0369*   @right:
0482DE 3A 9B 80 04 0370*       ld a,(sprite_screen_edge)
0482E2 F6 01       0371*       or a,collide_right
0482E4 21 00 F0 00 0372*       ld hl,sprite_right*256
0482E8             0373*   @collide_x:
0482E8 32 9B 80 04 0374*       ld (sprite_screen_edge),a
0482EC FD 2F 01    0375*       ld (iy+sprite_x),hl
0482EF             0376*   ; reverse x-axis velocity
0482EF FD 27 07    0377*       ld hl,(iy+sprite_xvel)
0482F2 CD 7C 04 04 0378*       call neg_hlu
0482F6 FD 2F 07    0379*       ld (iy+sprite_xvel),hl
0482F9             0380*   ; final collision flag to a and return
0482F9 3A 9B 80 04 0381*       ld a,(sprite_screen_edge)
0482FD C9          0382*       ret
0482FE             0383*   ; end move_sprite
