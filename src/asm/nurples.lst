0492B9 D8 92 04    0004*       dl move_crater          ; move_program
0492BC 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
0492BD 10          0006*       db 16                   ; dim_x
0492BE 10          0007*       db 16                   ; dim_y
0492BF 01          0008*       db 1                    ; num_orientations
0492C0 04          0009*       db 4                    ; num_animations
0492C1 05          0010*       db 5	                ; animation
0492C2 08          0011*       db 8                    ; animation_timer
0492C3 00          0012*       db 0                    ; move_timer
0492C4 00          0013*       db 0                    ; move_step
0492C5 00          0014*       db 0                    ; points
0492C6 00          0015*       db 0                    ; shield_damage
0492C7 00          0016*       db 0                    ; frame
