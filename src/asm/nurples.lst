0413B2             0095*   ; COLOUR MODES
0413B2             0096*   ; Mode	Effect
0413B2             0097*   ; 0	Set on-screen pixel to target colour value
0413B2             0098*   ; 1	OR value with the on-screen pixel
0413B2             0099*   ; 2	AND value with the on-screen pixel
0413B2             0100*   ; 3	XOR value with the on-screen pixel
0413B2             0101*   ; 4	Invert the on-screen pixel
0413B2             0102*   ; 5	No operation
0413B2             0103*   ; 6	AND the inverse of the specified colour with the on-screen pixel
0413B2             0104*   ; 7	OR the inverse of the specified colour with the on-screen pixel
0413B2             0105*   
