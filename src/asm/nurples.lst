047F17             0054*   ; define laser sprites
047F17             0055*   @sprites_loop:
047F17 F5          0056*       push af
047F18 D5          0057*       push de
047F19 CD DD 18 04 0058*   	call vdu_sprite_select
047F1D CD F0 18 04 0059*   	call vdu_sprite_clear_frames
047F21 21 4E 01 00 0060*   	ld hl,BUF_LASER_A
047F25 06 02       0061*   	ld b,2 ; two bitmaps for laser
047F27             0062*   @frames_loop:
