041462 01 05 00 00 0186*       ld bc,@end-@cmd
041466 5B DF       0187*       rst.lil $18
041468 C9          0188*       ret
041469 1D          0189*   @cmd:   db 29 ; set graphics origin command
04146A 00 00       0190*   @x0: 	dw 0x0000 ; set by bc
04146C 00 00       0191*   @y0: 	dw 0x0000 ; set by de
