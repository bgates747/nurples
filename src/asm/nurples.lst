049DE4             0087        include "telemetry.inc"
049DE4             0001*   ; Purple Nurples stable runtime telemetry ABI, version 1.
049DE4             0002*   ;
049DE4             0003*   ; Host readers use telemetry_write_seq as a seqlock: read an even sequence,
049DE4             0004*   ; copy telemetry_size bytes, then accept the copy only if the sequence is still
049DE4             0005*   ; the same even value. All multi-byte values are little-endian.
049DE4             0006*   
049DE4             0007*   TELEMETRY_VERSION_MAJOR: equ 1
049DE4             0008*   TELEMETRY_VERSION_MINOR: equ 0
049DE4             0009*   TELEMETRY_FLAG_LEGACY_POINTER_BRIDGE: equ 0
049DE4             0010*   TELEMETRY_FLAG_SESSION_VALID: equ 1
049DE4             0011*   TELEMETRY_FLAG_LEVEL_VALID: equ 2
049DE4             0012*   TELEMETRY_FLAG_ACTORS_VALID: equ 3
049DE4             0013*   
049DE4             0014*   TELEMETRY_LIFECYCLE_RESPAWN:     equ %00000001
049DE4             0015*   TELEMETRY_LIFECYCLE_PLAYER_DEAD: equ %00000010
049DE4             0016*   TELEMETRY_DISPATCH_IDLE: equ 0
049DE4             0017*   
049DE4             0018*   TELEMETRY_OUTCOME_RUNNING:          equ 0
049DE4             0019*   TELEMETRY_OUTCOME_LEVEL_TRANSITION: equ 1
049DE4             0020*   TELEMETRY_OUTCOME_GAME_OVER:        equ 2
049DE4             0021*   TELEMETRY_OUTCOME_VICTORY:          equ 3
049DE4             0022*   TELEMETRY_OUTCOME_EXIT:             equ 4
049DE4             0023*   TELEMETRY_OUTCOME_FAULT:            equ 5
049DE4             0024*   TELEMETRY_OUTCOME_RESPAWN:          equ 6
049DE4             0025*   TELEMETRY_OUTCOME_PLAYER_DEAD:      equ 7
049DE4             0026*   
049DE4             0027*   telemetry_begin:
049DE4 50 4E 53 54 0028*   telemetry_magic:                    db "PNST" ; 00
049DE8 01          0029*   telemetry_version_major:            db TELEMETRY_VERSION_MAJOR ; 04
049DE9 00          0030*   telemetry_version_minor:            db TELEMETRY_VERSION_MINOR ; 05
049DEA 50 00       0031*   telemetry_size:                     dw telemetry_end-telemetry_begin ; 06
049DEC 01          0032*   telemetry_write_seq:                db 1 ; 08; invalid until telemetry_init completes
049DED 00          0033*   telemetry_flags:                    db 0 ; 09
049DEE 00 00 00 00 0034*   telemetry_header_reserved:          db 0,0,0,0,0,0 ; 0A
       00 00       
049DF4             0035*   
049DF4 FF          0036*   telemetry_global_current:           db STATE_NEW_NONE ; 10
049DF5 FF          0037*   telemetry_global_previous:          db STATE_NEW_NONE ; 11
049DF6 FF          0038*   telemetry_global_pending:           db STATE_NEW_NONE ; 12
049DF7 00          0039*   telemetry_global_policy:            db 0 ; 13
049DF8 00          0040*   telemetry_dispatcher_phase:         db TELEMETRY_DISPATCH_IDLE ; 14
049DF9 00          0041*   telemetry_outcome:                  db TELEMETRY_OUTCOME_RUNNING ; 15
049DFA FF          0042*   telemetry_player_current:           db STATE_NEW_NONE ; 16
049DFB FF          0043*   telemetry_player_previous:          db STATE_NEW_NONE ; 17
049DFC FF          0044*   telemetry_player_pending:           db STATE_NEW_NONE ; 18
049DFD 00          0045*   telemetry_player_dying_phase:       db 0 ; 19
049DFE 00          0046*   telemetry_player_dying_timer:       db 0 ; 1A
049DFF 00          0047*   telemetry_player_dying_spawns:      db 0 ; 1B
049E00 FF          0048*   telemetry_enemies_current:          db STATE_NEW_NONE ; 1C
049E01 FF          0049*   telemetry_enemies_previous:         db STATE_NEW_NONE ; 1D
049E02 FF          0050*   telemetry_enemies_pending:          db STATE_NEW_NONE ; 1E
049E03 00          0051*   telemetry_last_lifecycle_events:    db 0 ; 1F
049E04             0052*   
049E04 00 00 00    0053*   telemetry_total_frames:             dl 0 ; 20
049E07 00 00 00    0054*   telemetry_global_state_frames:      dl 0 ; 23
049E0A 00 00 00    0055*   telemetry_global_transition_serial: dl 0 ; 26
049E0D 00 00 00    0056*   telemetry_player_state_frames:      dl 0 ; 29
049E10 00 00 00    0057*   telemetry_player_transition_serial: dl 0 ; 2C
049E13 00 00 00    0058*   telemetry_enemies_state_frames:     dl 0 ; 2F
049E16 00 00 00    0059*   telemetry_enemies_transition_serial: dl 0 ; 32
049E19 00          0060*   telemetry_pending_events:           db 0 ; 35
049E1A 00          0061*   telemetry_frame_events:             db 0 ; 36
049E1B 00          0062*   telemetry_last_transition_events:   db 0 ; 37
049E1C 00          0063*   telemetry_events_seen:              db 0 ; 38
049E1D 00 00 00    0064*   telemetry_lifecycle_serial:         dl 0 ; 39
049E20             0065*   
049E20 00 00       0066*   telemetry_fault_domains:            dw 0 ; 3C
049E22 00          0067*   telemetry_fault_game:               db 0 ; 3E
049E23 00          0068*   telemetry_fault_player:             db 0 ; 3F
049E24 00          0069*   telemetry_fault_enemies:            db 0 ; 40
049E25 00          0070*   telemetry_fault_sprite:             db 0 ; 41
049E26 00          0071*   telemetry_fault_tile:               db 0 ; 42
049E27 00          0072*   telemetry_fault_timer:              db 0 ; 43
049E28 00          0073*   telemetry_fault_vdu:                db 0 ; 44
049E29 00          0074*   telemetry_fault_coordinator:        db 0 ; 45
049E2A 00          0075*   telemetry_fault_player_controller:  db 0 ; 46
049E2B 00          0076*   telemetry_fault_enemy_controller:   db 0 ; 47
049E2C 00          0077*   telemetry_fault_telemetry:          db 0 ; 48
049E2D 00          0078*   telemetry_player_ships:             db 0 ; 49
049E2E 00          0079*   telemetry_player_shields:           db 0 ; 4A
049E2F 00          0080*   telemetry_tileset:                  db 0 ; 4B
049E30 00          0081*   telemetry_level:                    db 0 ; 4C
049E31 00 00 00    0082*   telemetry_rows_remaining:           dl 0 ; 4D
049E34             0083*   telemetry_end:
049E34             0084*   
049E34             0085*   ; Producer-side latches are deliberately outside the public ABI. Callers can
049E34             0086*   ; post between snapshots without making an even public snapshot incoherent.
049E34 00          0087*   telemetry_event_latch:             db 0
049E35 00          0088*   telemetry_lifecycle_latch:         db 0
049E36 00          0089*   telemetry_forced_outcome:          db 0
049E37 00          0090*   telemetry_count_frame:             db 0
049E38 00          0091*   telemetry_legacy_phase:            db STATE_NEW_BOOT
049E39             0092*   
049E39             0093*   ; Stable byte offsets exported alongside label symbols.
049E39             0094*   TELEMETRY_OFFSET_WRITE_SEQ: equ telemetry_write_seq-telemetry_begin
049E39             0095*   TELEMETRY_OFFSET_GLOBAL_CURRENT: equ telemetry_global_current-telemetry_begin
049E39             0096*   TELEMETRY_OFFSET_PLAYER_CURRENT: equ telemetry_player_current-telemetry_begin
049E39             0097*   TELEMETRY_OFFSET_ENEMIES_CURRENT: equ telemetry_enemies_current-telemetry_begin
049E39             0098*   TELEMETRY_OFFSET_FAULT_DOMAINS: equ telemetry_fault_domains-telemetry_begin
049E39             0099*   
049E39             0100*   ; Inputs: A = one or more STATE_NEW_EVENT_* bits.
049E39             0101*   ; Destroys: A, HL.
049E39             0102*   telemetry_post_events:
049E39 21 34 9E 04 0103*       ld hl,telemetry_event_latch
049E3D B6          0104*       or (hl)
049E3E 77          0105*       ld (hl),a
049E3F C9          0106*       ret
049E40             0107*   
049E40             0108*   ; Inputs: A = one or more TELEMETRY_LIFECYCLE_* bits.
049E40             0109*   ; Destroys: A, HL.
049E40             0110*   telemetry_post_lifecycle:
049E40 21 35 9E 04 0111*       ld hl,telemetry_lifecycle_latch
049E44 B6          0112*       or (hl)
049E45 77          0113*       ld (hl),a
049E46 C9          0114*       ret
049E47             0115*   
049E47             0116*   telemetry_request_exit:
049E47 3E 80       0117*       ld a,STATE_NEW_EVENT_QUIT
049E49 CD 39 9E 04 0118*       call telemetry_post_events
049E4D 3E 04       0119*       ld a,TELEMETRY_OUTCOME_EXIT
049E4F 32 36 9E 04 0120*       ld (telemetry_forced_outcome),a
049E53 C9          0121*       ret
049E54             0122*   
049E54             0123*   ; Recreate the complete ABI header and dynamic state on every MOS RUN.
049E54             0124*   ; Destroys: AF, BC, DE, HL, IX.
049E54             0125*   telemetry_init:
049E54 3E 01       0126*       ld a,1
049E56 32 EC 9D 04 0127*       ld (telemetry_write_seq),a
049E5A 21 ED 9D 04 0128*       ld hl,telemetry_flags
049E5E 11 EE 9D 04 0129*       ld de,telemetry_flags+1
049E62 01 46 00 00 0130*       ld bc,telemetry_end-telemetry_flags-1
049E66 AF          0131*       xor a
049E67 77          0132*       ld (hl),a
049E68 ED B0       0133*       ldir
049E6A 32 34 9E 04 0134*       ld (telemetry_event_latch),a
049E6E 32 35 9E 04 0135*       ld (telemetry_lifecycle_latch),a
049E72 32 36 9E 04 0136*       ld (telemetry_forced_outcome),a
049E76 32 37 9E 04 0137*       ld (telemetry_count_frame),a
049E7A 3E 50       0138*       ld a,$50 ; P
