       04          
047F59 CD AB 12 04 0093*       call timestamp_tmr_get
047F5D F0          0094*       ret p ; not time to fire
047F5E             0095*   ; check laser power
047F5E 3A DC 7E 04 0096*       ld a,(laser_power)
047F62 21 DF 7E 04 0097*       ld hl,laser_power_per_shot
047F66 96          0098*       sub (hl) ; units of power per laser shot
047F67 D8          0099*       ret c ; not enough power to fire
047F68             0100*   ; update power to reflect firing
047F68 32 DC 7E 04 0101*       ld (laser_power),a
047F6C             0102*   ; reset timer
047F6C 2A D9 7E 04 0103*       ld hl,(tmr_laser_reset)
047F70 CD A0 12 04 0104*       call timestamp_tmr_set
047F74             0105*   ; fire the laser
047F74 DD 21 9E 9B 0106*       ld ix,player_weapons_begin
       04          
