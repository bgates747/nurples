04666D             0021*   ; inputs: none
04666D             0022*   print_score:
04666D             0023*   ; set text colors
04666D 3E 80       0024*       ld a,c_black+128
04666F CD 03 14 04 0025*       call vdu_colour_text
046673 3E 0A       0026*       ld a,c_green
