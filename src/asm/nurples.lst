047009             0074        include "targeting.inc"
047009             0001*   ; compute orientation to player
047009             0002*   ; based on relative positions
047009             0003*   ; returns: uh.l 16.8 fixed angle256 to player
047009             0004*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
047009             0005*   ;    representing delta-x/y *to* target respectively
047009             0006*   ; inputs: iy pointed at sprite record
047009             0007*   ; destroys: everything except iy (sprite record pointer)
047009             0008*   orientation_to_player:
047009 DD 21 D8 8E 0009*       ld ix,player_begin
       04          
04700E             0010*   ; compute dx
04700E DD 27 01    0011*       ld hl,(ix+sprite_x)
047011 FD 17 01    0012*       ld de,(iy+sprite_x)
047014 B7          0013*       or a ; clear carry
047015 ED 52       0014*       sbc hl,de ; dx
047017 E5          0015*       push hl ; save dx
047018             0016*   ; compute dy
047018 DD 27 04    0017*       ld hl,(ix+sprite_y)
04701B FD 17 04    0018*       ld de,(iy+sprite_y)
04701E B7          0019*       or a ; clear carry
04701F ED 52       0020*       sbc hl,de ; dy
047021 EB          0021*       ex de,hl ; de = dy
047022             0022*   ; compute angle to player
047022 C1          0023*       pop bc ; dx (was hl)
047023 C5          0024*       push bc ; save dx
047024 D5          0025*       push de ; save dy
047025 CD E3 07 04 0026*       call atan2_168fast ; uh.l = angle to player
047029 3E E0       0027*       ld a,%11100000
04702B A5          0028*       and l ; round angle to nearest 32th of a circle
04702C 6F          0029*       ld l,a
04702D 22 7E 70 04 0030*       ld (Bearing_t),hl ; return angle to player
047031 D1          0031*       pop de ; restore dy
047032 C1          0032*       pop bc ; restore dx
047033 C9          0033*       ret
047034             0034*   ; end orientation_to_player
047034             0035*   
047034             0036*   ; compute orientation to player
047034             0037*   ; based on relative positions
047034             0038*   ; returns: uh.l 16.8 fixed angle256 to player
047034             0039*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
047034             0040*   ;    representing delta-x/y *to* target respectively
047034             0041*   ; inputs: iy pointed at tile record
047034             0042*   ; destroys: everything except iy (tile record pointer)
047034             0043*   tile_orientation_to_player:
047034 DD 21 D8 8E 0044*       ld ix,player_begin
       04          
047039             0045*   ; compute dx
047039 DD 27 01    0046*       ld hl,(ix+sprite_x)
04703C FD 17 01    0047*       ld de,(iy+tile_x)
04703F B7          0048*       or a ; clear carry
047040 ED 52       0049*       sbc hl,de ; dx
047042 E5          0050*       push hl ; save dx
047043             0051*   ; compute dy
047043 DD 27 04    0052*       ld hl,(ix+sprite_y)
047046 FD 17 04    0053*       ld de,(iy+tile_y)
047049 B7          0054*       or a ; clear carry
04704A ED 52       0055*       sbc hl,de ; dy
04704C EB          0056*       ex de,hl ; de = dy
04704D             0057*   ; compute angle to player
04704D C1          0058*       pop bc ; dx (was hl)
04704E CD E3 07 04 0059*       call atan2_168fast ; uh.l = angle to player
047052 3E E0       0060*       ld a,%11100000
047054 A5          0061*       and l ; round angle to nearest 32th of a circle
047055 6F          0062*       ld l,a
047056 22 7E 70 04 0063*       ld (Bearing_t),hl
04705A C9          0064*       ret
04705B             0065*   ; end tile_orientation_to_player
04705B             0066*   
04705B             0067*   ; compute orientation to coordinate
04705B             0068*   ; based on relative positions
04705B             0069*   ; returns: uh.l 16.8 fixed angle256 to coordinate
04705B             0070*   ;    ub.c and ud.e as 16.8 signed fixed point numbers
04705B             0071*   ;    representing delta-x/y *to* target respectively
04705B             0072*   ; inputs: iy pointed at sprite record, ub.c,ud.e are target x,y coordinates
04705B             0073*   ; destroys: everything except iy (sprite record pointer)
04705B             0074*   bearing_to_coord:
04705B             0075*   ; compute dx
04705B C5          0076*       push bc
04705C E1          0077*       pop hl
04705D FD 07 01    0078*       ld bc,(iy+sprite_x)
047060 B7          0079*       or a ; clear carry
047061 ED 42       0080*       sbc hl,bc ; dx
047063 E5          0081*       push hl ; save dx
047064             0082*   ; compute dy
047064 EB          0083*       ex de,hl
047065 FD 17 04    0084*       ld de,(iy+sprite_y)
047068 B7          0085*       or a ; clear carry
047069 ED 52       0086*       sbc hl,de ; dy
04706B EB          0087*       ex de,hl ; de = dy
04706C             0088*   ; compute angle to coordinate
04706C C1          0089*       pop bc ; dx (was hl)
04706D C5          0090*       push bc ; save dx
04706E D5          0091*       push de ; save dy
04706F CD E3 07 04 0092*       call atan2_168fast ; uh.l = angle to coordinate
047073 3E E0       0093*       ld a,%11100000
047075 A5          0094*       and l ; round angle to nearest 32th of a circle
047076 6F          0095*       ld l,a
047077 22 7E 70 04 0096*       ld (Bearing_t),hl ; return angle to coordinate
04707B D1          0097*       pop de ; restore dy
04707C C1          0098*       pop bc ; restore dx
04707D C9          0099*       ret
04707E             0100*   ; end bearing_to_coord
04707E             0101*   
04707E             0102*   ; targeting_computer variables fixed 16.8 format
04707E 00 00 00    0103*   Bearing_t: dl 0x000000 ; angle to target
047081 00 00 00    0104*   Heading_t: dl 0x000000 ; angle of target motion
047084 00 00 00    0105*   Vp: dl 0x000000 ; velocity of projectile
047087 00 00 00    0106*   Vp_x: dl 0x000000 ; x component of projectile velocity
04708A 00 00 00    0107*   Vp_y: dl 0x000000 ; y component of projectile velocity
04708D 00 00 00    0108*   Vt: dl 0x000000 ; velocity of target
047090 00 00 00    0109*   Vt_x: dl 0x000000 ; x component of target velocity
047093 00 00 00    0110*   Vt_y: dl 0x000000 ; y component of target velocity
047096 00 00 00    0111*   Heading_p: dl 0x000000 ; angle of projectile motion
047099 00 00 00    0112*   lead_angle: dl 0x000000 ; lead angle
04709C             0113*   
04709C             0114*   ; Inputs:   Vp velocity of projectile set,
04709C             0115*   ;           iy pointed to sprite record,
04709C             0116*   ;           player position and velocities correctly set
04709C             0117*   ; Outputs:  uh.l is the 16.8 fixed firing angle256
04709C             0118*   ;           ub.c and ud.e are the 16.8 fixed x,y component projectile velocities
04709C             0119*   ; Law-of-sines derivation and NanoLinearTargeting small-angle approximation:
04709C             0120*   ; https://old.robowiki.net/cgi-bin/robowiki?LinearTargeting
04709C             0121*   ; Archived mirror:
04709C             0122*   ; https://robowiki.net/wiki/Linear_Targeting/Archived_Talk_20071111
04709C             0123*   targeting_computer:
04709C DD 21 D8 8E 0124*       ld ix,player_begin
       04          
0470A1             0125*   ; compute target speed and heading from its component velocities
0470A1 DD 07 07    0126*       ld bc,(ix+sprite_xvel)
0470A4 DD 17 0A    0127*       ld de,(ix+sprite_yvel)
0470A7 21 00 FF FF 0128*       ld hl,-1*256 ; account for vertical ground movement
0470AB 19          0129*       add hl,de
0470AC EB          0130*       ex de,hl ; ud.e = player y velocity - ground scroll velocity
0470AD CD 3D 07 04 0131*       call cartesian_to_polar_sm ; uh.l = Heading_t, ud.e = Vt
0470B1 22 81 70 04 0132*       ld (Heading_t),hl
0470B5 ED 53 8D 70 0133*       ld (Vt),de
       04          
0470BA             0134*   ; B = target heading - bearing to target
0470BA ED 5B 7E 70 0135*       ld de,(Bearing_t)
       04          
0470BF B7          0136*       or a ; clear carry
0470C0 ED 52       0137*       sbc hl,de
0470C2             0138*   ; numerator = Vt * sin(B), the target's lateral velocity
0470C2 CD D5 06 04 0139*       call sin168
0470C6 ED 5B 8D 70 0140*       ld de,(Vt)
       04          
0470CB CD 11 06 04 0141*       call smul168
0470CF             0142*   ; sin(A) = Vt * sin(B) / Vp
0470CF ED 5B 84 70 0143*       ld de,(Vp)
       04          
0470D4 CD 75 06 04 0144*       call sdiv168 ; quotient is returned in ud.e, remainder in uh.l
0470D8 EB          0145*       ex de,hl
0470D9             0146*   ; NanoLinearTargeting drops asin and treats its argument as radians. Convert
0470D9             0147*   ; that small-angle result to angle256: 256/(2*pi) = 40.743665...
0470D9 11 BE 28 00 0148*       ld de,0x0028BE ; 40.7421875 in 16.8 fixed
0470DD CD 11 06 04 0149*       call smul168
0470E1 22 99 70 04 0150*       ld (lead_angle),hl
0470E5             0151*   ; projectile heading = bearing + lead angle
0470E5 ED 5B 7E 70 0152*       ld de,(Bearing_t)
       04          
0470EA 19          0153*       add hl,de
0470EB             0154*   
0470EB E5          0155*       push hl
0470EC             0156*   
0470EC             0157*   ; compute component projectile velocities
0470EC ED 5B 84 70 0158*       ld de,(Vp) ; Vp should have been set by caller
       04          
0470F1 CD E9 06 04 0159*       call polar_to_cartesian ; ub.c = Vp_x, ud.e = Vp_y
0470F5 ED 43 87 70 0160*       ld (Vp_x),bc
       04          
0470FA             0161*       ; inc d ; account for vertical ground movement
0470FA ED 53 8A 70 0162*       ld (Vp_y),de
       04          
0470FF E1          0163*       pop hl ; uh.l = lead angle+target bearing
047100 22 96 70 04 0164*       ld (Heading_p),hl
047104             0165*   
047104 C9          0166*       ret
047105             0167*   
047105             0168*   ; debug print the results
