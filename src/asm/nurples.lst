040434             0215*   ; Scratch area for calculations
040434             0216*   ;------------------------------------------------------------------------
040434 00 00 00    0217*   bitbuf1:	dw24	0	;bit manipulation buffer 1
040437 00 00 00    0218*   bitbuf2:	dw24	0	;bit manipulation buffer 2
