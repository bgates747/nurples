0417DF             0041        include "vdu_buffered_api.inc"
0417DF             0001*   ; https://agonconsole8.github.io/agon-docs/vdp/Buffered-Commands-API/
0417DF             0002*   
0417DF             0003*   ; Command 0: Write block to a buffer
0417DF             0004*   ; VDU 23, 0, &A0, bufferId; 0, length; <buffer-data>
0417DF             0005*   ; inputs: hl = bufferId, bc = length of data, de = pointer to data
0417DF             0006*   vdu_write_block_to_buffer:
0417DF             0007*   ; back up input parameters
0417DF D5          0008*       push de ; pointer to data
0417E0 C5          0009*       push bc ; length of data
0417E1             0010*   ; set up the vdu command string
0417E1 22 01 18 04 0011*       ld (@bufferId),hl
0417E5 ED 43 04 18 0012*       ld (@length),bc
       04          
0417EA AF          0013*       xor a ; load buffer
0417EB 32 03 18 04 0014*       ld (@bufferId+2),a
0417EF 21 FE 17 04 0015*       ld hl,@cmd0
0417F3 01 08 00 00 0016*       ld bc,@end0-@cmd0
0417F7 5B DF       0017*       rst.lil $18
0417F9             0018*   ; send the buffer data
0417F9 C1          0019*       pop bc ; length of data
0417FA E1          0020*       pop hl ; pointer to data (was de)
0417FB 5B DF       0021*       rst.lil $18 ; send it
0417FD C9          0022*       ret
0417FE             0023*   ; command string data
0417FE 17 00 A0    0024*   @cmd0:      db 23,0,0xA0
041801 00 00       0025*   @bufferId:	dw 0x0000
041803 00          0026*               db 0 ; load buffer
041804 00 00       0027*   @length:	dw 0x0000
041806 00          0028*   @end0:      db 0x00 ; padding
041807             0029*   ; end vdu_write_block_to_buffer
041807             0030*   
041807             0031*   ; Command 1: Call a buffer
041807             0032*   ; VDU 23, 0, &A0, bufferId; 1
041807             0033*   ; inputs: hl = bufferId
041807             0034*   vdu_call_buffer:
041807 22 1F 18 04 0035*       ld (@bufferId),hl
04180B 3E 01       0036*       ld a,1 ; call buffer
04180D 32 21 18 04 0037*       ld (@bufferId+2),a
041811 21 1C 18 04 0038*       ld hl,@cmd
041815 01 06 00 00 0039*       ld bc,@end-@cmd
041819 5B DF       0040*       rst.lil $18
04181B C9          0041*       ret
04181C 17 00 A0    0042*   @cmd:     db 23,0,0xA0
04181F 00 00       0043*   @bufferId: dw 0x0000
041821 01          0044*              db 1 ; call buffer
041822             0045*   @end:
041822             0046*   ; end vdu_call_buffer
041822             0047*   
041822             0048*   ; Command 2: Clear a buffer
041822             0049*   ; VDU 23, 0 &A0, bufferId; 2
041822             0050*   ; inputs: hl = bufferId
041822             0051*   vdu_clear_buffer:
041822 22 3A 18 04 0052*       ld (@bufferId),hl
041826 3E 02       0053*       ld a,2 ; clear buffer
041828 32 3C 18 04 0054*       ld (@bufferId+2),a
04182C 21 37 18 04 0055*       ld hl,@cmd
041830 01 06 00 00 0056*       ld bc,@end-@cmd
041834 5B DF       0057*       rst.lil $18
041836 C9          0058*       ret
041837 17 00 A0    0059*   @cmd:     db 23,0,0xA0
04183A 00 00       0060*   @bufferId: dw 0x0000
04183C 02          0061*              db 2 ; clear buffer
04183D             0062*   @end:
04183D             0063*   ; end vdu_clear_buffer
04183D             0064*   
04183D             0065*   ; Clear all buffers
04183D             0066*   ; inputs: none
04183D             0067*   vdu_clear_all_buffers:
04183D             0068*   ; clear all buffers
04183D 21 48 18 04 0069*       ld hl,@beg
041841 01 06 00 00 0070*       ld bc,@end-@beg
041845 5B DF       0071*       rst.lil $18
041847 C9          0072*       ret
041848 17 00 A0    0073*   @beg: db 23,0,$A0
04184B FF FF       0074*         dw -1 ; bufferId -1 (65535) means clear all buffers
04184D 02          0075*         db 2  ; command 2: clear a buffer
04184E             0076*   @end:
04184E             0077*   ; end vdu_clear_all_buffers
04184E             0078*   
04184E             0079*   ; Command 3: Create a writeable buffer
04184E             0080*   ; VDU 23, 0 &A0, bufferId; 3, length;
04184E             0081*   ; inputs: hl = bufferId, bc = length
04184E             0082*   vdu_create_writeable_buffer:
04184E 22 6B 18 04 0083*       ld (@bufferId),hl
041852 ED 43 6E 18 0084*       ld (@length),bc
       04          
041857 3E 03       0085*       ld a,3 ; create writeable buffer
041859 32 6D 18 04 0086*       ld (@bufferId+2),a
04185D 21 68 18 04 0087*       ld hl,@cmd
041861 01 08 00 00 0088*       ld bc,@end-@cmd
041865 5B DF       0089*       rst.lil $18
041867 C9          0090*       ret
041868 17 00 A0    0091*   @cmd:     db 23,0,0xA0
04186B 00 00       0092*   @bufferId: dw 0x0000
04186D 03          0093*              db 3 ; create writeable buffer
04186E 00 00       0094*   @length: dw 0x0000
041870 00          0095*   @end:     db 0x00 ; padding
041871             0096*   ; end vdu_create_writeable_buffer
041871             0097*   
041871             0098*   ; Command 4: Set output stream to a buffer
041871             0099*   ; VDU 23, 0 &A0, bufferId; 4
041871             0100*   ; inputs: hl = bufferId
041871             0101*   vdu_set_output_stream_buffer:
041871 22 89 18 04 0102*       ld (@bufferId),hl
041875 3E 04       0103*       ld a,4 ; set output stream to buffer
041877 32 8B 18 04 0104*       ld (@bufferId+2),a
04187B 21 86 18 04 0105*       ld hl,@cmd
04187F 01 06 00 00 0106*       ld bc,@end-@cmd
041883 5B DF       0107*       rst.lil $18
041885 C9          0108*       ret
041886 17 00 A0    0109*   @cmd:     db 23,0,0xA0
041889 00 00       0110*   @bufferId: dw 0x0000
04188B 04          0111*              db 4 ; set output stream to buffer
04188C 00          0112*   @end:     db 0x00 ; padding
04188D             0113*   ; end vdu_set_output_stream_buffer
04188D             0114*   
04188D             0115*   ; Command 5: Adjust buffer contents
04188D             0116*   ; VDU 23, 0, &A0, bufferId; 5, operation, offset; [count;] <operand>, [arguments]
04188D             0117*   vdu_adjust_buffer:
04188D C9          0118*       ret ; TODO: implement
04188E             0119*   ; end vdu_adjust_buffer
04188E             0120*   
04188E             0121*   ; Command 6: Conditionally call a buffer
04188E             0122*   ; VDU 23, 0, &A0, bufferId; 6, operation, checkBufferId; checkOffset; [arguments]
04188E             0123*   vdu_call_buffer_conditional:
04188E C9          0124*       ret ; TODO: implement
04188F             0125*   ; end vdu_call_buffer_conditional
04188F             0126*   
04188F             0127*   ; Command 7: Jump to a buffer
04188F             0128*   ; VDU 23, 0, &A0, bufferId; 7
04188F             0129*   ; inputs: hl = bufferId
04188F             0130*   vdu_jump_to_buffer:
04188F 22 A7 18 04 0131*       ld (@bufferId),hl
041893 3E 07       0132*       ld a,7 ; jump to buffer
041895 32 A9 18 04 0133*       ld (@bufferId+2),a
041899 21 A4 18 04 0134*       ld hl,@cmd
04189D 01 06 00 00 0135*       ld bc,@end-@cmd
0418A1 5B DF       0136*       rst.lil $18
0418A3 C9          0137*       ret
0418A4 17 00 A0    0138*   @cmd:     db 23,0,0xA0
0418A7 00 00       0139*   @bufferId: dw 0x0000
0418A9 07          0140*              db 7 ; jump to buffer
0418AA 00          0141*   @end:     db 0x00 ; padding
0418AB             0142*   ; end vdu_jump_to_buffer
0418AB             0143*   
0418AB             0144*   ; Command 8: Conditional Jump to a buffer
0418AB             0145*   ; VDU 23, 0, &A0, bufferId; 8, operation, checkBufferId; checkOffset; [arguments]
0418AB             0146*   vdu_jump_to_buffer_conditional:
0418AB C9          0147*       ret ; TODO: implement
0418AC             0148*   ; end vdu_jump_to_buffer_conditional
0418AC             0149*   
0418AC             0150*   ; Command 9: Jump to an offset in a buffer
0418AC             0151*   ; VDU 23, 0, &A0, bufferId; 9, offset; offsetHighByte, [blockNumber;]
0418AC             0152*   vdu_jump_to_buffer_offset:
0418AC C9          0153*       ret ; TODO: implement
0418AD             0154*   ; end vdu_jump_to_buffer_offset
0418AD             0155*   
0418AD             0156*   ; Command 10: Conditional jump to an offset in a buffer
0418AD             0157*   ; VDU 23, 0, &A0, bufferId; 10, offset; offsetHighByte, [blockNumber;] [arguments]
0418AD             0158*   vdu_jump_to_buffer_offset_conditional:
0418AD C9          0159*       ret ; TODO: implement
0418AE             0160*   ; end vdu_jump_to_buffer_offset_conditional
0418AE             0161*   
0418AE             0162*   ; Command 11: Call buffer with an offset
0418AE             0163*   ; VDU 23, 0, &A0, bufferId; 11, offset; offsetHighByte, [blockNumber;]
0418AE             0164*   vdu_call_buffer_offset:
0418AE C9          0165*       ret ; TODO: implement
0418AF             0166*   ; end vdu_call_buffer_offset
0418AF             0167*   
0418AF             0042        include "vdu_fonts.inc"
0418AF             0001*   ; select font
0418AF             0002*   ; inputs: hl = bufferId, a = font flags
0418AF             0003*   ; Flags:
0418AF             0004*   ; Bit	Description
0418AF             0005*   ; 0	Adjust cursor position to ensure text baseline is aligned
0418AF             0006*   ;   0: Do not adjust cursor position (best for changing font on a new line)
0418AF             0007*   ;   1: Adjust cursor position (best for changing font in the middle of a line)
0418AF             0008*   ; 1-7	Reserved for future use
0418AF             0009*   ; VDU 23, 0, &95, 0, bufferId; flags: Select font
0418AF             0010*   vdu_font_select:
0418AF 22 C6 18 04 0011*       ld (@bufferId),hl
0418B3 32 C8 18 04 0012*       ld (@flags),a
0418B7 21 C2 18 04 0013*       ld hl,@cmd
0418BB 01 07 00 00 0014*       ld bc,@end-@cmd
0418BF 5B DF       0015*       rst.lil $18
0418C1 C9          0016*       ret
0418C2 17 00 95 00 0017*   @cmd: db 23, 0, 0x95, 0
0418C6 00 00       0018*   @bufferId: dw 0x0000
0418C8 00          0019*   @flags: db 0x00
0418C9             0020*   @end:
0418C9             0021*   
0418C9             0022*   ; create font from buffer
0418C9             0023*   ; inputs: hl = bufferId, e = width, d = height, d = ascent, a = flags
0418C9             0024*   ; VDU 23, 0, &95, 1, bufferId; width, height, ascent, flags: Create font from buffer
0418C9             0025*   vdu_font_create:
0418C9 22 EE 18 04 0026*       ld (@bufferId),hl
0418CD ED 53 F0 18 0027*       ld (@width),de ; also loads height
       04          
0418D2 32 F3 18 04 0028*       ld (@flags),a
0418D6 7A          0029*       ld a,d ; height
0418D7 32 F2 18 04 0030*       ld (@ascent),a ; ascent = height
0418DB             0031*   ; consolidate buffer
0418DB CD 04 16 04 0032*       call vdu_consolidate_buffer
0418DF             0033*   ; create font
0418DF 21 EA 18 04 0034*       ld hl,@cmd
0418E3 01 0A 00 00 0035*       ld bc,@end-@cmd
0418E7 5B DF       0036*       rst.lil $18
0418E9 C9          0037*       ret
0418EA 17 00 95 01 0038*   @cmd: db 23, 0, 0x95, 1
0418EE 00 00       0039*   @bufferId: dw 0x0000
0418F0 00          0040*   @width: db 0x00
0418F1 00          0041*   @height: db 0x00
0418F2 00          0042*   @ascent: db 0x00
0418F3 00          0043*   @flags: db 0x00
0418F4             0044*   @end:
0418F4             0045*   
0418F4             0046*   ; set or adjust font property
0418F4             0047*   ; inputs: hl = bufferId, a = field, de = value
0418F4             0048*   ; VDU 23, 0, &95, 2, bufferId; field, value;: Set or adjust font property
0418F4             0049*   vdu_font_property:
0418F4 22 10 19 04 0050*       ld (@bufferId),hl
0418F8 32 12 19 04 0051*       ld (@field),a
0418FC ED 53 13 19 0052*       ld (@value),de
       04          
041901 21 0C 19 04 0053*       ld hl,@cmd
041905 01 09 00 00 0054*       ld bc,@end-@cmd
041909 5B DF       0055*       rst.lil $18
04190B C9          0056*       ret
04190C 17 00 95 02 0057*   @cmd: db 23, 0, 0x95, 2
041910 00 00       0058*   @bufferId: dw 0x0000
041912 00          0059*   @field: db 0x00
041913 00 00       0060*   @value: dw 0x0000
041915 00          0061*   @end: db 0x00 ; padding
041916             0062*   
041916             0063*   ; VDU 23, 0, &95, 3, bufferId; [<args>]: Reserved
041916             0064*   
041916             0065*   ; Clear/Delete font
041916             0066*   ; inputs: hl = bufferId
041916             0067*   ; VDU 23, 0, &95, 4, bufferId;: Clear/Delete font
041916             0068*   vdu_font_clear:
041916 22 29 19 04 0069*       ld (@bufferId),hl
04191A 21 25 19 04 0070*       ld hl,@cmd
04191E 01 06 00 00 0071*       ld bc,@end-@cmd
041922 5B DF       0072*       rst.lil $18
041924 C9          0073*       ret
041925 17 00 95 04 0074*   @cmd: db 23, 0, 0x95, 4
041929 00 00       0075*   @bufferId: dw 0x0000
04192B 00          0076*   @end: db 0x00 ; padding
04192C             0077*   
04192C             0078*   ; Copy system font to buffer
04192C             0079*   ; inputs: hl = bufferId
04192C             0080*   ; VDU 23, 0, &95, 5, bufferId;: Copy system font to buffer
04192C             0081*   vdu_font_copy_system:
04192C 22 3F 19 04 0082*       ld (@bufferId),hl
041930 21 3B 19 04 0083*       ld hl,@cmd
041934 01 06 00 00 0084*       ld bc,@end-@cmd
041938 5B DF       0085*       rst.lil $18
