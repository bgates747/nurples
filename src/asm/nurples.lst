0464DF CC 65 04    0004*       dl move_player_laser	; move_program
0464E2 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
0464E3 05          0006*       db 5	                ; dim_x
0464E4 0D          0007*       db 13                   ; dim_y
0464E5 01          0008*       db 1                    ; num_orientations
0464E6 02          0009*       db 2                    ; num_animations
0464E7 00          0010*       db 0	                ; animation
0464E8 02          0011*       db laser_animation_timer_reset ; animation_timer
0464E9 00          0012*       db 0	                ; move_timer
0464EA 00          0013*       db 0	                ; move_step
0464EB 00          0014*       db 0	                ; points
