044AF5 CD C1 19 04 0089*       call vdu_sprite_clear_frames
044AF9 21 0E 01 00 0090*       ld hl,BUF_FIREBALL_2_000
044AFD 06 40       0091*       ld b,2*32 ; 2 animations * 32 orientations
044AFF             0092*   @frames_loop:
044AFF C5          0093*       push bc
044B00 E5          0094*       push hl
044B01 CD 03 1B 04 0095*       call vdu_sprite_add_buff
044B05 E1          0096*       pop hl
044B06 23          0097*       inc hl
044B07 C1          0098*       pop bc
044B08 10 F5       0099*       djnz @frames_loop
044B0A D1          0100*       pop de ; sprite loop counter
044B0B F1          0101*       pop af ; sprite id
044B0C 3C          0102*       inc a
044B0D 1D          0103*       dec e
044B0E C2 EF 4A 04 0104*       jp nz,@sprites_loop
044B12 C9          0105*       ret
