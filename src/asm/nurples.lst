0480F9 AF          0106*   	xor a ; loop counter / sprite id
0480FA             0107*   @sprite_loop:
0480FA F5          0108*   	push af ; save loop counter / sprite id
0480FB CD D7 18 04 0109*   	call vdu_sprite_select
