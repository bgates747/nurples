046703             0074*   table_init:
046703             0075*   ; clear the sprite table
046703 AF          0076*       xor a ; write zeroes to sprite table
046704 32 E1 66 04 0077*       ld (sprite_fault_flags),a
046708 21 F3 86 04 0078*       ld hl,table_base ; address to copy from
04670C 01 00 05 00 0079*       ld bc,table_end-table_base ; number of bytes to clear
046710 CD 5B 03 04 0080*       call clear_mem
046714             0081*   ; write sprite ids
046714 DD 21 F3 86 0082*       ld ix,table_base
       04          
046719 AF          0083*       xor a ; sprite id
04671A 0E 00       0084*       ld c,0 ; sprite type
04671C 06 14       0085*       ld b,table_num_records ; loop counter
04671E             0086*   @loop:
04671E DD 77 00    0087*       ld (ix+sprite_id),a
046721 DD 71 16    0088*       ld (ix+sprite_type),c
046724 ED 32 40    0089*       lea ix,ix+table_record_size
046727 3C          0090*       inc a
046728 10 F4       0091*       djnz @loop
04672A C9          0092*       ret
04672B             0093*   ; end table_init
04672B             0094*   
04672B             0095*   ; Validate a record pointer and its stable identity byte against the physical
04672B             0096*   ; 64-byte slot it occupies in the sprite table.
04672B             0097*   ; inputs: iy = candidate sprite record
04672B             0098*   ; outputs: carry set only for an aligned in-range pointer with the expected id
04672B             0099*   ; destroys: a,de,hl
04672B             0100*   sprite_table_record_pointer_valid:
04672B FD E5       0101*       push iy
04672D E1          0102*       pop hl
04672E 11 F3 86 04 0103*       ld de,table_base
046732 B7          0104*       or a
046733 ED 52       0105*       sbc hl,de ; offset from the sprite-table base
046735 DA 5F 67 04 0106*       jp c,@invalid
046739 11 00 05 00 0107*       ld de,table_end-table_base
04673D B7          0108*       or a
04673E ED 52       0109*       sbc hl,de
046740 D2 5F 67 04 0110*       jp nc,@invalid
046744 19          0111*       add hl,de ; restore the in-range offset
046745 7D          0112*       ld a,l
046746 E6 3F       0113*       and table_record_size-1
046748 C2 5F 67 04 0114*       jp nz,@invalid
04674C             0115*   ; Convert the aligned offset to its record id: H*4 + L/64.
04674C 7C          0116*       ld a,h
04674D 87          0117*       add a,a
04674E 87          0118*       add a,a
04674F 57          0119*       ld d,a
046750 7D          0120*       ld a,l
046751 07          0121*       rlca
046752 07          0122*       rlca
046753 E6 03       0123*       and %00000011
046755 B2          0124*       or d
046756 FD BE 00    0125*       cp (iy+sprite_id)
046759 C2 5F 67 04 0126*       jp nz,@invalid
04675D 37          0127*       scf
04675E C9          0128*       ret
04675F             0129*   @invalid:
04675F AF          0130*       xor a
046760 C9          0131*       ret
046761             0132*   ; end sprite_table_record_pointer_valid
046761             0133*   
046761             0134*   ; deactivate the sprite with the given id
046761             0135*   ; inputs: iy set to sprite record
046761             0136*   ; outputs: nothing
046761             0137*   ; destroys: a,de,hl
046761             0138*   table_deactivate_sprite:
046761 CD 2B 67 04 0139*       call sprite_table_record_pointer_valid
046765 D2 81 67 04 0140*       jp nc,@invalid
046769 FD 7E 00    0141*       ld a,(iy+sprite_id) ; get spriteId
04676C FD E5       0142*       push iy
04676E CD 9B 19 04 0143*       call vdu_sprite_select ; select sprite
046772 CD 1F 1A 04 0144*       call vdu_sprite_hide
046776 FD E1       0145*       pop iy
046778 FD CB 1D B6 0146*       res sprite_alive,(iy+sprite_collisions)
04677C FD CB 1D BE 0147*       res sprite_just_died,(iy+sprite_collisions)
046780 C9          0148*       ret
046781             0149*   @invalid:
046781 21 E1 66 04 0150*       ld hl,sprite_fault_flags
046785 CB C6       0151*       set sprite_fault_bad_record,(hl)
046787 C9          0152*       ret
046788             0153*   ; end table_deactivate_sprite
046788             0154*   
046788             0155*   sprites_init:
046788             0156*   ; initialize sprites
046788 CD CF 1A 04 0157*   	call vdu_sprite_reset ; clear sprite data in vdp
04678C             0158*   
04678C             0159*   ; define player sprite
04678C 3A F3 87 04 0160*   	ld a,(player_begin+sprite_id)
046790 CD 9B 19 04 0161*   	call vdu_sprite_select
046794 CD AE 19 04 0162*   	call vdu_sprite_clear_frames
046798 21 73 01 00 0163*   	ld hl,BUF_SHIP_0L
04679C 06 03       0164*   	ld b,3 ; DJNZ consumes B; loading BC with 3 would put zero in B
04679E             0165*   @sprite_player_loop:
04679E C5          0166*   	push bc
04679F E5          0167*   	push hl
0467A0 CD F0 1A 04 0168*   	call vdu_sprite_add_buff
0467A4 E1          0169*   	pop hl
0467A5 23          0170*   	inc hl
0467A6 C1          0171*   	pop bc
0467A7 10 F5       0172*   	djnz @sprite_player_loop
0467A9             0173*   
0467A9             0174*   ; define player weapon sprites
0467A9 CD 28 65 04 0175*       call init_player_laser
0467AD             0176*   
