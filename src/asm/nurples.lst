       04          
041443 FD 22 60 14 0203*       ld (@y1),iy
       04          
041448 DD 22 62 14 0204*   	ld (@x1),ix
       04          
04144D ED 53 64 14 0205*   	ld (@y0),de
       04          
041452 21 5D 14 04 0206*   	ld hl,@cmd
041456 01 09 00 00 0207*   	ld bc,@end-@cmd
04145A 5B DF       0208*   	rst.lil $18
04145C C9          0209*   	ret
04145D 18          0210*   @cmd:   db 24 ; set graphics viewport command
04145E 00 00       0211*   @x0: 	dw 0x0000 ; set by bc
041460 00 00       0212*   @y1: 	dw 0x0000 ; set by iy
041462 00 00       0213*   @x1: 	dw 0x0000 ; set by ix
041464 00 00       0214*   @y0: 	dw 0x0000 ; set by de
041466 00          0215*   @end:   db 0x00	  ; padding
