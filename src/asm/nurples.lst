044D5D 00 00 00    0004*   tileset_ptr_idx: dl 0
044D60             0005*   tileset_ptrs:
044D60             0006*       ; dl tiles_xevious_levels
044D60 14 4F 04    0007*       dl tileset_00_levels
044D63 00 00 00    0008*   tileset_ptrs_end: dl 0 ; list terminator
044D66             0009*   tileset_ptrs_count: equ [tileset_ptrs_end-tileset_ptrs]/3
044D66             0010*   
044D66             0011*   ; get a pointer to the current tileset
044D66             0012*   ; inputs: tileset_ptr_idx
044D66             0013*   ; returns: ix = pointer to tileset levels lut
044D66             0014*   get_tileset_ptr:
044D66 3A 5D 4D 04 0015*       ld a,(tileset_ptr_idx)
044D6A FE 01       0016*       cp tileset_ptrs_count
044D6C DA 75 4D 04 0017*       jp c,@index_valid
044D70 AF          0018*       xor a ; corrupt/out-of-range selectors recover to the first tileset
044D71 32 5D 4D 04 0019*       ld (tileset_ptr_idx),a
044D75             0020*   @index_valid:
044D75 11 00 00 00 0021*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
044D79 57          0022*       ld d,a ; d = tileset index
044D7A 1E 03       0023*       ld e,3 ; three bytes per index record
044D7C ED 5C       0024*       mlt de ; offset into tileset_ptrs lut
044D7E DD 21 60 4D 0025*       ld ix,tileset_ptrs
       04          
044D83 DD 19       0026*       add ix,de ; ix = pointer to tileset_ptrs record
044D85 C9          0027*       ret
044D86             0028*   ; end get_tileset_ptr
044D86             0029*   
044D86             0030*   ; intialize a tileset
044D86             0031*   ; inputs: a = index into tileset_ptrs
044D86             0032*   init_tileset:
044D86 32 5D 4D 04 0033*       ld (tileset_ptr_idx),a ; store new tileset index
044D8A CD 66 4D 04 0034*       call get_tileset_ptr ; ix = pointer to tileset_ptrs record
044D8E DD 37 00    0035*       ld ix,(ix) ; ix = pointer to tileset levels lut
044D91 DD 7E FF    0036*       ld a,(ix-1) ; number of levels in the tileset
044D94 32 B2 4D 04 0037*       ld (num_levels),a
044D98 AF          0038*       xor a ; reset current level to zero
044D99 32 B1 4D 04 0039*       ld (cur_level),a
044D9D C3 12 4E 04 0040*       jp init_level
044DA1             0041*   ; end init_tileset
044DA1             0042*   
044DA1             0043*   next_tileset:
044DA1 3A 5D 4D 04 0044*       ld a,(tileset_ptr_idx)
044DA5 3C          0045*       inc a ; bump to next index
044DA6 FE 01       0046*       cp tileset_ptrs_count
044DA8 DA 86 4D 04 0047*       jp c,init_tileset
044DAC AF          0048*       xor a ; wrap to the first tileset without dereferencing the terminator
044DAD C3 86 4D 04 0049*       jp init_tileset
044DB1             0050*   ; end next_tileset
044DB1             0051*   
044DB1 00          0052*   cur_level: db 0
044DB2 00          0053*   num_levels: db 0
044DB3             0054*   
044DB3             0055*   ; get a pointer to the current level lookup record
044DB3             0056*   ; inputs: tileset_ptr_idx, cur_level
044DB3             0057*   ; returns: ix = pointer to level definition
044DB3             0058*   get_level_ptr:
044DB3 CD 66 4D 04 0059*       call get_tileset_ptr
044DB7 DD 37 00    0060*       ld ix,(ix) ; ix = pointer to tileset levels lut
044DBA DD 7E FF    0061*       ld a,(ix-1) ; refresh the count after any outer-selector recovery
044DBD 32 B2 4D 04 0062*       ld (num_levels),a
044DC1 47          0063*       ld b,a
044DC2 3A B1 4D 04 0064*       ld a,(cur_level)
044DC6 B8          0065*       cp b
044DC7 DA D0 4D 04 0066*       jp c,@index_valid
044DCB             0067*   @index_invalid:
044DCB AF          0068*       xor a ; corrupt/out-of-range selectors recover to the first level
044DCC 32 B1 4D 04 0069*       ld (cur_level),a
044DD0             0070*   @index_valid:
044DD0 11 00 00 00 0071*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
044DD4 57          0072*       ld d,a ; d = level index
044DD5 1E 03       0073*       ld e,3 ; three bytes per level record
044DD7 ED 5C       0074*       mlt de ; offset into tileset levels lut
044DD9 DD 19       0075*       add ix,de ; ix = pointer to level record
044DDB C9          0076*       ret
044DDC             0077*   ; end get_level_ptr
044DDC             0078*   
044DDC             0079*   ; advance to the next level in the current tileset
044DDC             0080*   ; inputs: tileset_ptr_idx, cur_level
044DDC             0081*   next_level:
044DDC             0082*   ; update starting score
044DDC 2A 28 66 04 0083*       ld hl,(player_score)
044DE0 22 2B 66 04 0084*       ld (player_starting_score),hl
044DE4             0085*   ; refresh the authoritative inner-table count before advancing
044DE4 CD 66 4D 04 0086*       call get_tileset_ptr
044DE8 DD 37 00    0087*       ld ix,(ix)
044DEB DD 7E FF    0088*       ld a,(ix-1)
044DEE 32 B2 4D 04 0089*       ld (num_levels),a
044DF2 47          0090*       ld b,a
044DF3             0091*   ; select the next valid level without indexing the terminator
044DF3 3A B1 4D 04 0092*       ld a,(cur_level)
044DF7 3C          0093*       inc a ; bump to next level
044DF8 CA 09 4E 04 0094*       jp z,@advance_tileset ; guard a corrupt 255 index wrapping to zero
044DFC B8          0095*       cp b
044DFD D2 09 4E 04 0096*       jp nc,@advance_tileset
044E01 32 B1 4D 04 0097*       ld (cur_level),a
044E05 C3 12 4E 04 0098*       jp init_level
044E09             0099*   @advance_tileset:
044E09 AF          0100*       xor a
044E0A 32 B1 4D 04 0101*       ld (cur_level),a
044E0E C3 A1 4D 04 0102*       jp next_tileset
044E12             0103*   ; end next_level
044E12             0104*   
044E12             0105*   ; inputs: tileset_ptr_idx, cur_level
044E12             0106*   init_level:
044E12             0107*   ; ; initialize sprites and active tiles table
044E12             0108*   ;     call sprites_init
044E12             0109*   ;     call table_init
044E12             0110*   ;     call tile_table_init
044E12             0111*   ; set pointers
044E12 CD B3 4D 04 0112*       call get_level_ptr ; ix points to level lookup record
044E16 DD 37 00    0113*       ld ix,(ix) ; ix points to level definition
044E19             0114*   ; set tiles_cols
044E19 DD 7E 00    0115*       ld a,(ix+0)
044E1C 32 8D 75 04 0116*       ld (tiles_cols),a
044E20             0117*   ; set tiles_row counter
044E20 DD 7E 01    0118*       ld a,(ix+1)
044E23 32 8A 75 04 0119*       ld (tiles_row),a
044E27 AF          0120*       xor a
044E28 32 8E 75 04 0121*       ld (tiles_level_complete),a
