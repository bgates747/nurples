047A1A             0081*   
047A1A             0082*   player_move_weapons:
047A1A             0083*   ; initialize pointers and loop counter
047A1A FD 21 E2 A3 0084*       ld iy,player_weapons_begin ; set iy to first record in table
       04          
047A1F 06 04       0085*       ld b,player_lasers_max ; loop counter
047A21 CD 71 7E 04 0086*       call move_sprite_group
047A25 C9          0087*       ret
047A26             0088*   ; end player_move_weapons
047A26             0089*   
047A26             0090*   player_spawn_laser:
047A26             0091*    ; check laser spawn timer
047A26 FD 21 A8 79 0092*       ld iy,tmr_laser
       04          
047A2B CD EF 12 04 0093*       call timestamp_tmr_get
047A2F F0          0094*       ret p ; not time to fire
047A30             0095*   ; check laser power
047A30 3A B1 79 04 0096*       ld a,(laser_power)
047A34 21 B4 79 04 0097*       ld hl,laser_power_per_shot
047A38 96          0098*       sub (hl) ; units of power per laser shot
047A39 D8          0099*       ret c ; not enough power to fire
047A3A             0100*   ; update power to reflect firing
047A3A 32 B1 79 04 0101*       ld (laser_power),a
047A3E             0102*   ; reset timer
047A3E 2A AE 79 04 0103*       ld hl,(tmr_laser_reset)
047A42 CD E4 12 04 0104*       call timestamp_tmr_set
047A46             0105*   ; fire the laser
047A46 DD 21 E2 A3 0106*       ld ix,player_weapons_begin
       04          
047A4B 06 04       0107*       ld b,player_lasers_max
047A4D FD 21 E2 A4 0108*       ld iy,player_begin
       04          
047A52 FD 22 94 7B 0109*       ld (table_pointer),iy
       04          
047A57 21 95 79 04 0110*       ld hl,laser_defaults
047A5B CD 6A 7D 04 0111*       call spawn_sprite_from_sprite
047A5F D0          0112*       ret nc ; no carry means no free sprite slots, so we go home
047A60             0113*   ; other specific initialization
047A60             0114*   ; ------------------------------------------------
047A60 FD 21 E2 A4 0115*       ld iy,player_begin
       04          
047A65             0116*   ; x-coordinate
047A65 FD 27 01    0117*       ld hl,(iy+sprite_x)
047A68 11 00 05 00 0118*       ld de,5*256 ; horizontal center with player sprite
047A6C 19          0119*       add hl,de
047A6D DD 2F 01    0120*       ld (ix+sprite_x),hl
047A70             0121*   ; y-coordinate
047A70 FD 27 04    0122*       ld hl,(iy+sprite_y)
047A73 11 00 FA FF 0123*       ld de,-6*256 ; set laser y a few pixels above player
047A77 19          0124*       add hl,de
047A78 DD 2F 04    0125*       ld (ix+sprite_y),hl
047A7B             0126*   ; set laser velocity
047A7B 21 00 FC FF 0127*       ld hl,-laser_speed
047A7F DD 2F 0A    0128*       ld (ix+sprite_yvel),hl
047A82 C9          0129*       ret
047A83             0130*   ; end player_spawn_laser
047A83             0131*   
047A83             0132*   move_player_laser:
047A83             0133*   ; run the movement program for the laser
047A83 CD 2E 7F 04 0134*       call move_sprite
047A87 3A 97 7B 04 0135*       ld a,(sprite_screen_edge)
047A8B E6 08       0136*       and a,collide_top ; check collision with top of screen
047A8D CA 95 7A 04 0137*       jp z,@F ; still on screen
047A91 C3 14 7C 04 0138*       jp table_deactivate_sprite
047A95             0139*   @@: ; check animation timer
047A95 FD 35 23    0140*       dec (iy+sprite_animation_timer)
047A98 C2 AC 7A 04 0141*       jp nz,@F
047A9C 3E 02       0142*       ld a,laser_animation_timer_reset
047A9E FD 77 23    0143*       ld (iy+sprite_animation_timer),a
047AA1 FD 7E 00    0144*       ld a,(iy+sprite_id)
047AA4 CD 03 1A 04 0145*       call vdu_sprite_select
047AA8 CD 4A 1A 04 0146*       call vdu_sprite_next_frame
047AAC             0147*   @@: ; all done
047AAC C9          0148*       ret
047AAD             0149*   ; end move_player_laser
047AAD             0150*   
047AAD             0151*   charge_laser:
