04227D             0103*   
04227D             0104*   ; contains the logic for how to move the enemy
04227D             0105*   ; and then does the moving
04227D             0106*   ; inputs: a fully-populated active sprite table
04227D             0107*   ;         player position variables
04227D             0108*   ; destroys: everything except index registers
04227D             0109*   ; outputs: moving enemies
04227D             0110*   en_nav_seek_zag:
04227D             0111*   ; set velocity and orientation by player's relative location
04227D             0112*   ; move enemies y-axis
04227D             0113*   ; where is player relative to us?
04227D CD 3B 89 04 0114*       call orientation_to_player ; uh.l angle to player, ub.c, ud.e = dx, dy
042281             0115*   ; is player above or below us?
042281 ED 53 37 03 0116*       ld (ude),de ; dy
       04          
042286 3A 39 03 04 0117*       ld a,(ude+2) ; deu
04228A 17          0118*       rla ; shift sign bit into carry
04228B D2 B4 22 04 0119*       jp nc,@zig_zag ; player is below,evade
04228F             0120*   ; player is even or above,so home in on current heading
04228F FD 2F 10    0121*       ld (iy+sprite_heading),hl ; save sprite heading
042292             0122*   ; fall through to @compute_velocities
042292             0123*   @compute_velocities:
042292 CD 9E 85 04 0124*       call sprite_compute_velocities
042296 CD FD 84 04 0125*       call move_sprite ; move the sprite
04229A B7          0126*       or a ; a will be non-zero if have collided with screen edge
04229B C2 CB 22 04 0127*       jp nz,@edge_switch ; switch direction, but never move twice in one frame
04229F C3 40 22 04 0128*       jp move_enemy_seeker ; didn't hit an edge so check collisions and move sprite
0422A3             0129*   @reset_zig_zag_timer:
0422A3 FD 2A E1 81 0130*       ld iy,(table_pointer)
       04          
0422A8 CD 14 05 04 0131*       call rand_8
0422AC E6 3F       0132*       and %00111111 ; limit it to 64
0422AE CB DF       0133*       set 3,a ; make sure it's at least 8
0422B0 FD 77 24    0134*       ld (iy+sprite_move_timer),a ; store it
0422B3 C9          0135*       ret
0422B4             0136*   @zig_zag:
0422B4 FD 7E 24    0137*       ld a,(iy+sprite_move_timer)
0422B7 3D          0138*       dec a
0422B8 FD 77 24    0139*       ld (iy+sprite_move_timer),a
0422BB C2 F3 22 04 0140*       jp nz,@zig_zag_no_switch
0422BF             0141*   @zag_switch:
0422BF CD D7 22 04 0142*       call @switch_zag_heading
0422C3 CD A3 22 04 0143*       call @reset_zig_zag_timer
0422C7 C3 F3 22 04 0144*       jp @zig_zag_no_switch
0422CB             0145*   @edge_switch:
0422CB             0146*   ; The generic mover has already clamped/bounced this seeker. Choose the next
0422CB             0147*   ; zag and return through collision handling; moving again here can loop forever
0422CB             0148*   ; at the bottom edge because both zag headings point downward.
0422CB CD D7 22 04 0149*       call @switch_zag_heading
0422CF CD A3 22 04 0150*       call @reset_zig_zag_timer
0422D3 C3 40 22 04 0151*       jp move_enemy_seeker
0422D7             0152*   @switch_zag_heading:
0422D7 FD 7E 25    0153*       ld a,(iy+sprite_move_step)
0422DA EE 01       0154*       xor %1 ; flips bit zero
0422DC FD 77 25    0155*       ld (iy+sprite_move_step),a ; store it
0422DF C2 EB 22 04 0156*       jp nz,@right ; zag right
0422E3             0157*   ;otherwise zag left
0422E3 21 00 A0 00 0158*       ld hl,160*256; southwest heading
0422E7 FD 2F 10    0159*       ld (iy+sprite_heading),hl ; save sprite heading
0422EA C9          0160*       ret
0422EB             0161*   @right:
0422EB 21 00 60 00 0162*       ld hl,96*256; southeast heading
0422EF FD 2F 10    0163*       ld (iy+sprite_heading),hl ; save sprite heading
0422F2 C9          0164*       ret
0422F3             0165*   @zig_zag_no_switch:
0422F3             0166*       ; ld a,(sprite_orientation)
0422F3 FD 27 10    0167*       ld hl,(iy+sprite_heading)
0422F6 C3 92 22 04 0168*       jp @compute_velocities
0422FA             0169*   ; end en_nav_seek_zag
