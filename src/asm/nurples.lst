0407F0             0472*   atan2_168fast:
0407F0             0473*   ; get signs and make everything positive
0407F0             0474*   ; get abs(x) and store its original sign
0407F0 C5          0475*       push bc
0407F1 E1          0476*       pop hl
0407F2 CD 6C 04 04 0477*       call hlu_abs ; if x was negative this also sets the sign flag
0407F6 E5          0478*       push hl ; store abs(x)
0407F7 C1          0479*       pop bc ; bc = abs(x)
0407F8 F5          0480*       push af ; store sign of x
0407F9             0481*   ; get abs(y) and store its original sign
0407F9 EB          0482*       ex de,hl ; hl = y
0407FA CD 6C 04 04 0483*       call hlu_abs ; if y was negative this also sets the sign flag
0407FE EB          0484*       ex de,hl ; de = abs(y)
