0480F4 CD 30 1A 04 0111*   	call vdu_sprite_add_buff
0480F8 F1          0112*   	pop af ; restore loop counter / sprite id
0480F9 3C          0113*       inc a
0480FA FE 14       0114*       cp table_num_records
0480FC C2 EB 80 04 0115*       jp nz,@sprite_loop
048100 CD 0F 19 04 0116*   	call vdu_sprite_activate
