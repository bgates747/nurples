047332 00 00 00    0034*       dl 0 ; list terminator
047335             0035*   tile_stack_end:
047335 32 70 04    0036*   tile_stack_pointer: dl tile_stack ; pointer to current stack record, initialized to tile_stack
047338 86 8C 04    0037*   tile_table_pointer: dl tile_table_base ; pointer to top address of current record, initialized to tile_table_base
04733B 00 00 00    0038*   num_active_tiles: dl 0 ; how many active tiles
04733E 00          0039*   next_tile_id: db 0 ; next available tile id
04733F 00 00 00    0040*   new_tile_table_pointer: dl 0 ; pointer to new tile record
047342             0041*   tile_fault_bad_record: equ 0
047342             0042*   tile_fault_bad_move_program: equ 1
047342             0043*   tile_fault_bad_deactivation: equ 2
047342 00          0044*   tile_fault_flags: db 0 ; latched fail-closed diagnostics
047343             0045*   
047343             0046*   tile_table_init:
047343             0047*   ; reset num active tiles
047343 21 00 00 00 0048*       ld hl,0
047347 22 3B 73 04 0049*       ld (num_active_tiles),hl
04734B             0050*   ; reset next tile id
04734B AF          0051*       xor a
04734C 32 3E 73 04 0052*       ld (next_tile_id),a
047350 32 42 73 04 0053*       ld (tile_fault_flags),a
047354             0054*   ; clear the tile stack
047354 AF          0055*       xor a ; write zeroes to tile stack
047355 21 32 70 04 0056*       ld hl,tile_stack
047359 01 03 03 00 0057*       ld bc,tile_stack_end-tile_stack
04735D CD 5B 03 04 0058*       call clear_mem
047361             0059*   ; clear the tile table
047361 AF          0060*       xor a ; write zeroes to tile table
047362 21 86 8C 04 0061*       ld hl,tile_table_base ; address to copy from
047366 01 00 40 00 0062*       ld bc,tile_table_end-tile_table_base ; number of bytes to clear
04736A CD 5B 03 04 0063*       call clear_mem
04736E             0064*   ; write tile ids
04736E DD 21 86 8C 0065*       ld ix,tile_table_base
       04          
047373 AF          0066*       xor a ; tile id
047374 06 00       0067*       ld b,0 ; loop counter
047376             0068*   @loop:
047376 DD 77 00    0069*       ld (ix+tile_id),a
047379 ED 32 40    0070*       lea ix,ix+table_record_size
04737C 3C          0071*       inc a
04737D 10 F7       0072*       djnz @loop
04737F             0073*   ; set pointers to top of tile stack and tile table
04737F 21 3E 73 04 0074*       ld hl,next_tile_id
047383 3E FF       0075*       ld a,255 ; will wrap around to 0 on first call to create active tile
047385 77          0076*       ld (hl),a
047386 21 86 8C 04 0077*       ld hl,tile_table_base
04738A 22 38 73 04 0078*       ld (tile_table_pointer),hl
04738E 21 32 70 04 0079*       ld hl,tile_stack
047392 22 35 73 04 0080*       ld (tile_stack_pointer),hl
047396 C9          0081*       ret
047397             0082*   ; end tile_table_init
047397             0083*   
047397             0084*   ; gets the next available tile id
047397             0085*   ; inputs; none
047397             0086*   ; returns: if new tile available, a = tile id, ix pointing to new tile vars, carry set
047397             0087*   ;      otherwise, a = 0, carry flag reset, ix invalid and must not be dereferenced
047397             0088*   ; destroys: a,b,de,hl,ix
047397             0089*   ; affects: on success, bumps num_active_tiles by one, adds a tile pointer to the top of the tile stack
047397             0090*   tile_table_get_next_id:
047397             0091*   ; The byte-sized active count deliberately caps the dense stack at 255 entries.
047397 3A 3B 73 04 0092*       ld a,(num_active_tiles)
04739B 3C          0093*       inc a
04739C CA C1 73 04 0094*       jp z,@not_found
0473A0             0095*   ; Search the entire ring rather than assuming the next physical record is free.
0473A0 06 00       0096*       ld b,0 ; DJNZ with zero visits all 256 tile records
0473A2 3A 3E 73 04 0097*       ld a,(next_tile_id)
0473A6             0098*   @search:
0473A6 3C          0099*       inc a
0473A7 11 00 00 00 0100*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
0473AB 57          0101*       ld d,a ; candidate index into tile table
0473AC 1E 40       0102*       ld e,tile_table_record_size
0473AE ED 5C       0103*       mlt de ; de is now the offset to the table entry
0473B0 DD 21 86 8C 0104*       ld ix,tile_table_base ; point to base address of tile table
       04          
0473B5 DD 19       0105*       add ix,de ; ix is now the address of the table entry
0473B7 DD CB 1D 76 0106*       bit sprite_alive,(ix+tile_collisions)
0473BB CA C3 73 04 0107*       jp z,@found
0473BF 10 E5       0108*       djnz @search
0473C1             0109*   @not_found:
0473C1 AF          0110*       xor a ; reset carry flag indicating that we didn't find a free tile
0473C2 C9          0111*       ret
0473C3             0112*   @found:
0473C3 32 3E 73 04 0113*       ld (next_tile_id),a
0473C7 DD 77 00    0114*       ld (ix+tile_id),a ; repair the stable identity byte before publishing it
0473CA 21 3B 73 04 0115*       ld hl,num_active_tiles
0473CE 34          0116*       inc (hl)
0473CF 7E          0117*       ld a,(hl) ; number of active tiles
0473D0             0118*   ; add tile pointer to tile stack
0473D0 21 32 70 04 0119*       ld hl,tile_stack
0473D4 11 00 00 00 0120*       ld de,0 ; keep the second pointer offset independently width-safe
0473D8 57          0121*       ld d,a ; number of active tiles
0473D9 15          0122*       dec d ; zero-based index
0473DA 1E 03       0123*       ld e,3 ; three bytes per tile record
0473DC ED 5C       0124*       mlt de ; offset into tile stack
0473DE 19          0125*       add hl,de ; hl points to top of the active tiles
0473DF ED 3F       0126*       ld (hl),ix
0473E1             0127*   ; return tile id
0473E1 DD 7E 00    0128*       ld a,(ix+tile_id)
0473E4 37          0129*       scf ; sets carry flag indicating we found a free tile
0473E5 C9          0130*       ret ; done
0473E6             0131*   ; end tile_table_get_next_id
0473E6             0132*   
0473E6             0133*   ; Validate an address into the dense tile-stack entries currently in use.
0473E6             0134*   ; inputs: hl = candidate tile-stack address
0473E6             0135*   ; outputs: carry set for an aligned slot in the active dense-stack range
0473E6             0136*   ; destroys: a,de,hl
0473E6             0137*   tile_stack_pointer_valid:
0473E6 11 32 70 04 0138*       ld de,tile_stack
0473EA B7          0139*       or a
0473EB ED 52       0140*       sbc hl,de
0473ED DA 1D 74 04 0141*       jp c,@invalid
0473F1 3A 3B 73 04 0142*       ld a,(num_active_tiles)
0473F5 B7          0143*       or a
0473F6 CA 1D 74 04 0144*       jp z,@invalid
0473FA 11 00 00 00 0145*       ld de,0
0473FE 57          0146*       ld d,a
0473FF 1E 03       0147*       ld e,3
047401 ED 5C       0148*       mlt de
047403 B7          0149*       or a
047404 ED 52       0150*       sbc hl,de
047406 D2 1D 74 04 0151*       jp nc,@invalid
04740A 19          0152*       add hl,de ; restore the in-range offset
04740B             0153*   ; For offsets below 768, divisibility by three can be tested without a loop.
04740B             0154*   ; 256 == 1 (mod 3), and multiplication by 171 maps byte multiples of three
04740B             0155*   ; into 0..85 while every non-multiple maps into 86..255.
04740B 7C          0156*       ld a,h
04740C 85          0157*       add a,l
04740D CE 00       0158*       adc a,0
04740F 57          0159*       ld d,a
047410 1E AB       0160*       ld e,171
047412 ED 5C       0161*       mlt de
047414 7B          0162*       ld a,e
047415 FE 56       0163*       cp 86
047417 D2 1D 74 04 0164*       jp nc,@invalid
04741B 37          0165*       scf
04741C C9          0166*       ret
04741D             0167*   @invalid:
04741D AF          0168*       xor a
04741E C9          0169*       ret
04741F             0170*   ; end tile_stack_pointer_valid
04741F             0171*   
04741F             0172*   ; Validate a 64-byte-aligned pointer into the active-tile record table.
04741F             0173*   ; inputs: iy = candidate tile record
04741F             0174*   ; outputs: carry set only for an aligned in-range record pointer
04741F             0175*   ; destroys: a,de,hl
04741F             0176*   tile_table_record_pointer_valid:
04741F FD E5       0177*       push iy
047421 E1          0178*       pop hl
047422 11 86 8C 04 0179*       ld de,tile_table_base
047426 B7          0180*       or a
047427 ED 52       0181*       sbc hl,de ; offset from the tile-table base
047429 DA 53 74 04 0182*       jp c,@invalid
04742D 11 00 40 00 0183*       ld de,tile_table_end-tile_table_base
047431 B7          0184*       or a
047432 ED 52       0185*       sbc hl,de
047434 D2 53 74 04 0186*       jp nc,@invalid
047438 19          0187*       add hl,de ; restore the in-range offset
047439 7D          0188*       ld a,l
04743A E6 3F       0189*       and tile_table_record_size-1
04743C C2 53 74 04 0190*       jp nz,@invalid
047440             0191*   ; Convert the aligned offset to its stable record id: H*4 + L/64.
