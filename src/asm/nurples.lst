04732B             0411*   ; Snap the final subpixel residue to the shared, reviewed endpoint.
04732B 21 00 78 00 0412*       ld hl,player_entry_target_x*256
04732F FD 2F 01    0413*       ld (iy+sprite_x),hl
047332 21 00 E0 00 0414*       ld hl,player_entry_target_y*256
