04900F             0077        include "tile_lightning.inc"
04900F             0001*   lightning_defaults:
04900F 0A          0002*       db tile_lightning       ; type
049010 50 01 00    0003*       dl BUF_LIGHTNING_H_0    ; base_bufferId
049013 2C 90 04    0004*       dl move_lightning       ; move_program
049016 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
049017 10          0006*       db 16                   ; dim_x
049018 10          0007*       db 16                   ; dim_y
049019 01          0008*       db 1                    ; num_orientations
04901A 02          0009*       db 2                    ; num_animations
04901B 00          0010*       db 0                    ; animation
04901C 08          0011*       db 8                    ; animation_timer
04901D 00          0012*       db 0                    ; move_timer
04901E 00          0013*       db 0                    ; move_step
04901F 00          0014*       db 0                    ; points
049020 FF          0015*       db -1                    ; shield_damage
049021 00          0016*       db 0                    ; frame
049022             0017*   
049022             0018*   activate_lightning:
049022 21 0F 90 04 0019*       ld hl,lightning_defaults
049026             0020*   ; get next available active tile id
049026 CD 5E 8A 04 0021*       call spawn_active_tile
04902A D0          0022*       ret nc ; no carry means no free active tile slots, so we go home
04902B             0023*   ; other specific initialization
04902B C9          0024*       ret
04902C             0025*   ; end activate_lightning
04902C             0026*   
04902C             0027*   move_lightning:
04902C CD B4 8C 04 0028*       call move_active_tile
049030 CA C6 89 04 0029*       jp z,table_deactivate_tile
