047A49             0025*   discharge_fuel:
047A49             0026*   ; check fuel timer
047A49 21 47 7A 04 0027*       ld hl,discharge_fuel_timer
047A4D 35          0028*       dec (hl)
047A4E C0          0029*       ret nz ; not time to discharge fuel so return
047A4F             0030*   ; reset fuel discharge timer
047A4F 3A 48 7A 04 0031*       ld a,(discharge_fuel_timer_max)
047A53 77          0032*       ld (hl),a
047A54             0033*   ; discharge fuel
047A54 21 44 7A 04 0034*       ld hl,player_fuel
047A58 35          0035*       dec (hl)
047A59 CA 62 7A 04 0036*       jp z,@no_fuel
047A5D FA 62 7A 04 0037*       jp m,@no_fuel
047A61 C9          0038*       ret ; fuel not zero so return
047A62             0039*   @no_fuel:
047A62 36 00       0040*       ld (hl),0 ; TODO: implement out-of-fuel handler
047A64 C9          0041*       ret
047A65             0042*   ; end discharge_fuel
047A65             0043*   
047A65             0044*   draw_fuel:
047A65 CD 49 7A 04 0045*       call discharge_fuel
047A69 21 45 7A 04 0046*       ld hl,player_fuel_last
047A6D 3A 44 7A 04 0047*       ld a,(player_fuel)
047A71 BE          0048*       cp (hl)
047A72 C8          0049*       ret z ; no change to update
047A73 77          0050*       ld (hl),a
047A74 DD 21 19 7A 0051*       ld ix,bar_fuel
       04          
047A79 DD 77 00    0052*       ld (ix+bar_val),a ; TODO: this is redundant
047A7C CD C3 79 04 0053*       call bar_update_h
047A80 C9          0054*       ret
