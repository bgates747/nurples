044B1F             0063*   @animate:
044B1F             0064*   ; check the animation timer
044B1F FD 35 23    0065*       dec (iy+sprite_animation_timer)
044B22 C0          0066*       ret nz ; not time to animate
044B23             0067*   ; reset the animation timer and bump animation
044B23 3E 08       0068*       ld a,8
044B25 FD 77 23    0069*       ld (iy+sprite_animation_timer),a
044B28 FD 7E 22    0070*       ld a,(iy+sprite_animation)
044B2B 3C          0071*       inc a
044B2C E6 01       0072*       and %00000001 ; modulo 2
044B2E FD 77 22    0073*       ld (iy+sprite_animation),a
044B31 CD 75 6B 04 0074*       call sprite_frame_heading_animation ; a, sprite_frame set to heading-based frame
044B35 CD 66 1A 04 0075*       call vdu_sprite_select_frame
044B39 C9          0076*       ret
044B3A             0077*   ; end move_enemy_fireball
044B3A             0078*   
044B3A             0079*   init_enemy_fireballs:
044B3A             0080*   ; set pointer to seeker sprite table
044B3A FD 21 D8 8F 0081*       ld iy,fireballs_base
       04          
044B3F FD 7E 00    0082*       ld a,(iy+sprite_id) ; sprite id
044B42 1E 04       0083*       ld e,fireballs_max ; sprite loop counter
044B44             0084*   ; define seeker sprites
044B44             0085*   @sprites_loop:
