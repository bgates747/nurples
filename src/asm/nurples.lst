0420C1             0067*   ; reset the animation timer and bump animation
0420C1 3E 08       0068*       ld a,8
0420C3 FD 77 23    0069*       ld (iy+sprite_animation_timer),a
0420C6 FD 7E 22    0070*       ld a,(iy+sprite_animation)
0420C9 3C          0071*       inc a
0420CA E6 01       0072*       and %00000001 ; modulo 2
0420CC FD 77 22    0073*       ld (iy+sprite_animation),a
0420CF CD 14 83 04 0074*       call sprite_frame_heading_animation ; a, sprite_frame set to heading-based frame
0420D3 CD 3A 19 04 0075*       call vdu_sprite_select_frame
