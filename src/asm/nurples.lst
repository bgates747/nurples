047B94             0072        include "sprites.inc"
047B94             0001*   ; sprite_type
047B94             0002*   enemy_dead: equ 0
047B94             0003*   enemy_air: equ 1
047B94             0004*   enemy_ground: equ 2
047B94             0005*   enemy_projectile: equ 3
047B94             0006*   explosion: equ 4
047B94             0007*   player: equ 5
047B94             0008*   player_air: equ 6
047B94             0009*   player_ground: equ 7
047B94             0010*   
047B94             0011*   ; ###### SPRITE TABLE FIELD INDICES ######
047B94             0012*   table_record_size:         equ  actor_record_size; bytes per sprite record
047B94             0013*   sprite_id:                 equ   0; 1 bytes ;unique spriteId, zero-based
047B94             0014*   ; sprite state variables
047B94             0015*   sprite_state_variables:    equ   1; beginning of sprite state variables
047B94             0016*   sprite_x:                  equ   1; 3 bytes ;16.8 fractional x position in pixels
047B94             0017*   sprite_y:                  equ   4; 3 bytes ;16.8 fractional y position in pixels
047B94             0018*   sprite_xvel:               equ   7; 3 bytes ;x-component velocity, 16.8 fixed, pixels
047B94             0019*   sprite_yvel:               equ  10; 3 bytes ;y-component velocity, 16.8 fixed, pixels
047B94             0020*   sprite_vel:                equ  13; 3 bytes ;velocity px/frame (16.8 fixed)
047B94             0021*   sprite_heading:            equ  16; 3 bytes ;sprite movement direction deg256 16.8 fixed
047B94             0022*   sprite_orientation:        equ  19; 3 bytes ;orientation bits
047B94             0023*   ; sprite definition variables
047B94             0024*   sprite_definitions:        equ  22; beginnning of sprite definition variables
047B94             0025*   sprite_type:               equ  22; 1 bytes ;type of sprite as defined in enemies.inc
047B94             0026*   sprite_base_bufferId:      equ  23; 3 bytes ;bitmap bufferId
047B94             0027*   sprite_move_program:       equ  26; 3 bytes ;address of sprite's behavior subroutine
047B94             0028*   sprite_collisions:         equ  29; 1 bytes ;see collisions.inc constants for bit definitions
047B94             0029*   sprite_dim_x:              equ  30; 1 bytes ;sprite width in pixels
047B94             0030*   sprite_dim_y:              equ  31; 1 bytes ;sprite height in pixels
047B94             0031*   sprite_num_orientations:   equ  32; 1 bytes ;number of orientations for this sprite
047B94             0032*   sprite_num_animations:     equ  33; 1 bytes ;number of animations for this sprite
047B94             0033*   sprite_animation:          equ  34; 1 bytes ;current animation index, zero-based
047B94             0034*   sprite_animation_timer:    equ  35; 1 bytes ;when hits zero, draw next animation
047B94             0035*   sprite_move_timer:         equ  36; 1 bytes ;when zero, go to next move program, or step
047B94             0036*   sprite_move_step:          equ  37; 1 bytes ;stage in a move program sequence, varies
047B94             0037*   sprite_points:             equ  38; 1 bytes ;points awarded for killing this sprite type
047B94             0038*   sprite_shield_damage:      equ  39; 1 bytes ;shield points deducted for collision
047B94             0039*   sprite_frame:              equ  40; 1 bytes ;current animation frame
047B94             0040*   sprite_definitions_size:   equ  sprite_frame-sprite_definitions+1
047B94             0041*   sprite_custom:             equ  actor_record_custom
047B94             0042*       .if table_record_size-actor_record_size
047B94             0043*           dl sprite_record_size_mismatch
047B94             0044*       .endif
047B94             0045*       .if [sprite_definitions+sprite_definitions_size]-actor_record_shared_end
047B94             0046*           dl sprite_shared_header_span_mismatch
047B94             0047*       .endif
047B94             0048*       .if sprite_custom-actor_record_custom
047B94             0049*           dl sprite_custom_offset_mismatch
047B94             0050*       .endif
047B94             0051*   
047B94             0052*   ; ###### SPRITE TABLE VARIABLES ######
047B94             0053*   ; pointer to top address of current record, initialized to table_base
047B94 E2 A3 04    0054*   table_pointer: dl table_base
047B97             0055*   
047B97             0056*   ; flag indicating collision with screen edge
047B97 00          0057*   sprite_screen_edge: db #00
047B98             0058*   sprite_fault_bad_record: equ 0
047B98             0059*   sprite_fault_bad_move_program: equ 1
047B98             0060*   sprite_fault_bad_pool: equ 2
047B98 00          0061*   sprite_fault_flags: db 0 ; latched fail-closed diagnostics
047B99             0062*   
047B99             0063*   ; ######### COLLISION SPRITE PARAMETERS ##########
047B99             0064*   ; integer coordinates are all that are needed for collision calculations
047B99 00          0065*   collision_x: db 0x00
047B9A 00          0066*   collision_y: db 0x00
047B9B 00          0067*   collision_dim_x: db 0x00
047B9C 00          0068*   collision_dim_y: db 0x00
047B9D             0069*   
047B9D             0070*   ; scratch variables
047B9D 00          0071*   x: db 0x00 ; 8-bit signed integer
047B9E 00          0072*   y: db 0x00 ; 8-bit signed integer
047B9F 00 00 00    0073*   x0: dl 0x000000 ; 16.8 signed fixed place
047BA2 00 00 00    0074*   y0: dl 0x000000 ; 16.8 signed fixed place
047BA5 00 00 00    0075*   incx1: dl 0x000000 ; 16.8 signed fixed place
047BA8 00 00 00    0076*   incy1: dl 0x000000 ; 16.8 signed fixed place
047BAB 00 00 00    0077*   incx2: dl 0x000000 ; 16.8 signed fixed place
047BAE 00 00 00    0078*   incy2: dl 0x000000 ; 16.8 signed fixed place
047BB1             0079*   
047BB1             0080*   ; sprite_heading: dl 0x000000 ; signed fixed 16.8
047BB1 00 00 00    0081*   radius: dl 0x000000 ; signed fixed 16.8 (but should always be positive)
047BB4 00 00 00    0082*   sin_sprite_heading: dl 0x000000 ; signed fixed 16.8
047BB7 00 00 00    0083*   cos_sprite_heading: dl 0x000000 ; signed fixed 16.8
047BBA             0084*   
047BBA             0085*   table_init:
047BBA             0086*   ; clear the sprite table
047BBA AF          0087*       xor a ; write zeroes to sprite table
047BBB 21 E2 A3 04 0088*       ld hl,table_base ; address to copy from
047BBF 01 00 05 00 0089*       ld bc,table_end-table_base ; number of bytes to clear
047BC3 CD 5B 03 04 0090*       call clear_mem
047BC7             0091*   ; write sprite ids
047BC7 DD 21 E2 A3 0092*       ld ix,table_base
       04          
047BCC AF          0093*       xor a ; sprite id
047BCD 0E 00       0094*       ld c,0 ; sprite type
047BCF 06 14       0095*       ld b,table_num_records ; loop counter
047BD1             0096*   @loop:
047BD1 DD 77 00    0097*       ld (ix+sprite_id),a
047BD4 DD 71 16    0098*       ld (ix+sprite_type),c
047BD7 ED 32 40    0099*       lea ix,ix+table_record_size
047BDA 3C          0100*       inc a
047BDB 10 F4       0101*       djnz @loop
047BDD C9          0102*       ret
047BDE             0103*   ; end table_init
047BDE             0104*   
047BDE             0105*   ; Validate a record pointer and its stable identity byte against the physical
047BDE             0106*   ; 64-byte slot it occupies in the sprite table.
047BDE             0107*   ; inputs: iy = candidate sprite record
047BDE             0108*   ; outputs: carry set only for an aligned in-range pointer with the expected id
047BDE             0109*   ; destroys: a,de,hl
047BDE             0110*   sprite_table_record_pointer_valid:
047BDE FD E5       0111*       push iy
047BE0 E1          0112*       pop hl
047BE1 11 E2 A3 04 0113*       ld de,table_base
047BE5 B7          0114*       or a
047BE6 ED 52       0115*       sbc hl,de ; offset from the sprite-table base
047BE8 DA 12 7C 04 0116*       jp c,@invalid
047BEC 11 00 05 00 0117*       ld de,table_end-table_base
047BF0 B7          0118*       or a
047BF1 ED 52       0119*       sbc hl,de
047BF3 D2 12 7C 04 0120*       jp nc,@invalid
047BF7 19          0121*       add hl,de ; restore the in-range offset
047BF8 7D          0122*       ld a,l
047BF9 E6 3F       0123*       and table_record_size-1
047BFB C2 12 7C 04 0124*       jp nz,@invalid
047BFF             0125*   ; Convert the aligned offset to its record id: H*4 + L/64.
047BFF 7C          0126*       ld a,h
047C00 87          0127*       add a,a
047C01 87          0128*       add a,a
047C02 57          0129*       ld d,a
047C03 7D          0130*       ld a,l
047C04 07          0131*       rlca
047C05 07          0132*       rlca
047C06 E6 03       0133*       and %00000011
047C08 B2          0134*       or d
047C09 FD BE 00    0135*       cp (iy+sprite_id)
047C0C C2 12 7C 04 0136*       jp nz,@invalid
047C10 37          0137*       scf
047C11 C9          0138*       ret
047C12             0139*   @invalid:
047C12 AF          0140*       xor a
047C13 C9          0141*       ret
047C14             0142*   ; end sprite_table_record_pointer_valid
047C14             0143*   
047C14             0144*   ; deactivate the sprite with the given id
047C14             0145*   ; inputs: iy set to sprite record
047C14             0146*   ; outputs: nothing
047C14             0147*   ; destroys: a,de,hl
047C14             0148*   table_deactivate_sprite:
047C14 CD DE 7B 04 0149*       call sprite_table_record_pointer_valid
047C18 D2 34 7C 04 0150*       jp nc,@invalid
047C1C FD 7E 00    0151*       ld a,(iy+sprite_id) ; get spriteId
047C1F FD E5       0152*       push iy
047C21 CD 03 1A 04 0153*       call vdu_sprite_select ; select sprite
047C25 CD 87 1A 04 0154*       call vdu_sprite_hide
047C29 FD E1       0155*       pop iy
047C2B FD CB 1D B6 0156*       res sprite_alive,(iy+sprite_collisions)
047C2F FD CB 1D BE 0157*       res sprite_just_died,(iy+sprite_collisions)
047C33 C9          0158*       ret
047C34             0159*   @invalid:
047C34 21 98 7B 04 0160*       ld hl,sprite_fault_flags
047C38 CB C6       0161*       set sprite_fault_bad_record,(hl)
047C3A C9          0162*       ret
047C3B             0163*   ; end table_deactivate_sprite
047C3B             0164*   
047C3B             0165*   sprites_init:
047C3B             0166*   ; initialize sprites
047C3B CD 37 1B 04 0167*   	call vdu_sprite_reset ; clear sprite data in vdp
047C3F             0168*   
047C3F             0169*   ; define player sprite
047C3F 3A E2 A4 04 0170*   	ld a,(player_begin+sprite_id)
047C43 CD 03 1A 04 0171*   	call vdu_sprite_select
047C47 CD 16 1A 04 0172*   	call vdu_sprite_clear_frames
047C4B 21 73 01 00 0173*   	ld hl,BUF_SHIP_0L
047C4F 06 03       0174*   	ld b,3 ; DJNZ consumes B; loading BC with 3 would put zero in B
047C51             0175*   @sprite_player_loop:
047C51 C5          0176*   	push bc
047C52 E5          0177*   	push hl
047C53 CD 58 1B 04 0178*   	call vdu_sprite_add_buff
047C57 E1          0179*   	pop hl
047C58 23          0180*   	inc hl
047C59 C1          0181*   	pop bc
047C5A 10 F5       0182*   	djnz @sprite_player_loop
047C5C             0183*   
047C5C             0184*   ; define player weapon sprites
047C5C CD DF 79 04 0185*       call init_player_laser
047C60             0186*   
047C60             0187*   ; define enemy sprites
047C60 CD 69 4D 04 0188*       call init_enemy_seekers
047C64 CD 69 4B 04 0189*       call init_enemy_fireballs
047C68             0190*   
047C68             0191*   ; define explosion sprites
047C68 CD 41 4E 04 0192*       call init_explosions
047C6C             0193*   
047C6C             0194*   ; activate only after every contiguous sprite has its final frame definitions
047C6C 3E 14       0195*       ld a,table_num_records
047C6E CD 37 1A 04 0196*   	call vdu_sprite_activate
047C72 C9          0197*       ret
047C73             0198*   ; end sprites_init
047C73             0199*   
047C73             0200*   ; gets the next available sprite id for a particular sprite group
047C73             0201*   ; inputs; ix = pointer to sprite group, b = number of records in sprite group
047C73             0202*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
047C73             0203*   ;      otherwise, a = 0, carry reset, ix invalid and must not be dereferenced
047C73             0204*   ; destroys: a,b,c,hl,ix
047C73             0205*   table_get_next_id:
047C73 CD 95 7C 04 0206*       call sprite_pool_valid
047C77 D2 8D 7C 04 0207*       jp nc,@bad_pool
047C7B             0208*   @loop:
047C7B DD CB 1D 76 0209*       bit sprite_alive,(ix+sprite_collisions)
047C7F 28 07       0210*       jr z,@found
047C81 ED 32 40    0211*       lea ix,ix+table_record_size
047C84 10 F5       0212*       djnz @loop
047C86             0213*   @notfound:
047C86 AF          0214*       xor a ; a = 0 and reset carry flag indicating that we didn't find a free sprite
047C87 C9          0215*       ret
047C88             0216*   @found:
047C88             0217*   ; return sprite id
047C88 DD 7E 00    0218*       ld a,(ix+sprite_id)
047C8B 37          0219*       scf ; sets carry flag indicating we found a free sprite
047C8C C9          0220*       ret ; done
047C8D             0221*   @bad_pool:
047C8D 21 98 7B 04 0222*       ld hl,sprite_fault_flags
047C91 CB D6       0223*       set sprite_fault_bad_pool,(hl)
047C93 AF          0224*       xor a
047C94 C9          0225*       ret
047C95             0226*   ; end table_get_next_id
047C95             0227*   
047C95             0228*   ; Admit only the five compile-time sprite pools. This prevents a bad caller
047C95             0229*   ; from scanning or writing across an adjacent actor pool before dispatch-time
047C95             0230*   ; record validation can contain it.
047C95             0231*   ; inputs: ix = pool base, b = pool count
047C95             0232*   ; outputs: carry set only for an exact known base/count pair
047C95             0233*   ; destroys: a,de,hl
047C95             0234*   sprite_pool_valid:
047C95 11 E2 A3 04 0235*       ld de,player_lasers_begin
047C99 CD 0C 7D 04 0236*       call @base_matches
047C9D CA D5 7C 04 0237*       jp z,@player_lasers
047CA1 11 E2 A4 04 0238*       ld de,player_begin
047CA5 CD 0C 7D 04 0239*       call @base_matches
047CA9 CA E0 7C 04 0240*       jp z,@player
047CAD 11 22 A5 04 0241*       ld de,seekers_base
047CB1 CD 0C 7D 04 0242*       call @base_matches
047CB5 CA EB 7C 04 0243*       jp z,@seekers
047CB9 11 E2 A5 04 0244*       ld de,fireballs_base
047CBD CD 0C 7D 04 0245*       call @base_matches
047CC1 CA F6 7C 04 0246*       jp z,@fireballs
047CC5 11 E2 A6 04 0247*       ld de,explosions_base
047CC9 CD 0C 7D 04 0248*       call @base_matches
047CCD CA 01 7D 04 0249*       jp z,@explosions
047CD1 C3 0A 7D 04 0250*       jp @invalid
047CD5             0251*   @player_lasers:
047CD5 78          0252*       ld a,b
047CD6 FE 04       0253*       cp player_lasers_max
047CD8 CA 08 7D 04 0254*       jp z,@valid
047CDC C3 0A 7D 04 0255*       jp @invalid
047CE0             0256*   @player:
047CE0 78          0257*       ld a,b
047CE1 FE 01       0258*       cp 1
047CE3 CA 08 7D 04 0259*       jp z,@valid
047CE7 C3 0A 7D 04 0260*       jp @invalid
047CEB             0261*   @seekers:
047CEB 78          0262*       ld a,b
047CEC FE 03       0263*       cp seekers_max
047CEE CA 08 7D 04 0264*       jp z,@valid
047CF2 C3 0A 7D 04 0265*       jp @invalid
047CF6             0266*   @fireballs:
047CF6 78          0267*       ld a,b
047CF7 FE 04       0268*       cp fireballs_max
047CF9 CA 08 7D 04 0269*       jp z,@valid
047CFD C3 0A 7D 04 0270*       jp @invalid
047D01             0271*   @explosions:
047D01 78          0272*       ld a,b
047D02 FE 08       0273*       cp explosions_max
047D04 C2 0A 7D 04 0274*       jp nz,@invalid
047D08             0275*   @valid:
047D08 37          0276*       scf
047D09 C9          0277*       ret
047D0A             0278*   @invalid:
047D0A AF          0279*       xor a
