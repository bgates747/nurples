048F7C FD 77 23    0042*       ld (iy+tile_animation_timer),a
048F7F FD 7E 28    0043*       ld a,(iy+tile_frame)
048F82 3C          0044*       inc a
048F83 E6 01       0045*       and %00000001 ; modulo 1
048F85 FD 77 28    0046*       ld (iy+tile_frame),a
048F88 C3 77 8D 04 0047*       jp draw_active_tile
048F8C C9          0048*       ret
048F8D             0078        include "tile_pad_small.inc"
048F8D             0001*   pad_small_defaults:
048F8D 01          0002*       db tile_pad_small       ; type
048F8E 77 01 00    0003*       dl BUF_TILE_PAD_0       ; base_bufferId
048F91 B3 8F 04    0004*       dl move_pad_small       ; move_program
048F94 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
048F95 10          0006*       db 16                   ; dim_x
