0469F6 FD 7E 00    0409*       ld a,(iy+sprite_id)
0469F9 CD AE 19 04 0410*       call vdu_sprite_select
0469FD FD 07 01    0411*       ld bc,(iy+sprite_x)
046A00 FD 17 04    0412*       ld de,(iy+sprite_y)
046A03 CD 7A 1A 04 0413*       call vdu_sprite_move_abs168
