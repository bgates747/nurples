04231C C1          0191*   	pop bc
04231D 10 F5       0192*   	djnz @frames_loop
04231F D1          0193*       pop de ; sprite loop counter
042320 F1          0194*       pop af ; sprite id
042321 3C          0195*       inc a
042322 1D          0196*       dec e
042323 C2 04 23 04 0197*       jp nz,@sprites_loop
042327 C9          0198*       ret
