0416B3             0040        include "vdu_buffered_api.inc"
0416B3             0001*   ; https://agonconsole8.github.io/agon-docs/vdp/Buffered-Commands-API/
0416B3             0002*   
0416B3             0003*   ; Command 0: Write block to a buffer
0416B3             0004*   ; VDU 23, 0, &A0, bufferId; 0, length; <buffer-data>
0416B3             0005*   ; inputs: hl = bufferId, bc = length of data, de = pointer to data
0416B3             0006*   vdu_write_block_to_buffer:
0416B3             0007*   ; back up input parameters
0416B3 D5          0008*       push de ; pointer to data
0416B4 C5          0009*       push bc ; length of data
0416B5             0010*   ; set up the vdu command string
0416B5 22 D5 16 04 0011*       ld (@bufferId),hl
0416B9 ED 43 D8 16 0012*       ld (@length),bc
       04          
0416BE AF          0013*       xor a ; load buffer
0416BF 32 D7 16 04 0014*       ld (@bufferId+2),a
0416C3 21 D2 16 04 0015*       ld hl,@cmd0
0416C7 01 08 00 00 0016*       ld bc,@end0-@cmd0
0416CB 5B DF       0017*       rst.lil $18
0416CD             0018*   ; send the buffer data
0416CD C1          0019*       pop bc ; length of data
0416CE E1          0020*       pop hl ; pointer to data (was de)
0416CF 5B DF       0021*       rst.lil $18 ; send it
0416D1 C9          0022*       ret
0416D2             0023*   ; command string data
0416D2 17 00 A0    0024*   @cmd0:      db 23,0,0xA0
0416D5 00 00       0025*   @bufferId:	dw 0x0000
0416D7 00          0026*               db 0 ; load buffer
0416D8 00 00       0027*   @length:	dw 0x0000
0416DA 00          0028*   @end0:      db 0x00 ; padding
0416DB             0029*   ; end vdu_write_block_to_buffer
0416DB             0030*   
0416DB             0031*   ; Command 1: Call a buffer
0416DB             0032*   ; VDU 23, 0, &A0, bufferId; 1
0416DB             0033*   ; inputs: hl = bufferId
0416DB             0034*   vdu_call_buffer:
0416DB 22 F3 16 04 0035*       ld (@bufferId),hl
0416DF 3E 01       0036*       ld a,1 ; call buffer
0416E1 32 F5 16 04 0037*       ld (@bufferId+2),a
0416E5 21 F0 16 04 0038*       ld hl,@cmd
0416E9 01 06 00 00 0039*       ld bc,@end-@cmd
0416ED 5B DF       0040*       rst.lil $18
0416EF C9          0041*       ret
0416F0 17 00 A0    0042*   @cmd:     db 23,0,0xA0
0416F3 00 00       0043*   @bufferId: dw 0x0000
0416F5 01          0044*              db 1 ; call buffer
0416F6             0045*   @end:
0416F6             0046*   ; end vdu_call_buffer
0416F6             0047*   
0416F6             0048*   ; Command 2: Clear a buffer
0416F6             0049*   ; VDU 23, 0 &A0, bufferId; 2
0416F6             0050*   ; inputs: hl = bufferId
0416F6             0051*   vdu_clear_buffer:
0416F6 22 0E 17 04 0052*       ld (@bufferId),hl
0416FA 3E 02       0053*       ld a,2 ; clear buffer
0416FC 32 10 17 04 0054*       ld (@bufferId+2),a
041700 21 0B 17 04 0055*       ld hl,@cmd
041704 01 06 00 00 0056*       ld bc,@end-@cmd
041708 5B DF       0057*       rst.lil $18
04170A C9          0058*       ret
04170B 17 00 A0    0059*   @cmd:     db 23,0,0xA0
04170E 00 00       0060*   @bufferId: dw 0x0000
041710 02          0061*              db 2 ; clear buffer
041711             0062*   @end:
041711             0063*   ; end vdu_clear_buffer
041711             0064*   
041711             0065*   ; Clear all buffers
041711             0066*   ; inputs: none
041711             0067*   vdu_clear_all_buffers:
041711             0068*   ; clear all buffers
041711 21 1C 17 04 0069*       ld hl,@beg
041715 01 06 00 00 0070*       ld bc,@end-@beg
041719 5B DF       0071*       rst.lil $18
04171B C9          0072*       ret
04171C 17 00 A0    0073*   @beg: db 23,0,$A0
04171F FF FF       0074*         dw -1 ; bufferId -1 (65535) means clear all buffers
041721 02          0075*         db 2  ; command 2: clear a buffer
041722             0076*   @end:
041722             0077*   ; end vdu_clear_all_buffers
041722             0078*   
041722             0079*   ; Command 3: Create a writeable buffer
041722             0080*   ; VDU 23, 0 &A0, bufferId; 3, length;
041722             0081*   ; inputs: hl = bufferId, bc = length
041722             0082*   vdu_create_writeable_buffer:
041722 22 3F 17 04 0083*       ld (@bufferId),hl
041726 ED 43 42 17 0084*       ld (@length),bc
       04          
04172B 3E 03       0085*       ld a,3 ; create writeable buffer
04172D 32 41 17 04 0086*       ld (@bufferId+2),a
041731 21 3C 17 04 0087*       ld hl,@cmd
041735 01 08 00 00 0088*       ld bc,@end-@cmd
041739 5B DF       0089*       rst.lil $18
04173B C9          0090*       ret
04173C 17 00 A0    0091*   @cmd:     db 23,0,0xA0
04173F 00 00       0092*   @bufferId: dw 0x0000
041741 03          0093*              db 3 ; create writeable buffer
041742 00 00       0094*   @length: dw 0x0000
041744 00          0095*   @end:     db 0x00 ; padding
041745             0096*   ; end vdu_create_writeable_buffer
041745             0097*   
041745             0098*   ; Command 4: Set output stream to a buffer
041745             0099*   ; VDU 23, 0 &A0, bufferId; 4
041745             0100*   ; inputs: hl = bufferId
041745             0101*   vdu_set_output_stream_buffer:
041745 22 5D 17 04 0102*       ld (@bufferId),hl
041749 3E 04       0103*       ld a,4 ; set output stream to buffer
04174B 32 5F 17 04 0104*       ld (@bufferId+2),a
04174F 21 5A 17 04 0105*       ld hl,@cmd
041753 01 06 00 00 0106*       ld bc,@end-@cmd
041757 5B DF       0107*       rst.lil $18
041759 C9          0108*       ret
04175A 17 00 A0    0109*   @cmd:     db 23,0,0xA0
04175D 00 00       0110*   @bufferId: dw 0x0000
04175F 04          0111*              db 4 ; set output stream to buffer
041760 00          0112*   @end:     db 0x00 ; padding
041761             0113*   ; end vdu_set_output_stream_buffer
041761             0114*   
041761             0115*   ; Command 5: Adjust buffer contents
041761             0116*   ; VDU 23, 0, &A0, bufferId; 5, operation, offset; [count;] <operand>, [arguments]
041761             0117*   vdu_adjust_buffer:
041761 C9          0118*       ret ; TODO: implement
041762             0119*   ; end vdu_adjust_buffer
041762             0120*   
041762             0121*   ; Command 6: Conditionally call a buffer
041762             0122*   ; VDU 23, 0, &A0, bufferId; 6, operation, checkBufferId; checkOffset; [arguments]
041762             0123*   vdu_call_buffer_conditional:
041762 C9          0124*       ret ; TODO: implement
041763             0125*   ; end vdu_call_buffer_conditional
041763             0126*   
041763             0127*   ; Command 7: Jump to a buffer
041763             0128*   ; VDU 23, 0, &A0, bufferId; 7
041763             0129*   ; inputs: hl = bufferId
041763             0130*   vdu_jump_to_buffer:
041763 22 7B 17 04 0131*       ld (@bufferId),hl
041767 3E 07       0132*       ld a,7 ; jump to buffer
041769 32 7D 17 04 0133*       ld (@bufferId+2),a
04176D 21 78 17 04 0134*       ld hl,@cmd
041771 01 06 00 00 0135*       ld bc,@end-@cmd
041775 5B DF       0136*       rst.lil $18
041777 C9          0137*       ret
041778 17 00 A0    0138*   @cmd:     db 23,0,0xA0
04177B 00 00       0139*   @bufferId: dw 0x0000
04177D 07          0140*              db 7 ; jump to buffer
04177E 00          0141*   @end:     db 0x00 ; padding
04177F             0142*   ; end vdu_jump_to_buffer
04177F             0143*   
04177F             0144*   ; Command 8: Conditional Jump to a buffer
04177F             0145*   ; VDU 23, 0, &A0, bufferId; 8, operation, checkBufferId; checkOffset; [arguments]
04177F             0146*   vdu_jump_to_buffer_conditional:
04177F C9          0147*       ret ; TODO: implement
041780             0148*   ; end vdu_jump_to_buffer_conditional
041780             0149*   
041780             0150*   ; Command 9: Jump to an offset in a buffer
041780             0151*   ; VDU 23, 0, &A0, bufferId; 9, offset; offsetHighByte, [blockNumber;]
041780             0152*   vdu_jump_to_buffer_offset:
041780 C9          0153*       ret ; TODO: implement
041781             0154*   ; end vdu_jump_to_buffer_offset
041781             0155*   
041781             0156*   ; Command 10: Conditional jump to an offset in a buffer
041781             0157*   ; VDU 23, 0, &A0, bufferId; 10, offset; offsetHighByte, [blockNumber;] [arguments]
041781             0158*   vdu_jump_to_buffer_offset_conditional:
041781 C9          0159*       ret ; TODO: implement
041782             0160*   ; end vdu_jump_to_buffer_offset_conditional
041782             0161*   
041782             0162*   ; Command 11: Call buffer with an offset
041782             0163*   ; VDU 23, 0, &A0, bufferId; 11, offset; offsetHighByte, [blockNumber;]
041782             0164*   vdu_call_buffer_offset:
041782 C9          0165*       ret ; TODO: implement
041783             0166*   ; end vdu_call_buffer_offset
041783             0167*   
041783             0041        include "vdu_fonts.inc"
041783             0001*   ; select font
041783             0002*   ; inputs: hl = bufferId, a = font flags
041783             0003*   ; Flags:
041783             0004*   ; Bit	Description
041783             0005*   ; 0	Adjust cursor position to ensure text baseline is aligned
041783             0006*   ;   0: Do not adjust cursor position (best for changing font on a new line)
041783             0007*   ;   1: Adjust cursor position (best for changing font in the middle of a line)
041783             0008*   ; 1-7	Reserved for future use
041783             0009*   ; VDU 23, 0, &95, 0, bufferId; flags: Select font
041783             0010*   vdu_font_select:
041783 22 9A 17 04 0011*       ld (@bufferId),hl
041787 32 9C 17 04 0012*       ld (@flags),a
04178B 21 96 17 04 0013*       ld hl,@cmd
04178F 01 07 00 00 0014*       ld bc,@end-@cmd
041793 5B DF       0015*       rst.lil $18
041795 C9          0016*       ret
041796 17 00 95 00 0017*   @cmd: db 23, 0, 0x95, 0
04179A 00 00       0018*   @bufferId: dw 0x0000
04179C 00          0019*   @flags: db 0x00
04179D             0020*   @end:
04179D             0021*   
04179D             0022*   ; create font from buffer
04179D             0023*   ; inputs: hl = bufferId, e = width, d = height, d = ascent, a = flags
04179D             0024*   ; VDU 23, 0, &95, 1, bufferId; width, height, ascent, flags: Create font from buffer
04179D             0025*   vdu_font_create:
04179D 22 C2 17 04 0026*       ld (@bufferId),hl
0417A1 ED 53 C4 17 0027*       ld (@width),de ; also loads height
       04          
0417A6 32 C7 17 04 0028*       ld (@flags),a
0417AA 7A          0029*       ld a,d ; height
0417AB 32 C6 17 04 0030*       ld (@ascent),a ; ascent = height
0417AF             0031*   ; consolidate buffer
0417AF CD 0D 15 04 0032*       call vdu_consolidate_buffer
0417B3             0033*   ; create font
0417B3 21 BE 17 04 0034*       ld hl,@cmd
0417B7 01 0A 00 00 0035*       ld bc,@end-@cmd
0417BB 5B DF       0036*       rst.lil $18
0417BD C9          0037*       ret
0417BE 17 00 95 01 0038*   @cmd: db 23, 0, 0x95, 1
0417C2 00 00       0039*   @bufferId: dw 0x0000
0417C4 00          0040*   @width: db 0x00
0417C5 00          0041*   @height: db 0x00
0417C6 00          0042*   @ascent: db 0x00
0417C7 00          0043*   @flags: db 0x00
0417C8             0044*   @end:
0417C8             0045*   
0417C8             0046*   ; set or adjust font property
0417C8             0047*   ; inputs: hl = bufferId, a = field, de = value
0417C8             0048*   ; VDU 23, 0, &95, 2, bufferId; field, value;: Set or adjust font property
0417C8             0049*   vdu_font_property:
0417C8 22 E4 17 04 0050*       ld (@bufferId),hl
0417CC 32 E6 17 04 0051*       ld (@field),a
0417D0 ED 53 E7 17 0052*       ld (@value),de
       04          
0417D5 21 E0 17 04 0053*       ld hl,@cmd
0417D9 01 09 00 00 0054*       ld bc,@end-@cmd
0417DD 5B DF       0055*       rst.lil $18
0417DF C9          0056*       ret
0417E0 17 00 95 02 0057*   @cmd: db 23, 0, 0x95, 2
0417E4 00 00       0058*   @bufferId: dw 0x0000
0417E6 00          0059*   @field: db 0x00
0417E7 00 00       0060*   @value: dw 0x0000
0417E9 00          0061*   @end: db 0x00 ; padding
0417EA             0062*   
0417EA             0063*   ; VDU 23, 0, &95, 3, bufferId; [<args>]: Reserved
0417EA             0064*   
0417EA             0065*   ; Clear/Delete font
0417EA             0066*   ; inputs: hl = bufferId
0417EA             0067*   ; VDU 23, 0, &95, 4, bufferId;: Clear/Delete font
0417EA             0068*   vdu_font_clear:
0417EA 22 FD 17 04 0069*       ld (@bufferId),hl
0417EE 21 F9 17 04 0070*       ld hl,@cmd
0417F2 01 06 00 00 0071*       ld bc,@end-@cmd
0417F6 5B DF       0072*       rst.lil $18
0417F8 C9          0073*       ret
0417F9 17 00 95 04 0074*   @cmd: db 23, 0, 0x95, 4
0417FD 00 00       0075*   @bufferId: dw 0x0000
0417FF 00          0076*   @end: db 0x00 ; padding
041800             0077*   
041800             0078*   ; Copy system font to buffer
041800             0079*   ; inputs: hl = bufferId
041800             0080*   ; VDU 23, 0, &95, 5, bufferId;: Copy system font to buffer
041800             0081*   vdu_font_copy_system:
041800 22 13 18 04 0082*       ld (@bufferId),hl
041804 21 0F 18 04 0083*       ld hl,@cmd
041808 01 06 00 00 0084*       ld bc,@end-@cmd
04180C 5B DF       0085*       rst.lil $18
04180E C9          0086*       ret
04180F 17 00 95 05 0087*   @cmd: db 23, 0, 0x95, 5
041813 00 00       0088*   @bufferId: dw 0x0000
041815 00          0089*   @end: db 0x00 ; padding
041816             0042        include "vdu_plot.inc"
041816             0001*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
041816             0002*   ; PLOT code 	(Decimal) 	Effect
041816             0003*   ; &00-&07 	0-7 	Solid line, includes both ends
041816             0004*   plot_sl_both: equ 0x00
041816             0005*   
041816             0006*   ; &08-&0F 	8-15 	Solid line, final point omitted
041816             0007*   plot_sl_first: equ 0x08
041816             0008*   
041816             0009*   ; &10-&17 	16-23 	Not supported (Dot-dash line, includes both ends, pattern restarted)
041816             0010*   ; &18-&1F 	24-31 	Not supported (Dot-dash line, first point omitted, pattern restarted)
041816             0011*   
041816             0012*   ; &20-&27 	32-39 	Solid line, first point omitted
041816             0013*   plot_sl_last: equ 0x20
041816             0014*   
041816             0015*   ; &28-&2F 	40-47 	Solid line, both points omitted
041816             0016*   plot_sl_none: equ 0x28
041816             0017*   
041816             0018*   ; &30-&37 	48-55 	Not supported (Dot-dash line, first point omitted, pattern continued)
041816             0019*   ; &38-&3F 	56-63 	Not supported (Dot-dash line, both points omitted, pattern continued)
041816             0020*   
041816             0021*   ; &40-&47 	64-71 	Point plot
041816             0022*   plot_pt: equ 0x40
041816             0023*   
041816             0024*   ; &48-&4F 	72-79 	Line fill left and right to non-background §§
041816             0025*   plot_lf_lr_non_bg: equ 0x48
041816             0026*   
041816             0027*   ; &50-&57 	80-87 	Triangle fill
041816             0028*   plot_tf: equ 0x50
041816             0029*   
041816             0030*   ; &58-&5F 	88-95 	Line fill right to background §§
041816             0031*   plot_lf_r_bg: equ 0x58
041816             0032*   
041816             0033*   ; &60-&67 	96-103 	Rectangle fill
041816             0034*   plot_rf: equ 0x60
041816             0035*   
041816             0036*   ; &68-&6F 	104-111 	Line fill left and right to foreground §§
041816             0037*   plot_lf_lr_fg: equ 0x60
041816             0038*   
041816             0039*   ; &70-&77 	112-119 	Parallelogram fill
041816             0040*   plot_pf: equ 0x70
041816             0041*   
041816             0042*   ; &78-&7F 	120-127 	Line fill right to non-foreground §§
041816             0043*   plot_lf_r_non_fg: equ 0x78
041816             0044*   
041816             0045*   ; &80-&87 	128-135 	Not supported (Flood until non-background)
041816             0046*   ; &88-&8F 	136-143 	Not supported (Flood until foreground)
041816             0047*   
041816             0048*   ; &90-&97 	144-151 	Circle outline
041816             0049*   plot_co: equ 0x90
041816             0050*   
041816             0051*   ; &98-&9F 	152-159 	Circle fill
041816             0052*   plot_cf: equ 0x98
041816             0053*   
041816             0054*   ; &A0-&A7 	160-167 	Not supported (Circular arc)
041816             0055*   ; &A8-&AF 	168-175 	Not supported (Circular segment)
041816             0056*   ; &B0-&B7 	176-183 	Not supported (Circular sector)
041816             0057*   
041816             0058*   ; &B8-&BF 	184-191 	Rectangle copy/move
041816             0059*   plot_rcm: equ 0xB8
041816             0060*   
041816             0061*   ; &C0-&C7 	192-199 	Not supported (Ellipse outline)
041816             0062*   ; &C8-&CF 	200-207 	Not supported (Ellipse fill)
041816             0063*   ; &D0-&D7 	208-215 	Not defined
041816             0064*   ; &D8-&DF 	216-223 	Not defined
041816             0065*   ; &E0-&E7 	224-231 	Not defined
041816             0066*   
041816             0067*   ; &E8-&EF 	232-239 	Bitmap plot §
041816             0068*   plot_bmp: equ 0xE8
041816             0069*   
041816             0070*   ; &F0-&F7 	240-247 	Not defined
041816             0071*   ; &F8-&FF 	248-255 	Not defined
041816             0072*   
041816             0073*   ; § Support added in Agon Console8 VDP 2.1.0 §§ Support added in
041816             0074*   ; Agon Console8 VDP 2.2.0
041816             0075*   
041816             0076*   ; Within each group of eight plot codes, the effects are as follows:
041816             0077*   ; Plot code 	Effect
041816             0078*   ; 0 	Move relative
041816             0079*   mv_rel: equ 0
041816             0080*   
041816             0081*   ; 1 	Plot relative in current foreground colour
041816             0082*   dr_rel_fg: equ 1
041816             0083*   
041816             0084*   ; 2 	Not supported (Plot relative in logical inverse colour)
041816             0085*   ; 3 	Plot relative in current background colour
041816             0086*   dr_rel_bg: equ 3
041816             0087*   
041816             0088*   ; 4 	Move absolute
041816             0089*   mv_abs: equ 4
041816             0090*   
041816             0091*   ; 5 	Plot absolute in current foreground colour
041816             0092*   dr_abs_fg: equ 5
041816             0093*   
041816             0094*   ; 6 	Not supported (Plot absolute in logical inverse colour)
041816             0095*   ; 7 	Plot absolute in current background colour
041816             0096*   dr_abs_bg: equ 7
041816             0097*   
041816             0098*   ; Codes 0-3 use the position data provided as part of the command
041816             0099*   ; as a relative position, adding the position given to the current
041816             0100*   ; graphical cursor position. Codes 4-7 use the position data provided
041816             0101*   ; as part of the command as an absolute position, setting the current
041816             0102*   ; graphical cursor position to the position given.
041816             0103*   
041816             0104*   ; Codes 2 and 6 on Acorn systems plot using a logical inverse of the
041816             0105*   ; current pixel colour. These operations cannot currently be supported
041816             0106*   ; by the graphics system the Agon VDP uses, so these codes are not
041816             0107*   ; supported. Support for these codes may be added in a future version
041816             0108*   ; of the VDP firmware.
041816             0109*   
041816             0110*   ; 16 colour palette constants
041816             0111*   c_black: equ 0
041816             0112*   c_red_dk: equ 1
041816             0113*   c_green_dk: equ 2
041816             0114*   c_yellow_dk: equ 3
041816             0115*   c_blue_dk: equ 4
041816             0116*   c_magenta_dk: equ 5
041816             0117*   c_cyan_dk: equ 6
041816             0118*   c_grey: equ 7
041816             0119*   c_grey_dk: equ 8
041816             0120*   c_red: equ 9
041816             0121*   c_green: equ 10
041816             0122*   c_yellow: equ 11
041816             0123*   c_blue: equ 12
041816             0124*   c_magenta: equ 13
041816             0125*   c_cyan: equ 14
041816             0126*   c_white: equ 15
041816             0127*   
041816             0128*   ; VDU 25, mode, x; y;: PLOT command
041816             0129*   ; inputs: a=mode, bc=x0, de=y0
041816             0130*   vdu_plot:
041816 32 30 18 04 0131*       ld (@mode),a
04181A ED 43 31 18 0132*       ld (@x0),bc
       04          
04181F ED 53 33 18 0133*       ld (@y0),de
       04          
041824 21 2F 18 04 0134*   	ld hl,@cmd
041828 01 06 00 00 0135*   	ld bc,@end-@cmd
04182C 5B DF       0136*   	rst.lil $18
04182E C9          0137*   	ret
04182F 19          0138*   @cmd:   db 25
041830 00          0139*   @mode:  db 0
041831 00 00       0140*   @x0: 	dw 0
041833 00 00       0141*   @y0: 	dw 0
041835 00          0142*   @end:   db 0 ; extra byte to soak up deu
041836             0143*   
041836             0144*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
041836             0145*   ; &E8-&EF 	232-239 	Bitmap plot §
041836             0146*   ; VDU 25, mode, x; y;: PLOT command
041836             0147*   ; inputs: bc=x0, de=y0
041836             0148*   ; prerequisites: vdu_buff_select
041836             0149*   vdu_plot_bmp:
041836 ED 43 4D 18 0150*       ld (@x0),bc
       04          
04183B ED 53 4F 18 0151*       ld (@y0),de
       04          
041840 21 4B 18 04 0152*   	ld hl,@cmd
041844 01 06 00 00 0153*   	ld bc,@end-@cmd
041848 5B DF       0154*   	rst.lil $18
04184A C9          0155*   	ret
04184B 19          0156*   @cmd:   db 25
04184C ED          0157*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
04184D 00 00       0158*   @x0: 	dw 0x0000
04184F 00 00       0159*   @y0: 	dw 0x0000
041851 00          0160*   @end:   db 0x00 ; padding
041852             0161*   
041852             0162*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
041852             0163*   ; &E8-&EF 	232-239 	Bitmap plot §
041852             0164*   ; VDU 25, mode, x; y;: PLOT command
041852             0165*   ; inputs: bc=x0, de=y0
041852             0166*   ; USING 16.8 FIXED POINT COORDINATES
041852             0167*   ; inputs: ub.c is x coordinate, ud.e is y coordinate
041852             0168*   ;   the fractional portiion of the inputs are truncated
041852             0169*   ;   leaving only the 16-bit integer portion
041852             0170*   ; prerequisites: vdu_buff_select
041852             0171*   vdu_plot_bmp168:
041852             0172*   ; populate in the reverse of normal to keep the
041852             0173*   ; inputs from stomping on each other
041852 ED 53 70 18 0174*       ld (@y0-1),de
       04          
041857 ED 43 6E 18 0175*       ld (@x0-1),bc
       04          
04185C 3E ED       0176*       ld a,plot_bmp+dr_abs_fg ; 0xED
04185E 32 6E 18 04 0177*       ld (@mode),a ; restore the mode byte that got stomped on by bcu
041862 21 6D 18 04 0178*   	ld hl,@cmd
041866 01 06 00 00 0179*   	ld bc,@end-@cmd
04186A 5B DF       0180*   	rst.lil $18
04186C C9          0181*   	ret
04186D 19          0182*   @cmd:   db 25
04186E ED          0183*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
04186F 00 00       0184*   @x0: 	dw 0x0000
041871 00 00       0185*   @y0: 	dw 0x0000
041873             0186*   @end:  ; no padding required b/c we shifted de right
041873             0187*   
041873             0188*   ; draw a filled rectangle
041873             0189*   vdu_plot_rf:
041873 ED 43 9A 18 0190*       ld (@x0),bc
       04          
041878 ED 53 9C 18 0191*       ld (@y0),de
       04          
04187D DD 22 A0 18 0192*       ld (@x1),ix
       04          
041882 FD 22 A2 18 0193*       ld (@y1),iy
       04          
041887 3E 19       0194*       ld a,25 ; we have to reload the 2nd plot command
041889 32 9E 18 04 0195*       ld (@cmd1),a ; because the 24-bit y0 load stomped on it
04188D 21 98 18 04 0196*   	ld hl,@cmd0
041891 01 0C 00 00 0197*   	ld bc,@end-@cmd0
041895 5B DF       0198*   	rst.lil $18
041897 C9          0199*       ret
041898 19          0200*   @cmd0:  db 25 ; plot
041899 04          0201*   @arg0:  db plot_sl_both+mv_abs
04189A 00 00       0202*   @x0:    dw 0x0000
04189C 00 00       0203*   @y0:    dw 0x0000
04189E 19          0204*   @cmd1:  db 25 ; plot
04189F 65          0205*   @arg1:  db plot_rf+dr_abs_fg
0418A0 00 00       0206*   @x1:    dw 0x0000
0418A2 00 00       0207*   @y1:    dw 0x0000
0418A4 00          0208*   @end:   db 0x00 ; padding
0418A5             0209*   
0418A5             0210*   ; draw a filled circle
0418A5             0211*   vdu_plot_cf:
0418A5 ED 43 CC 18 0212*       ld (@x0),bc
       04          
0418AA ED 53 CE 18 0213*       ld (@y0),de
       04          
0418AF DD 22 D2 18 0214*       ld (@x1),ix
       04          
0418B4 FD 22 D4 18 0215*       ld (@y1),iy
       04          
0418B9 3E 19       0216*       ld a,25 ; we have to reload the 2nd plot command
0418BB 32 D0 18 04 0217*       ld (@cmd1),a ; because the 24-bit y0 load stomped on it
0418BF 21 CA 18 04 0218*   	ld hl,@cmd0
0418C3 01 0C 00 00 0219*   	ld bc,@end-@cmd0
0418C7 5B DF       0220*   	rst.lil $18
0418C9 C9          0221*       ret
0418CA 19          0222*   @cmd0:  db 25 ; plot
0418CB 04          0223*   @arg0:  db plot_sl_both+mv_abs
0418CC 00 00       0224*   @x0:    dw 0x0000
0418CE 00 00       0225*   @y0:    dw 0x0000
0418D0 19          0226*   @cmd1:  db 25 ; plot
0418D1 9D          0227*   @arg1:  db plot_cf+dr_abs_fg
0418D2 00 00       0228*   @x1:    dw 0x0000
0418D4 00 00       0229*   @y1:    dw 0x0000
0418D6 00          0230*   @end:   db 0x00 ; padding
0418D7             0043        include "vdu_sprites.inc"
0418D7             0001*   ; ; https://github.com/AgonConsole8/agon-docs/blob/main/VDP---Bitmaps-API.md
0418D7             0002*   ; the VDP can support up to 256 sprites. They must be defined
0418D7             0003*   ; contiguously, and so the first sprite is sprite 0.
0418D7             0004*   ; (In contrast, bitmaps can have any ID from 0 to 65534.)
0418D7             0005*   ; Once a selection of sprites have been defined, you can activate
0418D7             0006*   ; them using the VDU 23, 27, 7, n command, where n is the number
0418D7             0007*   ; of sprites to activate. This will activate the first n sprites,
0418D7             0008*   ; starting with sprite 0. All sprites from 0 to n-1 must be defined.
0418D7             0009*   
0418D7             0010*   ; A single sprite can have multiple "frames", referring to
0418D7             0011*   ; different bitmaps.
0418D7             0012*   ; (These bitmaps do not need to be the same size.)
0418D7             0013*   ; This allows a sprite to include an animation sequence,
0418D7             0014*   ; which can be stepped through one frame at a time, or picked
0418D7             0015*   ; in any order.
0418D7             0016*   
0418D7             0017*   ; Any format of bitmap can be used as a sprite frame. It should
0418D7             0018*   ; be noted however that "native" format bitmaps are not
0418D7             0019*   ; recommended for use as sprite frames, as they cannot get
0418D7             0020*   ; erased from the screen. (As noted above, the "native" bitmap
0418D7             0021*   ; format is not really intended for general use.) This is part
0418D7             0022*   ; of why from Agon Console8 VDP 2.6.0 bitmaps captured from the
0418D7             0023*   ; screen are now stored in RGBA2222 format.
0418D7             0024*   
0418D7             0025*   ; An "active" sprite can be hidden, so it will stop being drawn,
0418D7             0026*   ; and then later shown again.
0418D7             0027*   
0418D7             0028*   ; Moving sprites around the screen is done by changing the
0418D7             0029*   ; position of the sprite. This can be done either by setting
0418D7             0030*   ; the absolute position of the sprite, or by moving the sprite
0418D7             0031*   ; by a given number of pixels. (Sprites are positioned using
0418D7             0032*   ; pixel coordinates, and not by the logical OS coordinate system.)
0418D7             0033*   ; In the current sprite system, sprites will not update their
0418D7             0034*   ; position on-screen until either another drawing operation is
0418D7             0035*   ; performed or an explicit VDU 23, 27, 15 command is performed.
0418D7             0036*   
0418D7             0037*   ; VDU 23, 27, 4, n: Select sprite n
0418D7             0038*   ; inputs: a is the 8-bit sprite id
0418D7             0039*   vdu_sprite_select:
0418D7 32 E9 18 04 0040*       ld (@sprite),a
0418DB 21 E6 18 04 0041*       ld hl,@cmd
0418DF 01 04 00 00 0042*       ld bc,@end-@cmd
0418E3 5B DF       0043*       rst.lil $18
0418E5 C9          0044*       ret
0418E6 17 1B 04    0045*   @cmd:    db 23,27,4
0418E9 00          0046*   @sprite: db 0x00
0418EA             0047*   @end:
0418EA             0048*   
0418EA             0049*   ; VDU 23, 27, 5: Clear frames in current sprite
0418EA             0050*   ; inputs: none
0418EA             0051*   ; prerequisites: vdu_sprite_select
0418EA             0052*   vdu_sprite_clear_frames:
0418EA 21 F5 18 04 0053*       ld hl,@cmd
0418EE 01 03 00 00 0054*       ld bc,@end-@cmd
0418F2 5B DF       0055*       rst.lil $18
0418F4 C9          0056*       ret
0418F5 17 1B 05    0057*   @cmd: db 23,27,5
0418F8             0058*   @end:
0418F8             0059*   
0418F8             0060*   ; VDU 23, 27, 6, n: Add bitmap n as a frame to current sprite (where bitmap's buffer ID is 64000+n)
0418F8             0061*   ; inputs: a is the 8-bit bitmap number
0418F8             0062*   ; prerequisites: vdu_sprite_select
0418F8             0063*   vdu_sprite_add_bmp:
0418F8 32 0A 19 04 0064*       ld (@bmp),a
0418FC 21 07 19 04 0065*       ld hl,@cmd
041900 01 04 00 00 0066*       ld bc,@end-@cmd
041904 5B DF       0067*       rst.lil $18
041906 C9          0068*       ret
041907 17 1B 06    0069*   @cmd: db 23,27,6
04190A 00          0070*   @bmp: db 0x00
04190B             0071*   @end:
04190B             0072*   
04190B             0073*   ; VDU 23, 27, 7, n: Activate n sprites
04190B             0074*   ; inputs: a is the number of sprites to activate
04190B             0075*   ; prerequisites: each sprite activated must have at least one frame attached to it
04190B             0076*   vdu_sprite_activate:
04190B 32 1D 19 04 0077*       ld (@num),a
04190F 21 1A 19 04 0078*       ld hl,@cmd
041913 01 04 00 00 0079*       ld bc,@end-@cmd
041917 5B DF       0080*       rst.lil $18
041919 C9          0081*       ret
04191A 17 1B 07    0082*   @cmd: db 23,27,7
04191D 00          0083*   @num: db 0x00
04191E             0084*   @end:
04191E             0085*   
04191E             0086*   ; VDU 23, 27, 8: Select next frame of current sprite
04191E             0087*   ; inputs: none
04191E             0088*   ; prerequisites: vdu_sprite_select
04191E             0089*   vdu_sprite_next_frame:
04191E 21 29 19 04 0090*       ld hl,@cmd
041922 01 03 00 00 0091*       ld bc,@end-@cmd
041926 5B DF       0092*       rst.lil $18
041928 C9          0093*       ret
041929 17 1B 08    0094*   @cmd: db 23,27,8
04192C             0095*   @end:
04192C             0096*   
04192C             0097*   ; VDU 23, 27, 9: Select previous frame of current sprite
04192C             0098*   ; inputs: none
04192C             0099*   ; prerequisites: vdu_sprite_select
04192C             0100*   vdu_sprite_prev_frame:
04192C 21 37 19 04 0101*       ld hl,@cmd
041930 01 03 00 00 0102*       ld bc,@end-@cmd
041934 5B DF       0103*       rst.lil $18
041936 C9          0104*       ret
041937 17 1B 09    0105*   @cmd: db 23,27,9
04193A             0106*   @end:
04193A             0107*   
04193A             0108*   ; VDU 23, 27, 10, n: Select the nth frame of current sprite
04193A             0109*   ; inputs: a is frame number to select
04193A             0110*   ; prerequisites: vdu_sprite_select
04193A             0111*   vdu_sprite_select_frame:
04193A 32 4C 19 04 0112*       ld (@frame),a
04193E 21 49 19 04 0113*       ld hl,@cmd
041942 01 04 00 00 0114*       ld bc,@end-@cmd
041946 5B DF       0115*       rst.lil $18
041948 C9          0116*       ret
041949 17 1B 0A    0117*   @cmd:    db 23,27,10
04194C 00          0118*   @frame:  db 0x00
04194D             0119*   @end:
04194D             0120*   
04194D             0121*   ; VDU 23, 27, 11: Show current sprite
04194D             0122*   ; inputs: none
04194D             0123*   ; prerequisites: vdu_sprite_select
04194D             0124*   vdu_sprite_show:
04194D 21 58 19 04 0125*       ld hl,@cmd
041951 01 03 00 00 0126*       ld bc,@end-@cmd
041955 5B DF       0127*       rst.lil $18
041957 C9          0128*       ret
041958 17 1B 0B    0129*   @cmd: db 23,27,11
04195B             0130*   @end:
04195B             0131*   
04195B             0132*   ; VDU 23, 27, 12: Hide current sprite
04195B             0133*   ; inputs: none
04195B             0134*   ; prerequisites: vdu_sprite_select
04195B             0135*   vdu_sprite_hide:
04195B 21 66 19 04 0136*       ld hl,@cmd
04195F 01 03 00 00 0137*       ld bc,@end-@cmd
041963 5B DF       0138*       rst.lil $18
041965 C9          0139*       ret
041966 17 1B 0C    0140*   @cmd: db 23,27,12
041969             0141*   @end:
041969             0142*   
041969             0143*   ; VDU 23, 27, 13, x; y;: Move current sprite to pixel position x, y
041969             0144*   ; inputs: bc is x coordinate, de is y coordinate
041969             0145*   ; prerequisites: vdu_sprite_select
041969             0146*   vdu_sprite_move_abs:
041969 ED 43 81 19 0147*       ld (@xpos),bc
       04          
04196E ED 53 83 19 0148*       ld (@ypos),de
       04          
041973 21 7E 19 04 0149*       ld hl,@cmd
041977 01 07 00 00 0150*       ld bc,@end-@cmd
04197B 5B DF       0151*       rst.lil $18
04197D C9          0152*       ret
04197E 17 1B 0D    0153*   @cmd:  db 23,27,13
041981 00 00       0154*   @xpos: dw 0x0000
041983 00 00       0155*   @ypos: dw 0x0000
041985 00          0156*   @end:  db 0x00 ; padding
041986             0157*   
041986             0158*   ; VDU 23, 27, 14, x; y;: Move current sprite by x, y pixels
041986             0159*   ; inputs: bc is x coordinate, de is y coordinate
041986             0160*   ; prerequisites: vdu_sprite_select
041986             0161*   vdu_sprite_move_rel:
041986 ED 43 9E 19 0162*       ld (@dx),bc
       04          
04198B ED 53 A0 19 0163*       ld (@dy),de
       04          
041990 21 9B 19 04 0164*       ld hl,@cmd
041994 01 07 00 00 0165*       ld bc,@end-@cmd
041998 5B DF       0166*       rst.lil $18
04199A C9          0167*       ret
04199B 17 1B 0E    0168*   @cmd: db 23,27,14
04199E 00 00       0169*   @dx:  dw 0x0000
0419A0 00 00       0170*   @dy:  dw 0x0000
0419A2 00          0171*   @end: db 0x00 ; padding
0419A3             0172*   
0419A3             0173*   ; VDU 23, 27, 13, x; y;: Move current sprite to pixel position x, y
0419A3             0174*   ; USING 16.8 FIXED POINT COORDINATES
0419A3             0175*   ; inputs: ub.c is x coordinate, ud.e is y coordinate
0419A3             0176*   ;   the fractional portiion of the inputs are truncated
0419A3             0177*   ;   leaving only the 16-bit integer portion
0419A3             0178*   ; prerequisites: vdu_sprite_select
0419A3             0179*   vdu_sprite_move_abs168:
0419A3             0180*   ; offset inputs by the gfx origin
0419A3             0181*   ; y coordinate
0419A3 21 00 30 00 0182*       ld hl,origin_top*256
0419A7 19          0183*       add hl,de
0419A8 22 CA 19 04 0184*       ld (@ypos-1),hl
0419AC             0185*   ; x coordinate
0419AC 21 00 80 00 0186*       ld hl,origin_left*256
0419B0 09          0187*       add hl,bc
0419B1 22 C8 19 04 0188*       ld (@xpos-1),hl
0419B5             0189*   ; prepare vdu command
0419B5 3E 0D       0190*       ld a,13       ; restore the final byte of the command
0419B7 32 C8 19 04 0191*       ld (@cmd+2),a ; string that got stomped on by bcu
0419BB 21 C6 19 04 0192*       ld hl,@cmd
0419BF 01 07 00 00 0193*       ld bc,@end-@cmd
0419C3 5B DF       0194*       rst.lil $18
0419C5 C9          0195*       ret
0419C6 17 1B 0D    0196*   @cmd:  db 23,27,13
0419C9 00 00       0197*   @xpos: dw 0x0000
0419CB 00 00       0198*   @ypos: dw 0x0000
0419CD             0199*   @end:  ; no padding required b/c we shifted de right
0419CD             0200*   
0419CD             0201*   ; VDU 23, 27, 14, x; y;: Move current sprite by x, y pixels
0419CD             0202*   ; USING 16.8 FIXED POINT COORDINATES
0419CD             0203*   ; inputs: ub.c is dx, ud.e is dy
0419CD             0204*   ;   the fractional portiion of the inputs are truncated
0419CD             0205*   ;   leaving only the 16-bit integer portion
0419CD             0206*   ; prerequisites: vdu_sprite_select
0419CD             0207*   vdu_sprite_move_rel168:
0419CD             0208*   ; populate in the reverse of normal to keep the
0419CD             0209*   ; inputs from stomping on each other
0419CD ED 53 EC 19 0210*       ld (@dy-1),de
       04          
0419D2 ED 43 EA 19 0211*       ld (@dx-1),bc
       04          
0419D7 3E 0E       0212*       ld a,14       ; restore the final byte of the command
0419D9 32 EA 19 04 0213*       ld (@cmd+2),a ; string that got stomped on by bcu
0419DD 21 E8 19 04 0214*       ld hl,@cmd
0419E1 01 07 00 00 0215*       ld bc,@end-@cmd
0419E5 5B DF       0216*       rst.lil $18
0419E7 C9          0217*       ret
0419E8 17 1B 0E    0218*   @cmd:  db 23,27,14
0419EB 00 00       0219*   @dx: dw 0x0000
0419ED 00 00       0220*   @dy: dw 0x0000
0419EF             0221*   @end:  ; no padding required b/c we shifted de right
0419EF             0222*   
0419EF             0223*   ; VDU 23, 27, 15: Update the sprites in the GPU
0419EF             0224*   ; inputs: none
0419EF             0225*   vdu_sprite_update:
0419EF 21 FA 19 04 0226*       ld hl,@cmd
0419F3 01 03 00 00 0227*       ld bc,@end-@cmd
0419F7 5B DF       0228*       rst.lil $18
0419F9 C9          0229*       ret
0419FA 17 1B 0F    0230*   @cmd: db 23,27,15
0419FD             0231*   @end:
0419FD             0232*   
0419FD             0233*   ; VDU 23, 27, 16: Reset bitmaps and sprites and clear all data
0419FD             0234*   ; inputs: none
0419FD             0235*   vdu_sprite_bmp_reset:
0419FD 21 08 1A 04 0236*       ld hl,@cmd
041A01 01 03 00 00 0237*       ld bc,@end-@cmd
041A05 5B DF       0238*       rst.lil $18
041A07 C9          0239*       ret
041A08 17 1B 10    0240*   @cmd: db 23,27,16
041A0B             0241*   @end:
041A0B             0242*   
041A0B             0243*   ; VDU 23, 27, 17: Reset sprites (only) and clear all data
041A0B             0244*   ; inputs: none
041A0B             0245*   vdu_sprite_reset:
041A0B 21 16 1A 04 0246*       ld hl,@cmd
041A0F 01 03 00 00 0247*       ld bc,@end-@cmd
041A13 5B DF       0248*       rst.lil $18
041A15 C9          0249*       ret
041A16 17 1B 11    0250*   @cmd: db 23,27,17
041A19             0251*   @end:
041A19             0252*   
041A19             0253*   ; VDU 23, 27, 18, n: Set the current sprite GCOL paint mode to n **
041A19             0254*   ; inputs: a is the GCOL paint mode
041A19             0255*   ; prerequisites: vdu_sprite_select
041A19             0256*   vdu_sprite_set_gcol:
041A19 32 2B 1A 04 0257*       ld (@mode),a
041A1D 21 28 1A 04 0258*       ld hl,@cmd
041A21 01 04 00 00 0259*       ld bc,@end-@cmd
041A25 5B DF       0260*       rst.lil $18
041A27 C9          0261*       ret
041A28 17 1B 12    0262*   @cmd:  db 23,27,18
041A2B 00          0263*   @mode: db 0x00
041A2C             0264*   @end:
041A2C             0265*   
041A2C             0266*   ; VDU 23, 27, &26, n;: Add bitmap n as a frame to current sprite using a 16-bit buffer ID
041A2C             0267*   ; inputs: hl=bufferId
041A2C             0268*   ; prerequisites: vdu_sprite_select
041A2C             0269*   vdu_sprite_add_buff:
041A2C 22 3E 1A 04 0270*       ld (@bufferId),hl
041A30 21 3B 1A 04 0271*       ld hl,@cmd
041A34 01 05 00 00 0272*       ld bc,@end-@cmd
041A38 5B DF       0273*       rst.lil $18
041A3A C9          0274*       ret
041A3B 17 1B 26    0275*   @cmd:      db 23,27,0x26
041A3E 00 00       0276*   @bufferId: dw 0x0000
041A40 00          0277*   @end:      db 0x00 ; padding
