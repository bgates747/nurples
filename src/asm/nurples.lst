0468AB FE 01       0318*       cp enemy_air
0468AD C2 07 69 04 0319*       jp nz,@invalid
0468B1 11 B8 4B 04 0320*       ld de,en_nav_seek_zag
0468B5 CD 0B 69 04 0321*       call @matches
