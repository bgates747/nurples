0464E4 BE          0048*       cp (hl)
0464E5 C8          0049*       ret z ; no change to update
0464E6 77          0050*       ld (hl),a
0464E7 DD 21 8F 64 0051*       ld ix,bar_fuel
       04          
0464EC DD 77 00    0052*       ld (ix+bar_val),a ; TODO: this is redundant
