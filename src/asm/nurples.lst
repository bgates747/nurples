044ED5 CD C0 7B 04 0186*       call printHexA
044ED9 0E 26       0187*       ld c,38 ; x
044EDB 06 11       0188*       ld b,17 ; y
044EDD CD 9E 13 04 0189*       call vdu_move_cursor
044EE1 3E 80       0190*       ld a,%10000000 ; bit 7 changes once per second
044EE3 CD 15 13 04 0191*       call multiPurposeDelay
044EE7 C1          0192*       pop bc
044EE8 10 E8       0193*       djnz @waitLoop
044EEA C9          0194*       ret
