04636A             0169*   ; update a vertical bar display
04636A             0170*   ; inputs: ix points to bar structure
04636A             0171*   ;         bar_val set by caller
04636A             0172*   ; prerequisite: bar_init called before first use
04636A             0173*   bar_update_v:
04636A             0174*   ; set gfx viewport
04636A DD E5       0175*       push ix ; preserve pointer
