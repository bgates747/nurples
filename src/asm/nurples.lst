0463BB 19          0207*       add hl,de
0463BC 7D          0208*       ld a,l
0463BD E6 FC       0209*       and %11111100 ; round to nearest 4 pixels
0463BF 6F          0210*       ld l,a
0463C0 EB          0211*       ex de,hl
