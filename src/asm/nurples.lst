0466DD             0069        include "sprites.inc"
0466DD             0001*   ; sprite_type
0466DD             0002*   enemy_dead: equ 0
0466DD             0003*   enemy_air: equ 1
0466DD             0004*   enemy_ground: equ 2
0466DD             0005*   enemy_projectile: equ 3
0466DD             0006*   explosion: equ 4
0466DD             0007*   player: equ 5
0466DD             0008*   player_air: equ 6
0466DD             0009*   player_ground: equ 7
0466DD             0010*   
0466DD             0011*   ; ###### SPRITE TABLE FIELD INDICES ######
0466DD             0012*   table_record_size:         equ  64; bytes per sprite record
0466DD             0013*   sprite_id:                 equ   0; 1 bytes ;unique spriteId, zero-based
0466DD             0014*   ; sprite state variables
0466DD             0015*   sprite_state_variables:    equ   1; beginning of sprite state variables
0466DD             0016*   sprite_x:                  equ   1; 3 bytes ;16.8 fractional x position in pixels
0466DD             0017*   sprite_y:                  equ   4; 3 bytes ;16.8 fractional y position in pixels
0466DD             0018*   sprite_xvel:               equ   7; 3 bytes ;x-component velocity, 16.8 fixed, pixels
0466DD             0019*   sprite_yvel:               equ  10; 3 bytes ;y-component velocity, 16.8 fixed, pixels
0466DD             0020*   sprite_vel:                equ  13; 3 bytes ;velocity px/frame (16.8 fixed)
0466DD             0021*   sprite_heading:            equ  16; 3 bytes ;sprite movement direction deg256 16.8 fixed
0466DD             0022*   sprite_orientation:        equ  19; 3 bytes ;orientation bits
0466DD             0023*   ; sprite definition variables
0466DD             0024*   sprite_definitions:        equ  22; beginnning of sprite definition variables
0466DD             0025*   sprite_type:               equ  22; 1 bytes ;type of sprite as defined in enemies.inc
0466DD             0026*   sprite_base_bufferId:      equ  23; 3 bytes ;bitmap bufferId
0466DD             0027*   sprite_move_program:       equ  26; 3 bytes ;address of sprite's behavior subroutine
0466DD             0028*   sprite_collisions:         equ  29; 1 bytes ;see collisions.inc constants for bit definitions
0466DD             0029*   sprite_dim_x:              equ  30; 1 bytes ;sprite width in pixels
0466DD             0030*   sprite_dim_y:              equ  31; 1 bytes ;sprite height in pixels
0466DD             0031*   sprite_num_orientations:   equ  32; 1 bytes ;number of orientations for this sprite
0466DD             0032*   sprite_num_animations:     equ  33; 1 bytes ;number of animations for this sprite
0466DD             0033*   sprite_animation:          equ  34; 1 bytes ;current animation index, zero-based
0466DD             0034*   sprite_animation_timer:    equ  35; 1 bytes ;when hits zero, draw next animation
0466DD             0035*   sprite_move_timer:         equ  36; 1 bytes ;when zero, go to next move program, or step
0466DD             0036*   sprite_move_step:          equ  37; 1 bytes ;stage in a move program sequence, varies
0466DD             0037*   sprite_points:             equ  38; 1 bytes ;points awarded for killing this sprite type
0466DD             0038*   sprite_shield_damage:      equ  39; 1 bytes ;shield points deducted for collision
0466DD             0039*   sprite_frame:              equ  40; 1 bytes ;current animation frame
0466DD             0040*   sprite_definitions_size:   equ  sprite_frame-sprite_definitions+1
0466DD             0041*   
0466DD             0042*   ; ###### SPRITE TABLE VARIABLES ######
0466DD             0043*   ; pointer to top address of current record, initialized to table_base
0466DD F3 86 04    0044*   table_pointer: dl table_base
0466E0             0045*   
0466E0             0046*   ; flag indicating collision with screen edge
0466E0 00          0047*   sprite_screen_edge: db #00
0466E1             0048*   sprite_fault_bad_record: equ 0
0466E1             0049*   sprite_fault_bad_move_program: equ 1
0466E1 00          0050*   sprite_fault_flags: db 0 ; latched fail-closed diagnostics
0466E2             0051*   
0466E2             0052*   ; ######### COLLISION SPRITE PARAMETERS ##########
0466E2             0053*   ; integer coordinates are all that are needed for collision calculations
0466E2 00          0054*   collision_x: db 0x00
0466E3 00          0055*   collision_y: db 0x00
0466E4 00          0056*   collision_dim_x: db 0x00
0466E5 00          0057*   collision_dim_y: db 0x00
0466E6             0058*   
0466E6             0059*   ; scratch variables
0466E6 00          0060*   x: db 0x00 ; 8-bit signed integer
0466E7 00          0061*   y: db 0x00 ; 8-bit signed integer
0466E8 00 00 00    0062*   x0: dl 0x000000 ; 16.8 signed fixed place
0466EB 00 00 00    0063*   y0: dl 0x000000 ; 16.8 signed fixed place
0466EE 00 00 00    0064*   incx1: dl 0x000000 ; 16.8 signed fixed place
0466F1 00 00 00    0065*   incy1: dl 0x000000 ; 16.8 signed fixed place
0466F4 00 00 00    0066*   incx2: dl 0x000000 ; 16.8 signed fixed place
0466F7 00 00 00    0067*   incy2: dl 0x000000 ; 16.8 signed fixed place
0466FA             0068*   
0466FA             0069*   ; sprite_heading: dl 0x000000 ; signed fixed 16.8
0466FA 00 00 00    0070*   radius: dl 0x000000 ; signed fixed 16.8 (but should always be positive)
0466FD 00 00 00    0071*   sin_sprite_heading: dl 0x000000 ; signed fixed 16.8
046700 00 00 00    0072*   cos_sprite_heading: dl 0x000000 ; signed fixed 16.8
