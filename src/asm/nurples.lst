0469B3             0383*       CALL_HL ; run the behavior subroutine
                       M1 Args: none
0469B3 01 B9 69 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
0469B7 C5          0002*M1     push bc ; which constitutes the return address
0469B8 E9          0003*M1     jp (hl) ; Jump to the address in HL
