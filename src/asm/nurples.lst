047DD2             0062        include "player_input.inc"
047DD2             0001*   ; UART ports for reading joystick input
047DD2             0002*   ; bit tests: 0 means actuated, 1 means not actuated
047DD2             0003*   portC: 	EQU 	$9E ; reads dpad input
047DD2             0004*   joy1_u: equ 1
047DD2             0005*   joy1_d: equ 3
047DD2             0006*   joy1_l: equ 5
047DD2             0007*   joy1_r: equ 7
047DD2             0008*   portD: 	EQU 	$A2 ; reads buttons
047DD2             0009*   btn1_a: equ 5
047DD2             0010*   
047DD2             0011*   ; process player keyboard input, set player bitmap
047DD2             0012*   ; velocities and draw player bitmap at updated coordinates
047DD2             0013*   ; Inputs: player_x/y set at desired position
047DD2             0014*   ; Returns: player bitmap drawn at updated position
047DD2             0015*   ; Destroys: probably everything except maybe iy
047DD2             0016*   ; NOTE: in mode 9 we draw the ship as a sprite, not a bitmap
047DD2             0017*   ; TODO: requires sprite implementation
047DD2             0018*   player_input:
047DD2             0019*   ; point to player sprite record
047DD2 FD 21 60 9C 0020*       ld iy,player_begin
       04          
047DD7 FD 22 98 80 0021*       ld (table_pointer),iy
       04          
047DDC             0022*   ; reset player component velocities to zero as the default
047DDC 21 00 00 00 0023*       ld hl,0
047DE0 FD 2F 07    0024*       ld (iy+sprite_xvel),hl
047DE3 FD 2F 0A    0025*       ld (iy+sprite_yvel),hl
047DE6             0026*   ; make ship the active sprite
047DE6 FD 7E 00    0027*       ld a,(iy+sprite_id)
047DE9 CD D7 18 04 0028*       call vdu_sprite_select
047DED             0029*   ; check for keypresses and branch accordingly
047DED             0030*       MOSCALL    mos_getkbmap ;ix = pointer to MOS virtual keys table
                       M1 Args: function=mos_getkbmap 
047DED 3E 1E       0001*M1 			LD	A, function
047DEF 5B CF       0002*M1 			RST.LIL	08h
047DF1             0031*   ; do player directional input
047DF1 AF          0032*       xor a ; clear flags
047DF2 DB 9E       0033*       in a,(portC) ; read dpad input
047DF4 57          0034*       ld d,a ; save dpad input
047DF5 3E 01       0035*       ld a,1 ; set ship's default animation to center
047DF7             0036*   ; 26 Left: move player left
047DF7 DD CB 03 4E 0037*       bit 1,(ix+3)
047DFB C2 09 7E 04 0038*       jp nz,@F
047DFF             0039*   ; test dpad left
047DFF CB 6A       0040*       bit joy1_l,d
047E01 CA 09 7E 04 0041*       jp z,@F
047E05 C3 15 7E 04 0042*       jp @right
047E09             0043*   @@:
047E09 FD 27 07    0044*       ld hl,(iy+sprite_xvel)
047E0C 01 00 FD FF 0045*       ld bc,-player_speed
047E10 09          0046*       add hl,bc
047E11 FD 2F 07    0047*       ld (iy+sprite_xvel),hl
047E14 3D          0048*       dec a ; set ship's animation to left
047E15             0049*   @right:
047E15             0050*   ; 122 Right: move player right
047E15 DD CB 0F 4E 0051*       bit 1,(ix+15)
047E19 C2 27 7E 04 0052*       jp nz,@F
047E1D             0053*   ; test dpad right
047E1D CB 7A       0054*       bit joy1_r,d
047E1F CA 27 7E 04 0055*       jp z,@F
047E23 C3 33 7E 04 0056*       jp @up
047E27             0057*   @@:
047E27 FD 27 07    0058*       ld hl,(iy+sprite_xvel)
047E2A 01 00 03 00 0059*       ld bc,player_speed
047E2E 09          0060*       add hl,bc
047E2F FD 2F 07    0061*       ld (iy+sprite_xvel),hl
047E32 3C          0062*       inc a ; set ship's animation to right
047E33             0063*   @up:
047E33             0064*   ; 58 Up: move player up
047E33 DD CB 07 4E 0065*       bit 1,(ix+7)
047E37 C2 45 7E 04 0066*       jp nz,@F
047E3B             0067*   ; test dpad up
047E3B CB 4A       0068*       bit joy1_u,d
047E3D CA 45 7E 04 0069*       jp z,@F
047E41 C3 50 7E 04 0070*       jp @dn
047E45             0071*   @@:
047E45 FD 27 0A    0072*       ld hl,(iy+sprite_yvel)
047E48 01 00 FD FF 0073*       ld bc,-player_speed
047E4C 09          0074*       add hl,bc
047E4D FD 2F 0A    0075*       ld (iy+sprite_yvel),hl
047E50             0076*   @dn:
047E50             0077*   ; 42 Down: move player down
047E50 DD CB 05 4E 0078*       bit 1,(ix+5)
047E54 C2 62 7E 04 0079*       jp nz,@F
047E58             0080*   ; test dpad down
047E58 CB 5A       0081*       bit joy1_d,d
047E5A CA 62 7E 04 0082*       jp z,@F
047E5E C3 6D 7E 04 0083*       jp @frame
047E62             0084*   @@:
047E62 FD 27 0A    0085*       ld hl,(iy+sprite_yvel)
047E65 01 00 03 00 0086*       ld bc,player_speed
047E69 09          0087*       add hl,bc
047E6A FD 2F 0A    0088*       ld (iy+sprite_yvel),hl
047E6D             0089*   @frame:
047E6D             0090*   ; a should land here loaded with the correct frame
047E6D CD 3A 19 04 0091*       call vdu_sprite_select_frame
047E71             0092*   ; draw player at updated position
047E71 FD 21 60 9C 0093*       ld iy,player_begin
       04          
047E76 FD 22 98 80 0094*       ld (table_pointer),iy
       04          
047E7B CD 5D 82 04 0095*       call move_sprite
047E7F FD 07 01    0096*       ld bc,(iy+sprite_x)
047E82 FD 17 04    0097*       ld de,(iy+sprite_y)
047E85 CD A3 19 04 0098*       call vdu_sprite_move_abs168
047E89             0099*   
047E89             0100*   ; process player laser fire
047E89             0101*   ; do player fire button input
047E89             0102*   ; read joystick fire button
047E89 AF          0103*       xor a ; clear flags
047E8A DB A2       0104*       in a,(portD) ; read joypad fire button input
047E8C CB 6F       0105*       bit btn1_a,a
047E8E CA 2F 7F 04 0106*       jp z,player_spawn_laser
047E92             0107*   ; 99 Space: fire main weapon
047E92 DD CB 0C 56 0108*       bit 2,(ix+12)
047E96 C2 2F 7F 04 0109*       jp nz,player_spawn_laser
047E9A             0110*   ; no fire button pressed so go home
047E9A C9          0111*       ret
047E9B             0112*   ; end player_input
