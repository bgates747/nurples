048A5E             0294*   ; spawn a new active tile at the prescribed location
048A5E             0295*   ; inputs: hl = pointer to new tile default settings, tiles_x_plot, tiles_y_plot = x,y position
048A5E             0296*   ; returns: if new tile available, a = tile id, ix pointing to new tile vars, carry set
048A5E             0297*   ;      otherwise, a = 0, carry flag reset, ix invalid and must not be dereferenced
048A5E             0298*   ; destroys: a,hl,bc,de,ix
048A5E             0299*   ; affects: on success, bumps num_active_tiles by one, adds a tile pointer to the top of the tile stack
048A5E             0300*   spawn_active_tile:
048A5E E5          0301*       push hl ; back up pointer to new tile defaults
048A5F CD 08 89 04 0302*       call tile_table_get_next_id ; if available: a = new tile id, ix = pointer to new tile vars
048A63 E1          0303*       pop hl ; restore pointer to new tile defaults
048A64 D0          0304*       ret nc ; no carry means no free tile slots, so we go home
048A65             0305*   ; copy default settings to new tile
