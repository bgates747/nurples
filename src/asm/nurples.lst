048E21 10          0006*       db 16                   ; dim_x
048E22 10          0007*       db 16                   ; dim_y
048E23 01          0008*       db 1                    ; num_orientations
048E24 04          0009*       db 4                    ; num_animations
048E25 05          0010*       db 5	                ; animation
048E26 08          0011*       db 8                    ; animation_timer
048E27 00          0012*       db 0                    ; move_timer
048E28 00          0013*       db 0                    ; move_step
048E29 00          0014*       db 0                    ; points
048E2A 00          0015*       db 0                    ; shield_damage
