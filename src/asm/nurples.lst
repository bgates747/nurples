04770F             0020*   tile_activation_routines:
04770F 42 77 04    0021*       dl activate_null_tile ; dummy spacer since tiled is 1-based
047712 0A 7B 04    0022*       dl activate_pad_small
047715 42 77 04    0023*       dl activate_null_tile
047718 42 77 04    0024*       dl activate_null_tile
04771B 42 77 04    0025*       dl activate_null_tile
04771E 7F 7B 04    0026*       dl activate_turret_fireball
047721 42 77 04    0027*       dl activate_null_tile
047724 42 77 04    0028*       dl activate_null_tile
047727 42 77 04    0029*       dl activate_null_tile
04772A 10 79 04    0030*       dl activate_electrode
04772D B1 7A 04    0031*       dl activate_lightning
047730 10 79 04    0032*       dl activate_electrode
047733 42 77 04    0033*       dl activate_null_tile
047736 42 77 04    0034*       dl activate_null_tile
047739 42 77 04    0035*       dl activate_null_tile
04773C 42 77 04    0036*       dl activate_null_tile ; tile 15
04773F BB 78 04    0037*       dl activate_crater ; tile 16
