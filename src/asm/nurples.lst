0482AA 3A 23 A2 04 0171*   	ld a,(player_begin+sprite_id)
0482AE CD 44 19 04 0172*   	call vdu_sprite_select
0482B2 CD 57 19 04 0173*   	call vdu_sprite_clear_frames
0482B6 21 73 01 00 0174*   	ld hl,BUF_SHIP_0L
0482BA 01 03 00 00 0175*   	ld bc,3 ; three bitmaps for player ship
0482BE             0176*   @sprite_player_loop:
0482BE C5          0177*   	push bc
0482BF E5          0178*   	push hl
0482C0 CD 99 1A 04 0179*   	call vdu_sprite_add_buff
0482C4 E1          0180*   	pop hl
0482C5 23          0181*   	inc hl
0482C6 C1          0182*   	pop bc
0482C7 10 F5       0183*   	djnz @sprite_player_loop
