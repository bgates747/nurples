044B20             0052        include "enemy_seeker.inc"
044B20 00          0001*   seekers_count: db 0
044B21             0002*   seekers_max: equ 3
044B21             0003*   speed_seeker: equ 0x000280 ; 2.5 pixels per frame
044B21             0004*   
044B21             0005*   seeker_defaults:
044B21 01          0006*       db enemy_air            ; type
044B22 53 01 00    0007*       dl BUF_SEEKER_000       ; base_bufferId
044B25 D8 4B 04    0008*       dl en_nav_seek_zag    ; move_program
044B28 40          0009*       db %01000000            ; collisions bit 6 signals sprite alive
044B29 10          0010*       db 16                   ; dim_x
044B2A 10          0011*       db 16                   ; dim_y
044B2B 20          0012*       db 32                   ; num_orientations
044B2C 01          0013*       db 1                    ; num_animations
044B2D 00          0014*       db 0                    ; animation
044B2E 00          0015*       db 0                    ; animation_timer
044B2F 01          0016*       db 1                    ; move_timer
044B30 00          0017*       db 0                    ; move_step
044B31 0A          0018*       db 10                   ; points
044B32 FC          0019*       db -4                   ; shield_damage
044B33 00          0020*       db 0                    ; frame
044B34             0021*   
044B34             0022*   enemy_spawn_seeker:
044B34 21 21 4B 04 0023*       ld hl,seeker_defaults
044B38 DD 21 C6 88 0024*       ld ix,seekers_base
       04          
044B3D 06 03       0025*       ld b,seekers_max
044B3F CD 4C 78 04 0026*       call spawn_sprite_from_tile
044B43 D0          0027*       ret nc ; no carry means no free sprite slots, so we go home
044B44             0028*   ; other specific initialization
044B44 21 80 02 00 0029*       ld hl,speed_seeker
044B48 DD 2F 0D    0030*       ld (ix+sprite_vel),hl
044B4B C9          0031*       ret
044B4C             0032*   ; end enemy_spawn_seeker
044B4C             0033*   
044B4C             0034*   move_enemy_seeker_orbit:
044B4C             0035*   ; compute x coordinate of orbit origin based on sprite id
044B4C 3E 05       0036*       ld a,seeker_min_sprite_id
044B4E FD 96 00    0037*       sub (iy+sprite_id)
044B51 6F          0038*       ld l,a
044B52 26 55       0039*       ld h,85 ; 1/3 the playing field width
044B54 ED 6C       0040*       mlt hl
044B56 3E 40       0041*       ld a,64 ; 1/4 of the playing field width
044B58 85          0042*       add a,l ; a = x coordinate of orbit origin
044B59 FD 77 25    0043*       ld (iy+sprite_move_step),a ; as good a place as any to store it
044B5C             0044*   ; initialize orbit angle
044B5C AF          0045*       xor a
044B5D FD 77 13    0046*       ld (iy+sprite_orientation),a
044B60             0047*   ; ; initialize move timer
044B60             0048*   ;     inc a ; set to 1
044B60             0049*   ;     ld (iy+sprite_move_timer),a
044B60             0050*   ; init done, so update move program
044B60 21 67 4B 04 0051*       ld hl,move_enemy_seeker_orbit_stage1 ; update move program pointer
044B64 FD 2F 1A    0052*       ld (iy+sprite_move_program),hl
044B67             0053*   ; fall through to the persistent orbit behavior
044B67             0054*   move_enemy_seeker_orbit_stage1:
044B67             0055*   ; ; check whether time to update orbit angle
044B67             0056*   ;     dec (iy+sprite_move_timer)
044B67             0057*   ;     jp nz,@F ; not time to change so simply movethe sprite on the current heading
044B67             0058*   ;     inc (iy+sprite_move_timer) ; reset timer to 1
044B67             0059*   ; update the target coordinates based on orbit angle and radius
044B67 FD 34 13    0060*       inc (iy+sprite_orientation) ; increment angle
044B6A 21 00 00 00 0061*       ld hl,0 ; clear hlu and l
044B6E FD 66 13    0062*       ld h,(iy+sprite_orientation) ; uh.l = angle
044B71 11 00 80 00 0063*       ld de,128*256 ; ud.e = radius
044B75 CD F6 06 04 0064*       call polar_to_cartesian ; u.bc, u.de = x,y offsets
044B79 FD 7E 25    0065*       ld a,(iy+sprite_move_step) ; x coordinate of orbit origin
044B7C 80          0066*       add a,b ; add x offset
044B7D 01 00 00 00 0067*       ld bc,0 ; bcu and c
044B81 47          0068*       ld b,a ; ub.c = x
044B82 21 00 A8 00 0069*       ld hl,336/2*256
044B86 19          0070*       add hl,de
044B87 EB          0071*       ex de,hl ; ud.e = y
044B88 CD 71 6F 04 0072*       call bearing_to_coord ; uh.l = angle to coordinate
044B8C FD 2F 10    0073*       ld (iy+sprite_heading),hl ; save angle as heading
044B8F             0074*   ; compute component velocities, save them in sprite record, and move the sprite
044B8F CD AE 6A 04 0075*       call sprite_compute_velocities
044B93             0076*   @@:
044B93 CD 0D 6A 04 0077*       call move_sprite ; move the sprite
044B97 C3 9B 4B 04 0078*       jp move_enemy_seeker
044B9B             0079*   ; end move_enemy_seeker_orbit
044B9B             0080*   
044B9B             0081*   move_enemy_seeker:
044B9B DD 21 86 88 0082*       ld ix,player_begin
       04          
044BA0 DD CB 1D 76 0083*       bit sprite_alive,(ix+sprite_collisions)
044BA4 CA B0 4B 04 0084*       jp z,@F ; player is dead so don't check for collisions
044BA8 CD D8 49 04 0085*       call check_enemy_collision_player
044BAC CA D0 4B 04 0086*       jp z,@player
044BB0             0087*   @@:
044BB0 CD CC 49 04 0088*       call check_enemy_collision_laser
044BB4 CA C8 4B 04 0089*       jp z,@laser
044BB8             0090*   ; change the animation frame to match heading
044BB8 FD 7E 00    0091*       ld a,(iy+sprite_id)
044BBB CD BB 19 04 0092*       call vdu_sprite_select
044BBF CD D9 6A 04 0093*       call sprite_frame_heading ; a, sprite_frame set to heading-based frame
044BC3 CD 1E 1A 04 0094*       call vdu_sprite_select_frame
044BC7 C9          0095*       ret
044BC8             0096*   @laser:
044BC8 CD 58 66 04 0097*       call update_score
044BCC C3 96 4C 04 0098*       jp spawn_explosion
044BD0             0099*   @player:
044BD0 CD B5 66 04 0100*       call update_shields
044BD4 C3 96 4C 04 0101*       jp spawn_explosion
044BD8             0102*   ; end move_enemy_seeker
044BD8             0103*   
044BD8             0104*   ; contains the logic for how to move the enemy
044BD8             0105*   ; and then does the moving
044BD8             0106*   ; inputs: a fully-populated active sprite table
044BD8             0107*   ;         player position variables
044BD8             0108*   ; destroys: everything except index registers
044BD8             0109*   ; outputs: moving enemies
044BD8             0110*   en_nav_seek_zag:
044BD8             0111*   ; set velocity and orientation by player's relative location
044BD8             0112*   ; move enemies y-axis
044BD8             0113*   ; where is player relative to us?
044BD8 CD 1F 6F 04 0114*       call orientation_to_player ; uh.l angle to player, ub.c, ud.e = dx, dy
044BDC             0115*   ; is player above or below us?
044BDC ED 53 37 03 0116*       ld (ude),de ; dy
       04          
044BE1 3A 39 03 04 0117*       ld a,(ude+2) ; deu
044BE5 17          0118*       rla ; shift sign bit into carry
044BE6 D2 0F 4C 04 0119*       jp nc,@zig_zag ; player is below,evade
044BEA             0120*   ; player is even or above,so home in on current heading
044BEA FD 2F 10    0121*       ld (iy+sprite_heading),hl ; save sprite heading
044BED             0122*   ; fall through to @compute_velocities
044BED             0123*   @compute_velocities:
044BED CD AE 6A 04 0124*       call sprite_compute_velocities
044BF1 CD 0D 6A 04 0125*       call move_sprite ; move the sprite
044BF5 B7          0126*       or a ; a will be non-zero if have collided with screen edge
044BF6 C2 26 4C 04 0127*       jp nz,@edge_switch ; switch direction, but never move twice in one frame
044BFA C3 9B 4B 04 0128*       jp move_enemy_seeker ; didn't hit an edge so check collisions and move sprite
044BFE             0129*   @reset_zig_zag_timer:
044BFE FD 2A 07 67 0130*       ld iy,(table_pointer)
       04          
044C03 CD 14 05 04 0131*       call rand_8
044C07 E6 3F       0132*       and %00111111 ; limit it to 64
044C09 CB DF       0133*       set 3,a ; make sure it's at least 8
044C0B FD 77 24    0134*       ld (iy+sprite_move_timer),a ; store it
044C0E C9          0135*       ret
044C0F             0136*   @zig_zag:
044C0F FD 7E 24    0137*       ld a,(iy+sprite_move_timer)
044C12 3D          0138*       dec a
044C13 FD 77 24    0139*       ld (iy+sprite_move_timer),a
044C16 C2 4E 4C 04 0140*       jp nz,@zig_zag_no_switch
044C1A             0141*   @zag_switch:
044C1A CD 32 4C 04 0142*       call @switch_zag_heading
044C1E CD FE 4B 04 0143*       call @reset_zig_zag_timer
044C22 C3 4E 4C 04 0144*       jp @zig_zag_no_switch
044C26             0145*   @edge_switch:
044C26             0146*   ; The generic mover has already clamped/bounced this seeker. Choose the next
044C26             0147*   ; zag and return through collision handling; moving again here can loop forever
044C26             0148*   ; at the bottom edge because both zag headings point downward.
044C26 CD 32 4C 04 0149*       call @switch_zag_heading
044C2A CD FE 4B 04 0150*       call @reset_zig_zag_timer
044C2E C3 9B 4B 04 0151*       jp move_enemy_seeker
044C32             0152*   @switch_zag_heading:
044C32 FD 7E 25    0153*       ld a,(iy+sprite_move_step)
044C35 EE 01       0154*       xor %1 ; flips bit zero
044C37 FD 77 25    0155*       ld (iy+sprite_move_step),a ; store it
044C3A C2 46 4C 04 0156*       jp nz,@right ; zag right
044C3E             0157*   ;otherwise zag left
044C3E 21 00 A0 00 0158*       ld hl,160*256; southwest heading
044C42 FD 2F 10    0159*       ld (iy+sprite_heading),hl ; save sprite heading
044C45 C9          0160*       ret
044C46             0161*   @right:
044C46 21 00 60 00 0162*       ld hl,96*256; southeast heading
044C4A FD 2F 10    0163*       ld (iy+sprite_heading),hl ; save sprite heading
044C4D C9          0164*       ret
044C4E             0165*   @zig_zag_no_switch:
044C4E             0166*       ; ld a,(sprite_orientation)
044C4E FD 27 10    0167*       ld hl,(iy+sprite_heading)
044C51 C3 ED 4B 04 0168*       jp @compute_velocities
044C55             0169*   ; end en_nav_seek_zag
