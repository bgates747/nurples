046007 3A 6B 65 04 0121*       ld a,(charge_laser_timer_max)
04600B 32 6A 65 04 0122*       ld (charge_laser_timer),a
04600F 3A 48 64 04 0123*       ld a,(discharge_fuel_timer_max)
046013 32 47 64 04 0124*       ld (discharge_fuel_timer),a
