0462F8             0169*   ; update a vertical bar display
0462F8             0170*   ; inputs: ix points to bar structure
0462F8             0171*   ;         bar_val set by caller
0462F8             0172*   ; prerequisite: bar_init called before first use
0462F8             0173*   bar_update_v:
0462F8             0174*   ; set gfx viewport
0462F8 DD E5       0175*       push ix ; preserve pointer
0462FA DD 07 03    0176*       ld bc,(ix+bar_x0)
0462FD DD 17 06    0177*       ld de,(ix+bar_y0)
046300 DD 31 0C    0178*       ld iy,(ix+bar_y1)
046303 DD 37 09    0179*       ld ix,(ix+bar_x1)
046306 CD 6F 14 04 0180*       call vdu_set_gfx_viewport
04630A DD E1       0181*       pop ix ; restore pointer
04630C             0182*   ; select the color based on the value thresholds
04630C DD 17 00    0183*       ld de,(ix+bar_val)
04630F 21 EF FF FF 0184*       ld hl,-bar_red
046313 19          0185*       add hl,de
046314 D2 31 63 04 0186*       jp nc,@red
046318 21 DF FF FF 0187*       ld hl,-bar_yellow
04631C 19          0188*       add hl,de
04631D D2 29 63 04 0189*       jp nc,@yellow
