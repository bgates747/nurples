       52 65 61 64 
       79 21 00    
04620C             0303*   
04620C             0304*   player_dead:
04620C             0305*   ; reset player score to what it was at the start of the level
04620C 2A 0A 67 04 0306*       ld hl,(player_starting_score)
046210 22 07 67 04 0307*       ld (player_score),hl
046214             0308*   ; decrement lives
046214 3A A4 5F 04 0309*       ld a,(player_ships)
046218 3D          0310*       dec a
046219 32 A4 5F 04 0311*       ld (player_ships),a
04621D C2 28 62 04 0312*       jp nz,@respawn
046221             0313*   ; actors publish outcomes; the global playing state owns the phase transition
046221 3E 01       0314*       ld a,player_event_game_over
046223 32 9F 5F 04 0315*       ld (player_event),a
046227 C9          0316*       ret
046228             0317*   @respawn:
046228 3E 01       0318*       ld a,TELEMETRY_LIFECYCLE_RESPAWN
04622A CD 3E 88 04 0319*       call telemetry_post_lifecycle
04622E CD A6 5F 04 0320*       call draw_player_ships
046232 CD 89 6F 04 0321*       call reset_runtime_tables
046236             0322*   ; ; reset player score to what it was at the start of the level
046236             0323*   ;     ld hl,(player_starting_score)
046236             0324*   ;     ld (player_score),hl
046236             0325*   ; restart the level
046236 CD 7A 4E 04 0326*       call init_level
04623A             0327*   ; spawn player sprite at starting position
04623A CD 44 60 04 0328*       call player_init
04623E DA 49 62 04 0329*       jp c,@player_ready
046242             0330*   ; allocation should be impossible after table_init; recover without touching IX
046242 3E 01       0331*       ld a,player_event_game_over
046244 32 9F 5F 04 0332*       ld (player_event),a
046248 C9          0333*       ret
046249             0334*   @player_ready:
046249             0335*   ; set game playing substates
046249 21 94 4A 04 0336*       ld hl,enemies_alive
04624D 22 34 4A 04 0337*       ld (enemies_state), hl
046251 C9          0338*       ret
046252             0339*   ; end player_dead
