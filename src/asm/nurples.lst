04906B CD 96 90 04 0078*       call do_active_tiles
04906F E1          0079*       pop hl ; get back pointer to next row tile def
049070             0080*   ; time to bump tiles_row_defs to next row
049070             0081*   ; (hl was already there at the end of the loop)
049070 22 C6 8F 04 0082*       ld (tiles_row_defs),hl
049074             0083*   ; reset coords to plot next row of tiles
049074 21 00 00 00 0084*       ld hl,0
