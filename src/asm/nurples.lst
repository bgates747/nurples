048D10             0075*       CALL_HL
                       M1 Args: none
048D10 01 16 8D 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
048D14 C5          0002*M1     push bc ; which constitutes the return address
048D15 E9          0003*M1     jp (hl) ; Jump to the address in HL
048D16             0076*    ; get back stack pointer and loop
048D16             0077*   @next_record:
048D16 FD 2A F6 89 0078*       ld iy,(tile_stack_pointer)
       04          
048D1B ED 33 03    0079*       lea iy,iy+3 ; next tile stack record
048D1E C3 EE 8C 04 0080*       jp @move_loop ; loop until we've checked all the records
048D22             0081*   @just_spawned:
048D22 FD CB 16 BE 0082*       res 7,(iy+tile_type) ; clear just spawned flag
048D26 C3 16 8D 04 0083*       jp @next_record
