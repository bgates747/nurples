0400EF             0171*   ; BEGIN MY CODE
0400EF             0172*   ; restore all the things
0400EF E1          0173*       pop hl
0400F0 D1          0174*       pop de
0400F1 C1          0175*       pop bc
0400F2 F1          0176*       pop af
0400F3             0177*   ; END MY CODE
0400F3 C9          0178*       RET
