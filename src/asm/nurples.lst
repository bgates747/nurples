047AB5 CD ED 74 04 0021*       call spawn_active_tile
047AB9 D0          0022*       ret nc ; no carry means no free active tile slots, so we go home
047ABA             0023*   ; other specific initialization
047ABA C9          0024*       ret
047ABB             0025*   ; end activate_lightning
047ABB             0026*   
