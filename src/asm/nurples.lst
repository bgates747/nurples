044B13             0052        include "enemy_seeker.inc"
044B13 00          0001*   seekers_count: db 0
044B14             0002*   seekers_max: equ 3
044B14             0003*   speed_seeker: equ 0x000280 ; 2.5 pixels per frame
044B14             0004*   
044B14             0005*   seeker_defaults:
044B14 01          0006*       db enemy_air            ; type
044B15 53 01 00    0007*       dl BUF_SEEKER_000       ; base_bufferId
044B18 CB 4B 04    0008*       dl en_nav_seek_zag    ; move_program
044B1B 40          0009*       db %01000000            ; collisions bit 6 signals sprite alive
044B1C 10          0010*       db 16                   ; dim_x
044B1D 10          0011*       db 16                   ; dim_y
044B1E 20          0012*       db 32                   ; num_orientations
044B1F 01          0013*       db 1                    ; num_animations
044B20 00          0014*       db 0                    ; animation
044B21 00          0015*       db 0                    ; animation_timer
044B22 01          0016*       db 1                    ; move_timer
044B23 00          0017*       db 0                    ; move_step
044B24 0A          0018*       db 10                   ; points
044B25 FC          0019*       db -4                   ; shield_damage
044B26 00          0020*       db 0                    ; frame
