04204F 10          0009*       db 16                   ; dim_x
042050 10          0010*       db 16                   ; dim_y
042051 20          0011*       db 32                   ; num_orientations
042052 02          0012*       db 2                    ; num_animations
042053 00          0013*       db 0                    ; animation
042054 08          0014*       db 8                    ; animation_timer
042055 00          0015*       db 0                    ; move_timer
042056 00          0016*       db 0                    ; move_step
