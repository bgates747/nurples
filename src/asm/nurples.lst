041498             0259*   vdu_set_screen_mode:
041498 32 A8 14 04 0260*   	ld (@arg),a
04149C 21 A7 14 04 0261*   	ld hl,@cmd
0414A0 01 02 00 00 0262*   	ld bc,@end-@cmd
0414A4 5B DF       0263*   	rst.lil $18
0414A6 C9          0264*   	ret
0414A7 16          0265*   @cmd: db 22 ; set screen mode
0414A8 00          0266*   @arg: db 0  ; screen mode parameter
0414A9             0267*   @end:
0414A9             0268*   
0414A9             0269*   ; get the current screen mode
0414A9             0270*   ; inputs: none
0414A9             0271*   ; outputs: a=screen mode
0414A9             0272*   ; destroys: af, ix
0414A9             0273*   vdu_get_screen_mode:
0414A9             0274*       MOSCALL mos_sysvars
                       M1 Args: function=mos_sysvars 
0414A9 3E 08       0001*M1 			LD	A, function
0414AB 5B CF       0002*M1 			RST.LIL	08h
