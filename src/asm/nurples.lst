049368             0468*   
049368             0469*   ; print bytes from an address to the screen in binary format
049368             0470*   ; with the bits of each byte in reverse order (lsb first)
049368             0471*   ; inputs: hl = address of first byte to print, a = number of bytes to print
049368             0472*   ; outputs: values of each byte printed to screen separated by spaces
049368             0473*   ; destroys: nothing
049368             0474*   dumpMemoryBinRev:
049368             0475*   ; save all registers to the stack
049368 F5          0476*       push af
049369 C5          0477*       push bc
04936A D5          0478*       push de
04936B E5          0479*       push hl
04936C DD E5       0480*       push ix
04936E FD E5       0481*       push iy
049370             0482*   
049370             0483*   ; set b to be our loop counter
049370 47          0484*       ld b,a
049371             0485*   @loop:
049371             0486*   ; print the byte
049371 7E          0487*       ld a,(hl)
049372 E5          0488*       push hl
049373 C5          0489*       push bc
049374 CD 8F 02 04 0490*       call printBin8Rev
049378 C1          0491*       pop bc
049379             0492*   ; print a space
049379 3E 20       0493*       ld a,' '
04937B 5B D7       0494*       rst.lil 10h
04937D E1          0495*       pop hl
04937E 23          0496*       inc hl
04937F 10 F0       0497*       djnz @loop
049381 CD 78 00 04 0498*       call printNewLine
049385             0499*   
049385             0500*   ; restore everything
