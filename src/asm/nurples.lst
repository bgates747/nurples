0486B6             0083        include "runtime_init.inc"
0486B6             0001*   ; Process-entry initialization
0486B6             0002*   ; ============================
0486B6             0003*   ;
0486B6             0004*   ; MOS RUN re-enters the resident binary; it does not restore DB/DL initializers.
0486B6             0005*   ; Only state whose lifetime is one application invocation belongs here. Session,
0486B6             0006*   ; level, life, table, loader, and arithmetic scratch state is initialized by its
0486B6             0007*   ; owning routine before first use.
0486B6             0008*   
0486B6             0009*   runtime_process_init:
0486B6             0010*   ; Process control bytes are ordinary resident RAM. Reset them explicitly on
0486B6             0011*   ; every MOS RUN instead of relying on their assembled DB values.
0486B6 AF          0012*       xor a
0486B7 32 09 6B 04 0013*       ld (game_exit_requested),a
0486BB 32 57 5F 04 0014*       ld (player_event),a
0486BF             0015*   
0486BF             0016*   ; Diagnostic latches describe this invocation only.
0486BF 32 08 6B 04 0017*       ld (game_fault_flags),a
0486C3 32 EF 49 04 0018*       ld (enemies_fault_flags),a
0486C7 32 58 5F 04 0019*       ld (player_fault_flags),a
0486CB 32 0B 67 04 0020*       ld (sprite_fault_flags),a
0486CF 32 42 73 04 0021*       ld (tile_fault_flags),a
0486D3 32 84 13 04 0022*       ld (timer_fault_flags),a
0486D7 32 46 14 04 0023*       ld (vdu_timing_fault_flags),a
0486DB             0024*   
0486DB             0025*   ; Small persistent helpers that otherwise inherit their previous RUN values.
0486DB 32 20 4B 04 0026*       ld (seekers_count),a
0486DF 32 0A 67 04 0027*       ld (sprite_screen_edge),a
0486E3 32 85 13 04 0028*       ld (oldTimeStamp),a
0486E7 21 00 00 00 0029*       ld hl,0
0486EB 22 4A 05 04 0030*       ld (seed1),hl
0486EF 22 4D 05 04 0031*       ld (seed2),hl
0486F3             0032*   
0486F3             0033*   ; Publish valid dispatcher states before the first tick. Their owning init
0486F3             0034*   ; routines will republish the same operational states after resources exist.
0486F3 21 76 6C 04 0035*       ld hl,game_init
0486F7 22 05 6B 04 0036*       ld (game_state),hl
0486FB 21 4C 4A 04 0037*       ld hl,enemies_alive
0486FF 22 EC 49 04 0038*       ld (enemies_state),hl
048703 21 8B 60 04 0039*       ld hl,player_alive
048707 22 54 5F 04 0040*       ld (player_state),hl
04870B             0041*   
04870B             0042*   ; Restore the documented random seed and establish a current clock baseline.
04870B 3E 50       0043*       ld a,$50
04870D 32 28 05 04 0044*       ld (r_seed),a
048711 CD BC 12 04 0045*       call timestamp_init
048715 C9          0046*       ret
048716             0047*   ; end runtime_process_init
048716             0084    
048716             0085    ; --- MAIN PROGRAM FILE ---
048716             0086    main:
048716             0087    ; Establish a new process lifetime. MOS RUN does not reload initialized data.
048716 CD B6 86 04 0088        call runtime_process_init
04871A             0089    ; Capture the caller's display mode exactly once, before game_init changes VDP
04871A             0090    ; state. In-process restarts must not replace this with the gameplay mode.
04871A CD C9 14 04 0091        call vdu_get_screen_mode
04871E 32 75 6C 04 0092        ld (original_screen_mode),a
048722             0093    main_loop:
048722             0094    ; update the global timestamp
048722 CD D4 12 04 0095        call timestamp_tick
048726             0096    ; do gamestate logic
048726 CD 0A 6B 04 0097        call do_game
04872A             0098    ; state handlers return through the dispatcher; honor an orderly exit request
04872A 3A 09 6B 04 0099        ld a,(game_exit_requested)
04872E B7          0100        or a
04872F C2 48 87 04 0101        jp nz,main_end
048733             0102    ; wait for the next vblank mitigate flicker and for loop timing
048733 CD 47 14 04 0103        call vdu_vblank
048737             0104    ; poll keyboard for escape keypress
048737 3E 08       0105        ld a, $08 ; code to send to MOS
048739 5B CF       0106        rst.lil $08 ; get IX pointer to System Variables
04873B DD 7E 05    0107        ld a, (ix + $05) ; get ASCII code of key pressed
04873E FE 1B       0108        cp 27 ; check if 27 (ascii code for ESC)
048740 CA 48 87 04 0109        jp z, main_end ; if pressed, jump to exit
048744             0110    ; escape not pressed so loop
048744 C3 22 87 04 0111        jp main_loop
048748             0112    
048748             0113    main_end:
048748             0114    ; Release application-owned VDP state. Select the permanent system font before
048748             0115    ; deleting the custom-font buffer, and detach sprites before their bitmaps.
048748 21 FF FF 00 0116        ld hl,65535
04874C AF          0117        xor a
04874D CD 67 18 04 0118        call vdu_font_select
048751 CD EF 1A 04 0119        call vdu_sprite_reset
048755 CD F5 17 04 0120        call vdu_clear_all_buffers
048759             0121    ; restore original screen mode
048759 3A 75 6C 04 0122        ld a,(original_screen_mode)
04875D CD B8 14 04 0123        call vdu_set_screen_mode
048761             0124    ; print thanks for playing message
048761 CD 5C 00 04 0125        call printInline
048765 54 68 61 6E 0126        asciz "Thank you for playing\r\n"
       6B 20 79 6F 
       75 20 66 6F 
       72 20 70 6C 
       61 79 69 6E 
       67 0D 0A 00 
04877D 21 09 44 04 0127        ld hl,purple_nurples_ascii
048781 CD 63 00 04 0128        call printString
048785 C9          0129        ret
048786             0130    ; end main
048786             0131    
048786             0132    ; needs to be the final include to leave room for the sprite and tile tables
048786             0133        include "tables.inc"
048786             0001*   ; #### THIS IS THE SPACE ALLOCATED TO THE SPRITE TABLE ####
048786             0002*   table_base: equ $
048786             0003*   player_weapons_begin: equ table_base
048786             0004*   player_lasers_begin: equ player_weapons_begin
048786             0005*   player_lasers_end: equ table_record_size*player_lasers_max+player_lasers_begin
048786             0006*   player_lasers_end_sprite_id: equ [player_lasers_end-table_base]/table_record_size
048786             0007*   player_weapons_end: equ table_record_size*player_lasers_max+player_weapons_begin
048786             0008*   player_begin: equ player_weapons_end
048786             0009*   player_end: equ table_record_size+player_begin
048786             0010*   enemy_sprites_begin: equ player_end
048786             0011*   seekers_base: equ enemy_sprites_begin
048786             0012*   seeker_min_sprite_id: equ [seekers_base-table_base]/table_record_size
048786             0013*   seekers_end: equ table_record_size*seekers_max+seekers_base
048786             0014*   seekers_end_sprite_id: equ [seekers_end-table_base]/table_record_size
048786             0015*   fireballs_base: equ seekers_end
048786             0016*   fireballs_end: equ table_record_size*fireballs_max+fireballs_base
048786             0017*   fireballs_end_sprite_id: equ [fireballs_end-table_base]/table_record_size
048786             0018*   enemy_sprites_end: equ fireballs_end
048786             0019*   explosions_base: equ enemy_sprites_end
048786             0020*   explosions_end: equ table_record_size*explosions_max+explosions_base
048786             0021*   explosions_end_sprite_id: equ [explosions_end-table_base]/table_record_size
048786             0022*   table_end: equ explosions_end
048786             0023*   
048786             0024*   table_num_records: equ [table_end-table_base]/table_record_size
048786             0025*   table_num_enemy_records: equ [enemy_sprites_end-enemy_sprites_begin]/table_record_size
048786             0026*   
048786             0027*   ; ### THIS IS THE SPACE ALLOCATED TO THE ACTIVE TILES TABLE ###
048786             0028*   tile_table_base: equ table_end
048786             0029*   tile_table_end: equ 256*tile_table_record_size+tile_table_base
