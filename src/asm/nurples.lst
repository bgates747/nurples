04A20C             0528*   
04A20C             0529*   telemetry_game_state_map:
04A20C E7 80 04    0530*       dl game_main_menu
04A20F 02          0531*       db STATE_NEW_TITLE
04A210 E8 80 04    0532*       dl game_paused
04A213 07          0533*       db STATE_NEW_PAUSED
04A214 E9 80 04    0534*       dl game_level_transition
04A217 08          0535*       db STATE_NEW_LEVEL_TRANSITION
04A218 F6 80 04    0536*       dl game_over
04A21B 0A          0537*       db STATE_NEW_GAME_OVER
04A21C 59 81 04    0538*       dl game_victory
04A21F 0B          0539*       db STATE_NEW_VICTORY
04A220 5A 81 04    0540*       dl game_loading
04A223 01          0541*       db STATE_NEW_LOADING
04A224 67 81 04    0542*       dl game_cutscene
04A227 80          0543*       db STATE_LEGACY_CUTSCENE
04A228 68 81 04    0544*       dl game_inventory
04A22B 81          0545*       db STATE_LEGACY_INVENTORY
04A22C 69 81 04    0546*       dl game_map
04A22F 82          0547*       db STATE_LEGACY_MAP
04A230 6A 81 04    0548*       dl game_exit
04A233 0C          0549*       db STATE_NEW_EXIT
04A234 67 84 04    0550*       dl game_playing
04A237 06          0551*       db STATE_NEW_PLAYING
04A238             0552*   telemetry_game_state_map_end:
04A238             0553*   telemetry_game_state_count: equ [telemetry_game_state_map_end-telemetry_game_state_map]/4
04A238             0554*   
04A238             0555*   telemetry_player_state_map:
04A238 DE 73 04    0556*       dl player_alive
04A23B 02          0557*       db STATE_NEW_PLAYER_ACTIVE
04A23C 0D 73 04    0558*       dl player_spawning
04A23F 01          0559*       db STATE_NEW_PLAYER_READY
04A240 9A 73 04    0560*       dl player_grace
04A243 02          0561*       db STATE_NEW_PLAYER_ACTIVE
04A244 48 74 04    0562*       dl player_dying
04A247 03          0563*       db STATE_NEW_PLAYER_DYING
04A248 BE 75 04    0564*       dl player_dead
04A24B 04          0565*       db STATE_NEW_PLAYER_DEAD
04A24C             0566*   telemetry_player_state_map_end:
