0476EC             0020*   tile_activation_routines:
0476EC 1F 77 04    0021*       dl activate_null_tile ; dummy spacer since tiled is 1-based
0476EF E7 7A 04    0022*       dl activate_pad_small
0476F2 1F 77 04    0023*       dl activate_null_tile
0476F5 1F 77 04    0024*       dl activate_null_tile
0476F8 1F 77 04    0025*       dl activate_null_tile
0476FB 5C 7B 04    0026*       dl activate_turret_fireball
0476FE 1F 77 04    0027*       dl activate_null_tile
047701 1F 77 04    0028*       dl activate_null_tile
047704 1F 77 04    0029*       dl activate_null_tile
047707 ED 78 04    0030*       dl activate_electrode
04770A 8E 7A 04    0031*       dl activate_lightning
04770D ED 78 04    0032*       dl activate_electrode
047710 1F 77 04    0033*       dl activate_null_tile
047713 1F 77 04    0034*       dl activate_null_tile
047716 1F 77 04    0035*       dl activate_null_tile
047719 1F 77 04    0036*       dl activate_null_tile ; tile 15
04771C 98 78 04    0037*       dl activate_crater ; tile 16
04771F             0038*   tile_activation_routines_end:
04771F             0039*   tile_activation_routines_count: equ [tile_activation_routines_end-tile_activation_routines]/3
04771F             0040*   ; end tile_activation_routines
04771F             0041*   
04771F             0042*   activate_null_tile:
04771F C9          0043*       ret ; dummy routine, do nothing
047720             0044*   move_active_tile:
047720             0045*   ; y-axis movement
047720 FD 27 04    0046*       ld hl,(iy+tile_y)
047723 FD 17 0A    0047*       ld de,(iy+tile_yvel)
047726 19          0048*       add hl,de
047727 FD 2F 04    0049*       ld (iy+tile_y),hl
04772A             0050*   ; detect screen edge collisions
04772A             0051*   ; y-axis bottom is all we need to test
04772A 11 00 80 FE 0052*       ld de,-tile_bottom*256
04772E ED 5A       0053*       adc hl,de
047730 F8          0054*       ret m ; still on screen so do nothing further
047731 AF          0055*       xor a ; signal caller that tile has scrolled off screen
047732 C9          0056*       ret
047733             0057*   ; end move_active_tile
047733             0058*   
047733             0059*   ; Exact stabilization whitelist for writable legacy tile callbacks.
047733             0060*   ; inputs: iy = validated tile record, hl = stored callback
047733             0061*   ; outputs: carry set and hl = expected callback on an exact type/program match
047733             0062*   ; destroys: a,de,hl
047733             0063*   tile_move_program_valid:
047733 FD 7E 16    0064*       ld a,(iy+tile_type)
047736 FE 01       0065*       cp tile_pad_small
047738 CA 58 77 04 0066*       jp z,@pad_small
04773C FE 05       0067*       cp tile_turret_fireball
04773E CA 60 77 04 0068*       jp z,@turret_fireball
047742 FE 09       0069*       cp tile_electrode
047744 CA 68 77 04 0070*       jp z,@electrode
047748 FE 0A       0071*       cp tile_lightning
04774A CA 70 77 04 0072*       jp z,@lightning
04774E FE 10       0073*       cp tile_crater
047750 CA 78 77 04 0074*       jp z,@crater
047754 C3 87 77 04 0075*       jp @invalid
047758             0076*   @pad_small:
047758 11 FA 7A 04 0077*       ld de,move_pad_small
04775C C3 7C 77 04 0078*       jp @compare
047760             0079*   @turret_fireball:
047760 11 6F 7B 04 0080*       ld de,move_turret_fireball
047764 C3 7C 77 04 0081*       jp @compare
047768             0082*   @electrode:
047768 11 F6 78 04 0083*       ld de,move_electrode
04776C C3 7C 77 04 0084*       jp @compare
047770             0085*   @lightning:
047770 11 98 7A 04 0086*       ld de,move_lightning
047774 C3 7C 77 04 0087*       jp @compare
047778             0088*   @crater:
047778 11 A8 78 04 0089*       ld de,move_crater
04777C             0090*   @compare:
04777C B7          0091*       or a
04777D ED 52       0092*       sbc hl,de
04777F C2 87 77 04 0093*       jp nz,@invalid
047783 D5          0094*       push de
047784 E1          0095*       pop hl ; publish the fixed expected address, not writable record data
047785 37          0096*       scf
047786 C9          0097*       ret
047787             0098*   @invalid:
047787 AF          0099*       xor a
047788 C9          0100*       ret
047789             0101*   ; end tile_move_program_valid
047789             0102*   
047789             0103*   move_tiles:
047789             0104*   ; initialize the dense-stack cursor
047789 3A 18 73 04 0105*       ld a,(num_active_tiles)
04778D B7          0106*       or a
04778E C8          0107*       ret z
04778F FD 21 0F 70 0108*       ld iy,tile_stack ; set iy to first record in table
       04          
047794             0109*   @move_loop:
047794 FD E5       0110*       push iy
047796 E1          0111*       pop hl
047797 CD C3 73 04 0112*       call tile_stack_pointer_valid
04779B D0          0113*       ret nc ; normal end-of-stack or fail-closed malformed cursor
04779C FD 22 12 73 0114*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
0477A1             0115*   ; point iy to tile record
0477A1 FD 37 00    0116*       ld iy,(iy) ; iy points to the current tile record
0477A4 CD FC 73 04 0117*       call tile_table_record_pointer_valid
0477A8 D2 F2 77 04 0118*       jp nc,@bad_record
0477AC FD 22 15 73 0119*       ld (tile_table_pointer),iy ; update table pointer
       04          
0477B1             0120*   ; check top bit of tile_type to see if tile is just spawned
0477B1 FD CB 16 7E 0121*       bit 7,(iy+tile_type)
0477B5 C2 E2 77 04 0122*       jp nz,@just_spawned ; if just spawned, skip to next record
0477B9             0123*   ; check sprite_alive bit to see if tile is active
0477B9 FD CB 1D 76 0124*       bit sprite_alive,(iy+tile_collisions)
0477BD CA EA 77 04 0125*       jp z,@inactive_record
0477C1             0126*   ; otherwise we prepare to move the tile
0477C1 FD 27 1A    0127*       ld hl,(iy+tile_move_program) ; load the behavior subroutine address
0477C4 CD 33 77 04 0128*       call tile_move_program_valid
0477C8 D2 00 78 04 0129*       jp nc,@bad_move_program
0477CC FD E5       0130*       push iy ; callbacks may use index registers internally but do not own them
0477CE             0131*       CALL_HL
                       M1 Args: none
0477CE 01 D4 77 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
0477D2 C5          0002*M1     push bc ; which constitutes the return address
0477D3 E9          0003*M1     jp (hl) ; Jump to the address in HL
0477D4 FD E1       0132*       pop iy
0477D6             0133*    ; get back stack pointer and loop
0477D6             0134*   @next_record:
0477D6 FD 2A 12 73 0135*       ld iy,(tile_stack_pointer)
       04          
0477DB ED 33 03    0136*       lea iy,iy+3 ; next tile stack record
0477DE C3 94 77 04 0137*       jp @move_loop ; loop until we've checked all the records
0477E2             0138*   @just_spawned:
0477E2 FD CB 16 BE 0139*       res 7,(iy+tile_type) ; clear just spawned flag
0477E6 C3 D6 77 04 0140*       jp @next_record
0477EA             0141*   @inactive_record:
0477EA CD 32 74 04 0142*       call table_deactivate_tile
0477EE C3 D6 77 04 0143*       jp @next_record
0477F2             0144*   @bad_record:
0477F2 21 1F 73 04 0145*       ld hl,tile_fault_flags
0477F6 CB C6       0146*       set tile_fault_bad_record,(hl)
0477F8 CD 76 74 04 0147*       call tile_stack_quarantine_entry
0477FC C3 D6 77 04 0148*       jp @next_record
047800             0149*   @bad_move_program:
047800 21 1F 73 04 0150*       ld hl,tile_fault_flags
047804 CB CE       0151*       set tile_fault_bad_move_program,(hl)
047806 CD 32 74 04 0152*       call table_deactivate_tile
04780A C3 D6 77 04 0153*       jp @next_record
04780E             0154*   ; end move_tiles
04780E             0155*   
04780E             0156*   draw_active_tile:
04780E FD 27 17    0157*       ld hl,(iy+tile_base_bufferId)
047811 FD 7E 28    0158*       ld a,(iy+tile_frame)
047814 85          0159*       add a,l ; TODO: with a little work we could make all tile base buffer ids align to 256
047815 6F          0160*       ld l,a
047816 3E 00       0161*       ld a,0 ; preserve carry
047818 8C          0162*       adc a,h
047819 67          0163*       ld h,a
04781A CD C4 14 04 0164*       call vdu_buff_select ; buffer id of animation frame
04781E FD 07 01    0165*       ld bc,(iy+tile_x)
047821 FD 17 04    0166*       ld de,(iy+tile_y)
047824 CD 16 19 04 0167*       call vdu_plot_bmp168
047828 C9          0168*       ret
047829             0169*   ; end draw_active_tile
047829             0170*   
047829             0171*   ; create a new sprite at the same location as the current tile
047829             0172*   ; inputs: hl = pointer to new sprite default settings, tile_table_pointer = current tile
047829             0173*   ;         ix = pointer to sprite group, b = number of records in sprite group
047829             0174*   spawn_sprite_from_tile:
047829 E5          0175*       push hl ; back up pointer to new sprite defaults
04782A CD C0 67 04 0176*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
04782E E1          0177*       pop hl ; restore pointer to new sprite defaults
04782F D0          0178*       ret nc ; no carry means no free sprite slots, so we go home
047830             0179*   ; copy default settings to new sprite
047830 DD E5       0180*       push ix ; back up pointer to new sprite record
047832 ED 32 16    0181*       lea ix,ix+sprite_definitions ; bump pointer to copy to
047835 DD E5       0182*       push ix ; pointer to default sprite settings
047837 D1          0183*       pop de ; address to copy to
047838 01 13 00 00 0184*       ld bc,sprite_definitions_size ; copy only bytes provided by defaults
04783C ED B0       0185*       ldir ; copies defaults to new sprite record
04783E DD E1       0186*       pop ix ; restore pointer to new sprite record
047840             0187*   ; copy sprite position from existing tile
047840 FD 2A 15 73 0188*       ld iy,(tile_table_pointer) ; get existing tile record
       04          
047845 FD 27 01    0189*       ld hl,(iy+tile_x)
047848 DD 2F 01    0190*       ld (ix+sprite_x),hl
04784B FD 27 04    0191*       ld hl,(iy+tile_y)
04784E DD 2F 04    0192*       ld (ix+sprite_y),hl
047851             0193*   ; clear motion state retained by a previously used physical record
047851 21 00 00 00 0194*       ld hl,0
047855 DD 2F 07    0195*       ld (ix+sprite_xvel),hl
047858 DD 2F 0A    0196*       ld (ix+sprite_yvel),hl
04785B DD 2F 0D    0197*       ld (ix+sprite_vel),hl
04785E DD 2F 10    0198*       ld (ix+sprite_heading),hl
047861 DD 2F 13    0199*       ld (ix+sprite_orientation),hl
047864             0200*   ; return to caller
047864 DD CB 16 FE 0201*       set 7,(ix+sprite_type) ; set just spawned flag
047868 DD CB 1D F6 0202*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
04786C 37          0203*       scf ; set carry flag to indicate success
04786D C9          0204*       ret
04786E             0205*   ; end spawn_sprite_from_tile
04786E             0206*   
04786E             0207*   ; create a new tile at the same location as the current tile
04786E             0208*   ; inputs: tile_table_pointer = current tile
04786E             0209*   spawn_active_tile_from_tile:
04786E             0210*   ; copy default settings to new tile
04786E DD 2A 15 73 0211*       ld ix,(tile_table_pointer) ; get existing tile record
       04          
047873 ED 32 16    0212*       lea ix,ix+tile_definitions ; bump pointer to copy to
047876 DD E5       0213*       push ix ; pointer to default tile settings
047878 D1          0214*       pop de ; address to copy to
047879 01 13 00 00 0215*       ld bc,tile_definitions_size ; copy only bytes provided by defaults
04787D ED B0       0216*       ldir ; copies defaults to new tile record
04787F DD 2A 15 73 0217*       ld ix,(tile_table_pointer) ; restore pointer to new tile record
       04          
047884 C9          0218*       ret
047885             0219*   ; end spawn_active_tile_from_tile
047885             0077        include "tile_crater.inc"
047885             0001*   crater_defaults:
047885 10          0002*       db tile_crater          ; type
047886 04 01 00    0003*       dl BUF_CRATER_A      ; base_bufferId
047889 A8 78 04    0004*       dl move_crater          ; move_program
04788C 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
04788D 10          0006*       db 16                   ; dim_x
04788E 10          0007*       db 16                   ; dim_y
04788F 01          0008*       db 1                    ; num_orientations
047890 04          0009*       db 4                    ; num_animations
047891 05          0010*       db 5	                ; animation
047892 08          0011*       db 8                    ; animation_timer
047893 00          0012*       db 0                    ; move_timer
047894 00          0013*       db 0                    ; move_step
047895 00          0014*       db 0                    ; points
047896 00          0015*       db 0                    ; shield_damage
047897 00          0016*       db 0                    ; frame
047898             0017*   
047898             0018*   activate_crater:
047898 21 85 78 04 0019*       ld hl,crater_defaults
04789C C3 CA 74 04 0020*       jp spawn_active_tile
0478A0             0021*   ; end activate_crater
0478A0             0022*   
0478A0             0023*   ; Replace an existing active tile without allocating or changing its position.
0478A0             0024*   transform_active_tile_to_crater:
0478A0 21 85 78 04 0025*       ld hl,crater_defaults
0478A4 C3 6E 78 04 0026*       jp spawn_active_tile_from_tile
0478A8             0027*   ; end transform_active_tile_to_crater
0478A8             0028*   
0478A8             0029*   move_crater:
0478A8 CD 20 77 04 0030*       call move_active_tile
0478AC CA 32 74 04 0031*       jp z,table_deactivate_tile
0478B0             0032*   ; do animation
0478B0 FD 35 23    0033*       dec (iy+tile_animation_timer)
0478B3 C0          0034*       ret nz ; not time to animate
0478B4 FD 35 22    0035*       dec (iy+sprite_animation) ; check whether time to transition to crater
0478B7 CC CD 78 04 0036*       call z,@make_crater
0478BB 3E 08       0037*       ld a,8
0478BD FD 77 23    0038*       ld (iy+tile_animation_timer),a
0478C0 FD 7E 28    0039*       ld a,(iy+tile_frame)
0478C3 3C          0040*       inc a
0478C4 E6 03       0041*       and %00000011 ; modulo 4
0478C6 FD 77 28    0042*       ld (iy+tile_frame),a
0478C9 C3 0E 78 04 0043*       jp draw_active_tile
0478CD             0044*   @make_crater:
0478CD 21 00 01 00 0045*       ld hl,BUF_CRATER_0
0478D1 FD 2F 17    0046*       ld (iy+tile_base_bufferId),hl
0478D4 3E FF       0047*       ld a,-1 ; will wrap to zero on return
0478D6 FD 77 28    0048*       ld (iy+tile_frame),a
0478D9 C9          0049*       ret
0478DA             0050*   ; end move_crater
0478DA             0078        include "tile_electrode.inc"
0478DA             0001*   electrode_defaults:
0478DA 09          0002*       db tile_electrode       ; type
0478DB 76 01 00    0003*       dl BUF_TILE_BLANK       ; base_bufferId
0478DE F6 78 04    0004*       dl move_electrode       ; move_program
0478E1 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
0478E2 10          0006*       db 16                   ; dim_x
0478E3 10          0007*       db 16                   ; dim_y
0478E4 01          0008*       db 1                    ; num_orientations
0478E5 01          0009*       db 1                    ; num_animations
0478E6 00          0010*       db 0                    ; animation
0478E7 00          0011*       db 0                    ; animation_timer
0478E8 00          0012*       db 0                    ; move_timer
0478E9 00          0013*       db 0                    ; move_step
0478EA 05          0014*       db 5                    ; points
0478EB FC          0015*       db -4                   ; shield_damage
0478EC 00          0016*       db 0                    ; frame
0478ED             0017*   
0478ED             0018*   activate_electrode:
0478ED 21 DA 78 04 0019*       ld hl,electrode_defaults
0478F1             0020*   ; get next available active tile id
0478F1 CD CA 74 04 0021*       call spawn_active_tile
0478F5             0022*       ; ret nc ; no carry means no free active tile slots, so we go home
0478F5             0023*   ; other specific initialization
0478F5 C9          0024*       ret
0478F6             0025*   ; end activate_electrode
0478F6             0026*   
0478F6             0027*   move_electrode:
0478F6 CD 20 77 04 0028*       call move_active_tile
0478FA CA 32 74 04 0029*       jp z,table_deactivate_tile
0478FE DD 21 F3 87 0030*       ld ix,player_begin
       04          
047903 DD CB 1D 76 0031*       bit sprite_alive,(ix+sprite_collisions)
047907 CA 1B 79 04 0032*       jp z,@laser ; player is dead so don't check for collisions
04790B CD B8 49 04 0033*       call check_enemy_collision_player
04790F C2 1B 79 04 0034*       jp nz,@laser ; no collision so check laser collision
047913 CD 8B 66 04 0035*       call update_shields
047917 C3 28 79 04 0036*       jp kill_electrode
04791B             0037*   @laser:
04791B CD AC 49 04 0038*       call check_enemy_collision_laser
04791F C0          0039*       ret nz ; no collision so we're done
047920 CD 2E 66 04 0040*       call update_score
047924 C3 28 79 04 0041*       jp kill_electrode
047928             0042*   ; end move_electrode
047928             0043*   
047928             0044*   kill_electrode:
047928             0045*   ; Preserve the source record itself. Removing earlier stack entries may change
047928             0046*   ; its dense-stack slot, so the slot is rediscovered after the scan.
047928 FD 22 77 7A 0047*       ld (@source_tile_pointer),iy
       04          
04792D FD 27 04    0048*       ld hl,(iy+tile_y)
047930 22 74 7A 04 0049*       ld (@tile_y),hl
047934             0050*   ; activate blank tile bitmap only after source data no longer depends on IY
047934 21 76 01 00 0051*       ld hl,BUF_TILE_BLANK
047938 CD C4 14 04 0052*       call vdu_buff_select
04793C             0053*   ; Bound the scan to the entry count at its start. Each processed or removed
04793C             0054*   ; entry consumes one unit; removal leaves IX on the shifted successor.
04793C 3A 18 73 04 0055*       ld a,(num_active_tiles)
047940 32 7A 7A 04 0056*       ld (@tiles_remaining),a
047944 DD 21 0F 70 0057*       ld ix,tile_stack ; set ix to first record in table
       04          
047949             0058*   @check_loop:
047949 3A 7A 7A 04 0059*       ld a,(@tiles_remaining)
04794D B7          0060*       or a
04794E CA 00 7A 04 0061*       jp z,@scan_done
047952 3D          0062*       dec a
047953 32 7A 7A 04 0063*       ld (@tiles_remaining),a
047957             0064*   ; validate the stack slot before loading its pointer
047957 DD E5       0065*       push ix
047959 E1          0066*       pop hl
04795A CD C3 73 04 0067*       call tile_stack_pointer_valid
04795E D2 00 7A 04 0068*       jp nc,@scan_done
047962 DD 22 71 7A 0069*       ld (@tile_stack_pointer),ix ; update stack pointer
       04          
047967             0070*   ; validate the record before reading any fields
047967 DD 31 00    0071*       ld iy,(ix)
04796A CD FC 73 04 0072*       call tile_table_record_pointer_valid
04796E D2 DC 79 04 0073*       jp nc,@bad_record
047972             0074*   ; check top bit of tile_type to see if tile is just spawned
047972 FD CB 16 7E 0075*       bit 7,(iy+tile_type)
047976 C2 F4 79 04 0076*       jp nz,@next_record ; if just spawned, skip to next record
04797A             0077*   ; check sprite_alive bit to see if tile is active
04797A FD CB 1D 76 0078*       bit sprite_alive,(iy+tile_collisions)
04797E CA CA 79 04 0079*       jp z,@inactive_record
047982             0080*   ; check tile type
047982 FD 7E 16    0081*       ld a,(iy+tile_type)
047985 FE 0A       0082*       cp tile_lightning ; check if tile is lightning
047987 C2 F4 79 04 0083*       jp nz,@next_record ; if not lightning, skip to next record
04798B             0084*   ; check tile position
04798B DD 22 12 73 0085*       ld (tile_stack_pointer),ix
       04          
047990 FD 22 15 73 0086*       ld (tile_table_pointer),iy
       04          
047995 FD 27 04    0087*       ld hl,(iy+tile_y)
047998 ED 5B 74 7A 0088*       ld de,(@tile_y)
       04          
04799D B7          0089*       or a ; clear carry
04799E E5          0090*       push hl
04799F ED 52       0091*       sbc hl,de
0479A1 E1          0092*       pop hl
0479A2 CA B2 79 04 0093*       jp z,@kill_it
0479A6 01 00 01 00 0094*       ld bc,1*256
0479AA 09          0095*       add hl,bc
0479AB B7          0096*       or a
0479AC ED 52       0097*       sbc hl,de
0479AE C2 F4 79 04 0098*       jp nz,@next_record
0479B2             0099*   @kill_it: ; deactivate tile and replace with inactive blank tile
0479B2 FD 07 01    0100*       ld bc,(iy+tile_x) ; get x position (ud.e already has y-position)
0479B5 FD E5       0101*       push iy
0479B7 CD 16 19 04 0102*       call vdu_plot_bmp168 ; plot blank tile (bitmap was activated at beginning of proc)
0479BB FD E1       0103*       pop iy
0479BD CD 32 74 04 0104*       call table_deactivate_tile
0479C1 DD 2A 71 7A 0105*       ld ix,(@tile_stack_pointer) ; get back stack pointer
       04          
0479C6 C3 49 79 04 0106*       jp @check_loop ; deactivate tile naturally advances to next record
0479CA             0107*   @inactive_record:
0479CA             0108*   ; A valid inactive record violates the dense-stack invariant but is safe to
0479CA             0109*   ; remove. Keep IX on this slot so the shifted successor is checked next.
0479CA DD 22 12 73 0110*       ld (tile_stack_pointer),ix
       04          
0479CF CD 32 74 04 0111*       call table_deactivate_tile
0479D3 DD 2A 71 7A 0112*       ld ix,(@tile_stack_pointer)
       04          
0479D8 C3 49 79 04 0113*       jp @check_loop
0479DC             0114*   @bad_record:
0479DC             0115*   ; The slot itself was validated, so it can be quarantined without touching the
0479DC             0116*   ; malformed record pointer. Continue at the successor shifted into this slot.
0479DC 21 1F 73 04 0117*       ld hl,tile_fault_flags
0479E0 CB C6       0118*       set tile_fault_bad_record,(hl)
0479E2 DD 22 12 73 0119*       ld (tile_stack_pointer),ix
       04          
0479E7 CD 76 74 04 0120*       call tile_stack_quarantine_entry
0479EB DD 2A 71 7A 0121*       ld ix,(@tile_stack_pointer)
       04          
0479F0 C3 49 79 04 0122*       jp @check_loop
0479F4             0123*    ; get back stack pointer and loop
0479F4             0124*   @next_record:
0479F4 DD 2A 71 7A 0125*       ld ix,(@tile_stack_pointer)
       04          
0479F9 ED 32 03    0126*       lea ix,ix+3 ; next tile stack record
0479FC C3 49 79 04 0127*       jp @check_loop ; loop until we've checked all the records
047A00             0128*   @scan_done:
047A00             0129*   ; Rediscover the source cursor after any compaction. This search is bounded by
047A00             0130*   ; the current dense-stack count and validates each slot before loading it.
047A00 3A 18 73 04 0131*       ld a,(num_active_tiles)
047A04 32 7A 7A 04 0132*       ld (@tiles_remaining),a
047A08 FD 21 0F 70 0133*       ld iy,tile_stack
       04          
047A0D             0134*   @find_loop:
047A0D 3A 7A 7A 04 0135*       ld a,(@tiles_remaining)
047A11 B7          0136*       or a
047A12 CA 54 7A 04 0137*       jp z,@source_not_found
047A16 3D          0138*       dec a
047A17 32 7A 7A 04 0139*       ld (@tiles_remaining),a
047A1B FD E5       0140*       push iy
047A1D E1          0141*       pop hl
047A1E CD C3 73 04 0142*       call tile_stack_pointer_valid
047A22 D2 54 7A 04 0143*       jp nc,@source_not_found
047A26 FD 27 00    0144*       ld hl,(iy)
047A29 ED 33 03    0145*       lea iy,iy+3 ; next tile stack record
047A2C ED 5B 77 7A 0146*       ld de,(@source_tile_pointer)
       04          
047A31 B7          0147*       or a ; clear carry
047A32 ED 52       0148*       sbc hl,de ; if not the same address, loop
047A34 C2 0D 7A 04 0149*       jp nz,@find_loop
047A38 ED 33 FD    0150*       lea iy,iy-3 ; back up to the record we want
047A3B FD 22 12 73 0151*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
047A40 FD 37 00    0152*       ld iy,(iy) ; iy points to the tile stack record
047A43 CD FC 73 04 0153*       call tile_table_record_pointer_valid
047A47 D2 54 7A 04 0154*       jp nc,@source_not_found
047A4B FD 22 15 73 0155*       ld (tile_table_pointer),iy ; set pointer to this tile record
       04          
047A50 C3 A0 78 04 0156*       jp transform_active_tile_to_crater
