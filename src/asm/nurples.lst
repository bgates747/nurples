044451             0048        include "state_ids.inc"
044451             0001*   ; Stable numeric state/event ABI shared by runtime telemetry and the replacement
044451             0002*   ; state machine. These values are externally observable; do not renumber them.
044451             0003*   
044451             0004*   STATE_NEW_BOOT:                equ 0
044451             0005*   STATE_NEW_LOADING:             equ 1
044451             0006*   STATE_NEW_TITLE:               equ 2
044451             0007*   STATE_NEW_NEW_GAME:            equ 3
044451             0008*   STATE_NEW_LEVEL_ENTER:         equ 4
044451             0009*   STATE_NEW_COUNTDOWN:           equ 5
044451             0010*   STATE_NEW_PLAYING:             equ 6
044451             0011*   STATE_NEW_PAUSED:              equ 7
044451             0012*   STATE_NEW_LEVEL_TRANSITION:    equ 8
044451             0013*   STATE_NEW_RESPAWN:             equ 9
044451             0014*   STATE_NEW_GAME_OVER:           equ 10
044451             0015*   STATE_NEW_VICTORY:             equ 11
044451             0016*   STATE_NEW_EXIT:                equ 12
044451             0017*   STATE_NEW_FAULT:               equ 13
044451             0018*   STATE_NEW_COUNT:               equ 14
044451             0019*   STATE_NEW_NONE:                equ 255
044451             0020*   
044451             0021*   ; Legacy-only phases remain distinguishable while the pointer dispatcher is
044451             0022*   ; being retired. They are never valid replacement-coordinator table indices.
044451             0023*   STATE_LEGACY_CUTSCENE:         equ 128
044451             0024*   STATE_LEGACY_INVENTORY:        equ 129
044451             0025*   STATE_LEGACY_MAP:              equ 130
044451             0026*   
044451             0027*   STATE_NEW_EVENT_START:         equ %00000001
044451             0028*   STATE_NEW_EVENT_LOAD_COMPLETE: equ %00000010
044451             0029*   STATE_NEW_EVENT_PAUSE:         equ %00000100
044451             0030*   STATE_NEW_EVENT_LEVEL_COMPLETE:equ %00001000
044451             0031*   STATE_NEW_EVENT_PLAYER_DEAD:   equ %00010000
044451             0032*   STATE_NEW_EVENT_NO_LIVES:      equ %00100000
044451             0033*   STATE_NEW_EVENT_VICTORY:       equ %01000000
044451             0034*   STATE_NEW_EVENT_QUIT:          equ %10000000
044451             0035*   
044451             0036*   STATE_NEW_POLICY_INPUT:        equ %00000001
044451             0037*   STATE_NEW_POLICY_ACTOR_UPDATE: equ %00000010
044451             0038*   STATE_NEW_POLICY_ACTOR_RENDER: equ %00000100
044451             0039*   STATE_NEW_POLICY_WORLD_UPDATE: equ %00001000
044451             0040*   STATE_NEW_POLICY_WORLD_RENDER: equ %00010000
044451             0041*   STATE_NEW_POLICY_STATE_RENDER: equ %00100000
044451             0042*   
044451             0043*   STATE_NEW_PLAYER_INACTIVE:     equ 0
044451             0044*   STATE_NEW_PLAYER_READY:        equ 1
044451             0045*   STATE_NEW_PLAYER_ACTIVE:       equ 2
044451             0046*   STATE_NEW_PLAYER_DYING:        equ 3
044451             0047*   STATE_NEW_PLAYER_DEAD:         equ 4
044451             0048*   STATE_NEW_PLAYER_COUNT:        equ 5
044451             0049*   
044451             0050*   STATE_TELEMETRY_ENEMY_INACTIVE:   equ 0
044451             0051*   STATE_TELEMETRY_ENEMY_ACTIVE:     equ 1
044451             0052*   STATE_TELEMETRY_ENEMY_DESPAWNING: equ 2
044451             0053*   STATE_TELEMETRY_ENEMY_DEAD:       equ 3
044451             0054*   STATE_TELEMETRY_ENEMY_RESPAWNING: equ 4
044451             0055*   STATE_TELEMETRY_ENEMY_COUNT:      equ 5
