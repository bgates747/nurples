0464F8 00          0026*   laser_power_last: db 0 ; integer
0464F9 40          0027*   laser_power_max: db 64 ; integer
0464FA 04          0028*   laser_power_per_shot: db 4 ; integer
0464FB 00          0029*   charge_laser_timer: db 0
0464FC 06          0030*   charge_laser_timer_max: db 6
