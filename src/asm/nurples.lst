047E9B             0001*   laser_defaults:
047E9B 06          0002*       db player_air        ; type
047E9C 4E 01 00    0003*       dl BUF_LASER_A	    ; base_bufferId
047E9F 8C 7F 04    0004*       dl move_player_laser	; move_program
047EA2 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
047EA3 05          0006*       db 5	                ; dim_x
047EA4 0D          0007*       db 13                   ; dim_y
047EA5 01          0008*       db 1                    ; num_orientations
047EA6 02          0009*       db 2                    ; num_animations
047EA7 00          0010*       db 0	                ; animation
047EA8 02          0011*       db laser_animation_timer_reset ; animation_timer
047EA9 00          0012*       db 0	                ; move_timer
047EAA 00          0013*       db 0	                ; move_step
047EAB 00          0014*       db 0	                ; points
047EAC 00          0015*       db 0	                ; shield_damage
047EAD 00          0016*       db 0                    ; frame
047EAE             0017*   
