047320             0046*   tile_table_init:
047320             0047*   ; reset num active tiles
047320 21 00 00 00 0048*       ld hl,0
047324 22 18 73 04 0049*       ld (num_active_tiles),hl
047328             0050*   ; reset next tile id
047328 AF          0051*       xor a
047329 32 1B 73 04 0052*       ld (next_tile_id),a
04732D 32 1F 73 04 0053*       ld (tile_fault_flags),a
047331             0054*   ; clear the tile stack
047331 AF          0055*       xor a ; write zeroes to tile stack
047332 21 0F 70 04 0056*       ld hl,tile_stack
047336 01 03 03 00 0057*       ld bc,tile_stack_end-tile_stack
04733A CD 5B 03 04 0058*       call clear_mem
04733E             0059*   ; clear the tile table
04733E AF          0060*       xor a ; write zeroes to tile table
04733F 21 F3 8B 04 0061*       ld hl,tile_table_base ; address to copy from
047343 01 00 40 00 0062*       ld bc,tile_table_end-tile_table_base ; number of bytes to clear
047347 CD 5B 03 04 0063*       call clear_mem
04734B             0064*   ; write tile ids
04734B DD 21 F3 8B 0065*       ld ix,tile_table_base
       04          
047350 AF          0066*       xor a ; tile id
047351 06 00       0067*       ld b,0 ; loop counter
047353             0068*   @loop:
047353 DD 77 00    0069*       ld (ix+tile_id),a
047356 ED 32 40    0070*       lea ix,ix+table_record_size
047359 3C          0071*       inc a
04735A 10 F7       0072*       djnz @loop
04735C             0073*   ; set pointers to top of tile stack and tile table
04735C 21 1B 73 04 0074*       ld hl,next_tile_id
047360 3E FF       0075*       ld a,255 ; will wrap around to 0 on first call to create active tile
047362 77          0076*       ld (hl),a
047363 21 F3 8B 04 0077*       ld hl,tile_table_base
047367 22 15 73 04 0078*       ld (tile_table_pointer),hl
04736B 21 0F 70 04 0079*       ld hl,tile_stack
04736F 22 12 73 04 0080*       ld (tile_stack_pointer),hl
047373 C9          0081*       ret
047374             0082*   ; end tile_table_init
047374             0083*   
047374             0084*   ; gets the next available tile id
047374             0085*   ; inputs; none
047374             0086*   ; returns: if new tile available, a = tile id, ix pointing to new tile vars, carry set
047374             0087*   ;      otherwise, a = 0, carry flag reset, ix invalid and must not be dereferenced
047374             0088*   ; destroys: a,b,de,hl,ix
047374             0089*   ; affects: on success, bumps num_active_tiles by one, adds a tile pointer to the top of the tile stack
047374             0090*   tile_table_get_next_id:
047374             0091*   ; The byte-sized active count deliberately caps the dense stack at 255 entries.
047374 3A 18 73 04 0092*       ld a,(num_active_tiles)
047378 3C          0093*       inc a
047379 CA 9E 73 04 0094*       jp z,@not_found
04737D             0095*   ; Search the entire ring rather than assuming the next physical record is free.
04737D 06 00       0096*       ld b,0 ; DJNZ with zero visits all 256 tile records
04737F 3A 1B 73 04 0097*       ld a,(next_tile_id)
047383             0098*   @search:
047383 3C          0099*       inc a
047384 11 00 00 00 0100*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
047388 57          0101*       ld d,a ; candidate index into tile table
047389 1E 40       0102*       ld e,tile_table_record_size
04738B ED 5C       0103*       mlt de ; de is now the offset to the table entry
04738D DD 21 F3 8B 0104*       ld ix,tile_table_base ; point to base address of tile table
       04          
047392 DD 19       0105*       add ix,de ; ix is now the address of the table entry
047394 DD CB 1D 76 0106*       bit sprite_alive,(ix+tile_collisions)
047398 CA A0 73 04 0107*       jp z,@found
04739C 10 E5       0108*       djnz @search
04739E             0109*   @not_found:
04739E AF          0110*       xor a ; reset carry flag indicating that we didn't find a free tile
04739F C9          0111*       ret
0473A0             0112*   @found:
0473A0 32 1B 73 04 0113*       ld (next_tile_id),a
0473A4 DD 77 00    0114*       ld (ix+tile_id),a ; repair the stable identity byte before publishing it
0473A7 21 18 73 04 0115*       ld hl,num_active_tiles
0473AB 34          0116*       inc (hl)
0473AC 7E          0117*       ld a,(hl) ; number of active tiles
0473AD             0118*   ; add tile pointer to tile stack
0473AD 21 0F 70 04 0119*       ld hl,tile_stack
0473B1 11 00 00 00 0120*       ld de,0 ; keep the second pointer offset independently width-safe
0473B5 57          0121*       ld d,a ; number of active tiles
0473B6 15          0122*       dec d ; zero-based index
0473B7 1E 03       0123*       ld e,3 ; three bytes per tile record
0473B9 ED 5C       0124*       mlt de ; offset into tile stack
0473BB 19          0125*       add hl,de ; hl points to top of the active tiles
0473BC ED 3F       0126*       ld (hl),ix
0473BE             0127*   ; return tile id
0473BE DD 7E 00    0128*       ld a,(ix+tile_id)
0473C1 37          0129*       scf ; sets carry flag indicating we found a free tile
0473C2 C9          0130*       ret ; done
0473C3             0131*   ; end tile_table_get_next_id
0473C3             0132*   
0473C3             0133*   ; Validate an address into the dense tile-stack entries currently in use.
0473C3             0134*   ; inputs: hl = candidate tile-stack address
0473C3             0135*   ; outputs: carry set for an aligned slot in the active dense-stack range
0473C3             0136*   ; destroys: a,de,hl
0473C3             0137*   tile_stack_pointer_valid:
0473C3 11 0F 70 04 0138*       ld de,tile_stack
0473C7 B7          0139*       or a
0473C8 ED 52       0140*       sbc hl,de
0473CA DA FA 73 04 0141*       jp c,@invalid
0473CE 3A 18 73 04 0142*       ld a,(num_active_tiles)
0473D2 B7          0143*       or a
0473D3 CA FA 73 04 0144*       jp z,@invalid
0473D7 11 00 00 00 0145*       ld de,0
0473DB 57          0146*       ld d,a
0473DC 1E 03       0147*       ld e,3
0473DE ED 5C       0148*       mlt de
0473E0 B7          0149*       or a
0473E1 ED 52       0150*       sbc hl,de
0473E3 D2 FA 73 04 0151*       jp nc,@invalid
0473E7 19          0152*       add hl,de ; restore the in-range offset
0473E8             0153*   ; For offsets below 768, divisibility by three can be tested without a loop.
0473E8             0154*   ; 256 == 1 (mod 3), and multiplication by 171 maps byte multiples of three
0473E8             0155*   ; into 0..85 while every non-multiple maps into 86..255.
0473E8 7C          0156*       ld a,h
0473E9 85          0157*       add a,l
0473EA CE 00       0158*       adc a,0
0473EC 57          0159*       ld d,a
0473ED 1E AB       0160*       ld e,171
0473EF ED 5C       0161*       mlt de
0473F1 7B          0162*       ld a,e
0473F2 FE 56       0163*       cp 86
0473F4 D2 FA 73 04 0164*       jp nc,@invalid
0473F8 37          0165*       scf
0473F9 C9          0166*       ret
0473FA             0167*   @invalid:
0473FA AF          0168*       xor a
0473FB C9          0169*       ret
0473FC             0170*   ; end tile_stack_pointer_valid
0473FC             0171*   
0473FC             0172*   ; Validate a 64-byte-aligned pointer into the active-tile record table.
0473FC             0173*   ; inputs: iy = candidate tile record
0473FC             0174*   ; outputs: carry set only for an aligned in-range record pointer
0473FC             0175*   ; destroys: a,de,hl
0473FC             0176*   tile_table_record_pointer_valid:
0473FC FD E5       0177*       push iy
0473FE E1          0178*       pop hl
0473FF 11 F3 8B 04 0179*       ld de,tile_table_base
047403 B7          0180*       or a
047404 ED 52       0181*       sbc hl,de ; offset from the tile-table base
047406 DA 30 74 04 0182*       jp c,@invalid
04740A 11 00 40 00 0183*       ld de,tile_table_end-tile_table_base
04740E B7          0184*       or a
04740F ED 52       0185*       sbc hl,de
047411 D2 30 74 04 0186*       jp nc,@invalid
047415 19          0187*       add hl,de ; restore the in-range offset
047416 7D          0188*       ld a,l
047417 E6 3F       0189*       and tile_table_record_size-1
047419 C2 30 74 04 0190*       jp nz,@invalid
04741D             0191*   ; Convert the aligned offset to its stable record id: H*4 + L/64.
04741D 7C          0192*       ld a,h
04741E 87          0193*       add a,a
04741F 87          0194*       add a,a
047420 57          0195*       ld d,a
047421 7D          0196*       ld a,l
047422 07          0197*       rlca
047423 07          0198*       rlca
047424 E6 03       0199*       and %00000011
047426 B2          0200*       or d
047427 FD BE 00    0201*       cp (iy+tile_id)
04742A C2 30 74 04 0202*       jp nz,@invalid
04742E 37          0203*       scf
04742F C9          0204*       ret
047430             0205*   @invalid:
047430 AF          0206*       xor a
047431 C9          0207*       ret
047432             0208*   ; end tile_table_record_pointer_valid
