049163             0059*   ; Exact stabilization whitelist for writable legacy tile callbacks.
049163             0060*   ; inputs: iy = validated tile record, hl = stored callback
049163             0061*   ; outputs: carry set and hl = expected callback on an exact type/program match
049163             0062*   ; destroys: a,de,hl
049163             0063*   tile_move_program_valid:
049163 FD 7E 16    0064*       ld a,(iy+tile_type)
049166 FE 01       0065*       cp tile_pad_small
049168 CA 88 91 04 0066*       jp z,@pad_small
04916C FE 05       0067*       cp tile_turret_fireball
04916E CA 90 91 04 0068*       jp z,@turret_fireball
049172 FE 09       0069*       cp tile_electrode
049174 CA 98 91 04 0070*       jp z,@electrode
049178 FE 0A       0071*       cp tile_lightning
04917A CA A0 91 04 0072*       jp z,@lightning
04917E FE 10       0073*       cp tile_crater
049180 CA A8 91 04 0074*       jp z,@crater
049184 C3 B7 91 04 0075*       jp @invalid
049188             0076*   @pad_small:
049188 11 2A 95 04 0077*       ld de,move_pad_small
04918C C3 AC 91 04 0078*       jp @compare
049190             0079*   @turret_fireball:
049190 11 9F 95 04 0080*       ld de,move_turret_fireball
049194 C3 AC 91 04 0081*       jp @compare
049198             0082*   @electrode:
049198 11 26 93 04 0083*       ld de,move_electrode
04919C C3 AC 91 04 0084*       jp @compare
0491A0             0085*   @lightning:
0491A0 11 C8 94 04 0086*       ld de,move_lightning
0491A4 C3 AC 91 04 0087*       jp @compare
0491A8             0088*   @crater:
0491A8 11 D8 92 04 0089*       ld de,move_crater
0491AC             0090*   @compare:
0491AC B7          0091*       or a
0491AD ED 52       0092*       sbc hl,de
0491AF C2 B7 91 04 0093*       jp nz,@invalid
0491B3 D5          0094*       push de
0491B4 E1          0095*       pop hl ; publish the fixed expected address, not writable record data
0491B5 37          0096*       scf
0491B6 C9          0097*       ret
0491B7             0098*   @invalid:
0491B7 AF          0099*       xor a
0491B8 C9          0100*       ret
0491B9             0101*   ; end tile_move_program_valid
