04643F             0064        include "player_input.inc"
04643F             0001*   ; UART ports for reading joystick input
04643F             0002*   ; bit tests: 0 means actuated, 1 means not actuated
04643F             0003*   portC: 	EQU 	$9E ; reads dpad input
04643F             0004*   joy1_u: equ 1
04643F             0005*   joy1_d: equ 3
04643F             0006*   joy1_l: equ 5
04643F             0007*   joy1_r: equ 7
04643F             0008*   portD: 	EQU 	$A2 ; reads buttons
04643F             0009*   btn1_a: equ 5
04643F             0010*   
04643F             0011*   ; process player keyboard input, set player bitmap
04643F             0012*   ; velocities and draw player bitmap at updated coordinates
04643F             0013*   ; Inputs: player_x/y set at desired position
04643F             0014*   ; Returns: player bitmap drawn at updated position
04643F             0015*   ; Destroys: probably everything except maybe iy
04643F             0016*   ; NOTE: in mode 9 we draw the ship as a sprite, not a bitmap
04643F             0017*   ; TODO: requires sprite implementation
04643F             0018*   player_input:
04643F             0019*   ; point to player sprite record
04643F FD 21 86 88 0020*       ld iy,player_begin
       04          
046444 FD 22 07 67 0021*       ld (table_pointer),iy
       04          
046449             0022*   ; reset player component velocities to zero as the default
046449 21 00 00 00 0023*       ld hl,0
04644D FD 2F 07    0024*       ld (iy+sprite_xvel),hl
046450 FD 2F 0A    0025*       ld (iy+sprite_yvel),hl
046453             0026*   ; make ship the active sprite
046453 FD 7E 00    0027*       ld a,(iy+sprite_id)
046456 CD BB 19 04 0028*       call vdu_sprite_select
04645A             0029*   ; check for keypresses and branch accordingly
04645A             0030*       MOSCALL    mos_getkbmap ;ix = pointer to MOS virtual keys table
                       M1 Args: function=mos_getkbmap 
04645A 3E 1E       0001*M1 			LD	A, function
04645C 5B CF       0002*M1 			RST.LIL	08h
04645E             0031*   ; do player directional input
04645E AF          0032*       xor a ; clear flags
04645F DB 9E       0033*       in a,(portC) ; read dpad input
046461 57          0034*       ld d,a ; save dpad input
046462 3E 01       0035*       ld a,1 ; set ship's default animation to center
046464             0036*   ; 26 Left: move player left
046464 DD CB 03 4E 0037*       bit 1,(ix+3)
046468 C2 76 64 04 0038*       jp nz,@F
04646C             0039*   ; test dpad left
04646C CB 6A       0040*       bit joy1_l,d
04646E CA 76 64 04 0041*       jp z,@F
046472 C3 82 64 04 0042*       jp @right
046476             0043*   @@:
046476 FD 27 07    0044*       ld hl,(iy+sprite_xvel)
046479 01 00 FD FF 0045*       ld bc,-player_speed
04647D 09          0046*       add hl,bc
04647E FD 2F 07    0047*       ld (iy+sprite_xvel),hl
046481 3D          0048*       dec a ; set ship's animation to left
046482             0049*   @right:
046482             0050*   ; 122 Right: move player right
046482 DD CB 0F 4E 0051*       bit 1,(ix+15)
046486 C2 94 64 04 0052*       jp nz,@F
04648A             0053*   ; test dpad right
04648A CB 7A       0054*       bit joy1_r,d
04648C CA 94 64 04 0055*       jp z,@F
046490 C3 A0 64 04 0056*       jp @up
046494             0057*   @@:
046494 FD 27 07    0058*       ld hl,(iy+sprite_xvel)
046497 01 00 03 00 0059*       ld bc,player_speed
04649B 09          0060*       add hl,bc
04649C FD 2F 07    0061*       ld (iy+sprite_xvel),hl
04649F 3C          0062*       inc a ; set ship's animation to right
0464A0             0063*   @up:
0464A0             0064*   ; 58 Up: move player up
0464A0 DD CB 07 4E 0065*       bit 1,(ix+7)
0464A4 C2 B2 64 04 0066*       jp nz,@F
0464A8             0067*   ; test dpad up
0464A8 CB 4A       0068*       bit joy1_u,d
0464AA CA B2 64 04 0069*       jp z,@F
0464AE C3 BD 64 04 0070*       jp @dn
0464B2             0071*   @@:
0464B2 FD 27 0A    0072*       ld hl,(iy+sprite_yvel)
0464B5 01 00 FD FF 0073*       ld bc,-player_speed
0464B9 09          0074*       add hl,bc
0464BA FD 2F 0A    0075*       ld (iy+sprite_yvel),hl
0464BD             0076*   @dn:
0464BD             0077*   ; 42 Down: move player down
0464BD DD CB 05 4E 0078*       bit 1,(ix+5)
0464C1 C2 CF 64 04 0079*       jp nz,@F
0464C5             0080*   ; test dpad down
0464C5 CB 5A       0081*       bit joy1_d,d
0464C7 CA CF 64 04 0082*       jp z,@F
0464CB C3 DA 64 04 0083*       jp @frame
0464CF             0084*   @@:
0464CF FD 27 0A    0085*       ld hl,(iy+sprite_yvel)
0464D2 01 00 03 00 0086*       ld bc,player_speed
0464D6 09          0087*       add hl,bc
0464D7 FD 2F 0A    0088*       ld (iy+sprite_yvel),hl
0464DA             0089*   @frame:
0464DA             0090*   ; a should land here loaded with the correct frame
0464DA CD 1E 1A 04 0091*       call vdu_sprite_select_frame
0464DE             0092*   ; draw player at updated position
0464DE FD 21 86 88 0093*       ld iy,player_begin
       04          
0464E3 FD 22 07 67 0094*       ld (table_pointer),iy
       04          
0464E8 CD 0D 6A 04 0095*       call move_sprite
0464EC FD 07 01    0096*       ld bc,(iy+sprite_x)
0464EF FD 17 04    0097*       ld de,(iy+sprite_y)
0464F2 CD 87 1A 04 0098*       call vdu_sprite_move_abs168
0464F6             0099*   
0464F6             0100*   ; process player laser fire
0464F6             0101*   ; do player fire button input
0464F6             0102*   ; read joystick fire button
0464F6 AF          0103*       xor a ; clear flags
0464F7 DB A2       0104*       in a,(portD) ; read joypad fire button input
0464F9 CB 6F       0105*       bit btn1_a,a
0464FB CA 99 65 04 0106*       jp z,player_spawn_laser
0464FF             0107*   ; 99 Space: fire main weapon
0464FF DD CB 0C 56 0108*       bit 2,(ix+12)
046503 C2 99 65 04 0109*       jp nz,player_spawn_laser
046507             0110*   ; no fire button pressed so go home
046507 C9          0111*       ret
046508             0112*   ; end player_input
