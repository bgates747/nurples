040FE9             0013*   img_load_init:
040FE9             0014*   ; initialize logo's position parameters
040FE9 21 00 00 00 0015*       ld hl,0
040FED 22 9E 10 04 0016*       ld (logo_xvel),hl
040FF1 22 A1 10 04 0017*       ld (logo_xpos),hl
040FF5             0018*   ; begin 16.8 maths to determine logo's y position and velocity
040FF5 21 00 E0 00 0019*       ld hl,224*256
040FF9 22 A7 10 04 0020*       ld (logo_ypos),hl
040FFD EB          0021*       ex de,hl
040FFE 21 00 28 FF 0022*       ld hl,-240+24*256
041002             0023*       ; ld de,-256*[sprites_num_images+tiles_dg_num_images+ui_num_images]
041002 11 00 88 01 0024*       ld de,[sprites_num_images+tiles_dg_num_images+ui_num_images]*256
041006 CD 75 06 04 0025*       call sdiv168 ; ud.e = distance / num images = y velocity
04100A ED 53 A4 10 0026*       ld (logo_yvel),de
       04          
04100F             0027*   ; all done
04100F C9          0028*       ret
041010             0029*   
041010             0030*   ; inputs: bc is the number of images to load, cur_image_list set
041010             0031*   img_load_main:
