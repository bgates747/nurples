047BE8 3A 66 7B 04 0096*       ld a,(laser_power)
047BEC 21 69 7B 04 0097*       ld hl,laser_power_per_shot
047BF0 96          0098*       sub (hl) ; units of power per laser shot
047BF1 D8          0099*       ret c ; not enough power to fire
047BF2             0100*   ; update power to reflect firing
047BF2 32 66 7B 04 0101*       ld (laser_power),a
047BF6             0102*   ; reset timer
047BF6 2A 63 7B 04 0103*       ld hl,(tmr_laser_reset)
047BFA CD A8 12 04 0104*       call timestamp_tmr_set
047BFE             0105*   ; fire the laser
047BFE DD 21 87 9C 0106*       ld ix,player_weapons_begin
       04          
