04897D 85          0157*       add a,l
04897E CE 00       0158*       adc a,0
048980 57          0159*       ld d,a
048981 1E AB       0160*       ld e,171
048983 ED 5C       0161*       mlt de
048985 7B          0162*       ld a,e
048986 FE 56       0163*       cp 86
048988 D2 8E 89 04 0164*       jp nc,@invalid
04898C 37          0165*       scf
04898D C9          0166*       ret
04898E             0167*   @invalid:
04898E AF          0168*       xor a
04898F C9          0169*       ret
048990             0170*   ; end tile_stack_pointer_valid
048990             0171*   
048990             0172*   ; Validate a 64-byte-aligned pointer into the active-tile record table.
048990             0173*   ; inputs: iy = candidate tile record
