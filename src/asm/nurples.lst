04127E             0262*   ; ===============================================
04127E             0263*   ; Timer functions
04127E             0264*   ; -----------------------------------------------
04127E             0265*   ; set a countdown timer
04127E             0266*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
04127E             0267*   ; returns: hl = current time
04127E             0268*   tmr_set:
04127E FD 2F 03    0269*       ld (iy+3),hl            ; set time remaining
041281             0270*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041281 3E 08       0001*M1 			LD	A, function
041283 5B CF       0002*M1 			RST.LIL	08h
041285 DD 27 00    0271*       ld hl,(ix+sysvar_time)  ; get current time
041288 FD 2F 00    0272*       ld (iy+0),hl            ; set start time
04128B C9          0273*       ret
04128C             0274*   
04128C             0275*   ; gets time remaining on a countdown timer
04128C             0276*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
04128C             0277*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
04128C             0278*   ;          sign flags: pos = time not expired,zero or neg = time expired
04128C             0279*   tmr_get:
04128C             0280*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04128C 3E 08       0001*M1 			LD	A, function
04128E 5B CF       0002*M1 			RST.LIL	08h
041290 DD 17 00    0281*       ld de,(ix+sysvar_time)  ; get current time
041293 FD 27 00    0282*       ld hl,(iy+0)            ; get start time
041296 AF          0283*       xor a                   ; clear carry
041297 ED 52       0284*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
041299 FD 17 03    0285*       ld de,(iy+3)            ; get timer set value
04129C AF          0286*       xor a                   ; clear carry
04129D ED 5A       0287*       adc hl,de               ; hl = time remaining
04129F             0288*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
04129F C9          0289*       ret
0412A0             0290*   
0412A0             0291*   tmr_test: ds 6 ; example of a buffer to hold timer data
0412A6             0292*   
       FF FF FF FF 
       FF FF 
0412A6 00 00 00    0293*   timestamp_now: dl 0
0412A9 00 00 00    0294*   timestamp_old: dl 0
0412AC 00 00 00    0295*   timestamp_chg: dl 0
0412AF             0296*   
0412AF             0297*   ; Establish a restart-safe baseline before the first timestamp_tick. Without
0412AF             0298*   ; this, a second MOS RUN computes its first delta from the prior invocation.
0412AF             0299*   timestamp_init:
0412AF             0300*       MOSCALL mos_sysvars
                       M1 Args: function=mos_sysvars 
0412AF 3E 08       0001*M1 			LD	A, function
0412B1 5B CF       0002*M1 			RST.LIL	08h
0412B3 DD 27 00    0301*       ld hl,(ix+sysvar_time)
0412B6 22 A6 12 04 0302*       ld (timestamp_now),hl
0412BA 22 A9 12 04 0303*       ld (timestamp_old),hl
0412BE 21 00 00 00 0304*       ld hl,0
0412C2 22 AC 12 04 0305*       ld (timestamp_chg),hl
0412C6 C9          0306*       ret
0412C7             0307*   ; end timestamp_init
0412C7             0308*   
0412C7             0309*   ; update the global timestamp from the system clock
0412C7             0310*   ; inputs: none
0412C7             0311*   ; returns: hl = time elapsed in 1/120ths of a second
0412C7             0312*   ;          de = current time
0412C7             0313*   ;          ix = pointer to syvars table
0412C7             0314*   ; destroys: af,hl,de,ix
0412C7             0315*   timestamp_tick:
0412C7 ED 5B A6 12 0316*       ld de,(timestamp_now)   ; get previous time
       04          
0412CC ED 53 A9 12 0317*       ld (timestamp_old),de   ; save previous time
       04          
0412D1             0318*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0412D1 3E 08       0001*M1 			LD	A, function
0412D3 5B CF       0002*M1 			RST.LIL	08h
0412D5 DD 27 00    0319*       ld hl,(ix+sysvar_time)  ; get current time
0412D8 22 A6 12 04 0320*       ld (timestamp_now),hl   ; save current time
0412DC AF          0321*       xor a                   ; clear carry
0412DD ED 52       0322*       sbc hl,de               ; hl = time elapsed
0412DF 22 AC 12 04 0323*       ld (timestamp_chg),hl   ; save elapsed time
0412E3 C9          0324*       ret
0412E4             0325*   
0412E4             0326*   ; set a countdown timer
0412E4             0327*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412E4             0328*   ; requires: timestamp_tick to be called at least once before this function
0412E4             0329*   ; returns: hl = current time
0412E4             0330*   ; destroys: hl
0412E4             0331*   timestamp_tmr_set:
0412E4 FD 2F 03    0332*       ld (iy+3),hl            ; set time remaining
0412E7 2A A6 12 04 0333*       ld hl,(timestamp_now)   ; get current timestamp
0412EB FD 2F 00    0334*       ld (iy+0),hl            ; set start time
0412EE C9          0335*       ret
0412EF             0336*   
0412EF             0337*   ; gets time remaining on a countdown timer following the global timestamp
0412EF             0338*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412EF             0339*   ; requires: timestamp_tick to be called at least once before this function
0412EF             0340*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
0412EF             0341*   ;          sign flags: pos = time not expired,zero or neg = time expired
0412EF             0342*   ; destroys: af,hl,de
0412EF             0343*   timestamp_tmr_get:
0412EF ED 5B A6 12 0344*       ld de,(timestamp_now)   ; get current timestamp
       04          
0412F4 FD 27 00    0345*       ld hl,(iy+0)            ; get start time
0412F7 AF          0346*       xor a                   ; clear carry
0412F8 ED 52       0347*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
0412FA FD 17 03    0348*       ld de,(iy+3)            ; get timer set value
0412FD AF          0349*       xor a                   ; clear carry
0412FE ED 5A       0350*       adc hl,de               ; hl = time remaining
041300             0351*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
041300 C9          0352*       ret
041301             0353*   
041301             0354*   ; set a stopwatch
041301             0355*   ; returns: hl = start time
041301             0356*   ; destroys: hl,ix
041301             0357*   stopwatch_set:
041301             0358*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041301 3E 08       0001*M1 			LD	A, function
041303 5B CF       0002*M1 			RST.LIL	08h
041305 DD 27 00    0359*       ld hl,(ix+sysvar_time)  ; get current time
041308 22 1D 13 04 0360*       ld (stopwatch_started),hl            ; set start time
04130C C9          0361*       ret
04130D             0362*   
04130D             0363*   ; gets time elapsed on a stopwatch
04130D             0364*   ; returns: hl = time elapsed in 1/120ths of a second
04130D             0365*   ; destroys: af,hl,de,ix
04130D             0366*   stopwatch_get:
04130D             0367*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04130D 3E 08       0001*M1 			LD	A, function
04130F 5B CF       0002*M1 			RST.LIL	08h
041311 DD 27 00    0368*       ld hl,(ix+sysvar_time)  ; get current time
041314 ED 5B 1D 13 0369*       ld de,(stopwatch_started)            ; get start time
       04          
041319 AF          0370*       xor a                   ; clear carry
04131A ED 52       0371*       sbc hl,de               ; hl = time elapsed (will always be zero or positive)
04131C C9          0372*       ret
04131D             0373*   
04131D             0374*   stopwatch_started: ds 3 ; buffer to hold stopwatch start time
041320             0375*   
041320             0376*   ; ------------------
041320             0377*   ; delay routine
041320             0378*   ; Author: Richard Turrnidge
041320             0379*   ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.asm
041320             0380*   ; routine waits a fixed time,then returns
041320             0381*   ; arrive with A =  the delay byte. One bit to be set only.
041320             0382*   ; eg. ld A,00000100b
041320             0383*   
041320             0384*   multiPurposeDelay:
       FF FF FF 
041320 F5          0385*       push af
041321 C5          0386*       push bc
041322 D5          0387*       push de
041323 DD E5       0388*       push ix
041325 5F          0389*       ld e,a ; timestamp bit mask
041326 3E 20       0390*       ld a,32
041328 32 79 13 04 0391*       ld (multiPurposeDelay_timeout_outer),a
04132C 06 00       0392*       ld b,0
04132E 16 00       0393*       ld d,0
041330 3E 08       0394*       ld a,$08
041332 5B CF       0395*       RST.LIL	08h                 ; get IX pointer to sysvars
041334             0396*   
041334             0397*   ; oldTimeStamp is per-call scratch, not persistent process state. Seed it from
041334             0398*   ; the requested clock bit so every call waits for a real transition.
041334 DD 7E 00    0399*       ld a,(ix + 0)
041337 A3          0400*       and e
041338 32 78 13 04 0401*       ld (oldTimeStamp),a
04133C             0402*   
04133C             0403*   waitLoop:
04133C             0404*   
04133C DD 7E 00    0405*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
04133F             0406*   
04133F             0407*                                   ;   we check if bit set is same as last time we checked.
04133F             0408*                                   ;   bit 0 - don't use
04133F             0409*                                   ;   bit 1 - changes 64 times per second
04133F             0410*                                   ;   bit 2 - changes 32 times per second
04133F             0411*                                   ;   bit 3 - changes 16 times per second
04133F             0412*   
04133F             0413*                                   ;   bit 4 - changes 8 times per second
04133F             0414*                                   ;   bit 5 - changes 4 times per second
04133F             0415*                                   ;   bit 6 - changes 2 times per second
04133F             0416*                                   ;   bit 7 - changes 1 times per second
04133F A3          0417*       and e
041340 4F          0418*       ld c,a
041341 3A 78 13 04 0419*       ld a,(oldTimeStamp)
041345 B9          0420*       cp c                        ; is A same as last value?
041346 C2 6C 13 04 0421*       jp nz,@changed
04134A             0422*   ; Bound a stalled MOS clock to 32 * 65,536 polls.
04134A 15          0423*       dec d
04134B C2 3C 13 04 0424*       jp nz,waitLoop
04134F 10 EB       0425*       djnz waitLoop
041351 3A 79 13 04 0426*       ld a,(multiPurposeDelay_timeout_outer)
041355 3D          0427*       dec a
041356 32 79 13 04 0428*       ld (multiPurposeDelay_timeout_outer),a
04135A C2 3C 13 04 0429*       jp nz,waitLoop
04135E 3A 77 13 04 0430*       ld a,(timer_fault_flags)
041362 F6 01       0431*       or %00000001
041364 32 77 13 04 0432*       ld (timer_fault_flags),a
041368 C3 71 13 04 0433*       jp @done
04136C             0434*   @changed:
04136C 79          0435*       ld a,c
04136D 32 78 13 04 0436*       ld (oldTimeStamp),a        ; set new value
041371             0437*   
041371             0438*   @done:
041371 DD E1       0439*       pop ix
041373 D1          0440*       pop de
041374 C1          0441*       pop bc
041375 F1          0442*       pop af
041376 C9          0443*       ret
041377             0444*   
041377             0445*   timer_fault_delay_timeout: equ 0
041377 00          0446*   timer_fault_flags: db 0
041378 00          0447*   oldTimeStamp: .db 00h
041379 00          0448*   multiPurposeDelay_timeout_outer: db 0
