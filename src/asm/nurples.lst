0407F1 E1          0476*       pop hl
0407F2 CD 6C 04 04 0477*       call hlu_abs ; if x was negative this also sets the sign flag
0407F6 E5          0478*       push hl ; store abs(x)
0407F7 C1          0479*       pop bc ; bc = abs(x)
