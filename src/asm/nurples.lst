048F97 01          0008*       db 1                    ; num_orientations
048F98 01          0009*       db 1                    ; num_animations
048F99 00          0010*       db 0                    ; animation
048F9A 10          0011*       db 16                   ; animation_timer
048F9B 00          0012*       db 0                    ; move_timer
048F9C 00          0013*       db 0                    ; move_step
048F9D 05          0014*       db 5                    ; points
048F9E 00          0015*       db 0                    ; shield_damage
048F9F 00          0016*       db 0                    ; frame
048FA0             0017*   
048FA0             0018*   activate_pad_small:
048FA0 21 8D 8F 04 0019*       ld hl,pad_small_defaults
