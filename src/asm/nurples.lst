047F2F C1          0068*   	pop bc
047F30 10 F5       0069*   	djnz @frames_loop
047F32 D1          0070*       pop de ; sprite loop counter
047F33 F1          0071*       pop af ; sprite id
047F34 3C          0072*       inc a
047F35 1D          0073*       dec e
047F36 C2 17 7F 04 0074*       jp nz,@sprites_loop
047F3A             0075*   ; set laser firing timer to zero
047F3A FD 21 D3 7E 0076*       ld iy,tmr_laser
       04          
047F3F 21 00 00 00 0077*       ld hl,0
