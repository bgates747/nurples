0467BC             0001*   ; sprite_type
0467BC             0002*   enemy_dead: equ 0
0467BC             0003*   enemy_air: equ 1
0467BC             0004*   enemy_ground: equ 2
0467BC             0005*   enemy_projectile: equ 3
0467BC             0006*   explosion: equ 4
0467BC             0007*   player: equ 5
0467BC             0008*   player_air: equ 6
0467BC             0009*   player_ground: equ 7
0467BC             0010*   
0467BC             0011*   ; ###### SPRITE TABLE FIELD INDICES ######
0467BC             0012*   table_record_size:         equ  64; bytes per sprite record
0467BC             0013*   sprite_id:                 equ   0; 1 bytes ;unique spriteId, zero-based
0467BC             0014*   ; sprite state variables
0467BC             0015*   sprite_state_variables:    equ   1; beginning of sprite state variables
0467BC             0016*   sprite_x:                  equ   1; 3 bytes ;16.8 fractional x position in pixels
0467BC             0017*   sprite_y:                  equ   4; 3 bytes ;16.8 fractional y position in pixels
0467BC             0018*   sprite_xvel:               equ   7; 3 bytes ;x-component velocity, 16.8 fixed, pixels
0467BC             0019*   sprite_yvel:               equ  10; 3 bytes ;y-component velocity, 16.8 fixed, pixels
0467BC             0020*   sprite_vel:                equ  13; 3 bytes ;velocity px/frame (16.8 fixed)
0467BC             0021*   sprite_heading:            equ  16; 3 bytes ;sprite movement direction deg256 16.8 fixed
0467BC             0022*   sprite_orientation:        equ  19; 3 bytes ;orientation bits
0467BC             0023*   ; sprite definition variables
0467BC             0024*   sprite_definitions:        equ  22; beginnning of sprite definition variables
0467BC             0025*   sprite_type:               equ  22; 1 bytes ;type of sprite as defined in enemies.inc
0467BC             0026*   sprite_base_bufferId:      equ  23; 3 bytes ;bitmap bufferId
0467BC             0027*   sprite_move_program:       equ  26; 3 bytes ;address of sprite's behavior subroutine
0467BC             0028*   sprite_collisions:         equ  29; 1 bytes ;see collisions.inc constants for bit definitions
0467BC             0029*   sprite_dim_x:              equ  30; 1 bytes ;sprite width in pixels
0467BC             0030*   sprite_dim_y:              equ  31; 1 bytes ;sprite height in pixels
0467BC             0031*   sprite_num_orientations:   equ  32; 1 bytes ;number of orientations for this sprite
0467BC             0032*   sprite_num_animations:     equ  33; 1 bytes ;number of animations for this sprite
0467BC             0033*   sprite_animation:          equ  34; 1 bytes ;current animation index, zero-based
0467BC             0034*   sprite_animation_timer:    equ  35; 1 bytes ;when hits zero, draw next animation
0467BC             0035*   sprite_move_timer:         equ  36; 1 bytes ;when zero, go to next move program, or step
0467BC             0036*   sprite_move_step:          equ  37; 1 bytes ;stage in a move program sequence, varies
0467BC             0037*   sprite_points:             equ  38; 1 bytes ;points awarded for killing this sprite type
0467BC             0038*   sprite_shield_damage:      equ  39; 1 bytes ;shield points deducted for collision
0467BC             0039*   sprite_frame:              equ  40; 1 bytes ;current animation frame
0467BC             0040*   sprite_definitions_size:   equ  sprite_frame-sprite_definitions+1
0467BC             0041*   
0467BC             0042*   ; ###### SPRITE TABLE VARIABLES ######
0467BC             0043*   ; pointer to top address of current record, initialized to table_base
0467BC D8 8D 04    0044*   table_pointer: dl table_base
0467BF             0045*   
0467BF             0046*   ; flag indicating collision with screen edge
0467BF 00          0047*   sprite_screen_edge: db #00
0467C0             0048*   sprite_fault_bad_record: equ 0
0467C0             0049*   sprite_fault_bad_move_program: equ 1
0467C0 00          0050*   sprite_fault_flags: db 0 ; latched fail-closed diagnostics
0467C1             0051*   
0467C1             0052*   ; ######### COLLISION SPRITE PARAMETERS ##########
0467C1             0053*   ; integer coordinates are all that are needed for collision calculations
0467C1 00          0054*   collision_x: db 0x00
0467C2 00          0055*   collision_y: db 0x00
0467C3 00          0056*   collision_dim_x: db 0x00
0467C4 00          0057*   collision_dim_y: db 0x00
0467C5             0058*   
0467C5             0059*   ; scratch variables
0467C5 00          0060*   x: db 0x00 ; 8-bit signed integer
0467C6 00          0061*   y: db 0x00 ; 8-bit signed integer
0467C7 00 00 00    0062*   x0: dl 0x000000 ; 16.8 signed fixed place
0467CA 00 00 00    0063*   y0: dl 0x000000 ; 16.8 signed fixed place
0467CD 00 00 00    0064*   incx1: dl 0x000000 ; 16.8 signed fixed place
0467D0 00 00 00    0065*   incy1: dl 0x000000 ; 16.8 signed fixed place
0467D3 00 00 00    0066*   incx2: dl 0x000000 ; 16.8 signed fixed place
0467D6 00 00 00    0067*   incy2: dl 0x000000 ; 16.8 signed fixed place
0467D9             0068*   
0467D9             0069*   ; sprite_heading: dl 0x000000 ; signed fixed 16.8
0467D9 00 00 00    0070*   radius: dl 0x000000 ; signed fixed 16.8 (but should always be positive)
0467DC 00 00 00    0071*   sin_sprite_heading: dl 0x000000 ; signed fixed 16.8
0467DF 00 00 00    0072*   cos_sprite_heading: dl 0x000000 ; signed fixed 16.8
0467E2             0073*   
0467E2             0074*   table_init:
0467E2             0075*   ; clear the sprite table
0467E2 AF          0076*       xor a ; write zeroes to sprite table
0467E3 21 D8 8D 04 0077*       ld hl,table_base ; address to copy from
0467E7 01 00 05 00 0078*       ld bc,table_end-table_base ; number of bytes to clear
0467EB CD 5B 03 04 0079*       call clear_mem
0467EF             0080*   ; write sprite ids
0467EF DD 21 D8 8D 0081*       ld ix,table_base
       04          
0467F4 AF          0082*       xor a ; sprite id
0467F5 0E 00       0083*       ld c,0 ; sprite type
0467F7 06 14       0084*       ld b,table_num_records ; loop counter
0467F9             0085*   @loop:
0467F9 DD 77 00    0086*       ld (ix+sprite_id),a
0467FC DD 71 16    0087*       ld (ix+sprite_type),c
0467FF ED 32 40    0088*       lea ix,ix+table_record_size
046802 3C          0089*       inc a
046803 10 F4       0090*       djnz @loop
046805 C9          0091*       ret
046806             0092*   ; end table_init
046806             0093*   
046806             0094*   ; Validate a record pointer and its stable identity byte against the physical
046806             0095*   ; 64-byte slot it occupies in the sprite table.
046806             0096*   ; inputs: iy = candidate sprite record
046806             0097*   ; outputs: carry set only for an aligned in-range pointer with the expected id
046806             0098*   ; destroys: a,de,hl
046806             0099*   sprite_table_record_pointer_valid:
046806 FD E5       0100*       push iy
046808 E1          0101*       pop hl
046809 11 D8 8D 04 0102*       ld de,table_base
04680D B7          0103*       or a
04680E ED 52       0104*       sbc hl,de ; offset from the sprite-table base
046810 DA 3A 68 04 0105*       jp c,@invalid
046814 11 00 05 00 0106*       ld de,table_end-table_base
046818 B7          0107*       or a
046819 ED 52       0108*       sbc hl,de
04681B D2 3A 68 04 0109*       jp nc,@invalid
04681F 19          0110*       add hl,de ; restore the in-range offset
046820 7D          0111*       ld a,l
046821 E6 3F       0112*       and table_record_size-1
046823 C2 3A 68 04 0113*       jp nz,@invalid
046827             0114*   ; Convert the aligned offset to its record id: H*4 + L/64.
046827 7C          0115*       ld a,h
046828 87          0116*       add a,a
046829 87          0117*       add a,a
04682A 57          0118*       ld d,a
04682B 7D          0119*       ld a,l
04682C 07          0120*       rlca
04682D 07          0121*       rlca
04682E E6 03       0122*       and %00000011
046830 B2          0123*       or d
046831 FD BE 00    0124*       cp (iy+sprite_id)
046834 C2 3A 68 04 0125*       jp nz,@invalid
046838 37          0126*       scf
046839 C9          0127*       ret
04683A             0128*   @invalid:
04683A AF          0129*       xor a
04683B C9          0130*       ret
04683C             0131*   ; end sprite_table_record_pointer_valid
04683C             0132*   
04683C             0133*   ; deactivate the sprite with the given id
04683C             0134*   ; inputs: iy set to sprite record
04683C             0135*   ; outputs: nothing
04683C             0136*   ; destroys: a,de,hl
04683C             0137*   table_deactivate_sprite:
04683C CD 06 68 04 0138*       call sprite_table_record_pointer_valid
046840 D2 5C 68 04 0139*       jp nc,@invalid
046844 FD 7E 00    0140*       ld a,(iy+sprite_id) ; get spriteId
046847 FD E5       0141*       push iy
046849 CD 03 1A 04 0142*       call vdu_sprite_select ; select sprite
04684D CD 87 1A 04 0143*       call vdu_sprite_hide
046851 FD E1       0144*       pop iy
046853 FD CB 1D B6 0145*       res sprite_alive,(iy+sprite_collisions)
046857 FD CB 1D BE 0146*       res sprite_just_died,(iy+sprite_collisions)
04685B C9          0147*       ret
04685C             0148*   @invalid:
04685C 21 C0 67 04 0149*       ld hl,sprite_fault_flags
046860 CB C6       0150*       set sprite_fault_bad_record,(hl)
046862 C9          0151*       ret
046863             0152*   ; end table_deactivate_sprite
046863             0153*   
046863             0154*   sprites_init:
046863             0155*   ; initialize sprites
046863 CD 37 1B 04 0156*   	call vdu_sprite_reset ; clear sprite data in vdp
046867             0157*   
046867             0158*   ; define player sprite
046867 3A D8 8E 04 0159*   	ld a,(player_begin+sprite_id)
04686B CD 03 1A 04 0160*   	call vdu_sprite_select
04686F CD 16 1A 04 0161*   	call vdu_sprite_clear_frames
046873 21 73 01 00 0162*   	ld hl,BUF_SHIP_0L
046877 06 03       0163*   	ld b,3 ; DJNZ consumes B; loading BC with 3 would put zero in B
046879             0164*   @sprite_player_loop:
