04816D             0145*   ; gets the next available sprite id for a particular sprite group
04816D             0146*   ; inputs; ix = pointer to sprite group, b = number of records in sprite group
04816D             0147*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
04816D             0148*   ;      otherwise, a = 0, carry reset, ix invalid and must not be dereferenced
04816D             0149*   ; destroys: a,b,c,hl,ix
04816D             0150*   table_get_next_id:
04816D             0151*   @loop:
04816D DD CB 1D 76 0152*       bit sprite_alive,(ix+sprite_collisions)
048171 28 07       0153*       jr z,@found
048173 ED 32 40    0154*       lea ix,ix+table_record_size
048176 10 F5       0155*       djnz @loop
048178             0156*   @notfound:
048178 AF          0157*       xor a ; a = 0 and reset carry flag indicating that we didn't find a free sprite
048179 C9          0158*       ret
04817A             0159*   @found:
04817A             0160*   ; return sprite id
04817A DD 7E 00    0161*       ld a,(ix+sprite_id)
04817D 37          0162*       scf ; sets carry flag indicating we found a free sprite
04817E C9          0163*       ret ; done
04817F             0164*   ; end table_get_next_id
04817F             0165*   
04817F             0166*   ; create a new sprite at the prescribed coordinates
04817F             0167*   ; inputs: hl = pointer to new sprite default settings, ub.c, ud.e = x,y position
04817F             0168*   ;         ix = pointer to sprite group, a = number of records in sprite group
04817F             0169*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
04817F             0170*   ;      otherwise, a = 0, carry reset, ix invalid and must not be dereferenced
04817F             0171*   spawn_sprite_from_coords:
04817F ED 43 B9 81 0172*       ld (@sprite_x),bc ; store x-coordinate
       04          
048184 ED 53 BC 81 0173*       ld (@sprite_y),de ; store y-coordinate
       04          
048189 47          0174*       ld b,a ; number of records in sprite group
04818A E5          0175*       push hl ; back up pointer to new sprite defaults
04818B CD 6D 81 04 0176*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
04818F E1          0177*       pop hl ; restore pointer to new sprite defaults
048190 D0          0178*       ret nc ; no carry means no free sprite slots, so we go home
048191             0179*   ; copy default settings to new sprite
048191 DD E5       0180*       push ix ; back up pointer to new sprite record
048193 ED 32 16    0181*       lea ix,ix+sprite_definitions ; bump pointer to copy to
048196 DD E5       0182*       push ix ; pointer to default sprite settings
048198 D1          0183*       pop de ; address to copy to
048199 01 2A 00 00 0184*       ld bc,table_record_size-sprite_definitions ; number of bytes to copy
04819D ED B0       0185*       ldir ; copies defaults to new sprite record
04819F DD E1       0186*       pop ix ; restore pointer to new sprite record
0481A1             0187*   ; copy sprite position from existing sprite
0481A1 2A B9 81 04 0188*       ld hl,(@sprite_x)
0481A5 DD 2F 01    0189*       ld (ix+sprite_x),hl
0481A8 2A BC 81 04 0190*       ld hl,(@sprite_y)
0481AC DD 2F 04    0191*       ld (ix+sprite_y),hl
0481AF             0192*   ; return to caller
0481AF DD CB 16 FE 0193*       set 7,(ix+sprite_type) ; set just spawned flag
0481B3 DD CB 1D F6 0194*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
0481B7 37          0195*       scf ; set carry flag to indicate success
0481B8 C9          0196*       ret
0481B9 00 00 00    0197*   @sprite_x: dl 0 ; new sprite x-coordinate
0481BC 00 00 00    0198*   @sprite_y: dl 0 ; new sprite y-coordinate
0481BF             0199*   ; end spawn_sprite_from_coords
0481BF             0200*   
0481BF             0201*   ; create a new sprite at the same location as an existing sprite
0481BF             0202*   ; inputs: hl = pointer to new sprite default settings, table_pointer = existing sprite
0481BF             0203*   ;         ix = pointer to sprite group, b = number of records in sprite group
0481BF             0204*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
0481BF             0205*   ;      otherwise, a = 0, carry reset, ix invalid and must not be dereferenced
0481BF             0206*   spawn_sprite_from_sprite:
0481BF E5          0207*       push hl ; back up pointer to new sprite defaults
0481C0 CD 6D 81 04 0208*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
0481C4 E1          0209*       pop hl ; restore pointer to new sprite defaults
0481C5 D0          0210*       ret nc ; no carry means no free sprite slots, so we go home
0481C6             0211*   ; copy default settings to new sprite
0481C6 DD E5       0212*       push ix ; back up pointer to new sprite record
0481C8 ED 32 16    0213*       lea ix,ix+sprite_definitions ; bump pointer to copy to
0481CB DD E5       0214*       push ix ; pointer to default sprite settings
0481CD D1          0215*       pop de ; address to copy to
0481CE 01 2A 00 00 0216*       ld bc,table_record_size-sprite_definitions ; number of bytes to copy
0481D2 ED B0       0217*       ldir ; copies defaults to new sprite record
0481D4 DD E1       0218*       pop ix ; restore pointer to new sprite record
0481D6             0219*   ; copy sprite position from existing sprite
0481D6 FD 2A C2 80 0220*       ld iy,(table_pointer) ; get existing sprite record
       04          
0481DB FD 27 01    0221*       ld hl,(iy+sprite_x)
0481DE DD 2F 01    0222*       ld (ix+sprite_x),hl
0481E1 FD 27 04    0223*       ld hl,(iy+sprite_y)
0481E4 DD 2F 04    0224*       ld (ix+sprite_y),hl
0481E7             0225*   ; return to caller
0481E7 DD CB 16 FE 0226*       set 7,(ix+sprite_type) ; set just spawned flag
0481EB DD CB 1D F6 0227*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
0481EF 37          0228*       scf ; set carry flag to indicate success
0481F0 C9          0229*       ret
