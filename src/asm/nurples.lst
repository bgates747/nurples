044EB2 3E 90       0165*       ld a,16+128 ; darkest blue
044EB4 CD 03 14 04 0166*       call vdu_colour_text
044EB8 3E 3A       0167*       ld a,58 ; dark orange
044EBA CD 03 14 04 0168*       call vdu_colour_text
044EBE             0169*   ; print get ready message
044EBE 0E 1B       0170*       ld c,27 ; x
044EC0 06 10       0171*       ld b,16 ; y
044EC2 CD BE 13 04 0172*       call vdu_move_cursor
044EC6 CD 5C 00 04 0173*       call printInline
044ECA 47 65 74 20 0174*       asciz "Get Ready!"
       52 65 61 64 
       79 21 00    
044ED5             0175*   ; countdown to restart
044ED5 0E 18       0176*       ld c,24 ; x
044ED7 06 11       0177*       ld b,17 ; y
044ED9 CD BE 13 04 0178*       call vdu_move_cursor
044EDD CD 5C 00 04 0179*       call printInline
044EE1 53 74 61 72 0180*       asciz "Starting In..."
       74 69 6E 67 
       20 49 6E 2E 
       2E 2E 00    
