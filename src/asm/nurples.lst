0413FF 00          0090*   @extent:    db 0x00 ; 0 current text window, 1 entire screen, 2 curr gfx viewport
041400 00          0091*   @dir:       db 0x00 ; 0 right, 1 left, 2 down, 3 up
041401 00          0092*   @speed:     db 0x00 ; pixels
041402 00          0093*   @end:		db 0x00 ; padding
041403             0094*   
041403             0095*   ; COLOUR MODES
041403             0096*   ; Mode	Effect
041403             0097*   ; 0	Set on-screen pixel to target colour value
041403             0098*   ; 1	OR value with the on-screen pixel
041403             0099*   ; 2	AND value with the on-screen pixel
041403             0100*   ; 3	XOR value with the on-screen pixel
041403             0101*   ; 4	Invert the on-screen pixel
041403             0102*   ; 5	No operation
041403             0103*   ; 6	AND the inverse of the specified colour with the on-screen pixel
041403             0104*   ; 7	OR the inverse of the specified colour with the on-screen pixel
041403             0105*   
