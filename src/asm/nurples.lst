04705A             0063        include "motion_damped_sine.inc"
04705A             0001*   ; Reusable horizontal damped-sine position primitive.
04705A             0002*   ;
04705A             0003*   ; This owns no actor fields and performs no movement or drawing. Actor schemas
04705A             0004*   ; retain their own phase/amplitude state, so the same primitive can drive a
04705A             0005*   ; player presentation, an enemy flight pattern, or another scripted actor.
04705A             0006*   ;
04705A             0007*   ; inputs:
04705A             0008*   ;   A  = angle256 integer phase
04705A             0009*   ;   BC = positive 16.8 amplitude in pixels
04705A             0010*   ;   DE = signed 16.8 centre position
04705A             0011*   ; output:
04705A             0012*   ;   HL = centre + sin(phase) * amplitude, signed 16.8
04705A             0013*   ; preserves: IX, IY, SP
04705A             0014*   ; destroys: AF, BC, DE, HL
04705A             0015*   motion_damped_sine_position:
04705A D5          0016*       push de
04705B C5          0017*       push bc
04705C 21 00 00 00 0018*       ld hl,0
047060 67          0019*       ld h,a
047061 CD D5 06 04 0020*       call sin168
047065 D1          0021*       pop de
047066 CD 11 06 04 0022*       call smul168
04706A D1          0023*       pop de
04706B 19          0024*       add hl,de
04706C C9          0025*       ret
04706D             0026*   ; end motion_damped_sine_position
04706D             0064        include "player_state.inc"
04706D             0001*   player_custom_begin: equ actor_record_custom
04706D             0002*   player_death_base_frame: equ player_custom_begin
04706D             0003*   player_death_turn_timer: equ player_death_base_frame+1
04706D             0004*   player_death_wiggle_timer: equ player_death_turn_timer+1
04706D             0005*   player_entry_angle: equ player_death_wiggle_timer+1
04706D             0006*   player_entry_timer: equ player_entry_angle+1
04706D             0007*   player_grace_timer: equ player_entry_timer+1
04706D             0008*   player_entry_warp_enabled: equ player_grace_timer+1
04706D             0009*   player_entry_warp_stage: equ player_entry_warp_enabled+1
04706D             0010*   player_entry_warp_timer: equ player_entry_warp_stage+1
04706D             0011*   player_entry_warp_hold_timer: equ player_entry_warp_timer+1
04706D             0012*   player_entry_amplitude: equ player_entry_warp_hold_timer+1
04706D             0013*   player_custom_end: equ player_entry_amplitude+1
04706D             0014*       .if player_custom_end-player_custom_begin-11
04706D             0015*           dl player_custom_span_mismatch
04706D             0016*       .endif
04706D             0017*   
04706D             0018*   player_play_ceiling: equ 64
04706D             0019*   player_entry_start_y: equ 320
04706D             0020*   player_entry_target_x: equ 120
04706D             0021*   player_entry_target_y: equ 224
04706D             0022*   player_grace_frames: equ 60
04706D             0023*   player_entry_fast_hold_frames: equ 56
04706D             0024*   player_entry_warp_stage_frames: equ 7
04706D             0025*   player_entry_warp_stage_count: equ 8
04706D             0026*   player_entry_warp_total_frames: equ player_entry_warp_stage_frames*player_entry_warp_stage_count
04706D             0027*   player_entry_total_frames: equ player_entry_fast_hold_frames+player_entry_warp_total_frames
04706D             0028*   player_entry_initial_angle: equ 192
04706D             0029*   player_entry_angle_step: equ 8
04706D             0030*   player_entry_initial_amplitude: equ 112
04706D             0031*   player_entry_y_velocity: equ -219 ; -0.855 px/frame; final residue is snapped
04706D             0032*   player_death_lateral_speed: equ 1*256
04706D             0033*   player_death_forward_speed: equ -64 ; -0.25 pixel/frame in 16.8 fixed
04706D             0034*   
04706D             0035*   ; The level-start starfield holds maximum speed for one complete old-entrance
04706D             0036*   ; duration, then reaches gameplay's one-scanline pace over the next 56 frames.
04706D             0037*   ; Mid-level respawn uses the same ship path with this actor-owned effect
04706D             0038*   ; disabled, because scrolling the rasterized playfield would detach existing
04706D             0039*   ; terrain from its records.
04706D             0040*   player_entry_warp_speeds:
04706D 10 0C 08 06 0041*       db 16,12,8,6,4,3,2,1
       04 03 02 01 
047075             0042*   player_entry_warp_speeds_end:
047075             0043*       .if player_entry_warp_speeds_end-player_entry_warp_speeds-player_entry_warp_stage_count
047075             0044*           dl player_entry_warp_speed_count_mismatch
047075             0045*       .endif
047075             0046*       .if player_entry_fast_hold_frames-player_entry_warp_total_frames
047075             0047*           dl player_entry_warp_duration_mismatch
047075             0048*       .endif
047075             0049*   
047075             0050*   ; The damped sine begins near the left edge and can never leave the actor's
047075             0051*   ; horizontal runway. Its final subpixel vertical residue is snapped to the
047075             0052*   ; reviewed endpoint before grace begins.
047075             0053*   player_entry_start_x: equ player_entry_target_x-player_entry_initial_amplitude
047075             0054*       .if player_entry_start_x-8
047075             0055*           dl player_entry_start_x_mismatch
047075             0056*       .endif
047075             0057*       .if player_entry_target_x+player_entry_initial_amplitude-232
047075             0058*           dl player_entry_right_extent_mismatch
047075             0059*       .endif
047075             0060*   
047075             0061*   player_defaults:
047075 05          0062*       db player               ; type
047076 73 01 00    0063*       dl BUF_SHIP_0L          ; base_bufferId
047079 E2 70 04    0064*       dl do_player            ; move_program
04707C 40          0065*       db %01000000            ; collisions bit 6 signals sprite alive
04707D 10          0066*       db 16                   ; dim_x
04707E 10          0067*       db 16                   ; dim_y
04707F 01          0068*       db 1                    ; num_orientations
047080 01          0069*       db 1                    ; num_animations
047081 00          0070*       db 0                    ; animation
047082 00          0071*       db 0                    ; animation_timer
047083 00          0072*       db 0                    ; move_timer
047084 00          0073*       db 0                    ; move_step
047085 00          0074*       db 0                    ; points
047086 00          0075*       db 0                    ; shield_damage
047087 00          0076*       db 0                    ; frame
047088             0077*   
047088 DE 73 04    0078*   player_state:  dl player_alive
04708B             0079*   player_event_none: equ 0
04708B             0080*   player_event_game_over: equ 1
04708B 00          0081*   player_event: db player_event_none
04708C             0082*   player_fault_bad_state: equ 0
04708C             0083*   player_fault_bad_entry_warp: equ 1
04708C 00          0084*   player_fault_flags: db 0 ; latched fail-closed diagnostics
04708D             0085*   player_dying_phase_initial: equ 0
04708D             0086*   player_dying_phase_delay: equ 1
04708D             0087*   player_dying_phase_finale: equ 2
04708D             0088*   player_dying_phase_finish: equ 3
04708D             0089*   ; The finale spawn frame itself performs lifetime update one later in the
04708D             0090*   ; global loop; FINISH therefore waits only the remaining updates.
04708D             0091*   player_dying_finish_frames: equ explosion_lifetime_updates-1
04708D 00          0092*   player_dying_phase: db player_dying_phase_initial
04708E 00          0093*   player_dying_timer: db 0
04708F 00          0094*   player_dying_spawns: db 0
047090 00          0095*   player_ships: db 0
047091 03          0096*   player_ships_max: db 3
047092             0097*   player_speed: equ 3*256 ; pixels per frame 16.8 fixed
047092             0098*   
047092             0099*   draw_player_ships:
047092             0100*   ; activate mfd
047092 DD 21 3F 76 0101*       ld ix,mfd_ships
       04          
047097 CD 46 77 04 0102*       call mfd_activate
04709B             0103*   ; blank out previously drawn ships
04709B AF          0104*       xor a ; color mode 0
04709C 0E 00       0105*       ld c,c_black
04709E CD 0C 14 04 0106*       call vdu_gcol
0470A2 01 00 00 00 0107*       ld bc,0
0470A6 11 00 00 00 0108*       ld de,0
0470AA DD 21 4F 00 0109*       ld ix,0+79
       00          
0470AF FD 21 0F 00 0110*       ld iy,0+15
       00          
0470B4 CD 9F 19 04 0111*       call vdu_plot_rf
0470B8             0112*   ; draw the ships remaining
0470B8 21 2B 00 00 0113*       ld hl,BUF_SHIP_MFD
0470BC CD 2C 15 04 0114*       call vdu_buff_select
0470C0 3A 90 70 04 0115*       ld a,(player_ships) ; loop counter
0470C4 01 00 00 00 0116*       ld bc,0 ; starting x-coordinate
0470C8             0117*   @loop:
0470C8 3D          0118*       dec a ; we don't count the ship we're flying
0470C9 C8          0119*       ret z
0470CA F5          0120*       push af ; back up loop counter
0470CB C5          0121*       push bc ; save x-coordinate
0470CC 11 00 00 00 0122*       ld de,0 ; y-coordinate
0470D0 CD 62 19 04 0123*       call vdu_plot_bmp
0470D4 C1          0124*       pop bc ; restore x-coordinate
