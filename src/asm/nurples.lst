044CC3 CD 91 68 04 0045*       call spawn_sprite_from_sprite
044CC7 D8          0046*       ret c ; carry is the only indication that IX names a valid explosion
044CC8             0047*   ; no slot: keep the player hidden and return failure without exposing invalid IX
044CC8 CD CD 67 04 0048*       call table_deactivate_sprite
044CCC AF          0049*       xor a ; clear carry after the VDU calls in table_deactivate_sprite
044CCD C9          0050*       ret
