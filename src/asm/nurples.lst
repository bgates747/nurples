04128B             0263*   ; Timer functions
04128B             0264*   ; -----------------------------------------------
04128B             0265*   ; set a countdown timer
04128B             0266*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
04128B             0267*   ; returns: hl = current time
04128B             0268*   tmr_set:
04128B FD 2F 03    0269*       ld (iy+3),hl            ; set time remaining
04128E             0270*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04128E 3E 08       0001*M1 			LD	A, function
041290 5B CF       0002*M1 			RST.LIL	08h
041292 DD 27 00    0271*       ld hl,(ix+sysvar_time)  ; get current time
041295 FD 2F 00    0272*       ld (iy+0),hl            ; set start time
041298 C9          0273*       ret
041299             0274*   
041299             0275*   ; gets time remaining on a countdown timer
041299             0276*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041299             0277*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
041299             0278*   ;          sign flags: pos = time not expired,zero or neg = time expired
041299             0279*   tmr_get:
041299             0280*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041299 3E 08       0001*M1 			LD	A, function
04129B 5B CF       0002*M1 			RST.LIL	08h
04129D DD 17 00    0281*       ld de,(ix+sysvar_time)  ; get current time
0412A0 FD 27 00    0282*       ld hl,(iy+0)            ; get start time
0412A3 AF          0283*       xor a                   ; clear carry
0412A4 ED 52       0284*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
0412A6 FD 17 03    0285*       ld de,(iy+3)            ; get timer set value
0412A9 AF          0286*       xor a                   ; clear carry
0412AA ED 5A       0287*       adc hl,de               ; hl = time remaining
0412AC             0288*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
0412AC C9          0289*       ret
0412AD             0290*   
0412AD             0291*   tmr_test: ds 6 ; example of a buffer to hold timer data
0412B3             0292*   
       FF FF FF FF 
       FF FF 
0412B3 00 00 00    0293*   timestamp_now: dl 0
0412B6 00 00 00    0294*   timestamp_old: dl 0
0412B9 00 00 00    0295*   timestamp_chg: dl 0
0412BC             0296*   
0412BC             0297*   ; update the global timestamp from the system clock
0412BC             0298*   ; inputs: none
0412BC             0299*   ; returns: hl = time elapsed in 1/120ths of a second
0412BC             0300*   ;          de = current time
0412BC             0301*   ;          ix = pointer to syvars table
0412BC             0302*   ; destroys: af,hl,de,ix
0412BC             0303*   timestamp_tick:
0412BC ED 5B B3 12 0304*       ld de,(timestamp_now)   ; get previous time
       04          
0412C1 ED 53 B6 12 0305*       ld (timestamp_old),de   ; save previous time
       04          
0412C6             0306*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0412C6 3E 08       0001*M1 			LD	A, function
0412C8 5B CF       0002*M1 			RST.LIL	08h
0412CA DD 27 00    0307*       ld hl,(ix+sysvar_time)  ; get current time
0412CD 22 B3 12 04 0308*       ld (timestamp_now),hl   ; save current time
0412D1 AF          0309*       xor a                   ; clear carry
0412D2 ED 52       0310*       sbc hl,de               ; hl = time elapsed
0412D4 22 B9 12 04 0311*       ld (timestamp_chg),hl   ; save elapsed time
0412D8 C9          0312*       ret
0412D9             0313*   
0412D9             0314*   ; set a countdown timer
0412D9             0315*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412D9             0316*   ; requires: timestamp_tick to be called at least once before this function
0412D9             0317*   ; returns: hl = current time
0412D9             0318*   ; destroys: hl
0412D9             0319*   timestamp_tmr_set:
0412D9 FD 2F 03    0320*       ld (iy+3),hl            ; set time remaining
0412DC 2A B3 12 04 0321*       ld hl,(timestamp_now)   ; get current timestamp
0412E0 FD 2F 00    0322*       ld (iy+0),hl            ; set start time
0412E3 C9          0323*       ret
0412E4             0324*   
0412E4             0325*   ; gets time remaining on a countdown timer following the global timestamp
0412E4             0326*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412E4             0327*   ; requires: timestamp_tick to be called at least once before this function
0412E4             0328*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
0412E4             0329*   ;          sign flags: pos = time not expired,zero or neg = time expired
0412E4             0330*   ; destroys: af,hl,de
0412E4             0331*   timestamp_tmr_get:
0412E4 ED 5B B3 12 0332*       ld de,(timestamp_now)   ; get current timestamp
       04          
0412E9 FD 27 00    0333*       ld hl,(iy+0)            ; get start time
0412EC AF          0334*       xor a                   ; clear carry
0412ED ED 52       0335*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
0412EF FD 17 03    0336*       ld de,(iy+3)            ; get timer set value
0412F2 AF          0337*       xor a                   ; clear carry
0412F3 ED 5A       0338*       adc hl,de               ; hl = time remaining
0412F5             0339*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
0412F5 C9          0340*       ret
