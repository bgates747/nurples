041085 ED 5B A4 10 0097*       ld de,(logo_yvel)
       04          
04108A 19          0098*       add hl,de
04108B 22 A7 10 04 0099*       ld (logo_ypos),hl
04108F             0100*   ; draw logo
04108F ED 4B A1 10 0101*       ld bc,(logo_xpos)
       04          
041094 ED 5B A7 10 0102*       ld de,(logo_ypos)
