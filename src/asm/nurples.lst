046532             0054*   ; define laser sprites
046532             0055*   @sprites_loop:
046532 F5          0056*       push af
046533 D5          0057*       push de
046534 CD 9B 19 04 0058*   	call vdu_sprite_select
046538 CD AE 19 04 0059*   	call vdu_sprite_clear_frames
04653C 21 4E 01 00 0060*   	ld hl,BUF_LASER_A
