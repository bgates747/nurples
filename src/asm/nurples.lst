049560 C0          0051*       ret nz
049561             0052*   ; spwan a seeker
049561 CD D9 21 04 0053*       call enemy_spawn_seeker
049565             0054*       ; ret ; DEBUG
049565             0055*       ; fall through to reset move timer
049565             0056*   pad_small_reset_move_timer:
049565 CD 14 05 04 0057*       call rand_8     ; snag a random number
049569 E6 1F       0058*       and %00011111   ; keep only 5 lowest bits (max 31)
04956B C6 40       0059*       add a,64 ; range is now 64-127
04956D FD 77 24    0060*       ld (iy+tile_move_timer),a ; when this hits zero,will spawn a seeker
049570 C9          0061*       ret
