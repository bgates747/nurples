042115 10          0010*       db 16                   ; dim_x
042116 10          0011*       db 16                   ; dim_y
042117 20          0012*       db 32                   ; num_orientations
042118 01          0013*       db 1                    ; num_animations
042119 00          0014*       db 0                    ; animation
04211A 00          0015*       db 0                    ; animation_timer
