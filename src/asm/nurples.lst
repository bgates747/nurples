041467             0246*   ; 137   320   240   16    60hz
041467             0247*   ; 21    512   384   16    60hz
041467             0248*   ; 149   512   384   16    60hz
041467             0249*   ; 4     640   240   16    60hz
041467             0250*   ; 132   640   240   16    60hz
041467             0251*   ; 0     640   480   16    60hz
041467             0252*   ; 7     n/a   n/a   16    60hz
