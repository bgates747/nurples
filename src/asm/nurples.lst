044AA0             0049*   
044AA0             0050*   move_enemy_fireball:
044AA0             0051*   ; run the movement program for the fireball enemy
044AA0 CD 4F 6A 04 0052*       call move_sprite
044AA4 3A 4C 67 04 0053*       ld a,(sprite_screen_edge)
044AA8 B7          0054*       or a ; a will be non-zero if have scrolled off screen
044AA9 C2 CD 67 04 0055*       jp nz,table_deactivate_sprite
044AAD DD 21 1A 89 0056*       ld ix,player_begin
       04          
044AB2 DD CB 1D 76 0057*       bit sprite_alive,(ix+sprite_collisions)
044AB6 CA CA 4A 04 0058*       jp z,@animate ; player is dead so don't check for collisions
044ABA CD CB 49 04 0059*       call check_enemy_collision_player
044ABE C2 CA 4A 04 0060*       jp nz,@animate ; no collision so do animation
044AC2 CD F7 66 04 0061*       call update_shields
