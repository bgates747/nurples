0423B8 CA 65 82 04 0078*       jp z,table_deactivate_sprite ; reached the end of the animations
0423BC 3E 08       0079*       ld a,explosion_animation_ticks ; reset animation timer
0423BE FD 77 23    0080*       ld (iy+sprite_animation_timer),a
