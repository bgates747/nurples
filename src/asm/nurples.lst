0441DD             1075*   ; AGNB 0.2 audio loader
0441DD             1076*   ; =====================
0441DD             1077*   ;
0441DD             1078*   ; The generic RIFF/AGNB file, chunk, bounds, streaming, buffer-clear, buffer-
0441DD             1079*   ; load, and buffer-consolidation routines remain in agnb_api.inc. This file adds
0441DD             1080*   ; the audio-specific record path for:
0441DD             1081*   ;
0441DD             1082*   ;     LIST BUFR
0441DD             1083*   ;       BHDR  u16 bufferId
0441DD             1084*   ;       AUDI  u8 vdpFormat=0x09; u16 sampleRate
0441DD             1085*   ;       DATA  unsigned 8-bit mono PCM bytes
0441DD             1086*   ;
0441DD             1087*   ; AUDI format 0x09 means VDP base format 1 (unsigned 8-bit mono) with bit 3
0441DD             1088*   ; set to record that an explicit u16 sample rate follows. vdu_buffer_to_sound
0441DD             1089*   ; accepts the base format and adds bit 3 itself, so finalization masks it off.
0441DD             1090*   
0441DD             1091*   agnb_audio_version_major:  equ 0
0441DD             1092*   agnb_audio_version_minor:  equ 2
0441DD             1093*   
0441DD             1094*   agnb_audi_format:          equ 0 ; u8 VDP sample format byte
0441DD             1095*   agnb_audi_sample_rate:     equ 1 ; u16 Hz
0441DD             1096*   agnb_audi_payload_size:    equ 3
0441DD             1097*   
0441DD             1098*   agnb_audio_vdp_format:     equ 0x09 ; unsigned 8-bit mono + sample rate follows
0441DD             1099*   
0441DD 41 55 44 49 1100*   agnb_id_audi:              db "AUDI"
0441E1             1101*   
0441E1             1102*   ; Normalized metadata retained until DATA has been validated and streamed.
0441E1             1103*   agnb_audio_meta_bufferId:  equ 0 ; u16 writer-specified VDP bufferId
0441E1             1104*   agnb_audio_meta_format:    equ 2 ; u8 VDP format; version 0.2 requires 0x09
0441E1             1105*   agnb_audio_meta_rate:      equ 3 ; u16 sample rate in Hz
0441E1             1106*   agnb_audio_meta_data_size: equ 5 ; u32 DATA payload size
0441E1             1107*   agnb_audio_meta_size:      equ 9
0441E1             1108*   
0441E1             1109*   agnb_audio_metadata:
0441E1 00 00 00 00 1110*       blkb agnb_audio_meta_size,0
       00 00 00 00 
       00          
0441EA             1111*   
0441EA             1112*   ; Application callback invoked after each audio sample has been finalized.
0441EA 00 00 00    1113*   agnb_audio_callback:       dl 0
0441ED             1114*   
0441ED             1115*   ; Load every valid audio record at its explicit bufferId. Playback remains the
0441ED             1116*   ; application's responsibility.
0441ED             1117*   ; inputs:  DE = zero-terminated container filename
0441ED             1118*   ; outputs: A=0/Z after the complete container; error code/NZ on failure
0441ED             1119*   ; destroys: AF, BC, DE, HL, IX
0441ED             1120*   agnb_load_audio:
0441ED 21 5C 42 04 1121*       ld hl,agnb_audio_callback_noop
0441F1             1122*   
0441F1             1123*   ; Callback-enabled audio loader.
0441F1             1124*   ; inputs: DE = filename; HL = callback whose result is ignored
0441F1             1125*   agnb_load_audio_with_callback:
