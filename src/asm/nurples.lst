047147 C9          0176*       ret
047148             0177*   ; end player_state_pointer_valid
047148             0178*   
047148             0179*   ; World components consume this published lifecycle policy themselves. The
047148             0180*   ; coordinator continues calling them. Travel resumes with intangible grace so
047148             0181*   ; the one-second safety state does not freeze the live world after entrance.
047148             0182*   ; outputs: carry set while normal world travel is enabled
047148             0183*   player_world_travel_enabled:
047148 2A 88 70 04 0184*       ld hl,(player_state)
04714C 11 DE 73 04 0185*       ld de,player_alive
047150 B7          0186*       or a
047151 ED 52       0187*       sbc hl,de
047153 CA 66 71 04 0188*       jp z,@travel
047157 2A 88 70 04 0189*       ld hl,(player_state)
04715B 11 9A 73 04 0190*       ld de,player_grace
04715F B7          0191*       or a
047160 ED 52       0192*       sbc hl,de
047162 C2 68 71 04 0193*       jp nz,@paused
047166             0194*   @travel:
047166 37          0195*       scf
047167 C9          0196*       ret
047168             0197*   @paused:
047168 AF          0198*       xor a
047169 C9          0199*       ret
04716A             0200*   ; end player_world_travel_enabled
04716A             0201*   
04716A             0202*   ; Publish the actor-owned level-start starfield speed to the global renderer.
04716A             0203*   ; Mid-level respawn keeps this disabled so existing terrain pixels and records
04716A             0204*   ; remain spatially coherent. Carry set means A is a validated 1..16 speed.
04716A             0205*   player_entry_starfield_speed:
04716A 2A 88 70 04 0206*       ld hl,(player_state)
04716E 11 0D 73 04 0207*       ld de,player_spawning
047172 B7          0208*       or a
047173 ED 52       0209*       sbc hl,de
047175 C2 B3 71 04 0210*       jp nz,@inactive
047179 FD 21 E2 A4 0211*       ld iy,player_begin
       04          
04717E FD 7E 30    0212*       ld a,(iy+player_entry_warp_enabled)
047181 B7          0213*       or a
047182 CA B3 71 04 0214*       jp z,@inactive
047186 FD 7E 33    0215*       ld a,(iy+player_entry_warp_hold_timer)
047189 B7          0216*       or a
04718A CA 92 71 04 0217*       jp z,@decelerating
04718E 3E 10       0218*       ld a,16
047190 37          0219*       scf
047191 C9          0220*       ret
047192             0221*   @decelerating:
047192 FD 7E 31    0222*       ld a,(iy+player_entry_warp_stage)
047195 FE 08       0223*       cp player_entry_warp_stage_count
047197 DA A6 71 04 0224*       jp c,@stage_valid
04719B             0225*   ; A malformed actor field degrades to ordinary one-scanline starfield travel.
04719B 21 8C 70 04 0226*       ld hl,player_fault_flags
04719F CB CE       0227*       set player_fault_bad_entry_warp,(hl)
0471A1 3E 07       0228*       ld a,player_entry_warp_stage_count-1
0471A3 FD 77 31    0229*       ld (iy+player_entry_warp_stage),a
0471A6             0230*   @stage_valid:
0471A6 21 6D 70 04 0231*       ld hl,player_entry_warp_speeds
0471AA 11 00 00 00 0232*       ld de,0
0471AE 5F          0233*       ld e,a
0471AF 19          0234*       add hl,de
0471B0 7E          0235*       ld a,(hl)
0471B1 37          0236*       scf
0471B2 C9          0237*       ret
0471B3             0238*   @inactive:
0471B3 AF          0239*       xor a
0471B4 C9          0240*       ret
0471B5             0241*   ; end player_entry_starfield_speed
0471B5             0242*   
0471B5             0243*   ; Hold maximum speed for 56 frames, then advance eight equal seven-frame
0471B5             0244*   ; deceleration stages. The final stage deliberately holds speed one until
0471B5             0245*   ; player_spawning publishes GRACE.
0471B5             0246*   player_entry_starfield_advance:
0471B5 FD 21 E2 A4 0247*       ld iy,player_begin
       04          
0471BA FD 7E 33    0248*       ld a,(iy+player_entry_warp_hold_timer)
0471BD B7          0249*       or a
0471BE CA C7 71 04 0250*       jp z,@decelerating
0471C2 3D          0251*       dec a
0471C3 FD 77 33    0252*       ld (iy+player_entry_warp_hold_timer),a
0471C6 C9          0253*       ret
0471C7             0254*   @decelerating:
0471C7 FD 35 32    0255*       dec (iy+player_entry_warp_timer)
0471CA C0          0256*       ret nz
0471CB FD 7E 31    0257*       ld a,(iy+player_entry_warp_stage)
0471CE FE 07       0258*       cp player_entry_warp_stage_count-1
0471D0 D2 DE 71 04 0259*       jp nc,@hold_normal
0471D4 3C          0260*       inc a
0471D5 FD 77 31    0261*       ld (iy+player_entry_warp_stage),a
0471D8 3E 07       0262*       ld a,player_entry_warp_stage_frames
0471DA FD 77 32    0263*       ld (iy+player_entry_warp_timer),a
0471DD C9          0264*       ret
0471DE             0265*   @hold_normal:
0471DE 3E 07       0266*       ld a,player_entry_warp_stage_count-1
0471E0 FD 77 31    0267*       ld (iy+player_entry_warp_stage),a
0471E3 3E 01       0268*       ld a,1
0471E5 FD 77 32    0269*       ld (iy+player_entry_warp_timer),a
0471E8 C9          0270*       ret
0471E9             0271*   ; end player_entry_starfield_advance
0471E9             0272*   
