048E8A             0026*   
048E8A             0027*   move_electrode:
048E8A CD B4 8C 04 0028*       call move_active_tile
048E8E CA C6 89 04 0029*       jp z,table_deactivate_tile
048E92 DD 21 87 9D 0030*       ld ix,player_begin
       04          
048E97 DD CB 1D 76 0031*       bit sprite_alive,(ix+sprite_collisions)
048E9B CA AF 8E 04 0032*       jp z,@laser ; player is dead so don't check for collisions
048E9F CD 7D 20 04 0033*       call check_enemy_collision_player
048EA3 C2 AF 8E 04 0034*       jp nz,@laser ; no collision so check laser collision
048EA7 CD FA 7C 04 0035*       call update_shields
