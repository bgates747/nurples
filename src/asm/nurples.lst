       04          
041474 FD 22 91 14 0203*       ld (@y1),iy
       04          
041479 DD 22 93 14 0204*   	ld (@x1),ix
       04          
04147E ED 53 95 14 0205*   	ld (@y0),de
       04          
041483 21 8E 14 04 0206*   	ld hl,@cmd
041487 01 09 00 00 0207*   	ld bc,@end-@cmd
04148B 5B DF       0208*   	rst.lil $18
04148D C9          0209*   	ret
04148E 18          0210*   @cmd:   db 24 ; set graphics viewport command
04148F 00 00       0211*   @x0: 	dw 0x0000 ; set by bc
041491 00 00       0212*   @y1: 	dw 0x0000 ; set by iy
041493 00 00       0213*   @x1: 	dw 0x0000 ; set by ix
041495 00 00       0214*   @y0: 	dw 0x0000 ; set by de
041497 00          0215*   @end:   db 0x00	  ; padding
