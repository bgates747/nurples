049259             0171*   ; create a new sprite at the same location as the current tile
049259             0172*   ; inputs: hl = pointer to new sprite default settings, tile_table_pointer = current tile
049259             0173*   ;         ix = pointer to sprite group, b = number of records in sprite group
049259             0174*   spawn_sprite_from_tile:
049259 E5          0175*       push hl ; back up pointer to new sprite defaults
04925A CD DA 82 04 0176*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
04925E E1          0177*       pop hl ; restore pointer to new sprite defaults
04925F D0          0178*       ret nc ; no carry means no free sprite slots, so we go home
049260             0179*   ; copy default settings to new sprite
049260 DD E5       0180*       push ix ; back up pointer to new sprite record
049262 ED 32 16    0181*       lea ix,ix+sprite_definitions ; bump pointer to copy to
049265 DD E5       0182*       push ix ; pointer to default sprite settings
049267 D1          0183*       pop de ; address to copy to
049268 01 13 00 00 0184*       ld bc,sprite_definitions_size ; copy only bytes provided by defaults
04926C ED B0       0185*       ldir ; copies defaults to new sprite record
04926E DD E1       0186*       pop ix ; restore pointer to new sprite record
049270             0187*   ; copy sprite position from existing tile
049270 FD 2A 54 8D 0188*       ld iy,(tile_table_pointer) ; get existing tile record
       04          
049275 FD 27 01    0189*       ld hl,(iy+tile_x)
049278 DD 2F 01    0190*       ld (ix+sprite_x),hl
04927B FD 27 04    0191*       ld hl,(iy+tile_y)
04927E DD 2F 04    0192*       ld (ix+sprite_y),hl
049281             0193*   ; clear motion state retained by a previously used physical record
049281 21 00 00 00 0194*       ld hl,0
049285 DD 2F 07    0195*       ld (ix+sprite_xvel),hl
049288 DD 2F 0A    0196*       ld (ix+sprite_yvel),hl
04928B DD 2F 0D    0197*       ld (ix+sprite_vel),hl
04928E DD 2F 10    0198*       ld (ix+sprite_heading),hl
049291 DD 2F 13    0199*       ld (ix+sprite_orientation),hl
049294             0200*   ; return to caller
049294 DD CB 16 FE 0201*       set 7,(ix+sprite_type) ; set just spawned flag
049298 DD CB 1D F6 0202*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
04929C 37          0203*       scf ; set carry flag to indicate success
04929D C9          0204*       ret
04929E             0205*   ; end spawn_sprite_from_tile
04929E             0206*   
04929E             0207*   ; create a new tile at the same location as the current tile
04929E             0208*   ; inputs: tile_table_pointer = current tile
04929E             0209*   spawn_active_tile_from_tile:
04929E             0210*   ; copy default settings to new tile
04929E DD 2A 54 8D 0211*       ld ix,(tile_table_pointer) ; get existing tile record
       04          
