041108 11 00 00 00 0147*       ld de,0
04110C B7          0148*       or a
04110D ED 52       0149*       sbc hl,de
04110F 20 09       0150*       jr nz,@count_error
041111 3A 07 10 04 0151*       ld a,(game_load_callback_overflow)
041115 B7          0152*       or a
