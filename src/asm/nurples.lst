049225 01          0008*       db tile_pad_small       ; type
049226 77 01 00    0009*       dl BUF_TILE_PAD_0       ; base_bufferId
049229 4B 92 04    0010*       dl move_pad_small       ; move_program
04922C 40          0011*       db %01000000            ; collisions bit 6 signals sprite alive
04922D 10          0012*       db 16                   ; dim_x
04922E 10          0013*       db 16                   ; dim_y
04922F 01          0014*       db 1                    ; num_orientations
049230 01          0015*       db 1                    ; num_animations
049231 00          0016*       db 0                    ; animation
049232 10          0017*       db 16                   ; animation_timer
049233 00          0018*       db 0                    ; move_timer
049234 00          0019*       db 0                    ; move_step
049235 05          0020*       db 5                    ; points
049236 00          0021*       db 0                    ; shield_damage
049237 00          0022*       db 0                    ; frame
049238             0023*   
049238             0024*   activate_pad_small:
049238 21 25 92 04 0025*       ld hl,pad_small_defaults
04923C             0026*   ; get next available active tile id
04923C CD E9 8A 04 0027*       call spawn_active_tile
049240 D0          0028*       ret nc ; no carry means no free active tile slots, so we go home
049241             0029*   ; other specific initialization
049241 CD 14 05 04 0030*       call rand_8     ; snag a random number
049245 E6 1F       0031*       and %00011111 ; keep only 5 lowest bits (max 31)
049247 DD 77 24    0032*       ld (ix+tile_move_timer),a ; when this hits zero,will spawn a seeker
04924A C9          0033*       ret
04924B             0034*   ; end activate_pad_small
04924B             0035*   
04924B             0036*   move_pad_small:
04924B CD 42 8E 04 0037*       call move_active_tile
04924F CA 51 8A 04 0038*       jp z,table_deactivate_tile
