044870             0049        include "collisions.inc"
044870             0001*   ; ====== COLLISION DETECTION ======
044870             0002*   ; --- constants ---
044870             0003*   ; sprite_collisions flags
044870             0004*   ; collides_with_player: equ %00000001
044870             0005*   ; collides_with_laser: equ %00000010
044870             0006*   sprite_alive: equ 6; set when sprite is alive
044870             0007*   sprite_just_died: equ 7; set when sprite just died
044870             0008*   collide_top: equ %00001000
044870             0009*   collide_bottom: equ %00000100
044870             0010*   collide_left: equ %00000010
044870             0011*   collide_right: equ %00000001
044870             0012*   
044870 00 00 00    0013*   collision_table_pointer: dl 0x000000 ; pointer to the sprite in the group being checked for collision
044873             0014*   
044873             0015*   collision_draw_hitboxes:
044873             0016*   ; draw hitbox for ix collider
044873 DD E5       0017*       push ix
044875 FD E5       0018*       push iy
044877 AF          0019*       xor a ; color mode 0
044878 0E 09       0020*       ld c,c_red
04487A CD 14 14 04 0021*       call vdu_gcol
04487E 01 00 00 00 0022*       ld bc,0
044882 DD 4E 02    0023*       ld c,(ix+sprite_x+1)
044885 DD 46 03    0024*       ld b,(ix+sprite_x+2)
044888 11 00 00 00 0025*       ld de,0
04488C DD 5E 05    0026*       ld e,(ix+sprite_y+1)
04488F DD 56 06    0027*       ld d,(ix+sprite_y+2)
044892 21 00 00 00 0028*       ld hl,0 ; clear hlu and h
044896 DD 6E 1E    0029*       ld l,(ix+sprite_dim_x)
044899 09          0030*       add hl,bc ; hl = x1
04489A E5          0031*       push hl ; save x1
04489B 21 00 00 00 0032*       ld hl,0 ; clear hlu and h
04489F DD 6E 1F    0033*       ld l,(ix+sprite_dim_y)
0448A2 19          0034*       add hl,de ; hl = y1
0448A3 DD E1       0035*       pop ix ; ix = x1 (was hl)
0448A5 E5          0036*       push hl
0448A6 FD E1       0037*       pop iy ; iy = y1
0448A8 CD 57 19 04 0038*       call vdu_plot_rf
0448AC FD E1       0039*       pop iy
0448AE DD E1       0040*       pop ix
0448B0             0041*   
0448B0             0042*   ; draw hitbox for iy collider
0448B0 DD E5       0043*       push ix
0448B2 FD E5       0044*       push iy
0448B4 AF          0045*       xor a ; color mode 0
0448B5 0E 0A       0046*       ld c,c_green
0448B7 CD 14 14 04 0047*       call vdu_gcol
0448BB 01 00 00 00 0048*       ld bc,0
0448BF FD 4E 02    0049*       ld c,(iy+sprite_x+1)
0448C2 FD 46 03    0050*       ld b,(iy+sprite_x+2)
0448C5 11 00 00 00 0051*       ld de,0
0448C9 FD 5E 05    0052*       ld e,(iy+sprite_y+1)
0448CC FD 56 06    0053*       ld d,(iy+sprite_y+2)
0448CF 21 00 00 00 0054*       ld hl,0 ; clear hlu and h
0448D3 FD 6E 1E    0055*       ld l,(iy+sprite_dim_x)
0448D6 09          0056*       add hl,bc ; hl = x1
0448D7 E5          0057*       push hl ; save x1
0448D8 21 00 00 00 0058*       ld hl,0 ; clear hlu and h
0448DC FD 6E 1F    0059*       ld l,(iy+sprite_dim_y)
0448DF 19          0060*       add hl,de ; hl = y1
0448E0 DD E1       0061*       pop ix ; ix = x1 (was hl)
0448E2 E5          0062*       push hl
0448E3 FD E1       0063*       pop iy ; iy = y1
0448E5 CD 57 19 04 0064*       call vdu_plot_rf
0448E9 FD E1       0065*       pop iy
0448EB DD E1       0066*       pop ix
0448ED C9          0067*       ret
0448EE             0068*   ; end collision_draw_hitboxes
0448EE             0069*   
0448EE             0070*   ; check_collision:
0448EE             0071*   ; Detects collision using bounding box method.
0448EE             0072*   ; Inputs:
0448EE             0073*   ;   IX -> Sprite/Tile table for Collider A
0448EE             0074*   ;   IY -> Sprite/Tile table for Collider B
0448EE             0075*   ; Outputs:
0448EE             0076*   ;   a = 0, zero flag set, positive sign, carry reset -> Collision detected
0448EE             0077*   ;   a = -1, zero flag reset, negative sign, carry set -> No collision detected
0448EE             0078*   ; Destroys: HL, DE, AF
0448EE             0079*   check_collision:
0448EE             0080*   check_collision_box:
0448EE             0081*   ; Test 1: (ay + ah) - by < 0
0448EE 21 00 00 00 0082*       ld hl,0                     ; Clear hlu
0448F2 DD 6E 05    0083*       ld l,(ix+sprite_y+1)        ; Load ay integer part low byte
0448F5 DD 66 06    0084*       ld h,(ix+sprite_y+2)        ; Load ay integer part high byte
0448F8 11 00 00 00 0085*       ld de,0                     ; Clear deu and d
0448FC DD 5E 1F    0086*       ld e,(ix+sprite_dim_y)      ; Load ah
0448FF 19          0087*       add hl,de                   ; (ay + ah)
044900 FD 5E 05    0088*       ld e,(iy+sprite_y+1)        ; Load by integer part low byte
044903 FD 56 06    0089*       ld d,(iy+sprite_y+2)        ; Load by integer part high byte
044906 AF          0090*       xor a                       ; Clear carry
044907 ED 52       0091*       sbc hl,de                   ; (ay + ah) - by
044909 FA 6C 49 04 0092*       jp m,@not_collision         ; No collision if negative
04490D             0093*   
04490D             0094*   ; Test 2: ay - (by + bh) < 0
04490D 21 00 00 00 0095*       ld hl,0                     ; Clear hlu
044911 FD 6E 05    0096*       ld l,(iy+sprite_y+1)        ; Load by integer part low byte
044914 FD 66 06    0097*       ld h,(iy+sprite_y+2)        ; Load by integer part high byte
044917 11 00 00 00 0098*       ld de,0                     ; Clear deu and d
04491B FD 5E 1F    0099*       ld e,(iy+sprite_dim_y)      ; Load bh
04491E 19          0100*       add hl,de                   ; (by + bh)
04491F DD 5E 05    0101*       ld e,(ix+sprite_y+1)        ; Load ay integer part low byte
044922 DD 56 06    0102*       ld d,(ix+sprite_y+2)        ; Load ay integer part high byte
044925 AF          0103*       xor a                       ; Clear carry
044926 ED 52       0104*       sbc hl,de                   ; (by + bh) - ay
044928 FA 6C 49 04 0105*       jp m,@not_collision         ; No collision if negative
04492C             0106*   
04492C             0107*   ; Test 3: (ax + aw) - bx < 0
04492C 21 00 00 00 0108*       ld hl,0                     ; Clear hlu
044930 DD 6E 02    0109*       ld l,(ix+sprite_x+1)        ; Load ax integer part low byte
044933 DD 66 03    0110*       ld h,(ix+sprite_x+2)        ; Load ax integer part high byte
044936 11 00 00 00 0111*       ld de,0                     ; Clear deu and d
04493A DD 5E 1E    0112*       ld e,(ix+sprite_dim_x)      ; Load aw
04493D 19          0113*       add hl,de                   ; (ax + aw)
04493E FD 5E 02    0114*       ld e,(iy+sprite_x+1)        ; Load bx integer part low byte
044941 FD 56 03    0115*       ld d,(iy+sprite_x+2)        ; Load bx integer part high byte
044944 AF          0116*       xor a                       ; Clear carry
044945 ED 52       0117*       sbc hl,de                   ; (ax + aw) - bx
044947 FA 6C 49 04 0118*       jp m,@not_collision         ; No collision if negative
04494B             0119*   
04494B             0120*   ; Test 4: ax - (bx + bw) < 0
04494B 21 00 00 00 0121*       ld hl,0                     ; Clear hlu
04494F FD 6E 02    0122*       ld l,(iy+sprite_x+1)        ; Load bx integer part low byte
044952 FD 66 03    0123*       ld h,(iy+sprite_x+2)        ; Load bx integer part high byte
044955 11 00 00 00 0124*       ld de,0                     ; Clear deu and d
044959 FD 5E 1E    0125*       ld e,(iy+sprite_dim_x)      ; Load bw
04495C 19          0126*       add hl,de                   ; (bx + bw)
04495D DD 5E 02    0127*       ld e,(ix+sprite_x+1)        ; Load ax integer part low byte
044960 DD 56 03    0128*       ld d,(ix+sprite_x+2)        ; Load ax integer part high byte
044963 AF          0129*       xor a                       ; Clear carry
044964 ED 52       0130*       sbc hl,de                   ; (bx + bw) - ax
044966 FA 6C 49 04 0131*       jp m,@not_collision         ; No collision if negative
04496A             0132*   
04496A             0133*   ; If all tests pass, collision is detected
04496A             0134*   @is_collision:
04496A AF          0135*       xor a                       ; Clear accumulator and flags (a = 0)
04496B C9          0136*       ret                         ; Return with zero flag set
04496C             0137*   
04496C             0138*   ; No collision detected
04496C             0139*   @not_collision:
04496C 3D          0140*       dec a                       ; Set a to -1
04496D C9          0141*       ret                         ; Return with carry set
04496E             0142*   ; End check_collision_box
04496E             0143*   
04496E             0144*   
04496E             0145*   ; this routine detects collisions between two collidable objects,
04496E             0146*   ; which can include sprites, active tiles, or any screen coordinate
04496E             0147*   ; which has been set up with a sprite table structure that includes dim_x
04496E             0148*   ; representing the radius of the collidable object
04496E             0149*   ; inputs: ix and iy point to the colliding objects' sprite/tile table records
04496E             0150*   ; outputs: uh.l = distance - sum of radii
04496E             0151*   ;          zero flag set if collision detected
04496E             0152*   ;          dx168 and dy168 are also populated with the signed displacements
04496E             0153*   ; destroys: everything except indexes
04496E             0154*   ; check_collision:
04496E             0155*   check_collision_cartesian:
04496E             0156*   ; compute dx = x1-x0
04496E DD 27 01    0157*       ld hl,(ix+sprite_x)
044971 FD 17 01    0158*       ld de,(iy+sprite_x)
044974 AF          0159*       xor a ; clear carry
044975 ED 52       0160*       sbc hl,de
044977 22 84 07 04 0161*       ld (dx168),hl ; dx to scratch
04497B             0162*   ; compute dy = y1-y0
04497B DD 27 04    0163*       ld hl,(ix+sprite_y)
04497E FD 17 04    0164*       ld de,(iy+sprite_y)
044981 AF          0165*       xor a ; clear carry
044982 ED 52       0166*       sbc hl,de ; hl = dy
044984 22 8A 07 04 0167*       ld (dy168),hl ; dy to scratch
044988             0168*   ; compute euclidean distance between centers
044988 CD 90 07 04 0169*       call distance168 ; uh.l = distance
04498C             0170*   ; check for overlap by summing half the radii
04498C DD 7E 1E    0171*       ld a,(ix+sprite_dim_x)
04498F CB 3F       0172*       srl a ; divide by 2
044991 FD 5E 1E    0173*       ld e,(iy+sprite_dim_x)
044994 CB 3B       0174*       srl e ; divide by 2
044996 83          0175*       add a,e
044997 11 00 00 00 0176*       ld de,0 ; clear deu and e
04499B 57          0177*       ld d,a ; ud.e = sum of radii
04499C B7          0178*       or a ; clear carry
04499D ED 52       0179*       sbc hl,de ; uh.l = distance - sum of radii
04499F C8          0180*       ret z ; return collision
0449A0 F0          0181*       ret p ; return no collision
0449A1 AF          0182*       xor a ; return collision
0449A2 C9          0183*       ret
0449A3             0184*   ; end check_collision_cartesian
0449A3             0185*   
0449A3             0186*   ; check collisions of a sprite or tile against a sprite group
0449A3             0187*   ; inputs: iy = pointer to sprite or tile record being checked
0449A3             0188*   ;         ix = pointer to sprite group, b = number of records in sprite group
0449A3             0189*   check_sprite_group_collisions:
0449A3             0190*   @collision_loop:
0449A3 DD 22 70 48 0191*       ld (collision_table_pointer),ix ; update table pointer
       04          
0449A8 C5          0192*       push bc ; backup loop counter
0449A9             0193*   ; check sprite_collisions sprite_alive flag to see if sprite is active
0449A9 DD CB 1D 76 0194*       bit sprite_alive,(ix+sprite_collisions)
0449AD CA C3 49 04 0195*       jp z,@next_record ; not alive so skip to next record
0449B1             0196*   ; sprite alive so check for collision
0449B1 CD EE 48 04 0197*       call check_collision
0449B5 C2 C3 49 04 0198*       jp nz,@next_record ; no collision
0449B9             0199*   ; set sprite_just_died flag for each entity and return to caller
0449B9 C1          0200*       pop bc ; dummy pop to balance stack
0449BA DD CB 1D FE 0201*       set sprite_just_died,(ix+sprite_collisions)
0449BE FD CB 1D FE 0202*       set sprite_just_died,(iy+sprite_collisions)
0449C2 C9          0203*       ret
0449C3             0204*   @next_record:
0449C3 C1          0205*       pop bc ; get back our loop counter
0449C4 ED 32 40    0206*       lea ix,ix+table_record_size
0449C7 10 DA       0207*       djnz @collision_loop ; loop until we've checked all the records
0449C9             0208*   ; return to caller
0449C9 AF          0209*       xor a
0449CA 3C          0210*       inc a ; resets sign flag and a to non-zero indicating no collision
0449CB C9          0211*       ret
0449CC             0212*   ; end check_sprite_group_collisions
0449CC             0213*   
0449CC             0214*   check_enemy_collision_laser: ; check for collisions with laser
0449CC DD 21 86 87 0215*       ld ix,player_lasers_begin
       04          
0449D1 06 04       0216*       ld b,player_lasers_max
0449D3 CD A3 49 04 0217*       call check_sprite_group_collisions
0449D7 C9          0218*       ret
0449D8             0219*   ; end check_enemy_collision_laser
0449D8             0220*   
0449D8             0221*   check_enemy_collision_player: ; check for collisions with player
0449D8 DD 21 86 88 0222*       ld ix,player_begin
       04          
0449DD CD EE 48 04 0223*       call check_collision
0449E1 C0          0224*       ret nz ; no collision so nothing to do
0449E2 DD CB 1D FE 0225*       set sprite_just_died,(ix+sprite_collisions)
0449E6 FD CB 1D FE 0226*       set sprite_just_died,(iy+sprite_collisions)
0449EA AF          0227*       xor a ; signal collision detected
0449EB C9          0228*       ret
0449EC             0229*   ; end check_enemy_collision_player
0449EC             0050        include "enemies.inc"
0449EC 4C 4A 04    0001*   enemies_state: dl enemies_alive
0449EF             0002*   enemies_fault_bad_state: equ 0
0449EF 00          0003*   enemies_fault_flags: db 0 ; latched fail-closed diagnostics
0449F0             0004*   
0449F0             0005*   do_enemies:
0449F0 2A EC 49 04 0006*       ld hl,(enemies_state)
0449F4 CD 12 4A 04 0007*       call enemies_state_pointer_valid
0449F8 DA 0B 4A 04 0008*       jp c,@dispatch
0449FC 21 EF 49 04 0009*       ld hl,enemies_fault_flags
044A00 CB C6       0010*       set enemies_fault_bad_state,(hl)
044A02 21 59 4A 04 0011*       ld hl,enemies_dead ; actor-local fail-closed state for the next tick
044A06 22 EC 49 04 0012*       ld (enemies_state),hl
044A0A C9          0013*       ret
044A0B             0014*   @dispatch:
044A0B             0015*       CALL_HL
                       M1 Args: none
044A0B 01 11 4A 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
044A0F C5          0002*M1     push bc ; which constitutes the return address
044A10 E9          0003*M1     jp (hl) ; Jump to the address in HL
044A11 C9          0016*       ret
044A12             0017*   
044A12             0018*   ; Exact stabilization whitelist for writable legacy enemy-state pointers.
044A12             0019*   enemies_state_pointer_valid:
044A12 11 4C 4A 04 0020*       ld de,enemies_alive
044A16 CD 46 4A 04 0021*       call @matches
044A1A CA 44 4A 04 0022*       jp z,@valid
044A1E 11 58 4A 04 0023*       ld de,enemies_despawning
044A22 CD 46 4A 04 0024*       call @matches
044A26 CA 44 4A 04 0025*       jp z,@valid
044A2A 11 59 4A 04 0026*       ld de,enemies_dead
044A2E CD 46 4A 04 0027*       call @matches
044A32 CA 44 4A 04 0028*       jp z,@valid
044A36 11 5A 4A 04 0029*       ld de,enemies_respawning
044A3A CD 46 4A 04 0030*       call @matches
044A3E CA 44 4A 04 0031*       jp z,@valid
044A42 AF          0032*       xor a
044A43 C9          0033*       ret
044A44             0034*   @valid:
044A44 37          0035*       scf
044A45 C9          0036*       ret
044A46             0037*   @matches:
044A46 E5          0038*       push hl
044A47 B7          0039*       or a
044A48 ED 52       0040*       sbc hl,de
044A4A E1          0041*       pop hl
044A4B C9          0042*       ret
044A4C             0043*   ; end enemies_state_pointer_valid
044A4C             0044*   
044A4C             0045*   enemies_alive:
044A4C FD 21 C6 88 0046*       ld iy,enemy_sprites_begin
       04          
044A51 06 07       0047*       ld b,table_num_enemy_records
044A53 CD 3B 69 04 0048*       call move_sprite_group
044A57 C9          0049*       ret
044A58             0050*   
044A58             0051*   enemies_despawning:
044A58 C9          0052*       ret
044A59             0053*   
044A59             0054*   enemies_dead:
044A59 C9          0055*       ret
044A5A             0056*   
044A5A             0057*   enemies_respawning:
044A5A C9          0058*       ret
044A5B             0051        include "enemy_fireball.inc"
044A5B             0001*   speed_fireball: equ 4*256 ; 6 pixels per frame 16.8 fixed
044A5B             0002*   fireballs_max: equ 4
044A5B             0003*   
044A5B             0004*   fireball_defaults:
044A5B 03          0005*       db enemy_projectile     ; type
044A5C 0E 01 00    0006*       dl BUF_FIREBALL_2_000   ; base_bufferId
044A5F AD 4A 04    0007*       dl move_enemy_fireball  ; move_program
044A62 40          0008*       db %01000000            ; collisions bit 6 signals sprite alive
044A63 10          0009*       db 16                   ; dim_x
044A64 10          0010*       db 16                   ; dim_y
044A65 20          0011*       db 32                   ; num_orientations
044A66 02          0012*       db 2                    ; num_animations
044A67 00          0013*       db 0                    ; animation
044A68 08          0014*       db 8                    ; animation_timer
044A69 00          0015*       db 0                    ; move_timer
044A6A 00          0016*       db 0                    ; move_step
044A6B 00          0017*       db 0                    ; points
044A6C FE          0018*       db -2                   ; shield_damage
044A6D 00          0019*       db 0                    ; frame
044A6E             0020*   
044A6E             0021*   enemy_spawn_fireball:
044A6E 21 5B 4A 04 0022*       ld hl,fireball_defaults
044A72 DD 21 86 89 0023*       ld ix,fireballs_base
       04          
044A77 06 04       0024*       ld b,fireballs_max
044A79 CD 4C 78 04 0025*       call spawn_sprite_from_tile
044A7D D0          0026*       ret nc ; no carry means no free sprite slots, so we go home
044A7E             0027*   ; other specific initialization
044A7E             0028*   ; ------------------------------------------------
044A7E             0029*   ; copy sprite heading and component velocities from targeting_computer
044A7E 2A 94 6F 04 0030*       ld hl,(Bearing_t)
044A82 11 00 80 00 0031*       ld de,128*256 ; rotate 128 degrees
044A86 19          0032*       add hl,de
044A87 DD 2F 10    0033*       ld (ix+sprite_heading),hl
044A8A 2A 9D 6F 04 0034*       ld hl,(Vp_x)
044A8E DD 2F 07    0035*       ld (ix+sprite_xvel),hl
044A91 2A A0 6F 04 0036*       ld hl,(Vp_y)
044A95 DD 2F 0A    0037*       ld (ix+sprite_yvel),hl
044A98             0038*   ; move projectile one frame's distance so it isn't drawn right over turret
044A98 DD 27 01    0039*       ld hl,(ix+sprite_x)
044A9B DD 17 07    0040*       ld de,(ix+sprite_xvel)
044A9E 19          0041*       add hl,de
044A9F DD 2F 01    0042*       ld (ix+sprite_x),hl
044AA2 DD 27 04    0043*       ld hl,(ix+sprite_y)
044AA5 DD 17 0A    0044*       ld de,(ix+sprite_yvel)
044AA8 19          0045*       add hl,de
044AA9 DD 2F 04    0046*       ld (ix+sprite_y),hl
044AAC C9          0047*       ret
