0414B0 C9          0276*       ret
0414B1             0277*   ; end vdu_get_screen_mode
0414B1             0278*   
0414B1             0279*   ; VDU 23, 0, &C0, n: Turn logical screen scaling on and off *
0414B1             0280*   ; inputs: a is scaling mode, 1=on, 0=off
0414B1             0281*   ; note: default setting on boot is scaling ON
0414B1             0282*   vdu_set_scaling:
0414B1 32 C3 14 04 0283*   	ld (@arg),a
0414B5 21 C0 14 04 0284*   	ld hl,@cmd
0414B9 01 04 00 00 0285*   	ld bc,@end-@cmd
0414BD 5B DF       0286*   	rst.lil $18
0414BF C9          0287*   	ret
0414C0 17 00 C0    0288*   @cmd: db 23,0,0xC0
0414C3 00          0289*   @arg: db 0  ; scaling on/off
0414C4             0290*   @end:
0414C4             0291*   
0414C4             0292*   ; VDU 23, 27, &20, bufferId; : Select bitmap (using a buffer ID)
0414C4             0293*   ; inputs: hl=bufferId
0414C4             0294*   vdu_buff_select:
0414C4 22 D6 14 04 0295*   	ld (@bufferId),hl
0414C8 21 D3 14 04 0296*   	ld hl,@cmd
0414CC 01 05 00 00 0297*   	ld bc,@end-@cmd
0414D0 5B DF       0298*   	rst.lil $18
0414D2 C9          0299*   	ret
0414D3 17 1B 20    0300*   @cmd: db 23,27,0x20
0414D6 00 00       0301*   @bufferId: dw 0x0000
0414D8 00          0302*   @end: db 0x00 ; padding
0414D9             0303*   
0414D9             0304*   ; VDU 23, 27, &21, w; h; format: Create bitmap from selected buffer
0414D9             0305*   ; inputs: a=format; bc=width; de=height
0414D9             0306*   ; prerequisites: buffer selected by vdu_bmp_select or vdu_buff_select
0414D9             0307*   ; formats: https://agonconsole8.github.io/agon-docs/VDP---Bitmaps-API.html
0414D9             0308*   ; 0 	RGBA8888 (4-bytes per pixel)
0414D9             0309*   ; 1 	RGBA2222 (1-bytes per pixel)
0414D9             0310*   ; 2 	Mono/Mask (1-bit per pixel)
0414D9             0311*   ; 3 	Reserved for internal use by VDP (“native” format)
0414D9             0312*   vdu_bmp_create:
0414D9 ED 43 F5 14 0313*       ld (@width),bc
       04          
0414DE ED 53 F7 14 0314*       ld (@height),de
       04          
0414E3 32 F9 14 04 0315*       ld (@fmt),a
0414E7 21 F2 14 04 0316*   	ld hl,@cmd
0414EB 01 08 00 00 0317*   	ld bc,@end-@cmd
0414EF 5B DF       0318*   	rst.lil $18
0414F1 C9          0319*   	ret
0414F2 17 1B 21    0320*   @cmd:       db 23,27,0x21
0414F5 00 00       0321*   @width:     dw 0x0000
0414F7 00 00       0322*   @height:    dw 0x0000
0414F9 00          0323*   @fmt:       db 0x00
0414FA             0324*   @end:
0414FA             0325*   
0414FA             0326*   ; load an rgba2222 image file to a working buffer and make it an rgba8888 bitmap in a target buffer
0414FA             0327*   ; inputs: bc,de image width,height ; hl = targetBufferId ; ix = file size ; iy = pointer to filename
0414FA             0328*   vdu_load_img_rgba2_to_8:
0414FA             0329*   ; backup the target buffer id and image dimensions
0414FA E5          0330*       push hl
0414FB D5          0331*       push de
0414FC C5          0332*       push bc
0414FD             0333*   ; load the rgba2 image to working buffer 65534
0414FD 21 FE FF 00 0334*       ld hl,65534 ; temporary working buffer id
041501 CD 0A 16 04 0335*   	call vdu_load_buffer_from_file
041505             0336*   ; restore the image dimensions and target buffer id
041505 C1          0337*       pop bc
041506 D1          0338*       pop de
041507 E1          0339*       pop hl
041508 D0          0340*       ret nc ; leave the cleared target untouched when the source cannot open
041509             0341*   ; fall through to vdu_rgba2_to_8
041509             0342*   
041509             0343*   ; https://discord.com/channels/1158535358624039014/1158536711148675072/1257757461729771771
041509             0344*   ; ok, so the "expand bitmap" can be used, when coupled with a "reverse" - the expanded bitmap _doesn't_ come out "right" otherwise, cos of endian-ness
041509             0345*   ; the "expand bitmap" command is:
041509             0346*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
041509             0347*   ; and then to reverse the byte order to fix endian-ness:
041509             0348*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
041509             0349*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
041509             0350*   ; VDU 23,27,&20,targetBufferID%;
041509             0351*   ; VDU 23,27,&21,width%;height%;0
041509             0352*   ; -------------------------------------------------------------------
041509             0353*   ; inputs: bc,de image width,height ; hl = targetBufferId
041509             0354*   ; prerequisites: rgba2 image data loaded into workingBufferId 65534
041509             0355*   vdu_rgba2_to_8:
041509             0356*   ; load the image dimensions and buffer id parameters
041509 ED 43 65 15 0357*       ld (@width),bc
       04          
04150E ED 53 67 15 0358*       ld (@height),de
       04          
041513 22 4A 15 04 0359*       ld (@bufferId0),hl
041517 22 57 15 04 0360*       ld (@bufferId2),hl
04151B 22 60 15 04 0361*       ld (@bufferId1),hl
04151F             0362*   ; clean up bytes that got stomped on by the ID loads
04151F 3E 48       0363*       ld a,0x48
041521 32 4C 15 04 0364*       ld (@bufferId0+2),a
041525 3E 17       0365*       ld a,23
041527 32 62 15 04 0366*       ld (@bufferId1+2),a
04152B 3E 18       0367*       ld a,24
04152D 32 59 15 04 0368*       ld (@bufferId2+2),a
041531 AF          0369*       xor a
041532 32 69 15 04 0370*       ld (@height+2),a
041536             0371*   ; send the vdu command strings
041536 21 41 15 04 0372*       ld hl,@beg
04153A 01 29 00 00 0373*       ld bc,@end-@beg
04153E 5B DF       0374*       rst.lil $18
041540 C9          0375*       ret
041541             0376*   @beg:
041541             0377*   ; Command 14: Consolidate blocks in a buffer
041541             0378*   ; VDU 23, 0, &A0, bufferId; 14
041541 17 00 A0    0379*       db 23,0,0xA0
041544 FE FF       0380*       dw 65534 ; workingBufferId
041546 0E          0381*       db 14 ; consolidate blocks
041547             0382*   ; the "expand bitmap" command is:
041547             0383*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
041547 17 00 A0    0384*       db 23,0,0xA0
04154A 00 00       0385*   @bufferId0: dw 0x0000 ; targetBufferId
04154C 48          0386*       db 0x48 ; given as decimal command 72 in the docs
04154D 02          0387*       db 2 ; options mask: %00000011 is the number of bits per pixel in the source bitmap
04154E FE FF       0388*       dw 65534 ; sourceBufferId
041550 00 7F BF FF 0389*       db 0x00,0x7F,0xBF,0xFF ; expanding to bytes by bit-shifting?
041554             0390*   ; reverse the byte order to fix endian-ness:
041554             0391*   ; Command 24: Reverse the order of data of blocks within a buffer
041554             0392*   ; VDU 23, 0, &A0, bufferId; 24, options, [valueSize;] [chunkSize;]
041554             0393*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
041554 17 00 A0    0394*       db 23,0,0xA0
041557 00 00       0395*   @bufferId2:    dw 0x0000 ; targetBufferId
041559 18          0396*       db 24 ; reverse byte order
04155A 04          0397*       db 4 ; option: Reverse data of the value size within chunk of data of the specified size
04155B 04 00       0398*       dw 4 ; size (4 bytes)
04155D             0399*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
04155D             0400*   ; VDU 23,27,&20,targetBufferID%;
04155D 17 1B 20    0401*       db 23,27,0x20 ; select bitmap
041560 00 00       0402*   @bufferId1: dw 0x0000 ; targetBufferId
041562             0403*   ; VDU 23,27,&21,width%;height%;0
041562 17 1B 21    0404*       db 23,27,0x21 ; create bitmap from buffer
041565 00 00       0405*   @width: dw 0x0000
041567 00 00       0406*   @height: dw 0x0000
041569 00          0407*       db 0x00 ; rgba8888 format
04156A             0408*   @end:
04156A             0409*   
04156A             0410*   ; scratch variables
04156A 00 00 00    0411*   bufferId0: dl 0x000000
04156D 00 00 00    0412*   bufferId1: dl 0x000000
041570             0413*   
041570             0414*   ; load a vdu buffer from local memory
041570             0415*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
041570             0416*   vdu_load_buffer:
041570 ED 43 99 15 0417*       ld (@length),bc
       04          
041575 D5          0418*       push de ; save data pointer
041576             0419*   ; send the vdu command string
041576 7D          0420*       ld a,l
041577 32 96 15 04 0421*       ld (@bufferId),a
04157B 7C          0422*       ld a,h
04157C 32 97 15 04 0423*       ld (@bufferId+1),a
041580 21 93 15 04 0424*       ld hl,@cmd
041584 01 08 00 00 0425*       ld bc,@end-@cmd
041588 5B DF       0426*       rst.lil $18
04158A             0427*   ; send the buffer data
04158A E1          0428*       pop hl ; pointer to data
04158B ED 4B 99 15 0429*       ld bc,(@length)
       04          
041590 5B DF       0430*       rst.lil $18 ; send it
041592 C9          0431*       ret
041593             0432*   ; Upload data :: VDU 23, 0 &A0, bufferId; 0, length; <buffer-data>
041593 17 00 A0    0433*   @cmd:       db 23,0,0xA0
041596 00 00       0434*   @bufferId:	dw 0x0000
041598 00          0435*   		    db 0 ; load buffer
041599 00 00       0436*   @length:	dw 0x0000
04159B 00          0437*   @end: db 0 ; padding
04159C             0438*   
04159C             0439*   ; Command 14: Consolidate blocks in a buffer
04159C             0440*   vdu_consolidate_buffer:
04159C             0441*   ; set parameters for vdu call
04159C 7D          0442*       ld a,l
04159D 32 B4 15 04 0443*       ld (@bufferId),a
0415A1 7C          0444*       ld a,h
0415A2 32 B5 15 04 0445*       ld (@bufferId+1),a
0415A6 21 B1 15 04 0446*       ld hl,@beg
0415AA 01 06 00 00 0447*       ld bc,@end-@beg
0415AE 5B DF       0448*       rst.lil $18
0415B0 C9          0449*       ret
0415B1             0450*   ; VDU 23, 0, &A0, bufferId; 14
0415B1 17 00 A0    0451*   @beg: db 23,0,0xA0
0415B4 00 00       0452*   @bufferId: dw 0x0000
0415B6 0E          0453*              db 14
0415B7             0454*   @end:
0415B7             0455*   
0415B7             0456*   ; Convert a consolidated buffer to an explicitly rated audio sample.
0415B7             0457*   ; This is a dependency of the canonical AGNB API's dormant audio entry point;
0415B7             0458*   ; Purple Nurples currently creates no audio container and does not call it.
0415B7             0459*   ; inputs: HL=bufferId, A=base format (0 signed, 1 unsigned), DE=sample rate
0415B7             0460*   vdu_buffer_to_sound:
0415B7 22 D7 15 04 0461*       ld (@bufferId),hl
0415BB C6 08       0462*       add a,8
0415BD 32 D9 15 04 0463*       ld (@format),a
0415C1 ED 53 DA 15 0464*       ld (@sampleRate),de
       04          
0415C6 21 D1 15 04 0465*       ld hl,@cmd
0415CA 01 0B 00 00 0466*       ld bc,@end-@cmd
0415CE 5B DF       0467*       rst.lil $18
0415D0 C9          0468*       ret
0415D1 17 00 85    0469*   @cmd:        db 23,0,$85
0415D4 00 05 02    0470*                db 0,5,2
0415D7 00 00       0471*   @bufferId:   dw 0
0415D9 00          0472*   @format:     db 0
0415DA 00 00       0473*   @sampleRate: dw 0
0415DC             0474*   ; Native ADL stores three bytes from DE. This byte absorbs DEU outside the VDU
0415DC             0475*   ; packet, matching the canonical dependency implementation.
0415DC 00          0476*   @end:        db 0
0415DD             0477*   
0415DD             0478*   ; load an image file to a buffer and make it a bitmap
0415DD             0479*   ; inputs: a = image type ; bc,de image width,height ; hl = bufferId ; ix = file size ; iy = pointer to filename
0415DD             0480*   vdu_load_img:
0415DD             0481*   ; back up image type and dimension parameters
0415DD 22 6A 15 04 0482*       ld (bufferId0),hl
0415E1 F5          0483*       push af
0415E2 C5          0484*   	push bc
0415E3 D5          0485*   	push de
0415E4             0486*   ; load the image
0415E4 CD 0A 16 04 0487*   	call vdu_load_buffer_from_file
0415E8 DA F1 15 04 0488*       jp c,@loaded
0415EC             0489*   ; balance the saved arguments and fail without creating an empty bitmap
0415EC D1          0490*   	pop de
0415ED C1          0491*   	pop bc
0415EE F1          0492*   	pop af
0415EF B7          0493*       or a ; preserve A while reasserting the carry-clear failure contract
0415F0 C9          0494*       ret
0415F1             0495*   @loaded:
0415F1             0496*   ; now make it a bitmap
0415F1 2A 6A 15 04 0497*       ld hl,(bufferId0)
0415F5 CD 9C 15 04 0498*       call vdu_consolidate_buffer
0415F9 2A 6A 15 04 0499*       ld hl,(bufferId0)
0415FD CD C4 14 04 0500*       call vdu_buff_select
041601 D1          0501*   	pop de ; image height
041602 C1          0502*   	pop bc ; image width
041603 F1          0503*   	pop af ; image type
041604 CD D9 14 04 0504*   	call vdu_bmp_create
041608 37          0505*       scf
041609 C9          0506*       ret
04160A             0507*   
04160A             0508*   ; inputs: hl = bufferId; iy = pointer to filename
04160A             0509*   ; outputs: carry set after a complete read/close; carry clear if open failed
04160A             0510*   vdu_load_buffer_from_file:
04160A 22 6A 15 04 0511*       ld (bufferId0),hl
04160E             0512*   
04160E             0513*   ; clear target buffer
04160E CD BA 17 04 0514*       call vdu_clear_buffer
041612             0515*   
041612             0516*   ; open the file in read mode
041612             0517*   ; Open a file
041612             0518*   ; HLU: Filename
041612             0519*   ;   C: Mode
041612             0520*   ; Returns:
041612             0521*   ;   A: Filehandle, or 0 if couldn't open
041612 FD E5       0522*   	push iy ; pointer to filename
041614 E1          0523*   	pop hl
041615 0E 01       0524*       ld c,fa_read
041617             0525*       MOSCALL mos_fopen
                       M1 Args: function=mos_fopen 
041617 3E 0A       0001*M1 			LD	A, function
041619 5B CF       0002*M1 			RST.LIL	08h
04161B B7          0526*       or a
04161C C8          0527*       ret z ; carry clear: do not read or close the all-files handle zero
04161D 32 5A 16 04 0528*       ld (@filehandle),a
041621             0529*   
041621             0530*   @read_file:
041621             0531*   ; Read a block of data from a file
041621             0532*   ;   C: Filehandle
041621             0533*   ; HLU: Pointer to where to write the data to
041621             0534*   ; DEU: Number of bytes to read
041621             0535*   ; Returns:
041621             0536*   ; DEU: Number of bytes read
041621 3A 5A 16 04 0537*       ld a,(@filehandle)
041625 4F          0538*       ld c,a
041626 21 00 E0 B7 0539*       ld hl,filedata
04162A 11 00 20 00 0540*       ld de,8192 ; max we can read into onboard sram at one time
04162E             0541*       MOSCALL mos_fread
                       M1 Args: function=mos_fread 
04162E 3E 1A       0001*M1 			LD	A, function
041630 5B CF       0002*M1 			RST.LIL	08h
041632             0542*   
041632             0543*   ; test de for zero bytes read
041632 21 00 00 00 0544*       ld hl,0
041636 AF          0545*       xor a ; clear carry
041637 ED 52       0546*       sbc hl,de
041639 CA 4F 16 04 0547*       jp z,@close_file
04163D             0548*   
04163D             0549*   ; load a vdu buffer from local memory
04163D             0550*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
04163D 2A 6A 15 04 0551*       ld hl,(bufferId0)
041641 D5          0552*       push de ; chunksize
041642 C1          0553*       pop bc
041643 11 00 E0 B7 0554*       ld de,filedata
041647 CD 70 15 04 0555*       call vdu_load_buffer
04164B             0556*   
04164B             0557*   ; read the next block
04164B C3 21 16 04 0558*       jp @read_file
04164F             0559*   
04164F             0560*   ; close the file
04164F             0561*   @close_file:
04164F 3A 5A 16 04 0562*       ld a,(@filehandle)
041653 4F          0563*       ld c,a
041654             0564*       MOSCALL mos_fclose
                       M1 Args: function=mos_fclose 
041654 3E 0B       0001*M1 			LD	A, function
041656 5B CF       0002*M1 			RST.LIL	08h
041658 37          0565*       scf
041659 C9          0566*       ret ; vdu_load_buffer_from_file
