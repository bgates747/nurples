041312             0362*   stopwatch_started: ds 3 ; buffer to hold stopwatch start time
041315             0363*   
041315             0364*   ; ------------------
041315             0365*   ; delay routine
041315             0366*   ; Author: Richard Turrnidge
041315             0367*   ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.asm
041315             0368*   ; routine waits a fixed time,then returns
041315             0369*   ; arrive with A =  the delay byte. One bit to be set only.
041315             0370*   ; eg. ld A,00000100b
041315             0371*   
041315             0372*   multiPurposeDelay:
       FF FF FF 
041315 F5          0373*       push af
041316 C5          0374*       push bc
041317 D5          0375*       push de
041318 DD E5       0376*       push ix
04131A 5F          0377*       ld e,a ; timestamp bit mask
04131B 3E 20       0378*       ld a,32
04131D 32 66 13 04 0379*       ld (multiPurposeDelay_timeout_outer),a
041321 06 00       0380*       ld b,0
041323 16 00       0381*       ld d,0
041325 3E 08       0382*       ld a,$08
041327 5B CF       0383*       RST.LIL	08h                 ; get IX pointer to sysvars
041329             0384*   
041329             0385*   waitLoop:
041329             0386*   
041329 DD 7E 00    0387*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
04132C             0388*   
04132C             0389*                                   ;   we check if bit set is same as last time we checked.
04132C             0390*                                   ;   bit 0 - don't use
04132C             0391*                                   ;   bit 1 - changes 64 times per second
04132C             0392*                                   ;   bit 2 - changes 32 times per second
04132C             0393*                                   ;   bit 3 - changes 16 times per second
04132C             0394*   
04132C             0395*                                   ;   bit 4 - changes 8 times per second
04132C             0396*                                   ;   bit 5 - changes 4 times per second
04132C             0397*                                   ;   bit 6 - changes 2 times per second
04132C             0398*                                   ;   bit 7 - changes 1 times per second
04132C A3          0399*       and e
04132D 4F          0400*       ld c,a
04132E 3A 65 13 04 0401*       ld a,(oldTimeStamp)
041332 B9          0402*       cp c                        ; is A same as last value?
041333 C2 59 13 04 0403*       jp nz,@changed
041337             0404*   ; Bound a stalled MOS clock to 32 * 65,536 polls.
041337 15          0405*       dec d
041338 C2 29 13 04 0406*       jp nz,waitLoop
04133C 10 EB       0407*       djnz waitLoop
04133E 3A 66 13 04 0408*       ld a,(multiPurposeDelay_timeout_outer)
041342 3D          0409*       dec a
041343 32 66 13 04 0410*       ld (multiPurposeDelay_timeout_outer),a
041347 C2 29 13 04 0411*       jp nz,waitLoop
04134B 3A 64 13 04 0412*       ld a,(timer_fault_flags)
04134F F6 01       0413*       or %00000001
041351 32 64 13 04 0414*       ld (timer_fault_flags),a
041355 C3 5E 13 04 0415*       jp @done
041359             0416*   @changed:
041359 79          0417*       ld a,c
04135A 32 65 13 04 0418*       ld (oldTimeStamp),a        ; set new value
04135E             0419*   
04135E             0420*   @done:
04135E DD E1       0421*       pop ix
041360 D1          0422*       pop de
041361 C1          0423*       pop bc
041362 F1          0424*       pop af
041363 C9          0425*       ret
041364             0426*   
041364             0427*   timer_fault_delay_timeout: equ 0
041364 00          0428*   timer_fault_flags: db 0
041365 00          0429*   oldTimeStamp: .db 00h
041366 00          0430*   multiPurposeDelay_timeout_outer: db 0
