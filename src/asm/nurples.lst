047F89 CD BF 81 04 0111*       call spawn_sprite_from_sprite
047F8D D0          0112*       ret nc ; no carry means no free sprite slots, so we go home
047F8E             0113*   ; other specific initialization
047F8E             0114*   ; ------------------------------------------------
047F8E FD 21 9E 9C 0115*       ld iy,player_begin
       04          
