04735A             0429*   ; Damped sinusoidal approach shared by level entry and mid-level respawn.
04735A             0430*   ; The generic primitive owns only its math; this actor schema owns the evolving
04735A             0431*   ; angle, amplitude and bank frame. Amplitude falls one pixel per frame, so the
04735A             0432*   ; ship completes several broad weaves before settling naturally at centre.
04735A             0433*   ; inputs: IY = player record
04735A             0434*   player_entry_damped_swoop:
04735A FD 7E 2D    0435*       ld a,(iy+player_entry_angle)
04735D 01 00 00 00 0436*       ld bc,0
047361 FD 46 34    0437*       ld b,(iy+player_entry_amplitude)
047364 11 00 78 00 0438*       ld de,player_entry_target_x*256
047368 CD 5A 70 04 0439*       call motion_damped_sine_position
04736C FD 2F 01    0440*       ld (iy+sprite_x),hl
04736F             0441*   ; Bank in the direction of the sine derivative. Angle quadrants 3 and 0 move
04736F             0442*   ; right; quadrants 1 and 2 move left.
04736F FD 7E 2D    0443*       ld a,(iy+player_entry_angle)
047372 FE 40       0444*       cp 64
047374 DA 7E 73 04 0445*       jp c,@bank_right
047378 FE C0       0446*       cp 192
04737A DA 84 73 04 0447*       jp c,@bank_left
04737E             0448*   @bank_right:
04737E 3E 02       0449*       ld a,2
047380 C3 85 73 04 0450*       jp @bank_ready
047384             0451*   @bank_left:
047384 AF          0452*       xor a
047385             0453*   @bank_ready:
047385 FD 77 28    0454*       ld (iy+sprite_frame),a
047388 FD 7E 2D    0455*       ld a,(iy+player_entry_angle)
04738B C6 08       0456*       add a,player_entry_angle_step
04738D FD 77 2D    0457*       ld (iy+player_entry_angle),a
047390 FD 7E 34    0458*       ld a,(iy+player_entry_amplitude)
047393 B7          0459*       or a
047394 C8          0460*       ret z
047395 3D          0461*       dec a
047396 FD 77 34    0462*       ld (iy+player_entry_amplitude),a
047399 C9          0463*       ret
04739A             0464*   ; end player_entry_damped_swoop
04739A             0465*   
04739A             0466*   player_grace:
04739A             0467*   ; Control begins only after the entrance settles. Collision remains disabled
04739A             0468*   ; for exactly one second at the game's 60 Hz outer-frame cadence.
04739A CD 96 78 04 0469*       call player_input
