047AE5             0004*   
047AE5             0005*   ; inputs: iy set to sprite/tile record being tallied
047AE5             0006*   ; outputs: hl,player_score = updated score
047AE5             0007*   ; destroys: hl,de
047AE5             0008*   update_score:
047AE5 11 00 00 00 0009*       ld de,0 ; clear deu and d
047AE9 FD 5E 26    0010*       ld e,(iy+sprite_points)
047AEC 2A DF 7A 04 0011*       ld hl,(player_score)
047AF0 19          0012*       add hl,de
047AF1 22 DF 7A 04 0013*       ld (player_score),hl
047AF5 CD FA 7A 04 0014*       call print_score
047AF9 C9          0015*       ret
047AFA             0016*   ; end update_score
047AFA             0017*   
047AFA             0018*   ; text coordinates for score display
047AFA             0019*   score_x: equ 50
047AFA             0020*   score_y: equ 33
047AFA             0021*   ; inputs: none
047AFA             0022*   print_score:
047AFA             0023*   ; set text colors
047AFA 3E 80       0024*       ld a,c_black+128
047AFC CD FB 13 04 0025*       call vdu_colour_text
047B00 3E 0A       0026*       ld a,c_green
047B02 CD FB 13 04 0027*       call vdu_colour_text
047B06             0028*   ; print the score
047B06 0E 32       0029*       ld c,score_x
047B08 06 21       0030*       ld b,score_y
047B0A CD B6 13 04 0031*       call vdu_move_cursor
047B0E 2A DF 7A 04 0032*       ld hl,(player_score)
047B12 CD C8 00 04 0033*       call printDec
047B16 C9          0034*       ret
047B17             0035*   ; end print_score
047B17             0070        include "player_shields.inc"
047B17             0001*   
047B17 40          0002*   player_shields: db 64
047B18 40          0003*   player_shields_max: db 64
047B19             0004*   ; player_shields_max: db 8 ; DEBUG
047B19 00          0005*   player_shields_last: db 0
047B1A             0006*   bar_shields:
047B1A 00 00 00    0007*       dl 0 ; value
047B1D F0 01 00    0008*       dl 496 ; x0
047B20 30 01 00    0009*       dl 304 ; y0
047B23 F7 01 00    0010*       dl 496+7 ; x1
047B26 6F 01 00    0011*       dl 304+63 ; y1
