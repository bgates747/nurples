047BE4 E6 1F       0058*       and %00011111   ; keep only 5 lowest bits (max 31)
047BE6 C6 40       0059*       add a,64 ; range is now 64-127
047BE8 FD 77 24    0060*       ld (iy+tile_move_timer),a ; when this hits zero,will spawn a seeker
047BEB C9          0061*       ret
