049151             0134*   @scan_done:
049151             0135*   ; Rediscover the source cursor after any compaction. This search is bounded by
049151             0136*   ; the current dense-stack count and validates each slot before loading it.
049151 3A 3B 89 04 0137*       ld a,(num_active_tiles)
049155 32 CB 91 04 0138*       ld (@tiles_remaining),a
049159 FD 21 32 86 0139*       ld iy,tile_stack
       04          
04915E             0140*   @find_loop:
04915E 3A CB 91 04 0141*       ld a,(@tiles_remaining)
049162 B7          0142*       or a
049163 CA A5 91 04 0143*       jp z,@source_not_found
049167 3D          0144*       dec a
049168 32 CB 91 04 0145*       ld (@tiles_remaining),a
04916C FD E5       0146*       push iy
04916E E1          0147*       pop hl
04916F CD E2 89 04 0148*       call tile_stack_pointer_valid
049173 D2 A5 91 04 0149*       jp nc,@source_not_found
049177 FD 27 00    0150*       ld hl,(iy)
04917A ED 33 03    0151*       lea iy,iy+3 ; next tile stack record
04917D ED 5B C8 91 0152*       ld de,(@source_tile_pointer)
       04          
049182 B7          0153*       or a ; clear carry
049183 ED 52       0154*       sbc hl,de ; if not the same address, loop
049185 C2 5E 91 04 0155*       jp nz,@find_loop
049189 ED 33 FD    0156*       lea iy,iy-3 ; back up to the record we want
04918C FD 22 35 89 0157*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
049191 FD 37 00    0158*       ld iy,(iy) ; iy points to the tile stack record
049194 CD 1B 8A 04 0159*       call tile_table_record_pointer_valid
049198 D2 A5 91 04 0160*       jp nc,@source_not_found
04919C FD 22 38 89 0161*       ld (tile_table_pointer),iy ; set pointer to this tile record
       04          
0491A1 C3 F1 8F 04 0162*       jp transform_active_tile_to_crater
0491A5             0163*   @source_not_found:
0491A5             0164*   ; Fail closed and make the outer traversal's normal +3 step land exactly on
0491A5             0165*   ; the current logical end. It will then stop on the validated range check.
0491A5 21 42 89 04 0166*       ld hl,tile_fault_flags
0491A9 CB C6       0167*       set tile_fault_bad_record,(hl)
0491AB 3A 3B 89 04 0168*       ld a,(num_active_tiles)
0491AF 21 00 00 00 0169*       ld hl,0
0491B3 67          0170*       ld h,a
0491B4 2E 03       0171*       ld l,3
0491B6 ED 6C       0172*       mlt hl
0491B8 11 2F 86 04 0173*       ld de,tile_stack-3
0491BC 19          0174*       add hl,de
0491BD 22 35 89 04 0175*       ld (tile_stack_pointer),hl
0491C1 C9          0176*       ret
0491C2 32 86 04    0177*   @tile_stack_pointer: dl tile_stack ; pointer to current stack record, initialized to tile_stack
0491C5 00 00 00    0178*   @tile_y: dl 0 ; y position of tiles to kill
0491C8 00 00 00    0179*   @source_tile_pointer: dl 0
0491CB 00          0180*   @tiles_remaining: db 0
0491CC             0181*   ; end move_electrode
