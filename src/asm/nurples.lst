047882             0059*   ; Exact stabilization whitelist for writable legacy tile callbacks.
047882             0060*   ; inputs: iy = validated tile record, hl = stored callback
047882             0061*   ; outputs: carry set and hl = expected callback on an exact type/program match
047882             0062*   ; destroys: a,de,hl
047882             0063*   tile_move_program_valid:
047882 FD 7E 16    0064*       ld a,(iy+tile_type)
047885 FE 01       0065*       cp tile_pad_small
047887 CA A7 78 04 0066*       jp z,@pad_small
04788B FE 05       0067*       cp tile_turret_fireball
04788D CA AF 78 04 0068*       jp z,@turret_fireball
047891 FE 09       0069*       cp tile_electrode
047893 CA B7 78 04 0070*       jp z,@electrode
047897 FE 0A       0071*       cp tile_lightning
047899 CA BF 78 04 0072*       jp z,@lightning
04789D FE 10       0073*       cp tile_crater
04789F CA C7 78 04 0074*       jp z,@crater
0478A3 C3 D6 78 04 0075*       jp @invalid
0478A7             0076*   @pad_small:
0478A7 11 49 7C 04 0077*       ld de,move_pad_small
0478AB C3 CB 78 04 0078*       jp @compare
0478AF             0079*   @turret_fireball:
