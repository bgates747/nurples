048DF6 01          0009*       db 1                    ; num_animations
048DF7 00          0010*       db 0                    ; animation
048DF8 00          0011*       db 0                    ; animation_timer
048DF9 00          0012*       db 0                    ; move_timer
048DFA 00          0013*       db 0                    ; move_step
