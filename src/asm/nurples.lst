04672A 11 30 00 00 0019*       ld de,origin_top
04672E CD 67 14 04 0020*       call vdu_set_gfx_origin
046732 01 00 00 00 0021*       ld bc,field_left
046736 11 00 00 00 0022*       ld de,field_top
04673A DD 21 FF 00 0023*       ld ix,field_right
       00          
04673F FD 21 4F 01 0024*       ld iy,field_bottom
       00          
046744 CD 82 14 04 0025*       call vdu_set_gfx_viewport
046748 C9          0026*       ret
