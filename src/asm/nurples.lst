048134             0144*   
048134             0145*   ; gets the next available sprite id for a particular sprite group
048134             0146*   ; inputs; ix = pointer to sprite group, b = number of records in sprite group
048134             0147*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
048134             0148*   ;      otherwise, a = 0, carry flag reset, ix pointing to highest sprite vars
048134             0149*   ; destroys: a,b,c,hl,ix
048134             0150*   table_get_next_id:
048134             0151*   @loop:
048134 DD CB 1D 76 0152*       bit sprite_alive,(ix+sprite_collisions)
048138 28 07       0153*       jr z,@found
04813A ED 32 40    0154*       lea ix,ix+table_record_size
04813D 10 F5       0155*       djnz @loop
04813F             0156*   @notfound:
04813F AF          0157*       xor a ; a = 0 and reset carry flag indicating that we didn't find a free sprite
048140 C9          0158*       ret
048141             0159*   @found:
048141             0160*   ; return sprite id
048141 DD 7E 00    0161*       ld a,(ix+sprite_id)
048144 37          0162*       scf ; sets carry flag indicating we found a free sprite
048145 C9          0163*       ret ; done
048146             0164*   ; end table_get_next_id
048146             0165*   
048146             0166*   ; create a new sprite at the prescribed coordinates
048146             0167*   ; inputs: hl = pointer to new sprite default settings, ub.c, ud.e = x,y position
048146             0168*   ;         ix = pointer to sprite group, a = number of records in sprite group
048146             0169*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
048146             0170*   ;      otherwise, a = 0, carry flag reset, ix pointing to highest sprite vars
048146             0171*   spawn_sprite_from_coords:
048146 ED 43 80 81 0172*       ld (@sprite_x),bc ; store x-coordinate
       04          
04814B ED 53 83 81 0173*       ld (@sprite_y),de ; store y-coordinate
       04          
048150 47          0174*       ld b,a ; number of records in sprite group
048151 E5          0175*       push hl ; back up pointer to new sprite defaults
048152 CD 34 81 04 0176*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
048156 E1          0177*       pop hl ; restore pointer to new sprite defaults
048157 D0          0178*       ret nc ; no carry means no free sprite slots, so we go home
048158             0179*   ; copy default settings to new sprite
048158 DD E5       0180*       push ix ; back up pointer to new sprite record
04815A ED 32 16    0181*       lea ix,ix+sprite_definitions ; bump pointer to copy to
04815D DD E5       0182*       push ix ; pointer to default sprite settings
04815F D1          0183*       pop de ; address to copy to
048160 01 2A 00 00 0184*       ld bc,table_record_size-sprite_definitions ; number of bytes to copy
048164 ED B0       0185*       ldir ; copies defaults to new sprite record
048166 DD E1       0186*       pop ix ; restore pointer to new sprite record
048168             0187*   ; copy sprite position from existing sprite
048168 2A 80 81 04 0188*       ld hl,(@sprite_x)
04816C DD 2F 01    0189*       ld (ix+sprite_x),hl
04816F 2A 83 81 04 0190*       ld hl,(@sprite_y)
048173 DD 2F 04    0191*       ld (ix+sprite_y),hl
048176             0192*   ; return to caller
048176 DD CB 16 FE 0193*       set 7,(ix+sprite_type) ; set just spawned flag
04817A DD CB 1D F6 0194*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
04817E 37          0195*       scf ; set carry flag to indicate success
04817F C9          0196*       ret
048180 00 00 00    0197*   @sprite_x: dl 0 ; new sprite x-coordinate
048183 00 00 00    0198*   @sprite_y: dl 0 ; new sprite y-coordinate
048186             0199*   ; end spawn_sprite_from_coords
048186             0200*   
048186             0201*   ; create a new sprite at the same location as an existing sprite
048186             0202*   ; inputs: hl = pointer to new sprite default settings, table_pointer = existing sprite
048186             0203*   ;         ix = pointer to sprite group, b = number of records in sprite group
048186             0204*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
048186             0205*   ;      otherwise, a = 0, carry flag reset, ix pointing to highest sprite vars
048186             0206*   spawn_sprite_from_sprite:
048186 E5          0207*       push hl ; back up pointer to new sprite defaults
048187 CD 34 81 04 0208*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
04818B E1          0209*       pop hl ; restore pointer to new sprite defaults
04818C D0          0210*       ret nc ; no carry means no free sprite slots, so we go home
04818D             0211*   ; copy default settings to new sprite
04818D DD E5       0212*       push ix ; back up pointer to new sprite record
04818F ED 32 16    0213*       lea ix,ix+sprite_definitions ; bump pointer to copy to
048192 DD E5       0214*       push ix ; pointer to default sprite settings
048194 D1          0215*       pop de ; address to copy to
048195 01 2A 00 00 0216*       ld bc,table_record_size-sprite_definitions ; number of bytes to copy
048199 ED B0       0217*       ldir ; copies defaults to new sprite record
04819B DD E1       0218*       pop ix ; restore pointer to new sprite record
04819D             0219*   ; copy sprite position from existing sprite
04819D FD 2A 89 80 0220*       ld iy,(table_pointer) ; get existing sprite record
       04          
0481A2 FD 27 01    0221*       ld hl,(iy+sprite_x)
0481A5 DD 2F 01    0222*       ld (ix+sprite_x),hl
0481A8 FD 27 04    0223*       ld hl,(iy+sprite_y)
0481AB DD 2F 04    0224*       ld (ix+sprite_y),hl
0481AE             0225*   ; return to caller
0481AE DD CB 16 FE 0226*       set 7,(ix+sprite_type) ; set just spawned flag
0481B2 DD CB 1D F6 0227*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
0481B6 37          0228*       scf ; set carry flag to indicate success
0481B7 C9          0229*       ret
0481B8             0230*   ; end spawn_sprite_from_sprite
0481B8             0231*   
0481B8             0232*   ; call the behavior subroutines for a specified sprite group
0481B8             0233*   ; inputs: iy = pointer to sprite group, b = number of records in sprite group
0481B8             0234*   move_sprite_group:
0481B8 C5          0235*       push bc ; backup loop counter
0481B9 FD E5       0236*       push iy ; backup table pointer
0481BB             0237*   @move_loop:
0481BB FD 22 89 80 0238*       ld (table_pointer),iy ; update table pointer
       04          
0481C0 C5          0239*       push bc ; backup loop counter
0481C1             0240*   ; check top bit of sprite_type to see if sprite is just spawned
0481C1 FD CB 16 7E 0241*       bit 7,(iy+sprite_type)
0481C5 C2 FA 81 04 0242*       jp nz,@next_record ; if just spawned, skip to next record
0481C9             0243*   ; check sprite_just_died bit
0481C9 FD CB 1D 7E 0244*       bit sprite_just_died,(iy+sprite_collisions)
0481CD C2 31 82 04 0245*       jp nz,@sprite_died ; if just died, deactivate sprite
0481D1             0246*   ; check sprite_alive bit to see if sprite is active
0481D1 FD CB 1D 76 0247*       bit sprite_alive,(iy+sprite_collisions)
0481D5 CA FA 81 04 0248*       jp z,@next_record ; ... skip to next record
0481D9             0249*   ; otherwise move the sprite
0481D9 FD 27 1A    0250*       ld hl,(iy+sprite_move_program) ; load the behavior subroutine address
0481DC             0251*       CALL_HL ; run the behavior subroutine
                       M1 Args: none
0481DC 01 E2 81 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
0481E0 C5          0002*M1     push bc ; which constitutes the return address
0481E1 E9          0003*M1     jp (hl) ; Jump to the address in HL
0481E2 FD 7E 00    0252*       ld a,(iy+sprite_id) ; get spriteId
0481E5 CD DB 18 04 0253*       call vdu_sprite_select ; select sprite
0481E9 FD 7E 28    0254*       ld a,(iy+sprite_frame)
0481EC CD 3E 19 04 0255*       call vdu_sprite_select_frame
0481F0 FD 07 01    0256*       ld bc,(iy+sprite_x)
0481F3 FD 17 04    0257*       ld de,(iy+sprite_y)
0481F6 CD A7 19 04 0258*       call vdu_sprite_move_abs168
0481FA             0259*   ; fall through to @next_record
0481FA             0260*   @next_record:
0481FA ED 33 40    0261*       lea iy,iy+table_record_size
0481FD AF          0262*       xor a ; clears carry flag
0481FE 32 8C 80 04 0263*       ld (sprite_screen_edge),a ; clear screen edge collision flag
048202 C1          0264*       pop bc ; get back our loop counter
048203 10 B6       0265*       djnz @move_loop ; loop until we've checked all the records
048205             0266*   ; reset all just spawned flags
048205 FD E1       0267*       pop iy ; get back table pointer
048207 C1          0268*       pop bc ; get back loop counter
048208             0269*   @reset_just_spawned:
048208 C5          0270*       push bc ; back up loop counter
048209 FD CB 16 7E 0271*       bit 7,(iy+sprite_type) ; check if just spawned
04820D CA 2A 82 04 0272*       jp z,@F
048211 FD CB 16 BE 0273*       res 7,(iy+sprite_type) ; clear just spawned flag
048215 FD 7E 00    0274*       ld a,(iy+sprite_id)
048218 CD DB 18 04 0275*       call vdu_sprite_select
04821C FD 07 01    0276*       ld bc,(iy+sprite_x)
04821F FD 17 04    0277*       ld de,(iy+sprite_y)
048222 CD A7 19 04 0278*       call vdu_sprite_move_abs168
048226 CD 51 19 04 0279*       call vdu_sprite_show
04822A             0280*   @@:
04822A ED 33 40    0281*       lea iy,iy+table_record_size
04822D C1          0282*       pop bc ; get back loop counter
04822E 10 D8       0283*       djnz @reset_just_spawned
048230 C9          0284*       ret
048231             0285*   @sprite_died:
048231 CD D2 80 04 0286*       call table_deactivate_sprite
048235 C3 FA 81 04 0287*       jp @next_record
048239             0288*   ; end move_sprite_group
048239             0289*   
048239             0290*   ; update behavior subroutines for a specified sprite group
048239             0291*   ; inputs: hl = pointer to move program, iy = pointer to sprite group, b = number of records in sprite group
048239             0292*   change_sprite_group_move_program:
048239             0293*   @update_loop:
048239             0294*   ; check sprite_alive bit to see if sprite is active
048239 FD CB 1D 76 0295*       bit sprite_alive,(iy+sprite_collisions)
04823D CA 48 82 04 0296*       jp z,@next_record ; ... skip to next record
048241             0297*   ; otherwise load the behavior subroutine address
048241 FD 2F 1A    0298*       ld (iy+sprite_move_program),hl
048244             0299*    ; clear just spawned flag
048244 FD CB 16 BE 0300*       res 7,(iy+sprite_type)
048248             0301*   ; fall through to @next_record
048248             0302*   @next_record:
048248 ED 33 40    0303*       lea iy,iy+table_record_size
04824B 10 EC       0304*       djnz @update_loop ; loop until we've checked all the records
04824D C9          0305*       ret
04824E             0306*   ; end change_sprite_group_move_program
04824E             0307*   
04824E             0308*   ; compute a sprite's new position based on its component x,y velocities
04824E             0309*   ; with screen boundary checking and update its sprite table record accordingly
04824E             0310*   ; inputs: table_pointer set to sprite record
04824E             0311*   ; returns: updated x, y positions and edge collision flags in sprite_screen_edge
04824E             0312*   ; destroys: everything
04824E             0313*   ; note: actual rendering of sprite must be handled by caller
04824E             0314*   move_sprite:
04824E FD 2A 89 80 0315*       ld iy,(table_pointer)
       04          
048253             0316*   ; x-axis movement
048253 FD 27 01    0317*       ld hl,(iy+sprite_x)
048256 FD 17 07    0318*       ld de,(iy+sprite_xvel)
048259 19          0319*       add hl,de
04825A FD 2F 01    0320*       ld (iy+sprite_x),hl
04825D             0321*   ; y-axis movement
04825D FD 27 04    0322*       ld hl,(iy+sprite_y)
048260 FD 17 0A    0323*       ld de,(iy+sprite_yvel)
048263 19          0324*       add hl,de
048264 FD 2F 04    0325*       ld (iy+sprite_y),hl
048267             0326*   ; detect screen edge collisions
048267 AF          0327*       xor a ; reset screen edge collision flag and clear carry
048268 32 8C 80 04 0328*       ld (sprite_screen_edge),a
04826C             0329*   ; y-axis first since we already have it in hl
04826C 11 00 00 00 0330*       ld de,-sprite_top*256
048270 ED 5A       0331*       adc hl,de
048272 FA 9C 82 04 0332*       jp m,@top
048276 ED 52       0333*       sbc hl,de ; hl back to original value
048278 11 00 C0 FE 0334*       ld de,-sprite_bottom*256
04827C ED 5A       0335*       adc hl,de
04827E F2 A6 82 04 0336*       jp p,@bottom
048282             0337*   @xaxis:
048282 FD 27 01    0338*       ld hl,(iy+sprite_x)
048285 11 00 00 00 0339*       ld de,-sprite_left*256
048289 ED 5A       0340*       adc hl,de
04828B FA C1 82 04 0341*       jp m,@left
04828F ED 52       0342*       sbc hl,de ; hl back to original value
048291 11 00 10 FF 0343*       ld de,-sprite_right*256
048295 ED 5A       0344*       adc hl,de
048297 F2 CF 82 04 0345*       jp p,@right
04829B             0346*   ; no edge collisions so go home
04829B C9          0347*       ret
04829C             0348*   @top:
04829C 3E 08       0349*       ld a,collide_top
04829E 21 00 00 00 0350*       ld hl,sprite_top*256
0482A2 C3 AC 82 04 0351*       jp @collide_y
0482A6             0352*   @bottom:
0482A6 3E 04       0353*       ld a,collide_bottom
0482A8 21 00 40 01 0354*       ld hl,sprite_bottom*256
0482AC             0355*   @collide_y:
0482AC 32 8C 80 04 0356*       ld (sprite_screen_edge),a
0482B0 FD 2F 04    0357*       ld (iy+sprite_y),hl
0482B3             0358*   ; reverse y-axis velocity
0482B3 FD 27 0A    0359*       ld hl,(iy+sprite_yvel)
0482B6 CD 80 04 04 0360*       call neg_hlu
0482BA FD 2F 0A    0361*       ld (iy+sprite_yvel),hl
0482BD             0362*   ; go check for x-axis collisions
0482BD C3 82 82 04 0363*       jp @xaxis
0482C1             0364*   @left:
0482C1 3A 8C 80 04 0365*       ld a,(sprite_screen_edge)
0482C5 F6 02       0366*       or a,collide_left
0482C7 21 00 00 00 0367*       ld hl,sprite_left*256
0482CB C3 D9 82 04 0368*       jp @collide_x
0482CF             0369*   @right:
0482CF 3A 8C 80 04 0370*       ld a,(sprite_screen_edge)
0482D3 F6 01       0371*       or a,collide_right
0482D5 21 00 F0 00 0372*       ld hl,sprite_right*256
0482D9             0373*   @collide_x:
0482D9 32 8C 80 04 0374*       ld (sprite_screen_edge),a
0482DD FD 2F 01    0375*       ld (iy+sprite_x),hl
0482E0             0376*   ; reverse x-axis velocity
0482E0 FD 27 07    0377*       ld hl,(iy+sprite_xvel)
0482E3 CD 80 04 04 0378*       call neg_hlu
0482E7 FD 2F 07    0379*       ld (iy+sprite_xvel),hl
0482EA             0380*   ; final collision flag to a and return
0482EA 3A 8C 80 04 0381*       ld a,(sprite_screen_edge)
0482EE C9          0382*       ret
0482EF             0383*   ; end move_sprite
0482EF             0384*   
0482EF             0385*   sprite_compute_velocities:
0482EF FD 27 10    0386*       ld hl,(iy+sprite_heading)
0482F2 FD 17 0D    0387*       ld de,(iy+sprite_vel)
0482F5 CD F4 06 04 0388*       call polar_to_cartesian
0482F9 FD 2A 89 80 0389*       ld iy,(table_pointer)
       04          
0482FE FD 0F 07    0390*       ld (iy+sprite_xvel),bc ; save x-velocity component
048301 FD 1F 0A    0391*       ld (iy+sprite_yvel),de ; save y-velocity component
048304 C9          0392*       ret
048305             0393*   ; end sprite_compute_velocities
048305             0394*   
048305             0395*   ; compute animation frame based on sprite_animation and sprite_heading
048305             0396*   ; inputs: table_pointer set to sprite record
048305             0397*   ; outputs: a, sprite_frame set to animation frame
048305             0398*   ; destroys: a,hl
048305             0399*   sprite_frame_heading_animation:
048305 FD 7E 11    0400*       ld a,(iy+sprite_heading+1) ; we want the integer portion
048308 CB 3F       0401*       srl a ; divide integer portion by 8
04830A CB 3F       0402*       srl a
04830C CB 3F       0403*       srl a
04830E FD 66 22    0404*       ld h,(iy+sprite_animation)
048311 2E 20       0405*       ld l,32 ; 32 orientation frames per animation
048313 ED 6C       0406*       mlt hl ; hl = offset from base animation
048315 85          0407*       add a,l ; modulo256 since sprite_frame is only 1 byte
048316 FD 77 28    0408*       ld (iy+sprite_frame),a
048319 C9          0409*       ret
04831A             0410*   ; end sprite_frame_heading_animation
04831A             0411*   
04831A             0412*   ; compute animation frame based on sprite_heading
04831A             0413*   ; inputs: table_pointer set to sprite record
04831A             0414*   ; outputs: a, sprite_frame set to animation frame
04831A             0415*   ; destroys: a,hl
04831A             0416*   sprite_frame_heading:
04831A FD 7E 11    0417*       ld a,(iy+sprite_heading+1) ; we want the integer portion
04831D CB 3F       0418*       srl a ; divide integer portion by 8
04831F CB 3F       0419*       srl a
048321 CB 3F       0420*       srl a
048323 FD 77 28    0421*       ld (iy+sprite_frame),a
048326 C9          0422*       ret
048327             0423*   ; end sprite_frame_heading
048327             0424*   
048327             0425*   ; load a sprite with animation bitmaps
048327             0426*   ; inputs: a = sprite id, hl = base bufferId, bc = number of frames, sprite_select
048327             0427*   sprite_load_frames:
048327             0428*   ; back up input parameters
048327 E5          0429*       push hl ; base bufferId
048328 C5          0430*       push bc ; bc = number of frames
048329 CD EE 18 04 0431*       call vdu_sprite_clear_frames
04832D C1          0432*       pop bc ; bc = number of frames
04832E E1          0433*       pop hl ; = base bufferId
04832F             0434*   @load_frames:
04832F C5          0435*       push bc ; back up loop counter
048330 E5          0436*       push hl ; back up base bufferId
048331 CD 30 1A 04 0437*       call vdu_sprite_add_buff
048335 E1          0438*       pop hl ; restore base bufferId
048336 23          0439*       inc hl ; bump it to the next frame
048337             0440*   ; decrement loop counter
048337 C1          0441*       pop bc
048338 0B          0442*       dec bc
048339 79          0443*       ld a,c
04833A B7          0444*       or a
04833B C2 2F 83 04 0445*       jp nz,@load_frames
04833F 78          0446*       ld a,b
048340 B7          0447*       or a
048341 C2 2F 83 04 0448*       jp nz,@load_frames
048345 C9          0449*       ret
048346             0450*   ; end sprite_load_frames
