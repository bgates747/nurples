0491CC             0007*   lightning_defaults:
0491CC 0A          0008*       db tile_lightning       ; type
0491CD 50 01 00    0009*       dl BUF_LIGHTNING_H_0    ; base_bufferId
0491D0 E9 91 04    0010*       dl move_lightning       ; move_program
0491D3 40          0011*       db %01000000            ; collisions bit 6 signals sprite alive
0491D4 10          0012*       db 16                   ; dim_x
0491D5 10          0013*       db 16                   ; dim_y
0491D6 01          0014*       db 1                    ; num_orientations
0491D7 02          0015*       db 2                    ; num_animations
0491D8 00          0016*       db 0                    ; animation
0491D9 08          0017*       db 8                    ; animation_timer
0491DA 00          0018*       db 0                    ; move_timer
0491DB 00          0019*       db 0                    ; move_step
0491DC 00          0020*       db 0                    ; points
0491DD FF          0021*       db -1                    ; shield_damage
0491DE 00          0022*       db 0                    ; frame
0491DF             0023*   
0491DF             0024*   activate_lightning:
0491DF 21 CC 91 04 0025*       ld hl,lightning_defaults
0491E3             0026*   ; get next available active tile id
0491E3 CD E9 8A 04 0027*       call spawn_active_tile
0491E7 D0          0028*       ret nc ; no carry means no free active tile slots, so we go home
0491E8             0029*   ; other specific initialization
0491E8 C9          0030*       ret
0491E9             0031*   ; end activate_lightning
0491E9             0032*   
0491E9             0033*   move_lightning:
0491E9 CD 42 8E 04 0034*       call move_active_tile
0491ED CA 51 8A 04 0035*       jp z,table_deactivate_tile
0491F1 CD 2D 4A 04 0036*       call check_enemy_collision_laser ; kills laser on collision but does not die
0491F5 DD 21 E2 A4 0037*       ld ix,player_begin
       04          
0491FA DD CB 1D 76 0038*       bit sprite_alive,(ix+sprite_collisions)
0491FE CA 0E 92 04 0039*       jp z,@animate ; player is dead so don't check for collisions
049202 CD 39 4A 04 0040*       call check_enemy_collision_player
049206 C2 0E 92 04 0041*       jp nz,@animate ; no collision so do animation
04920A CD 42 7B 04 0042*       call update_shields
04920E             0043*   @animate:
04920E FD 35 23    0044*       dec (iy+tile_animation_timer)
049211 C0          0045*       ret nz ; not time to animate
049212             0046*   ; reset the animation timer and bump animation
049212 3E 08       0047*       ld a,8
049214 FD 77 23    0048*       ld (iy+tile_animation_timer),a
049217 FD 7E 28    0049*       ld a,(iy+tile_frame)
04921A 3C          0050*       inc a
04921B E6 01       0051*       and %00000001 ; modulo 1
04921D FD 77 28    0052*       ld (iy+tile_frame),a
049220 C3 3C 8F 04 0053*       jp draw_active_tile
049224 C9          0054*       ret
