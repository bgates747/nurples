041AA4             0209*   ; inputs from stomping on each other
041AA4 ED 53 C3 1A 0210*       ld (@dy-1),de
       04          
041AA9 ED 43 C1 1A 0211*       ld (@dx-1),bc
       04          
041AAE 3E 0E       0212*       ld a,14       ; restore the final byte of the command
041AB0 32 C1 1A 04 0213*       ld (@cmd+2),a ; string that got stomped on by bcu
041AB4 21 BF 1A 04 0214*       ld hl,@cmd
041AB8 01 07 00 00 0215*       ld bc,@end-@cmd
041ABC 5B DF       0216*       rst.lil $18
041ABE C9          0217*       ret
041ABF 17 1B 0E    0218*   @cmd:  db 23,27,14
041AC2 00 00       0219*   @dx: dw 0x0000
041AC4 00 00       0220*   @dy: dw 0x0000
041AC6             0221*   @end:  ; no padding required b/c we shifted de right
041AC6             0222*   
041AC6             0223*   ; VDU 23, 27, 15: Update the sprites in the GPU
041AC6             0224*   ; inputs: none
041AC6             0225*   vdu_sprite_update:
041AC6 21 D1 1A 04 0226*       ld hl,@cmd
041ACA 01 03 00 00 0227*       ld bc,@end-@cmd
041ACE 5B DF       0228*       rst.lil $18
041AD0 C9          0229*       ret
041AD1 17 1B 0F    0230*   @cmd: db 23,27,15
041AD4             0231*   @end:
041AD4             0232*   
041AD4             0233*   ; VDU 23, 27, 16: Reset bitmaps and sprites and clear all data
041AD4             0234*   ; inputs: none
041AD4             0235*   vdu_sprite_bmp_reset:
041AD4 21 DF 1A 04 0236*       ld hl,@cmd
041AD8 01 03 00 00 0237*       ld bc,@end-@cmd
041ADC 5B DF       0238*       rst.lil $18
041ADE C9          0239*       ret
041ADF 17 1B 10    0240*   @cmd: db 23,27,16
041AE2             0241*   @end:
041AE2             0242*   
041AE2             0243*   ; VDU 23, 27, 17: Reset sprites (only) and clear all data
041AE2             0244*   ; inputs: none
041AE2             0245*   vdu_sprite_reset:
041AE2 21 ED 1A 04 0246*       ld hl,@cmd
041AE6 01 03 00 00 0247*       ld bc,@end-@cmd
041AEA 5B DF       0248*       rst.lil $18
041AEC C9          0249*       ret
041AED 17 1B 11    0250*   @cmd: db 23,27,17
041AF0             0251*   @end:
041AF0             0252*   
041AF0             0253*   ; VDU 23, 27, 18, n: Set the current sprite GCOL paint mode to n **
041AF0             0254*   ; inputs: a is the GCOL paint mode
041AF0             0255*   ; prerequisites: vdu_sprite_select
041AF0             0256*   vdu_sprite_set_gcol:
041AF0 32 02 1B 04 0257*       ld (@mode),a
041AF4 21 FF 1A 04 0258*       ld hl,@cmd
041AF8 01 04 00 00 0259*       ld bc,@end-@cmd
041AFC 5B DF       0260*       rst.lil $18
041AFE C9          0261*       ret
041AFF 17 1B 12    0262*   @cmd:  db 23,27,18
041B02 00          0263*   @mode: db 0x00
041B03             0264*   @end:
041B03             0265*   
