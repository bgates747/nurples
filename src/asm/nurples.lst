049053             0043*   ; check player alive
049053 DD 21 9E 9C 0044*       ld ix,player_begin
       04          
049058 DD CB 1D 76 0045*       bit sprite_alive,(ix+sprite_collisions)
04905C C8          0046*       ret z ; player dead so nothing more to do
04905D             0047*   ; check whether it is time to spawn a fireball
04905D FD 35 24    0048*       dec (iy+tile_move_timer)
049060 C0          0049*       ret nz
049061             0050*   ; spwan a fireball
049061 CD 5A 20 04 0051*       call enemy_spawn_fireball
049065             0052*       ; fall through to reset move timer
049065             0053*   turret_fireball_reset_move_timer:
049065 CD 14 05 04 0054*       call rand_8     ; snag a random number
049069 E6 1F       0055*       and %00011111   ; keep only 5 lowest bits (max 31)
