04121F 22 E3 11 04 0225*       ld (prt_irq_counter),hl
041223 2A 57 12 04 0226*       ld hl,(prt_loops)
041227 23          0227*       inc hl
041228 22 57 12 04 0228*       ld (prt_loops),hl
04122C D1          0229*       pop de
04122D E1          0230*       pop hl
