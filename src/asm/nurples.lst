0494D4 DD 21 23 A2 0031*       ld ix,player_begin
       04          
0494D9 DD CB 1D 76 0032*       bit sprite_alive,(ix+sprite_collisions)
0494DD CA ED 94 04 0033*       jp z,@animate ; player is dead so don't check for collisions
0494E1 CD 7D 20 04 0034*       call check_enemy_collision_player
0494E5 C2 ED 94 04 0035*       jp nz,@animate ; no collision so do animation
0494E9 CD 8F 81 04 0036*       call update_shields
0494ED             0037*   @animate:
0494ED FD 35 23    0038*       dec (iy+tile_animation_timer)
0494F0 C0          0039*       ret nz ; not time to animate
0494F1             0040*   ; reset the animation timer and bump animation
0494F1 3E 08       0041*       ld a,8
0494F3 FD 77 23    0042*       ld (iy+tile_animation_timer),a
0494F6 FD 7E 28    0043*       ld a,(iy+tile_frame)
0494F9 3C          0044*       inc a
0494FA E6 01       0045*       and %00000001 ; modulo 1
0494FC FD 77 28    0046*       ld (iy+tile_frame),a
0494FF C3 3E 92 04 0047*       jp draw_active_tile
049503 C9          0048*       ret
