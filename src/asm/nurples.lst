0473BA 00 00 00    0034*       dl 0 ; list terminator
0473BD             0035*   tile_stack_end:
0473BD BA 70 04    0036*   tile_stack_pointer: dl tile_stack ; pointer to current stack record, initialized to tile_stack
0473C0 1A 8D 04    0037*   tile_table_pointer: dl tile_table_base ; pointer to top address of current record, initialized to tile_table_base
0473C3 00 00 00    0038*   num_active_tiles: dl 0 ; how many active tiles
0473C6 00          0039*   next_tile_id: db 0 ; next available tile id
0473C7 00 00 00    0040*   new_tile_table_pointer: dl 0 ; pointer to new tile record
0473CA             0041*   tile_fault_bad_record: equ 0
0473CA             0042*   tile_fault_bad_move_program: equ 1
0473CA             0043*   tile_fault_bad_deactivation: equ 2
0473CA 00          0044*   tile_fault_flags: db 0 ; latched fail-closed diagnostics
0473CB             0045*   
0473CB             0046*   tile_table_init:
0473CB             0047*   ; reset num active tiles
0473CB 21 00 00 00 0048*       ld hl,0
0473CF 22 C3 73 04 0049*       ld (num_active_tiles),hl
0473D3             0050*   ; reset next tile id
0473D3 AF          0051*       xor a
0473D4 32 C6 73 04 0052*       ld (next_tile_id),a
0473D8 32 CA 73 04 0053*       ld (tile_fault_flags),a
0473DC             0054*   ; clear the tile stack
0473DC AF          0055*       xor a ; write zeroes to tile stack
0473DD 21 BA 70 04 0056*       ld hl,tile_stack
0473E1 01 03 03 00 0057*       ld bc,tile_stack_end-tile_stack
0473E5 CD 5B 03 04 0058*       call clear_mem
0473E9             0059*   ; clear the tile table
0473E9 AF          0060*       xor a ; write zeroes to tile table
0473EA 21 1A 8D 04 0061*       ld hl,tile_table_base ; address to copy from
0473EE 01 00 40 00 0062*       ld bc,tile_table_end-tile_table_base ; number of bytes to clear
0473F2 CD 5B 03 04 0063*       call clear_mem
0473F6             0064*   ; write tile ids
0473F6 DD 21 1A 8D 0065*       ld ix,tile_table_base
       04          
0473FB AF          0066*       xor a ; tile id
0473FC 06 00       0067*       ld b,0 ; loop counter
0473FE             0068*   @loop:
0473FE DD 77 00    0069*       ld (ix+tile_id),a
047401 ED 32 40    0070*       lea ix,ix+table_record_size
047404 3C          0071*       inc a
047405 10 F7       0072*       djnz @loop
047407             0073*   ; set pointers to top of tile stack and tile table
047407 21 C6 73 04 0074*       ld hl,next_tile_id
04740B 3E FF       0075*       ld a,255 ; will wrap around to 0 on first call to create active tile
04740D 77          0076*       ld (hl),a
04740E 21 1A 8D 04 0077*       ld hl,tile_table_base
047412 22 C0 73 04 0078*       ld (tile_table_pointer),hl
047416 21 BA 70 04 0079*       ld hl,tile_stack
04741A 22 BD 73 04 0080*       ld (tile_stack_pointer),hl
04741E C9          0081*       ret
04741F             0082*   ; end tile_table_init
04741F             0083*   
04741F             0084*   ; gets the next available tile id
04741F             0085*   ; inputs; none
04741F             0086*   ; returns: if new tile available, a = tile id, ix pointing to new tile vars, carry set
04741F             0087*   ;      otherwise, a = 0, carry flag reset, ix invalid and must not be dereferenced
04741F             0088*   ; destroys: a,b,de,hl,ix
04741F             0089*   ; affects: on success, bumps num_active_tiles by one, adds a tile pointer to the top of the tile stack
04741F             0090*   tile_table_get_next_id:
04741F             0091*   ; The byte-sized active count deliberately caps the dense stack at 255 entries.
04741F 3A C3 73 04 0092*       ld a,(num_active_tiles)
047423 3C          0093*       inc a
047424 CA 49 74 04 0094*       jp z,@not_found
047428             0095*   ; Search the entire ring rather than assuming the next physical record is free.
047428 06 00       0096*       ld b,0 ; DJNZ with zero visits all 256 tile records
04742A 3A C6 73 04 0097*       ld a,(next_tile_id)
04742E             0098*   @search:
04742E 3C          0099*       inc a
04742F 11 00 00 00 0100*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
047433 57          0101*       ld d,a ; candidate index into tile table
047434 1E 40       0102*       ld e,tile_table_record_size
047436 ED 5C       0103*       mlt de ; de is now the offset to the table entry
047438 DD 21 1A 8D 0104*       ld ix,tile_table_base ; point to base address of tile table
       04          
04743D DD 19       0105*       add ix,de ; ix is now the address of the table entry
04743F DD CB 1D 76 0106*       bit sprite_alive,(ix+tile_collisions)
047443 CA 4B 74 04 0107*       jp z,@found
047447 10 E5       0108*       djnz @search
047449             0109*   @not_found:
047449 AF          0110*       xor a ; reset carry flag indicating that we didn't find a free tile
04744A C9          0111*       ret
04744B             0112*   @found:
04744B 32 C6 73 04 0113*       ld (next_tile_id),a
04744F DD 77 00    0114*       ld (ix+tile_id),a ; repair the stable identity byte before publishing it
047452 21 C3 73 04 0115*       ld hl,num_active_tiles
047456 34          0116*       inc (hl)
047457 7E          0117*       ld a,(hl) ; number of active tiles
047458             0118*   ; add tile pointer to tile stack
047458 21 BA 70 04 0119*       ld hl,tile_stack
04745C 11 00 00 00 0120*       ld de,0 ; keep the second pointer offset independently width-safe
047460 57          0121*       ld d,a ; number of active tiles
047461 15          0122*       dec d ; zero-based index
047462 1E 03       0123*       ld e,3 ; three bytes per tile record
047464 ED 5C       0124*       mlt de ; offset into tile stack
047466 19          0125*       add hl,de ; hl points to top of the active tiles
047467 ED 3F       0126*       ld (hl),ix
047469             0127*   ; return tile id
047469 DD 7E 00    0128*       ld a,(ix+tile_id)
04746C 37          0129*       scf ; sets carry flag indicating we found a free tile
04746D C9          0130*       ret ; done
04746E             0131*   ; end tile_table_get_next_id
04746E             0132*   
04746E             0133*   ; Validate an address into the dense tile-stack entries currently in use.
04746E             0134*   ; inputs: hl = candidate tile-stack address
04746E             0135*   ; outputs: carry set for an aligned slot in the active dense-stack range
04746E             0136*   ; destroys: a,de,hl
04746E             0137*   tile_stack_pointer_valid:
04746E 11 BA 70 04 0138*       ld de,tile_stack
047472 B7          0139*       or a
047473 ED 52       0140*       sbc hl,de
047475 DA A5 74 04 0141*       jp c,@invalid
047479 3A C3 73 04 0142*       ld a,(num_active_tiles)
04747D B7          0143*       or a
04747E CA A5 74 04 0144*       jp z,@invalid
047482 11 00 00 00 0145*       ld de,0
047486 57          0146*       ld d,a
047487 1E 03       0147*       ld e,3
047489 ED 5C       0148*       mlt de
04748B B7          0149*       or a
04748C ED 52       0150*       sbc hl,de
04748E D2 A5 74 04 0151*       jp nc,@invalid
047492 19          0152*       add hl,de ; restore the in-range offset
047493             0153*   ; For offsets below 768, divisibility by three can be tested without a loop.
047493             0154*   ; 256 == 1 (mod 3), and multiplication by 171 maps byte multiples of three
047493             0155*   ; into 0..85 while every non-multiple maps into 86..255.
047493 7C          0156*       ld a,h
047494 85          0157*       add a,l
047495 CE 00       0158*       adc a,0
047497 57          0159*       ld d,a
047498 1E AB       0160*       ld e,171
04749A ED 5C       0161*       mlt de
04749C 7B          0162*       ld a,e
04749D FE 56       0163*       cp 86
04749F D2 A5 74 04 0164*       jp nc,@invalid
0474A3 37          0165*       scf
0474A4 C9          0166*       ret
0474A5             0167*   @invalid:
0474A5 AF          0168*       xor a
0474A6 C9          0169*       ret
