044FDD 0E 1B       0176*       ld c,27 ; x
044FDF 06 10       0177*       ld b,16 ; y
044FE1 CD B6 13 04 0178*       call vdu_move_cursor
044FE5 CD 5C 00 04 0179*       call printInline
