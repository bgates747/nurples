047EAE             0021*   tmr_laser: ds 6 ; rate timer for firing laser
       FF FF FF FF 
       FF FF 
047EB4 0C 00 00    0022*   tmr_laser_reset: dl 120/10
047EB7             0023*   laser_animation_timer_reset: equ 2 ; animate every two frames
047EB7             0024*   
047EB7 40          0025*   laser_power: db 64 ; integer
047EB8 00          0026*   laser_power_last: db 0 ; integer
047EB9 40          0027*   laser_power_max: db 64 ; integer
047EBA 04          0028*   laser_power_per_shot: db 4 ; integer
047EBB 00          0029*   charge_laser_timer: db 0
047EBC 06          0030*   charge_laser_timer_max: db 6
047EBD             0031*   bar_laser:
047EBD 00 00 00    0032*       dl 0 ; value
047EC0 08 00 00    0033*       dl 8 ; x0
047EC3 30 01 00    0034*       dl 304 ; y0
