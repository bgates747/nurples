                       M1 Args: function=mos_sysvars 
041302 3E 08       0001*M1 			LD	A, function
041304 5B CF       0002*M1 			RST.LIL	08h
041306 DD 27 00    0356*       ld hl,(ix+sysvar_time)  ; get current time
041309 ED 5B 12 13 0357*       ld de,(stopwatch_started)            ; get start time
       04          
04130E AF          0358*       xor a                   ; clear carry
04130F ED 52       0359*       sbc hl,de               ; hl = time elapsed (will always be zero or positive)
041311 C9          0360*       ret
