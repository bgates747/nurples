048045             0486*   ; print the byte
048045 7E          0487*       ld a,(hl)
048046 E5          0488*       push hl
048047 C5          0489*       push bc
048048 CD 8F 02 04 0490*       call printBin8Rev
04804C C1          0491*       pop bc
04804D             0492*   ; print a space
04804D 3E 20       0493*       ld a,' '
04804F 5B D7       0494*       rst.lil 10h
048051 E1          0495*       pop hl
048052 23          0496*       inc hl
048053 10 F0       0497*       djnz @loop
048055 CD 78 00 04 0498*       call printNewLine
