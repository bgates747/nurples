044CF3             0067*   
044CF3             0068*   move_explosion:
044CF3             0069*   ; run the movement program for the explosion
044CF3 CD 4F 6A 04 0070*       call move_sprite
044CF7 B7          0071*       or a ; a will be non-zero if have scrolled off screen
044CF8 C2 CD 67 04 0072*       jp nz,table_deactivate_sprite
044CFC             0073*   ; do the animations
044CFC FD 35 23    0074*       dec (iy+sprite_animation_timer)
044CFF C0          0075*       ret nz ; not time to bump animation frame
044D00 FD 34 28    0076*       inc (iy+sprite_frame)
044D03 FD 35 22    0077*       dec (iy+sprite_animation)
044D06 CA CD 67 04 0078*       jp z,table_deactivate_sprite ; reached the end of the animations
044D0A 3E 08       0079*       ld a,explosion_animation_ticks ; reset animation timer
