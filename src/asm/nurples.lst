046B1B             0566*   ; destroys: a,hl
046B1B             0567*   sprite_frame_heading:
046B1B FD 7E 11    0568*       ld a,(iy+sprite_heading+1) ; we want the integer portion
046B1E CB 3F       0569*       srl a ; divide integer portion by 8
046B20 CB 3F       0570*       srl a
046B22 CB 3F       0571*       srl a
046B24 FD 77 28    0572*       ld (iy+sprite_frame),a
046B27 C9          0573*       ret
046B28             0574*   ; end sprite_frame_heading
