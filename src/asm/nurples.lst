0481E1             0001*   ; sprite_type
0481E1             0002*   enemy_dead: equ 0
0481E1             0003*   enemy_air: equ 1
0481E1             0004*   enemy_ground: equ 2
0481E1             0005*   enemy_projectile: equ 3
0481E1             0006*   explosion: equ 4
0481E1             0007*   player: equ 5
0481E1             0008*   player_air: equ 6
0481E1             0009*   player_ground: equ 7
0481E1             0010*   
0481E1             0011*   ; ###### SPRITE TABLE FIELD INDICES ######
0481E1             0012*   table_record_size:         equ  64; bytes per sprite record
0481E1             0013*   sprite_id:                 equ   0; 1 bytes ;unique spriteId, zero-based
0481E1             0014*   ; sprite state variables
0481E1             0015*   sprite_state_variables:    equ   1; beginning of sprite state variables
0481E1             0016*   sprite_x:                  equ   1; 3 bytes ;16.8 fractional x position in pixels
0481E1             0017*   sprite_y:                  equ   4; 3 bytes ;16.8 fractional y position in pixels
0481E1             0018*   sprite_xvel:               equ   7; 3 bytes ;x-component velocity, 16.8 fixed, pixels
0481E1             0019*   sprite_yvel:               equ  10; 3 bytes ;y-component velocity, 16.8 fixed, pixels
0481E1             0020*   sprite_vel:                equ  13; 3 bytes ;velocity px/frame (16.8 fixed)
0481E1             0021*   sprite_heading:            equ  16; 3 bytes ;sprite movement direction deg256 16.8 fixed
0481E1             0022*   sprite_orientation:        equ  19; 3 bytes ;orientation bits
0481E1             0023*   ; sprite definition variables
0481E1             0024*   sprite_definitions:        equ  22; beginnning of sprite definition variables
0481E1             0025*   sprite_type:               equ  22; 1 bytes ;type of sprite as defined in enemies.inc
0481E1             0026*   sprite_base_bufferId:      equ  23; 3 bytes ;bitmap bufferId
0481E1             0027*   sprite_move_program:       equ  26; 3 bytes ;address of sprite's behavior subroutine
0481E1             0028*   sprite_collisions:         equ  29; 1 bytes ;see collisions.inc constants for bit definitions
0481E1             0029*   sprite_dim_x:              equ  30; 1 bytes ;sprite width in pixels
0481E1             0030*   sprite_dim_y:              equ  31; 1 bytes ;sprite height in pixels
0481E1             0031*   sprite_num_orientations:   equ  32; 1 bytes ;number of orientations for this sprite
0481E1             0032*   sprite_num_animations:     equ  33; 1 bytes ;number of animations for this sprite
0481E1             0033*   sprite_animation:          equ  34; 1 bytes ;current animation index, zero-based
0481E1             0034*   sprite_animation_timer:    equ  35; 1 bytes ;when hits zero, draw next animation
0481E1             0035*   sprite_move_timer:         equ  36; 1 bytes ;when zero, go to next move program, or step
0481E1             0036*   sprite_move_step:          equ  37; 1 bytes ;stage in a move program sequence, varies
0481E1             0037*   sprite_points:             equ  38; 1 bytes ;points awarded for killing this sprite type
0481E1             0038*   sprite_shield_damage:      equ  39; 1 bytes ;shield points deducted for collision
0481E1             0039*   sprite_frame:              equ  40; 1 bytes ;current animation frame
0481E1             0040*   sprite_definitions_size:   equ  sprite_frame-sprite_definitions+1
0481E1             0041*   
0481E1             0042*   ; ###### SPRITE TABLE VARIABLES ######
0481E1             0043*   ; pointer to top address of current record, initialized to table_base
0481E1 23 A1 04    0044*   table_pointer: dl table_base
0481E4             0045*   
0481E4             0046*   ; flag indicating collision with screen edge
0481E4 00          0047*   sprite_screen_edge: db #00
0481E5             0048*   sprite_fault_bad_record: equ 0
0481E5             0049*   sprite_fault_bad_move_program: equ 1
0481E5 00          0050*   sprite_fault_flags: db 0 ; latched fail-closed diagnostics
0481E6             0051*   
0481E6             0052*   ; ######### COLLISION SPRITE PARAMETERS ##########
0481E6             0053*   ; integer coordinates are all that are needed for collision calculations
0481E6 00          0054*   collision_x: db 0x00
0481E7 00          0055*   collision_y: db 0x00
0481E8 00          0056*   collision_dim_x: db 0x00
0481E9 00          0057*   collision_dim_y: db 0x00
0481EA             0058*   
0481EA             0059*   ; scratch variables
0481EA 00          0060*   x: db 0x00 ; 8-bit signed integer
0481EB 00          0061*   y: db 0x00 ; 8-bit signed integer
0481EC 00 00 00    0062*   x0: dl 0x000000 ; 16.8 signed fixed place
0481EF 00 00 00    0063*   y0: dl 0x000000 ; 16.8 signed fixed place
0481F2 00 00 00    0064*   incx1: dl 0x000000 ; 16.8 signed fixed place
0481F5 00 00 00    0065*   incy1: dl 0x000000 ; 16.8 signed fixed place
0481F8 00 00 00    0066*   incx2: dl 0x000000 ; 16.8 signed fixed place
0481FB 00 00 00    0067*   incy2: dl 0x000000 ; 16.8 signed fixed place
0481FE             0068*   
0481FE             0069*   ; sprite_heading: dl 0x000000 ; signed fixed 16.8
0481FE 00 00 00    0070*   radius: dl 0x000000 ; signed fixed 16.8 (but should always be positive)
048201 00 00 00    0071*   sin_sprite_heading: dl 0x000000 ; signed fixed 16.8
048204 00 00 00    0072*   cos_sprite_heading: dl 0x000000 ; signed fixed 16.8
