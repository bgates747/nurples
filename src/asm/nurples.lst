046403 00          0021*   player_fuel_last: db 0 ; integer
046404 40          0022*   player_fuel_max: db 64 ; integer
046405 00          0023*   discharge_fuel_timer: db 0
046406 40          0024*   discharge_fuel_timer_max: db 64 ;
046407             0025*   discharge_fuel:
046407             0026*   ; check fuel timer
046407 21 05 64 04 0027*       ld hl,discharge_fuel_timer
04640B 35          0028*       dec (hl)
04640C C0          0029*       ret nz ; not time to discharge fuel so return
04640D             0030*   ; reset fuel discharge timer
04640D 3A 06 64 04 0031*       ld a,(discharge_fuel_timer_max)
046411 77          0032*       ld (hl),a
046412             0033*   ; discharge fuel
046412 21 02 64 04 0034*       ld hl,player_fuel
046416 35          0035*       dec (hl)
046417 CA 20 64 04 0036*       jp z,@no_fuel
04641B FA 20 64 04 0037*       jp m,@no_fuel
04641F C9          0038*       ret ; fuel not zero so return
046420             0039*   @no_fuel:
046420 36 00       0040*       ld (hl),0 ; TODO: implement out-of-fuel handler
046422 C9          0041*       ret
046423             0042*   ; end discharge_fuel
046423             0043*   
