04106A 21 2C 00 00 0080*       ld hl,BUF_SPLASH_BG
04106E CD C4 14 04 0081*       call vdu_buff_select
041072 01 00 00 00 0082*       ld bc,0
041076 11 00 00 00 0083*       ld de,0
04107A CD FA 18 04 0084*       call vdu_plot_bmp
04107E             0085*   
04107E CD AF 10 04 0086*       call move_logo
041082             0087*   
