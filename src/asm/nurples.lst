04406D             0845*   ; destroys: AF, HL
04406D             0846*   ;
04406D             0847*   ; IMPORTANT: umul24 discards product bits above bit 23. That theoretical limit
04406D             0848*   ; is 16,777,215 bytes/pixels--orders of magnitude larger than any conceivable
04406D             0849*   ; bitmap on the Agon. The initial image loader therefore deliberately uses the
04406D             0850*   ; smaller native-ADL result instead of carrying a general u16*u16=u32 routine.
04406D             0851*   agnb_calculate_image_data_size:
04406D             0852*   ; Load each contiguous u16 field as UHL, then use the established eZ80 idiom
04406D             0853*   ; to discard the accidentally loaded following byte.
04406D 2A D1 1B 04 0854*       ld hl,(agnb_metadata+agnb_meta_height)
044071 2B          0855*       dec hl
044072 52 23       0856*       inc.s hl ; undocumented: preserves HL and clears HLU
044074 EB          0857*       ex de,hl
044075 2A CF 1B 04 0858*       ld hl,(agnb_metadata+agnb_meta_width)
044079 2B          0859*       dec hl
04407A 52 23       0860*       inc.s hl ; undocumented: preserves HL and clears HLU
04407C CD 63 03 04 0861*       call umul24
044080 22 D8 1B 04 0862*       ld (agnb_expected_data_size),hl
044084 AF          0863*       xor a
044085 32 DB 1B 04 0864*       ld (agnb_expected_data_size+3),a
044089 C9          0865*       ret
04408A             0866*   
04408A             0867*   ; Validate the current RGBA2222 DATA size against width * height.
04408A             0868*   ; inputs:  normalized IMAG metadata and DATA size in agnb_metadata
04408A             0869*   ; outputs: A=0 and Z set on success
04408A             0870*   ;          A=agnb_error_data_size and NZ set on mismatch
04408A             0871*   ; destroys: AF, DE, HL
04408A             0872*   agnb_validate_image_data_size:
