                       M1 Args: function=mos_sysvars 
04143E 3E 08       0001*M1 			LD	A, function
041440 5B CF       0002*M1 			RST.LIL	08h
041442 DD 5E 00    0158*       ld e,(ix+sysvar_time+0)
041445 01 00 00 00 0159*       ld bc,0 ; 65,536 polls before failing open
041449             0160*   @wait:
