0478D8             0103*   move_tiles:
0478D8             0104*   ; initialize the dense-stack cursor
0478D8 3A 6B 74 04 0105*       ld a,(num_active_tiles)
0478DC B7          0106*       or a
0478DD C8          0107*       ret z
0478DE FD 21 62 71 0108*       ld iy,tile_stack ; set iy to first record in table
       04          
0478E3             0109*   @move_loop:
0478E3 FD E5       0110*       push iy
0478E5 E1          0111*       pop hl
0478E6 CD 12 75 04 0112*       call tile_stack_pointer_valid
0478EA D0          0113*       ret nc ; normal end-of-stack or fail-closed malformed cursor
0478EB FD 22 65 74 0114*       ld (tile_stack_pointer),iy ; update stack pointer
       04          
0478F0             0115*   ; point iy to tile record
0478F0 FD 37 00    0116*       ld iy,(iy) ; iy points to the current tile record
0478F3 CD 4B 75 04 0117*       call tile_table_record_pointer_valid
0478F7 D2 41 79 04 0118*       jp nc,@bad_record
0478FB FD 22 68 74 0119*       ld (tile_table_pointer),iy ; update table pointer
       04          
047900             0120*   ; check top bit of tile_type to see if tile is just spawned
047900 FD CB 16 7E 0121*       bit 7,(iy+tile_type)
047904 C2 31 79 04 0122*       jp nz,@just_spawned ; if just spawned, skip to next record
047908             0123*   ; check sprite_alive bit to see if tile is active
047908 FD CB 1D 76 0124*       bit sprite_alive,(iy+tile_collisions)
04790C CA 39 79 04 0125*       jp z,@inactive_record
047910             0126*   ; otherwise we prepare to move the tile
047910 FD 27 1A    0127*       ld hl,(iy+tile_move_program) ; load the behavior subroutine address
047913 CD 82 78 04 0128*       call tile_move_program_valid
047917 D2 4F 79 04 0129*       jp nc,@bad_move_program
04791B FD E5       0130*       push iy ; callbacks may use index registers internally but do not own them
04791D             0131*       CALL_HL
                       M1 Args: none
04791D 01 23 79 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
047921 C5          0002*M1     push bc ; which constitutes the return address
047922 E9          0003*M1     jp (hl) ; Jump to the address in HL
047923 FD E1       0132*       pop iy
047925             0133*    ; get back stack pointer and loop
047925             0134*   @next_record:
047925 FD 2A 65 74 0135*       ld iy,(tile_stack_pointer)
       04          
04792A ED 33 03    0136*       lea iy,iy+3 ; next tile stack record
04792D C3 E3 78 04 0137*       jp @move_loop ; loop until we've checked all the records
047931             0138*   @just_spawned:
