041500             0282*   ; 139   320   240   2     60hz
041500             0283*   ; 23    512   384   2     60hz
041500             0284*   ; 151   512   384   2     60hz
041500             0285*   ; 6     640   240   2     60hz
041500             0286*   ; 134   640   240   2     60hz
041500             0287*   ; 2     640   480   2     60hz
041500             0288*   ; 130   640   480   2     60hz
041500             0289*   ; 17    800   600   2     60hz
041500             0290*   ; 145   800   600   2     60hz
041500             0291*   ; 18    1024  768   2     60hz
041500             0292*   ; 146   1024  768   2     60hz
