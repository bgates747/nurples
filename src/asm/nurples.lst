047F2F             0089*   
047F2F             0090*   player_spawn_laser:
047F2F             0091*    ; check laser spawn timer
047F2F FD 21 AE 7E 0092*       ld iy,tmr_laser
       04          
047F34 CD A5 12 04 0093*       call timestamp_tmr_get
047F38 F0          0094*       ret p ; not time to fire
047F39             0095*   ; check laser power
047F39 3A B7 7E 04 0096*       ld a,(laser_power)
047F3D 21 BA 7E 04 0097*       ld hl,laser_power_per_shot
047F41 96          0098*       sub (hl) ; units of power per laser shot
047F42 D8          0099*       ret c ; not enough power to fire
047F43             0100*   ; update power to reflect firing
047F43 32 B7 7E 04 0101*       ld (laser_power),a
047F47             0102*   ; reset timer
047F47 2A B4 7E 04 0103*       ld hl,(tmr_laser_reset)
047F4B CD 9A 12 04 0104*       call timestamp_tmr_set
047F4F             0105*   ; fire the laser
047F4F DD 21 60 9B 0106*       ld ix,player_weapons_begin
       04          
047F54 06 04       0107*       ld b,player_lasers_max
047F56 FD 21 60 9C 0108*       ld iy,player_begin
       04          
047F5B FD 22 98 80 0109*       ld (table_pointer),iy
       04          
047F60 21 9B 7E 04 0110*       ld hl,laser_defaults
047F64 CD 95 81 04 0111*       call spawn_sprite_from_sprite
047F68 D0          0112*       ret nc ; no carry means no free sprite slots, so we go home
047F69             0113*   ; other specific initialization
047F69             0114*   ; ------------------------------------------------
047F69 FD 21 60 9C 0115*       ld iy,player_begin
       04          
047F6E             0116*   ; x-coordinate
047F6E FD 27 01    0117*       ld hl,(iy+sprite_x)
