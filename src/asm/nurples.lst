047B4F             0128*   @scan_done:
047B4F             0129*   ; Rediscover the source cursor after any compaction. This search is bounded by
047B4F             0130*   ; the current dense-stack count and validates each slot before loading it.
047B4F 3A 6B 74 04 0131*       ld a,(num_active_tiles)
047B53 32 C9 7B 04 0132*       ld (@tiles_remaining),a
047B57 FD 21 62 71 0133*       ld iy,tile_stack
       04          
