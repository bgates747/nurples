046B30             0585*   @load_frames:
046B30 C5          0586*       push bc ; back up loop counter
046B31 E5          0587*       push hl ; back up base bufferId
046B32 CD 03 1B 04 0588*       call vdu_sprite_add_buff
046B36 E1          0589*       pop hl ; restore base bufferId
046B37 23          0590*       inc hl ; bump it to the next frame
046B38             0591*   ; decrement loop counter
046B38 C1          0592*       pop bc
046B39 0B          0593*       dec bc
046B3A 79          0594*       ld a,c
046B3B B7          0595*       or a
046B3C C2 30 6B 04 0596*       jp nz,@load_frames
046B40 78          0597*       ld a,b
046B41 B7          0598*       or a
046B42 C2 30 6B 04 0599*       jp nz,@load_frames
046B46 C9          0600*       ret
