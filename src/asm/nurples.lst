0418FA             0043        include "vdu_plot.inc"
0418FA             0001*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
0418FA             0002*   ; PLOT code 	(Decimal) 	Effect
0418FA             0003*   ; &00-&07 	0-7 	Solid line, includes both ends
0418FA             0004*   plot_sl_both: equ 0x00
0418FA             0005*   
0418FA             0006*   ; &08-&0F 	8-15 	Solid line, final point omitted
0418FA             0007*   plot_sl_first: equ 0x08
0418FA             0008*   
0418FA             0009*   ; &10-&17 	16-23 	Not supported (Dot-dash line, includes both ends, pattern restarted)
0418FA             0010*   ; &18-&1F 	24-31 	Not supported (Dot-dash line, first point omitted, pattern restarted)
0418FA             0011*   
0418FA             0012*   ; &20-&27 	32-39 	Solid line, first point omitted
0418FA             0013*   plot_sl_last: equ 0x20
0418FA             0014*   
0418FA             0015*   ; &28-&2F 	40-47 	Solid line, both points omitted
0418FA             0016*   plot_sl_none: equ 0x28
0418FA             0017*   
0418FA             0018*   ; &30-&37 	48-55 	Not supported (Dot-dash line, first point omitted, pattern continued)
0418FA             0019*   ; &38-&3F 	56-63 	Not supported (Dot-dash line, both points omitted, pattern continued)
0418FA             0020*   
0418FA             0021*   ; &40-&47 	64-71 	Point plot
0418FA             0022*   plot_pt: equ 0x40
0418FA             0023*   
0418FA             0024*   ; &48-&4F 	72-79 	Line fill left and right to non-background §§
0418FA             0025*   plot_lf_lr_non_bg: equ 0x48
0418FA             0026*   
0418FA             0027*   ; &50-&57 	80-87 	Triangle fill
0418FA             0028*   plot_tf: equ 0x50
0418FA             0029*   
0418FA             0030*   ; &58-&5F 	88-95 	Line fill right to background §§
0418FA             0031*   plot_lf_r_bg: equ 0x58
0418FA             0032*   
0418FA             0033*   ; &60-&67 	96-103 	Rectangle fill
0418FA             0034*   plot_rf: equ 0x60
0418FA             0035*   
0418FA             0036*   ; &68-&6F 	104-111 	Line fill left and right to foreground §§
0418FA             0037*   plot_lf_lr_fg: equ 0x60
0418FA             0038*   
0418FA             0039*   ; &70-&77 	112-119 	Parallelogram fill
0418FA             0040*   plot_pf: equ 0x70
0418FA             0041*   
0418FA             0042*   ; &78-&7F 	120-127 	Line fill right to non-foreground §§
0418FA             0043*   plot_lf_r_non_fg: equ 0x78
0418FA             0044*   
0418FA             0045*   ; &80-&87 	128-135 	Not supported (Flood until non-background)
0418FA             0046*   ; &88-&8F 	136-143 	Not supported (Flood until foreground)
0418FA             0047*   
0418FA             0048*   ; &90-&97 	144-151 	Circle outline
0418FA             0049*   plot_co: equ 0x90
0418FA             0050*   
0418FA             0051*   ; &98-&9F 	152-159 	Circle fill
0418FA             0052*   plot_cf: equ 0x98
0418FA             0053*   
0418FA             0054*   ; &A0-&A7 	160-167 	Not supported (Circular arc)
0418FA             0055*   ; &A8-&AF 	168-175 	Not supported (Circular segment)
0418FA             0056*   ; &B0-&B7 	176-183 	Not supported (Circular sector)
0418FA             0057*   
0418FA             0058*   ; &B8-&BF 	184-191 	Rectangle copy/move
0418FA             0059*   plot_rcm: equ 0xB8
0418FA             0060*   
0418FA             0061*   ; &C0-&C7 	192-199 	Not supported (Ellipse outline)
0418FA             0062*   ; &C8-&CF 	200-207 	Not supported (Ellipse fill)
0418FA             0063*   ; &D0-&D7 	208-215 	Not defined
0418FA             0064*   ; &D8-&DF 	216-223 	Not defined
0418FA             0065*   ; &E0-&E7 	224-231 	Not defined
0418FA             0066*   
0418FA             0067*   ; &E8-&EF 	232-239 	Bitmap plot §
0418FA             0068*   plot_bmp: equ 0xE8
0418FA             0069*   
0418FA             0070*   ; &F0-&F7 	240-247 	Not defined
0418FA             0071*   ; &F8-&FF 	248-255 	Not defined
0418FA             0072*   
0418FA             0073*   ; § Support added in Agon Console8 VDP 2.1.0 §§ Support added in
0418FA             0074*   ; Agon Console8 VDP 2.2.0
0418FA             0075*   
0418FA             0076*   ; Within each group of eight plot codes, the effects are as follows:
0418FA             0077*   ; Plot code 	Effect
0418FA             0078*   ; 0 	Move relative
0418FA             0079*   mv_rel: equ 0
0418FA             0080*   
0418FA             0081*   ; 1 	Plot relative in current foreground colour
0418FA             0082*   dr_rel_fg: equ 1
0418FA             0083*   
0418FA             0084*   ; 2 	Not supported (Plot relative in logical inverse colour)
0418FA             0085*   ; 3 	Plot relative in current background colour
0418FA             0086*   dr_rel_bg: equ 3
0418FA             0087*   
0418FA             0088*   ; 4 	Move absolute
0418FA             0089*   mv_abs: equ 4
0418FA             0090*   
0418FA             0091*   ; 5 	Plot absolute in current foreground colour
0418FA             0092*   dr_abs_fg: equ 5
0418FA             0093*   
0418FA             0094*   ; 6 	Not supported (Plot absolute in logical inverse colour)
0418FA             0095*   ; 7 	Plot absolute in current background colour
0418FA             0096*   dr_abs_bg: equ 7
0418FA             0097*   
0418FA             0098*   ; Codes 0-3 use the position data provided as part of the command
0418FA             0099*   ; as a relative position, adding the position given to the current
0418FA             0100*   ; graphical cursor position. Codes 4-7 use the position data provided
0418FA             0101*   ; as part of the command as an absolute position, setting the current
0418FA             0102*   ; graphical cursor position to the position given.
0418FA             0103*   
0418FA             0104*   ; Codes 2 and 6 on Acorn systems plot using a logical inverse of the
0418FA             0105*   ; current pixel colour. These operations cannot currently be supported
0418FA             0106*   ; by the graphics system the Agon VDP uses, so these codes are not
0418FA             0107*   ; supported. Support for these codes may be added in a future version
0418FA             0108*   ; of the VDP firmware.
0418FA             0109*   
0418FA             0110*   ; 16 colour palette constants
0418FA             0111*   c_black: equ 0
0418FA             0112*   c_red_dk: equ 1
0418FA             0113*   c_green_dk: equ 2
0418FA             0114*   c_yellow_dk: equ 3
0418FA             0115*   c_blue_dk: equ 4
0418FA             0116*   c_magenta_dk: equ 5
0418FA             0117*   c_cyan_dk: equ 6
0418FA             0118*   c_grey: equ 7
0418FA             0119*   c_grey_dk: equ 8
0418FA             0120*   c_red: equ 9
0418FA             0121*   c_green: equ 10
0418FA             0122*   c_yellow: equ 11
0418FA             0123*   c_blue: equ 12
0418FA             0124*   c_magenta: equ 13
0418FA             0125*   c_cyan: equ 14
0418FA             0126*   c_white: equ 15
0418FA             0127*   
0418FA             0128*   ; VDU 25, mode, x; y;: PLOT command
0418FA             0129*   ; inputs: a=mode, bc=x0, de=y0
0418FA             0130*   vdu_plot:
0418FA 32 14 19 04 0131*       ld (@mode),a
0418FE ED 43 15 19 0132*       ld (@x0),bc
       04          
041903 ED 53 17 19 0133*       ld (@y0),de
       04          
041908 21 13 19 04 0134*   	ld hl,@cmd
04190C 01 06 00 00 0135*   	ld bc,@end-@cmd
041910 5B DF       0136*   	rst.lil $18
041912 C9          0137*   	ret
041913 19          0138*   @cmd:   db 25
041914 00          0139*   @mode:  db 0
041915 00 00       0140*   @x0: 	dw 0
041917 00 00       0141*   @y0: 	dw 0
041919 00          0142*   @end:   db 0 ; extra byte to soak up deu
04191A             0143*   
04191A             0144*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
04191A             0145*   ; &E8-&EF 	232-239 	Bitmap plot §
04191A             0146*   ; VDU 25, mode, x; y;: PLOT command
04191A             0147*   ; inputs: bc=x0, de=y0
04191A             0148*   ; prerequisites: vdu_buff_select
04191A             0149*   vdu_plot_bmp:
04191A ED 43 31 19 0150*       ld (@x0),bc
       04          
04191F ED 53 33 19 0151*       ld (@y0),de
       04          
041924 21 2F 19 04 0152*   	ld hl,@cmd
041928 01 06 00 00 0153*   	ld bc,@end-@cmd
04192C 5B DF       0154*   	rst.lil $18
04192E C9          0155*   	ret
04192F 19          0156*   @cmd:   db 25
041930 ED          0157*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
041931 00 00       0158*   @x0: 	dw 0x0000
041933 00 00       0159*   @y0: 	dw 0x0000
041935 00          0160*   @end:   db 0x00 ; padding
041936             0161*   
041936             0162*   ; https://agonconsole8.github.io/agon-docs/VDP---PLOT-Commands.html
041936             0163*   ; &E8-&EF 	232-239 	Bitmap plot §
041936             0164*   ; VDU 25, mode, x; y;: PLOT command
041936             0165*   ; inputs: bc=x0, de=y0
041936             0166*   ; USING 16.8 FIXED POINT COORDINATES
041936             0167*   ; inputs: ub.c is x coordinate, ud.e is y coordinate
041936             0168*   ;   the fractional portiion of the inputs are truncated
041936             0169*   ;   leaving only the 16-bit integer portion
041936             0170*   ; prerequisites: vdu_buff_select
041936             0171*   vdu_plot_bmp168:
041936             0172*   ; populate in the reverse of normal to keep the
041936             0173*   ; inputs from stomping on each other
041936 ED 53 54 19 0174*       ld (@y0-1),de
       04          
04193B ED 43 52 19 0175*       ld (@x0-1),bc
       04          
041940 3E ED       0176*       ld a,plot_bmp+dr_abs_fg ; 0xED
041942 32 52 19 04 0177*       ld (@mode),a ; restore the mode byte that got stomped on by bcu
041946 21 51 19 04 0178*   	ld hl,@cmd
04194A 01 06 00 00 0179*   	ld bc,@end-@cmd
04194E 5B DF       0180*   	rst.lil $18
041950 C9          0181*   	ret
041951 19          0182*   @cmd:   db 25
041952 ED          0183*   @mode:  db plot_bmp+dr_abs_fg ; 0xED
041953 00 00       0184*   @x0: 	dw 0x0000
041955 00 00       0185*   @y0: 	dw 0x0000
041957             0186*   @end:  ; no padding required b/c we shifted de right
041957             0187*   
041957             0188*   ; draw a filled rectangle
041957             0189*   vdu_plot_rf:
041957 ED 43 7E 19 0190*       ld (@x0),bc
       04          
04195C ED 53 80 19 0191*       ld (@y0),de
       04          
041961 DD 22 84 19 0192*       ld (@x1),ix
       04          
041966 FD 22 86 19 0193*       ld (@y1),iy
       04          
04196B 3E 19       0194*       ld a,25 ; we have to reload the 2nd plot command
04196D 32 82 19 04 0195*       ld (@cmd1),a ; because the 24-bit y0 load stomped on it
041971 21 7C 19 04 0196*   	ld hl,@cmd0
041975 01 0C 00 00 0197*   	ld bc,@end-@cmd0
041979 5B DF       0198*   	rst.lil $18
04197B C9          0199*       ret
04197C 19          0200*   @cmd0:  db 25 ; plot
04197D 04          0201*   @arg0:  db plot_sl_both+mv_abs
04197E 00 00       0202*   @x0:    dw 0x0000
041980 00 00       0203*   @y0:    dw 0x0000
041982 19          0204*   @cmd1:  db 25 ; plot
041983 65          0205*   @arg1:  db plot_rf+dr_abs_fg
041984 00 00       0206*   @x1:    dw 0x0000
041986 00 00       0207*   @y1:    dw 0x0000
041988 00          0208*   @end:   db 0x00 ; padding
041989             0209*   
041989             0210*   ; draw a filled circle
041989             0211*   vdu_plot_cf:
041989 ED 43 B0 19 0212*       ld (@x0),bc
       04          
04198E ED 53 B2 19 0213*       ld (@y0),de
       04          
041993 DD 22 B6 19 0214*       ld (@x1),ix
       04          
041998 FD 22 B8 19 0215*       ld (@y1),iy
       04          
04199D 3E 19       0216*       ld a,25 ; we have to reload the 2nd plot command
04199F 32 B4 19 04 0217*       ld (@cmd1),a ; because the 24-bit y0 load stomped on it
0419A3 21 AE 19 04 0218*   	ld hl,@cmd0
0419A7 01 0C 00 00 0219*   	ld bc,@end-@cmd0
0419AB 5B DF       0220*   	rst.lil $18
0419AD C9          0221*       ret
0419AE 19          0222*   @cmd0:  db 25 ; plot
0419AF 04          0223*   @arg0:  db plot_sl_both+mv_abs
0419B0 00 00       0224*   @x0:    dw 0x0000
0419B2 00 00       0225*   @y0:    dw 0x0000
0419B4 19          0226*   @cmd1:  db 25 ; plot
0419B5 9D          0227*   @arg1:  db plot_cf+dr_abs_fg
0419B6 00 00       0228*   @x1:    dw 0x0000
0419B8 00 00       0229*   @y1:    dw 0x0000
0419BA 00          0230*   @end:   db 0x00 ; padding
0419BB             0044        include "vdu_sprites.inc"
0419BB             0001*   ; ; https://github.com/AgonConsole8/agon-docs/blob/main/VDP---Bitmaps-API.md
0419BB             0002*   ; the VDP can support up to 256 sprites. They must be defined
0419BB             0003*   ; contiguously, and so the first sprite is sprite 0.
0419BB             0004*   ; (In contrast, bitmaps can have any ID from 0 to 65534.)
0419BB             0005*   ; Once a selection of sprites have been defined, you can activate
0419BB             0006*   ; them using the VDU 23, 27, 7, n command, where n is the number
0419BB             0007*   ; of sprites to activate. This will activate the first n sprites,
0419BB             0008*   ; starting with sprite 0. All sprites from 0 to n-1 must be defined.
0419BB             0009*   
0419BB             0010*   ; A single sprite can have multiple "frames", referring to
0419BB             0011*   ; different bitmaps.
0419BB             0012*   ; (These bitmaps do not need to be the same size.)
0419BB             0013*   ; This allows a sprite to include an animation sequence,
0419BB             0014*   ; which can be stepped through one frame at a time, or picked
0419BB             0015*   ; in any order.
0419BB             0016*   
0419BB             0017*   ; Any format of bitmap can be used as a sprite frame. It should
0419BB             0018*   ; be noted however that "native" format bitmaps are not
0419BB             0019*   ; recommended for use as sprite frames, as they cannot get
0419BB             0020*   ; erased from the screen. (As noted above, the "native" bitmap
0419BB             0021*   ; format is not really intended for general use.) This is part
0419BB             0022*   ; of why from Agon Console8 VDP 2.6.0 bitmaps captured from the
0419BB             0023*   ; screen are now stored in RGBA2222 format.
0419BB             0024*   
0419BB             0025*   ; An "active" sprite can be hidden, so it will stop being drawn,
0419BB             0026*   ; and then later shown again.
0419BB             0027*   
0419BB             0028*   ; Moving sprites around the screen is done by changing the
0419BB             0029*   ; position of the sprite. This can be done either by setting
0419BB             0030*   ; the absolute position of the sprite, or by moving the sprite
0419BB             0031*   ; by a given number of pixels. (Sprites are positioned using
0419BB             0032*   ; pixel coordinates, and not by the logical OS coordinate system.)
0419BB             0033*   ; In the current sprite system, sprites will not update their
0419BB             0034*   ; position on-screen until either another drawing operation is
0419BB             0035*   ; performed or an explicit VDU 23, 27, 15 command is performed.
0419BB             0036*   
0419BB             0037*   ; VDU 23, 27, 4, n: Select sprite n
0419BB             0038*   ; inputs: a is the 8-bit sprite id
0419BB             0039*   vdu_sprite_select:
0419BB 32 CD 19 04 0040*       ld (@sprite),a
0419BF 21 CA 19 04 0041*       ld hl,@cmd
0419C3 01 04 00 00 0042*       ld bc,@end-@cmd
0419C7 5B DF       0043*       rst.lil $18
0419C9 C9          0044*       ret
0419CA 17 1B 04    0045*   @cmd:    db 23,27,4
0419CD 00          0046*   @sprite: db 0x00
0419CE             0047*   @end:
0419CE             0048*   
0419CE             0049*   ; VDU 23, 27, 5: Clear frames in current sprite
0419CE             0050*   ; inputs: none
0419CE             0051*   ; prerequisites: vdu_sprite_select
0419CE             0052*   vdu_sprite_clear_frames:
0419CE 21 D9 19 04 0053*       ld hl,@cmd
0419D2 01 03 00 00 0054*       ld bc,@end-@cmd
0419D6 5B DF       0055*       rst.lil $18
0419D8 C9          0056*       ret
0419D9 17 1B 05    0057*   @cmd: db 23,27,5
0419DC             0058*   @end:
0419DC             0059*   
0419DC             0060*   ; VDU 23, 27, 6, n: Add bitmap n as a frame to current sprite (where bitmap's buffer ID is 64000+n)
0419DC             0061*   ; inputs: a is the 8-bit bitmap number
0419DC             0062*   ; prerequisites: vdu_sprite_select
0419DC             0063*   vdu_sprite_add_bmp:
0419DC 32 EE 19 04 0064*       ld (@bmp),a
0419E0 21 EB 19 04 0065*       ld hl,@cmd
0419E4 01 04 00 00 0066*       ld bc,@end-@cmd
0419E8 5B DF       0067*       rst.lil $18
0419EA C9          0068*       ret
0419EB 17 1B 06    0069*   @cmd: db 23,27,6
0419EE 00          0070*   @bmp: db 0x00
0419EF             0071*   @end:
0419EF             0072*   
0419EF             0073*   ; VDU 23, 27, 7, n: Activate n sprites
0419EF             0074*   ; inputs: a is the number of sprites to activate
0419EF             0075*   ; prerequisites: each sprite activated must have at least one frame attached to it
0419EF             0076*   vdu_sprite_activate:
0419EF 32 01 1A 04 0077*       ld (@num),a
0419F3 21 FE 19 04 0078*       ld hl,@cmd
0419F7 01 04 00 00 0079*       ld bc,@end-@cmd
0419FB 5B DF       0080*       rst.lil $18
0419FD C9          0081*       ret
0419FE 17 1B 07    0082*   @cmd: db 23,27,7
041A01 00          0083*   @num: db 0x00
041A02             0084*   @end:
041A02             0085*   
041A02             0086*   ; VDU 23, 27, 8: Select next frame of current sprite
041A02             0087*   ; inputs: none
041A02             0088*   ; prerequisites: vdu_sprite_select
041A02             0089*   vdu_sprite_next_frame:
041A02 21 0D 1A 04 0090*       ld hl,@cmd
041A06 01 03 00 00 0091*       ld bc,@end-@cmd
041A0A 5B DF       0092*       rst.lil $18
041A0C C9          0093*       ret
041A0D 17 1B 08    0094*   @cmd: db 23,27,8
041A10             0095*   @end:
041A10             0096*   
041A10             0097*   ; VDU 23, 27, 9: Select previous frame of current sprite
041A10             0098*   ; inputs: none
041A10             0099*   ; prerequisites: vdu_sprite_select
041A10             0100*   vdu_sprite_prev_frame:
041A10 21 1B 1A 04 0101*       ld hl,@cmd
041A14 01 03 00 00 0102*       ld bc,@end-@cmd
041A18 5B DF       0103*       rst.lil $18
041A1A C9          0104*       ret
041A1B 17 1B 09    0105*   @cmd: db 23,27,9
041A1E             0106*   @end:
041A1E             0107*   
041A1E             0108*   ; VDU 23, 27, 10, n: Select the nth frame of current sprite
041A1E             0109*   ; inputs: a is frame number to select
041A1E             0110*   ; prerequisites: vdu_sprite_select
041A1E             0111*   vdu_sprite_select_frame:
041A1E 32 30 1A 04 0112*       ld (@frame),a
041A22 21 2D 1A 04 0113*       ld hl,@cmd
041A26 01 04 00 00 0114*       ld bc,@end-@cmd
041A2A 5B DF       0115*       rst.lil $18
041A2C C9          0116*       ret
041A2D 17 1B 0A    0117*   @cmd:    db 23,27,10
041A30 00          0118*   @frame:  db 0x00
041A31             0119*   @end:
041A31             0120*   
041A31             0121*   ; VDU 23, 27, 11: Show current sprite
041A31             0122*   ; inputs: none
041A31             0123*   ; prerequisites: vdu_sprite_select
041A31             0124*   vdu_sprite_show:
041A31 21 3C 1A 04 0125*       ld hl,@cmd
041A35 01 03 00 00 0126*       ld bc,@end-@cmd
041A39 5B DF       0127*       rst.lil $18
041A3B C9          0128*       ret
041A3C 17 1B 0B    0129*   @cmd: db 23,27,11
041A3F             0130*   @end:
041A3F             0131*   
041A3F             0132*   ; VDU 23, 27, 12: Hide current sprite
041A3F             0133*   ; inputs: none
041A3F             0134*   ; prerequisites: vdu_sprite_select
041A3F             0135*   vdu_sprite_hide:
041A3F 21 4A 1A 04 0136*       ld hl,@cmd
041A43 01 03 00 00 0137*       ld bc,@end-@cmd
041A47 5B DF       0138*       rst.lil $18
041A49 C9          0139*       ret
041A4A 17 1B 0C    0140*   @cmd: db 23,27,12
041A4D             0141*   @end:
041A4D             0142*   
041A4D             0143*   ; VDU 23, 27, 13, x; y;: Move current sprite to pixel position x, y
041A4D             0144*   ; inputs: bc is x coordinate, de is y coordinate
041A4D             0145*   ; prerequisites: vdu_sprite_select
041A4D             0146*   vdu_sprite_move_abs:
041A4D ED 43 65 1A 0147*       ld (@xpos),bc
       04          
041A52 ED 53 67 1A 0148*       ld (@ypos),de
       04          
041A57 21 62 1A 04 0149*       ld hl,@cmd
041A5B 01 07 00 00 0150*       ld bc,@end-@cmd
041A5F 5B DF       0151*       rst.lil $18
041A61 C9          0152*       ret
041A62 17 1B 0D    0153*   @cmd:  db 23,27,13
041A65 00 00       0154*   @xpos: dw 0x0000
041A67 00 00       0155*   @ypos: dw 0x0000
041A69 00          0156*   @end:  db 0x00 ; padding
041A6A             0157*   
041A6A             0158*   ; VDU 23, 27, 14, x; y;: Move current sprite by x, y pixels
041A6A             0159*   ; inputs: bc is x coordinate, de is y coordinate
041A6A             0160*   ; prerequisites: vdu_sprite_select
041A6A             0161*   vdu_sprite_move_rel:
041A6A ED 43 82 1A 0162*       ld (@dx),bc
       04          
041A6F ED 53 84 1A 0163*       ld (@dy),de
       04          
041A74 21 7F 1A 04 0164*       ld hl,@cmd
041A78 01 07 00 00 0165*       ld bc,@end-@cmd
041A7C 5B DF       0166*       rst.lil $18
041A7E C9          0167*       ret
041A7F 17 1B 0E    0168*   @cmd: db 23,27,14
041A82 00 00       0169*   @dx:  dw 0x0000
041A84 00 00       0170*   @dy:  dw 0x0000
041A86 00          0171*   @end: db 0x00 ; padding
041A87             0172*   
041A87             0173*   ; VDU 23, 27, 13, x; y;: Move current sprite to pixel position x, y
041A87             0174*   ; USING 16.8 FIXED POINT COORDINATES
041A87             0175*   ; inputs: ub.c is x coordinate, ud.e is y coordinate
041A87             0176*   ;   the fractional portiion of the inputs are truncated
041A87             0177*   ;   leaving only the 16-bit integer portion
041A87             0178*   ; prerequisites: vdu_sprite_select
041A87             0179*   vdu_sprite_move_abs168:
041A87             0180*   ; offset inputs by the gfx origin
041A87             0181*   ; y coordinate
041A87 21 00 30 00 0182*       ld hl,origin_top*256
041A8B 19          0183*       add hl,de
041A8C 22 AE 1A 04 0184*       ld (@ypos-1),hl
041A90             0185*   ; x coordinate
041A90 21 00 80 00 0186*       ld hl,origin_left*256
041A94 09          0187*       add hl,bc
041A95 22 AC 1A 04 0188*       ld (@xpos-1),hl
041A99             0189*   ; prepare vdu command
041A99 3E 0D       0190*       ld a,13       ; restore the final byte of the command
041A9B 32 AC 1A 04 0191*       ld (@cmd+2),a ; string that got stomped on by bcu
041A9F 21 AA 1A 04 0192*       ld hl,@cmd
041AA3 01 07 00 00 0193*       ld bc,@end-@cmd
041AA7 5B DF       0194*       rst.lil $18
041AA9 C9          0195*       ret
041AAA 17 1B 0D    0196*   @cmd:  db 23,27,13
041AAD 00 00       0197*   @xpos: dw 0x0000
041AAF 00 00       0198*   @ypos: dw 0x0000
041AB1             0199*   @end:  ; no padding required b/c we shifted de right
041AB1             0200*   
041AB1             0201*   ; VDU 23, 27, 14, x; y;: Move current sprite by x, y pixels
041AB1             0202*   ; USING 16.8 FIXED POINT COORDINATES
041AB1             0203*   ; inputs: ub.c is dx, ud.e is dy
041AB1             0204*   ;   the fractional portiion of the inputs are truncated
041AB1             0205*   ;   leaving only the 16-bit integer portion
041AB1             0206*   ; prerequisites: vdu_sprite_select
041AB1             0207*   vdu_sprite_move_rel168:
041AB1             0208*   ; populate in the reverse of normal to keep the
041AB1             0209*   ; inputs from stomping on each other
041AB1 ED 53 D0 1A 0210*       ld (@dy-1),de
       04          
041AB6 ED 43 CE 1A 0211*       ld (@dx-1),bc
       04          
041ABB 3E 0E       0212*       ld a,14       ; restore the final byte of the command
041ABD 32 CE 1A 04 0213*       ld (@cmd+2),a ; string that got stomped on by bcu
041AC1 21 CC 1A 04 0214*       ld hl,@cmd
041AC5 01 07 00 00 0215*       ld bc,@end-@cmd
041AC9 5B DF       0216*       rst.lil $18
041ACB C9          0217*       ret
041ACC 17 1B 0E    0218*   @cmd:  db 23,27,14
041ACF 00 00       0219*   @dx: dw 0x0000
041AD1 00 00       0220*   @dy: dw 0x0000
041AD3             0221*   @end:  ; no padding required b/c we shifted de right
041AD3             0222*   
041AD3             0223*   ; VDU 23, 27, 15: Update the sprites in the GPU
041AD3             0224*   ; inputs: none
041AD3             0225*   vdu_sprite_update:
041AD3 21 DE 1A 04 0226*       ld hl,@cmd
041AD7 01 03 00 00 0227*       ld bc,@end-@cmd
041ADB 5B DF       0228*       rst.lil $18
041ADD C9          0229*       ret
041ADE 17 1B 0F    0230*   @cmd: db 23,27,15
041AE1             0231*   @end:
041AE1             0232*   
041AE1             0233*   ; VDU 23, 27, 16: Reset bitmaps and sprites and clear all data
041AE1             0234*   ; inputs: none
041AE1             0235*   vdu_sprite_bmp_reset:
041AE1 21 EC 1A 04 0236*       ld hl,@cmd
041AE5 01 03 00 00 0237*       ld bc,@end-@cmd
041AE9 5B DF       0238*       rst.lil $18
041AEB C9          0239*       ret
041AEC 17 1B 10    0240*   @cmd: db 23,27,16
041AEF             0241*   @end:
041AEF             0242*   
041AEF             0243*   ; VDU 23, 27, 17: Reset sprites (only) and clear all data
041AEF             0244*   ; inputs: none
041AEF             0245*   vdu_sprite_reset:
041AEF 21 FA 1A 04 0246*       ld hl,@cmd
041AF3 01 03 00 00 0247*       ld bc,@end-@cmd
041AF7 5B DF       0248*       rst.lil $18
041AF9 C9          0249*       ret
041AFA 17 1B 11    0250*   @cmd: db 23,27,17
041AFD             0251*   @end:
041AFD             0252*   
041AFD             0253*   ; VDU 23, 27, 18, n: Set the current sprite GCOL paint mode to n **
041AFD             0254*   ; inputs: a is the GCOL paint mode
041AFD             0255*   ; prerequisites: vdu_sprite_select
041AFD             0256*   vdu_sprite_set_gcol:
041AFD 32 0F 1B 04 0257*       ld (@mode),a
041B01 21 0C 1B 04 0258*       ld hl,@cmd
041B05 01 04 00 00 0259*       ld bc,@end-@cmd
041B09 5B DF       0260*       rst.lil $18
041B0B C9          0261*       ret
041B0C 17 1B 12    0262*   @cmd:  db 23,27,18
041B0F 00          0263*   @mode: db 0x00
041B10             0264*   @end:
041B10             0265*   
041B10             0266*   ; VDU 23, 27, &26, n;: Add bitmap n as a frame to current sprite using a 16-bit buffer ID
041B10             0267*   ; inputs: hl=bufferId
041B10             0268*   ; prerequisites: vdu_sprite_select
041B10             0269*   vdu_sprite_add_buff:
041B10 22 22 1B 04 0270*       ld (@bufferId),hl
041B14 21 1F 1B 04 0271*       ld hl,@cmd
041B18 01 05 00 00 0272*       ld bc,@end-@cmd
041B1C 5B DF       0273*       rst.lil $18
041B1E C9          0274*       ret
041B1F 17 1B 26    0275*   @cmd:      db 23,27,0x26
041B22 00 00       0276*   @bufferId: dw 0x0000
041B24 00          0277*   @end:      db 0x00 ; padding
041B25             0045        include "agnb_api.inc"
041B25             0001*   ; Canonical AGNB image/audio loader API
041B25             0002*   ; =====================================
041B25             0003*   ;
041B25             0004*   ; Public entry points:
041B25             0005*   ;   agnb_load_images: DE -> zero-terminated AGNB 0.1 image filename
041B25             0006*   ;   agnb_load_images_with_callback:
041B25             0007*   ;                     DE -> filename, HL -> completed-image callback
041B25             0008*   ;   agnb_load_audio:  DE -> zero-terminated AGNB 0.2 audio filename
041B25             0009*   ;   agnb_load_audio_with_callback:
041B25             0010*   ;                     DE -> filename, HL -> completed-audio callback
041B25             0011*   ;
041B25             0012*   ; Applications own plotting, playback, input, timing, and debug behavior.
041B25             0013*   ; External dependencies and reference implementations are documented in
041B25             0014*   ; README.md and agnb_dependencies.inc.
041B25             0015*   ;
041B25             0016*   ; AGNB 0.1 image-container layout
041B25             0017*   ; ===============================
041B25             0018*   ;
041B25             0019*   ; AGNB is a RIFF container. All integer fields are unsigned little-endian.
041B25             0020*   ; Every chunk begins with a four-byte ID and a u32 payload size. The payload
041B25             0021*   ; follows immediately and is padded with zero bytes to a four-byte boundary.
041B25             0022*   ; The stored chunk size excludes its eight-byte header and alignment padding.
041B25             0023*   ;
041B25             0024*   ;     RIFF  u32(file size - 8)  AGNB
041B25             0025*   ;       VERS  size=2
041B25             0026*   ;         u8 major=0
041B25             0027*   ;         u8 minor=1
041B25             0028*   ;       LIST  type=BUFR
041B25             0029*   ;         BHDR  size=2
041B25             0030*   ;           u16 bufferId
041B25             0031*   ;         IMAG  size=5
041B25             0032*   ;           u16 width
041B25             0033*   ;           u16 height
041B25             0034*   ;           u8  format=1        ; RGBA2222
041B25             0035*   ;         DATA  size=width*height
041B25             0036*   ;           u8 pixels[]         ; row-major, no row padding
041B25             0037*   ;
041B25             0038*   ; VERS occurs once before the LIST records. Each version 0.1 LIST BUFR record
041B25             0039*   ; contains exactly BHDR, IMAG, and DATA in that order. The LIST payload starts
041B25             0040*   ; with its four-byte BUFR type, followed by those nested chunks. Readers must
041B25             0041*   ; validate the enclosing RIFF/LIST bounds and the BHDR/IMAG metadata before
041B25             0042*   ; reading or uploading DATA. Chunk traversal advances by:
041B25             0043*   ;
041B25             0044*   ;     8 + ((payload_size + 3) & ~3)
041B25             0045*   ;
041B25             0046*   ; The offsets below are indices from the beginning of the named header or
041B25             0047*   ; payload. RIFF and chunk sizes are u32 values even though ADL registers are
041B25             0048*   ; 24-bit, so their high byte must not be silently discarded during validation.
041B25             0049*   
041B25             0050*   ; RIFF file header: "RIFF", u32 size, "AGNB"
041B25             0051*   agnb_riff_id:              equ 0
041B25             0052*   agnb_riff_size:            equ 4
041B25             0053*   agnb_riff_form:            equ 8
041B25             0054*   agnb_riff_header_size:     equ 12
041B25             0055*   
041B25             0056*   ; Generic RIFF chunk header: FourCC ID, u32 payload size
041B25             0057*   agnb_chunk_id:             equ 0
041B25             0058*   agnb_chunk_size:           equ 4
041B25             0059*   agnb_chunk_data:           equ 8
041B25             0060*   agnb_chunk_header_size:    equ 8
041B25             0061*   
041B25             0062*   ; VERS payload
041B25             0063*   agnb_vers_major:           equ 0
041B25             0064*   agnb_vers_minor:           equ 1
041B25             0065*   agnb_vers_payload_size:    equ 2
041B25             0066*   
041B25             0067*   ; LIST BUFR payload
041B25             0068*   agnb_list_type:            equ 0
041B25             0069*   agnb_list_chunks:          equ 4
041B25             0070*   agnb_list_type_size:       equ 4
041B25             0071*   
041B25             0072*   ; BHDR payload
041B25             0073*   agnb_bhdr_bufferId:        equ 0
041B25             0074*   agnb_bhdr_payload_size:    equ 2
041B25             0075*   
041B25             0076*   ; IMAG payload
041B25             0077*   agnb_imag_width:           equ 0
041B25             0078*   agnb_imag_height:          equ 2
041B25             0079*   agnb_imag_format:          equ 4
041B25             0080*   agnb_imag_payload_size:    equ 5
041B25             0081*   
041B25             0082*   ; DATA payload
041B25             0083*   agnb_data_pixels:          equ 0
041B25             0084*   
041B25             0085*   ; Values supported by the version 0.1 image loader
041B25             0086*   agnb_version_major:        equ 0
041B25             0087*   agnb_version_minor:        equ 1
041B25             0088*   agnb_image_rgba2222:       equ 1
041B25             0089*   
041B25             0090*   
041B25             0091*   ; FourCC constants
041B25             0092*   ; ----------------
041B25             0093*   ; Store each identifier exactly as it appears on disk. agnb_compare_fourcc
041B25             0094*   ; compares one of these tables with four bytes read from the container.
041B25             0095*   
041B25 52 49 46 46 0096*   agnb_id_riff:              db "RIFF"
041B29 41 47 4E 42 0097*   agnb_id_agnb:              db "AGNB"
041B2D 56 45 52 53 0098*   agnb_id_vers:              db "VERS"
041B31 4C 49 53 54 0099*   agnb_id_list:              db "LIST"
041B35 42 55 46 52 0100*   agnb_id_bufr:              db "BUFR"
041B39 42 48 44 52 0101*   agnb_id_bhdr:              db "BHDR"
041B3D 49 4D 41 47 0102*   agnb_id_imag:              db "IMAG"
041B41 44 41 54 41 0103*   agnb_id_data:              db "DATA"
041B45             0104*   
041B45             0105*   
041B45             0106*   ; Reader result codes
041B45             0107*   ; -------------------
041B45             0108*   ; Public routines will return A=0 with Z set on success, or one of these
041B45             0109*   ; nonzero values with NZ set on failure. The same value is stored in
041B45             0110*   ; agnb_last_error.
041B45             0111*   
041B45             0112*   agnb_error_ok:             equ 0
041B45             0113*   agnb_error_open:           equ 1
041B45             0114*   agnb_error_read:           equ 2
041B45             0115*   agnb_error_seek:           equ 3
041B45             0116*   agnb_error_riff_id:        equ 4
041B45             0117*   agnb_error_riff_form:      equ 5
041B45             0118*   agnb_error_version:        equ 6
041B45             0119*   agnb_error_chunk:          equ 7
041B45             0120*   agnb_error_bounds:         equ 8
041B45             0121*   agnb_error_bufferId:       equ 9
041B45             0122*   agnb_error_metadata:       equ 10
041B45             0123*   agnb_error_data_size:      equ 11
041B45             0124*   agnb_error_vdp:            equ 12
041B45             0125*   agnb_error_eof:            equ 13
041B45             0126*   agnb_error_not_implemented: equ 255
041B45             0127*   
041B45             0128*   
041B45             0129*   ; FatFS file structure
041B45             0130*   ; --------------------
041B45             0131*   ; The direct ffs_* API needs one caller-owned FIL. Its field indices come from
041B45             0132*   ; mos_api.inc. No FILINFO is needed for opening, reading, seeking, or closing
041B45             0133*   ; the single known container filename.
041B45             0134*   
041B45             0135*   agnb_fil_size:             equ fil_dir_ptr+3
041B45             0136*   agnb_fil:
041B45 00 00 00 00 0137*       blkb agnb_fil_size,0
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
041B69             0138*   
041B69             0139*   
041B69             0140*   ; Reader-state structure
041B69             0141*   ; ----------------------
041B69             0142*   ; RIFF sizes and offsets are u32 and are kept as four bytes even though most
041B69             0143*   ; eZ80 arithmetic is 24-bit. The byte at offset +3 must participate in bounds
041B69             0144*   ; checks and FatFS seeks.
041B69             0145*   
041B69             0146*   agnb_state_file_size:      equ 0  ; u32 physical size from FIL object
041B69             0147*   agnb_state_riff_end:       equ 4  ; u32 first byte after RIFF contents
041B69             0148*   agnb_state_list_end:       equ 8  ; u32 first byte after current LIST payload
041B69             0149*   agnb_state_chunk_size:     equ 12 ; u32 current chunk payload size
041B69             0150*   agnb_state_chunk_end:      equ 16 ; u32 first byte after current payload
041B69             0151*   agnb_state_file_offset:    equ 20 ; u32 current logical read position
041B69             0152*   agnb_state_bytes_read:     equ 24 ; u32 last read count (high byte normally 0)
041B69             0153*   agnb_state_size:           equ 28
041B69             0154*   
041B69             0155*   agnb_state:
041B69 00 00 00 00 0156*       blkb agnb_state_size,0
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
       00 00 00 00 
041B85             0157*   
041B85             0158*   
041B85             0159*   ; Normalized image metadata
041B85             0160*   ; -------------------------
041B85             0161*   ; BHDR and IMAG are copied here and validated completely before DATA is read.
041B85             0162*   
041B85             0163*   agnb_meta_bufferId:        equ 0  ; u16 writer-specified VDP bufferId
041B85             0164*   agnb_meta_width:           equ 2  ; u16 pixels
041B85             0165*   agnb_meta_height:          equ 4  ; u16 pixels
041B85             0166*   agnb_meta_format:          equ 6  ; u8, version 0.1 requires RGBA2222
041B85             0167*   agnb_meta_data_size:       equ 7  ; u32 DATA payload size
041B85             0168*   agnb_meta_size:            equ 11
041B85             0169*   
041B85             0170*   agnb_metadata:
041B85 00 00 00 00 0171*       blkb agnb_meta_size,0
       00 00 00 00 
       00 00 00    
041B90             0172*   
041B90             0173*   ; Retained u32 result from agnb_calculate_image_data_size for validation and
041B90             0174*   ; temporary test inspection. The high byte is zero for the 24-bit product.
041B90             0175*   agnb_expected_data_size:
041B90 00 00 00 00 0176*       blkb 4,0
041B94             0177*   
041B94             0178*   ; Working counters used by agnb_stream_data. DATA sizes accepted by the image
041B94             0179*   ; loader have already been constrained to 24 bits.
041B94             0180*   agnb_stream_remaining:
041B94 00 00 00    0181*       blkb 3,0
041B97             0182*   agnb_stream_block_size:
041B97 00 00 00    0183*       blkb 3,0
041B9A             0184*   agnb_padding_size:
041B9A 00          0185*       db 0
041B9B             0186*   
041B9B             0187*   ; Record-validation flags. These are reset at the start of each LIST BUFR.
041B9B             0188*   agnb_record_has_bhdr:      equ 0
041B9B             0189*   agnb_record_has_imag:      equ 1
041B9B             0190*   agnb_record_has_data:      equ 2
041B9B             0191*   
041B9B 00          0192*   agnb_record_flags:         db 0
041B9C 00          0193*   agnb_last_error:           db agnb_error_ok
041B9D 00          0194*   agnb_file_is_open:         db 0
041B9E             0195*   
041B9E             0196*   
041B9E             0197*   ; Reusable I/O storage
041B9E             0198*   ; --------------------
041B9E             0199*   ; The 12-byte buffer is large enough for either the RIFF file header or a
041B9E             0200*   ; generic chunk header plus the four-byte LIST type. DATA is streamed through
041B9E             0201*   ; the application's existing 8 KiB SRAM filedata area.
041B9E             0202*   
041B9E             0203*   agnb_header:
041B9E 00 00 00 00 0204*       blkb agnb_riff_header_size,0
       00 00 00 00 
       00 00 00 00 
