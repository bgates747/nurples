0421A7 CD DD 18 04 0092*       call vdu_sprite_select
0421AB CD 53 83 04 0093*       call sprite_frame_heading ; a, sprite_frame set to heading-based frame
0421AF CD 40 19 04 0094*       call vdu_sprite_select_frame
