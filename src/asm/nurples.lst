048D86 21 B3 88 04 0145*       ld hl,tile_fault_flags
048D8A CB C6       0146*       set tile_fault_bad_record,(hl)
048D8C CD 0A 8A 04 0147*       call tile_stack_quarantine_entry
048D90 C3 6A 8D 04 0148*       jp @next_record
