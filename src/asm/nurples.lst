044AF5             0049*   
044AF5             0050*   move_enemy_fireball:
044AF5             0051*   ; run the movement program for the fireball enemy
044AF5 CD BE 6A 04 0052*       call move_sprite
044AF9 3A BF 67 04 0053*       ld a,(sprite_screen_edge)
044AFD B7          0054*       or a ; a will be non-zero if have scrolled off screen
044AFE C2 3C 68 04 0055*       jp nz,table_deactivate_sprite
044B02 DD 21 D8 8E 0056*       ld ix,player_begin
       04          
044B07 DD CB 1D 76 0057*       bit sprite_alive,(ix+sprite_collisions)
044B0B CA 1F 4B 04 0058*       jp z,@animate ; player is dead so don't check for collisions
044B0F CD 20 4A 04 0059*       call check_enemy_collision_player
044B13 C2 1F 4B 04 0060*       jp nz,@animate ; no collision so do animation
044B17 CD 6A 67 04 0061*       call update_shields
