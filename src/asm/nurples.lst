041436             0275*   @end:
041436             0276*   
041436             0277*   ; VDU 23, 27, &20, bufferId; : Select bitmap (using a buffer ID)
041436             0278*   ; inputs: hl=bufferId
041436             0279*   vdu_buff_select:
041436 22 48 14 04 0280*   	ld (@bufferId),hl
04143A 21 45 14 04 0281*   	ld hl,@cmd
04143E 01 05 00 00 0282*   	ld bc,@end-@cmd
041442 5B DF       0283*   	rst.lil $18
041444 C9          0284*   	ret
041445 17 1B 20    0285*   @cmd: db 23,27,0x20
041448 00 00       0286*   @bufferId: dw 0x0000
04144A 00          0287*   @end: db 0x00 ; padding
04144B             0288*   
04144B             0289*   ; VDU 23, 27, &21, w; h; format: Create bitmap from selected buffer
04144B             0290*   ; inputs: a=format; bc=width; de=height
04144B             0291*   ; prerequisites: buffer selected by vdu_bmp_select or vdu_buff_select
04144B             0292*   ; formats: https://agonconsole8.github.io/agon-docs/VDP---Bitmaps-API.html
04144B             0293*   ; 0 	RGBA8888 (4-bytes per pixel)
04144B             0294*   ; 1 	RGBA2222 (1-bytes per pixel)
04144B             0295*   ; 2 	Mono/Mask (1-bit per pixel)
04144B             0296*   ; 3 	Reserved for internal use by VDP (“native” format)
04144B             0297*   vdu_bmp_create:
04144B ED 43 67 14 0298*       ld (@width),bc
       04          
041450 ED 53 69 14 0299*       ld (@height),de
       04          
041455 32 6B 14 04 0300*       ld (@fmt),a
041459 21 64 14 04 0301*   	ld hl,@cmd
04145D 01 08 00 00 0302*   	ld bc,@end-@cmd
041461 5B DF       0303*   	rst.lil $18
041463 C9          0304*   	ret
041464 17 1B 21    0305*   @cmd:       db 23,27,0x21
041467 00 00       0306*   @width:     dw 0x0000
041469 00 00       0307*   @height:    dw 0x0000
04146B 00          0308*   @fmt:       db 0x00
04146C             0309*   @end:
04146C             0310*   
04146C             0311*   ; load an rgba2222 image file to a working buffer and make it an rgba8888 bitmap in a target buffer
04146C             0312*   ; inputs: bc,de image width,height ; hl = targetBufferId ; ix = file size ; iy = pointer to filename
04146C             0313*   vdu_load_img_rgba2_to_8:
04146C             0314*   ; backup the target buffer id and image dimensions
04146C E5          0315*       push hl
04146D D5          0316*       push de
04146E C5          0317*       push bc
04146F             0318*   ; load the rgba2 image to working buffer 65534
04146F 21 FE FF 00 0319*       ld hl,65534 ; temporary working buffer id
041473 CD 4A 15 04 0320*   	call vdu_load_buffer_from_file
041477             0321*   ; restore the image dimensions and target buffer id
041477 C1          0322*       pop bc
041478 D1          0323*       pop de
041479 E1          0324*       pop hl
04147A             0325*   ; fall through to vdu_rgba2_to_8
04147A             0326*   
04147A             0327*   ; https://discord.com/channels/1158535358624039014/1158536711148675072/1257757461729771771
04147A             0328*   ; ok, so the "expand bitmap" can be used, when coupled with a "reverse" - the expanded bitmap _doesn't_ come out "right" otherwise, cos of endian-ness
04147A             0329*   ; the "expand bitmap" command is:
04147A             0330*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
04147A             0331*   ; and then to reverse the byte order to fix endian-ness:
04147A             0332*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
04147A             0333*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
04147A             0334*   ; VDU 23,27,&20,targetBufferID%;
04147A             0335*   ; VDU 23,27,&21,width%;height%;0
04147A             0336*   ; -------------------------------------------------------------------
04147A             0337*   ; inputs: bc,de image width,height ; hl = targetBufferId
04147A             0338*   ; prerequisites: rgba2 image data loaded into workingBufferId 65534
04147A             0339*   vdu_rgba2_to_8:
04147A             0340*   ; load the image dimensions and buffer id parameters
04147A ED 43 D6 14 0341*       ld (@width),bc
       04          
04147F ED 53 D8 14 0342*       ld (@height),de
       04          
041484 22 BB 14 04 0343*       ld (@bufferId0),hl
041488 22 C8 14 04 0344*       ld (@bufferId2),hl
04148C 22 D1 14 04 0345*       ld (@bufferId1),hl
041490             0346*   ; clean up bytes that got stomped on by the ID loads
041490 3E 48       0347*       ld a,0x48
041492 32 BD 14 04 0348*       ld (@bufferId0+2),a
041496 3E 17       0349*       ld a,23
041498 32 D3 14 04 0350*       ld (@bufferId1+2),a
04149C 3E 18       0351*       ld a,24
04149E 32 CA 14 04 0352*       ld (@bufferId2+2),a
0414A2 AF          0353*       xor a
0414A3 32 DA 14 04 0354*       ld (@height+2),a
0414A7             0355*   ; send the vdu command strings
0414A7 21 B2 14 04 0356*       ld hl,@beg
0414AB 01 29 00 00 0357*       ld bc,@end-@beg
0414AF 5B DF       0358*       rst.lil $18
0414B1 C9          0359*       ret
0414B2             0360*   @beg:
0414B2             0361*   ; Command 14: Consolidate blocks in a buffer
0414B2             0362*   ; VDU 23, 0, &A0, bufferId; 14
0414B2 17 00 A0    0363*       db 23,0,0xA0
0414B5 FE FF       0364*       dw 65534 ; workingBufferId
0414B7 0E          0365*       db 14 ; consolidate blocks
0414B8             0366*   ; the "expand bitmap" command is:
0414B8             0367*   ; VDU 23,0,&A0,targetBufferID%;&48,2,sourceBufferId%;0,&7F,&BF,&FF
0414B8 17 00 A0    0368*       db 23,0,0xA0
0414BB 00 00       0369*   @bufferId0: dw 0x0000 ; targetBufferId
0414BD 48          0370*       db 0x48 ; given as decimal command 72 in the docs
0414BE 02          0371*       db 2 ; options mask: %00000011 is the number of bits per pixel in the source bitmap
0414BF FE FF       0372*       dw 65534 ; sourceBufferId
0414C1 00 7F BF FF 0373*       db 0x00,0x7F,0xBF,0xFF ; expanding to bytes by bit-shifting?
0414C5             0374*   ; reverse the byte order to fix endian-ness:
0414C5             0375*   ; Command 24: Reverse the order of data of blocks within a buffer
0414C5             0376*   ; VDU 23, 0, &A0, bufferId; 24, options, [valueSize;] [chunkSize;]
0414C5             0377*   ; VDU 23,0,&A0,targetBufferID%;24,4,4;
0414C5 17 00 A0    0378*       db 23,0,0xA0
0414C8 00 00       0379*   @bufferId2:    dw 0x0000 ; targetBufferId
0414CA 18          0380*       db 24 ; reverse byte order
0414CB 04          0381*       db 4 ; option: Reverse data of the value size within chunk of data of the specified size
0414CC 04 00       0382*       dw 4 ; size (4 bytes)
0414CE             0383*   ; finally you'd need to set that buffer to be an RGBA8888 format bitmap:
0414CE             0384*   ; VDU 23,27,&20,targetBufferID%;
0414CE 17 1B 20    0385*       db 23,27,0x20 ; select bitmap
0414D1 00 00       0386*   @bufferId1: dw 0x0000 ; targetBufferId
0414D3             0387*   ; VDU 23,27,&21,width%;height%;0
0414D3 17 1B 21    0388*       db 23,27,0x21 ; create bitmap from buffer
0414D6 00 00       0389*   @width: dw 0x0000
0414D8 00 00       0390*   @height: dw 0x0000
0414DA 00          0391*       db 0x00 ; rgba8888 format
0414DB             0392*   @end:
0414DB             0393*   
0414DB             0394*   ; scratch variables
0414DB 00 00 00    0395*   bufferId0: dl 0x000000
0414DE 00 00 00    0396*   bufferId1: dl 0x000000
0414E1             0397*   
0414E1             0398*   ; load a vdu buffer from local memory
0414E1             0399*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
0414E1             0400*   vdu_load_buffer:
0414E1 ED 43 0A 15 0401*       ld (@length),bc
       04          
0414E6 D5          0402*       push de ; save data pointer
0414E7             0403*   ; send the vdu command string
0414E7 7D          0404*       ld a,l
0414E8 32 07 15 04 0405*       ld (@bufferId),a
0414EC 7C          0406*       ld a,h
0414ED 32 08 15 04 0407*       ld (@bufferId+1),a
0414F1 21 04 15 04 0408*       ld hl,@cmd
0414F5 01 08 00 00 0409*       ld bc,@end-@cmd
0414F9 5B DF       0410*       rst.lil $18
0414FB             0411*   ; send the buffer data
0414FB E1          0412*       pop hl ; pointer to data
0414FC ED 4B 0A 15 0413*       ld bc,(@length)
       04          
041501 5B DF       0414*       rst.lil $18 ; send it
041503 C9          0415*       ret
041504             0416*   ; Upload data :: VDU 23, 0 &A0, bufferId; 0, length; <buffer-data>
041504 17 00 A0    0417*   @cmd:       db 23,0,0xA0
041507 00 00       0418*   @bufferId:	dw 0x0000
041509 00          0419*   		    db 0 ; load buffer
04150A 00 00       0420*   @length:	dw 0x0000
04150C 00          0421*   @end: db 0 ; padding
04150D             0422*   
04150D             0423*   ; Command 14: Consolidate blocks in a buffer
04150D             0424*   vdu_consolidate_buffer:
04150D             0425*   ; set parameters for vdu call
04150D 7D          0426*       ld a,l
04150E 32 25 15 04 0427*       ld (@bufferId),a
041512 7C          0428*       ld a,h
041513 32 26 15 04 0429*       ld (@bufferId+1),a
041517 21 22 15 04 0430*       ld hl,@beg
04151B 01 06 00 00 0431*       ld bc,@end-@beg
04151F 5B DF       0432*       rst.lil $18
041521 C9          0433*       ret
041522             0434*   ; VDU 23, 0, &A0, bufferId; 14
041522 17 00 A0    0435*   @beg: db 23,0,0xA0
041525 00 00       0436*   @bufferId: dw 0x0000
041527 0E          0437*              db 14
041528             0438*   @end:
041528             0439*   
041528             0440*   ; load an image file to a buffer and make it a bitmap
041528             0441*   ; inputs: a = image type ; bc,de image width,height ; hl = bufferId ; ix = file size ; iy = pointer to filename
041528             0442*   vdu_load_img:
041528             0443*   ; back up image type and dimension parameters
041528 22 DB 14 04 0444*       ld (bufferId0),hl
04152C F5          0445*       push af
04152D C5          0446*   	push bc
04152E D5          0447*   	push de
04152F             0448*   ; load the image
04152F CD 4A 15 04 0449*   	call vdu_load_buffer_from_file
041533             0450*   ; now make it a bitmap
041533 2A DB 14 04 0451*       ld hl,(bufferId0)
041537 CD 0D 15 04 0452*       call vdu_consolidate_buffer
04153B 2A DB 14 04 0453*       ld hl,(bufferId0)
04153F CD 36 14 04 0454*       call vdu_buff_select
041543 D1          0455*   	pop de ; image height
041544 C1          0456*   	pop bc ; image width
041545 F1          0457*   	pop af ; image type
041546 C3 4B 14 04 0458*   	jp vdu_bmp_create ; will return to caller from there
04154A             0459*   
04154A             0460*   ; inputs: hl = bufferId; iy = pointer to filename
04154A             0461*   vdu_load_buffer_from_file:
04154A 22 DB 14 04 0462*       ld (bufferId0),hl
04154E             0463*   
04154E             0464*   ; clear target buffer
04154E CD F6 16 04 0465*       call vdu_clear_buffer
041552             0466*   
041552             0467*   ; open the file in read mode
041552             0468*   ; Open a file
041552             0469*   ; HLU: Filename
041552             0470*   ;   C: Mode
041552             0471*   ; Returns:
041552             0472*   ;   A: Filehandle, or 0 if couldn't open
041552 FD E5       0473*   	push iy ; pointer to filename
041554 E1          0474*   	pop hl
041555 0E 01       0475*   	ld c,fa_read
041557             0476*       MOSCALL mos_fopen
                       M1 Args: function=mos_fopen 
041557 3E 0A       0001*M1 			LD	A, function
041559 5B CF       0002*M1 			RST.LIL	08h
04155B 32 96 15 04 0477*       ld (@filehandle),a
04155F             0478*   
04155F             0479*   @read_file:
04155F             0480*   ; Read a block of data from a file
04155F             0481*   ;   C: Filehandle
04155F             0482*   ; HLU: Pointer to where to write the data to
04155F             0483*   ; DEU: Number of bytes to read
04155F             0484*   ; Returns:
04155F             0485*   ; DEU: Number of bytes read
04155F 3A 96 15 04 0486*       ld a,(@filehandle)
041563 4F          0487*       ld c,a
041564 21 00 E0 B7 0488*       ld hl,filedata
041568 11 00 20 00 0489*       ld de,8192 ; max we can read into onboard sram at one time
04156C             0490*       MOSCALL mos_fread
                       M1 Args: function=mos_fread 
04156C 3E 1A       0001*M1 			LD	A, function
04156E 5B CF       0002*M1 			RST.LIL	08h
041570             0491*   
041570             0492*   ; test de for zero bytes read
041570 21 00 00 00 0493*       ld hl,0
041574 AF          0494*       xor a ; clear carry
041575 ED 52       0495*       sbc hl,de
041577 CA 8D 15 04 0496*       jp z,@close_file
04157B             0497*   
04157B             0498*   ; load a vdu buffer from local memory
04157B             0499*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
04157B 2A DB 14 04 0500*       ld hl,(bufferId0)
04157F D5          0501*       push de ; chunksize
041580 C1          0502*       pop bc
041581 11 00 E0 B7 0503*       ld de,filedata
041585 CD E1 14 04 0504*       call vdu_load_buffer
041589             0505*   
041589             0506*   ; read the next block
041589 C3 5F 15 04 0507*       jp @read_file
04158D             0508*   
04158D             0509*   ; close the file
04158D             0510*   @close_file:
04158D 3A 96 15 04 0511*       ld a,(@filehandle)
041591             0512*       MOSCALL mos_fclose
                       M1 Args: function=mos_fclose 
041591 3E 0B       0001*M1 			LD	A, function
041593 5B CF       0002*M1 			RST.LIL	08h
041595 C9          0513*       ret ; vdu_load_buffer_from_file
041596             0514*   
041596 00          0515*   @filehandle: db 0 ; file handle
041597 00 00 00    0516*   @fil: dl 0 ; pointer to FIL struct
04159A             0517*   
04159A 00 00 00    0518*   @chunkpointer: dl 0 ; pointer to current chunk
04159D             0519*   
04159D             0520*   ; File information structure (FILINFO)
04159D             0521*   @filinfo:
04159D 00 00 00 00 0522*   @filinfo_fsize:    blkb 4, 0   ; File size (4 bytes)
0415A1 00 00       0523*   @filinfo_fdate:    blkb 2, 0   ; Modified date (2 bytes)
0415A3 00 00       0524*   @filinfo_ftime:    blkb 2, 0   ; Modified time (2 bytes)
0415A5 00          0525*   @filinfo_fattrib:  blkb 1, 0   ; File attribute (1 byte)
0415A6 00 00 00 00 0526*   @filinfo_altname:  blkb 13, 0  ; Alternative file name (13 bytes)
       00 00 00 00 
       00 00 00 00 
       00          
0415B3 00 00 00 00 0527*   @filinfo_fname:    blkb 256, 0 ; Primary file name (256 bytes)
       00 00 00 00 
       00 00 00 00 
