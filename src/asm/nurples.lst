046F94             0138*   ; ; compute (Vt*sin(Heading_t-Bearing_t))
046F94             0139*   ;     ld de,(Vt)
046F94             0140*   ;     call smul168 ; uh.l = (Vt*sin(Heading_t-Bearing_t))
046F94             0141*   ; ; compute (Vt * sin(Heading_t-Bearing_t)) / Vp
