047EF0 1E 04       0053*       ld e,player_lasers_max ; sprite loop counter
047EF2             0054*   ; define laser sprites
047EF2             0055*   @sprites_loop:
047EF2 F5          0056*       push af
047EF3 D5          0057*       push de
047EF4 CD D7 18 04 0058*   	call vdu_sprite_select
047EF8 CD EA 18 04 0059*   	call vdu_sprite_clear_frames
047EFC 21 4E 01 00 0060*   	ld hl,BUF_LASER_A
047F00 06 02       0061*   	ld b,2 ; two bitmaps for laser
047F02             0062*   @frames_loop:
047F02 C5          0063*   	push bc
047F03 E5          0064*   	push hl
047F04 CD 2C 1A 04 0065*   	call vdu_sprite_add_buff
047F08 E1          0066*   	pop hl
047F09 23          0067*   	inc hl
047F0A C1          0068*   	pop bc
047F0B 10 F5       0069*   	djnz @frames_loop
047F0D D1          0070*       pop de ; sprite loop counter
047F0E F1          0071*       pop af ; sprite id
047F0F 3C          0072*       inc a
047F10 1D          0073*       dec e
047F11 C2 F2 7E 04 0074*       jp nz,@sprites_loop
047F15             0075*   ; set laser firing timer to zero
047F15 FD 21 AE 7E 0076*       ld iy,tmr_laser
       04          
047F1A 21 00 00 00 0077*       ld hl,0
047F1E CD 9A 12 04 0078*       call timestamp_tmr_set
047F22 C9          0079*       ret
