048D98 01          0008*       db 1                    ; num_orientations
048D99 04          0009*       db 4                    ; num_animations
048D9A 05          0010*       db 5	                ; animation
048D9B 08          0011*       db 8                    ; animation_timer
048D9C 00          0012*       db 0                    ; move_timer
048D9D 00          0013*       db 0                    ; move_step
048D9E 00          0014*       db 0                    ; points
048D9F 00          0015*       db 0                    ; shield_damage
