04814A             0001*   ; Game state variables
04814A 0B 82 04    0002*   game_state:  dl game_main_menu
04814D             0003*   game_fault_bad_state: equ 0
04814D 00          0004*   game_fault_flags: db 0 ; latched fail-closed diagnostics
04814E 00          0005*   game_exit_requested: db 0 ; main-loop handoff; state handlers must return normally
04814F             0006*   
04814F             0007*   do_game:
04814F 2A 4A 81 04 0008*       ld hl,(game_state)   ; Load the current game state
048153 CD 71 81 04 0009*       call game_state_pointer_valid
048157 DA 6A 81 04 0010*       jp c,@dispatch
04815B 21 4D 81 04 0011*       ld hl,game_fault_flags
04815F CB C6       0012*       set game_fault_bad_state,(hl)
048161 21 BC 82 04 0013*       ld hl,game_init ; publish recovery; do not run it in the corrupt frame
048165 22 4A 81 04 0014*       ld (game_state),hl
048169 C9          0015*       ret
04816A             0016*   @dispatch:
04816A             0017*       CALL_HL                ; Call the corresponding state handler
                       M1 Args: none
04816A 01 70 81 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
04816E C5          0002*M1     push bc ; which constitutes the return address
04816F E9          0003*M1     jp (hl) ; Jump to the address in HL
048170 C9          0018*       ret
048171             0019*   
048171             0020*   ; Exact stabilization whitelist for writable legacy global-state pointers.
048171             0021*   ; inputs/outputs: hl = candidate handler; carry set only for an exact match
048171             0022*   ; destroys: a,de
048171             0023*   game_state_pointer_valid:
048171 11 0B 82 04 0024*       ld de,game_main_menu
048175 CD 05 82 04 0025*       call @matches
048179 CA 03 82 04 0026*       jp z,@valid
04817D 11 0C 82 04 0027*       ld de,game_paused
048181 CD 05 82 04 0028*       call @matches
048185 CA 03 82 04 0029*       jp z,@valid
