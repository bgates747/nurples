0480BD             0070*   table_init:
0480BD             0071*   ; clear the sprite table
0480BD AF          0072*       xor a ; write zeroes to sprite table
0480BE 21 60 9B 04 0073*       ld hl,table_base ; address to copy from
0480C2 01 00 05 00 0074*       ld bc,table_end-table_base ; number of bytes to clear
0480C6 CD 5B 03 04 0075*       call clear_mem
0480CA             0076*   ; write sprite ids
0480CA DD 21 60 9B 0077*       ld ix,table_base
       04          
0480CF AF          0078*       xor a ; sprite id
0480D0 0E 00       0079*       ld c,0 ; sprite type
0480D2 06 14       0080*       ld b,table_num_records ; loop counter
0480D4             0081*   @loop:
0480D4 DD 77 00    0082*       ld (ix+sprite_id),a
0480D7 DD 71 16    0083*       ld (ix+sprite_type),c
0480DA ED 32 40    0084*       lea ix,ix+table_record_size
0480DD 3C          0085*       inc a
0480DE 10 F4       0086*       djnz @loop
0480E0 C9          0087*       ret
0480E1             0088*   ; end table_init
0480E1             0089*   
0480E1             0090*   ; deactivate the sprite with the given id
0480E1             0091*   ; inputs: iy set to sprite record
