044B27             0022*   enemy_spawn_seeker:
044B27 21 14 4B 04 0023*       ld hl,seeker_defaults
044B2B DD 21 5A 89 0024*       ld ix,seekers_base
       04          
044B30 06 03       0025*       ld b,seekers_max
044B32 CD D4 78 04 0026*       call spawn_sprite_from_tile
044B36 D0          0027*       ret nc ; no carry means no free sprite slots, so we go home
044B37             0028*   ; other specific initialization
044B37 21 80 02 00 0029*       ld hl,speed_seeker
