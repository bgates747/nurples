045FC1             0084*   ; Exact stabilization whitelist for writable legacy player-state pointers.
045FC1             0085*   ; Invalid actor state is surfaced as an event for the global coordinator.
045FC1             0086*   player_state_pointer_valid:
045FC1 11 81 60 04 0087*       ld de,player_alive
045FC5 CD E9 5F 04 0088*       call @matches
045FC9 CA E7 5F 04 0089*       jp z,@valid
045FCD 11 C4 60 04 0090*       ld de,player_dying
045FD1 CD E9 5F 04 0091*       call @matches
045FD5 CA E7 5F 04 0092*       jp z,@valid
045FD9 11 9F 61 04 0093*       ld de,player_dead
045FDD CD E9 5F 04 0094*       call @matches
045FE1 CA E7 5F 04 0095*       jp z,@valid
045FE5 AF          0096*       xor a
045FE6 C9          0097*       ret
045FE7             0098*   @valid:
045FE7 37          0099*       scf
045FE8 C9          0100*       ret
