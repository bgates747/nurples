046B06             0546*   ; compute animation frame based on sprite_animation and sprite_heading
046B06             0547*   ; inputs: table_pointer set to sprite record
046B06             0548*   ; outputs: a, sprite_frame set to animation frame
046B06             0549*   ; destroys: a,hl
046B06             0550*   sprite_frame_heading_animation:
046B06 FD 7E 11    0551*       ld a,(iy+sprite_heading+1) ; we want the integer portion
046B09 CB 3F       0552*       srl a ; divide integer portion by 8
046B0B CB 3F       0553*       srl a
046B0D CB 3F       0554*       srl a
046B0F FD 66 22    0555*       ld h,(iy+sprite_animation)
046B12 2E 20       0556*       ld l,32 ; 32 orientation frames per animation
046B14 ED 6C       0557*       mlt hl ; hl = offset from base animation
046B16 85          0558*       add a,l ; modulo256 since sprite_frame is only 1 byte
046B17 FD 77 28    0559*       ld (iy+sprite_frame),a
046B1A C9          0560*       ret
