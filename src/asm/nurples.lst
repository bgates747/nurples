046791             0057        include "levels.inc"
046791             0001*   ; tileset indices
046791             0002*   tiles_dg: equ 0
046791             0003*   ; tiles_xevious: equ 1
046791 00 00 00    0004*   tileset_ptr_idx: dl 0
046794             0005*   tileset_ptrs:
046794             0006*       ; dl tiles_xevious_levels
046794 1B 69 04    0007*       dl tileset_00_levels
046797 00 00 00    0008*   tileset_ptrs_end: dl 0 ; list terminator
04679A             0009*   
04679A             0010*   ; get a pointer to the current tileset
04679A             0011*   ; inputs: tileset_ptr_idx
04679A             0012*   ; returns: ix = pointer to tileset levels lut
04679A             0013*   get_tileset_ptr:
04679A 3A 91 67 04 0014*       ld a,(tileset_ptr_idx)
04679E 57          0015*       ld d,a ; d = tileset index
04679F 1E 03       0016*       ld e,3 ; three bytes per index record
0467A1 ED 5C       0017*       mlt de ; offset into tileset_ptrs lut
0467A3 DD 21 94 67 0018*       ld ix,tileset_ptrs
       04          
0467A8 DD 19       0019*       add ix,de ; ix = pointer to tileset_ptrs record
0467AA C9          0020*       ret
0467AB             0021*   ; end get_tileset_ptr
0467AB             0022*   
0467AB             0023*   ; intialize a tileset
0467AB             0024*   ; inputs: a = index into tileset_ptrs
0467AB             0025*   init_tileset:
0467AB 32 91 67 04 0026*       ld (tileset_ptr_idx),a ; store new tileset index
0467AF CD 9A 67 04 0027*       call get_tileset_ptr ; ix = pointer to tileset_ptrs record
0467B3 DD 37 00    0028*       ld ix,(ix) ; ix = pointer to tileset levels lut
0467B6 DD 7E FF    0029*       ld a,(ix-1) ; number of levels in the tileset
0467B9 32 E9 67 04 0030*       ld (num_levels),a
0467BD AF          0031*       xor a ; reset current level to zero
0467BE 32 E8 67 04 0032*       ld (cur_level),a
0467C2 C3 22 68 04 0033*       jp init_level
0467C6             0034*   ; end init_tileset
0467C6             0035*   
0467C6             0036*   next_tileset:
0467C6 21 91 67 04 0037*       ld hl,tileset_ptr_idx
0467CA 34          0038*       inc (hl) ; bump to next index
0467CB CD 9A 67 04 0039*       call get_tileset_ptr ; ix = pointer to tileset_ptrs record
0467CF DD 27 00    0040*       ld hl,(ix) ; ix = pointer to tileset levels lut
0467D2             0041*       sign_hlu ; check for list terminator (0)
                       M1 Args: none
0467D2 19          0001*M1     add hl,de ; 1 cycle
0467D3 B7          0002*M1     or a ; clear flags ; 1 cycle
0467D4 ED 52       0003*M1     sbc hl,de ; 2 cycles
0467D6             0004*M1     ; 4 cycles total
0467D6 C2 E4 67 04 0042*       jp nz,@F ; not end of list
0467DA 3E FF       0043*       ld a,-1 ; will wrap around to zero on the next iteration
0467DC 32 91 67 04 0044*       ld (tileset_ptr_idx),a
0467E0 C3 C6 67 04 0045*       jp next_tileset ; try again
0467E4             0046*   @@:
0467E4 C3 AB 67 04 0047*       jp init_tileset
0467E8             0048*   ; end next_tileset
0467E8             0049*   
0467E8 00          0050*   cur_level: db 0
0467E9 00          0051*   num_levels: db 0
0467EA             0052*   
0467EA             0053*   ; get a pointer to the current level lookup record
0467EA             0054*   ; inputs: tileset_ptr_idx, cur_level
0467EA             0055*   ; returns: ix = pointer to level definition
0467EA             0056*   get_level_ptr:
0467EA CD 9A 67 04 0057*       call get_tileset_ptr
0467EE DD 37 00    0058*       ld ix,(ix) ; ix = pointer to tileset levels lut
0467F1 3A E8 67 04 0059*       ld a,(cur_level)
0467F5 57          0060*       ld d,a ; d = level index
0467F6 1E 03       0061*       ld e,3 ; three bytes per level record
0467F8 ED 5C       0062*       mlt de ; offset into tileset levels lut
0467FA DD 19       0063*       add ix,de ; ix = pointer to level record
0467FC C9          0064*       ret
0467FD             0065*   ; end get_level_ptr
0467FD             0066*   
0467FD             0067*   ; advance to the next level in the current tileset
0467FD             0068*   ; inputs: tileset_ptr_idx, cur_level
0467FD             0069*   next_level:
0467FD             0070*   ; update starting score
0467FD 2A E8 7F 04 0071*       ld hl,(player_score)
046801 22 EB 7F 04 0072*       ld (player_starting_score),hl
046805             0073*   ; set up pointers to next map definition
046805 21 E8 67 04 0074*       ld hl,cur_level
046809 34          0075*       inc (hl) ; bump to next level
04680A CD EA 67 04 0076*       call get_level_ptr ; ix points to current level lookup record
04680E DD 27 00    0077*       ld hl,(ix) ; hl = pointer to next level lookup record
046811             0078*       sign_hlu ; check for list terminator (0)
                       M1 Args: none
046811 19          0001*M1     add hl,de ; 1 cycle
046812 B7          0002*M1     or a ; clear flags ; 1 cycle
046813 ED 52       0003*M1     sbc hl,de ; 2 cycles
046815             0004*M1     ; 4 cycles total
046815 C2 22 68 04 0079*       jp nz,@F ; not end of list
046819 AF          0080*       xor a ; reset level to zero
04681A 32 E8 67 04 0081*       ld (cur_level),a
04681E C3 C6 67 04 0082*       jp next_tileset ; try next tileset
046822             0083*   @@: ; fall through to init_level
046822             0084*   ; end next_level
046822             0085*   
046822             0086*   ; inputs: tileset_ptr_idx, cur_level
046822             0087*   init_level:
046822             0088*   ; ; initialize sprites and active tiles table
046822             0089*   ;     call sprites_init
046822             0090*   ;     call table_init
046822             0091*   ;     call tile_table_init
046822             0092*   ; set pointers
046822 CD EA 67 04 0093*       call get_level_ptr ; ix points to level lookup record
046826 DD 37 00    0094*       ld ix,(ix) ; ix points to level definition
046829             0095*   ; set tiles_cols
046829 DD 7E 00    0096*       ld a,(ix+0)
04682C 32 7C 8B 04 0097*       ld (tiles_cols),a
046830             0098*   ; set tiles_row counter
046830 DD 7E 01    0099*       ld a,(ix+1)
046833 32 79 8B 04 0100*       ld (tiles_row),a
046837             0101*   ; set cur_baseBufferId
046837 DD 27 04    0102*       ld hl,(ix+4)
04683A 22 7D 8B 04 0103*       ld (cur_baseBufferId),hl
04683E             0104*   ; set tiles_row_defs
04683E ED 32 07    0105*       lea ix,ix+7 ; ix points to definition of first tile of first row
046841 DD 22 76 8B 0106*       ld (tiles_row_defs),ix
       04          
046846             0107*   ; reset tile rows and plot coordinates
046846 21 FF FF FF 0108*       ld hl,-1
04684A 22 76 8C 04 0109*       ld (bg_y_plot),hl
04684E 23          0110*       inc hl
04684F 22 81 8B 04 0111*       ld (tiles_x_plot),hl
046853 21 F1 FF FF 0112*       ld hl,-15
046857 22 85 8B 04 0113*       ld (tiles_y_plot),hl
04685B             0114*   ; print level number, score, and countdown to start
04685B CD F2 68 04 0115*       call print_level
04685F CD 03 80 04 0116*       call print_score
046863 CD 91 68 04 0117*       call start_level_countdown
046867 C9          0118*       ret
046868             0119*   ; end init_level
046868             0120*   
046868             0121*   init_bg:
046868             0122*   ; draw initial background tiles
046868 21 00 04 00 0123*       ld hl,BUF_BG_STARS_0
04686C CD 36 14 04 0124*       call vdu_buff_select
046870 01 00 00 00 0125*       ld bc,0
046874 11 00 00 00 0126*       ld de,field_top
046878 CD 36 18 04 0127*       call vdu_plot_bmp
04687C 21 02 04 00 0128*       ld hl,BUF_BG_STARS_4
046880 CD 36 14 04 0129*       call vdu_buff_select
046884 01 00 00 00 0130*       ld bc,0
046888 11 00 01 00 0131*       ld de,field_top+256
04688C CD 36 18 04 0132*       call vdu_plot_bmp
046890 C9          0133*       ret
046891             0134*   ; end init_level
046891             0135*   start_level_countdown:
046891             0136*   ; set gfx origin and viewport to playing field window
046891 CD 75 80 04 0137*       call set_gfx_playing_field
046895 CD 68 68 04 0138*       call init_bg
046899             0139*   ; set text colors
046899 3E 90       0140*       ld a,16+128 ; darkest blue
04689B CD 72 13 04 0141*       call vdu_colour_text
04689F 3E 3A       0142*       ld a,58 ; dark orange
0468A1 CD 72 13 04 0143*       call vdu_colour_text
0468A5             0144*   ; print get ready message
0468A5 0E 1B       0145*       ld c,27 ; x
0468A7 06 10       0146*       ld b,16 ; y
0468A9 CD 2D 13 04 0147*       call vdu_move_cursor
0468AD CD 5C 00 04 0148*       call printInline
0468B1 47 65 74 20 0149*       asciz "Get Ready!"
       52 65 61 64 
       79 21 00    
