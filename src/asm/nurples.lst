044EE8 CD 6B 7C 04 0186*       call printHexA
044EEC 0E 26       0187*       ld c,38 ; x
044EEE 06 11       0188*       ld b,17 ; y
044EF0 CD B1 13 04 0189*       call vdu_move_cursor
044EF4 3E 80       0190*       ld a,%10000000 ; bit 7 changes once per second
044EF6 CD 20 13 04 0191*       call multiPurposeDelay
044EFA C1          0192*       pop bc
044EFB 10 E8       0193*       djnz @waitLoop
044EFD C9          0194*       ret
