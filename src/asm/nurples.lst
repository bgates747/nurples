048A12             0040*   
048A12             0041*   tile_table_init:
048A12             0042*   ; reset num active tiles
048A12 21 00 00 00 0043*       ld hl,0
048A16 22 0B 8A 04 0044*       ld (num_active_tiles),hl
048A1A             0045*   ; reset next tile id
048A1A AF          0046*       xor a
048A1B 32 0E 8A 04 0047*       ld (next_tile_id),a
048A1F             0048*   ; clear the tile stack
048A1F AF          0049*       xor a ; write zeroes to tile stack
048A20 21 02 87 04 0050*       ld hl,tile_stack
048A24 01 03 03 00 0051*       ld bc,tile_stack_end-tile_stack
048A28 CD 5B 03 04 0052*       call clear_mem
048A2C             0053*   ; clear the tile table
048A2C AF          0054*       xor a ; write zeroes to tile table
048A2D 21 60 A0 04 0055*       ld hl,tile_table_base ; address to copy from
048A31 01 00 40 00 0056*       ld bc,tile_table_end-tile_table_base ; number of bytes to clear
048A35 CD 5B 03 04 0057*       call clear_mem
048A39             0058*   ; write tile ids
048A39 DD 21 60 A0 0059*       ld ix,tile_table_base
       04          
048A3E AF          0060*       xor a ; tile id
048A3F 06 00       0061*       ld b,0 ; loop counter
048A41             0062*   @loop:
048A41 DD 77 00    0063*       ld (ix+tile_id),a
048A44 ED 32 40    0064*       lea ix,ix+table_record_size
048A47 3C          0065*       inc a
048A48 10 F7       0066*       djnz @loop
048A4A             0067*   ; set pointers to top of tile stack and tile table
048A4A 21 0E 8A 04 0068*       ld hl,next_tile_id
048A4E 3E FF       0069*       ld a,255 ; will wrap around to 0 on first call to create active tile
048A50 77          0070*       ld (hl),a
048A51 21 60 A0 04 0071*       ld hl,tile_table_base
048A55 22 08 8A 04 0072*       ld (tile_table_pointer),hl
048A59 21 02 87 04 0073*       ld hl,tile_stack
048A5D 22 05 8A 04 0074*       ld (tile_stack_pointer),hl
048A61 C9          0075*       ret
048A62             0076*   ; end tile_table_init
048A62             0077*   
048A62             0078*   ; gets the next available tile id
048A62             0079*   ; inputs; none
048A62             0080*   ; returns: if new tile available, a = tile id, ix pointing to new tile vars, carry set
048A62             0081*   ;      otherwise, a = 0, carry flag reset, ix pointing to highest tile vars
048A62             0082*   ; destroys: a,hl,ix
048A62             0083*   ; affects: on success, bumps num_active_tiles by one, adds a tile pointer to the top of the tile stack
048A62             0084*   tile_table_get_next_id:
048A62 21 0B 8A 04 0085*       ld hl,num_active_tiles
048A66 34          0086*       inc (hl)
048A67 C2 6E 8A 04 0087*       jp nz,@F ; check rollover to > 256 active tiles
048A6B 35          0088*       dec (hl) ; undo increment
048A6C AF          0089*       xor a ; reset carry flag indicating that we didn't find a free tile
048A6D C9          0090*       ret
048A6E             0091*   @@:
048A6E 7E          0092*       ld a,(hl) ; number of active tiles
048A6F             0093*   ; point ix to next tile record
048A6F 21 0E 8A 04 0094*       ld hl,next_tile_id
048A73 34          0095*       inc (hl)
048A74 56          0096*       ld d,(hl) ; index into tile table
048A75 1E 40       0097*       ld e,tile_table_record_size
048A77 ED 5C       0098*       mlt de ; de is now the offset to the table entry
048A79 DD 21 60 A0 0099*       ld ix,tile_table_base ; point to base address of tile table
       04          
048A7E DD 19       0100*       add ix,de ; ix is now the address of the table entry
048A80             0101*   ; add tile pointer to tile stack
048A80 21 02 87 04 0102*       ld hl,tile_stack
048A84 57          0103*       ld d,a ; number of active tiles
048A85 15          0104*       dec d ; zero-based index
048A86 1E 03       0105*       ld e,3 ; three bytes per tile record
048A88 ED 5C       0106*       mlt de ; offset into tile stack
048A8A 19          0107*       add hl,de ; hl points to top of the active tiles
048A8B ED 3F       0108*       ld (hl),ix
