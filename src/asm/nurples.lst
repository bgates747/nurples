047754 E5          0065*       push hl ; save pointer to next row tile def
047755 CD B5 77 04 0066*       call do_active_tiles
047759 E1          0067*       pop hl ; get back pointer to next row tile def
04775A             0068*   ; time to bump tiles_row_defs to next row
04775A             0069*   ; (hl was already there at the end of the loop)
04775A 22 D6 76 04 0070*       ld (tiles_row_defs),hl
04775E             0071*   ; reset coords to plot next row of tiles
04775E 21 00 00 00 0072*       ld hl,0
