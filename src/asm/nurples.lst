047F75 19          0119*       add hl,de
047F76 DD 2F 01    0120*       ld (ix+sprite_x),hl
047F79             0121*   ; y-coordinate
047F79 FD 27 04    0122*       ld hl,(iy+sprite_y)
047F7C 11 00 FA FF 0123*       ld de,-6*256 ; set laser y a few pixels above player
047F80 19          0124*       add hl,de
047F81 DD 2F 04    0125*       ld (ix+sprite_y),hl
047F84             0126*   ; set laser velocity
047F84 21 00 FC FF 0127*       ld hl,-laser_speed
047F88 DD 2F 0A    0128*       ld (ix+sprite_yvel),hl
047F8B C9          0129*       ret
