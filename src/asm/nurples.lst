0489C6             0209*   
0489C6             0210*   ; deactivate the tile with the given id
0489C6             0211*   ; inputs: tile_stack_pointer set to record to remove
0489C6             0212*   ; outputs: decrements num_active_tiles by one, tile_stack_pointer set to record above removed record, removes tile pointer from the tile stack, shifts stack records above it down one position
0489C6             0213*   ; destroys: a,hl,bc,de
0489C6             0214*   table_deactivate_tile:
0489C6             0215*   ; refuse malformed count/cursor/record combinations before moving memory
0489C6 3A AC 88 04 0216*       ld a,(num_active_tiles)
0489CA B7          0217*       or a
0489CB CA 03 8A 04 0218*       jp z,@invalid
0489CF 2A A6 88 04 0219*       ld hl,(tile_stack_pointer)
0489D3 CD 57 89 04 0220*       call tile_stack_pointer_valid
0489D7 D2 03 8A 04 0221*       jp nc,@invalid
0489DB 2A A6 88 04 0222*       ld hl,(tile_stack_pointer)
0489DF ED 27       0223*       ld hl,(hl)
0489E1 FD E5       0224*       push iy
0489E3 D1          0225*       pop de
0489E4 B7          0226*       or a
0489E5 ED 52       0227*       sbc hl,de
0489E7 C2 03 8A 04 0228*       jp nz,@invalid
0489EB CD 90 89 04 0229*       call tile_table_record_pointer_valid
0489EF D2 03 8A 04 0230*       jp nc,@invalid
0489F3             0231*   ; make the physical record reusable before compacting its stack entry
0489F3 FD CB 1D B6 0232*       res sprite_alive,(iy+tile_collisions)
0489F7 FD CB 1D BE 0233*       res sprite_just_died,(iy+tile_collisions)
0489FB FD CB 16 BE 0234*       res 7,(iy+tile_type)
0489FF C3 21 8A 04 0235*       jp tile_stack_remove_current_entry
048A03             0236*   @invalid:
048A03 21 B3 88 04 0237*       ld hl,tile_fault_flags
