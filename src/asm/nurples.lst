049257 CA 92 92 04 0040*       jp z,kill_pad_small
04925B             0041*   ; do animation
04925B FD 35 23    0042*       dec (iy+tile_animation_timer)
04925E C2 74 92 04 0043*       jp nz,@F
049262 3E 10       0044*       ld a,16
049264 FD 77 23    0045*       ld (iy+tile_animation_timer),a
049267 FD 7E 28    0046*       ld a,(iy+tile_frame)
04926A 3C          0047*       inc a
04926B E6 07       0048*       and %00000111 ; modulo 8
04926D FD 77 28    0049*       ld (iy+tile_frame),a
049270 CD 3C 8F 04 0050*       call draw_active_tile
049274             0051*   @@: ; check player alive
049274 DD 21 E2 A4 0052*       ld ix,player_begin
       04          
049279 DD CB 1D 76 0053*       bit sprite_alive,(ix+sprite_collisions)
04927D C8          0054*       ret z ; player dead so nothing more to do
04927E             0055*   ; check whether it is time to spawn a seeker
04927E FD 35 24    0056*       dec (iy+tile_move_timer)
049281 C0          0057*       ret nz
049282             0058*   ; spwan a seeker
049282 CD AB 4B 04 0059*       call enemy_spawn_seeker
049286             0060*       ; ret ; DEBUG
049286             0061*       ; fall through to reset move timer
049286             0062*   pad_small_reset_move_timer:
049286 CD 14 05 04 0063*       call rand_8     ; snag a random number
04928A E6 1F       0064*       and %00011111   ; keep only 5 lowest bits (max 31)
04928C C6 40       0065*       add a,64 ; range is now 64-127
04928E FD 77 24    0066*       ld (iy+tile_move_timer),a ; when this hits zero,will spawn a seeker
049291 C9          0067*       ret
