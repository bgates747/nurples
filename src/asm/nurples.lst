047896             0067        include "player_input.inc"
047896             0001*   ; Optional legacy GPIO joystick. These pins cannot also serve as Extender
047896             0002*   ; UART signals: PC3 low (CTS ready) looks like joystick Down and cancels Up.
047896             0003*   ; The splash alone patches two baked-in NOP pairs to JR when joystick is off.
047896             0004*   ; Patching happens before gameplay, with byte stores only (ADL is 24-bit).
047896             0005*   ; No per-direction option test may disturb A's sprite-frame accumulator.
047896             0006*   ; GPIO ports for reading joystick input
047896             0007*   ; bit tests: 0 means actuated, 1 means not actuated
047896             0008*   portC: 	EQU 	$9E ; reads dpad input
047896             0009*   joy1_u: equ 1
047896             0010*   joy1_d: equ 3
047896             0011*   joy1_l: equ 5
047896             0012*   joy1_r: equ 7
047896             0013*   portD: 	EQU 	$A2 ; reads buttons
047896             0014*   btn1_a: equ 5
047896             0015*   
047896             0016*   ; process player keyboard input, set player bitmap
047896             0017*   ; velocities and draw player bitmap at updated coordinates
047896             0018*   ; Inputs: player_x/y set at desired position
047896             0019*   ; Returns: player bitmap drawn at updated position
047896             0020*   ; Destroys: probably everything except maybe iy
047896             0021*   ; NOTE: in mode 9 we draw the ship as a sprite, not a bitmap
047896             0022*   ; TODO: requires sprite implementation
047896             0023*   player_input:
047896             0024*   ; point to player sprite record
047896 FD 21 E2 A4 0025*       ld iy,player_begin
       04          
04789B FD 22 94 7B 0026*       ld (table_pointer),iy
       04          
0478A0             0027*   ; reset player component velocities to zero as the default
0478A0 21 00 00 00 0028*       ld hl,0
0478A4 FD 2F 07    0029*       ld (iy+sprite_xvel),hl
0478A7 FD 2F 0A    0030*       ld (iy+sprite_yvel),hl
0478AA             0031*   ; make ship the active sprite
0478AA FD 7E 00    0032*       ld a,(iy+sprite_id)
0478AD CD 03 1A 04 0033*       call vdu_sprite_select
0478B1             0034*   ; check for keypresses and branch accordingly
0478B1             0035*       MOSCALL    mos_getkbmap ;ix = pointer to MOS virtual keys table
                       M1 Args: function=mos_getkbmap 
0478B1 3E 1E       0001*M1 			LD	A, function
0478B3 5B CF       0002*M1 			RST.LIL	08h
0478B5             0036*   ; do player directional input
0478B5 16 FF       0037*       ld d,0ffh ; all active-low joystick directions released if polling is skipped
0478B7             0038*   player_joystick_direction_gate:
0478B7 00          0039*       nop
0478B8 00          0040*       nop
0478B9 AF          0041*       xor a ; clear flags
0478BA DB 9E       0042*       in a,(portC) ; read dpad input
0478BC 57          0043*       ld d,a ; save dpad input
0478BD             0044*   player_keyboard_directions:
0478BD 3E 01       0045*       ld a,1 ; set ship's default animation to center
0478BF             0046*   ; 26 Left: move player left
0478BF DD CB 03 4E 0047*       bit 1,(ix+3)
0478C3 C2 D1 78 04 0048*       jp nz,@F
0478C7             0049*   ; test dpad left
0478C7 CB 6A       0050*       bit joy1_l,d
0478C9 CA D1 78 04 0051*       jp z,@F
0478CD C3 DD 78 04 0052*       jp @right
0478D1             0053*   @@:
0478D1 FD 27 07    0054*       ld hl,(iy+sprite_xvel)
0478D4 01 00 FD FF 0055*       ld bc,-player_speed
0478D8 09          0056*       add hl,bc
0478D9 FD 2F 07    0057*       ld (iy+sprite_xvel),hl
0478DC 3D          0058*       dec a ; set ship's animation to left
0478DD             0059*   @right:
0478DD             0060*   ; 122 Right: move player right
0478DD DD CB 0F 4E 0061*       bit 1,(ix+15)
0478E1 C2 EF 78 04 0062*       jp nz,@F
0478E5             0063*   ; test dpad right
0478E5 CB 7A       0064*       bit joy1_r,d
0478E7 CA EF 78 04 0065*       jp z,@F
0478EB C3 FB 78 04 0066*       jp @up
0478EF             0067*   @@:
0478EF FD 27 07    0068*       ld hl,(iy+sprite_xvel)
0478F2 01 00 03 00 0069*       ld bc,player_speed
0478F6 09          0070*       add hl,bc
0478F7 FD 2F 07    0071*       ld (iy+sprite_xvel),hl
0478FA 3C          0072*       inc a ; set ship's animation to right
0478FB             0073*   @up:
0478FB             0074*   ; 58 Up: move player up
0478FB DD CB 07 4E 0075*       bit 1,(ix+7)
0478FF C2 0D 79 04 0076*       jp nz,@F
047903             0077*   ; test dpad up
047903 CB 4A       0078*       bit joy1_u,d
047905 CA 0D 79 04 0079*       jp z,@F
047909 C3 18 79 04 0080*       jp @dn
04790D             0081*   @@:
04790D FD 27 0A    0082*       ld hl,(iy+sprite_yvel)
047910 01 00 FD FF 0083*       ld bc,-player_speed
047914 09          0084*       add hl,bc
047915 FD 2F 0A    0085*       ld (iy+sprite_yvel),hl
047918             0086*   @dn:
047918             0087*   ; 42 Down: move player down
047918 DD CB 05 4E 0088*       bit 1,(ix+5)
04791C C2 2A 79 04 0089*       jp nz,@F
047920             0090*   ; test dpad down
047920 CB 5A       0091*       bit joy1_d,d
047922 CA 2A 79 04 0092*       jp z,@F
047926 C3 35 79 04 0093*       jp @frame
04792A             0094*   @@:
04792A FD 27 0A    0095*       ld hl,(iy+sprite_yvel)
04792D 01 00 03 00 0096*       ld bc,player_speed
047931 09          0097*       add hl,bc
047932 FD 2F 0A    0098*       ld (iy+sprite_yvel),hl
047935             0099*   @frame:
047935             0100*   ; a should land here loaded with the correct frame
047935 FD 77 28    0101*       ld (iy+sprite_frame),a ; retain the last commanded pose for damaged flight
047938 CD 66 1A 04 0102*       call vdu_sprite_select_frame
04793C             0103*   ; draw player at updated position
04793C FD 21 E2 A4 0104*       ld iy,player_begin
       04          
047941 FD 22 94 7B 0105*       ld (table_pointer),iy
       04          
047946 CD 2E 7F 04 0106*       call move_sprite
04794A CD E9 71 04 0107*       call player_enforce_play_ceiling
04794E FD 07 01    0108*       ld bc,(iy+sprite_x)
047951 FD 17 04    0109*       ld de,(iy+sprite_y)
047954 CD CF 1A 04 0110*       call vdu_sprite_move_abs168
047958             0111*   
047958             0112*   ; process player laser fire
047958             0113*   ; do player fire button input
047958             0114*   ; read joystick fire button
047958             0115*   player_joystick_fire_gate:
047958 00          0116*       nop
047959 00          0117*       nop
04795A AF          0118*       xor a ; clear flags
04795B DB A2       0119*       in a,(portD) ; read joypad fire button input
04795D CB 6F       0120*       bit btn1_a,a
04795F CA 26 7A 04 0121*       jp z,player_spawn_laser
047963             0122*   player_keyboard_fire:
047963             0123*   ; 99 Space: fire main weapon
047963 DD CB 0C 56 0124*       bit 2,(ix+12)
047967 C2 26 7A 04 0125*       jp nz,player_spawn_laser
04796B             0126*   ; no fire button pressed so go home
04796B C9          0127*       ret
04796C             0128*   ; end player_input
04796C             0129*   
04796C             0130*   ; Called only while the splash owns execution, before any player input.
04796C             0131*   ; Restore every byte so a later game/MOS RUN can reverse the previous choice.
04796C             0132*   ; Destroys: af. Never changes GPIO configuration or UART ownership.
04796C             0133*   player_joystick_enable:
04796C AF          0134*       xor a
04796D 32 B7 78 04 0135*       ld (player_joystick_direction_gate),a
047971 32 B8 78 04 0136*       ld (player_joystick_direction_gate+1),a
047975 32 58 79 04 0137*       ld (player_joystick_fire_gate),a
047979 32 59 79 04 0138*       ld (player_joystick_fire_gate+1),a
04797D C9          0139*       ret
04797E             0140*   
04797E             0141*   player_joystick_disable:
04797E 3E 04       0142*       ld a,player_keyboard_directions-player_joystick_direction_gate-2
047980 32 B8 78 04 0143*       ld (player_joystick_direction_gate+1),a
047984 3E 09       0144*       ld a,player_keyboard_fire-player_joystick_fire_gate-2
047986 32 59 79 04 0145*       ld (player_joystick_fire_gate+1),a
04798A 3E 18       0146*       ld a,018h ; JR rel8; NOP and JR both preserve flags and A
04798C 32 B7 78 04 0147*       ld (player_joystick_direction_gate),a
047990 32 58 79 04 0148*       ld (player_joystick_fire_gate),a
047994 C9          0149*       ret
047995             0150*   
047995             0151*   ; Reject a skip outside JR's forward range if either block later grows.
047995             0152*       .if [player_keyboard_directions-player_joystick_direction_gate-2] >> 7
047995             0153*           dl joystick_direction_skip_out_of_range
047995             0154*       .endif
047995             0155*       .if [player_keyboard_fire-player_joystick_fire_gate-2] >> 7
047995             0156*           dl joystick_fire_skip_out_of_range
047995             0157*       .endif
047995             0068        include "player_laser.inc"
047995             0001*   laser_defaults:
047995 06          0002*       db player_air        ; type
047996 4E 01 00    0003*       dl BUF_LASER_A	    ; base_bufferId
047999 83 7A 04    0004*       dl move_player_laser	; move_program
04799C 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
04799D 05          0006*       db 5	                ; dim_x
04799E 0D          0007*       db 13                   ; dim_y
04799F 01          0008*       db 1                    ; num_orientations
0479A0 02          0009*       db 2                    ; num_animations
0479A1 00          0010*       db 0	                ; animation
0479A2 02          0011*       db laser_animation_timer_reset ; animation_timer
0479A3 00          0012*       db 0	                ; move_timer
0479A4 00          0013*       db 0	                ; move_step
0479A5 00          0014*       db 0	                ; points
0479A6 00          0015*       db 0	                ; shield_damage
0479A7 00          0016*       db 0                    ; frame
0479A8             0017*   
0479A8             0018*   
0479A8             0019*   player_lasers_max: equ 4
0479A8             0020*   laser_speed: equ 4*256 ; 6 pixels per frame 16.8 fixed
0479A8             0021*   tmr_laser: ds 6 ; rate timer for firing laser
       FF FF FF FF 
       FF FF 
0479AE 0C 00 00    0022*   tmr_laser_reset: dl 120/10
0479B1             0023*   laser_animation_timer_reset: equ 2 ; animate every two frames
0479B1             0024*   
0479B1 40          0025*   laser_power: db 64 ; integer
0479B2 00          0026*   laser_power_last: db 0 ; integer
0479B3 40          0027*   laser_power_max: db 64 ; integer
0479B4 04          0028*   laser_power_per_shot: db 4 ; integer
0479B5 00          0029*   charge_laser_timer: db 0
0479B6 06          0030*   charge_laser_timer_max: db 6
0479B7             0031*   bar_laser:
0479B7 00 00 00    0032*       dl 0 ; value
0479BA 08 00 00    0033*       dl 8 ; x0
0479BD 30 01 00    0034*       dl 304 ; y0
0479C0 0F 00 00    0035*       dl 8+7 ; x1
0479C3 6F 01 00    0036*       dl 304+63 ; y1
0479C6 F0 00 00    0037*       dl 304-64 ; y-plot coordinate
