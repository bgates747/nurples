040FA7             0001*   fonts_load:
040FA7 DD 21 FC 23 0002*       ld ix,font_list ; pointer to font list lookup
       04          
040FAC 06 01       0003*       ld b,num_fonts ; loop counter
040FAE             0004*   
040FAE             0005*   @load_loop:
040FAE C5          0006*       push bc ; save loop counter
040FAF             0007*   
040FAF             0008*   ; load font into a buffer
040FAF DD 27 06    0009*       ld hl,(ix+font_list_bufferId)
040FB2 DD 31 09    0010*       ld iy,(ix+font_list_filename)
040FB5 DD E5       0011*       push ix ; mos_fread does not preserve the font-list cursor
040FB7 CD B3 15 04 0012*       call vdu_load_buffer_from_file
040FBB DD E1       0013*       pop ix
040FBD D2 D9 0F 04 0014*       jp nc,@next_font
040FC1             0015*   
040FC1             0016*   ; create font from buffer
040FC1 DD 27 06    0017*       ld hl,(ix+font_list_bufferId)
040FC4 DD 5E 00    0018*       ld e,(ix+font_list_width)
040FC7 DD 56 03    0019*       ld d,(ix+font_list_height)
040FCA 3E 00       0020*       ld a,0 ; flags
040FCC CD 0A 18 04 0021*       call vdu_font_create
040FD0             0022*   
040FD0             0023*   ; select font
040FD0 DD 27 06    0024*       ld hl,(ix+font_list_bufferId)
040FD3 3E 01       0025*       ld a,1 ; flags
040FD5 CD F0 17 04 0026*       call vdu_font_select
040FD9             0027*   
040FD9             0028*   ; ; debug print filename
040FD9             0029*   ;     call printNewLine
040FD9             0030*   ;     ld hl,(ix+font_list_filename)
040FD9             0031*   ;     call printString
040FD9             0032*   
040FD9             0033*   ; advance font_list pointer to next record
040FD9             0034*   @next_font:
040FD9 ED 32 0C    0035*       lea ix,ix+font_list_record_size
040FDC             0036*   
040FDC             0037*   ; restore loop counter
040FDC C1          0038*       pop bc
040FDD 10 CF       0039*       djnz @load_loop
040FDF             0040*   
040FDF             0041*   ; all done
040FDF C9          0042*       ret
