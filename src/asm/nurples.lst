041F14 00          0023*       db 0 ; string terminator
041F15             0047        include "collisions.inc"
041F15             0001*   ; ====== COLLISION DETECTION ======
041F15             0002*   ; --- constants ---
041F15             0003*   ; sprite_collisions flags
041F15             0004*   ; collides_with_player: equ %00000001
041F15             0005*   ; collides_with_laser: equ %00000010
041F15             0006*   sprite_alive: equ 6; set when sprite is alive
041F15             0007*   sprite_just_died: equ 7; set when sprite just died
041F15             0008*   collide_top: equ %00001000
041F15             0009*   collide_bottom: equ %00000100
041F15             0010*   collide_left: equ %00000010
041F15             0011*   collide_right: equ %00000001
041F15             0012*   
041F15 00 00 00    0013*   collision_table_pointer: dl 0x000000 ; pointer to the sprite in the group being checked for collision
041F18             0014*   
041F18             0015*   collision_draw_hitboxes:
041F18             0016*   ; draw hitbox for ix collider
041F18 DD E5       0017*       push ix
041F1A FD E5       0018*       push iy
041F1C AF          0019*       xor a ; color mode 0
041F1D 0E 09       0020*       ld c,c_red
041F1F CD C3 13 04 0021*       call vdu_gcol
041F23 01 00 00 00 0022*       ld bc,0
041F27 DD 4E 02    0023*       ld c,(ix+sprite_x+1)
041F2A DD 46 03    0024*       ld b,(ix+sprite_x+2)
041F2D 11 00 00 00 0025*       ld de,0
041F31 DD 5E 05    0026*       ld e,(ix+sprite_y+1)
041F34 DD 56 06    0027*       ld d,(ix+sprite_y+2)
041F37 21 00 00 00 0028*       ld hl,0 ; clear hlu and h
041F3B DD 6E 1E    0029*       ld l,(ix+sprite_dim_x)
041F3E 09          0030*       add hl,bc ; hl = x1
041F3F E5          0031*       push hl ; save x1
041F40 21 00 00 00 0032*       ld hl,0 ; clear hlu and h
041F44 DD 6E 1F    0033*       ld l,(ix+sprite_dim_y)
041F47 19          0034*       add hl,de ; hl = y1
041F48 DD E1       0035*       pop ix ; ix = x1 (was hl)
041F4A E5          0036*       push hl
041F4B FD E1       0037*       pop iy ; iy = y1
041F4D CD E0 18 04 0038*       call vdu_plot_rf
041F51 FD E1       0039*       pop iy
041F53 DD E1       0040*       pop ix
041F55             0041*   
041F55             0042*   ; draw hitbox for iy collider
041F55 DD E5       0043*       push ix
041F57 FD E5       0044*       push iy
041F59 AF          0045*       xor a ; color mode 0
041F5A 0E 0A       0046*       ld c,c_green
041F5C CD C3 13 04 0047*       call vdu_gcol
041F60 01 00 00 00 0048*       ld bc,0
041F64 FD 4E 02    0049*       ld c,(iy+sprite_x+1)
041F67 FD 46 03    0050*       ld b,(iy+sprite_x+2)
041F6A 11 00 00 00 0051*       ld de,0
041F6E FD 5E 05    0052*       ld e,(iy+sprite_y+1)
041F71 FD 56 06    0053*       ld d,(iy+sprite_y+2)
041F74 21 00 00 00 0054*       ld hl,0 ; clear hlu and h
041F78 FD 6E 1E    0055*       ld l,(iy+sprite_dim_x)
041F7B 09          0056*       add hl,bc ; hl = x1
041F7C E5          0057*       push hl ; save x1
041F7D 21 00 00 00 0058*       ld hl,0 ; clear hlu and h
041F81 FD 6E 1F    0059*       ld l,(iy+sprite_dim_y)
041F84 19          0060*       add hl,de ; hl = y1
041F85 DD E1       0061*       pop ix ; ix = x1 (was hl)
041F87 E5          0062*       push hl
041F88 FD E1       0063*       pop iy ; iy = y1
041F8A CD E0 18 04 0064*       call vdu_plot_rf
041F8E FD E1       0065*       pop iy
041F90 DD E1       0066*       pop ix
041F92 C9          0067*       ret
041F93             0068*   ; end collision_draw_hitboxes
041F93             0069*   
041F93             0070*   ; check_collision:
041F93             0071*   ; Detects collision using bounding box method.
041F93             0072*   ; Inputs:
041F93             0073*   ;   IX -> Sprite/Tile table for Collider A
041F93             0074*   ;   IY -> Sprite/Tile table for Collider B
041F93             0075*   ; Outputs:
041F93             0076*   ;   a = 0, zero flag set, positive sign, carry reset -> Collision detected
041F93             0077*   ;   a = -1, zero flag reset, negative sign, carry set -> No collision detected
041F93             0078*   ; Destroys: HL, DE, AF
041F93             0079*   check_collision:
041F93             0080*   check_collision_box:
041F93             0081*   ; Test 1: (ay + ah) - by < 0
041F93 21 00 00 00 0082*       ld hl,0                     ; Clear hlu
041F97 DD 6E 05    0083*       ld l,(ix+sprite_y+1)        ; Load ay integer part low byte
041F9A DD 66 06    0084*       ld h,(ix+sprite_y+2)        ; Load ay integer part high byte
041F9D 11 00 00 00 0085*       ld de,0                     ; Clear deu and d
041FA1 DD 5E 1F    0086*       ld e,(ix+sprite_dim_y)      ; Load ah
041FA4 19          0087*       add hl,de                   ; (ay + ah)
041FA5 FD 5E 05    0088*       ld e,(iy+sprite_y+1)        ; Load by integer part low byte
041FA8 FD 56 06    0089*       ld d,(iy+sprite_y+2)        ; Load by integer part high byte
041FAB AF          0090*       xor a                       ; Clear carry
041FAC ED 52       0091*       sbc hl,de                   ; (ay + ah) - by
041FAE FA 11 20 04 0092*       jp m,@not_collision         ; No collision if negative
041FB2             0093*   
041FB2             0094*   ; Test 2: ay - (by + bh) < 0
041FB2 21 00 00 00 0095*       ld hl,0                     ; Clear hlu
041FB6 FD 6E 05    0096*       ld l,(iy+sprite_y+1)        ; Load by integer part low byte
041FB9 FD 66 06    0097*       ld h,(iy+sprite_y+2)        ; Load by integer part high byte
041FBC 11 00 00 00 0098*       ld de,0                     ; Clear deu and d
041FC0 FD 5E 1F    0099*       ld e,(iy+sprite_dim_y)      ; Load bh
041FC3 19          0100*       add hl,de                   ; (by + bh)
041FC4 DD 5E 05    0101*       ld e,(ix+sprite_y+1)        ; Load ay integer part low byte
041FC7 DD 56 06    0102*       ld d,(ix+sprite_y+2)        ; Load ay integer part high byte
041FCA AF          0103*       xor a                       ; Clear carry
041FCB ED 52       0104*       sbc hl,de                   ; (by + bh) - ay
041FCD FA 11 20 04 0105*       jp m,@not_collision         ; No collision if negative
041FD1             0106*   
041FD1             0107*   ; Test 3: (ax + aw) - bx < 0
041FD1 21 00 00 00 0108*       ld hl,0                     ; Clear hlu
041FD5 DD 6E 02    0109*       ld l,(ix+sprite_x+1)        ; Load ax integer part low byte
041FD8 DD 66 03    0110*       ld h,(ix+sprite_x+2)        ; Load ax integer part high byte
041FDB 11 00 00 00 0111*       ld de,0                     ; Clear deu and d
041FDF DD 5E 1E    0112*       ld e,(ix+sprite_dim_x)      ; Load aw
041FE2 19          0113*       add hl,de                   ; (ax + aw)
041FE3 FD 5E 02    0114*       ld e,(iy+sprite_x+1)        ; Load bx integer part low byte
041FE6 FD 56 03    0115*       ld d,(iy+sprite_x+2)        ; Load bx integer part high byte
041FE9 AF          0116*       xor a                       ; Clear carry
041FEA ED 52       0117*       sbc hl,de                   ; (ax + aw) - bx
041FEC FA 11 20 04 0118*       jp m,@not_collision         ; No collision if negative
041FF0             0119*   
041FF0             0120*   ; Test 4: ax - (bx + bw) < 0
041FF0 21 00 00 00 0121*       ld hl,0                     ; Clear hlu
041FF4 FD 6E 02    0122*       ld l,(iy+sprite_x+1)        ; Load bx integer part low byte
041FF7 FD 66 03    0123*       ld h,(iy+sprite_x+2)        ; Load bx integer part high byte
041FFA 11 00 00 00 0124*       ld de,0                     ; Clear deu and d
041FFE FD 5E 1E    0125*       ld e,(iy+sprite_dim_x)      ; Load bw
042001 19          0126*       add hl,de                   ; (bx + bw)
042002 DD 5E 02    0127*       ld e,(ix+sprite_x+1)        ; Load ax integer part low byte
042005 DD 56 03    0128*       ld d,(ix+sprite_x+2)        ; Load ax integer part high byte
042008 AF          0129*       xor a                       ; Clear carry
042009 ED 52       0130*       sbc hl,de                   ; (bx + bw) - ax
04200B FA 11 20 04 0131*       jp m,@not_collision         ; No collision if negative
04200F             0132*   
04200F             0133*   ; If all tests pass, collision is detected
04200F             0134*   @is_collision:
04200F AF          0135*       xor a                       ; Clear accumulator and flags (a = 0)
042010 C9          0136*       ret                         ; Return with zero flag set
042011             0137*   
042011             0138*   ; No collision detected
042011             0139*   @not_collision:
042011 3D          0140*       dec a                       ; Set a to -1
042012 C9          0141*       ret                         ; Return with carry set
042013             0142*   ; End check_collision_box
042013             0143*   
042013             0144*   
042013             0145*   ; this routine detects collisions between two collidable objects,
042013             0146*   ; which can include sprites, active tiles, or any screen coordinate
042013             0147*   ; which has been set up with a sprite table structure that includes dim_x
042013             0148*   ; representing the radius of the collidable object
042013             0149*   ; inputs: ix and iy point to the colliding objects' sprite/tile table records
042013             0150*   ; outputs: uh.l = distance - sum of radii
042013             0151*   ;          zero flag set if collision detected
042013             0152*   ;          dx168 and dy168 are also populated with the signed displacements
042013             0153*   ; destroys: everything except indexes
042013             0154*   ; check_collision:
042013             0155*   check_collision_cartesian:
042013             0156*   ; compute dx = x1-x0
042013 DD 27 01    0157*       ld hl,(ix+sprite_x)
042016 FD 17 01    0158*       ld de,(iy+sprite_x)
042019 AF          0159*       xor a ; clear carry
04201A ED 52       0160*       sbc hl,de
04201C 22 84 07 04 0161*       ld (dx168),hl ; dx to scratch
042020             0162*   ; compute dy = y1-y0
042020 DD 27 04    0163*       ld hl,(ix+sprite_y)
042023 FD 17 04    0164*       ld de,(iy+sprite_y)
042026 AF          0165*       xor a ; clear carry
042027 ED 52       0166*       sbc hl,de ; hl = dy
042029 22 8A 07 04 0167*       ld (dy168),hl ; dy to scratch
04202D             0168*   ; compute euclidean distance between centers
04202D CD 90 07 04 0169*       call distance168 ; uh.l = distance
042031             0170*   ; check for overlap by summing half the radii
042031 DD 7E 1E    0171*       ld a,(ix+sprite_dim_x)
042034 CB 3F       0172*       srl a ; divide by 2
042036 FD 5E 1E    0173*       ld e,(iy+sprite_dim_x)
042039 CB 3B       0174*       srl e ; divide by 2
04203B 83          0175*       add a,e
04203C 11 00 00 00 0176*       ld de,0 ; clear deu and e
042040 57          0177*       ld d,a ; ud.e = sum of radii
042041 B7          0178*       or a ; clear carry
042042 ED 52       0179*       sbc hl,de ; uh.l = distance - sum of radii
042044 C8          0180*       ret z ; return collision
042045 F0          0181*       ret p ; return no collision
042046 AF          0182*       xor a ; return collision
042047 C9          0183*       ret
042048             0184*   ; end check_collision_cartesian
042048             0185*   
042048             0186*   ; check collisions of a sprite or tile against a sprite group
042048             0187*   ; inputs: iy = pointer to sprite or tile record being checked
042048             0188*   ;         ix = pointer to sprite group, b = number of records in sprite group
042048             0189*   check_sprite_group_collisions:
042048             0190*   @collision_loop:
042048 DD 22 15 1F 0191*       ld (collision_table_pointer),ix ; update table pointer
       04          
04204D C5          0192*       push bc ; backup loop counter
04204E             0193*   ; check sprite_collisions sprite_alive flag to see if sprite is active
04204E DD CB 1D 76 0194*       bit sprite_alive,(ix+sprite_collisions)
042052 CA 68 20 04 0195*       jp z,@next_record ; not alive so skip to next record
042056             0196*   ; sprite alive so check for collision
042056 CD 93 1F 04 0197*       call check_collision
04205A C2 68 20 04 0198*       jp nz,@next_record ; no collision
04205E             0199*   ; set sprite_just_died flag for each entity and return to caller
04205E C1          0200*       pop bc ; dummy pop to balance stack
04205F DD CB 1D FE 0201*       set sprite_just_died,(ix+sprite_collisions)
042063 FD CB 1D FE 0202*       set sprite_just_died,(iy+sprite_collisions)
042067 C9          0203*       ret
042068             0204*   @next_record:
042068 C1          0205*       pop bc ; get back our loop counter
042069 ED 32 40    0206*       lea ix,ix+table_record_size
04206C 10 DA       0207*       djnz @collision_loop ; loop until we've checked all the records
04206E             0208*   ; return to caller
04206E AF          0209*       xor a
04206F 3C          0210*       inc a ; resets sign flag and a to non-zero indicating no collision
042070 C9          0211*       ret
042071             0212*   ; end check_sprite_group_collisions
042071             0213*   
042071             0214*   check_enemy_collision_laser: ; check for collisions with laser
042071 DD 21 23 A1 0215*       ld ix,player_lasers_begin
       04          
042076 06 04       0216*       ld b,player_lasers_max
042078 CD 48 20 04 0217*       call check_sprite_group_collisions
04207C C9          0218*       ret
04207D             0219*   ; end check_enemy_collision_laser
04207D             0220*   
04207D             0221*   check_enemy_collision_player: ; check for collisions with player
04207D DD 21 23 A2 0222*       ld ix,player_begin
       04          
042082 CD 93 1F 04 0223*       call check_collision
042086 C0          0224*       ret nz ; no collision so nothing to do
042087 DD CB 1D FE 0225*       set sprite_just_died,(ix+sprite_collisions)
04208B FD CB 1D FE 0226*       set sprite_just_died,(iy+sprite_collisions)
04208F AF          0227*       xor a ; signal collision detected
042090 C9          0228*       ret
042091             0229*   ; end check_enemy_collision_player
