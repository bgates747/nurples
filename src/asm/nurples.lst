0492F0 FD 7E 28    0039*       ld a,(iy+tile_frame)
0492F3 3C          0040*       inc a
0492F4 E6 03       0041*       and %00000011 ; modulo 4
0492F6 FD 77 28    0042*       ld (iy+tile_frame),a
0492F9 C3 3E 92 04 0043*       jp draw_active_tile
