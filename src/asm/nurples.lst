0464F4             0001*   ; UART ports for reading joystick input
0464F4             0002*   ; bit tests: 0 means actuated, 1 means not actuated
0464F4             0003*   portC: 	EQU 	$9E ; reads dpad input
0464F4             0004*   joy1_u: equ 1
0464F4             0005*   joy1_d: equ 3
0464F4             0006*   joy1_l: equ 5
0464F4             0007*   joy1_r: equ 7
0464F4             0008*   portD: 	EQU 	$A2 ; reads buttons
0464F4             0009*   btn1_a: equ 5
0464F4             0010*   
0464F4             0011*   ; process player keyboard input, set player bitmap
0464F4             0012*   ; velocities and draw player bitmap at updated coordinates
0464F4             0013*   ; Inputs: player_x/y set at desired position
0464F4             0014*   ; Returns: player bitmap drawn at updated position
0464F4             0015*   ; Destroys: probably everything except maybe iy
0464F4             0016*   ; NOTE: in mode 9 we draw the ship as a sprite, not a bitmap
0464F4             0017*   ; TODO: requires sprite implementation
0464F4             0018*   player_input:
0464F4             0019*   ; point to player sprite record
0464F4 FD 21 D8 8E 0020*       ld iy,player_begin
       04          
0464F9 FD 22 BC 67 0021*       ld (table_pointer),iy
       04          
0464FE             0022*   ; reset player component velocities to zero as the default
0464FE 21 00 00 00 0023*       ld hl,0
046502 FD 2F 07    0024*       ld (iy+sprite_xvel),hl
046505 FD 2F 0A    0025*       ld (iy+sprite_yvel),hl
046508             0026*   ; make ship the active sprite
046508 FD 7E 00    0027*       ld a,(iy+sprite_id)
04650B CD 03 1A 04 0028*       call vdu_sprite_select
04650F             0029*   ; check for keypresses and branch accordingly
04650F             0030*       MOSCALL    mos_getkbmap ;ix = pointer to MOS virtual keys table
                       M1 Args: function=mos_getkbmap 
04650F 3E 1E       0001*M1 			LD	A, function
046511 5B CF       0002*M1 			RST.LIL	08h
046513             0031*   ; do player directional input
046513 AF          0032*       xor a ; clear flags
046514 DB 9E       0033*       in a,(portC) ; read dpad input
046516 57          0034*       ld d,a ; save dpad input
046517 3E 01       0035*       ld a,1 ; set ship's default animation to center
046519             0036*   ; 26 Left: move player left
046519 DD CB 03 4E 0037*       bit 1,(ix+3)
04651D C2 2B 65 04 0038*       jp nz,@F
046521             0039*   ; test dpad left
046521 CB 6A       0040*       bit joy1_l,d
046523 CA 2B 65 04 0041*       jp z,@F
046527 C3 37 65 04 0042*       jp @right
04652B             0043*   @@:
04652B FD 27 07    0044*       ld hl,(iy+sprite_xvel)
04652E 01 00 FD FF 0045*       ld bc,-player_speed
046532 09          0046*       add hl,bc
046533 FD 2F 07    0047*       ld (iy+sprite_xvel),hl
046536 3D          0048*       dec a ; set ship's animation to left
046537             0049*   @right:
046537             0050*   ; 122 Right: move player right
046537 DD CB 0F 4E 0051*       bit 1,(ix+15)
04653B C2 49 65 04 0052*       jp nz,@F
04653F             0053*   ; test dpad right
04653F CB 7A       0054*       bit joy1_r,d
046541 CA 49 65 04 0055*       jp z,@F
046545 C3 55 65 04 0056*       jp @up
046549             0057*   @@:
046549 FD 27 07    0058*       ld hl,(iy+sprite_xvel)
04654C 01 00 03 00 0059*       ld bc,player_speed
046550 09          0060*       add hl,bc
046551 FD 2F 07    0061*       ld (iy+sprite_xvel),hl
046554 3C          0062*       inc a ; set ship's animation to right
046555             0063*   @up:
046555             0064*   ; 58 Up: move player up
046555 DD CB 07 4E 0065*       bit 1,(ix+7)
046559 C2 67 65 04 0066*       jp nz,@F
04655D             0067*   ; test dpad up
04655D CB 4A       0068*       bit joy1_u,d
04655F CA 67 65 04 0069*       jp z,@F
046563 C3 72 65 04 0070*       jp @dn
046567             0071*   @@:
046567 FD 27 0A    0072*       ld hl,(iy+sprite_yvel)
04656A 01 00 FD FF 0073*       ld bc,-player_speed
04656E 09          0074*       add hl,bc
04656F FD 2F 0A    0075*       ld (iy+sprite_yvel),hl
046572             0076*   @dn:
046572             0077*   ; 42 Down: move player down
046572 DD CB 05 4E 0078*       bit 1,(ix+5)
046576 C2 84 65 04 0079*       jp nz,@F
04657A             0080*   ; test dpad down
04657A CB 5A       0081*       bit joy1_d,d
04657C CA 84 65 04 0082*       jp z,@F
046580 C3 8F 65 04 0083*       jp @frame
046584             0084*   @@:
046584 FD 27 0A    0085*       ld hl,(iy+sprite_yvel)
046587 01 00 03 00 0086*       ld bc,player_speed
04658B 09          0087*       add hl,bc
04658C FD 2F 0A    0088*       ld (iy+sprite_yvel),hl
04658F             0089*   @frame:
04658F             0090*   ; a should land here loaded with the correct frame
04658F CD 66 1A 04 0091*       call vdu_sprite_select_frame
046593             0092*   ; draw player at updated position
046593 FD 21 D8 8E 0093*       ld iy,player_begin
       04          
046598 FD 22 BC 67 0094*       ld (table_pointer),iy
       04          
04659D CD BE 6A 04 0095*       call move_sprite
0465A1 FD 07 01    0096*       ld bc,(iy+sprite_x)
0465A4 FD 17 04    0097*       ld de,(iy+sprite_y)
0465A7 CD CF 1A 04 0098*       call vdu_sprite_move_abs168
0465AB             0099*   
0465AB             0100*   ; process player laser fire
0465AB             0101*   ; do player fire button input
0465AB             0102*   ; read joystick fire button
0465AB AF          0103*       xor a ; clear flags
0465AC DB A2       0104*       in a,(portD) ; read joypad fire button input
0465AE CB 6F       0105*       bit btn1_a,a
0465B0 CA 4E 66 04 0106*       jp z,player_spawn_laser
0465B4             0107*   ; 99 Space: fire main weapon
0465B4 DD CB 0C 56 0108*       bit 2,(ix+12)
0465B8 C2 4E 66 04 0109*       jp nz,player_spawn_laser
0465BC             0110*   ; no fire button pressed so go home
0465BC C9          0111*       ret
0465BD             0112*   ; end player_input
