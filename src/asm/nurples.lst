0489F6             0034*   tile_stack_end:
0489F6 F3 86 04    0035*   tile_stack_pointer: dl tile_stack ; pointer to current stack record, initialized to tile_stack
0489F9 03 A4 04    0036*   tile_table_pointer: dl tile_table_base ; pointer to top address of current record, initialized to tile_table_base
0489FC 00 00 00    0037*   num_active_tiles: dl 0 ; how many active tiles
