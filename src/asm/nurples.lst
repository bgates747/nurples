041500             0306*   ; 137   320   240   16    60hz
041500             0307*   ; 21    512   384   16    60hz
041500             0308*   ; 149   512   384   16    60hz
041500             0309*   ; 4     640   240   16    60hz
041500             0310*   ; 132   640   240   16    60hz
