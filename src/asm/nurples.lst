0448B7 00          0023*       db 0 ; string terminator
0448B8             0050        include "collisions.inc"
0448B8             0001*   ; ====== COLLISION DETECTION ======
0448B8             0002*   ; --- constants ---
0448B8             0003*   ; sprite_collisions flags
0448B8             0004*   ; collides_with_player: equ %00000001
0448B8             0005*   ; collides_with_laser: equ %00000010
0448B8             0006*   sprite_alive: equ 6; set when sprite is alive
0448B8             0007*   sprite_just_died: equ 7; set when sprite just died
0448B8             0008*   collide_top: equ %00001000
0448B8             0009*   collide_bottom: equ %00000100
0448B8             0010*   collide_left: equ %00000010
0448B8             0011*   collide_right: equ %00000001
0448B8             0012*   
0448B8 00 00 00    0013*   collision_table_pointer: dl 0x000000 ; pointer to the sprite in the group being checked for collision
0448BB             0014*   
0448BB             0015*   collision_draw_hitboxes:
0448BB             0016*   ; draw hitbox for ix collider
0448BB DD E5       0017*       push ix
0448BD FD E5       0018*       push iy
0448BF AF          0019*       xor a ; color mode 0
0448C0 0E 09       0020*       ld c,c_red
0448C2 CD 0C 14 04 0021*       call vdu_gcol
0448C6 01 00 00 00 0022*       ld bc,0
0448CA DD 4E 02    0023*       ld c,(ix+sprite_x+1)
0448CD DD 46 03    0024*       ld b,(ix+sprite_x+2)
0448D0 11 00 00 00 0025*       ld de,0
0448D4 DD 5E 05    0026*       ld e,(ix+sprite_y+1)
0448D7 DD 56 06    0027*       ld d,(ix+sprite_y+2)
0448DA 21 00 00 00 0028*       ld hl,0 ; clear hlu and h
0448DE DD 6E 1E    0029*       ld l,(ix+sprite_dim_x)
0448E1 09          0030*       add hl,bc ; hl = x1
0448E2 E5          0031*       push hl ; save x1
0448E3 21 00 00 00 0032*       ld hl,0 ; clear hlu and h
0448E7 DD 6E 1F    0033*       ld l,(ix+sprite_dim_y)
0448EA 19          0034*       add hl,de ; hl = y1
0448EB DD E1       0035*       pop ix ; ix = x1 (was hl)
0448ED E5          0036*       push hl
0448EE FD E1       0037*       pop iy ; iy = y1
0448F0 CD 9F 19 04 0038*       call vdu_plot_rf
0448F4 FD E1       0039*       pop iy
0448F6 DD E1       0040*       pop ix
0448F8             0041*   
0448F8             0042*   ; draw hitbox for iy collider
0448F8 DD E5       0043*       push ix
0448FA FD E5       0044*       push iy
0448FC AF          0045*       xor a ; color mode 0
0448FD 0E 0A       0046*       ld c,c_green
0448FF CD 0C 14 04 0047*       call vdu_gcol
044903 01 00 00 00 0048*       ld bc,0
044907 FD 4E 02    0049*       ld c,(iy+sprite_x+1)
04490A FD 46 03    0050*       ld b,(iy+sprite_x+2)
04490D 11 00 00 00 0051*       ld de,0
044911 FD 5E 05    0052*       ld e,(iy+sprite_y+1)
044914 FD 56 06    0053*       ld d,(iy+sprite_y+2)
044917 21 00 00 00 0054*       ld hl,0 ; clear hlu and h
04491B FD 6E 1E    0055*       ld l,(iy+sprite_dim_x)
04491E 09          0056*       add hl,bc ; hl = x1
04491F E5          0057*       push hl ; save x1
044920 21 00 00 00 0058*       ld hl,0 ; clear hlu and h
044924 FD 6E 1F    0059*       ld l,(iy+sprite_dim_y)
044927 19          0060*       add hl,de ; hl = y1
044928 DD E1       0061*       pop ix ; ix = x1 (was hl)
04492A E5          0062*       push hl
04492B FD E1       0063*       pop iy ; iy = y1
04492D CD 9F 19 04 0064*       call vdu_plot_rf
044931 FD E1       0065*       pop iy
044933 DD E1       0066*       pop ix
044935 C9          0067*       ret
044936             0068*   ; end collision_draw_hitboxes
044936             0069*   
044936             0070*   ; check_collision:
044936             0071*   ; Detects collision using bounding box method.
044936             0072*   ; Inputs:
044936             0073*   ;   IX -> Sprite/Tile table for Collider A
044936             0074*   ;   IY -> Sprite/Tile table for Collider B
044936             0075*   ; Outputs:
044936             0076*   ;   a = 0, zero flag set, positive sign, carry reset -> Collision detected
044936             0077*   ;   a = -1, zero flag reset, negative sign, carry set -> No collision detected
044936             0078*   ; Destroys: HL, DE, AF
044936             0079*   check_collision:
044936             0080*   check_collision_box:
044936             0081*   ; Test 1: (ay + ah) - by < 0
044936 21 00 00 00 0082*       ld hl,0                     ; Clear hlu
04493A DD 6E 05    0083*       ld l,(ix+sprite_y+1)        ; Load ay integer part low byte
04493D DD 66 06    0084*       ld h,(ix+sprite_y+2)        ; Load ay integer part high byte
044940 11 00 00 00 0085*       ld de,0                     ; Clear deu and d
044944 DD 5E 1F    0086*       ld e,(ix+sprite_dim_y)      ; Load ah
044947 19          0087*       add hl,de                   ; (ay + ah)
044948 FD 5E 05    0088*       ld e,(iy+sprite_y+1)        ; Load by integer part low byte
04494B FD 56 06    0089*       ld d,(iy+sprite_y+2)        ; Load by integer part high byte
04494E AF          0090*       xor a                       ; Clear carry
04494F ED 52       0091*       sbc hl,de                   ; (ay + ah) - by
044951 FA B4 49 04 0092*       jp m,@not_collision         ; No collision if negative
044955             0093*   
044955             0094*   ; Test 2: ay - (by + bh) < 0
044955 21 00 00 00 0095*       ld hl,0                     ; Clear hlu
044959 FD 6E 05    0096*       ld l,(iy+sprite_y+1)        ; Load by integer part low byte
04495C FD 66 06    0097*       ld h,(iy+sprite_y+2)        ; Load by integer part high byte
04495F 11 00 00 00 0098*       ld de,0                     ; Clear deu and d
044963 FD 5E 1F    0099*       ld e,(iy+sprite_dim_y)      ; Load bh
044966 19          0100*       add hl,de                   ; (by + bh)
044967 DD 5E 05    0101*       ld e,(ix+sprite_y+1)        ; Load ay integer part low byte
04496A DD 56 06    0102*       ld d,(ix+sprite_y+2)        ; Load ay integer part high byte
04496D AF          0103*       xor a                       ; Clear carry
04496E ED 52       0104*       sbc hl,de                   ; (by + bh) - ay
044970 FA B4 49 04 0105*       jp m,@not_collision         ; No collision if negative
044974             0106*   
044974             0107*   ; Test 3: (ax + aw) - bx < 0
044974 21 00 00 00 0108*       ld hl,0                     ; Clear hlu
044978 DD 6E 02    0109*       ld l,(ix+sprite_x+1)        ; Load ax integer part low byte
04497B DD 66 03    0110*       ld h,(ix+sprite_x+2)        ; Load ax integer part high byte
04497E 11 00 00 00 0111*       ld de,0                     ; Clear deu and d
044982 DD 5E 1E    0112*       ld e,(ix+sprite_dim_x)      ; Load aw
044985 19          0113*       add hl,de                   ; (ax + aw)
044986 FD 5E 02    0114*       ld e,(iy+sprite_x+1)        ; Load bx integer part low byte
044989 FD 56 03    0115*       ld d,(iy+sprite_x+2)        ; Load bx integer part high byte
04498C AF          0116*       xor a                       ; Clear carry
04498D ED 52       0117*       sbc hl,de                   ; (ax + aw) - bx
04498F FA B4 49 04 0118*       jp m,@not_collision         ; No collision if negative
044993             0119*   
044993             0120*   ; Test 4: ax - (bx + bw) < 0
044993 21 00 00 00 0121*       ld hl,0                     ; Clear hlu
044997 FD 6E 02    0122*       ld l,(iy+sprite_x+1)        ; Load bx integer part low byte
04499A FD 66 03    0123*       ld h,(iy+sprite_x+2)        ; Load bx integer part high byte
04499D 11 00 00 00 0124*       ld de,0                     ; Clear deu and d
0449A1 FD 5E 1E    0125*       ld e,(iy+sprite_dim_x)      ; Load bw
0449A4 19          0126*       add hl,de                   ; (bx + bw)
0449A5 DD 5E 02    0127*       ld e,(ix+sprite_x+1)        ; Load ax integer part low byte
0449A8 DD 56 03    0128*       ld d,(ix+sprite_x+2)        ; Load ax integer part high byte
0449AB AF          0129*       xor a                       ; Clear carry
0449AC ED 52       0130*       sbc hl,de                   ; (bx + bw) - ax
0449AE FA B4 49 04 0131*       jp m,@not_collision         ; No collision if negative
0449B2             0132*   
0449B2             0133*   ; If all tests pass, collision is detected
0449B2             0134*   @is_collision:
0449B2 AF          0135*       xor a                       ; Clear accumulator and flags (a = 0)
0449B3 C9          0136*       ret                         ; Return with zero flag set
0449B4             0137*   
0449B4             0138*   ; No collision detected
0449B4             0139*   @not_collision:
0449B4 3D          0140*       dec a                       ; Set a to -1
0449B5 C9          0141*       ret                         ; Return with carry set
0449B6             0142*   ; End check_collision_box
0449B6             0143*   
0449B6             0144*   
0449B6             0145*   ; this routine detects collisions between two collidable objects,
0449B6             0146*   ; which can include sprites, active tiles, or any screen coordinate
0449B6             0147*   ; which has been set up with a sprite table structure that includes dim_x
0449B6             0148*   ; representing the radius of the collidable object
0449B6             0149*   ; inputs: ix and iy point to the colliding objects' sprite/tile table records
0449B6             0150*   ; outputs: uh.l = distance - sum of radii
0449B6             0151*   ;          zero flag set if collision detected
0449B6             0152*   ;          dx168 and dy168 are also populated with the signed displacements
0449B6             0153*   ; destroys: everything except indexes
0449B6             0154*   ; check_collision:
0449B6             0155*   check_collision_cartesian:
0449B6             0156*   ; compute dx = x1-x0
0449B6 DD 27 01    0157*       ld hl,(ix+sprite_x)
0449B9 FD 17 01    0158*       ld de,(iy+sprite_x)
0449BC AF          0159*       xor a ; clear carry
0449BD ED 52       0160*       sbc hl,de
0449BF 22 77 07 04 0161*       ld (dx168),hl ; dx to scratch
0449C3             0162*   ; compute dy = y1-y0
0449C3 DD 27 04    0163*       ld hl,(ix+sprite_y)
0449C6 FD 17 04    0164*       ld de,(iy+sprite_y)
0449C9 AF          0165*       xor a ; clear carry
0449CA ED 52       0166*       sbc hl,de ; hl = dy
0449CC 22 7D 07 04 0167*       ld (dy168),hl ; dy to scratch
0449D0             0168*   ; compute euclidean distance between centers
0449D0 CD 83 07 04 0169*       call distance168 ; uh.l = distance
0449D4             0170*   ; check for overlap by summing half the radii
0449D4 DD 7E 1E    0171*       ld a,(ix+sprite_dim_x)
0449D7 CB 3F       0172*       srl a ; divide by 2
0449D9 FD 5E 1E    0173*       ld e,(iy+sprite_dim_x)
0449DC CB 3B       0174*       srl e ; divide by 2
0449DE 83          0175*       add a,e
0449DF 11 00 00 00 0176*       ld de,0 ; clear deu and e
0449E3 57          0177*       ld d,a ; ud.e = sum of radii
0449E4 B7          0178*       or a ; clear carry
0449E5 ED 52       0179*       sbc hl,de ; uh.l = distance - sum of radii
0449E7 C8          0180*       ret z ; return collision
0449E8 F0          0181*       ret p ; return no collision
0449E9 AF          0182*       xor a ; return collision
0449EA C9          0183*       ret
0449EB             0184*   ; end check_collision_cartesian
0449EB             0185*   
0449EB             0186*   ; check collisions of a sprite or tile against a sprite group
0449EB             0187*   ; inputs: iy = pointer to sprite or tile record being checked
0449EB             0188*   ;         ix = pointer to sprite group, b = number of records in sprite group
0449EB             0189*   check_sprite_group_collisions:
0449EB             0190*   @collision_loop:
0449EB DD 22 B8 48 0191*       ld (collision_table_pointer),ix ; update table pointer
       04          
0449F0 C5          0192*       push bc ; backup loop counter
0449F1             0193*   ; check sprite_collisions sprite_alive flag to see if sprite is active
0449F1 DD CB 1D 76 0194*       bit sprite_alive,(ix+sprite_collisions)
0449F5 CA 0B 4A 04 0195*       jp z,@next_record ; not alive so skip to next record
0449F9             0196*   ; sprite alive so check for collision
0449F9 CD 36 49 04 0197*       call check_collision
0449FD C2 0B 4A 04 0198*       jp nz,@next_record ; no collision
044A01             0199*   ; set sprite_just_died flag for each entity and return to caller
044A01 C1          0200*       pop bc ; dummy pop to balance stack
044A02 DD CB 1D FE 0201*       set sprite_just_died,(ix+sprite_collisions)
044A06 FD CB 1D FE 0202*       set sprite_just_died,(iy+sprite_collisions)
044A0A C9          0203*       ret
044A0B             0204*   @next_record:
044A0B C1          0205*       pop bc ; get back our loop counter
044A0C ED 32 40    0206*       lea ix,ix+table_record_size
044A0F 10 DA       0207*       djnz @collision_loop ; loop until we've checked all the records
044A11             0208*   ; return to caller
044A11 AF          0209*       xor a
044A12 3C          0210*       inc a ; resets sign flag and a to non-zero indicating no collision
044A13 C9          0211*       ret
044A14             0212*   ; end check_sprite_group_collisions
044A14             0213*   
044A14             0214*   check_enemy_collision_laser: ; check for collisions with laser
044A14 DD 21 D8 8D 0215*       ld ix,player_lasers_begin
       04          
044A19 06 04       0216*       ld b,player_lasers_max
044A1B CD EB 49 04 0217*       call check_sprite_group_collisions
044A1F C9          0218*       ret
044A20             0219*   ; end check_enemy_collision_laser
044A20             0220*   
044A20             0221*   check_enemy_collision_player: ; check for collisions with player
044A20 DD 21 D8 8E 0222*       ld ix,player_begin
       04          
044A25 CD 36 49 04 0223*       call check_collision
044A29 C0          0224*       ret nz ; no collision so nothing to do
044A2A DD CB 1D FE 0225*       set sprite_just_died,(ix+sprite_collisions)
044A2E FD CB 1D FE 0226*       set sprite_just_died,(iy+sprite_collisions)
044A32 AF          0227*       xor a ; signal collision detected
044A33 C9          0228*       ret
044A34             0229*   ; end check_enemy_collision_player
044A34             0051        include "enemies.inc"
044A34 94 4A 04    0001*   enemies_state: dl enemies_alive
044A37             0002*   enemies_fault_bad_state: equ 0
044A37 00          0003*   enemies_fault_flags: db 0 ; latched fail-closed diagnostics
044A38             0004*   
044A38             0005*   do_enemies:
044A38 2A 34 4A 04 0006*       ld hl,(enemies_state)
044A3C CD 5A 4A 04 0007*       call enemies_state_pointer_valid
044A40 DA 53 4A 04 0008*       jp c,@dispatch
044A44 21 37 4A 04 0009*       ld hl,enemies_fault_flags
044A48 CB C6       0010*       set enemies_fault_bad_state,(hl)
044A4A 21 A1 4A 04 0011*       ld hl,enemies_dead ; actor-local fail-closed state for the next tick
044A4E 22 34 4A 04 0012*       ld (enemies_state),hl
044A52 C9          0013*       ret
044A53             0014*   @dispatch:
044A53             0015*       CALL_HL
                       M1 Args: none
044A53 01 59 4A 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
044A57 C5          0002*M1     push bc ; which constitutes the return address
044A58 E9          0003*M1     jp (hl) ; Jump to the address in HL
044A59 C9          0016*       ret
044A5A             0017*   
044A5A             0018*   ; Exact stabilization whitelist for writable legacy enemy-state pointers.
044A5A             0019*   enemies_state_pointer_valid:
044A5A 11 94 4A 04 0020*       ld de,enemies_alive
044A5E CD 8E 4A 04 0021*       call @matches
044A62 CA 8C 4A 04 0022*       jp z,@valid
044A66 11 A0 4A 04 0023*       ld de,enemies_despawning
044A6A CD 8E 4A 04 0024*       call @matches
044A6E CA 8C 4A 04 0025*       jp z,@valid
044A72 11 A1 4A 04 0026*       ld de,enemies_dead
044A76 CD 8E 4A 04 0027*       call @matches
044A7A CA 8C 4A 04 0028*       jp z,@valid
044A7E 11 A2 4A 04 0029*       ld de,enemies_respawning
044A82 CD 8E 4A 04 0030*       call @matches
044A86 CA 8C 4A 04 0031*       jp z,@valid
044A8A AF          0032*       xor a
044A8B C9          0033*       ret
044A8C             0034*   @valid:
044A8C 37          0035*       scf
044A8D C9          0036*       ret
044A8E             0037*   @matches:
044A8E E5          0038*       push hl
044A8F B7          0039*       or a
044A90 ED 52       0040*       sbc hl,de
044A92 E1          0041*       pop hl
044A93 C9          0042*       ret
044A94             0043*   ; end enemies_state_pointer_valid
