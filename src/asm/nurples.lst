0467B5 CD 09 4D 04 0182*       call init_explosions
0467B9             0183*   
0467B9             0184*   ; activate only after every contiguous sprite has its final frame definitions
0467B9 3E 14       0185*       ld a,table_num_records
0467BB CD CF 19 04 0186*   	call vdu_sprite_activate
0467BF C9          0187*       ret
0467C0             0188*   ; end sprites_init
0467C0             0189*   
0467C0             0190*   ; gets the next available sprite id for a particular sprite group
0467C0             0191*   ; inputs; ix = pointer to sprite group, b = number of records in sprite group
0467C0             0192*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
0467C0             0193*   ;      otherwise, a = 0, carry reset, ix invalid and must not be dereferenced
0467C0             0194*   ; destroys: a,b,c,hl,ix
0467C0             0195*   table_get_next_id:
0467C0             0196*   @loop:
0467C0 DD CB 1D 76 0197*       bit sprite_alive,(ix+sprite_collisions)
0467C4 28 07       0198*       jr z,@found
0467C6 ED 32 40    0199*       lea ix,ix+table_record_size
0467C9 10 F5       0200*       djnz @loop
0467CB             0201*   @notfound:
0467CB AF          0202*       xor a ; a = 0 and reset carry flag indicating that we didn't find a free sprite
0467CC C9          0203*       ret
0467CD             0204*   @found:
0467CD             0205*   ; return sprite id
0467CD DD 7E 00    0206*       ld a,(ix+sprite_id)
0467D0 37          0207*       scf ; sets carry flag indicating we found a free sprite
0467D1 C9          0208*       ret ; done
0467D2             0209*   ; end table_get_next_id
0467D2             0210*   
0467D2             0211*   ; create a new sprite at the prescribed coordinates
0467D2             0212*   ; inputs: hl = pointer to new sprite default settings, ub.c, ud.e = x,y position
0467D2             0213*   ;         ix = pointer to sprite group, a = number of records in sprite group
0467D2             0214*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
0467D2             0215*   ;      otherwise, a = 0, carry reset, ix invalid and must not be dereferenced
0467D2             0216*   spawn_sprite_from_coords:
0467D2 ED 43 1F 68 0217*       ld (@sprite_x),bc ; store x-coordinate
       04          
0467D7 ED 53 22 68 0218*       ld (@sprite_y),de ; store y-coordinate
       04          
0467DC 47          0219*       ld b,a ; number of records in sprite group
0467DD E5          0220*       push hl ; back up pointer to new sprite defaults
0467DE CD C0 67 04 0221*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
0467E2 E1          0222*       pop hl ; restore pointer to new sprite defaults
0467E3 D0          0223*       ret nc ; no carry means no free sprite slots, so we go home
0467E4             0224*   ; copy default settings to new sprite
0467E4 DD E5       0225*       push ix ; back up pointer to new sprite record
0467E6 ED 32 16    0226*       lea ix,ix+sprite_definitions ; bump pointer to copy to
0467E9 DD E5       0227*       push ix ; pointer to default sprite settings
0467EB D1          0228*       pop de ; address to copy to
0467EC 01 13 00 00 0229*       ld bc,sprite_definitions_size ; copy only bytes provided by defaults
0467F0 ED B0       0230*       ldir ; copies defaults to new sprite record
0467F2 DD E1       0231*       pop ix ; restore pointer to new sprite record
0467F4             0232*   ; copy sprite position from existing sprite
0467F4 2A 1F 68 04 0233*       ld hl,(@sprite_x)
0467F8 DD 2F 01    0234*       ld (ix+sprite_x),hl
0467FB 2A 22 68 04 0235*       ld hl,(@sprite_y)
0467FF DD 2F 04    0236*       ld (ix+sprite_y),hl
046802             0237*   ; clear motion state retained by a previously used physical record
046802 21 00 00 00 0238*       ld hl,0
046806 DD 2F 07    0239*       ld (ix+sprite_xvel),hl
046809 DD 2F 0A    0240*       ld (ix+sprite_yvel),hl
04680C DD 2F 0D    0241*       ld (ix+sprite_vel),hl
04680F DD 2F 10    0242*       ld (ix+sprite_heading),hl
046812 DD 2F 13    0243*       ld (ix+sprite_orientation),hl
046815             0244*   ; return to caller
046815 DD CB 16 FE 0245*       set 7,(ix+sprite_type) ; set just spawned flag
046819 DD CB 1D F6 0246*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
04681D 37          0247*       scf ; set carry flag to indicate success
04681E C9          0248*       ret
04681F 00 00 00    0249*   @sprite_x: dl 0 ; new sprite x-coordinate
046822 00 00 00    0250*   @sprite_y: dl 0 ; new sprite y-coordinate
046825             0251*   ; end spawn_sprite_from_coords
046825             0252*   
046825             0253*   ; create a new sprite at the same location as an existing sprite
046825             0254*   ; inputs: hl = pointer to new sprite default settings, table_pointer = existing sprite
046825             0255*   ;         ix = pointer to sprite group, b = number of records in sprite group
046825             0256*   ; returns: if new sprite available, a = sprite id, ix pointing to new sprite vars, carry set
046825             0257*   ;      otherwise, a = 0, carry reset, ix invalid and must not be dereferenced
046825             0258*   spawn_sprite_from_sprite:
046825 E5          0259*       push hl ; back up pointer to new sprite defaults
046826 CD C0 67 04 0260*       call table_get_next_id ; if available: a = new sprite id, ix = pointer to new sprite vars
04682A E1          0261*       pop hl ; restore pointer to new sprite defaults
04682B D0          0262*       ret nc ; no carry means no free sprite slots, so we go home
04682C             0263*   ; copy default settings to new sprite
04682C DD E5       0264*       push ix ; back up pointer to new sprite record
04682E ED 32 16    0265*       lea ix,ix+sprite_definitions ; bump pointer to copy to
046831 DD E5       0266*       push ix ; pointer to default sprite settings
046833 D1          0267*       pop de ; address to copy to
046834 01 13 00 00 0268*       ld bc,sprite_definitions_size ; copy only bytes provided by defaults
046838 ED B0       0269*       ldir ; copies defaults to new sprite record
04683A DD E1       0270*       pop ix ; restore pointer to new sprite record
04683C             0271*   ; copy sprite position from existing sprite
04683C FD 2A DD 66 0272*       ld iy,(table_pointer) ; get existing sprite record
       04          
046841 FD 27 01    0273*       ld hl,(iy+sprite_x)
046844 DD 2F 01    0274*       ld (ix+sprite_x),hl
046847 FD 27 04    0275*       ld hl,(iy+sprite_y)
04684A DD 2F 04    0276*       ld (ix+sprite_y),hl
04684D             0277*   ; clear motion state retained by a previously used physical record
04684D 21 00 00 00 0278*       ld hl,0
046851 DD 2F 07    0279*       ld (ix+sprite_xvel),hl
046854 DD 2F 0A    0280*       ld (ix+sprite_yvel),hl
046857 DD 2F 0D    0281*       ld (ix+sprite_vel),hl
04685A DD 2F 10    0282*       ld (ix+sprite_heading),hl
04685D DD 2F 13    0283*       ld (ix+sprite_orientation),hl
046860             0284*   ; return to caller
046860 DD CB 16 FE 0285*       set 7,(ix+sprite_type) ; set just spawned flag
046864 DD CB 1D F6 0286*       set sprite_alive,(ix+sprite_collisions) ; set sprite alive flag
046868 37          0287*       scf ; set carry flag to indicate success
046869 C9          0288*       ret
04686A             0289*   ; end spawn_sprite_from_sprite
