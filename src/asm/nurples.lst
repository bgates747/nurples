04125A             0263*   ; Timer functions
04125A             0264*   ; -----------------------------------------------
04125A             0265*   ; set a countdown timer
04125A             0266*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
04125A             0267*   ; returns: hl = current time
04125A             0268*   tmr_set:
04125A FD 2F 03    0269*       ld (iy+3),hl            ; set time remaining
04125D             0270*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04125D 3E 08       0001*M1 			LD	A, function
04125F 5B CF       0002*M1 			RST.LIL	08h
041261 DD 27 00    0271*       ld hl,(ix+sysvar_time)  ; get current time
041264 FD 2F 00    0272*       ld (iy+0),hl            ; set start time
041267 C9          0273*       ret
041268             0274*   
041268             0275*   ; gets time remaining on a countdown timer
041268             0276*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
041268             0277*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
041268             0278*   ;          sign flags: pos = time not expired,zero or neg = time expired
041268             0279*   tmr_get:
041268             0280*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041268 3E 08       0001*M1 			LD	A, function
04126A 5B CF       0002*M1 			RST.LIL	08h
04126C DD 17 00    0281*       ld de,(ix+sysvar_time)  ; get current time
04126F FD 27 00    0282*       ld hl,(iy+0)            ; get start time
041272 AF          0283*       xor a                   ; clear carry
041273 ED 52       0284*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
041275 FD 17 03    0285*       ld de,(iy+3)            ; get timer set value
041278 AF          0286*       xor a                   ; clear carry
041279 ED 5A       0287*       adc hl,de               ; hl = time remaining
04127B             0288*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
04127B C9          0289*       ret
04127C             0290*   
04127C             0291*   tmr_test: ds 6 ; example of a buffer to hold timer data
041282             0292*   
       FF FF FF FF 
       FF FF 
041282 00 00 00    0293*   timestamp_now: dl 0
041285 00 00 00    0294*   timestamp_old: dl 0
041288 00 00 00    0295*   timestamp_chg: dl 0
04128B             0296*   
04128B             0297*   ; update the global timestamp from the system clock
04128B             0298*   ; inputs: none
04128B             0299*   ; returns: hl = time elapsed in 1/120ths of a second
04128B             0300*   ;          de = current time
04128B             0301*   ;          ix = pointer to syvars table
04128B             0302*   ; destroys: af,hl,de,ix
04128B             0303*   timestamp_tick:
04128B ED 5B 82 12 0304*       ld de,(timestamp_now)   ; get previous time
       04          
041290 ED 53 85 12 0305*       ld (timestamp_old),de   ; save previous time
       04          
041295             0306*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041295 3E 08       0001*M1 			LD	A, function
041297 5B CF       0002*M1 			RST.LIL	08h
041299 DD 27 00    0307*       ld hl,(ix+sysvar_time)  ; get current time
04129C 22 82 12 04 0308*       ld (timestamp_now),hl   ; save current time
0412A0 AF          0309*       xor a                   ; clear carry
0412A1 ED 52       0310*       sbc hl,de               ; hl = time elapsed
0412A3 22 88 12 04 0311*       ld (timestamp_chg),hl   ; save elapsed time
0412A7 C9          0312*       ret
0412A8             0313*   
0412A8             0314*   ; set a countdown timer
0412A8             0315*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412A8             0316*   ; requires: timestamp_tick to be called at least once before this function
0412A8             0317*   ; returns: hl = current time
0412A8             0318*   ; destroys: hl
0412A8             0319*   timestamp_tmr_set:
0412A8 FD 2F 03    0320*       ld (iy+3),hl            ; set time remaining
0412AB 2A 82 12 04 0321*       ld hl,(timestamp_now)   ; get current timestamp
0412AF FD 2F 00    0322*       ld (iy+0),hl            ; set start time
0412B2 C9          0323*       ret
0412B3             0324*   
0412B3             0325*   ; gets time remaining on a countdown timer following the global timestamp
0412B3             0326*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412B3             0327*   ; requires: timestamp_tick to be called at least once before this function
0412B3             0328*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
0412B3             0329*   ;          sign flags: pos = time not expired,zero or neg = time expired
0412B3             0330*   ; destroys: af,hl,de
0412B3             0331*   timestamp_tmr_get:
0412B3 ED 5B 82 12 0332*       ld de,(timestamp_now)   ; get current timestamp
       04          
0412B8 FD 27 00    0333*       ld hl,(iy+0)            ; get start time
0412BB AF          0334*       xor a                   ; clear carry
0412BC ED 52       0335*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
0412BE FD 17 03    0336*       ld de,(iy+3)            ; get timer set value
0412C1 AF          0337*       xor a                   ; clear carry
0412C2 ED 5A       0338*       adc hl,de               ; hl = time remaining
0412C4             0339*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
0412C4 C9          0340*       ret
0412C5             0341*   
0412C5             0342*   ; set a stopwatch
0412C5             0343*   ; returns: hl = start time
0412C5             0344*   ; destroys: hl,ix
0412C5             0345*   stopwatch_set:
0412C5             0346*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0412C5 3E 08       0001*M1 			LD	A, function
0412C7 5B CF       0002*M1 			RST.LIL	08h
0412C9 DD 27 00    0347*       ld hl,(ix+sysvar_time)  ; get current time
0412CC 22 E1 12 04 0348*       ld (stopwatch_started),hl            ; set start time
0412D0 C9          0349*       ret
0412D1             0350*   
0412D1             0351*   ; gets time elapsed on a stopwatch
0412D1             0352*   ; returns: hl = time elapsed in 1/120ths of a second
0412D1             0353*   ; destroys: af,hl,de,ix
0412D1             0354*   stopwatch_get:
0412D1             0355*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0412D1 3E 08       0001*M1 			LD	A, function
0412D3 5B CF       0002*M1 			RST.LIL	08h
0412D5 DD 27 00    0356*       ld hl,(ix+sysvar_time)  ; get current time
0412D8 ED 5B E1 12 0357*       ld de,(stopwatch_started)            ; get start time
       04          
0412DD AF          0358*       xor a                   ; clear carry
0412DE ED 52       0359*       sbc hl,de               ; hl = time elapsed (will always be zero or positive)
0412E0 C9          0360*       ret
0412E1             0361*   
0412E1             0362*   stopwatch_started: ds 3 ; buffer to hold stopwatch start time
0412E4             0363*   
0412E4             0364*   ; ------------------
0412E4             0365*   ; delay routine
0412E4             0366*   ; Author: Richard Turrnidge
0412E4             0367*   ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.asm
0412E4             0368*   ; routine waits a fixed time,then returns
0412E4             0369*   ; arrive with A =  the delay byte. One bit to be set only.
0412E4             0370*   ; eg. ld A,00000100b
0412E4             0371*   
0412E4             0372*   multiPurposeDelay:
       FF FF FF 
0412E4 F5          0373*       push af
0412E5 C5          0374*       push bc
0412E6 D5          0375*       push de
0412E7 DD E5       0376*       push ix
0412E9 5F          0377*       ld e,a ; timestamp bit mask
0412EA 3E 20       0378*       ld a,32
0412EC 32 35 13 04 0379*       ld (multiPurposeDelay_timeout_outer),a
0412F0 06 00       0380*       ld b,0
0412F2 16 00       0381*       ld d,0
0412F4 3E 08       0382*       ld a,$08
0412F6 5B CF       0383*       RST.LIL	08h                 ; get IX pointer to sysvars
0412F8             0384*   
0412F8             0385*   waitLoop:
0412F8             0386*   
0412F8 DD 7E 00    0387*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
0412FB             0388*   
0412FB             0389*                                   ;   we check if bit set is same as last time we checked.
0412FB             0390*                                   ;   bit 0 - don't use
0412FB             0391*                                   ;   bit 1 - changes 64 times per second
0412FB             0392*                                   ;   bit 2 - changes 32 times per second
0412FB             0393*                                   ;   bit 3 - changes 16 times per second
0412FB             0394*   
0412FB             0395*                                   ;   bit 4 - changes 8 times per second
0412FB             0396*                                   ;   bit 5 - changes 4 times per second
0412FB             0397*                                   ;   bit 6 - changes 2 times per second
0412FB             0398*                                   ;   bit 7 - changes 1 times per second
0412FB A3          0399*       and e
0412FC 4F          0400*       ld c,a
0412FD 3A 34 13 04 0401*       ld a,(oldTimeStamp)
041301 B9          0402*       cp c                        ; is A same as last value?
041302 C2 28 13 04 0403*       jp nz,@changed
041306             0404*   ; Bound a stalled MOS clock to 32 * 65,536 polls.
041306 15          0405*       dec d
041307 C2 F8 12 04 0406*       jp nz,waitLoop
04130B 10 EB       0407*       djnz waitLoop
04130D 3A 35 13 04 0408*       ld a,(multiPurposeDelay_timeout_outer)
041311 3D          0409*       dec a
041312 32 35 13 04 0410*       ld (multiPurposeDelay_timeout_outer),a
041316 C2 F8 12 04 0411*       jp nz,waitLoop
04131A 3A 33 13 04 0412*       ld a,(timer_fault_flags)
04131E F6 01       0413*       or %00000001
041320 32 33 13 04 0414*       ld (timer_fault_flags),a
041324 C3 2D 13 04 0415*       jp @done
041328             0416*   @changed:
041328 79          0417*       ld a,c
041329 32 34 13 04 0418*       ld (oldTimeStamp),a        ; set new value
04132D             0419*   
04132D             0420*   @done:
04132D DD E1       0421*       pop ix
04132F D1          0422*       pop de
041330 C1          0423*       pop bc
041331 F1          0424*       pop af
041332 C9          0425*       ret
041333             0426*   
041333             0427*   timer_fault_delay_timeout: equ 0
041333 00          0428*   timer_fault_flags: db 0
041334 00          0429*   oldTimeStamp: .db 00h
041335 00          0430*   multiPurposeDelay_timeout_outer: db 0
