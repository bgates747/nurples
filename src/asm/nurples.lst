048DDF F7 8D 04    0004*       dl move_crater          ; move_program
048DE2 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
048DE3 10          0006*       db 16                   ; dim_x
048DE4 10          0007*       db 16                   ; dim_y
048DE5 01          0008*       db 1                    ; num_orientations
048DE6 04          0009*       db 4                    ; num_animations
048DE7 05          0010*       db 5	                ; animation
048DE8 08          0011*       db 8                    ; animation_timer
048DE9 00          0012*       db 0                    ; move_timer
048DEA 00          0013*       db 0                    ; move_step
048DEB 00          0014*       db 0                    ; points
048DEC 00          0015*       db 0                    ; shield_damage
048DED 00          0016*       db 0                    ; frame
