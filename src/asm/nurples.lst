0400D8 06 07       0157*       ld B, 7 ; if HL was 0, we want to keep the final zero
0400DA             0158*   @loop:
0400DA 7E          0159*       LD A, (HL)
0400DB FE 30       0160*       CP '0'
0400DD C2 E7 00 04 0161*       JP NZ, @done
