049C00             0001*   ; stream a song from the SD card
049C00             0002*   ; inputs: hl = pointer to filename
049C00             0003*   ; requirements: the file must be 8-bit signed PCM mono
049C00             0004*   ; uses: sound channels 0 and 1, buffers 0x3000 and 0x3001
049C00             0005*   ch0_buffer: equ 0x3000
049C00             0006*   ch1_buffer: equ 0x3001
049C00             0007*   cmd0_buffer: equ 0x3002
049C00             0008*   cmd1_buffer: equ 0x3003
049C00 00 00 00    0009*   current_song: dl 0 ; pointer to current song filename
049C03             0010*   play_song:
049C03 22 00 9C 04 0011*       ld (current_song),hl
049C07             0012*   ; stop the PRT timer
049C07 CD 62 9E 04 0013*       call ps_prt_stop
049C0B             0014*   ; ; tell the user what they've won
049C0B             0015*   ;     ld hl,(current_song)
049C0B             0016*   ;     call printInline
049C0B             0017*   ;     asciz "Playing song: "
049C0B             0018*   ;     ld hl,(current_song)
049C0B             0019*   ;     call printString ; print the song filename
049C0B             0020*   ;     call printNewLine
049C0B             0021*   ; open the file in read mode
049C0B             0022*   ; Open a file
049C0B             0023*   ; HLU: Filename
049C0B             0024*   ;   C: Mode
049C0B             0025*   ; Returns:
049C0B             0026*   ;   A: Filehandle, or 0 if couldn't open
049C0B             0027*       ; ld hl,(current_song)
049C0B 0E 01       0028*   	ld c,fa_read
049C0D             0029*       MOSCALL mos_fopen
                       M1 Args: function=mos_fopen 
049C0D 3E 0A       0001*M1 			LD	A, function
049C0F 5B CF       0002*M1 			RST.LIL	08h
049C11 32 BD 9C 04 0030*       ld (ps_filehandle),a
049C15             0031*   ; read the first block of data
049C15 CD 1F 9C 04 0032*       call ps_read_file
049C19             0033*   ; enable interrupts and start the PRT timer
049C19 FB          0034*       ei
049C1A CD 45 9E 04 0035*       call ps_prt_start
049C1E C9          0036*       ret
049C1F             0037*   ; end play_song
049C1F             0038*   
049C1F             0039*   ; read the next 1-second's worth of sound data from the file
049C1F             0040*   ; and upload it to the sample buffer
049C1F             0041*   ps_read_file:
049C1F             0042*   ; disable interrupts so load is guaranteed to complete
049C1F F3          0043*       di
049C20             0044*   ; ; DEBUG
049C20             0045*   ;     ld a,'.'
049C20             0046*   ;     rst.lil 10h
049C20             0047*   ; ; END DEBUG
049C20             0048*   ; Read a block of data from a file
049C20             0049*   ;   C: Filehandle
049C20             0050*   ; HLU: Pointer to where to write the data to
049C20             0051*   ; DEU: Number of bytes to read
049C20             0052*   ; Returns:
049C20             0053*   ; DEU: Number of bytes read
049C20 3A BD 9C 04 0054*       ld a,(ps_filehandle)
049C24 4F          0055*       ld c,a
049C25 21 03 E4 04 0056*       ld hl,song_data
049C29 11 00 10 00 0057*       ld de,sample_rate
049C2D             0058*       MOSCALL mos_fread
                       M1 Args: function=mos_fread 
049C2D 3E 1A       0001*M1 			LD	A, function
049C2F 5B CF       0002*M1 			RST.LIL	08h
049C31             0059*   ; test de for zero bytes read
049C31 21 00 00 00 0060*       ld hl,0
049C35 AF          0061*       xor a ; clear carry
049C36 ED 52       0062*       sbc hl,de ; hl = 0-chunksize
049C38 C2 4A 9C 04 0063*       jp nz,@load ; we read some data
049C3C             0064*   ; no data read so close file and play a random song
049C3C 3E 80       0065*       ld a,%10000000 ; wait a second to let the final sample play
049C3E CD DA 12 04 0066*       call multiPurposeDelay
049C42 CD 85 9C 04 0067*       call ps_close_file
049C46 C3 92 9C 04 0068*       jp ps_play_random
049C4A             0069*   ; load a vdu buffer from local memory
049C4A             0070*   ; inputs: hl = bufferId ; bc = length ; de = pointer to data
049C4A             0071*   @load:
049C4A 3A B6 9C 04 0072*       ld a,(ps_channel)
049C4E 3C          0073*       inc a
049C4F E6 01       0074*       and 1
049C51 32 B6 9C 04 0075*       ld (ps_channel),a
049C55 21 00 30 00 0076*       ld hl,ch0_buffer
049C59 6F          0077*       ld l,a
049C5A 22 BA 9C 04 0078*       ld (ps_sampleId),hl
049C5E CD FA 16 04 0079*       call vdu_clear_buffer
049C62 2A BA 9C 04 0080*       ld hl,(ps_sampleId)
049C66 D5          0081*       push de ; chunksize
049C67 C1          0082*       pop bc ; how much data to load
049C68 11 03 E4 04 0083*       ld de,song_data ; pointer to data
049C6C CD E5 14 04 0084*       call vdu_load_buffer
049C70 C9          0085*       ret
049C71             0086*   ; end ps_read_file
049C71             0087*   
049C71             0088*   ; this is called by the PRT timer interrupt
049C71             0089*   ps_play_sample:
049C71             0090*   ; call the command buffer to play the sound
049C71 2A BA 9C 04 0091*       ld hl,(ps_sampleId)
049C75 2C          0092*       inc l
049C76 2C          0093*       inc l
049C77 22 B7 9C 04 0094*       ld (ps_cmdId),hl ; TODO: perhaps not needed
049C7B CD DF 16 04 0095*       call vdu_call_buffer
049C7F             0096*   ; load the next chunk of data
049C7F CD 1F 9C 04 0097*       call ps_read_file
049C83             0098*   ; reenable interrupts and return to the user input loop
049C83 FB          0099*       ei
049C84 C9          0100*       ret
049C85             0101*   ; end ps_play_sample
049C85             0102*   
049C85             0103*   ; close the file
049C85             0104*   ps_close_file:
049C85 CD 62 9E 04 0105*       call ps_prt_stop ; stop the PRT timer
049C89 3A BD 9C 04 0106*       ld a,(ps_filehandle)
049C8D             0107*       MOSCALL mos_fclose
                       M1 Args: function=mos_fclose 
049C8D 3E 0B       0001*M1 			LD	A, function
049C8F 5B CF       0002*M1 			RST.LIL	08h
049C91 C9          0108*       ret
049C92             0109*   ; end ps_close_file
049C92             0110*   
049C92             0111*   ; queue a random song to play next
049C92             0112*   ps_play_random:
049C92 CD 18 05 04 0113*       call rand_8 ; a = 0-255
049C96 E6 07       0114*       and 7 ; mod 8
049C98 57          0115*       ld d,a
049C99 1E 03       0116*       ld e,3 ; three bytes per filename index
049C9B ED 5C       0117*       mlt de ; index into the filename table
049C9D 21 FF 9A 04 0118*       ld hl,SFX_filename_index
049CA1 19          0119*       add hl,de ; hl points to the filename index
049CA2 ED 27       0120*       ld hl,(hl) ; hl points to the filename
049CA4 EB          0121*       ex de,hl ; setting up cp hl,de
049CA5 2A 00 9C 04 0122*       ld hl,(current_song) ; don't play the same song twice in a row
049CA9 B7          0123*       or a ; clear carry
049CAA ED 52       0124*       sbc hl,de
049CAC CA 92 9C 04 0125*       jp z,ps_play_random ; same song, try again
049CB0 EB          0126*       ex de,hl ; pointer back to hl
049CB1 CD 03 9C 04 0127*       call play_song ; hit it
049CB5 C9          0128*       ret
049CB6             0129*   ; end ps_play_random
049CB6             0130*   
049CB6             0131*   ; current active channel and bufferId's
049CB6 00          0132*   ps_channel: db 0 ; channel number
