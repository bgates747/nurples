04124C             0261*   
04124C             0262*   ; ===============================================
04124C             0263*   ; Timer functions
04124C             0264*   ; -----------------------------------------------
04124C             0265*   ; set a countdown timer
04124C             0266*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
04124C             0267*   ; returns: hl = current time
04124C             0268*   tmr_set:
04124C FD 2F 03    0269*       ld (iy+3),hl            ; set time remaining
04124F             0270*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04124F 3E 08       0001*M1 			LD	A, function
041251 5B CF       0002*M1 			RST.LIL	08h
041253 DD 27 00    0271*       ld hl,(ix+sysvar_time)  ; get current time
041256 FD 2F 00    0272*       ld (iy+0),hl            ; set start time
041259 C9          0273*       ret
04125A             0274*   
04125A             0275*   ; gets time remaining on a countdown timer
04125A             0276*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
04125A             0277*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
04125A             0278*   ;          sign flags: pos = time not expired,zero or neg = time expired
04125A             0279*   tmr_get:
04125A             0280*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
04125A 3E 08       0001*M1 			LD	A, function
04125C 5B CF       0002*M1 			RST.LIL	08h
04125E DD 17 00    0281*       ld de,(ix+sysvar_time)  ; get current time
041261 FD 27 00    0282*       ld hl,(iy+0)            ; get start time
041264 AF          0283*       xor a                   ; clear carry
041265 ED 52       0284*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
041267 FD 17 03    0285*       ld de,(iy+3)            ; get timer set value
04126A AF          0286*       xor a                   ; clear carry
04126B ED 5A       0287*       adc hl,de               ; hl = time remaining
04126D             0288*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
04126D C9          0289*       ret
04126E             0290*   
04126E             0291*   tmr_test: ds 6 ; example of a buffer to hold timer data
041274             0292*   
       FF FF FF FF 
       FF FF 
041274 00 00 00    0293*   timestamp_now: dl 0
041277 00 00 00    0294*   timestamp_old: dl 0
04127A 00 00 00    0295*   timestamp_chg: dl 0
04127D             0296*   
04127D             0297*   ; update the global timestamp from the system clock
04127D             0298*   ; inputs: none
04127D             0299*   ; returns: hl = time elapsed in 1/120ths of a second
04127D             0300*   ;          de = current time
04127D             0301*   ;          ix = pointer to syvars table
04127D             0302*   ; destroys: af,hl,de,ix
04127D             0303*   timestamp_tick:
04127D ED 5B 74 12 0304*       ld de,(timestamp_now)   ; get previous time
       04          
041282 ED 53 77 12 0305*       ld (timestamp_old),de   ; save previous time
       04          
041287             0306*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
041287 3E 08       0001*M1 			LD	A, function
041289 5B CF       0002*M1 			RST.LIL	08h
04128B DD 27 00    0307*       ld hl,(ix+sysvar_time)  ; get current time
04128E 22 74 12 04 0308*       ld (timestamp_now),hl   ; save current time
041292 AF          0309*       xor a                   ; clear carry
041293 ED 52       0310*       sbc hl,de               ; hl = time elapsed
041295 22 7A 12 04 0311*       ld (timestamp_chg),hl   ; save elapsed time
041299 C9          0312*       ret
04129A             0313*   
04129A             0314*   ; set a countdown timer
04129A             0315*   ; inputs: hl = time to set in 1/120ths of a second; iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
04129A             0316*   ; requires: timestamp_tick to be called at least once before this function
04129A             0317*   ; returns: hl = current time
04129A             0318*   ; destroys: hl
04129A             0319*   timestamp_tmr_set:
04129A FD 2F 03    0320*       ld (iy+3),hl            ; set time remaining
04129D 2A 74 12 04 0321*       ld hl,(timestamp_now)   ; get current timestamp
0412A1 FD 2F 00    0322*       ld (iy+0),hl            ; set start time
0412A4 C9          0323*       ret
0412A5             0324*   
0412A5             0325*   ; gets time remaining on a countdown timer following the global timestamp
0412A5             0326*   ; inputs: iy = pointer to 3-byte buffer holding start time,iy+3 = pointer to 3-byte buffer holding timer set value
0412A5             0327*   ; requires: timestamp_tick to be called at least once before this function
0412A5             0328*   ; returns: hl pos = time remaining in 1/120ths of a second,hl neg = time past expiration
0412A5             0329*   ;          sign flags: pos = time not expired,zero or neg = time expired
0412A5             0330*   ; destroys: af,hl,de
0412A5             0331*   timestamp_tmr_get:
0412A5 ED 5B 74 12 0332*       ld de,(timestamp_now)   ; get current timestamp
       04          
0412AA FD 27 00    0333*       ld hl,(iy+0)            ; get start time
0412AD AF          0334*       xor a                   ; clear carry
0412AE ED 52       0335*       sbc hl,de               ; hl = time elapsed (will always be zero or negative)
0412B0 FD 17 03    0336*       ld de,(iy+3)            ; get timer set value
0412B3 AF          0337*       xor a                   ; clear carry
0412B4 ED 5A       0338*       adc hl,de               ; hl = time remaining
0412B6             0339*                               ; (we do adc because add hl,rr doesn't set sign or zero flags)
0412B6 C9          0340*       ret
0412B7             0341*   
0412B7             0342*   ; set a stopwatch
0412B7             0343*   ; returns: hl = start time
0412B7             0344*   ; destroys: hl,ix
0412B7             0345*   stopwatch_set:
0412B7             0346*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0412B7 3E 08       0001*M1 			LD	A, function
0412B9 5B CF       0002*M1 			RST.LIL	08h
0412BB DD 27 00    0347*       ld hl,(ix+sysvar_time)  ; get current time
0412BE 22 D3 12 04 0348*       ld (stopwatch_started),hl            ; set start time
0412C2 C9          0349*       ret
0412C3             0350*   
0412C3             0351*   ; gets time elapsed on a stopwatch
0412C3             0352*   ; returns: hl = time elapsed in 1/120ths of a second
0412C3             0353*   ; destroys: af,hl,de,ix
0412C3             0354*   stopwatch_get:
0412C3             0355*       MOSCALL mos_sysvars     ; ix points to syvars table
                       M1 Args: function=mos_sysvars 
0412C3 3E 08       0001*M1 			LD	A, function
0412C5 5B CF       0002*M1 			RST.LIL	08h
0412C7 DD 27 00    0356*       ld hl,(ix+sysvar_time)  ; get current time
0412CA ED 5B D3 12 0357*       ld de,(stopwatch_started)            ; get start time
       04          
0412CF AF          0358*       xor a                   ; clear carry
0412D0 ED 52       0359*       sbc hl,de               ; hl = time elapsed (will always be zero or positive)
0412D2 C9          0360*       ret
0412D3             0361*   
0412D3             0362*   stopwatch_started: ds 3 ; buffer to hold stopwatch start time
0412D6             0363*   
0412D6             0364*   ; ------------------
0412D6             0365*   ; delay routine
0412D6             0366*   ; Author: Richard Turrnidge
0412D6             0367*   ; https://github.com/richardturnnidge/lessons/blob/main/slowdown.asm
0412D6             0368*   ; routine waits a fixed time,then returns
0412D6             0369*   ; arrive with A =  the delay byte. One bit to be set only.
0412D6             0370*   ; eg. ld A,00000100b
0412D6             0371*   
0412D6             0372*   multiPurposeDelay:
       FF FF FF 
0412D6 F5          0373*       push af
0412D7 C5          0374*       push bc
0412D8 DD E5       0375*       push ix
0412DA 47          0376*       ld b,a
0412DB 3E 08       0377*       ld a,$08
0412DD 5B CF       0378*       RST.LIL	08h                 ; get IX pointer to sysvars
0412DF             0379*   
0412DF             0380*   waitLoop:
0412DF             0381*   
0412DF DD 7E 00    0382*       ld a,(ix + 0)              ; ix+0h is lowest byte of clock timer
0412E2             0383*   
0412E2             0384*                                   ;   we check if bit set is same as last time we checked.
0412E2             0385*                                   ;   bit 0 - don't use
0412E2             0386*                                   ;   bit 1 - changes 64 times per second
0412E2             0387*                                   ;   bit 2 - changes 32 times per second
0412E2             0388*                                   ;   bit 3 - changes 16 times per second
0412E2             0389*   
0412E2             0390*                                   ;   bit 4 - changes 8 times per second
0412E2             0391*                                   ;   bit 5 - changes 4 times per second
0412E2             0392*                                   ;   bit 6 - changes 2 times per second
0412E2             0393*                                   ;   bit 7 - changes 1 times per second
0412E2 A0          0394*       and b
0412E3 4F          0395*       ld c,a
0412E4 3A F5 12 04 0396*       ld a,(oldTimeStamp)
0412E8 B9          0397*       cp c                        ; is A same as last value?
0412E9 28 F4       0398*       jr z,waitLoop              ; loop here if it is
0412EB 79          0399*       ld a,c
0412EC 32 F5 12 04 0400*       ld (oldTimeStamp),a        ; set new value
0412F0             0401*   
0412F0 DD E1       0402*       pop ix
0412F2 C1          0403*       pop bc
0412F3 F1          0404*       pop af
0412F4 C9          0405*       ret
0412F5             0406*   
0412F5 00          0407*   oldTimeStamp:   .db 00h
