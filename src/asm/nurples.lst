046412             0001*   ; UART ports for reading joystick input
046412             0002*   ; bit tests: 0 means actuated, 1 means not actuated
046412             0003*   portC: 	EQU 	$9E ; reads dpad input
046412             0004*   joy1_u: equ 1
046412             0005*   joy1_d: equ 3
046412             0006*   joy1_l: equ 5
046412             0007*   joy1_r: equ 7
046412             0008*   portD: 	EQU 	$A2 ; reads buttons
046412             0009*   btn1_a: equ 5
046412             0010*   
046412             0011*   ; process player keyboard input, set player bitmap
046412             0012*   ; velocities and draw player bitmap at updated coordinates
046412             0013*   ; Inputs: player_x/y set at desired position
046412             0014*   ; Returns: player bitmap drawn at updated position
046412             0015*   ; Destroys: probably everything except maybe iy
046412             0016*   ; NOTE: in mode 9 we draw the ship as a sprite, not a bitmap
046412             0017*   ; TODO: requires sprite implementation
046412             0018*   player_input:
046412             0019*   ; point to player sprite record
046412 FD 21 F3 87 0020*       ld iy,player_begin
       04          
046417 FD 22 DD 66 0021*       ld (table_pointer),iy
       04          
04641C             0022*   ; reset player component velocities to zero as the default
04641C 21 00 00 00 0023*       ld hl,0
046420 FD 2F 07    0024*       ld (iy+sprite_xvel),hl
046423 FD 2F 0A    0025*       ld (iy+sprite_yvel),hl
046426             0026*   ; make ship the active sprite
046426 FD 7E 00    0027*       ld a,(iy+sprite_id)
046429 CD 9B 19 04 0028*       call vdu_sprite_select
04642D             0029*   ; check for keypresses and branch accordingly
04642D             0030*       MOSCALL    mos_getkbmap ;ix = pointer to MOS virtual keys table
                       M1 Args: function=mos_getkbmap 
04642D 3E 1E       0001*M1 			LD	A, function
04642F 5B CF       0002*M1 			RST.LIL	08h
046431             0031*   ; do player directional input
046431 AF          0032*       xor a ; clear flags
046432 DB 9E       0033*       in a,(portC) ; read dpad input
046434 57          0034*       ld d,a ; save dpad input
046435 3E 01       0035*       ld a,1 ; set ship's default animation to center
046437             0036*   ; 26 Left: move player left
046437 DD CB 03 4E 0037*       bit 1,(ix+3)
04643B C2 49 64 04 0038*       jp nz,@F
04643F             0039*   ; test dpad left
04643F CB 6A       0040*       bit joy1_l,d
046441 CA 49 64 04 0041*       jp z,@F
046445 C3 55 64 04 0042*       jp @right
046449             0043*   @@:
046449 FD 27 07    0044*       ld hl,(iy+sprite_xvel)
04644C 01 00 FD FF 0045*       ld bc,-player_speed
046450 09          0046*       add hl,bc
046451 FD 2F 07    0047*       ld (iy+sprite_xvel),hl
046454 3D          0048*       dec a ; set ship's animation to left
046455             0049*   @right:
046455             0050*   ; 122 Right: move player right
046455 DD CB 0F 4E 0051*       bit 1,(ix+15)
046459 C2 67 64 04 0052*       jp nz,@F
04645D             0053*   ; test dpad right
04645D CB 7A       0054*       bit joy1_r,d
04645F CA 67 64 04 0055*       jp z,@F
046463 C3 73 64 04 0056*       jp @up
046467             0057*   @@:
046467 FD 27 07    0058*       ld hl,(iy+sprite_xvel)
04646A 01 00 03 00 0059*       ld bc,player_speed
04646E 09          0060*       add hl,bc
04646F FD 2F 07    0061*       ld (iy+sprite_xvel),hl
046472 3C          0062*       inc a ; set ship's animation to right
046473             0063*   @up:
046473             0064*   ; 58 Up: move player up
046473 DD CB 07 4E 0065*       bit 1,(ix+7)
046477 C2 85 64 04 0066*       jp nz,@F
04647B             0067*   ; test dpad up
04647B CB 4A       0068*       bit joy1_u,d
04647D CA 85 64 04 0069*       jp z,@F
046481 C3 90 64 04 0070*       jp @dn
046485             0071*   @@:
046485 FD 27 0A    0072*       ld hl,(iy+sprite_yvel)
046488 01 00 FD FF 0073*       ld bc,-player_speed
04648C 09          0074*       add hl,bc
04648D FD 2F 0A    0075*       ld (iy+sprite_yvel),hl
046490             0076*   @dn:
046490             0077*   ; 42 Down: move player down
046490 DD CB 05 4E 0078*       bit 1,(ix+5)
046494 C2 A2 64 04 0079*       jp nz,@F
046498             0080*   ; test dpad down
046498 CB 5A       0081*       bit joy1_d,d
04649A CA A2 64 04 0082*       jp z,@F
04649E C3 AD 64 04 0083*       jp @frame
0464A2             0084*   @@:
0464A2 FD 27 0A    0085*       ld hl,(iy+sprite_yvel)
0464A5 01 00 03 00 0086*       ld bc,player_speed
0464A9 09          0087*       add hl,bc
0464AA FD 2F 0A    0088*       ld (iy+sprite_yvel),hl
0464AD             0089*   @frame:
0464AD             0090*   ; a should land here loaded with the correct frame
0464AD CD FE 19 04 0091*       call vdu_sprite_select_frame
0464B1             0092*   ; draw player at updated position
0464B1 FD 21 F3 87 0093*       ld iy,player_begin
       04          
0464B6 FD 22 DD 66 0094*       ld (table_pointer),iy
       04          
0464BB CD E3 69 04 0095*       call move_sprite
0464BF FD 07 01    0096*       ld bc,(iy+sprite_x)
0464C2 FD 17 04    0097*       ld de,(iy+sprite_y)
0464C5 CD 67 1A 04 0098*       call vdu_sprite_move_abs168
0464C9             0099*   
0464C9             0100*   ; process player laser fire
0464C9             0101*   ; do player fire button input
0464C9             0102*   ; read joystick fire button
0464C9 AF          0103*       xor a ; clear flags
0464CA DB A2       0104*       in a,(portD) ; read joypad fire button input
0464CC CB 6F       0105*       bit btn1_a,a
0464CE CA 6F 65 04 0106*       jp z,player_spawn_laser
0464D2             0107*   ; 99 Space: fire main weapon
0464D2 DD CB 0C 56 0108*       bit 2,(ix+12)
0464D6 C2 6F 65 04 0109*       jp nz,player_spawn_laser
0464DA             0110*   ; no fire button pressed so go home
0464DA C9          0111*       ret
0464DB             0112*   ; end player_input
