049030 CD 0A 20 04 0033*       call check_enemy_collision_laser
049034 CA 71 90 04 0034*       jp z,kill_turret_fireball
049038             0035*   ; target player
049038 CD 45 86 04 0036*       call tile_orientation_to_player
04903C 21 00 04 00 0037*       ld hl,speed_fireball
