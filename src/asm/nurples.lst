04741E DD 2F 07    0521*       ld (ix+sprite_xvel),hl
047421 21 C0 FF FF 0522*       ld hl,player_death_forward_speed
047425 DD 2F 0A    0523*       ld (ix+sprite_yvel),hl
047428             0524*   ; ask each live seeker to enter its initialized orbit state
047428 CD 3F 4C 04 0525*       call seeker_group_enter_orbit
04742C             0526*   ; set player state to dying
04742C AF          0527*       xor a
04742D 32 8D 70 04 0528*       ld (player_dying_phase),a
047431 32 8E 70 04 0529*       ld (player_dying_timer),a
047435 32 8F 70 04 0530*       ld (player_dying_spawns),a
047439 21 48 74 04 0531*       ld hl,player_dying
04743D 22 88 70 04 0532*       ld (player_state),hl
047441 FD E1       0533*       pop iy
047443 DD E1       0534*       pop ix
047445 C1          0535*       pop bc
047446 F1          0536*       pop af
047447 C9          0537*       ret
047448             0538*   ; end kill_player
047448             0539*   
047448             0540*   player_dying:
047448             0541*   ; This actor update is deliberately bounded to one frame. The global playing
047448             0542*   ; loop, not the actor, advances enemies, explosions, tiles, and VBlank.
047448 CD 1A 7A 04 0543*       call player_move_weapons
04744C 3A 8D 70 04 0544*       ld a,(player_dying_phase)
047450 B7          0545*       or a
047451 CA 82 74 04 0546*       jp z,@initial
047455 FE 01       0547*       cp player_dying_phase_delay
047457 CA CD 74 04 0548*       jp z,@delay
04745B FE 02       0549*       cp player_dying_phase_finale
04745D CA E5 74 04 0550*       jp z,@finale
047461             0551*   ; Finish only after the finale explosions have had their full lifetime.
047461 3A 8E 70 04 0552*       ld a,(player_dying_timer)
047465 3C          0553*       inc a
047466 32 8E 70 04 0554*       ld (player_dying_timer),a
04746A FE 28       0555*       cp player_dying_finish_frames
04746C D8          0556*       ret c
04746D 3E 10       0557*       ld a,STATE_NEW_EVENT_PLAYER_DEAD
04746F CD 39 9E 04 0558*       call telemetry_post_events
047473 3E 02       0559*       ld a,TELEMETRY_LIFECYCLE_PLAYER_DEAD
047475 CD 40 9E 04 0560*       call telemetry_post_lifecycle
047479 21 BE 75 04 0561*       ld hl,player_dead
04747D 22 88 70 04 0562*       ld (player_state),hl
047481 C9          0563*       ret
047482             0564*   
047482             0565*   @initial:
047482 CD 28 75 04 0566*       call player_dying_move
047486             0567*   ; Preserve the old cadence: one rising explosion every sixteen outer frames.
047486 3A 8E 70 04 0568*       ld a,(player_dying_timer)
04748A B7          0569*       or a
04748B C2 AE 74 04 0570*       jp nz,@tick_initial
04748F CD CF 4D 04 0571*       call spawn_explosion_player
047493 D2 A5 74 04 0572*       jp nc,@initial_spawned
047497 21 00 00 00 0573*       ld hl,0
04749B DD 2F 07    0574*       ld (ix+sprite_xvel),hl
04749E 21 00 01 00 0575*       ld hl,1*256
0474A2 DD 2F 0A    0576*       ld (ix+sprite_yvel),hl
0474A5             0577*   @initial_spawned:
0474A5 3A 8F 70 04 0578*       ld a,(player_dying_spawns)
0474A9 3C          0579*       inc a
0474AA 32 8F 70 04 0580*       ld (player_dying_spawns),a
0474AE             0581*   @tick_initial:
0474AE 3A 8E 70 04 0582*       ld a,(player_dying_timer)
0474B2 3C          0583*       inc a
0474B3 E6 0F       0584*       and 15
0474B5 32 8E 70 04 0585*       ld (player_dying_timer),a
0474B9 C0          0586*       ret nz
0474BA 3A 8F 70 04 0587*       ld a,(player_dying_spawns)
0474BE FE 10       0588*       cp 16
0474C0 D8          0589*       ret c
0474C1 3E 01       0590*       ld a,player_dying_phase_delay
0474C3 32 8D 70 04 0591*       ld (player_dying_phase),a
0474C7 AF          0592*       xor a
0474C8 32 8F 70 04 0593*       ld (player_dying_spawns),a
0474CC C9          0594*       ret
0474CD             0595*   
0474CD             0596*   @delay:
0474CD 3A 8E 70 04 0597*       ld a,(player_dying_timer)
0474D1 3C          0598*       inc a
0474D2 32 8E 70 04 0599*       ld (player_dying_timer),a
0474D6 FE 10       0600*       cp 16
0474D8 D8          0601*       ret c
0474D9 AF          0602*       xor a
0474DA 32 8E 70 04 0603*       ld (player_dying_timer),a
0474DE 3E 02       0604*       ld a,player_dying_phase_finale
0474E0 32 8D 70 04 0605*       ld (player_dying_phase),a
0474E4 C9          0606*       ret
0474E5             0607*   
0474E5             0608*   @finale:
0474E5             0609*   ; Spread allocations across frames so pool pressure can never turn this actor
0474E5             0610*   ; into a blocking burst. Allocation failure remains a harmless skipped effect.
0474E5 CD CF 4D 04 0611*       call spawn_explosion_player
0474E9 D2 FB 74 04 0612*       jp nc,@finale_spawned
0474ED CD 13 75 04 0613*       call @rand
0474F1 DD 2F 07    0614*       ld (ix+sprite_xvel),hl
0474F4 CD 13 75 04 0615*       call @rand
0474F8 DD 2F 0A    0616*       ld (ix+sprite_yvel),hl
0474FB             0617*   @finale_spawned:
0474FB 3A 8F 70 04 0618*       ld a,(player_dying_spawns)
0474FF 3C          0619*       inc a
047500 32 8F 70 04 0620*       ld (player_dying_spawns),a
047504 FE 08       0621*       cp explosions_max
047506 D8          0622*       ret c
047507 AF          0623*       xor a
047508 32 8E 70 04 0624*       ld (player_dying_timer),a
04750C 3E 03       0625*       ld a,player_dying_phase_finish
04750E 32 8D 70 04 0626*       ld (player_dying_phase),a
047512 C9          0627*       ret
047513             0628*   @rand:
047513 21 00 00 00 0629*       ld hl,0
047517 CD 14 05 04 0630*       call rand_8
04751B 47          0631*       ld b,a
04751C E6 01       0632*       and %00000001
04751E 67          0633*       ld h,a
04751F 68          0634*       ld l,b
047520 CB 78       0635*       bit 7,b
047522 C8          0636*       ret z
047523 CD 7C 04 04 0637*       call neg_hlu
047527 C9          0638*       ret
047528             0639*   ; end player_dying
047528             0640*   
047528             0641*   ; Actor-owned damaged flight. Random changes are latched for a useful duration;
047528             0642*   ; a side collision always commits to the generic mover's inward reflection.
047528             0643*   player_dying_move:
047528 FD 21 E2 A4 0644*       ld iy,player_begin
       04          
04752D FD 22 94 7B 0645*       ld (table_pointer),iy
       04          
047532 CD 2E 7F 04 0646*       call move_sprite
047536 3A 97 7B 04 0647*       ld a,(sprite_screen_edge)
04753A E6 03       0648*       and collide_left+collide_right
04753C C2 60 75 04 0649*       jp nz,@edge_turn
047540 FD 35 2B    0650*       dec (iy+player_death_turn_timer)
047543 C2 65 75 04 0651*       jp nz,@wiggle
047547 FD 27 07    0652*       ld hl,(iy+sprite_xvel)
04754A CD 7C 04 04 0653*       call neg_hlu
04754E FD 2F 07    0654*       ld (iy+sprite_xvel),hl
047551 CD 14 05 04 0655*       call rand_8
047555 E6 1F       0656*       and %00011111
047557 C6 18       0657*       add a,24
047559 FD 77 2B    0658*       ld (iy+player_death_turn_timer),a
04755C C3 65 75 04 0659*       jp @wiggle
047560             0660*   @edge_turn:
047560 3E 20       0661*       ld a,32
047562 FD 77 2B    0662*       ld (iy+player_death_turn_timer),a
047565             0663*   @wiggle:
047565 FD 35 2C    0664*       dec (iy+player_death_wiggle_timer)
047568 C2 AE 75 04 0665*       jp nz,@draw
04756C CD 14 05 04 0666*       call rand_8
047570 E6 03       0667*       and %00000011
047572 C6 04       0668*       add a,4
047574 FD 77 2C    0669*       ld (iy+player_death_wiggle_timer),a
047577 FD 7E 2A    0670*       ld a,(iy+player_death_base_frame)
04757A B7          0671*       or a
04757B CA 9A 75 04 0672*       jp z,@base_left
04757F FE 02       0673*       cp 2
047581 CA A4 75 04 0674*       jp z,@base_right
047585             0675*   ; A centred command wiggles to either bank without losing the saved base pose.
047585 CD 14 05 04 0676*       call rand_8
047589 E6 01       0677*       and %00000001
04758B CA 95 75 04 0678*       jp z,@frame_left
04758F 3E 02       0679*       ld a,2
047591 C3 AB 75 04 0680*       jp @store_frame
047595             0681*   @frame_left:
047595 AF          0682*       xor a
047596 C3 AB 75 04 0683*       jp @store_frame
04759A             0684*   @base_left:
04759A CD 14 05 04 0685*       call rand_8
04759E E6 01       0686*       and %00000001 ; frames 0 or 1
0475A0 C3 AB 75 04 0687*       jp @store_frame
0475A4             0688*   @base_right:
0475A4 CD 14 05 04 0689*       call rand_8
0475A8 E6 01       0690*       and %00000001
0475AA 3C          0691*       inc a ; frames 1 or 2
0475AB             0692*   @store_frame:
0475AB FD 77 28    0693*       ld (iy+sprite_frame),a
0475AE             0694*   @draw:
0475AE CD F0 72 04 0695*       call player_draw_record
0475B2 C9          0696*       ret
0475B3             0697*   ; end player_dying_move
