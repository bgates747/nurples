042253 D1          0183*       pop de ; sprite loop counter
042254 F1          0184*       pop af ; sprite id
042255 3C          0185*       inc a
042256 1D          0186*       dec e
042257 C2 38 22 04 0187*       jp nz,@sprites_loop
04225B C9          0188*       ret
