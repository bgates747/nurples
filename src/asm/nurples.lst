047EC8 05          0006*       db 5	                ; dim_x
047EC9 0D          0007*       db 13                   ; dim_y
047ECA 01          0008*       db 1                    ; num_orientations
047ECB 02          0009*       db 2                    ; num_animations
047ECC 00          0010*       db 0	                ; animation
047ECD 02          0011*       db laser_animation_timer_reset ; animation_timer
047ECE 00          0012*       db 0	                ; move_timer
