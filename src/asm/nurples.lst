                       M1 Args: function=mos_sysvars 
04144B 3E 08       0001*M1 			LD	A, function
04144D 5B CF       0002*M1 			RST.LIL	08h
04144F DD 5E 00    0158*       ld e,(ix+sysvar_time+0)
041452 01 00 00 00 0159*       ld bc,0 ; 65,536 polls before failing open
041456             0160*   @wait:
041456 DD 7E 00    0161*       ld a,(ix+sysvar_time+0)
041459 BB          0162*       cp e
04145A C2 6F 14 04 0163*       jp nz,@done
