048F34             0001*   lightning_defaults:
048F34 0A          0002*       db tile_lightning       ; type
048F35 50 01 00    0003*       dl BUF_LIGHTNING_H_0    ; base_bufferId
048F38 51 8F 04    0004*       dl move_lightning       ; move_program
048F3B 40          0005*       db %01000000            ; collisions bit 6 signals sprite alive
048F3C 10          0006*       db 16                   ; dim_x
048F3D 10          0007*       db 16                   ; dim_y
048F3E 01          0008*       db 1                    ; num_orientations
048F3F 02          0009*       db 2                    ; num_animations
048F40 00          0010*       db 0                    ; animation
048F41 08          0011*       db 8                    ; animation_timer
048F42 00          0012*       db 0                    ; move_timer
048F43 00          0013*       db 0                    ; move_step
048F44 00          0014*       db 0                    ; points
048F45 FF          0015*       db -1                    ; shield_damage
048F46 00          0016*       db 0                    ; frame
