047CDD             0169*   ; update a vertical bar display
047CDD             0170*   ; inputs: ix points to bar structure
047CDD             0171*   ;         bar_val set by caller
047CDD             0172*   ; prerequisite: bar_init called before first use
047CDD             0173*   bar_update_v:
047CDD             0174*   ; set gfx viewport
047CDD DD E5       0175*       push ix ; preserve pointer
047CDF DD 07 03    0176*       ld bc,(ix+bar_x0)
047CE2 DD 17 06    0177*       ld de,(ix+bar_y0)
047CE5 DD 31 0C    0178*       ld iy,(ix+bar_y1)
047CE8 DD 37 09    0179*       ld ix,(ix+bar_x1)
047CEB CD E7 13 04 0180*       call vdu_set_gfx_viewport
047CEF DD E1       0181*       pop ix ; restore pointer
047CF1             0182*   ; select the color based on the value thresholds
047CF1 DD 17 00    0183*       ld de,(ix+bar_val)
047CF4 21 EF FF FF 0184*       ld hl,-bar_red
047CF8 19          0185*       add hl,de
047CF9 D2 16 7D 04 0186*       jp nc,@red
047CFD 21 DF FF FF 0187*       ld hl,-bar_yellow
047D01 19          0188*       add hl,de
047D02 D2 0E 7D 04 0189*       jp nc,@yellow
047D06 21 05 00 00 0190*       ld hl,BUF_BAR_V_2 ; green
047D0A C3 1A 7D 04 0191*       jp @select
047D0E             0192*   @yellow:
047D0E 21 04 00 00 0193*       ld hl,BUF_BAR_V_1 ; yellow
047D12 C3 1A 7D 04 0194*       jp @select
047D16             0195*   @red:
047D16 21 03 00 00 0196*       ld hl,BUF_BAR_V_0 ; red
047D1A             0197*   @select:
047D1A CD 3C 14 04 0198*       call vdu_buff_select
047D1E             0199*   ; get x-plot position
047D1E DD 07 03    0200*       ld bc,(ix+bar_x0)
047D21             0201*   ; compute y-plot position
047D21 DD 17 00    0202*       ld de,(ix+bar_val)
047D24 21 40 00 00 0203*       ld hl,64
047D28 AF          0204*       xor a ; clear carry
047D29 ED 52       0205*       sbc hl,de
047D2B DD 17 0F    0206*       ld de,(ix+bar_y)
047D2E 19          0207*       add hl,de
047D2F 7D          0208*       ld a,l
047D30 E6 FC       0209*       and %11111100 ; round to nearest 4 pixels
047D32 6F          0210*       ld l,a
047D33 EB          0211*       ex de,hl
047D34 CD 3C 18 04 0212*       call vdu_plot_bmp
