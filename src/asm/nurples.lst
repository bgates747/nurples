0468E9             0159*   @waitLoop:
0468E9 C5          0160*       push bc
0468EA 78          0161*       ld a,b
0468EB 3D          0162*       dec a
0468EC CD 79 90 04 0163*       call printHexA
0468F0 0E 26       0164*       ld c,38 ; x
0468F2 06 11       0165*       ld b,17 ; y
0468F4 CD 33 13 04 0166*       call vdu_move_cursor
0468F8 3E 80       0167*       ld a,%10000000 ; bit 7 changes once per second
0468FA CD DC 12 04 0168*       call multiPurposeDelay
0468FE C1          0169*       pop bc
0468FF 10 E8       0170*       djnz @waitLoop
046901 C9          0171*       ret
046902             0172*   ; end start_level_countdown
