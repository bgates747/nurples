041019 21 2C 00 00 0040*       ld hl,BUF_SPLASH_BG
04101D CD 93 14 04 0041*       call vdu_buff_select
041021 01 00 00 00 0042*       ld bc,0
041025 11 00 00 00 0043*       ld de,0
041029 CD A3 18 04 0044*       call vdu_plot_bmp
04102D             0045*   
04102D             0046*   ; ; draw the most recently loaded image
04102D             0047*   ; 	ld hl,(cur_buffer_id)
04102D             0048*   ; 	call vdu_buff_select
04102D             0049*   ; 	ld bc,0
04102D             0050*   ; 	ld de,0
04102D             0051*   ; 	call vdu_plot_bmp
04102D             0052*   
