04633C             0201*   ; compute y-plot position
04633C DD 17 00    0202*       ld de,(ix+bar_val)
04633F 21 40 00 00 0203*       ld hl,64
046343 AF          0204*       xor a ; clear carry
046344 ED 52       0205*       sbc hl,de
046346 DD 17 0F    0206*       ld de,(ix+bar_y)
046349 19          0207*       add hl,de
04634A 7D          0208*       ld a,l
04634B E6 FC       0209*       and %11111100 ; round to nearest 4 pixels
04634D 6F          0210*       ld l,a
04634E EB          0211*       ex de,hl
