049B4C             0081    
049B4C             0082    ; --- MAIN PROGRAM FILE ---
049B4C             0083    main:
049B4C             0084    ; start a new game
049B4C 21 71 84 04 0085        ld hl,game_init
049B50 22 7F 83 04 0086        ld (game_state),hl
049B54             0087    main_loop:
049B54             0088    ; update the global timestamp
049B54 CD 83 12 04 0089        call timestamp_tick
049B58             0090    ; do gamestate logic
049B58 CD 82 83 04 0091        call do_game
049B5C             0092    ; wait for the next vblank mitigate flicker and for loop timing
049B5C CD BB 13 04 0093        call vdu_vblank
049B60             0094    ; poll keyboard for escape keypress
049B60 3E 08       0095        ld a, $08 ; code to send to MOS
049B62 5B CF       0096        rst.lil $08 ; get IX pointer to System Variables
049B64 DD 7E 05    0097        ld a, (ix + $05) ; get ASCII code of key pressed
049B67 FE 1B       0098        cp 27 ; check if 27 (ascii code for ESC)
049B69 CA 71 9B 04 0099        jp z, main_end ; if pressed, jump to exit
049B6D             0100    ; escape not pressed so loop
049B6D C3 54 9B 04 0101        jp main_loop
049B71             0102    
049B71             0103    main_end:
049B71             0104    ; restore original screen mode
049B71 3A 70 84 04 0105        ld a,(original_screen_mode)
049B75 CD 10 14 04 0106        call vdu_set_screen_mode
049B79             0107    ; print thanks for playing message
049B79 CD 5C 00 04 0108        call printInline
049B7D 54 68 61 6E 0109        asciz "Thank you for playing\r\n"
       6B 20 79 6F 
       75 20 66 6F 
       72 20 70 6C 
       61 79 69 6E 
       67 0D 0A 00 
049B95 21 47 1A 04 0110        ld hl,purple_nurples_ascii
049B99 CD 63 00 04 0111        call printString
049B9D C9          0112        ret
049B9E             0113    ; end main
049B9E             0114    
049B9E             0115    ; needs to be the final include to leave room for the sprite and tile tables
049B9E             0116        include "tables.inc"
049B9E             0001*   ; #### THIS IS THE SPACE ALLOCATED TO THE SPRITE TABLE ####
049B9E             0002*   table_base: equ $
049B9E             0003*   player_weapons_begin: equ table_base
049B9E             0004*   player_lasers_begin: equ player_weapons_begin
049B9E             0005*   player_lasers_end: equ table_record_size*player_lasers_max+player_lasers_begin
049B9E             0006*   player_weapons_end: equ table_record_size*player_lasers_max+player_weapons_begin
049B9E             0007*   player_begin: equ player_weapons_end
049B9E             0008*   player_end: equ table_record_size+player_begin
049B9E             0009*   enemy_sprites_begin: equ player_end
049B9E             0010*   seekers_base: equ enemy_sprites_begin
049B9E             0011*   seeker_min_sprite_id: equ [seekers_base-table_base]/table_record_size
049B9E             0012*   seekers_end: equ table_record_size*seekers_max+seekers_base
049B9E             0013*   fireballs_base: equ seekers_end
049B9E             0014*   fireballs_end: equ table_record_size*fireballs_max+fireballs_base
049B9E             0015*   enemy_sprites_end: equ fireballs_end
049B9E             0016*   explosions_base: equ enemy_sprites_end
049B9E             0017*   explosions_end: equ table_record_size*explosions_max+explosions_base
049B9E             0018*   table_end: equ explosions_end
049B9E             0019*   
049B9E             0020*   table_num_records: equ table_end-table_base/table_record_size
049B9E             0021*   table_num_enemy_records: equ enemy_sprites_end-enemy_sprites_begin/table_record_size
049B9E             0022*   
049B9E             0023*   ; ### THIS IS THE SPACE ALLOCATED TO THE ACTIVE TILES TABLE ###
049B9E             0024*   tile_table_base: equ table_end
049B9E             0025*   tile_table_end: equ 256*tile_table_record_size+tile_table_base
