044009 2B          0855*       dec hl
04400A 52 23       0856*       inc.s hl ; undocumented: preserves HL and clears HLU
04400C EB          0857*       ex de,hl
04400D 2A 67 1B 04 0858*       ld hl,(agnb_metadata+agnb_meta_width)
044011 2B          0859*       dec hl
044012 52 23       0860*       inc.s hl ; undocumented: preserves HL and clears HLU
044014 CD 63 03 04 0861*       call umul24
