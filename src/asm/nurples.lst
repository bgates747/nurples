0413ED 5B DF       0087*   	rst.lil $18     ;; Sending command to VDP
0413EF C9          0088*   	ret
0413F0 17 07       0089*   @cmd:       db 23,7
0413F2 00          0090*   @extent:    db 0x00 ; 0 current text window, 1 entire screen, 2 curr gfx viewport
0413F3 00          0091*   @dir:       db 0x00 ; 0 right, 1 left, 2 down, 3 up
0413F4 00          0092*   @speed:     db 0x00 ; pixels
0413F5 00          0093*   @end:		db 0x00 ; padding
0413F6             0094*   
0413F6             0095*   ; COLOUR MODES
0413F6             0096*   ; Mode	Effect
0413F6             0097*   ; 0	Set on-screen pixel to target colour value
0413F6             0098*   ; 1	OR value with the on-screen pixel
0413F6             0099*   ; 2	AND value with the on-screen pixel
0413F6             0100*   ; 3	XOR value with the on-screen pixel
0413F6             0101*   ; 4	Invert the on-screen pixel
0413F6             0102*   ; 5	No operation
0413F6             0103*   ; 6	AND the inverse of the specified colour with the on-screen pixel
0413F6             0104*   ; 7	OR the inverse of the specified colour with the on-screen pixel
0413F6             0105*   
