046778             0001*   ; tileset indices
046778             0002*   tiles_dg: equ 0
046778             0003*   ; tiles_xevious: equ 1
046778 00 00 00    0004*   tileset_ptr_idx: dl 0
04677B             0005*   tileset_ptrs:
04677B             0006*       ; dl tiles_xevious_levels
04677B 02 69 04    0007*       dl tileset_00_levels
04677E 00 00 00    0008*   tileset_ptrs_end: dl 0 ; list terminator
046781             0009*   
046781             0010*   ; get a pointer to the current tileset
046781             0011*   ; inputs: tileset_ptr_idx
046781             0012*   ; returns: ix = pointer to tileset levels lut
046781             0013*   get_tileset_ptr:
046781 3A 78 67 04 0014*       ld a,(tileset_ptr_idx)
046785 57          0015*       ld d,a ; d = tileset index
046786 1E 03       0016*       ld e,3 ; three bytes per index record
046788 ED 5C       0017*       mlt de ; offset into tileset_ptrs lut
04678A DD 21 7B 67 0018*       ld ix,tileset_ptrs
       04          
04678F DD 19       0019*       add ix,de ; ix = pointer to tileset_ptrs record
046791 C9          0020*       ret
046792             0021*   ; end get_tileset_ptr
046792             0022*   
046792             0023*   ; intialize a tileset
046792             0024*   ; inputs: a = index into tileset_ptrs
046792             0025*   init_tileset:
046792 32 78 67 04 0026*       ld (tileset_ptr_idx),a ; store new tileset index
046796 CD 81 67 04 0027*       call get_tileset_ptr ; ix = pointer to tileset_ptrs record
04679A DD 37 00    0028*       ld ix,(ix) ; ix = pointer to tileset levels lut
04679D DD 7E FF    0029*       ld a,(ix-1) ; number of levels in the tileset
0467A0 32 D0 67 04 0030*       ld (num_levels),a
0467A4 AF          0031*       xor a ; reset current level to zero
0467A5 32 CF 67 04 0032*       ld (cur_level),a
0467A9 C3 09 68 04 0033*       jp init_level
0467AD             0034*   ; end init_tileset
0467AD             0035*   
0467AD             0036*   next_tileset:
0467AD 21 78 67 04 0037*       ld hl,tileset_ptr_idx
0467B1 34          0038*       inc (hl) ; bump to next index
0467B2 CD 81 67 04 0039*       call get_tileset_ptr ; ix = pointer to tileset_ptrs record
0467B6 DD 27 00    0040*       ld hl,(ix) ; ix = pointer to tileset levels lut
0467B9             0041*       sign_hlu ; check for list terminator (0)
                       M1 Args: none
0467B9 19          0001*M1     add hl,de ; 1 cycle
0467BA B7          0002*M1     or a ; clear flags ; 1 cycle
0467BB ED 52       0003*M1     sbc hl,de ; 2 cycles
0467BD             0004*M1     ; 4 cycles total
0467BD C2 CB 67 04 0042*       jp nz,@F ; not end of list
0467C1 3E FF       0043*       ld a,-1 ; will wrap around to zero on the next iteration
0467C3 32 78 67 04 0044*       ld (tileset_ptr_idx),a
0467C7 C3 AD 67 04 0045*       jp next_tileset ; try again
0467CB             0046*   @@:
0467CB C3 92 67 04 0047*       jp init_tileset
0467CF             0048*   ; end next_tileset
0467CF             0049*   
0467CF 00          0050*   cur_level: db 0
0467D0 00          0051*   num_levels: db 0
0467D1             0052*   
0467D1             0053*   ; get a pointer to the current level lookup record
0467D1             0054*   ; inputs: tileset_ptr_idx, cur_level
0467D1             0055*   ; returns: ix = pointer to level definition
0467D1             0056*   get_level_ptr:
0467D1 CD 81 67 04 0057*       call get_tileset_ptr
0467D5 DD 37 00    0058*       ld ix,(ix) ; ix = pointer to tileset levels lut
0467D8 3A CF 67 04 0059*       ld a,(cur_level)
0467DC 57          0060*       ld d,a ; d = level index
0467DD 1E 03       0061*       ld e,3 ; three bytes per level record
0467DF ED 5C       0062*       mlt de ; offset into tileset levels lut
0467E1 DD 19       0063*       add ix,de ; ix = pointer to level record
0467E3 C9          0064*       ret
0467E4             0065*   ; end get_level_ptr
0467E4             0066*   
0467E4             0067*   ; advance to the next level in the current tileset
0467E4             0068*   ; inputs: tileset_ptr_idx, cur_level
0467E4             0069*   next_level:
0467E4             0070*   ; update starting score
0467E4 2A D9 7F 04 0071*       ld hl,(player_score)
0467E8 22 DC 7F 04 0072*       ld (player_starting_score),hl
0467EC             0073*   ; set up pointers to next map definition
0467EC 21 CF 67 04 0074*       ld hl,cur_level
0467F0 34          0075*       inc (hl) ; bump to next level
0467F1 CD D1 67 04 0076*       call get_level_ptr ; ix points to current level lookup record
0467F5 DD 27 00    0077*       ld hl,(ix) ; hl = pointer to next level lookup record
0467F8             0078*       sign_hlu ; check for list terminator (0)
                       M1 Args: none
0467F8 19          0001*M1     add hl,de ; 1 cycle
0467F9 B7          0002*M1     or a ; clear flags ; 1 cycle
0467FA ED 52       0003*M1     sbc hl,de ; 2 cycles
0467FC             0004*M1     ; 4 cycles total
0467FC C2 09 68 04 0079*       jp nz,@F ; not end of list
046800 AF          0080*       xor a ; reset level to zero
046801 32 CF 67 04 0081*       ld (cur_level),a
046805 C3 AD 67 04 0082*       jp next_tileset ; try next tileset
046809             0083*   @@: ; fall through to init_level
046809             0084*   ; end next_level
046809             0085*   
046809             0086*   ; inputs: tileset_ptr_idx, cur_level
046809             0087*   init_level:
046809             0088*   ; ; initialize sprites and active tiles table
046809             0089*   ;     call sprites_init
046809             0090*   ;     call table_init
046809             0091*   ;     call tile_table_init
046809             0092*   ; set pointers
046809 CD D1 67 04 0093*       call get_level_ptr ; ix points to level lookup record
04680D DD 37 00    0094*       ld ix,(ix) ; ix points to level definition
046810             0095*   ; set tiles_cols
046810 DD 7E 00    0096*       ld a,(ix+0)
046813 32 6D 8B 04 0097*       ld (tiles_cols),a
046817             0098*   ; set tiles_row counter
046817 DD 7E 01    0099*       ld a,(ix+1)
04681A 32 6A 8B 04 0100*       ld (tiles_row),a
04681E             0101*   ; set cur_baseBufferId
04681E DD 27 04    0102*       ld hl,(ix+4)
046821 22 6E 8B 04 0103*       ld (cur_baseBufferId),hl
046825             0104*   ; set tiles_row_defs
046825 ED 32 07    0105*       lea ix,ix+7 ; ix points to definition of first tile of first row
046828 DD 22 67 8B 0106*       ld (tiles_row_defs),ix
       04          
04682D             0107*   ; reset tile rows and plot coordinates
04682D 21 FF FF FF 0108*       ld hl,-1
046831 22 67 8C 04 0109*       ld (bg_y_plot),hl
046835 23          0110*       inc hl
046836 22 72 8B 04 0111*       ld (tiles_x_plot),hl
04683A 21 F1 FF FF 0112*       ld hl,-15
04683E 22 76 8B 04 0113*       ld (tiles_y_plot),hl
046842             0114*   ; print level number, score, and countdown to start
046842 CD D9 68 04 0115*       call print_level
046846 CD F4 7F 04 0116*       call print_score
04684A CD 78 68 04 0117*       call start_level_countdown
04684E C9          0118*       ret
04684F             0119*   ; end init_level
04684F             0120*   
04684F             0121*   init_bg:
04684F             0122*   ; draw initial background tiles
04684F 21 00 04 00 0123*       ld hl,BUF_BG_STARS_0
046853 CD 3A 14 04 0124*       call vdu_buff_select
046857 01 00 00 00 0125*       ld bc,0
04685B 11 00 00 00 0126*       ld de,field_top
04685F CD 3A 18 04 0127*       call vdu_plot_bmp
046863 21 02 04 00 0128*       ld hl,BUF_BG_STARS_4
046867 CD 3A 14 04 0129*       call vdu_buff_select
04686B 01 00 00 00 0130*       ld bc,0
04686F 11 00 01 00 0131*       ld de,field_top+256
046873 CD 3A 18 04 0132*       call vdu_plot_bmp
046877 C9          0133*       ret
046878             0134*   ; end init_level
046878             0135*   start_level_countdown:
