0448D0 00          0023*       db 0 ; string terminator
0448D1             0051        include "collisions.inc"
0448D1             0001*   ; ====== COLLISION DETECTION ======
0448D1             0002*   ; --- constants ---
0448D1             0003*   ; sprite_collisions flags
0448D1             0004*   ; collides_with_player: equ %00000001
0448D1             0005*   ; collides_with_laser: equ %00000010
0448D1             0006*   sprite_alive: equ 6; set when sprite is alive
0448D1             0007*   sprite_just_died: equ 7; set when sprite just died
0448D1             0008*   collide_top: equ %00001000
0448D1             0009*   collide_bottom: equ %00000100
0448D1             0010*   collide_left: equ %00000010
0448D1             0011*   collide_right: equ %00000001
0448D1             0012*   
0448D1 00 00 00    0013*   collision_table_pointer: dl 0x000000 ; pointer to the sprite in the group being checked for collision
0448D4             0014*   
0448D4             0015*   collision_draw_hitboxes:
0448D4             0016*   ; draw hitbox for ix collider
0448D4 DD E5       0017*       push ix
0448D6 FD E5       0018*       push iy
0448D8 AF          0019*       xor a ; color mode 0
0448D9 0E 09       0020*       ld c,c_red
0448DB CD 0C 14 04 0021*       call vdu_gcol
0448DF 01 00 00 00 0022*       ld bc,0
0448E3 DD 4E 02    0023*       ld c,(ix+sprite_x+1)
0448E6 DD 46 03    0024*       ld b,(ix+sprite_x+2)
0448E9 11 00 00 00 0025*       ld de,0
0448ED DD 5E 05    0026*       ld e,(ix+sprite_y+1)
0448F0 DD 56 06    0027*       ld d,(ix+sprite_y+2)
0448F3 21 00 00 00 0028*       ld hl,0 ; clear hlu and h
0448F7 DD 6E 1E    0029*       ld l,(ix+sprite_dim_x)
0448FA 09          0030*       add hl,bc ; hl = x1
0448FB E5          0031*       push hl ; save x1
0448FC 21 00 00 00 0032*       ld hl,0 ; clear hlu and h
044900 DD 6E 1F    0033*       ld l,(ix+sprite_dim_y)
044903 19          0034*       add hl,de ; hl = y1
044904 DD E1       0035*       pop ix ; ix = x1 (was hl)
044906 E5          0036*       push hl
044907 FD E1       0037*       pop iy ; iy = y1
044909 CD 9F 19 04 0038*       call vdu_plot_rf
04490D FD E1       0039*       pop iy
04490F DD E1       0040*       pop ix
044911             0041*   
044911             0042*   ; draw hitbox for iy collider
044911 DD E5       0043*       push ix
044913 FD E5       0044*       push iy
044915 AF          0045*       xor a ; color mode 0
044916 0E 0A       0046*       ld c,c_green
044918 CD 0C 14 04 0047*       call vdu_gcol
04491C 01 00 00 00 0048*       ld bc,0
044920 FD 4E 02    0049*       ld c,(iy+sprite_x+1)
044923 FD 46 03    0050*       ld b,(iy+sprite_x+2)
044926 11 00 00 00 0051*       ld de,0
04492A FD 5E 05    0052*       ld e,(iy+sprite_y+1)
04492D FD 56 06    0053*       ld d,(iy+sprite_y+2)
044930 21 00 00 00 0054*       ld hl,0 ; clear hlu and h
044934 FD 6E 1E    0055*       ld l,(iy+sprite_dim_x)
044937 09          0056*       add hl,bc ; hl = x1
044938 E5          0057*       push hl ; save x1
044939 21 00 00 00 0058*       ld hl,0 ; clear hlu and h
04493D FD 6E 1F    0059*       ld l,(iy+sprite_dim_y)
044940 19          0060*       add hl,de ; hl = y1
044941 DD E1       0061*       pop ix ; ix = x1 (was hl)
044943 E5          0062*       push hl
044944 FD E1       0063*       pop iy ; iy = y1
044946 CD 9F 19 04 0064*       call vdu_plot_rf
04494A FD E1       0065*       pop iy
04494C DD E1       0066*       pop ix
04494E C9          0067*       ret
04494F             0068*   ; end collision_draw_hitboxes
04494F             0069*   
04494F             0070*   ; check_collision:
04494F             0071*   ; Detects collision using bounding box method.
04494F             0072*   ; Inputs:
04494F             0073*   ;   IX -> Sprite/Tile table for Collider A
04494F             0074*   ;   IY -> Sprite/Tile table for Collider B
04494F             0075*   ; Outputs:
04494F             0076*   ;   a = 0, zero flag set, positive sign, carry reset -> Collision detected
04494F             0077*   ;   a = -1, zero flag reset, negative sign, carry set -> No collision detected
04494F             0078*   ; Destroys: HL, DE, AF
04494F             0079*   check_collision:
04494F             0080*   check_collision_box:
04494F             0081*   ; Test 1: (ay + ah) - by < 0
04494F 21 00 00 00 0082*       ld hl,0                     ; Clear hlu
044953 DD 6E 05    0083*       ld l,(ix+sprite_y+1)        ; Load ay integer part low byte
044956 DD 66 06    0084*       ld h,(ix+sprite_y+2)        ; Load ay integer part high byte
044959 11 00 00 00 0085*       ld de,0                     ; Clear deu and d
04495D DD 5E 1F    0086*       ld e,(ix+sprite_dim_y)      ; Load ah
044960 19          0087*       add hl,de                   ; (ay + ah)
044961 FD 5E 05    0088*       ld e,(iy+sprite_y+1)        ; Load by integer part low byte
044964 FD 56 06    0089*       ld d,(iy+sprite_y+2)        ; Load by integer part high byte
044967 AF          0090*       xor a                       ; Clear carry
044968 ED 52       0091*       sbc hl,de                   ; (ay + ah) - by
04496A FA CD 49 04 0092*       jp m,@not_collision         ; No collision if negative
04496E             0093*   
04496E             0094*   ; Test 2: ay - (by + bh) < 0
04496E 21 00 00 00 0095*       ld hl,0                     ; Clear hlu
044972 FD 6E 05    0096*       ld l,(iy+sprite_y+1)        ; Load by integer part low byte
044975 FD 66 06    0097*       ld h,(iy+sprite_y+2)        ; Load by integer part high byte
044978 11 00 00 00 0098*       ld de,0                     ; Clear deu and d
04497C FD 5E 1F    0099*       ld e,(iy+sprite_dim_y)      ; Load bh
04497F 19          0100*       add hl,de                   ; (by + bh)
044980 DD 5E 05    0101*       ld e,(ix+sprite_y+1)        ; Load ay integer part low byte
044983 DD 56 06    0102*       ld d,(ix+sprite_y+2)        ; Load ay integer part high byte
044986 AF          0103*       xor a                       ; Clear carry
044987 ED 52       0104*       sbc hl,de                   ; (by + bh) - ay
044989 FA CD 49 04 0105*       jp m,@not_collision         ; No collision if negative
04498D             0106*   
04498D             0107*   ; Test 3: (ax + aw) - bx < 0
04498D 21 00 00 00 0108*       ld hl,0                     ; Clear hlu
044991 DD 6E 02    0109*       ld l,(ix+sprite_x+1)        ; Load ax integer part low byte
044994 DD 66 03    0110*       ld h,(ix+sprite_x+2)        ; Load ax integer part high byte
044997 11 00 00 00 0111*       ld de,0                     ; Clear deu and d
04499B DD 5E 1E    0112*       ld e,(ix+sprite_dim_x)      ; Load aw
04499E 19          0113*       add hl,de                   ; (ax + aw)
04499F FD 5E 02    0114*       ld e,(iy+sprite_x+1)        ; Load bx integer part low byte
0449A2 FD 56 03    0115*       ld d,(iy+sprite_x+2)        ; Load bx integer part high byte
0449A5 AF          0116*       xor a                       ; Clear carry
0449A6 ED 52       0117*       sbc hl,de                   ; (ax + aw) - bx
0449A8 FA CD 49 04 0118*       jp m,@not_collision         ; No collision if negative
0449AC             0119*   
0449AC             0120*   ; Test 4: ax - (bx + bw) < 0
0449AC 21 00 00 00 0121*       ld hl,0                     ; Clear hlu
0449B0 FD 6E 02    0122*       ld l,(iy+sprite_x+1)        ; Load bx integer part low byte
0449B3 FD 66 03    0123*       ld h,(iy+sprite_x+2)        ; Load bx integer part high byte
0449B6 11 00 00 00 0124*       ld de,0                     ; Clear deu and d
0449BA FD 5E 1E    0125*       ld e,(iy+sprite_dim_x)      ; Load bw
0449BD 19          0126*       add hl,de                   ; (bx + bw)
0449BE DD 5E 02    0127*       ld e,(ix+sprite_x+1)        ; Load ax integer part low byte
0449C1 DD 56 03    0128*       ld d,(ix+sprite_x+2)        ; Load ax integer part high byte
0449C4 AF          0129*       xor a                       ; Clear carry
0449C5 ED 52       0130*       sbc hl,de                   ; (bx + bw) - ax
0449C7 FA CD 49 04 0131*       jp m,@not_collision         ; No collision if negative
0449CB             0132*   
0449CB             0133*   ; If all tests pass, collision is detected
0449CB             0134*   @is_collision:
0449CB AF          0135*       xor a                       ; Clear accumulator and flags (a = 0)
0449CC C9          0136*       ret                         ; Return with zero flag set
0449CD             0137*   
0449CD             0138*   ; No collision detected
0449CD             0139*   @not_collision:
0449CD 3D          0140*       dec a                       ; Set a to -1
0449CE C9          0141*       ret                         ; Return with carry set
0449CF             0142*   ; End check_collision_box
0449CF             0143*   
0449CF             0144*   
0449CF             0145*   ; this routine detects collisions between two collidable objects,
0449CF             0146*   ; which can include sprites, active tiles, or any screen coordinate
0449CF             0147*   ; which has been set up with a sprite table structure that includes dim_x
0449CF             0148*   ; representing the radius of the collidable object
0449CF             0149*   ; inputs: ix and iy point to the colliding objects' sprite/tile table records
0449CF             0150*   ; outputs: uh.l = distance - sum of radii
0449CF             0151*   ;          zero flag set if collision detected
0449CF             0152*   ;          dx168 and dy168 are also populated with the signed displacements
0449CF             0153*   ; destroys: everything except indexes
0449CF             0154*   ; check_collision:
0449CF             0155*   check_collision_cartesian:
0449CF             0156*   ; compute dx = x1-x0
0449CF DD 27 01    0157*       ld hl,(ix+sprite_x)
0449D2 FD 17 01    0158*       ld de,(iy+sprite_x)
0449D5 AF          0159*       xor a ; clear carry
0449D6 ED 52       0160*       sbc hl,de
0449D8 22 77 07 04 0161*       ld (dx168),hl ; dx to scratch
0449DC             0162*   ; compute dy = y1-y0
0449DC DD 27 04    0163*       ld hl,(ix+sprite_y)
0449DF FD 17 04    0164*       ld de,(iy+sprite_y)
0449E2 AF          0165*       xor a ; clear carry
0449E3 ED 52       0166*       sbc hl,de ; hl = dy
0449E5 22 7D 07 04 0167*       ld (dy168),hl ; dy to scratch
0449E9             0168*   ; compute euclidean distance between centers
0449E9 CD 83 07 04 0169*       call distance168 ; uh.l = distance
0449ED             0170*   ; check for overlap by summing half the radii
0449ED DD 7E 1E    0171*       ld a,(ix+sprite_dim_x)
0449F0 CB 3F       0172*       srl a ; divide by 2
0449F2 FD 5E 1E    0173*       ld e,(iy+sprite_dim_x)
0449F5 CB 3B       0174*       srl e ; divide by 2
0449F7 83          0175*       add a,e
0449F8 11 00 00 00 0176*       ld de,0 ; clear deu and e
0449FC 57          0177*       ld d,a ; ud.e = sum of radii
0449FD B7          0178*       or a ; clear carry
0449FE ED 52       0179*       sbc hl,de ; uh.l = distance - sum of radii
044A00 C8          0180*       ret z ; return collision
044A01 F0          0181*       ret p ; return no collision
044A02 AF          0182*       xor a ; return collision
044A03 C9          0183*       ret
044A04             0184*   ; end check_collision_cartesian
044A04             0185*   
044A04             0186*   ; check collisions of a sprite or tile against a sprite group
044A04             0187*   ; inputs: iy = pointer to sprite or tile record being checked
044A04             0188*   ;         ix = pointer to sprite group, b = number of records in sprite group
044A04             0189*   check_sprite_group_collisions:
044A04             0190*   @collision_loop:
044A04 DD 22 D1 48 0191*       ld (collision_table_pointer),ix ; update table pointer
       04          
044A09 C5          0192*       push bc ; backup loop counter
044A0A             0193*   ; check sprite_collisions sprite_alive flag to see if sprite is active
044A0A DD CB 1D 76 0194*       bit sprite_alive,(ix+sprite_collisions)
044A0E CA 24 4A 04 0195*       jp z,@next_record ; not alive so skip to next record
044A12             0196*   ; sprite alive so check for collision
044A12 CD 4F 49 04 0197*       call check_collision
044A16 C2 24 4A 04 0198*       jp nz,@next_record ; no collision
044A1A             0199*   ; set sprite_just_died flag for each entity and return to caller
044A1A C1          0200*       pop bc ; dummy pop to balance stack
044A1B DD CB 1D FE 0201*       set sprite_just_died,(ix+sprite_collisions)
044A1F FD CB 1D FE 0202*       set sprite_just_died,(iy+sprite_collisions)
044A23 C9          0203*       ret
044A24             0204*   @next_record:
044A24 C1          0205*       pop bc ; get back our loop counter
044A25 ED 32 40    0206*       lea ix,ix+table_record_size
044A28 10 DA       0207*       djnz @collision_loop ; loop until we've checked all the records
044A2A             0208*   ; return to caller
044A2A AF          0209*       xor a
044A2B 3C          0210*       inc a ; resets sign flag and a to non-zero indicating no collision
044A2C C9          0211*       ret
044A2D             0212*   ; end check_sprite_group_collisions
044A2D             0213*   
044A2D             0214*   check_enemy_collision_laser: ; check for collisions with laser
044A2D DD 21 E2 A3 0215*       ld ix,player_lasers_begin
       04          
044A32 06 04       0216*       ld b,player_lasers_max
044A34 CD 04 4A 04 0217*       call check_sprite_group_collisions
044A38 C9          0218*       ret
044A39             0219*   ; end check_enemy_collision_laser
044A39             0220*   
044A39             0221*   check_enemy_collision_player: ; check for collisions with player
044A39 DD 21 E2 A4 0222*       ld ix,player_begin
       04          
044A3E CD 4F 49 04 0223*       call check_collision
044A42 C0          0224*       ret nz ; no collision so nothing to do
044A43 DD CB 1D FE 0225*       set sprite_just_died,(ix+sprite_collisions)
044A47 FD CB 1D FE 0226*       set sprite_just_died,(iy+sprite_collisions)
044A4B AF          0227*       xor a ; signal collision detected
044A4C C9          0228*       ret
044A4D             0229*   ; end check_enemy_collision_player
044A4D             0052        include "enemies.inc"
044A4D AD 4A 04    0001*   enemies_state: dl enemies_alive
044A50             0002*   enemies_fault_bad_state: equ 0
044A50 00          0003*   enemies_fault_flags: db 0 ; latched fail-closed diagnostics
044A51             0004*   
044A51             0005*   do_enemies:
044A51 2A 4D 4A 04 0006*       ld hl,(enemies_state)
044A55 CD 73 4A 04 0007*       call enemies_state_pointer_valid
044A59 DA 6C 4A 04 0008*       jp c,@dispatch
044A5D 21 50 4A 04 0009*       ld hl,enemies_fault_flags
044A61 CB C6       0010*       set enemies_fault_bad_state,(hl)
044A63 21 BA 4A 04 0011*       ld hl,enemies_dead ; actor-local fail-closed state for the next tick
044A67 22 4D 4A 04 0012*       ld (enemies_state),hl
044A6B C9          0013*       ret
044A6C             0014*   @dispatch:
044A6C             0015*       CALL_HL
                       M1 Args: none
044A6C 01 72 4A 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
044A70 C5          0002*M1     push bc ; which constitutes the return address
044A71 E9          0003*M1     jp (hl) ; Jump to the address in HL
044A72 C9          0016*       ret
044A73             0017*   
044A73             0018*   ; Exact stabilization whitelist for writable legacy enemy-state pointers.
044A73             0019*   enemies_state_pointer_valid:
044A73 11 AD 4A 04 0020*       ld de,enemies_alive
044A77 CD A7 4A 04 0021*       call @matches
044A7B CA A5 4A 04 0022*       jp z,@valid
044A7F 11 B9 4A 04 0023*       ld de,enemies_despawning
044A83 CD A7 4A 04 0024*       call @matches
044A87 CA A5 4A 04 0025*       jp z,@valid
044A8B 11 BA 4A 04 0026*       ld de,enemies_dead
044A8F CD A7 4A 04 0027*       call @matches
044A93 CA A5 4A 04 0028*       jp z,@valid
044A97 11 BB 4A 04 0029*       ld de,enemies_respawning
044A9B CD A7 4A 04 0030*       call @matches
044A9F CA A5 4A 04 0031*       jp z,@valid
044AA3 AF          0032*       xor a
044AA4 C9          0033*       ret
044AA5             0034*   @valid:
044AA5 37          0035*       scf
044AA6 C9          0036*       ret
044AA7             0037*   @matches:
044AA7 E5          0038*       push hl
044AA8 B7          0039*       or a
044AA9 ED 52       0040*       sbc hl,de
044AAB E1          0041*       pop hl
044AAC C9          0042*       ret
044AAD             0043*   ; end enemies_state_pointer_valid
044AAD             0044*   
044AAD             0045*   enemies_alive:
044AAD FD 21 22 A5 0046*       ld iy,enemy_sprites_begin
       04          
044AB2 06 07       0047*       ld b,table_num_enemy_records
044AB4 CD 71 7E 04 0048*       call move_sprite_group
044AB8 C9          0049*       ret
044AB9             0050*   
044AB9             0051*   enemies_despawning:
044AB9 C9          0052*       ret
044ABA             0053*   
044ABA             0054*   enemies_dead:
