04644B             0081*   next_level:
04644B             0082*   ; update starting score
04644B 2A 97 7C 04 0083*       ld hl,(player_score)
04644F 22 9A 7C 04 0084*       ld (player_starting_score),hl
046453             0085*   ; refresh the authoritative inner-table count before advancing
046453 CD D5 63 04 0086*       call get_tileset_ptr
046457 DD 37 00    0087*       ld ix,(ix)
04645A DD 7E FF    0088*       ld a,(ix-1)
04645D 32 21 64 04 0089*       ld (num_levels),a
046461 47          0090*       ld b,a
046462             0091*   ; select the next valid level without indexing the terminator
046462 3A 20 64 04 0092*       ld a,(cur_level)
046466 3C          0093*       inc a ; bump to next level
046467 CA 78 64 04 0094*       jp z,@advance_tileset ; guard a corrupt 255 index wrapping to zero
04646B B8          0095*       cp b
04646C D2 78 64 04 0096*       jp nc,@advance_tileset
046470 32 20 64 04 0097*       ld (cur_level),a
