047788 01 00 00 00 0173*       ld bc,0
04778C ED 5B 59 77 0174*       ld de,(bg_y_plot)
       04          
047791 13          0175*       inc de
047792 CD 0D 19 04 0176*       call vdu_plot_bmp
047796 C9          0177*       ret
047797             0178*   ; end bg_plot
