0413C6             0161*   ; VDU 29, x; y;: Set graphics origin
0413C6             0162*   ; This command sets the graphics origin.
0413C6             0163*   ; The origin is the point on the screen where the coordinates (0,0) are located.
0413C6             0164*   ; inputs: bc=x0,de=y0
0413C6             0165*   ; outputs; nothing
0413C6             0166*   ; destroys: a might make it out alive
0413C6             0167*   vdu_set_gfx_origin:
0413C6 ED 43 DC 13 0168*       ld (@x0),bc
       04          
0413CB ED 53 DE 13 0169*       ld (@y0),de
       04          
0413D0 21 DB 13 04 0170*       ld hl,@cmd
0413D4 01 05 00 00 0171*       ld bc,@end-@cmd
0413D8 5B DF       0172*       rst.lil $18
0413DA C9          0173*       ret
0413DB 1D          0174*   @cmd:   db 29 ; set graphics origin command
0413DC 00 00       0175*   @x0: 	dw 0x0000 ; set by bc
0413DE 00 00       0176*   @y0: 	dw 0x0000 ; set by de
0413E0 00          0177*   @end:   db 0x00	  ; padding
0413E1             0178*   
0413E1             0179*   ; VDU 24, left; bottom; right; top;: Set graphics viewport
0413E1             0180*   ; NOTE: the order of the y-coordinate parameters are inverted
0413E1             0181*   ; 	because we have turned off logical screen scaling
0413E1             0182*   ; NOTE: coordinates are relative to current gfx origin
0413E1             0183*   ; inputs: bc=x0,de=y0,ix=x1,iy=y1
0413E1             0184*   ; outputs; nothing
0413E1             0185*   ; destroys: a might make it out alive
0413E1             0186*   vdu_set_gfx_viewport:
0413E1 ED 43 01 14 0187*       ld (@x0),bc
       04          
0413E6 FD 22 03 14 0188*       ld (@y1),iy
       04          
0413EB DD 22 05 14 0189*   	ld (@x1),ix
       04          
0413F0 ED 53 07 14 0190*   	ld (@y0),de
       04          
0413F5 21 00 14 04 0191*   	ld hl,@cmd
0413F9 01 09 00 00 0192*   	ld bc,@end-@cmd
0413FD 5B DF       0193*   	rst.lil $18
0413FF C9          0194*   	ret
041400 18          0195*   @cmd:   db 24 ; set graphics viewport command
041401 00 00       0196*   @x0: 	dw 0x0000 ; set by bc
041403 00 00       0197*   @y1: 	dw 0x0000 ; set by iy
041405 00 00       0198*   @x1: 	dw 0x0000 ; set by ix
041407 00 00       0199*   @y0: 	dw 0x0000 ; set by de
