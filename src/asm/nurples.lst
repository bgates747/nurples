046865             0057        include "levels.inc"
046865             0001*   ; tileset indices
046865             0002*   tiles_dg: equ 0
046865             0003*   ; tiles_xevious: equ 1
046865 00 00 00    0004*   tileset_ptr_idx: dl 0
046868             0005*   tileset_ptrs:
046868             0006*       ; dl tiles_xevious_levels
046868 18 6A 04    0007*       dl tileset_00_levels
04686B 00 00 00    0008*   tileset_ptrs_end: dl 0 ; list terminator
04686E             0009*   tileset_ptrs_count: equ [tileset_ptrs_end-tileset_ptrs]/3
04686E             0010*   
04686E             0011*   ; get a pointer to the current tileset
04686E             0012*   ; inputs: tileset_ptr_idx
04686E             0013*   ; returns: ix = pointer to tileset levels lut
04686E             0014*   get_tileset_ptr:
04686E 3A 65 68 04 0015*       ld a,(tileset_ptr_idx)
046872 FE 01       0016*       cp tileset_ptrs_count
046874 DA 7D 68 04 0017*       jp c,@index_valid
046878 AF          0018*       xor a ; corrupt/out-of-range selectors recover to the first tileset
046879 32 65 68 04 0019*       ld (tileset_ptr_idx),a
04687D             0020*   @index_valid:
04687D 11 00 00 00 0021*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
046881 57          0022*       ld d,a ; d = tileset index
046882 1E 03       0023*       ld e,3 ; three bytes per index record
046884 ED 5C       0024*       mlt de ; offset into tileset_ptrs lut
046886 DD 21 68 68 0025*       ld ix,tileset_ptrs
       04          
04688B DD 19       0026*       add ix,de ; ix = pointer to tileset_ptrs record
04688D C9          0027*       ret
04688E             0028*   ; end get_tileset_ptr
04688E             0029*   
04688E             0030*   ; intialize a tileset
04688E             0031*   ; inputs: a = index into tileset_ptrs
04688E             0032*   init_tileset:
04688E 32 65 68 04 0033*       ld (tileset_ptr_idx),a ; store new tileset index
046892 CD 6E 68 04 0034*       call get_tileset_ptr ; ix = pointer to tileset_ptrs record
046896 DD 37 00    0035*       ld ix,(ix) ; ix = pointer to tileset levels lut
046899 DD 7E FF    0036*       ld a,(ix-1) ; number of levels in the tileset
04689C 32 BA 68 04 0037*       ld (num_levels),a
0468A0 AF          0038*       xor a ; reset current level to zero
0468A1 32 B9 68 04 0039*       ld (cur_level),a
0468A5 C3 1A 69 04 0040*       jp init_level
0468A9             0041*   ; end init_tileset
0468A9             0042*   
0468A9             0043*   next_tileset:
0468A9 3A 65 68 04 0044*       ld a,(tileset_ptr_idx)
0468AD 3C          0045*       inc a ; bump to next index
0468AE FE 01       0046*       cp tileset_ptrs_count
0468B0 DA 8E 68 04 0047*       jp c,init_tileset
0468B4 AF          0048*       xor a ; wrap to the first tileset without dereferencing the terminator
0468B5 C3 8E 68 04 0049*       jp init_tileset
0468B9             0050*   ; end next_tileset
0468B9             0051*   
0468B9 00          0052*   cur_level: db 0
0468BA 00          0053*   num_levels: db 0
0468BB             0054*   
0468BB             0055*   ; get a pointer to the current level lookup record
0468BB             0056*   ; inputs: tileset_ptr_idx, cur_level
0468BB             0057*   ; returns: ix = pointer to level definition
0468BB             0058*   get_level_ptr:
0468BB CD 6E 68 04 0059*       call get_tileset_ptr
0468BF DD 37 00    0060*       ld ix,(ix) ; ix = pointer to tileset levels lut
0468C2 DD 7E FF    0061*       ld a,(ix-1) ; refresh the count after any outer-selector recovery
0468C5 32 BA 68 04 0062*       ld (num_levels),a
0468C9 47          0063*       ld b,a
0468CA 3A B9 68 04 0064*       ld a,(cur_level)
0468CE B8          0065*       cp b
0468CF DA D8 68 04 0066*       jp c,@index_valid
0468D3             0067*   @index_invalid:
0468D3 AF          0068*       xor a ; corrupt/out-of-range selectors recover to the first level
0468D4 32 B9 68 04 0069*       ld (cur_level),a
0468D8             0070*   @index_valid:
0468D8 11 00 00 00 0071*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
0468DC 57          0072*       ld d,a ; d = level index
0468DD 1E 03       0073*       ld e,3 ; three bytes per level record
0468DF ED 5C       0074*       mlt de ; offset into tileset levels lut
0468E1 DD 19       0075*       add ix,de ; ix = pointer to level record
0468E3 C9          0076*       ret
0468E4             0077*   ; end get_level_ptr
0468E4             0078*   
0468E4             0079*   ; advance to the next level in the current tileset
0468E4             0080*   ; inputs: tileset_ptr_idx, cur_level
0468E4             0081*   next_level:
0468E4             0082*   ; update starting score
0468E4 2A 2C 81 04 0083*       ld hl,(player_score)
0468E8 22 2F 81 04 0084*       ld (player_starting_score),hl
0468EC             0085*   ; refresh the authoritative inner-table count before advancing
0468EC CD 6E 68 04 0086*       call get_tileset_ptr
0468F0 DD 37 00    0087*       ld ix,(ix)
0468F3 DD 7E FF    0088*       ld a,(ix-1)
0468F6 32 BA 68 04 0089*       ld (num_levels),a
0468FA 47          0090*       ld b,a
0468FB             0091*   ; select the next valid level without indexing the terminator
0468FB 3A B9 68 04 0092*       ld a,(cur_level)
0468FF 3C          0093*       inc a ; bump to next level
046900 CA 11 69 04 0094*       jp z,@advance_tileset ; guard a corrupt 255 index wrapping to zero
046904 B8          0095*       cp b
046905 D2 11 69 04 0096*       jp nc,@advance_tileset
046909 32 B9 68 04 0097*       ld (cur_level),a
04690D C3 1A 69 04 0098*       jp init_level
046911             0099*   @advance_tileset:
046911 AF          0100*       xor a
046912 32 B9 68 04 0101*       ld (cur_level),a
046916 C3 A9 68 04 0102*       jp next_tileset
04691A             0103*   ; end next_level
04691A             0104*   
04691A             0105*   ; inputs: tileset_ptr_idx, cur_level
04691A             0106*   init_level:
04691A             0107*   ; ; initialize sprites and active tiles table
04691A             0108*   ;     call sprites_init
04691A             0109*   ;     call table_init
04691A             0110*   ;     call tile_table_init
04691A             0111*   ; set pointers
04691A CD BB 68 04 0112*       call get_level_ptr ; ix points to level lookup record
04691E DD 37 00    0113*       ld ix,(ix) ; ix points to level definition
046921             0114*   ; set tiles_cols
046921 DD 7E 00    0115*       ld a,(ix+0)
046924 32 CC 8F 04 0116*       ld (tiles_cols),a
046928             0117*   ; set tiles_row counter
046928 DD 7E 01    0118*       ld a,(ix+1)
04692B 32 C9 8F 04 0119*       ld (tiles_row),a
04692F AF          0120*       xor a
046930 32 CD 8F 04 0121*       ld (tiles_level_complete),a
046934             0122*   ; set cur_baseBufferId
046934 DD 27 04    0123*       ld hl,(ix+4)
046937 22 CE 8F 04 0124*       ld (cur_baseBufferId),hl
04693B             0125*   ; set tiles_row_defs
04693B ED 32 07    0126*       lea ix,ix+7 ; ix points to definition of first tile of first row
04693E DD 22 C6 8F 0127*       ld (tiles_row_defs),ix
       04          
046943             0128*   ; reset tile rows and plot coordinates
046943 21 FF FF FF 0129*       ld hl,-1
046947 22 DE 90 04 0130*       ld (bg_y_plot),hl
04694B 23          0131*       inc hl
04694C 22 D2 8F 04 0132*       ld (tiles_x_plot),hl
046950 21 F1 FF FF 0133*       ld hl,-15
046954 22 D6 8F 04 0134*       ld (tiles_y_plot),hl
046958             0135*   ; print level number, score, and countdown to start
046958 CD EF 69 04 0136*       call print_level
04695C CD 47 81 04 0137*       call print_score
046960 CD 8E 69 04 0138*       call start_level_countdown
046964 C9          0139*       ret
046965             0140*   ; end init_level
046965             0141*   
046965             0142*   init_bg:
046965             0143*   ; draw initial background tiles
046965 21 00 04 00 0144*       ld hl,BUF_BG_STARS_0
046969 CD 93 14 04 0145*       call vdu_buff_select
04696D 01 00 00 00 0146*       ld bc,0
046971 11 00 00 00 0147*       ld de,field_top
046975 CD A3 18 04 0148*       call vdu_plot_bmp
046979 21 02 04 00 0149*       ld hl,BUF_BG_STARS_4
04697D CD 93 14 04 0150*       call vdu_buff_select
046981 01 00 00 00 0151*       ld bc,0
046985 11 00 01 00 0152*       ld de,field_top+256
046989 CD A3 18 04 0153*       call vdu_plot_bmp
04698D C9          0154*       ret
04698E             0155*   ; end init_level
04698E             0156*   start_level_countdown:
04698E             0157*   ; set gfx origin and viewport to playing field window
04698E CD BE 81 04 0158*       call set_gfx_playing_field
046992 CD 65 69 04 0159*       call init_bg
046996             0160*   ; set text colors
046996 3E 90       0161*       ld a,16+128 ; darkest blue
046998 CD B2 13 04 0162*       call vdu_colour_text
04699C 3E 3A       0163*       ld a,58 ; dark orange
04699E CD B2 13 04 0164*       call vdu_colour_text
0469A2             0165*   ; print get ready message
0469A2 0E 1B       0166*       ld c,27 ; x
0469A4 06 10       0167*       ld b,16 ; y
0469A6 CD 6D 13 04 0168*       call vdu_move_cursor
0469AA CD 5C 00 04 0169*       call printInline
0469AE 47 65 74 20 0170*       asciz "Get Ready!"
       52 65 61 64 
       79 21 00    
0469B9             0171*   ; countdown to restart
0469B9 0E 18       0172*       ld c,24 ; x
0469BB 06 11       0173*       ld b,17 ; y
0469BD CD 6D 13 04 0174*       call vdu_move_cursor
0469C1 CD 5C 00 04 0175*       call printInline
0469C5 53 74 61 72 0176*       asciz "Starting In..."
       74 69 6E 67 
       20 49 6E 2E 
       2E 2E 00    
0469D4 06 06       0177*       ld b,6 ; loop counter
0469D6             0178*   @waitLoop:
0469D6 C5          0179*       push bc
0469D7 78          0180*       ld a,b
0469D8 3D          0181*       dec a
0469D9 CD F0 95 04 0182*       call printHexA
0469DD 0E 26       0183*       ld c,38 ; x
0469DF 06 11       0184*       ld b,17 ; y
0469E1 CD 6D 13 04 0185*       call vdu_move_cursor
0469E5 3E 80       0186*       ld a,%10000000 ; bit 7 changes once per second
0469E7 CD E4 12 04 0187*       call multiPurposeDelay
0469EB C1          0188*       pop bc
0469EC 10 E8       0189*       djnz @waitLoop
0469EE C9          0190*       ret
0469EF             0191*   ; end start_level_countdown
0469EF             0192*   
0469EF             0193*   level_x: equ 39
0469EF             0194*   level_y: equ 1
0469EF             0195*   print_level:
0469EF             0196*   ; set text colors
0469EF 3E 80       0197*       ld a,c_black+128
0469F1 CD B2 13 04 0198*       call vdu_colour_text
0469F5 3E 0A       0199*       ld a,c_green
0469F7 CD B2 13 04 0200*       call vdu_colour_text
0469FB             0201*   ; set text coordinates and print
0469FB 0E 27       0202*       ld c,level_x
0469FD 06 01       0203*       ld b,level_y
0469FF CD 6D 13 04 0204*       call vdu_move_cursor
046A03 CD 5C 00 04 0205*       call printInline
046A07 4C 65 76 65 0206*       asciz "Level "
       6C 20 00    
046A0E 3A B9 68 04 0207*       ld a,(cur_level)
046A12 CD F0 95 04 0208*       call printHexA
046A16 C9          0209*       ret
046A17             0210*   ; end print_level
