044C55             0171*   
044C55             0172*   init_enemy_seekers:
044C55             0173*   ; set pointer to seeker sprite table
044C55 FD 21 C6 88 0174*       ld iy,seekers_base
       04          
044C5A FD 7E 00    0175*       ld a,(iy+sprite_id) ; sprite id
044C5D 1E 03       0176*       ld e,seekers_max ; sprite loop counter
044C5F             0177*   ; define seeker sprites
044C5F             0178*   @sprites_loop:
044C5F F5          0179*       push af
044C60 D5          0180*       push de
044C61 CD BB 19 04 0181*   	call vdu_sprite_select
044C65 CD CE 19 04 0182*   	call vdu_sprite_clear_frames
044C69 21 53 01 00 0183*   	ld hl,BUF_SEEKER_000
044C6D 06 20       0184*   	ld b,32 ; 32 bitmaps for seeker
044C6F             0185*   @frames_loop:
044C6F C5          0186*   	push bc
044C70 E5          0187*   	push hl
044C71 CD 10 1B 04 0188*   	call vdu_sprite_add_buff
044C75 E1          0189*   	pop hl
044C76 23          0190*   	inc hl
044C77 C1          0191*   	pop bc
044C78 10 F5       0192*   	djnz @frames_loop
044C7A D1          0193*       pop de ; sprite loop counter
044C7B F1          0194*       pop af ; sprite id
044C7C 3C          0195*       inc a
044C7D 1D          0196*       dec e
044C7E C2 5F 4C 04 0197*       jp nz,@sprites_loop
044C82 C9          0198*       ret
044C83             0199*   ; end init_enemy_seekers
044C83             0053        include "explosion.inc"
044C83             0001*   explosions_max: equ 8
044C83             0002*   explosion_animation_count: equ 5
044C83             0003*   explosion_animation_ticks: equ 8
044C83             0004*   ; One update clears the just-spawned flag, then every animation frame runs for
044C83             0005*   ; explosion_animation_ticks updates.
044C83             0006*   explosion_lifetime_updates: equ explosion_animation_count*explosion_animation_ticks+1
044C83             0007*   explosion_defaults:
044C83 04          0008*       db explosion            ; type
044C84 09 01 00    0009*       dl BUF_EXPLOSION_A	    ; base_bufferId
044C87 00 4D 04    0010*       dl move_explosion	    ; move_program
044C8A 40          0011*       db %01000000            ; collisions bit 6 signals sprite alive
044C8B 07          0012*       db 7	                ; dim_x
044C8C 07          0013*       db 7                    ; dim_y
044C8D 01          0014*       db 1                    ; num_orientations
044C8E 05          0015*       db explosion_animation_count ; num_animations
044C8F 05          0016*       db explosion_animation_count ; animation
044C90 08          0017*       db explosion_animation_ticks ; animation_timer
044C91 00          0018*       db 0	                ; move_timer
044C92 00          0019*       db 0	                ; move_step
044C93 00          0020*       db 0	                ; points
044C94 00          0021*       db 0	                ; shield_damage
044C95 00          0022*       db 0                    ; frame
