       04          
04667A FD 22 BC 67 0109*       ld (table_pointer),iy
       04          
04667F 21 BD 65 04 0110*       ld hl,laser_defaults
046683 CD 00 69 04 0111*       call spawn_sprite_from_sprite
046687 D0          0112*       ret nc ; no carry means no free sprite slots, so we go home
046688             0113*   ; other specific initialization
