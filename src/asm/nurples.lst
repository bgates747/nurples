041867             0042        include "vdu_fonts.inc"
041867             0001*   ; select font
041867             0002*   ; inputs: hl = bufferId, a = font flags
041867             0003*   ; Flags:
041867             0004*   ; Bit	Description
041867             0005*   ; 0	Adjust cursor position to ensure text baseline is aligned
041867             0006*   ;   0: Do not adjust cursor position (best for changing font on a new line)
041867             0007*   ;   1: Adjust cursor position (best for changing font in the middle of a line)
041867             0008*   ; 1-7	Reserved for future use
041867             0009*   ; VDU 23, 0, &95, 0, bufferId; flags: Select font
041867             0010*   vdu_font_select:
041867 22 7E 18 04 0011*       ld (@bufferId),hl
04186B 32 80 18 04 0012*       ld (@flags),a
04186F 21 7A 18 04 0013*       ld hl,@cmd
041873 01 07 00 00 0014*       ld bc,@end-@cmd
041877 5B DF       0015*       rst.lil $18
041879 C9          0016*       ret
04187A 17 00 95 00 0017*   @cmd: db 23, 0, 0x95, 0
04187E 00 00       0018*   @bufferId: dw 0x0000
041880 00          0019*   @flags: db 0x00
041881             0020*   @end:
041881             0021*   
041881             0022*   ; create font from buffer
041881             0023*   ; inputs: hl = bufferId, e = width, d = height, d = ascent, a = flags
041881             0024*   ; VDU 23, 0, &95, 1, bufferId; width, height, ascent, flags: Create font from buffer
041881             0025*   vdu_font_create:
041881 22 A6 18 04 0026*       ld (@bufferId),hl
041885 ED 53 A8 18 0027*       ld (@width),de ; also loads height
       04          
04188A 32 AB 18 04 0028*       ld (@flags),a
04188E 7A          0029*       ld a,d ; height
04188F 32 AA 18 04 0030*       ld (@ascent),a ; ascent = height
041893             0031*   ; consolidate buffer
041893 CD BC 15 04 0032*       call vdu_consolidate_buffer
041897             0033*   ; create font
041897 21 A2 18 04 0034*       ld hl,@cmd
04189B 01 0A 00 00 0035*       ld bc,@end-@cmd
04189F 5B DF       0036*       rst.lil $18
0418A1 C9          0037*       ret
0418A2 17 00 95 01 0038*   @cmd: db 23, 0, 0x95, 1
0418A6 00 00       0039*   @bufferId: dw 0x0000
0418A8 00          0040*   @width: db 0x00
0418A9 00          0041*   @height: db 0x00
0418AA 00          0042*   @ascent: db 0x00
0418AB 00          0043*   @flags: db 0x00
0418AC             0044*   @end:
0418AC             0045*   
0418AC             0046*   ; set or adjust font property
0418AC             0047*   ; inputs: hl = bufferId, a = field, de = value
0418AC             0048*   ; VDU 23, 0, &95, 2, bufferId; field, value;: Set or adjust font property
0418AC             0049*   vdu_font_property:
0418AC 22 C8 18 04 0050*       ld (@bufferId),hl
0418B0 32 CA 18 04 0051*       ld (@field),a
0418B4 ED 53 CB 18 0052*       ld (@value),de
       04          
0418B9 21 C4 18 04 0053*       ld hl,@cmd
0418BD 01 09 00 00 0054*       ld bc,@end-@cmd
0418C1 5B DF       0055*       rst.lil $18
0418C3 C9          0056*       ret
0418C4 17 00 95 02 0057*   @cmd: db 23, 0, 0x95, 2
0418C8 00 00       0058*   @bufferId: dw 0x0000
0418CA 00          0059*   @field: db 0x00
0418CB 00 00       0060*   @value: dw 0x0000
0418CD 00          0061*   @end: db 0x00 ; padding
0418CE             0062*   
0418CE             0063*   ; VDU 23, 0, &95, 3, bufferId; [<args>]: Reserved
0418CE             0064*   
0418CE             0065*   ; Clear/Delete font
0418CE             0066*   ; inputs: hl = bufferId
0418CE             0067*   ; VDU 23, 0, &95, 4, bufferId;: Clear/Delete font
0418CE             0068*   vdu_font_clear:
