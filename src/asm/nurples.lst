040F5C FF 1D 00    1323*       dl 0x001DFF ; 0000E8, 42.184
040F5F 15 1E 00    1324*       dl 0x001E15 ; 0000E9, 42.307
040F62 2C 1E 00    1325*       dl 0x001E2C ; 0000EA, 42.429
040F65 42 1E 00    1326*       dl 0x001E42 ; 0000EB, 42.551
040F68 58 1E 00    1327*       dl 0x001E58 ; 0000EC, 42.672
040F6B 6E 1E 00    1328*       dl 0x001E6E ; 0000ED, 42.793
040F6E 84 1E 00    1329*       dl 0x001E84 ; 0000EE, 42.913
040F71 99 1E 00    1330*       dl 0x001E99 ; 0000EF, 43.033
040F74 AF 1E 00    1331*       dl 0x001EAF ; 0000F0, 43.152
040F77 C5 1E 00    1332*       dl 0x001EC5 ; 0000F1, 43.271
040F7A DA 1E 00    1333*       dl 0x001EDA ; 0000F2, 43.390
040F7D F0 1E 00    1334*       dl 0x001EF0 ; 0000F3, 43.508
