047D4C             0001*   ; sprite_type
047D4C             0002*   enemy_dead: equ 0
047D4C             0003*   enemy_air: equ 1
047D4C             0004*   enemy_ground: equ 2
047D4C             0005*   enemy_projectile: equ 3
047D4C             0006*   explosion: equ 4
