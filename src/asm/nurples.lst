046B75             0544*   
046B75             0545*   ; compute animation frame based on sprite_animation and sprite_heading
046B75             0546*   ; inputs: table_pointer set to sprite record
046B75             0547*   ; outputs: a, sprite_frame set to animation frame
046B75             0548*   ; destroys: a,hl
046B75             0549*   sprite_frame_heading_animation:
046B75 FD 7E 11    0550*       ld a,(iy+sprite_heading+1) ; we want the integer portion
046B78 CB 3F       0551*       srl a ; divide integer portion by 8
046B7A CB 3F       0552*       srl a
046B7C CB 3F       0553*       srl a
046B7E FD 66 22    0554*       ld h,(iy+sprite_animation)
046B81 2E 20       0555*       ld l,32 ; 32 orientation frames per animation
046B83 ED 6C       0556*       mlt hl ; hl = offset from base animation
046B85 85          0557*       add a,l ; modulo256 since sprite_frame is only 1 byte
046B86 FD 77 28    0558*       ld (iy+sprite_frame),a
046B89 C9          0559*       ret
046B8A             0560*   ; end sprite_frame_heading_animation
046B8A             0561*   
046B8A             0562*   ; compute animation frame based on sprite_heading
046B8A             0563*   ; inputs: table_pointer set to sprite record
046B8A             0564*   ; outputs: a, sprite_frame set to animation frame
046B8A             0565*   ; destroys: a,hl
046B8A             0566*   sprite_frame_heading:
046B8A FD 7E 11    0567*       ld a,(iy+sprite_heading+1) ; we want the integer portion
046B8D CB 3F       0568*       srl a ; divide integer portion by 8
046B8F CB 3F       0569*       srl a
046B91 CB 3F       0570*       srl a
046B93 FD 77 28    0571*       ld (iy+sprite_frame),a
046B96 C9          0572*       ret
046B97             0573*   ; end sprite_frame_heading
046B97             0574*   
046B97             0575*   ; load a sprite with animation bitmaps
046B97             0576*   ; inputs: a = sprite id, hl = base bufferId, bc = number of frames, sprite_select
046B97             0577*   sprite_load_frames:
046B97             0578*   ; back up input parameters
046B97 E5          0579*       push hl ; base bufferId
046B98 C5          0580*       push bc ; bc = number of frames
046B99 CD 16 1A 04 0581*       call vdu_sprite_clear_frames
046B9D C1          0582*       pop bc ; bc = number of frames
046B9E E1          0583*       pop hl ; = base bufferId
046B9F             0584*   @load_frames:
046B9F C5          0585*       push bc ; back up loop counter
046BA0 E5          0586*       push hl ; back up base bufferId
046BA1 CD 58 1B 04 0587*       call vdu_sprite_add_buff
046BA5 E1          0588*       pop hl ; restore base bufferId
046BA6 23          0589*       inc hl ; bump it to the next frame
046BA7             0590*   ; decrement loop counter
046BA7 C1          0591*       pop bc
046BA8 0B          0592*       dec bc
046BA9 79          0593*       ld a,c
046BAA B7          0594*       or a
046BAB C2 9F 6B 04 0595*       jp nz,@load_frames
046BAF 78          0596*       ld a,b
046BB0 B7          0597*       or a
046BB1 C2 9F 6B 04 0598*       jp nz,@load_frames
046BB5 C9          0599*       ret
046BB6             0600*   ; end sprite_load_frames
046BB6             0071        include "state.inc"
046BB6             0001*   ; Game state variables
046BB6 77 6C 04    0002*   game_state:  dl game_main_menu
046BB9             0003*   game_fault_bad_state: equ 0
046BB9 00          0004*   game_fault_flags: db 0 ; latched fail-closed diagnostics
046BBA 00          0005*   game_exit_requested: db 0 ; main-loop handoff; state handlers must return normally
046BBB             0006*   
046BBB             0007*   do_game:
046BBB 2A B6 6B 04 0008*       ld hl,(game_state)   ; Load the current game state
046BBF CD DD 6B 04 0009*       call game_state_pointer_valid
046BC3 DA D6 6B 04 0010*       jp c,@dispatch
046BC7 21 B9 6B 04 0011*       ld hl,game_fault_flags
046BCB CB C6       0012*       set game_fault_bad_state,(hl)
046BCD 21 30 6D 04 0013*       ld hl,game_init ; publish recovery; do not run it in the corrupt frame
046BD1 22 B6 6B 04 0014*       ld (game_state),hl
046BD5 C9          0015*       ret
046BD6             0016*   @dispatch:
046BD6             0017*       CALL_HL                ; Call the corresponding state handler
                       M1 Args: none
046BD6 01 DC 6B 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
046BDA C5          0002*M1     push bc ; which constitutes the return address
046BDB E9          0003*M1     jp (hl) ; Jump to the address in HL
046BDC C9          0018*       ret
046BDD             0019*   
046BDD             0020*   ; Exact stabilization whitelist for writable legacy global-state pointers.
046BDD             0021*   ; inputs/outputs: hl = candidate handler; carry set only for an exact match
046BDD             0022*   ; destroys: a,de
046BDD             0023*   game_state_pointer_valid:
046BDD 11 77 6C 04 0024*       ld de,game_main_menu
046BE1 CD 71 6C 04 0025*       call @matches
046BE5 CA 6F 6C 04 0026*       jp z,@valid
046BE9 11 78 6C 04 0027*       ld de,game_paused
046BED CD 71 6C 04 0028*       call @matches
046BF1 CA 6F 6C 04 0029*       jp z,@valid
046BF5 11 79 6C 04 0030*       ld de,game_level_transition
046BF9 CD 71 6C 04 0031*       call @matches
046BFD CA 6F 6C 04 0032*       jp z,@valid
046C01 11 86 6C 04 0033*       ld de,game_over
046C05 CD 71 6C 04 0034*       call @matches
046C09 CA 6F 6C 04 0035*       jp z,@valid
046C0D 11 E9 6C 04 0036*       ld de,game_victory
046C11 CD 71 6C 04 0037*       call @matches
046C15 CA 6F 6C 04 0038*       jp z,@valid
046C19 11 EA 6C 04 0039*       ld de,game_loading
046C1D CD 71 6C 04 0040*       call @matches
046C21 CA 6F 6C 04 0041*       jp z,@valid
046C25 11 F7 6C 04 0042*       ld de,game_cutscene
046C29 CD 71 6C 04 0043*       call @matches
046C2D CA 6F 6C 04 0044*       jp z,@valid
046C31 11 F8 6C 04 0045*       ld de,game_inventory
046C35 CD 71 6C 04 0046*       call @matches
046C39 CA 6F 6C 04 0047*       jp z,@valid
046C3D 11 F9 6C 04 0048*       ld de,game_map
046C41 CD 71 6C 04 0049*       call @matches
046C45 CA 6F 6C 04 0050*       jp z,@valid
046C49 11 FA 6C 04 0051*       ld de,game_exit
046C4D CD 71 6C 04 0052*       call @matches
046C51 CA 6F 6C 04 0053*       jp z,@valid
046C55 11 30 6D 04 0054*       ld de,game_init
046C59 CD 71 6C 04 0055*       call @matches
046C5D CA 6F 6C 04 0056*       jp z,@valid
046C61 11 A7 6F 04 0057*       ld de,game_playing
046C65 CD 71 6C 04 0058*       call @matches
046C69 CA 6F 6C 04 0059*       jp z,@valid
046C6D AF          0060*       xor a
046C6E C9          0061*       ret
046C6F             0062*   @valid:
046C6F 37          0063*       scf
046C70 C9          0064*       ret
046C71             0065*   @matches:
046C71 E5          0066*       push hl
046C72 B7          0067*       or a
046C73 ED 52       0068*       sbc hl,de
046C75 E1          0069*       pop hl
046C76 C9          0070*       ret
046C77             0071*   ; end game_state_pointer_valid
