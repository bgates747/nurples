047BB7 E1          0066*   	pop hl
047BB8 23          0067*   	inc hl
047BB9 C1          0068*   	pop bc
047BBA 10 F5       0069*   	djnz @frames_loop
047BBC D1          0070*       pop de ; sprite loop counter
047BBD F1          0071*       pop af ; sprite id
