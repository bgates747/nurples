       04          
044D2E FD 7E 00    0095*       ld a,(iy+sprite_id) ; sprite id
044D31 1E 08       0096*       ld e,explosions_max ; sprite loop counter
044D33             0097*   ; define explosion sprites
044D33             0098*   @sprites_loop:
044D33 F5          0099*       push af
044D34 D5          0100*       push de
044D35 CD BB 19 04 0101*   	call vdu_sprite_select
044D39 CD CE 19 04 0102*   	call vdu_sprite_clear_frames
044D3D 21 09 01 00 0103*   	ld hl,BUF_EXPLOSION_A
