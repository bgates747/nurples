047102             0147*   
047102             0148*   ; Exact stabilization whitelist for writable legacy player-state pointers.
047102             0149*   ; Invalid actor state is surfaced as an event for the global coordinator.
047102             0150*   player_state_pointer_valid:
047102 11 DE 73 04 0151*       ld de,player_alive
047106 CD 42 71 04 0152*       call @matches
04710A CA 40 71 04 0153*       jp z,@valid
04710E 11 0D 73 04 0154*       ld de,player_spawning
047112 CD 42 71 04 0155*       call @matches
047116 CA 40 71 04 0156*       jp z,@valid
04711A 11 9A 73 04 0157*       ld de,player_grace
04711E CD 42 71 04 0158*       call @matches
047122 CA 40 71 04 0159*       jp z,@valid
047126 11 48 74 04 0160*       ld de,player_dying
04712A CD 42 71 04 0161*       call @matches
04712E CA 40 71 04 0162*       jp z,@valid
047132 11 BE 75 04 0163*       ld de,player_dead
047136 CD 42 71 04 0164*       call @matches
04713A CA 40 71 04 0165*       jp z,@valid
04713E AF          0166*       xor a
04713F C9          0167*       ret
047140             0168*   @valid:
047140 37          0169*       scf
047141 C9          0170*       ret
047142             0171*   @matches:
047142 E5          0172*       push hl
047143 B7          0173*       or a
047144 ED 52       0174*       sbc hl,de
