042305 D5          0180*       push de
042306 CD 44 19 04 0181*   	call vdu_sprite_select
04230A CD 57 19 04 0182*   	call vdu_sprite_clear_frames
04230E 21 53 01 00 0183*   	ld hl,BUF_SEEKER_000
