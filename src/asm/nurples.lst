044B69             0004*   
044B69             0005*   seeker_defaults:
044B69 01          0006*       db enemy_air            ; type
044B6A 53 01 00    0007*       dl BUF_SEEKER_000       ; base_bufferId
044B6D 20 4C 04    0008*       dl en_nav_seek_zag    ; move_program
044B70 40          0009*       db %01000000            ; collisions bit 6 signals sprite alive
044B71 10          0010*       db 16                   ; dim_x
044B72 10          0011*       db 16                   ; dim_y
044B73 20          0012*       db 32                   ; num_orientations
044B74 01          0013*       db 1                    ; num_animations
044B75 00          0014*       db 0                    ; animation
044B76 00          0015*       db 0                    ; animation_timer
044B77 01          0016*       db 1                    ; move_timer
044B78 00          0017*       db 0                    ; move_step
044B79 0A          0018*       db 10                   ; points
044B7A FC          0019*       db -4                   ; shield_damage
044B7B 00          0020*       db 0                    ; frame
044B7C             0021*   
044B7C             0022*   enemy_spawn_seeker:
044B7C 21 69 4B 04 0023*       ld hl,seeker_defaults
044B80 DD 21 18 8F 0024*       ld ix,seekers_base
       04          
044B85 06 03       0025*       ld b,seekers_max
044B87 CD 78 79 04 0026*       call spawn_sprite_from_tile
044B8B D0          0027*       ret nc ; no carry means no free sprite slots, so we go home
044B8C             0028*   ; other specific initialization
044B8C 21 80 02 00 0029*       ld hl,speed_seeker
