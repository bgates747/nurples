048B98             0392*   ; compute animation frame based on tile_animation and tile_heading
048B98             0393*   ; inputs: iy set to tile record
048B98             0394*   ; outputs: a, tile_frame set to animation frame
048B98             0395*   ; destroys: a,hl
048B98             0396*   tile_frame_heading_animation:
048B98 FD 7E 11    0397*       ld a,(iy+tile_heading+1) ; we want the integer portion
048B9B CB 3F       0398*       srl a ; divide integer portion by 8
048B9D CB 3F       0399*       srl a
048B9F CB 3F       0400*       srl a
048BA1 FD 66 22    0401*       ld h,(iy+tile_animation)
048BA4 2E 20       0402*       ld l,32 ; 32 orientation frames per animation
048BA6 ED 6C       0403*       mlt hl ; hl = offset from base animation
048BA8 85          0404*       add a,l ; modulo256 since tile_frame is only 1 byte
048BA9 FD 77 28    0405*       ld (iy+tile_frame),a
048BAC C9          0406*       ret
048BAD             0407*   ; end tile_frame_heading_animation
048BAD             0408*   
048BAD             0409*   ; compute animation frame based on tile_heading
048BAD             0410*   ; inputs: iy set to tile record
048BAD             0411*   ; outputs: a, tile_frame set to animation frame
048BAD             0412*   ; destroys: a,hl
048BAD             0413*   tile_frame_heading:
048BAD FD 7E 11    0414*       ld a,(iy+tile_heading+1) ; we want the integer portion
048BB0 CB 3F       0415*       srl a ; divide integer portion by 8
048BB2 CB 3F       0416*       srl a
048BB4 CB 3F       0417*       srl a
048BB6 FD 77 28    0418*       ld (iy+tile_frame),a
048BB9 C9          0419*       ret
048BBA             0420*   ; end tile_frame_heading
048BBA             0078        include "tiles.inc"
048BBA 00 00 00    0001*   tiles_row_defs: dl 0x000000 ; pointer to current row tiles definitions
048BBD 00 00 00    0002*   tiles_row: dl 0 ; decrements each time a row is drawn. level is over when hits zero
048BC0             0003*       ; initialize to zero for a maximum of 256 rows in a level
048BC0 00          0004*   tiles_cols: db 0 ; number of tile columns in the current level
048BC1 00          0005*   tiles_level_complete: db 0 ; latched until the global state consumes it
048BC2             0006*   
048BC2 00 00 00    0007*   cur_baseBufferId: dl 0
048BC5 00          0008*       db 0 ; padding for byte-shifting
048BC6 00 00 00    0009*   tiles_x_plot: dl 0
048BC9 00          0010*       db 0 ; padding for byte-shifting
048BCA F1 FF FF    0011*   tiles_y_plot: dl -15
048BCD             0012*   
048BCD             0013*   ; GAMEPLAY-ONLY TERRAIN PIPELINE.
048BCD             0014*   ; This loop is deliberately synchronized to one scanline per frame and to the
048BCD             0015*   ; 16x16 terrain-row admission/activation cadence below. Do not generalize it to
048BCD             0016*   ; multi-scanline scrolling or reuse it for level-transition hyperwarp effects.
048BCD             0017*   ; Level transitions must wait for terrain to clear, then use the separate
048BCD             0018*   ; starfield-only transition scroller.
048BCD             0019*   tiles_plot:
048BCD             0020*   ; The terrain pipeline consumes the published player lifecycle itself. Death,
048BCD             0021*   ; entrance and grace keep the existing field spatially fixed without teaching
048BCD             0022*   ; the global scheduler how to rewrite tile state.
048BCD CD 48 71 04 0023*       call player_world_travel_enabled
048BD1 DA D7 8B 04 0024*       jp c,@travel
048BD5 AF          0025*       xor a
048BD6 C9          0026*       ret
048BD7             0027*   @travel:
048BD7 3A C1 8B 04 0028*       ld a,(tiles_level_complete)
048BDB B7          0029*       or a
048BDC CA E7 8B 04 0030*       jp z,@row_available
048BE0             0031*   ; A blocking actor sequence may still be rendering after the final source row.
048BE0             0032*   ; Keep the passive terrain moving without reading beyond the level definition.
048BE0 CD 6E 8C 04 0033*       call tiles_scroll_background
048BE4 3E 01       0034*       ld a,1 ; preserve the latched world result for a coordinating caller
048BE6 C9          0035*       ret
048BE7             0036*   @row_available:
048BE7 CD 6E 8C 04 0037*       call tiles_scroll_background
048BEB             0038*   ; initialize tiles loop
048BEB 21 00 00 00 0039*       ld hl,0 ; init plotting x-coordinate
048BEF 22 C6 8B 04 0040*       ld (tiles_x_plot),hl
048BF3 2A BA 8B 04 0041*       ld hl,(tiles_row_defs)
048BF7 3A C0 8B 04 0042*       ld a,(tiles_cols)
048BFB 47          0043*       ld b,a ; column loop counter
048BFC             0044*   @loop:
048BFC C5          0045*       push bc ; save the loop counter
048BFD             0046*   ; read the tile defintion for the current column
048BFD 7E          0047*       ld a,(hl) ; a has tile definition
048BFE E5          0048*       push hl ; save pointer to tile definition
048BFF 2A C2 8B 04 0049*       ld hl,(cur_baseBufferId) ; hl base buffer id of tileset
048C03 6F          0050*       ld l,a ; a is the offset from the base so hl is now the bufferId of the tile
048C04 CD 2C 15 04 0051*       call vdu_buff_select ; tile bitmap buffer is now active
048C08             0052*   ; plot the active bitmap
048C08 ED 4B C6 8B 0053*       ld bc,(tiles_x_plot)
       04          
048C0D ED 5B CA 8B 0054*       ld de,(tiles_y_plot)
       04          
048C12 CD 62 19 04 0055*       call vdu_plot_bmp
048C16             0056*   ; bump x-coords the width of one tile and save it
048C16 2A C6 8B 04 0057*       ld hl,(tiles_x_plot)
048C1A 01 10 00 00 0058*       ld bc,16
048C1E 09          0059*       add hl,bc
048C1F 22 C6 8B 04 0060*       ld (tiles_x_plot),hl
048C23             0061*   ; prepare to loop to next column
048C23 E1          0062*       pop hl ; get back pointer to tile def
048C24 23          0063*       inc hl ; bump it to the next column
048C25 C1          0064*       pop bc ; snag our loop counter
048C26 10 D4       0065*       djnz @loop
048C28             0066*   ; increment tiles plotting y-coordinate
048C28             0067*   ; (we use ix b/c we want to preserve hl for the next step)
048C28 DD 2A CA 8B 0068*       ld ix,(tiles_y_plot)
       04          
048C2D 11 01 00 00 0069*       ld de,1
048C31 DD 19       0070*       add ix,de
048C33 DD 22 CA 8B 0071*       ld (tiles_y_plot),ix
       04          
048C38 DD 7D       0072*       ld a,ixl
048C3A FE 01       0073*       cp 1
048C3C CA 42 8C 04 0074*       jp z,@next_row
048C40 AF          0075*       xor a ; no level-complete result this frame
048C41 C9          0076*       ret
048C42             0077*   @next_row:
048C42             0078*   ; do active tiles
048C42 E5          0079*       push hl ; save pointer to next row tile def
048C43 CD A3 8C 04 0080*       call do_active_tiles
048C47 E1          0081*       pop hl ; get back pointer to next row tile def
048C48             0082*   ; time to bump tiles_row_defs to next row
048C48             0083*   ; (hl was already there at the end of the loop)
048C48 22 BA 8B 04 0084*       ld (tiles_row_defs),hl
048C4C             0085*   ; reset coords to plot next row of tiles
048C4C 21 00 00 00 0086*       ld hl,0
048C50 22 C6 8B 04 0087*       ld (tiles_x_plot),hl
048C54 21 F1 FF FF 0088*       ld hl,-15
048C58 22 CA 8B 04 0089*       ld (tiles_y_plot),hl
048C5C             0090*   ; decrement tiles row counter
048C5C 21 BD 8B 04 0091*       ld hl,tiles_row
048C60 35          0092*       dec (hl)
048C61 CA 67 8C 04 0093*       jp z,@level_complete
048C65 AF          0094*       xor a ; no level-complete result this frame
048C66 C9          0095*       ret
048C67             0096*   @level_complete:
048C67 3E 01       0097*       ld a,1
048C69 32 C1 8B 04 0098*       ld (tiles_level_complete),a
048C6D C9          0099*       ret
048C6E             0100*   ; end tiles_plot
048C6E             0101*   
048C6E             0102*   tiles_scroll_background:
048C6E             0103*   ; GAMEPLAY ONLY: this one-scanline scroll and one-scanline redraw are coupled to
048C6E             0104*   ; tiles_plot's optimized terrain cadence. Do not pass a variable speed here and
048C6E             0105*   ; do not call this helper for fast level-transition scrolling.
048C6E             0106*   ; set gfx origin to playing field window
048C6E 01 80 00 00 0107*       ld bc,origin_left
048C72 11 30 00 00 0108*       ld de,origin_top
048C76 CD BC 14 04 0109*       call vdu_set_gfx_origin
048C7A             0110*   ; set gfx viewport to playing field window
048C7A CD 71 7B 04 0111*       call set_gfx_playing_field
048C7E             0112*   ; move the background down one pixel
048C7E 3E 02       0113*       ld a,2 ; current gfx viewport
048C80 2E 02       0114*       ld l,2 ; direction=down
048C82 26 01       0115*       ld h,1 ; speed=1 px
048C84 CD E2 13 04 0116*       call vdu_scroll_down
048C88             0117*   ; set gfx viewport to one scanline to optimise plotting tiles
048C88 01 00 00 00 0118*       ld bc,0 ; leftmost x-coord
048C8C 11 00 00 00 0119*       ld de,0 ; topmost y-coord
048C90 DD 21 FF 00 0120*       ld ix,255 ; rightmost x-coord
       00          
048C95 FD 21 00 00 0121*       ld iy,0 ; bottommost y-coord
       00          
048C9A CD D7 14 04 0122*       call vdu_set_gfx_viewport
048C9E             0123*   ; plot the background
048C9E CD F1 8C 04 0124*       call bg_plot
048CA2 C9          0125*       ret
048CA3             0126*   ; end tiles_scroll_background
048CA3             0127*   
048CA3             0128*   do_active_tiles:
048CA3             0129*   ; initialize tiles loop
048CA3 21 00 00 00 0130*       ld hl,0 ; init plotting x-coordinate
048CA7 22 C6 8B 04 0131*       ld (tiles_x_plot),hl
048CAB 2A BA 8B 04 0132*       ld hl,(tiles_row_defs)
048CAF 3A C0 8B 04 0133*       ld a,(tiles_cols)
048CB3 47          0134*       ld b,a ; column loop counter
048CB4             0135*   @loop:
048CB4 C5          0136*       push bc ; save the loop counter
048CB5             0137*   ; read the tile defintion for the current column
048CB5 7E          0138*       ld a,(hl) ; a has tile definition
048CB6 E5          0139*       push hl ; save pointer to tile definition
048CB7 B7          0140*       or a ; check for null tile
048CB8 CA D8 8C 04 0141*       jp z,@next_tile ; skip to next tile if null
048CBC FE 11       0142*       cp tile_activation_routines_count ; carry reset if active tile
048CBE D2 D8 8C 04 0143*       jp nc,@next_tile ; skip to next tile if not active
048CC2             0144*   ; call the tile activation routine
048CC2 21 0E 8E 04 0145*       ld hl,tile_activation_routines
048CC6 11 00 00 00 0146*       ld de,0 ; MLT writes DE[15:0] only; clear DEU before pointer arithmetic
048CCA 16 03       0147*       ld d,3 ; three bytes per table entry
048CCC 5F          0148*       ld e,a ; a is the tile type
048CCD ED 5C       0149*       mlt de ; de is now the offset to the table entry
048CCF 19          0150*       add hl,de ; hl is now the address of the table entry
048CD0 ED 27       0151*       ld hl,(hl) ; hl is now the activation routine address
048CD2             0152*       CALL_HL ; call the activation routine
                       M1 Args: none
048CD2 01 D8 8C 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
048CD6 C5          0002*M1     push bc ; which constitutes the return address
048CD7 E9          0003*M1     jp (hl) ; Jump to the address in HL
048CD8             0153*   @next_tile:
048CD8             0154*   ; bump x-coords the width of one tile and save it
048CD8 2A C6 8B 04 0155*       ld hl,(tiles_x_plot)
048CDC 01 10 00 00 0156*       ld bc,16
048CE0 09          0157*       add hl,bc
048CE1 22 C6 8B 04 0158*       ld (tiles_x_plot),hl
048CE5             0159*   ; prepare to loop to next column
048CE5 E1          0160*       pop hl ; get back pointer to tile def
048CE6 23          0161*       inc hl ; bump it to the next column
048CE7 C1          0162*       pop bc ; snag our loop counter
048CE8 10 CA       0163*       djnz @loop
048CEA C9          0164*       ret ; done
048CEB             0165*   ; end do_active_tiles
048CEB             0166*   
048CEB FF FF FF    0167*   bg_y_plot: dl -1
048CEE 00 04 00    0168*   bg_bufferId: dl BUF_BG_STARS_0 ; default bufferId for background tiles
048CF1             0169*   
048CF1             0170*   bg_plot:
048CF1             0171*   ; load current bg tile bufferId as default
048CF1 2A EE 8C 04 0172*       ld hl,(bg_bufferId)
048CF5             0173*   ; check whether it is time for a new background tile
048CF5 3A EB 8C 04 0174*       ld a,(bg_y_plot)
048CF9 3C          0175*       inc a
048CFA 32 EB 8C 04 0176*       ld (bg_y_plot),a
048CFE C2 16 8D 04 0177*       jp nz,@F ; not time for a new tile so draw current one
048D02             0178*   ; load the next background tile
048D02 21 00 04 00 0179*       ld hl,BUF_BG_STARS_0
048D06 CD 14 05 04 0180*       call rand_8
048D0A E6 03       0181*       and %0000011
048D0C 85          0182*       add a,l
048D0D 6F          0183*       ld l,a
048D0E 3E 00       0184*       ld a,0
048D10 8C          0185*       adc a,h
048D11 67          0186*       ld h,a
048D12 22 EE 8C 04 0187*       ld (bg_bufferId),hl
048D16             0188*   @@:
048D16 CD 2C 15 04 0189*       call vdu_buff_select
048D1A 01 00 00 00 0190*       ld bc,0
048D1E ED 5B EB 8C 0191*       ld de,(bg_y_plot)
       04          
048D23 13          0192*       inc de
048D24 CD 62 19 04 0193*       call vdu_plot_bmp
048D28 C9          0194*       ret
048D29             0195*   ; end bg_plot
048D29             0079        include "starfield_warp.inc"
048D29             0001*   ; Multi-scanline starfield-only scroller for level starts and transitions.
048D29             0002*   ;
048D29             0003*   ; This module must never be called by tiles_plot or generalized to terrain.
048D29             0004*   ; The global game renderer may select it only while no terrain rows are being
048D29             0005*   ; admitted (initial player approach, drained level transition, or hyperwarp).
048D29             0006*   ; It advances the existing 256x256 background stream by 0..16 scanlines in one
048D29             0007*   ; outer frame, splitting at most once when a step crosses a tile seam. Each
048D29             0008*   ; chunk scrolls only the playfield and redraws exactly the newly exposed strip.
048D29             0009*   
048D29             0010*   starfield_warp_max_step: equ 16
048D29 00          0011*   starfield_warp_remaining: db 0
048D2A 00          0012*   starfield_warp_chunk: db 0
048D2B             0013*   
048D2B             0014*   ; inputs: A = requested scanline displacement, 0..16
048D2B             0015*   ; outputs: carry set on success; carry clear with no VDU output if out of range
048D2B             0016*   ; destroys: everything except SP
048D2B             0017*   starfield_warp_scroll:
048D2B FE 11       0018*       cp starfield_warp_max_step+1
048D2D D2 A5 8D 04 0019*       jp nc,@invalid
048D31 32 29 8D 04 0020*       ld (starfield_warp_remaining),a
048D35 B7          0021*       or a
048D36 CA 9F 8D 04 0022*       jp z,@done
048D3A             0023*   @next_chunk:
048D3A 3A EB 8C 04 0024*       ld a,(bg_y_plot) ; low byte is the 0..255 position within current tile
048D3E FE FF       0025*       cp 255
048D40 CA 75 8D 04 0026*       jp z,@begin_new_tile
048D44             0027*   ; Capacity before the seam is 255-phase. A larger request renders that tail,
048D44             0028*   ; then loops once at phase 255 to select and render the new tile's head.
048D44 47          0029*       ld b,a
048D45 3E FF       0030*       ld a,255
048D47 90          0031*       sub b
048D48 47          0032*       ld b,a ; B = existing-tile capacity
048D49 3A 29 8D 04 0033*       ld a,(starfield_warp_remaining)
048D4D B8          0034*       cp b
048D4E DA 5B 8D 04 0035*       jp c,@existing_final
048D52 CA 5B 8D 04 0036*       jp z,@existing_final
048D56 78          0037*       ld a,b
048D57 C3 5F 8D 04 0038*       jp @existing_chunk_ready
048D5B             0039*   @existing_final:
048D5B 3A 29 8D 04 0040*       ld a,(starfield_warp_remaining)
048D5F             0041*   @existing_chunk_ready:
048D5F 32 2A 8D 04 0042*       ld (starfield_warp_chunk),a
048D63 47          0043*       ld b,a
048D64 3A EB 8C 04 0044*       ld a,(bg_y_plot)
048D68 80          0045*       add a,b
048D69 32 EB 8C 04 0046*       ld (bg_y_plot),a
048D6D CD BC 8D 04 0047*       call starfield_warp_render_chunk
048D71 C3 8A 8D 04 0048*       jp @consume_chunk
048D75             0049*   
048D75             0050*   @begin_new_tile:
048D75 CD A7 8D 04 0051*       call starfield_warp_select_next_tile
048D79 3A 29 8D 04 0052*       ld a,(starfield_warp_remaining)
048D7D 32 2A 8D 04 0053*       ld (starfield_warp_chunk),a
048D81 3D          0054*       dec a ; phase 255 + N steps wraps to N-1 in the new tile
048D82 32 EB 8C 04 0055*       ld (bg_y_plot),a
048D86 CD BC 8D 04 0056*       call starfield_warp_render_chunk
048D8A             0057*   
048D8A             0058*   @consume_chunk:
048D8A 3A 29 8D 04 0059*       ld a,(starfield_warp_remaining)
048D8E 47          0060*       ld b,a
048D8F 3A 2A 8D 04 0061*       ld a,(starfield_warp_chunk)
048D93 90          0062*       sub b
048D94 ED 44       0063*       neg ; A = remaining - chunk without relying on preserved flags/registers
048D96 32 29 8D 04 0064*       ld (starfield_warp_remaining),a
048D9A B7          0065*       or a
048D9B C2 3A 8D 04 0066*       jp nz,@next_chunk
048D9F             0067*   @done:
048D9F CD 71 7B 04 0068*       call set_gfx_playing_field
048DA3 37          0069*       scf
048DA4 C9          0070*       ret
048DA5             0071*   @invalid:
048DA5 AF          0072*       xor a
048DA6 C9          0073*       ret
048DA7             0074*   ; end starfield_warp_scroll
048DA7             0075*   
048DA7             0076*   ; Select a new 256x256 starfield tile using the same four-buffer policy as the
048DA7             0077*   ; gameplay background stream. Called only when phase 255 crosses to zero.
048DA7             0078*   starfield_warp_select_next_tile:
048DA7 21 00 04 00 0079*       ld hl,BUF_BG_STARS_0
048DAB CD 14 05 04 0080*       call rand_8
048DAF E6 03       0081*       and %00000011
048DB1 85          0082*       add a,l
048DB2 6F          0083*       ld l,a
048DB3 3E 00       0084*       ld a,0
048DB5 8C          0085*       adc a,h
048DB6 67          0086*       ld h,a
048DB7 22 EE 8C 04 0087*       ld (bg_bufferId),hl
048DBB C9          0088*       ret
048DBC             0089*   ; end starfield_warp_select_next_tile
048DBC             0090*   
048DBC             0091*   ; Scroll and redraw one nonzero chunk. The full playfield viewport is restored
048DBC             0092*   ; before scrolling. VDP bitmap clipping needs one guard scanline beyond the
048DBC             0093*   ; nominal 0..chunk-1 exposed strip here. Without it, one source scanline from
048DBC             0094*   ; above the playfield survives each call, is scrolled down on the next call,
048DBC             0095*   ; and grows into a visible cockpit-art band during the entrance warp.
048DBC             0096*   starfield_warp_render_chunk:
048DBC 01 80 00 00 0097*       ld bc,origin_left
048DC0 11 30 00 00 0098*       ld de,origin_top
048DC4 CD BC 14 04 0099*       call vdu_set_gfx_origin
048DC8 CD 71 7B 04 0100*       call set_gfx_playing_field
048DCC 3E 02       0101*       ld a,2 ; current graphics viewport
048DCE 2E 02       0102*       ld l,2 ; down
048DD0 3A 2A 8D 04 0103*       ld a,(starfield_warp_chunk)
048DD4 67          0104*       ld h,a
048DD5 3E 02       0105*       ld a,2
048DD7 CD E2 13 04 0106*       call vdu_scroll_down
048DDB 01 00 00 00 0107*       ld bc,0
048DDF 11 00 00 00 0108*       ld de,0
048DE3 DD 21 FF 00 0109*       ld ix,255
       00          
048DE8 FD 21 00 00 0110*       ld iy,0
       00          
048DED 3A 2A 8D 04 0111*       ld a,(starfield_warp_chunk)
048DF1 FD 6F       0112*       ld iyl,a
048DF3 CD D7 14 04 0113*       call vdu_set_gfx_viewport
048DF7 2A EE 8C 04 0114*       ld hl,(bg_bufferId)
048DFB CD 2C 15 04 0115*       call vdu_buff_select
048DFF 01 00 00 00 0116*       ld bc,0
048E03 ED 5B EB 8C 0117*       ld de,(bg_y_plot)
       04          
048E08 13          0118*       inc de
048E09 CD 62 19 04 0119*       call vdu_plot_bmp
048E0D C9          0120*       ret
048E0E             0121*   ; end starfield_warp_render_chunk
048E0E             0080        include "tiles_active.inc"
048E0E             0001*   
048E0E             0002*   ; ###### TODO: NEW CODE TO IMPLEMENT ######
048E0E             0003*   tile_pad_small: equ 1
048E0E             0004*   tile_pad_med: equ 2
048E0E             0005*   tile_pad_large: equ 3
048E0E             0006*   tile_charge_shields: equ 4
048E0E             0007*   tile_turret_fireball: equ 5
048E0E             0008*   tile_laser_turret: equ 6
048E0E             0009*   tile_twin_laser_turret: equ 7
048E0E             0010*   tile_charge_fuel: equ 8
048E0E             0011*   tile_electrode: equ 9
048E0E             0012*   tile_lightning: equ 10
048E0E             0013*   ; tile_electrode_r: equ 11 ; same as tile_electrode
048E0E             0014*   tile_12: equ 12
048E0E             0015*   tile_13: equ 13
048E0E             0016*   tile_14: equ 14
048E0E             0017*   tile_15: equ 15
048E0E             0018*   tile_crater: equ 16
048E0E             0019*   
048E0E             0020*   tile_activation_routines:
048E0E 41 8E 04    0021*       dl activate_null_tile ; dummy spacer since tiled is 1-based
048E11 38 92 04    0022*       dl activate_pad_small
048E14 41 8E 04    0023*       dl activate_null_tile
048E17 41 8E 04    0024*       dl activate_null_tile
048E1A 41 8E 04    0025*       dl activate_null_tile
048E1D AD 92 04    0026*       dl activate_turret_fireball
048E20 41 8E 04    0027*       dl activate_null_tile
048E23 41 8E 04    0028*       dl activate_null_tile
048E26 41 8E 04    0029*       dl activate_null_tile
048E29 3E 90 04    0030*       dl activate_electrode
048E2C DF 91 04    0031*       dl activate_lightning
048E2F 3E 90 04    0032*       dl activate_electrode
048E32 41 8E 04    0033*       dl activate_null_tile
048E35 41 8E 04    0034*       dl activate_null_tile
048E38 41 8E 04    0035*       dl activate_null_tile
048E3B 41 8E 04    0036*       dl activate_null_tile ; tile 15
048E3E E9 8F 04    0037*       dl activate_crater ; tile 16
048E41             0038*   tile_activation_routines_end:
048E41             0039*   tile_activation_routines_count: equ [tile_activation_routines_end-tile_activation_routines]/3
048E41             0040*   ; end tile_activation_routines
048E41             0041*   
048E41             0042*   activate_null_tile:
048E41 C9          0043*       ret ; dummy routine, do nothing
048E42             0044*   move_active_tile:
048E42             0045*   ; Keep local animation/controllers running while spatial world travel is
048E42             0046*   ; paused. The actor remains active and visible at its current coordinate.
048E42 CD 48 71 04 0047*       call player_world_travel_enabled
048E46 DA 4E 8E 04 0048*       jp c,@travel
048E4A 3E 01       0049*       ld a,1
048E4C B7          0050*       or a
