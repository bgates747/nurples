                       M1 Args: none
04835C 01 62 83 04 0001*M1     ld bc,$+6 ; Address of first instruction after the jump
048360 C5          0002*M1     push bc ; which constitutes the return address
048361 E9          0003*M1     jp (hl) ; Jump to the address in HL
048362 C9          0007*       ret
