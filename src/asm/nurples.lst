04145F C2 56 14 04 0165*       jp nz,@wait
041463 10 F1       0166*       djnz @wait
041465 3A 46 14 04 0167*       ld a,(vdu_timing_fault_flags)
041469 F6 01       0168*       or %00000001
04146B 32 46 14 04 0169*       ld (vdu_timing_fault_flags),a
04146F             0170*   @done:
